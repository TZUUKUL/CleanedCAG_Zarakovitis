{"id": "David_Passim_0001", "series": "CAG", "text": "ΤΑ ΠΡΟΛΕΓΟΜΕΝΑ ΤΗΣ ΦΙΛΟΣΟΦΙΑΣ ΑΠΟ ΦΩΝΗΣ ΔΑΒΙΔ ΤΟΥ ΘΕΟΦΙΛΕΣΤΑΤΟΥ ΚΑΙ ΘΕΟΦΡΟΝΟΣ ΦΙΛΟΣΟΦΟΥ.", "seq": 1}
{"id": "David_Passim_0002", "series": "CAG", "text": "<Πρᾶξις αʹ>.", "seq": 2}
{"id": "David_Passim_0003", "series": "CAG", "text": "Οἱ τῶν τῆς φιλοσοφίας λόγων ἐρῶντες καὶ τῆς ἐκ τούτων ἡδονῆς ἄκρῳ δακτύλῳ γευσάμενοι, πάσῃ τῇ τοῦ βίου φροντίδι χαίρειν εἰπόντες, σώφρονί τινι μανίᾳ πρὸς τούτους ἐλαυνόμενοι φαίνονται καὶ τῇ τῶν ὄντων ἐπιστήμῃ συντόμως αὐτῶν ψυχαγωγοῦσι τὸν ἔρωτα·", "seq": 3}
{"id": "David_Passim_0004", "series": "CAG", "text": "ἐπιστήμη δὲ τῶν ὄντων ἐστὶν ἡ φιλοσοφία, ὡς σὺν θεῷ μαθησόμεθα.", "seq": 4}
{"id": "David_Passim_0005", "series": "CAG", "text": "ἐπεὶ τοίνυν καὶ ἡμᾶς σοφὸς ἔρως καὶ πολλὴ προθυμία εἰς τοῦτον διήλασε τὸν ἀγῶνα, φέρε τὸν τῆς φιλοσοφίας θεῖον ἀγῶνα ὑποδυσώμεθα, μὴ τὸ παρὸν δυσχερὲς ἐπιλογιζόμενοι, ἀλλὰ πρὸς τὸ πέρας τῆς θείας ἐπαγγελίας αὐτῆς ἀποβλέποντες πάντα μόχθον ἐλάττονα καὶ δεύτερον αὐτῆς ἡγησώμεθα.", "seq": 5}
{"id": "David_Passim_0006", "series": "CAG", "text": "Δοκεῖ δέ μοι μικρὸν ἀναβάλλεσθαι τὴν ἐγκύκλιον ἐξήγησιν Ἀριστοτελικοῖς πειθομένῳ θεσμοῖς, ὡς δεῖ ἐν ἑκάστω σχεδὸν πράγματι τὰ τέσσαρα ταῦτα ζητεῖν κεφάλαια·", "seq": 6}
{"id": "David_Passim_0007", "series": "CAG", "text": "εἰ ἔστι, τί ἐστι, ὁποῖόν τί ἐστι καὶ διὰ τί ἐστι.", "seq": 7}
{"id": "David_Passim_0008", "series": "CAG", "text": "καὶ εἰκότως τὰ τέσσαρα ταῦτα ζητοῦμεν·", "seq": 8}
{"id": "David_Passim_0009", "series": "CAG", "text": "τῶν γὰρ πραγμάτων τὰ μὲν ἀνύπαρκτά ἐστιν, ὡς τραγέλαφος, σκινδαψός, βλίτυρι καὶ τὰ λοιπά, ὅσα ἡ ἡμετέρα διάνοια διαπλάττεται, τὰ δὲ ὕπαρξιν ἔχει.", "seq": 9}
{"id": "David_Passim_0010", "series": "CAG", "text": "καὶ τούτων αὖθις τῶν ὕπαρξιν ἐχόντων τὰ μὲν ἀμφιβαλλομένην ἔχει τὴν ὕπαρξιν, ὡς ἄναστρος σφαῖρα ἢ ὡς ἀντίποδες (ταῦτα γὰρ ἀμφιβάλλονται εἴτε εἰσὶν εἴτε οὔ), τὰ δὲ οὐκ ἀμφιβαλλομένην ἀλλ᾿ ὁμολογουμένην, ὥσπερ ἄνθρωπος ἢ βοῦς.", "seq": 10}
{"id": "David_Passim_0011", "series": "CAG", "text": "καὶ ἐπὶ μὲν τῶν ὕπαρξιν ἐχόντων ἀμφιβαλλομένην δὲ ζητοῦμεν τὸ εἰ ἔστιν, ἐπὶ δὲ τῶν ὁμολογουμένην ἐχόντων τὴν ὕπαρξιν ζητοῦμεν τὸ τί ἐστι.", "seq": 11}
{"id": "David_Passim_0012", "series": "CAG", "text": "τὸ δὲ τί ἐστιν ἢ δι᾿ ὀνόματος ἢ δι᾿ ὁρισμοῦ γινώσκεται, δι᾿ ὀνόματος μέν, ὅταν βλέπωμέν τι καὶ ἐρωτῶμεν τί ἐστι, καὶ λέγωμεν ὅτι ‘ἄνθρωπος’, δι᾿ ὁρισμοῦ δέ, ὅταν λέγωμεν ‘ζῷον λογικὸν θνητὸν νοῦ καὶ ἐπιστήμης δεκτικόν’.", "seq": 12}
{"id": "David_Passim_0013", "series": "CAG", "text": "εἶτα δὲ ἐπειδὴ τὰ πράγματα οὐ μόνον κοινωνοῦσιν ἀλλὰ καὶ διαφέρουσιν (καὶ γὰρ τὰ ζῷα οὐ μόνον κοινωνοῦσι κατὰ τὸ γένος καθὸ ζῷα, ἀλλὰ καὶ διαφέρουσι, καθὸ τὰ μὲν λογικὰ τὰ δὲ ἄλογα), διὰ τοῦτο ζητοῦμεν τὸ ὁποῖόν τί ἐστιν, ἵνα γνῶμεν τὰς διαφοράς·", "seq": 13}
{"id": "David_Passim_0014", "series": "CAG", "text": "καὶ γὰρ τῷ ὅρῳ συναναφαίνονται αἱ διαφοραί.", "seq": 14}
{"id": "David_Passim_0015", "series": "CAG", "text": "[ἰστέον δὲ ὅτι ἡνίκα τὸ τί ἐστι δι᾿ ὀνόματος ἐκφέρεται, τότε δεῖ ζητεῖν τὸ ὁποῖόν τί ἐστιν, ἡνίκα δὲ δι᾿ ὅρου γινώσκεται, τότε οὐ δεῖ ζητεῖν ὁποῖόν τί ἐστιν, ἀλλὰ τὸ διὰ τί ἐστιν.]", "seq": 15}
{"id": "David_Passim_0016", "series": "CAG", "text": "ἐπειδὴ δὲ πάντα πρός τι τέλος ὁρῶσι καὶ οὐδὲν μάτην οὔτε ὁ δημιουργὸς οὔτε ἡ φύσις οὔτε ἡ τέχνη ἐπενόησεν, τούτου χάριν ζητοῦμεν τὸ διὰ τί ἐστιν·", "seq": 16}
{"id": "David_Passim_0017", "series": "CAG", "text": "οἷον διὰ τί ἐστι κλίνη;", "seq": 17}
{"id": "David_Passim_0018", "series": "CAG", "text": "διὰ τὴν τῶν ἀνθρώπων ἀνάπαυσιν.", "seq": 18}
{"id": "David_Passim_0019", "series": "CAG", "text": "καὶ πάλιν διὰ τί ἐστιν ἄνθρωπος;", "seq": 19}
{"id": "David_Passim_0020", "series": "CAG", "text": "διὰ τὸ κοσμῆσαι τόδε τὸ πᾶν·", "seq": 20}
{"id": "David_Passim_0021", "series": "CAG", "text": "καὶ γὰρ τὸ πᾶν ἀτελὲς ἦν, εἰ μὴ ἦν τὸ ἀνθρώπειον γένος, ὡς δηλοῖ καὶ ὁ Πλάτων ἐν τῷ Τιμαίῳ·", "seq": 21}
{"id": "David_Passim_0022", "series": "CAG", "text": "ποιεῖ γὰρ τὸν δημιουργὸν λέγοντα μετὰ τὴν ποίησιν οὐρανοῦ καὶ γῆς ‘ἔτι λείπεται τρία γένη ἡμῖν θνητὰ καὶ ἀγέννητα, ὧν μήπω γενομένων ὁ οὐρανός, φησίν, ἐστὶν ἀτελής’.", "seq": 22}
{"id": "David_Passim_0023", "series": "CAG", "text": "οὐρανὸν δὲ ἐκάλεσε τὸν κόσμον ἐκ τοῦ περιέχοντος ὀνομάσας τὸ περιεχόμενον.", "seq": 23}
{"id": "David_Passim_0024", "series": "CAG", "text": "Ἐπεὶ τοίνυν ἡ φιλοσοφία ἐστὶν ἡμῖν τὸ προκείμενον, τὸ κάλλιστόν τε καὶ τιμιώτατον τῶν ἐν ἀνθρώποις πράξεων, ἥτις παρ᾿ ἡμῖν μὲν οὐκ ἀμφιβάλλεται, παρὰ δέ τισιν ἀμφιβάλλεται τυφλοῖς ἐοικόσι περὶ χρωμάτων συλλογιζομένοις, οὓς ὁ Σταγειρίτης φησίν (οἱ γὰρ ἐκ γενετῆς τυφλοὶ οὐ δύνανται περὶ χρωμάτων συλλογίσασθαι·", "seq": 24}
{"id": "David_Passim_0025", "series": "CAG", "text": "οὐ γὰρ ἴσασι τί ἐστι χρῶμα), φέρε τοὺς τούτων λόγους εἰς μέσον ἐκθώμεθα καὶ τὴν τούτων ἀνατροπὴν ὡς οἷόν τέ ἐστι ποιησώμεθα σαφῶς ἐλέγχοντες τὴν τούτων ἄνοιαν.", "seq": 25}
{"id": "David_Passim_0026", "series": "CAG", "text": "τίνες δέ εἰσιν οἱ τούτων λόγοι, ἐν τῇ ἐφεξῆς θεωρίᾳ μαθησόμεθα.", "seq": 26}
{"id": "David_Passim_0027", "series": "CAG", "text": "Πρᾶξις β΄.", "seq": 27}
{"id": "David_Passim_0028", "series": "CAG", "text": "Καθάπερ ἐν τῇ προτέρᾳ θεωρίᾳ ὑπεσχόμεθα, ἔλθωμεν καὶ τοὺς λόγους τῶν βουλομένων ἀνελεῖν τὴν ὕπαρξιν τῆς φιλοσοφίας ἐκθώμεθα καὶ τούτων τὴν ἀνατροπὴν ὡς οἷόν τέ ἐστι ποιησώμεθα.", "seq": 28}
{"id": "David_Passim_0029", "series": "CAG", "text": "πρῶτον μὲν ἐπιχείρημα τῶν ἀνατρεπόντων τὴν φιλοσοφίαν ἐστὶ τοῦτο·", "seq": 29}
{"id": "David_Passim_0030", "series": "CAG", "text": "τὸ ὂν τῶν ὁμωνύμων ἐστίν, τὰ ὁμώνυμα ὅρῳ οὐ καθυποβάλλονται, τὰ ὅρῳ μὴ καθυποβαλλόμενα γνώσει οὐχ ὑποπίπτουσι, τὸ ὂν ἄρα ἄγνωστόν ἐστιν.", "seq": 30}
{"id": "David_Passim_0031", "series": "CAG", "text": "εἰ δὲ ἡ φιλοσοφία γνῶσις τῶν ὄντων ἐστί, δῆλον ὅτι ἄγνωστός ἐστιν, εἴ γε τὸ ὂν ἄγνωστόν ἐστι.", "seq": 31}
{"id": "David_Passim_0032", "series": "CAG", "text": "πρὸς τοῦτο τὸ ἐπιχείρημα διττῶς ὑπαντῶμεν τῇ τε ἐνστάσει κεχρημένοι καὶ τῇ ἀντιπαραστάσει.", "seq": 32}
{"id": "David_Passim_0033", "series": "CAG", "text": "ἰστέον δὲ ὅτι ἐνστάσεως μὲν ἔργον ἐστὶ τὸ ἐκ βαλβῖδος αὐτῆς καὶ εὐθέως ἐκ προοιμίων ἀνατρέπειν τοὺς δι᾿ ἐναντίας λόγους, ἀντιπαραστάσεως δὲ τὸ δέξασθαι μὲν τὸν λόγον ὡς ἀληθῆ δεῖξαι δὲ αὐτὸν μηδαμῶς καταβλάπτοντα τὸ προκείμενον, ἀλλὰ μάτην εἰρημένον.", "seq": 33}
{"id": "David_Passim_0034", "series": "CAG", "text": "ἀνατρέποντες οὖν τὸ ἐπιχείρημα τῶν ἀνατρεπόντων τὴν φιλοσοφίαν κεχρήμεθα τῇ ἐνστάσει, λέγοντες ὅτι τὸ ὂν οὐκ ἔστι τῶν ὁμωνύμων ἀλλὰ τῶν ἀφ᾿ ἑνός (τί δέ ἐστι τὰ ὁμώνυμα καὶ τί τὰ ἀφ᾿ ἑνός, προκόπτοντες μαθησόμεθα), τῇ δὲ ἀντιπαραστάσει κεχρήμεθα λέγοντες ὅτι εἰ καὶ δῶμεν τῶν ὁμωνύμων εἶναι τὸ ὄν, οὐ παρὰ τοῦτο ἄγνωστόν ἐστι·", "seq": 34}
{"id": "David_Passim_0035", "series": "CAG", "text": "καὶ γὰρ δύναται τὰ ὁμώνυμα ὅρῳ καθυποβληθῆναι·", "seq": 35}
{"id": "David_Passim_0036", "series": "CAG", "text": "κανὼν γάρ ἐστι διαλεκτικὸς ὁ λέγων ὅτι ἐπὶ τῶν ὁμωνύμων τρία τινὰ δεῖ ζητεῖν, πόσα σημαινόμενα ἔχει τὸ ὁμώνυμον, καὶ περὶ ποίου σημαινομένου ἐστὶν ὁ λόγος, καὶ εἶθ᾿ οὕτως ὑπογράψαι ἢ ὁρίσασθαι τὸ ἓν τῶν σημαινομένων περὶ οὗ ἐστιν ὁ λόγος.", "seq": 36}
{"id": "David_Passim_0037", "series": "CAG", "text": "οἷον παραδείγματι σαφηνίσωμεν τὸ λεχθέν·", "seq": 37}
{"id": "David_Passim_0038", "series": "CAG", "text": "ἡνίκα περὶ κυνός ἐστιν ὁ λόγος, ἐπειδὴ αὕτη ἡ φωνὴ τῶν ὁμωνύμων ἐστίν, δεῖ πρῶτον λέγειν πόσα σημαινόμενα ἔχει, οἷον ὅτι σημαίνει τόν τε ἀστρῷον καὶ τὸν θαλάττιον καὶ τὸν χερσαῖον, καὶ δεύτερον περὶ ποίου κυνός ἐστιν ὁ λόγος, εἶτα ὑπογράφειν αὐτὸ ἢ ὅρῳ καθυποβάλλειν·", "seq": 38}
{"id": "David_Passim_0039", "series": "CAG", "text": "οἷον εἰ περὶ τοῦ χερσαίου κυνός ἐστιν ὁ λόγος, λέγομεν ὅτι ἐστὶ ζῷον τετράπουν ὑλακτικόν.", "seq": 39}
{"id": "David_Passim_0040", "series": "CAG", "text": "οὕτως οὖν καὶ ἐπὶ τοῦ ὄντος τὰ τρία ταῦτα ζητοῦμεν·", "seq": 40}
{"id": "David_Passim_0041", "series": "CAG", "text": "ζητοῦμεν γὰρ πρῶτον πόσα σημαινόμενα ἔχει καὶ λέγομεν ὅτι κατὰ δέκα σημαινομένων φέρεται, ἤγουν κατὰ τῶν δέκα κατηγοριῶν.", "seq": 41}
{"id": "David_Passim_0042", "series": "CAG", "text": "καὶ δεύτερον ζητοῦμεν περὶ ποίου σημαινομένου ἐστὶν ὁ λόγος, ἆρα περὶ οὐσίας ἢ περὶ ποσοῦ ἢ περὶ ποιοῦ ἢ περὶ τῶν ἑξῆς κατηγοριῶν.", "seq": 42}
{"id": "David_Passim_0043", "series": "CAG", "text": "τότε ζητοῦμεν ὁρισμῷ ἢ ὑπογραφῇ καθυποβάλλειν.", "seq": 43}
{"id": "David_Passim_0044", "series": "CAG", "text": "εἰ ἄρα οὖν ὁρισμῷ καθυποβάλλεται, δῆλον ὅτι οὐκ ἔστιν ἄγνωστον τὸ ὄν.", "seq": 44}
{"id": "David_Passim_0045", "series": "CAG", "text": "Τὸ δὲ δεύτερον ἐπιχείρημα τῶν ἀνατρεπόντων τὴν φιλοσοφίαν προέρχεται τοῦτον τὸν τρόπον·", "seq": 45}
{"id": "David_Passim_0046", "series": "CAG", "text": "τὰ ὄντα ἐν ῥοῇ καὶ ἀπορροῇ εἰσι καὶ στάσεως οὐδεμιᾶς τυγχάνουσι·", "seq": 46}
{"id": "David_Passim_0047", "series": "CAG", "text": "φθάνει γὰρ τὸν λόγον ἀμειφθέντα τὰ πράγματα·", "seq": 47}
{"id": "David_Passim_0048", "series": "CAG", "text": "καὶ γὰρ σχεδὸν πρὸ τοῦ ῥηθῆναι τὸν περὶ αὐτῶν λόγον ἀμείβονται τὰ πράγματα.", "seq": 48}
{"id": "David_Passim_0049", "series": "CAG", "text": "καὶ φέρουσι παράδειγμα τοιοῦτον, ὅτι ὥσπερ ἐν ποταμῷ ἐν τῷ αὐτῷ ὕδατι οὐ δύναταί τις βρέξαι δὶς τὸν πόδα, ἢ ὥσπερ ἕτεροι ἐπιτείνοντες τὴν ἀπορίαν λέγουσιν ὅτι οὐδὲ ἅπαξ δύναταί τις ἐν τῷ αὐτῷ ὕδατι βρέξαι τὸν πόδα ἐκείνου τοῦ ὕδατος παρερχομένου συντόμως καὶ ἄλλου ἐπερχομένου, οὕτω καὶ τὰ πράγματα ἐν ῥοῇ καὶ ἀπορροῇ ὄντα στάσεως οὐδεμιᾶς τυγχάνουσι καὶ δῆλον ὅτι γνώσει οὐχ ὑποπίπτουσιν·", "seq": 49}
{"id": "David_Passim_0050", "series": "CAG", "text": "ἐν τῷ γὰρ θέλειν τινὰ γινώσκειν αὐτὰ ἀμείβονται καὶ ἄλλοτε ἄλλως ἔχουσι, καὶ οὐ καταλαμβάνει τις γνῶναι αὐτά.", "seq": 50}
{"id": "David_Passim_0051", "series": "CAG", "text": "πῶς οὖν ἡ φιλοσοφία γνῶσις τῶν ὄντων ἐστίν, ὅπου τὰ ὄντα ἐν ῥοῇ καὶ ἀπορροῇ ὄντα ἄγνωστά εἰσιν;", "seq": 51}
{"id": "David_Passim_0052", "series": "CAG", "text": "ἄλλως τε δέ φασιν·", "seq": 52}
{"id": "David_Passim_0053", "series": "CAG", "text": "ἵνα γένηται κατάληψις, θέλει τὸ γινῶσκον ἐφαρμόζεσθαι τῷ γνωστῷ.", "seq": 53}
{"id": "David_Passim_0054", "series": "CAG", "text": "καὶ γινῶσκον μὲν λέγουσι τὴν ψυχὴν γνωστὸν δὲ τὸ πρᾶγμα τὸ ὑποκείμενον ἤγουν τὸ γινωσκόμενον.", "seq": 54}
{"id": "David_Passim_0055", "series": "CAG", "text": "ἵνα δὲ γένηται ἐφαρμογή, τοῦτ᾿ ἔστιν ἁρμοδία κατάληψις, θέλει τὸ γνωστὸν ἢ μὴ κινεῖσθαι ἀλλ᾿ ἀεὶ ὡσαύτως ἔχειν, ἢ εἰ κινεῖται τὸ γνωστὸν καὶ μεταβάλλεται, θέλει καὶ τὸ γινῶσκον ἤγουν ἡ ψυχὴ συγκινεῖσθαι καὶ συμμεταβάλλεσθαι, καὶ τυχὸν εἰ γίνεται τὸ γνωστὸν λευκόν, θέλει καὶ ἡ ψυχὴ λευκὴ εἶναι, καὶ εἰ γίνεται ὕδωρ, θέλει καὶ ἡ ψυχὴ ὕδωρ γίνεσθαι.", "seq": 55}
{"id": "David_Passim_0056", "series": "CAG", "text": "ἀλλὰ μὴν ἡ ψυχὴ οὐ συμμεταβάλλεται τῷ γνωστῷ·", "seq": 56}
{"id": "David_Passim_0057", "series": "CAG", "text": "δῆλον <οὖν> ὅτι οὐ δύναται γνῶναι αὐτό.", "seq": 57}
{"id": "David_Passim_0058", "series": "CAG", "text": "ἄρα οὖν ἡ φιλοσοφία γνῶσις τῶν ὄντων εἶναι οὐ δύναται, ὅπου τὰ ὄντα γνώσει οὐ καθυποβάλλονται.", "seq": 58}
{"id": "David_Passim_0059", "series": "CAG", "text": "ταῦτα μὲν οὗτοι.", "seq": 59}
{"id": "David_Passim_0060", "series": "CAG", "text": "ἔστι δὲ εἰπεῖν πρὸς αὐτούς·", "seq": 60}
{"id": "David_Passim_0061", "series": "CAG", "text": "πρῶτον μὲν ἡ φιλοσοφία οὐ καταγίνεται περὶ τὰ μερικά, ἅτινά εἰσιν ἐν ῥοῇ καὶ ἀπορροῇ, ἀλλὰ περὶ τὰ καθόλου, ἅτινα οὐ μεταβάλλεται, ἀλλ᾿ ἀεὶ ὡσαύτως ἔχει.", "seq": 61}
{"id": "David_Passim_0062", "series": "CAG", "text": "δεύτερον δὲ εἰ καὶ δῶμεν αὐτὴν περὶ τὰ μερικὰ καταγίνεσθαι, οὐ παρὰ τοῦτο οὐ δύναταί τις καταλαβέσθαι, καθὸ τὸ γινῶσκον ἤγουν ἡ ψυχὴ οὐ συμμεταβάλλεται τῷ γνωστῷ ἤγουν τῷ ὑποκειμένῳ πράγματι·", "seq": 62}
{"id": "David_Passim_0063", "series": "CAG", "text": "κατὰ γὰρ τοῦτον τὸν λόγον οὐδὲ τὸ θεῖον εἴσεταί τι τῶν γινομένων, ἐπειδὴ οὐ συμμεταβάλλεται τοῖς πράγμασιν, ἀλλ᾿ ἀεὶ ὡσαύτως ἔχει.", "seq": 63}
{"id": "David_Passim_0064", "series": "CAG", "text": "καὶ πάλιν κατὰ τοῦτον τὸν λόγον ὁ ἰατρὸς κατὰ φύσιν ὢν οὐ δύναται γνῶναι τὰ παρὰ φύσιν, τοῦτ᾿ ἔστιν ὅταν ὑγιαίνῃ, οὐ δύναται διακρῖναι τὴν νόσον, ἀλλ᾿ ἀναγκάζεται νοσεῖν, ἵνα τὴν νόσον διακρίνῃ.", "seq": 64}
{"id": "David_Passim_0065", "series": "CAG", "text": "ἔτι δὲ πολλάκις ἡ ψυχὴ πρὸ τοῦ ἀμειφθῆναι τὰ πράγματα γινώσκει αὐτά, ὡς καὶ ὁ Πλάτων δηλοῖ λέγων ‘αἱ γὰρ τῶν σπουδαίων ψυχαὶ οὐ μόνον κατόπιν ἔρχονται τῶν πραγμάτων, ἀλλὰ καὶ προφθάνουσιν αὐτὰ καὶ προγινώσκουσι πρὸ τοῦ ἀμειφθῆναι’.", "seq": 65}
{"id": "David_Passim_0066", "series": "CAG", "text": "καὶ ταῦτα μὲν ἐν τούτοις.", "seq": 66}
{"id": "David_Passim_0067", "series": "CAG", "text": "Τρίτον δὲ ἐπιχείρημα οἱ ἀνατρέποντες τὴν φιλοσοφίαν φασὶ τοῦτο·", "seq": 67}
{"id": "David_Passim_0068", "series": "CAG", "text": "τὰ γινωσκόμενα αἰσθήσει ὑποπίπτουσιν, ὡς καὶ ὁ Πλάτων δηλοῖ λέγων ‘ὁ γὰρ δημιουργὸς ὄψιν καὶ ἀκοὴν ἡμῖν ἐδωρήσατο, ἵνα διὰ τούτων τὸ τῆς φιλοσοφίας κατορθώσωμεν γένος’.", "seq": 68}
{"id": "David_Passim_0069", "series": "CAG", "text": "τοῦτο λαβόντες ὡς ὁμολογούμενόν φασιν ὅτι εἰ δείξομεν ἐκ τῆς ὑμῶν διαιρέσεως μὴ δυνάμενα εἶναι τὰ μέρη τῆς φιλοσοφίας, δῆλον ὅτι οὐ συνίσταται ἡ φιλοσοφία.", "seq": 69}
{"id": "David_Passim_0070", "series": "CAG", "text": "φασὶν οὖν ὅτι καθ᾿ ὑμᾶς ἡ φιλοσοφία διαιρεῖται εἰς θεωρητικὸν καὶ πρακτικόν, τὸ θεωρητικὸν πάλιν εἰς μαθηματικὸν φυσιολογικὸν καὶ θεολογικόν·", "seq": 70}
{"id": "David_Passim_0071", "series": "CAG", "text": "εἰ ἄρα οὖν ταῦτα ἀνατρέψομεν, δῆλον ὅτι οὐ συνίσταται ἡ φιλοσοφία.", "seq": 71}
{"id": "David_Passim_0072", "series": "CAG", "text": "φασὶν ὅτι τὸ μαθηματικὸν οὐκ ἔστι μέρος τῆς φιλοσοφίας, ὡς καὶ ὁ Πλάτων δοξάζει·", "seq": 72}
{"id": "David_Passim_0073", "series": "CAG", "text": "καὶ γὰρ οὗτος τὸ μαθηματικὸν οὐ δοξάζει μέρος τῆς φιλοσοφίας ἀλλὰ προγύμνασμά τι, ὥσπερ τὴν γραμματικὴν καὶ τὴν ῥητορικήν.", "seq": 73}
{"id": "David_Passim_0074", "series": "CAG", "text": "ὅθεν κἀν τῷ ἀκροατηρίῳ ἐπέγραφεν·", "seq": 74}
{"id": "David_Passim_0075", "series": "CAG", "text": "“ἀγεωμέτρητος μηδεὶς εἰσίτω”.", "seq": 75}
{"id": "David_Passim_0076", "series": "CAG", "text": "τὸ δὲ φυσιολογικόν, φασίν, ἀνατέτραπται διὰ τοῦ δευτέρου ἐπιχειρήματος τοῦ λέγοντος ὅτι τὰ ὄντα ἐν ῥοῇ καὶ ἀπορροῇ εἰσιν, τὸ δὲ θεολογικὸν ἀνατέτραπται οὕτως·", "seq": 76}
{"id": "David_Passim_0077", "series": "CAG", "text": "φασὶ γὰρ ὅτι τὰ θεῖα αἰσθήσει οὐ καθυποβάλλονται, τὰ δὲ αἰσθήσει μὴ καθυποβαλλόμενα γνώσει οὐχ ὑποπίπτουσι, τὰ θεῖα ἄρα ἄγνωστά εἰσι.", "seq": 77}
{"id": "David_Passim_0078", "series": "CAG", "text": "ταῦτα μὲν ἐν τούτοις.", "seq": 78}
{"id": "David_Passim_0079", "series": "CAG", "text": "Ἔστι δὲ εἰπεῖν ὅτι περὶ τοῦ πρακτικοῦ τέως οὐδὲν εἰρήκασιν, ὅπερ ἀντιδιαιρεῖται τῷ θεωρητικῷ, καὶ δῆλον ὅτι οὐκ ἀνεῖλον πᾶσαν τὴν φιλοσοφίαν·", "seq": 79}
{"id": "David_Passim_0080", "series": "CAG", "text": "καὶ γὰρ καὶ τὸ πρακτικὸν μέρος τῆς φιλοσοφίας.", "seq": 80}
{"id": "David_Passim_0081", "series": "CAG", "text": "καὶ τοῦτο δηλοῖ ὁ Πλάτων λέγων ὅτι ‘οὐ μόνον φιλόσοφον λέγω τὸν πολλὰ εἰδότα καὶ πολλὰ ἀποστηθίσαι δυνάμενον, ἀλλὰ καὶ τὸν ἀκηλίδωτον καὶ ἄρρυπον βίον κτησάμενον’, ὅπερ ἐστὶν ἔργον πρακτικοῦ φιλοσόφου.", "seq": 81}
{"id": "David_Passim_0082", "series": "CAG", "text": "ταῦτα μὲν ἐν τούτοις.", "seq": 82}
{"id": "David_Passim_0083", "series": "CAG", "text": "ἔλθωμεν δὲ καὶ ἀπολογησώμεθα περὶ τοῦ μαθηματικοῦ καὶ φυσιολογικοῦ καὶ θεολογικοῦ.", "seq": 83}
{"id": "David_Passim_0084", "series": "CAG", "text": "καὶ περὶ μὲν τοῦ μαθηματικοῦ ἔστιν εἰπεῖν ὅτι οὐ δοξάζει ὁ Πλάτων τοῦτο μὴ εἶναι μέρος τῆς φιλοσοφίας, εἰ μὴ τῆς ἄκρας φιλοσοφίας ἤγουν τοῦ θεολογικοῦ·", "seq": 84}
{"id": "David_Passim_0085", "series": "CAG", "text": "τούτου γὰρ δοξάζει μὴ εἶναι μέρος αὐτό·", "seq": 85}
{"id": "David_Passim_0086", "series": "CAG", "text": "ὅτι γὰρ ἐπίσταται τὸ μαθηματικὸν μέρος τῆς φιλοσοφίας δῆλον, εἴ γε καὶ ἐπιστήμην αὐτὸ λέγει εἶναι·", "seq": 86}
{"id": "David_Passim_0087", "series": "CAG", "text": "εἰ δὲ ἐπιστήμη ἐστί, δῆλον ὅτι μέρος τῆς φιλοσοφίας ἐστί.", "seq": 87}
{"id": "David_Passim_0088", "series": "CAG", "text": "καὶ ὁ Ἀριστοτέλης δὲ φανερῶς τὸ μαθηματικὸν μέρος τῆς φιλοσοφίας καλεῖ.", "seq": 88}
{"id": "David_Passim_0089", "series": "CAG", "text": "περὶ δὲ τοῦ φυσιολογικοῦ ἀπελογησάμεθα ἀνατρέψαντες τὸ δεύτερον αὐτῶν ἐπιχείρημα τὸ φάσκον ὅτι τὰ ὄντα ἐν ῥοῇ καὶ ἀπορροῇ εἰσι.", "seq": 89}
{"id": "David_Passim_0090", "series": "CAG", "text": "περὶ δὲ τοῦ θεολογικοῦ ἔστιν εἰπεῖν ὅτι εἰ καὶ τὸ θεῖον ἄγνωστον, ἀλλ᾿ οὖν θεωροῦντες τὰ δημιουργήματα καὶ τὴν εὔτακτον κίνησιν τοῦ παντὸς εἰς ἔννοιαν ἐρχόμεθα τοῦ δημιουργήσαντος.", "seq": 90}
{"id": "David_Passim_0091", "series": "CAG", "text": "τὸ δὲ ἀφανὲς ἐκ τοῦ φανεροῦ ταχίστην ἔχει τὴν διάγνωσιν·", "seq": 91}
{"id": "David_Passim_0092", "series": "CAG", "text": "ἐπειδὴ γὰρ πᾶν κινούμενον ὑφ᾿ ἑτέρου τινὸς κινεῖται, ὁρῶμεν δὲ τὸν οὐρανὸν σῶμα καὶ ὅτι κινεῖται, οὐκοῦν ὑπό τινος ἑτέρου κινεῖται·", "seq": 92}
{"id": "David_Passim_0093", "series": "CAG", "text": "ἔστιν ἄρα τις κινῶν τὸν οὐρανόν.", "seq": 93}
{"id": "David_Passim_0094", "series": "CAG", "text": "καὶ ἐπειδὴ τὴν αὐτὴν κίνησιν κινεῖται διηνεκῶς, δῆλον ὅτι ὑφ᾿ ἑνὸς κινεῖται, ὥς φησιν ὁ Ἀριστοτέλης·", "seq": 94}
{"id": "David_Passim_0095", "series": "CAG", "text": "εἰ γὰρ ἦσαν πολλοὶ οἱ κινοῦντες τὸν οὐρανόν, ἄλλος ἂν ἄλλως ἐκίνει καὶ ἡ αὐτὴ κίνησις οὐκ ἐγίνετο.", "seq": 95}
{"id": "David_Passim_0096", "series": "CAG", "text": "καὶ ἐπειδὴ ἀπαύστως ἀεὶ κινεῖται, δῆλον ὅτι ὑπό τινος ἀσωμάτου ἀεὶ κινεῖται·", "seq": 96}
{"id": "David_Passim_0097", "series": "CAG", "text": "εἰ γὰρ εἶχε σῶμα ὁ κινῶν τὸν οὐρανόν, πεπερασμένος ἂν ἦν·", "seq": 97}
{"id": "David_Passim_0098", "series": "CAG", "text": "τὸ δὲ πεπερασμένον σῶμα πεπερασμένην καὶ δύναμιν ἔχει καὶ οὐκ ἂν ἠδύνατο συνεχῶς καὶ ἀπαύστως κινεῖν τὸν οὐρανόν·", "seq": 98}
{"id": "David_Passim_0099", "series": "CAG", "text": "ὥστε δῆλον ὅτι οὐκ ἔχει σῶμα.", "seq": 99}
{"id": "David_Passim_0100", "series": "CAG", "text": "ἀλλὰ μὴν οὐδὲ φθείρεται·", "seq": 100}
{"id": "David_Passim_0101", "series": "CAG", "text": "εἰ γὰρ ἐφθείρετο ὁ κινῶν τὸν οὐρανόν, συνεφθείρετο αὐτῷ καὶ ὁ οὐρανός·", "seq": 101}
{"id": "David_Passim_0102", "series": "CAG", "text": "ἀλλὰ μὴν ὁ οὐρανὸς οὐ φθείρεται·", "seq": 102}
{"id": "David_Passim_0103", "series": "CAG", "text": "δῆλον <οὖν> ὅτι οὐδὲ ὁ κινῶν τὸν οὐρανὸν φθείρεται.", "seq": 103}
{"id": "David_Passim_0104", "series": "CAG", "text": "τί οὖν συνήγαγεν ὁ λόγος;", "seq": 104}
{"id": "David_Passim_0105", "series": "CAG", "text": "ὅτι ὁ κινῶν τὸν οὐρανὸν εἷς ἐστι καὶ ἀσώματος καὶ ἄπειρος καὶ ἄφθαρτος.", "seq": 105}
{"id": "David_Passim_0106", "series": "CAG", "text": "τοῦτο δὲ οὐδὲν ἕτερόν ἐστιν εἰ μὴ τὸ θεῖον.", "seq": 106}
{"id": "David_Passim_0107", "series": "CAG", "text": "οὕτως οὖν ἐκ τοῦ φανεροῦ εἰς ἔννοιαν ἐρχόμεθα τοῦ ἀφανοῦς.", "seq": 107}
{"id": "David_Passim_0108", "series": "CAG", "text": "οὕτως ἀνατρέψαντες καὶ τὸ τρίτον αὐτῶν ἐπιχείρημα καταπαύσωμεν ὧδε τὴν θεωρίαν.", "seq": 108}
{"id": "David_Passim_0109", "series": "CAG", "text": "Πρᾶξις γ΄.", "seq": 109}
{"id": "David_Passim_0110", "series": "CAG", "text": "Τὸ τέταρτον ἐπιχείρημα τῶν ἀνατρεπόντων τὴν φιλοσοφίαν ἔχει τοῦτον τὸν τρόπον·", "seq": 110}
{"id": "David_Passim_0111", "series": "CAG", "text": "ἡ φιλοσοφία ἢ γνῶσίς ἐστιν ἢ οὐκ ἔστι γνῶσις·", "seq": 111}
{"id": "David_Passim_0112", "series": "CAG", "text": "καὶ εἰ μὲν οὐκ ἔστι γνῶσις, δῆλον ὅτι οὐδὲ τέχνη ἐστὶν οὐδὲ ἐπιστήμη·", "seq": 112}
{"id": "David_Passim_0113", "series": "CAG", "text": "πᾶσα γὰρ τέχνη καὶ ἐπιστήμη γνῶσίς ἐστι·", "seq": 113}
{"id": "David_Passim_0114", "series": "CAG", "text": "γινώσκει γὰρ τὰ ὑποκείμενα αὐτῇ πράγματα·", "seq": 114}
{"id": "David_Passim_0115", "series": "CAG", "text": "εἰ δὲ γνῶσίς ἐστιν, ἢ μερική ἐστιν ἢ καθόλου·", "seq": 115}
{"id": "David_Passim_0116", "series": "CAG", "text": "καὶ εἰ μὲν μερική ἐστι, χείρων ἐστὶ τῶν ἄλλων τεχνῶν (ἐκεῖναι γὰρ καθόλου γνώσεις εἰσὶν ἔχουσαι καὶ καθολικοὺς κανόνας·", "seq": 116}
{"id": "David_Passim_0117", "series": "CAG", "text": "καὶ γὰρ ἡ γραμματικὴ καὶ ἡ ῥητορικὴ καὶ ἡ ἰατρικὴ ἔχουσι καθολικοὺς κανόνας)·", "seq": 117}
{"id": "David_Passim_0118", "series": "CAG", "text": "εἰ δὲ χείρων ἐστὶ τῶν ἄλλων τεχνῶν, πῶς λέγετε αὐτὴν τέχνην τεχνῶν εἶναι καὶ ἐπιστήμην ἐπιστημῶν;", "seq": 118}
{"id": "David_Passim_0119", "series": "CAG", "text": "εἰ δὲ καθόλου ἐστὶ γνῶσις, οὐ δύναται συστῆναι.", "seq": 119}
{"id": "David_Passim_0120", "series": "CAG", "text": "καὶ δῆλον ἐντεῦθεν·", "seq": 120}
{"id": "David_Passim_0121", "series": "CAG", "text": "ἡ καθόλου γνῶσις καθόλου συμβεβηκός ἐστι (καὶ γὰρ ἡ γνῶσις συμβεβηκός τί ἐστι·", "seq": 121}
{"id": "David_Passim_0122", "series": "CAG", "text": "ποιότης γάρ ἐστιν, ἡ δὲ ποιότης, ὡς μαθησόμεθα, συμβεβηκός ἐστι)·", "seq": 122}
{"id": "David_Passim_0123", "series": "CAG", "text": "τὰ δὲ καθόλου συμβεβηκότα ἐν μερικῷ ὑποκειμένῳ οὐ δύναται θεωρεῖσθαι (καὶ γὰρ τὸ καθόλου λευκὸν οὐ δύναται ἐν κύκνῳ μόνῳ θεωρεῖσθαι, ἐπεὶ οὐκ ὤφειλεν ἐν ἄλλῳ τινὶ θεωρεῖσθαι, οἷον ἐν χιόνι ἢ ψιμυθίῳ ἢ γάλακτι)·", "seq": 123}
{"id": "David_Passim_0124", "series": "CAG", "text": "εἰ ἄρα οὖν ἡ φιλοσοφία καθόλου γνῶσίς ἐστι, δῆλον ὅτι οὐ δύναται ἐν μερικῷ ὑποκειμένῳ θεωρεῖσθαι, οἷον ἐν Σωκράτει, ἐν Πλάτωνι, ἐν Ἀλκιβιάδῃ·", "seq": 124}
{"id": "David_Passim_0125", "series": "CAG", "text": "εἰ δὲ οὐ θεωρεῖται ἐν ὑποκειμένῳ, δῆλον ὅτι οὐκ ἔστι·", "seq": 125}
{"id": "David_Passim_0126", "series": "CAG", "text": "τὰ γὰρ συμβεβηκότα μὴ ἐν ὑποκειμένῳ θεωρούμενα οὐκ εἰσί.", "seq": 126}
{"id": "David_Passim_0127", "series": "CAG", "text": "ταῦτα μὲν οὗτοι.", "seq": 127}
{"id": "David_Passim_0128", "series": "CAG", "text": "Ἔστι δὲ ἀνατρέψαι αὐτοὺς οὕτως·", "seq": 128}
{"id": "David_Passim_0129", "series": "CAG", "text": "ὅτι καὶ καθόλου γνῶσίς ἐστιν ἡ φιλοσοφία καὶ οὐκ ἀδύνατον αὐτὴν ἐν μερικῷ ὑποκειμένῳ θεωρεῖσθαι·", "seq": 129}
{"id": "David_Passim_0130", "series": "CAG", "text": "καὶ γὰρ εἰ καὶ τὰ καθόλου συμβεβηκότα οὐ δύναται ἐν μερικῷ ὑποκειμένῳ θεωρεῖσθαι, ἀλλ᾿ οὖν ἡ περὶ τούτων γνῶσις δύναται ἐν μερικῷ θεωρεῖσθαι, οἷον εἰ καὶ τὸ καθόλου λευκὸν οὐκ ἔγκειται ἐν τῷ Σωκράτει μόνῳ, ἀλλ᾿ οὖν ἡ περὶ τούτου γνῶσις δύναται ἐν τούτῳ μόνῳ ἐγκεῖσθαι·", "seq": 130}
{"id": "David_Passim_0131", "series": "CAG", "text": "δύναται γὰρ ὁ Σωκράτης γινώσκειν ὅτι λευκόν ἐστι χρῶμα διακριτικὸν ὄψεως.", "seq": 131}
{"id": "David_Passim_0132", "series": "CAG", "text": "καὶ πάλιν οὐδέποτε τὰ ἐναντία ἀμιγῆ καὶ ἄκρατα ὄντα ἐν τῷ αὐτῷ μορίῳ κατὰ τὸν αὐτὸν χρόνον δύναται θεωρεῖσθαι, οἷον τὸ λευκὸν καὶ τὸ μέλαν ἀμιγῆ καὶ ἄκρατα ὄντα οὐ δύναται ἐν τῷ αὐτῷ ὑποκειμένῳ κατὰ τὸν αὐτὸν χρόνον θεωρεῖσθαι·", "seq": 132}
{"id": "David_Passim_0133", "series": "CAG", "text": "οὐ δύναται γὰρ τὸ αὐτὸ μόριον κατὰ τὸν αὐτὸν χρόνον καὶ λευκὸν καὶ μέλαν εἶναι.", "seq": 133}
{"id": "David_Passim_0134", "series": "CAG", "text": "πρόσκειται δὲ τὸ ‘ἐν τῷ αὐτῷ μορίῳ’, ἐπειδὴ ἐν ἄλλῳ καὶ ἄλλῳ μορίῳ δύναται καὶ τὸ λευκὸν θεωρεῖσθαι καὶ τὸ μέλαν, ὥσπερ ἐπὶ τοῦ Αἰθίοπος·", "seq": 134}
{"id": "David_Passim_0135", "series": "CAG", "text": "καὶ γὰρ ὁ Αἰθίοψ κατὰ μὲν τοὺς ὀδόντας ἐστὶ λευκός, κατὰ δὲ τὸ λοιπὸν μέρος τοῦ σώματός ἐστι μέλας.", "seq": 135}
{"id": "David_Passim_0136", "series": "CAG", "text": "πρόσκειται δὲ ‘κατὰ τὸν αὐτὸν χρόνον’, ἐπειδὴ ἐν τῷ αὐτῷ μορίῳ δύναται καὶ τὸ λευκὸν θεωρεῖσθαι καὶ τὸ μέλαν κατ᾿ ἄλλον καὶ ἄλλον χρόνον.", "seq": 136}
{"id": "David_Passim_0137", "series": "CAG", "text": "πρόσκειται δὲ ‘ἀμιγῆ καὶ ἄκρατα ὄντα’ διὰ τὸ φαιόν, ὅ ἐστι τὸ μύινον, ἐπειδὴ ἐν τούτῳ θεωρεῖται καὶ τὸ μέλαν καὶ τὸ λευκόν, ἀλλ᾿ οὐκ εἰσὶν ἐκεῖ ἀμιγῆ καὶ ἄκρατα·", "seq": 137}
{"id": "David_Passim_0138", "series": "CAG", "text": "οὔτε γὰρ ἡ φύσις τοῦ λευκοῦ τελείως σώζεται οὔτε ἡ τοῦ μέλανος·", "seq": 138}
{"id": "David_Passim_0139", "series": "CAG", "text": "τὸ γὰρ φαιὸν μῖγμά ἐστι τοῦ λευκοῦ καὶ μέλανος.", "seq": 139}
{"id": "David_Passim_0140", "series": "CAG", "text": "καὶ ὅμως εἰ καὶ τὰ ἐναντία ἀμιγῆ καὶ ἄκρατα ὄντα οὐ δύναται ἐν τῷ αὐτῷ μορίῳ κατὰ τὸν αὐτὸν χρόνον θεωρεῖσθαι, ἀλλ᾿ οὖν ἡ περὶ τούτων γνῶσις δύναται ἐν ἑνὶ ὑποκειμένῳ θεωρεῖσθαι·", "seq": 140}
{"id": "David_Passim_0141", "series": "CAG", "text": "δύναται γὰρ ὁ αὐτὸς γινώσκειν ὅτι λευκόν ἐστι χρῶμα διακριτικὸν ὄψεως, ἤγουν χρῶμα διαχέον τὴν ὄψιν (καὶ γὰρ τὸ χρῶμα τὸ λευκὸν διαχέει τὴν ὅρασιν), καὶ ὅτι μέλαν ἐστὶ χρῶμα συγκριτικὸν ὄψεως, ἤγουν χρῶμα συνάγον τὴν ὄψιν·", "seq": 141}
{"id": "David_Passim_0142", "series": "CAG", "text": "καὶ γὰρ τὴν ὅρασιν τὴν διαχυθεῖσαν διὰ τοῦ μέλανος ἀνακαλούμεθα, ὅθεν καὶ οἱ ὀφθαλμιῶντες πανίον μέλαν ἐπιτιθέασι τοῖς ὀφθαλμοῖς αὐτῶν διὰ τὸ τὴν ὅρασιν τὴν διαχυθεῖσαν συναγαγεῖν.", "seq": 142}
{"id": "David_Passim_0143", "series": "CAG", "text": "οὕτως οὖν εἰ καὶ τὰ καθόλου οὐ δύναται ἐν μερικῷ ὑποκειμένῳ θεωρεῖσθαι, ἀλλ᾿ οὖν ἡ περὶ τούτων γνῶσις δύναται ἐν μερικῷ θεωρεῖσθαι ὑποκειμένῳ·", "seq": 143}
{"id": "David_Passim_0144", "series": "CAG", "text": "δύναται γὰρ ὁ Σωκράτης γινώσκειν τὰ καθόλου, οἷον τί ἐστιν ἄνθρωπος, τί ἐστιν ἵππος, τί ἐστι λίθος.", "seq": 144}
{"id": "David_Passim_0145", "series": "CAG", "text": "Οὕτως οὖν ἀνατρέψαντες καὶ τὸ τέταρτον αὐτῶν ἐπιχείρημα ἔλθωμεν καὶ δείξωμεν ὅτι ἔστιν ἡ φιλοσοφία·", "seq": 145}
{"id": "David_Passim_0146", "series": "CAG", "text": "δεῖ γὰρ μὴ μόνον τὰ τῶν ἐναντίων ἀνασκευάζειν ἀλλὰ καὶ τὰ οἰκεῖα κατασκευάζειν.", "seq": 146}
{"id": "David_Passim_0147", "series": "CAG", "text": "δείκνυμεν δὲ ὅτι ἔστιν ἡ φιλοσοφία τοῦτον τὸν τρόπον·", "seq": 147}
{"id": "David_Passim_0148", "series": "CAG", "text": "εἰ ἔστι θεός, ἔστι καὶ πρόνοια·", "seq": 148}
{"id": "David_Passim_0149", "series": "CAG", "text": "οὐ μόνον γὰρ ἔστι θεός, ἀλλὰ καὶ προνοεῖται.", "seq": 149}
{"id": "David_Passim_0150", "series": "CAG", "text": "ἀλλὰ μὴν ἔστι θεός·", "seq": 150}
{"id": "David_Passim_0151", "series": "CAG", "text": "μεμηνότων γάρ ἐστι τὸ λέγειν ὅτι οὐκ ἔστι θεός·", "seq": 151}
{"id": "David_Passim_0152", "series": "CAG", "text": "δῆλον οὖν ὅτι ἔστι καὶ πρόνοια.", "seq": 152}
{"id": "David_Passim_0153", "series": "CAG", "text": "εἰ δὲ πρόνοια, δῆλον ὅτι ἔστι καὶ σοφία, δι᾿ ἧς προνοεῖται ὁ θεός·", "seq": 153}
{"id": "David_Passim_0154", "series": "CAG", "text": "οὐ γὰρ ἀλόγως προνοεῖται θεὸς οὐδὲ ἄνευ σοφίας.", "seq": 154}
{"id": "David_Passim_0155", "series": "CAG", "text": "εἰ δὲ ἔστι σοφία, δῆλον ὅτι ἔστι καὶ ἔφεσις αὐτῆς καὶ ἐπιθυμία·", "seq": 155}
{"id": "David_Passim_0156", "series": "CAG", "text": "πᾶς γὰρ τοῦ ἀγαθοῦ ἐφίεται, ὅθεν καὶ ἀγαθὸν λέγεται παρὰ τὸ ἄγαν θέειν ἡμᾶς ἐπ᾿ αὐτό.", "seq": 156}
{"id": "David_Passim_0157", "series": "CAG", "text": "εἰ δὲ ἔφεσις αὐτῆς καὶ ἐπιθυμία, δῆλον ὅτι καὶ ἡ φιλοσοφία ἔστιν·", "seq": 157}
{"id": "David_Passim_0158", "series": "CAG", "text": "οὐδὲν γὰρ ἕτερόν ἐστιν ἡ φιλοσοφία ἢ φιλία σοφίας, ὡς ὁ Πυθαγόρας ὁρίζεται.", "seq": 158}
{"id": "David_Passim_0159", "series": "CAG", "text": "ἐν οἷς καὶ ἡ παροῦσα πρᾶξις.", "seq": 159}
{"id": "David_Passim_0160", "series": "CAG", "text": "πρᾶξις δ΄.", "seq": 160}
{"id": "David_Passim_0161", "series": "CAG", "text": "Εἰ καὶ πάρεργον ἦν τὸ ζητῆσαι ἐπὶ τῆς φιλοσοφίας τὸ εἰ ἔστιν, ἀλλ᾿ οὖν τῇ ἀληθείᾳ συμμάχῳ χρησάμενοι τοὺς λόγους τῶν πειραθέντων τὴν ὕπαρξιν ἀνελεῖν τῆς φιλοσοφίας ὡς ἀσθενεῖς ἀνετρέψαμεν·", "seq": 161}
{"id": "David_Passim_0162", "series": "CAG", "text": "καὶ γὰρ οἷς ἔρις ὁ βίος ἐστίν (οὗτοι δέ εἰσιν οἱ Πυρρώνειοι οἱ πάντα ἀνατρέπειν πειρώμενοι), τὴν μητέρα τῶν ἀποδείξεων, φημὶ δὴ τὴν φιλοσοφίαν, δι᾿ ἀποδείξεων ἠβούλοντο ἀνατρέπειν καί, ὡς ἄν τις εἴποι, τὴν φιλοσοφίαν διὰ φιλοσοφίας ἀνέτρεπον.", "seq": 162}
{"id": "David_Passim_0163", "series": "CAG", "text": "πρὸς οὓς ἀπαντᾷ ὁ Πλάτων λέγοντας μὴ εἶναι κατάληψιν·", "seq": 163}
{"id": "David_Passim_0164", "series": "CAG", "text": "πῶς φατε μὴ εἶναι κατάληψιν ὡς κατειληφότες ἢ ὡς μὴ κατειληφότες;", "seq": 164}
{"id": "David_Passim_0165", "series": "CAG", "text": "καὶ εἰ μὲν ὡς καταλαβόντες, δῆλον ὅτι ἔστι κατάληψις, ἐπειδὴ κατελάβετε·", "seq": 165}
{"id": "David_Passim_0166", "series": "CAG", "text": "εἰ δὲ ὡς μὴ κατειληφότες, τίς ὑμῖν πιστεύσει τοιαῦτα λέγουσιν, ἃ μὴ κατελάβετε μηδὲ ἐπίστασθε;", "seq": 166}
{"id": "David_Passim_0167", "series": "CAG", "text": "καὶ ὁ Ἀριστοτέλης δὲ ἔν τινι Προτρεπτικῷ αὐτοῦ συγγράμματι, ἐν ᾧ προτρέπεται τοὺς νέους ἐπὶ φιλοσοφίαν, λέγει ὅτι εἴτε μὴ φιλοσοφητέον, φιλοσοφητέον, εἴτε φιλοσοφητέον, φιλοσοφητέον·", "seq": 167}
{"id": "David_Passim_0168", "series": "CAG", "text": "πάντως δὲ φιλοσοφητέον.", "seq": 168}
{"id": "David_Passim_0169", "series": "CAG", "text": "τοῦτ᾿ ἔστιν εἴτε λέγει τις μὴ εἶναι φιλοσοφίαν, ἀποδείξεσι κέχρηται, δι᾿ ὧν ἀναιρεῖ τὴν φιλοσοφίαν·", "seq": 169}
{"id": "David_Passim_0170", "series": "CAG", "text": "εἰ δὲ ἀποδείξεσι κέχρηται, δῆλον ὅτι φιλοσοφεῖ (μήτηρ γὰρ τῶν ἀποδείξεων ἡ φιλοσοφία)·", "seq": 170}
{"id": "David_Passim_0171", "series": "CAG", "text": "εἴτε λέγει εἶναι φιλοσοφίαν, πάλιν φιλοσοφεῖ·", "seq": 171}
{"id": "David_Passim_0172", "series": "CAG", "text": "ἀποδείξεσι γὰρ κέχρηται, δι᾿ ὧν δείκνυσιν οὖσαν αὐτήν.", "seq": 172}
{"id": "David_Passim_0173", "series": "CAG", "text": "πάντως οὖν φιλοσοφεῖ καὶ ὁ ἀναιρῶν αὐτὴν καὶ ὁ μὴ ἀναιρῶν·", "seq": 173}
{"id": "David_Passim_0174", "series": "CAG", "text": "ἑκάτερος γὰρ αὐτῶν ἀποδείξεσι κέχρηται, δι᾿ ὧν πιστοῦται τὰ λεγόμενα·", "seq": 174}
{"id": "David_Passim_0175", "series": "CAG", "text": "εἰ δὲ ἀποδείξεσι κέχρηται, δῆλον ὅτι φιλοσοφεῖ·", "seq": 175}
{"id": "David_Passim_0176", "series": "CAG", "text": "μήτηρ γὰρ τῶν ἀποδείξεων ἡ φιλοσοφία.", "seq": 176}
{"id": "David_Passim_0177", "series": "CAG", "text": "Παρέντες οὖν τὸ εἰ ἔστιν ἔλθωμεν ἐπὶ τὸ τί ἐστι καὶ εἴπωμεν τί ἐστιν ἡ φιλοσοφία.", "seq": 177}
{"id": "David_Passim_0178", "series": "CAG", "text": "ἰστέον δὲ ὅτι ἡ φιλοσοφία καὶ ἕν τί ἐστιν ὡς ὅλη ἐξεταζομένη καὶ πεπληθυσμένη ἐστὶν ὡς διάφορα μέρη ἔχουσα.", "seq": 178}
{"id": "David_Passim_0179", "series": "CAG", "text": "ὡς οὖν ἕν τι οὖσαν αὐτὴν ὁριζόμεθα, ὡς δὲ πεπληθυσμένην διαιροῦμεν·", "seq": 179}
{"id": "David_Passim_0180", "series": "CAG", "text": "ἄτοπον γάρ ἐστιν ἐπὶ μὲν τῶν ἄλλων τεχνῶν ὅρον παραδοῦναι καὶ διαίρεσιν, ἐπὶ δὲ τῆς φιλοσοφίας μὴ παραδοῦναι μήτε ὅρον μήτε διαίρεσιν, ἐξ ἧσπερ πᾶσαι αἱ τέχναι προέρχονται.", "seq": 180}
{"id": "David_Passim_0181", "series": "CAG", "text": "ἰστέον δὲ ὅτι καὶ τοῦ ὅρου καὶ τῆς διαιρέσεως μέμνηται ὁ Πλάτων, καὶ τοῦ μὲν ὅρου ἐν Φαίδρῳ τῷ διαλόγῳ λέγων ὅτι ‘ὦ παῖ, μία ἐστὶν ἀρχὴ τοῦ καλῶς βουλεύεσθαι, τὸ εἰδέναι περὶ ὅτου ἐστὶν ἡ σκέψις, ἢ τοῦ παντὸς ἁμαρτάνειν ἀνάγκη’, τοῦτ᾿ ἔστιν ὅτι ὁ θέλων καλῶς περί τινος βουλεύσασθαι ὀφείλει εἰδέναι τὴν φύσιν αὐτοῦ τοῦ πράγματος, ἤγουν τὸν ὅρον·", "seq": 181}
{"id": "David_Passim_0182", "series": "CAG", "text": "ὁ γὰρ μὴ τοῦτο γινώσκων πάντως τοῦ πράγματος ἐκείνου ἀποτυγχάνει.", "seq": 182}
{"id": "David_Passim_0183", "series": "CAG", "text": "οἷον ἐάν τις βουλόμενός τι περὶ ἰατρικῆς διαλαβεῖν μὴ γνῷ τὴν φύσιν τῆς ἰατρικῆς, τοῦτ᾿ ἔστιν ὅτι περὶ τὰ ἀνθρώπεια σώματα καταγίνεται, ἀλλὰ νομίσῃ αὐτὴν περὶ ξύλα καταγίνεσθαι, πάντας τοὺς περὶ αὐτῆς καταβαλλομένους λόγους μάτην καταβάλλεται.", "seq": 183}
{"id": "David_Passim_0184", "series": "CAG", "text": "τῆς δὲ διαιρέσεως μέμνηται ἐν τῷ Σοφιστῇ τῷ διαλόγῳ λέγων ‘τὴν δὲ διαιρετικὴν μέθοδον οὐδὲν ἐγκαυχήσεται φυγόν’·", "seq": 184}
{"id": "David_Passim_0185", "series": "CAG", "text": "καὶ γὰρ οὐδὲν ἐκφεύγει τὴν διαίρεσιν·", "seq": 185}
{"id": "David_Passim_0186", "series": "CAG", "text": "ἐὰν γὰρ εἴπω ὅτι τῶν ζῴων τὰ μέν εἰσι λογικὰ τὰ δὲ ἄλογα, οὐδέν ἐστι παρὰ τοῦτο·", "seq": 186}
{"id": "David_Passim_0187", "series": "CAG", "text": "οὐδὲν γάρ ἐστι ζῷον μὴ ὂν λογικὸν ἢ ἄλογον.", "seq": 187}
{"id": "David_Passim_0188", "series": "CAG", "text": "καὶ πάλιν δὲ ὁ αὐτὸς ἐν τῷ αὐτῷ διαλόγῳ περὶ τῆς διαιρέσεως ταῦτά φησι, τὴν διαιρετικὴν δεδωρῆσθαι ἡμῖν διὰ Προμηθέως σὺν φανοτάτῳ πυρί·", "seq": 188}
{"id": "David_Passim_0189", "series": "CAG", "text": "ἰστέον γὰρ ὅτι μυθεύοντες λέγουσιν ὅτι ὁ Προμηθεὺς ἔκλεψεν ἐκ τῶν θεῶν τὸ πῦρ καὶ ἐδωρήσατο τοῖς ἀνθρώποις·", "seq": 189}
{"id": "David_Passim_0190", "series": "CAG", "text": "τοῦτο γὰρ ἀλληγορεῖται·", "seq": 190}
{"id": "David_Passim_0191", "series": "CAG", "text": "ἐπειδὴ γὰρ ὁ Προμηθεὺς πρῶτος ἐφεῦρε τὴν διαιρετικὴν μέθοδον, ἡ δὲ διαιρετικὴ μέθοδος τῷ πυρὶ ἀναλογεῖ, τούτου χάριν λέγουσιν αὐτὸν τὸ πῦρ δωρήσασθαι τοῖς ἀνθρώποις.", "seq": 191}
{"id": "David_Passim_0192", "series": "CAG", "text": "ὅτι δὲ ἡ διαιρετικὴ μέθοδος τῷ πυρὶ ἀναλογεῖ, δῆλον ἐντεῦθεν·", "seq": 192}
{"id": "David_Passim_0193", "series": "CAG", "text": "ὥσπερ γὰρ τὸ πῦρ καὶ τὰ ὁμοιογενῆ διακρίνει ἀπ᾿ ἀλλήλων καὶ τὰ ἀνομοιογενῆ, καὶ τὰ ὁμοιογενῆ μὲν οἷον τὰ μέταλλα (ταῦτα γὰρ διὰ τοῦ πυρὸς διακρίνονται ἀπ᾿ ἀλλήλων·", "seq": 193}
{"id": "David_Passim_0194", "series": "CAG", "text": "καὶ γὰρ διὰ τοῦ πυρὸς διακρίνεται ὁ ἄργυρος ἐκ τοῦ χρυσοῦ καὶ ὁ μόλιβδος ἐκ τοῦ χαλκοῦ·", "seq": 194}
{"id": "David_Passim_0195", "series": "CAG", "text": "ταῦτα δὲ ὁμοιογενῆ εἰσι, καθὸ μέταλλά εἰσι πάντα), ἀνομοιογενῆ δέ, ὡς ὅταν διὰ τοῦ πυρὸς διακρίνηται ὁ ῥύπος ἐκ τῶν μετάλλων (ὁ γὰρ ῥύπος καὶ τὸ μέταλλον ἀνομοιογενῆ εἰσι)·", "seq": 195}
{"id": "David_Passim_0196", "series": "CAG", "text": "τὸν αὐτὸν τρόπον καὶ ἡ διαίρεσις διακρίνει τά τε ὁμοιογενῆ ἀπ᾿ ἀλλήλων καὶ τὰ ἀνομοιογενῆ·", "seq": 196}
{"id": "David_Passim_0197", "series": "CAG", "text": "ὁμοιογενῆ μέν, ὡς ὅταν τὸ ζῷον διαιρῶμεν εἰς λογικὸν καὶ ἄλογον, θνητὸν καὶ ἀθάνατον (καὶ διὰ μὲν τοῦ λογικοῦ διακρίνομεν τὸ ἄλογον, διὰ δὲ τοῦ θνητοῦ τὸ ἀθάνατον·", "seq": 197}
{"id": "David_Passim_0198", "series": "CAG", "text": "ταῦτα δὲ ὁμοιογενῆ εἰσι, καθὸ πάντα ζῷά εἰσιν), ἀνομοιογενῆ δέ, ὡς ὅταν διαιροῦντες διαχωρίσωμεν τὸν δέκα ἀριθμὸν ἀπὸ τῆς γραμματικῆς, λέγοντες ὅτι ἡ μὲν γραμματικὴ ὑπὸ τὸ ποιὸν ἀνάγεται (ποιότης γάρ τίς ἐστιν), ὁ δὲ δέκα ἀριθμὸς ὑπὸ τὸ ποσόν (ποσότης γάρ ἐστι)·", "seq": 198}
{"id": "David_Passim_0199", "series": "CAG", "text": "ταῦτα δὲ ἀνομοιογενῆ εἰσιν·", "seq": 199}
{"id": "David_Passim_0200", "series": "CAG", "text": "οὐκ ἀνάγονται γὰρ ὑπὸ τὸ αὐτὸ γένος·", "seq": 200}
{"id": "David_Passim_0201", "series": "CAG", "text": "ὁ γὰρ δέκα ἀριθμὸς ὑπὸ τὸν ἀριθμὸν ἀνάγεται, ὁ δὲ ἀριθμὸς ὑπὸ τὸ ποσὸν ἀνάγεται·", "seq": 201}
{"id": "David_Passim_0202", "series": "CAG", "text": "ἡ δὲ γραμματικὴ οὐκ ἀνάγεται ὑπὸ τὸ ποσόν, ἀλλ᾿ ὑπὸ τὴν καθόλου τέχνην, ἡ δὲ τέχνη ὑπὸ τὴν ἐπιστήμην, ἡ δὲ ἐπιστήμη ὑπὸ τὴν ἕξιν, ἡ δὲ ἕξις ὑπὸ τὴν ποιότητα.", "seq": 202}
{"id": "David_Passim_0203", "series": "CAG", "text": "Τούτου οὖν οὕτως ἔχοντος εἴπωμεν ὅρον τῆς φιλοσοφίας καὶ διαίρεσιν αὐτῆς ποιησώμεθα.", "seq": 203}
{"id": "David_Passim_0204", "series": "CAG", "text": "ἀλλὰ ζητήσωμεν ποῖον δεῖ πρῶτον ποιῆσαι·", "seq": 204}
{"id": "David_Passim_0205", "series": "CAG", "text": "ἆρα ὅρον αὐτῆς ἀποδοῦναι δεῖ πρῶτον ἢ διαίρεσιν αὐτῆς ποιήσασθαι;", "seq": 205}
{"id": "David_Passim_0206", "series": "CAG", "text": "καὶ ἔστιν εἰπεῖν ὅτι πρῶτον δεῖ ὁρίσασθαι αὐτὴν καὶ εἶθ᾿ οὕτως διελεῖν αὐτὴν διὰ τοιαύτην αἰτίαν·", "seq": 206}
{"id": "David_Passim_0207", "series": "CAG", "text": "ὁ ὅρος ἀναλογεῖ τῇ μονάδι, ἡ δὲ διαίρεσις τῷ πλήθει·", "seq": 207}
{"id": "David_Passim_0208", "series": "CAG", "text": "ὥσπερ οὖν ἡ μονὰς προτερεύει τοῦ πλήθους, τὸν αὐτὸν τρόπον καὶ ὁ ὅρος ἀναλογῶν τῇ μονάδι προτερεύει τῆς διαιρέσεως τῆς ἀναλογούσης τῷ πλήθει·", "seq": 208}
{"id": "David_Passim_0209", "series": "CAG", "text": "ὅτι μὲν γὰρ ὁ ὅρος ἀναλογεῖ τῇ μονάδι ἡ δὲ διαίρεσις τῷ πλήθει, δῆλον ἐντεῦθεν·", "seq": 209}
{"id": "David_Passim_0210", "series": "CAG", "text": "ὥσπερ ἡ μονὰς ἕν τί ἐστι καὶ μία φύσις, τὸν αὐτὸν τρόπον καὶ ὁ ὅρος τὰ πολλὰ ἕν τι ποιεῖ καὶ μίαν φύσιν ἀποτελεῖ (καὶ γὰρ τὸ ζῷον λογικὸν θνητὸν νοῦ καὶ ἐπιστήμης δεκτικὸν ἕν τι καὶ μίαν φύσιν ἀποτελεῖ, τὸν ἄνθρωπον), ἡ δὲ διαίρεσις τοὐναντίον τὸ ἓν πολλὰ ποιεῖ·", "seq": 210}
{"id": "David_Passim_0211", "series": "CAG", "text": "καὶ γὰρ λαμβάνουσα τὴν οὐσίαν διαιρεῖ αὐτὴν εἰς σῶμα καὶ ἀσώματον καὶ τὸ σῶμα εἰς ἔμψυχον καὶ ἄψυχον, καὶ τὰ ἑξῆς ὁμοίως.", "seq": 211}
{"id": "David_Passim_0212", "series": "CAG", "text": "Ἔλθωμεν οὖν καὶ ὁρισώμεθα τὴν φιλοσοφίαν.", "seq": 212}
{"id": "David_Passim_0213", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ ὥσπερ ἀδύνατόν ἐστί τινα πλέξαι συλλογισμόν, εἰ μὴ πρότερον μάθῃ τί ἐστι συλλογισμὸς καὶ πόθεν γίνεται, τὸν αὐτὸν τρόπον καὶ ὁρίσασθαί τι ἀδύνατόν ἐστί τινα, εἰ μὴ πρότερον μάθῃ τί ἐστιν ὅρος καὶ πόθεν λαμβάνεται·", "seq": 213}
{"id": "David_Passim_0214", "series": "CAG", "text": "τοῦτο γινώσκοντες ἐννέα κεφάλαια παραδίδομεν.", "seq": 214}
{"id": "David_Passim_0215", "series": "CAG", "text": "καὶ πρῶτον μέν ἐστι κεφάλαιον ἐν ᾧ λέγομεν τί ἐστιν ὁρισμός, δεύτερον δὲ ἐν ᾧ λέγομεν τί διαφέρει ὁρισμὸς ὅρου καὶ ὑπογραφῆς καὶ ὑπογραφικοῦ ὁρισμοῦ, τρίτον ἐν ᾧ λέγομεν πόθεν λέγεται ὁρισμός, τέταρτον ἐν ᾧ λέγομεν πόθεν λαμβάνονται οἱ ὁρισμοί, πέμπτον ἐν ᾧ λέγομεν ποῖος τέλειος καὶ ποῖος ἀτελὴς ὁρισμὸς καὶ τίς ἡ κακία καὶ τίς ἡ ὑγίεια τοῦ ὁρισμοῦ, ἕκτον ἐν ᾧ λέγομεν πόσοι ὁρισμοὶ τῆς φιλοσοφίας, ἕβδομον ἐν ᾧ λέγομεν διὰ τί τοσοῦτοί εἰσιν οἱ τῆς φιλοσοφίας ὁρισμοὶ καὶ μήτε πλείους μήτε ἐλάττους, ὄγδοον ἐν ᾧ λέγομεν τὴν τάξιν αὐτῶν, ἔνατον ἐν ᾧ λέγομεν τίνες ἐφεῦρον τοὺς ὁρισμοὺς τούτους.", "seq": 215}
{"id": "David_Passim_0216", "series": "CAG", "text": "ἐν οἷς καὶ ἡ παροῦσα πρᾶξις.", "seq": 216}
{"id": "David_Passim_0217", "series": "CAG", "text": "Πρᾶξις ἑ΄.", "seq": 217}
{"id": "David_Passim_0218", "series": "CAG", "text": "Ἀρξώμεθα τοῦ πρώτου κεφαλαίου καὶ εἴπωμεν τί ἐστιν ὁρισμός.", "seq": 218}
{"id": "David_Passim_0219", "series": "CAG", "text": "ἰστέον ὅτι ὁρισμός ἐστι λόγος σύντομος δηλωτικὸς τῆς φύσεως τοῦ ὑποκειμένου πράγματος.", "seq": 219}
{"id": "David_Passim_0220", "series": "CAG", "text": "ἀλλ᾿ ἐπειδή, ὡς μαθησόμεθα, οἱ ὅροι εἰώθασιν ἀπὸ γένους καὶ συστατικῶν διαφορῶν λαμβάνεσθαι, εἴπωμεν ποία λέξις ἐν τῷ παρόντι ὁρισμῷ ἀναλογεῖ τῷ γένει καὶ ποία ταῖς συστατικαῖς διαφοραῖς.", "seq": 220}
{"id": "David_Passim_0221", "series": "CAG", "text": "ἀλλ᾿ ἵνα σαφὴς ἡμῖν ἡ διδασκαλία γένηται, χρησώμεθα παραδείγματι τῷ ὅρῳ τοῦ ἀνθρώπου.", "seq": 221}
{"id": "David_Passim_0222", "series": "CAG", "text": "ἰστέον ὅτι ὁ ἄνθρωπός ἐστι ζῷον λογικὸν θνητὸν νοῦ καὶ ἐπιστήμης δεκτικόν·", "seq": 222}
{"id": "David_Passim_0223", "series": "CAG", "text": "ἰδοὺ ἐνταῦθα τὸ μὲν ζῷον ἀντὶ γένους εἴληπται (κοινότερον γάρ ἐστι καὶ κατὰ πλειόνων φέρεται·", "seq": 223}
{"id": "David_Passim_0224", "series": "CAG", "text": "φέρεται γὰρ κατά τε ἀνθρώπου καὶ κυνὸς καὶ ἵππου καὶ τῶν τοιούτων), αἱ δὲ λοιπαὶ λέξεις ἀντὶ συστατικῶν διαφορῶν παραλαμβάνονται.", "seq": 224}
{"id": "David_Passim_0225", "series": "CAG", "text": "οὕτως οὖν καὶ ἐν τῷ ὁρισμῷ τούτῳ τοῦ ὁρισμοῦ ὁ μὲν ‘λόγος’ ἀντὶ γένους εἴληπται (κοινότερος γάρ ἐστι καὶ κατὰ πλειόνων φέρεται·", "seq": 225}
{"id": "David_Passim_0226", "series": "CAG", "text": "φέρεται γὰρ κατά τε τοῦ ἐνδιαθέτου καὶ προφορικοῦ), αἱ δὲ λοιπαὶ λέξεις ἀντὶ συστατικῶν διαφορῶν παραλαμβάνονται.", "seq": 226}
{"id": "David_Passim_0227", "series": "CAG", "text": "ἔλθωμεν οὖν καὶ ἐξηγησώμεθα.", "seq": 227}
{"id": "David_Passim_0228", "series": "CAG", "text": "ἰστέον ὅτι ὁ λόγος πρόσκειται πρὸς ἀντιδιαστολὴν τοῦ ὀνόματος·", "seq": 228}
{"id": "David_Passim_0229", "series": "CAG", "text": "καὶ γὰρ καὶ τὸ ὄνομα δηλοῖ τὴν φύσιν τοῦ ὑποκειμένου πράγματος, οἷον τὸ ἄνθρωπος, καὶ ὅπερ ὁ ὅρος ποιεῖ διὰ πλειόνων λέξεων, τοῦτο τὸ ὄνομα ποιεῖ διὰ μιᾶς λέξεως.", "seq": 229}
{"id": "David_Passim_0230", "series": "CAG", "text": "ὅθεν καὶ ἀνθορίζονται·", "seq": 230}
{"id": "David_Passim_0231", "series": "CAG", "text": "ὄνομα μὲν γάρ, φάσιν, ἐστὶν ὅρος συνεσταλμένος, τοῦτ᾿ ἔστι κατὰ σύνοψιν ἤγουν ἐν συντόμῳ, ὅρος δέ ἐστιν ὄνομα ἐξηπλωμένον.", "seq": 231}
{"id": "David_Passim_0232", "series": "CAG", "text": "ἵνα οὖν χωρισθῇ τὸ ὄνομα, πρόσκειται λόγος.", "seq": 232}
{"id": "David_Passim_0233", "series": "CAG", "text": "καὶ εἰ ἄρα ὅπερ ποιεῖ τὸ ὄνομα, ποιεῖ καὶ ὁ ὅρος (καὶ γὰρ καὶ τὸ ὄνομα καὶ ὁ ὅρος τὴν φύσιν τοῦ ὑποκειμένου πράγματος δηλοῦσι), διὰ τί ἐπενοήθη ὁ ὅρος;", "seq": 233}
{"id": "David_Passim_0234", "series": "CAG", "text": "καὶ λέγομεν διὰ τὸ γνῶναι ἡμᾶς τὰς συστατικὰς διαφοράς, τοῦτ᾿ ἔστι τὰ συστατικὰ τοῦ ὑποκειμένου πράγματος·", "seq": 234}
{"id": "David_Passim_0235", "series": "CAG", "text": "ἐὰν μὲν γὰρ εἴπωμεν ἄνθρωπος, οὐ γινώσκομεν τὰς συστατικὰς διαφοράς, ἐὰν δὲ εἴπωμεν ζῷον λογικὸν καὶ τὰ ἑξῆς, οἴδαμεν ταύτας.", "seq": 235}
{"id": "David_Passim_0236", "series": "CAG", "text": "‘σύντομος’ δὲ πρόσκειται διὰ τοὺς ἐκτεταμένους λόγους, οἷον διὰ τὸν Περὶ στεφάνου, καὶ τοὺς διηγηματικοὺς λόγους·", "seq": 236}
{"id": "David_Passim_0237", "series": "CAG", "text": "οὗτοι γὰρ λόγοι εἰσίν, ἀλλ᾿ οὐ σύντομοι.", "seq": 237}
{"id": "David_Passim_0238", "series": "CAG", "text": "‘δηλωτικὸς δὲ τῆς φύσεως τοῦ ὑποκειμένου πράγματος’ πρόσκειται ἢ διὰ τὰ ἀποφθέγματα οἷον διὰ τὸ ‘μηδὲν ἄγαν’ καὶ ‘γνῶθι σαυτόν’ (ταῦτα γὰρ λόγοι εἰσὶν καὶ σύντομοι, ἀλλ᾿ οὐ δηλοῦσι τὴν φύσιν τοῦ ὑποκειμένου πράγματος), ἢ διὰ τὰς ὑπογραφάς·", "seq": 238}
{"id": "David_Passim_0239", "series": "CAG", "text": "αὗται γὰρ οὐ δηλοῦσι τὴν φύσιν τοῦ ὑποκειμένου πράγματος ἀλλὰ τὰ περὶ τὴν φύσιν καὶ τὰ παρεπόμενα αὐτῇ, οἷον ὡς ὅταν εἴπω ‘ἄνθρωπός ἐστιν ὀρθοπεριπατητικὸν γελαστικὸν πλατυώνυχον’·", "seq": 239}
{"id": "David_Passim_0240", "series": "CAG", "text": "ταῦτα γὰρ τὰ παρεπόμενα αὐτῷ δηλοῦσιν.", "seq": 240}
{"id": "David_Passim_0241", "series": "CAG", "text": "ἐν οἷς τὸ πρῶτον κεφάλαιον.", "seq": 241}
{"id": "David_Passim_0242", "series": "CAG", "text": "Ἔλθωμεν δὲ καὶ ἐπὶ τὸ δεύτερον καὶ εἴπωμεν τί διαφέρει ὁρισμὸς ὑπογραφῆς καὶ ὅρου καὶ ὑπογραφικοῦ ὁρισμοῦ.", "seq": 242}
{"id": "David_Passim_0243", "series": "CAG", "text": "ἰστέον ὅτι ὁρισμὸς ὑπογραφῆς διαφέρει, ὅτι ὁ μὲν ὁρισμὸς ἐξ οὐσιωδῶν φωνῶν λαμβάνεται καὶ τὴν οὐσίαν αὐτὴν καὶ τὴν φύσιν τοῦ ὑποκειμένου πράγματος δηλοῖ, οἷον ἄνθρωπός ἐστι ζῷον λογικὸν θνητὸν νοῦ καὶ ἐπιστήμης δεκτικόν, ἡ δὲ ὑπογραφὴ ἀπὸ συμβεβηκότων λαμβάνεται καὶ τὰ παρεπόμενα τῷ ὑποκειμένῳ πράγματι καὶ τὰ περὶ τὴν φύσιν αὐτοῦ δηλοῖ, οἷον ὡς ὅταν εἴπω ‘ἄνθρωπός ἐστιν ὀρθοπεριπατητικὸν γελαστικὸν πλατυώνυχον’.", "seq": 243}
{"id": "David_Passim_0244", "series": "CAG", "text": "ἐπειδὴ δὲ εἰρήκαμεν ὅτι ὁ μὲν ὁρισμὸς ἀπὸ οὐσιωδῶν φωνῶν λαμβάνεται, ἡ δὲ ὑπογραφὴ ἀπὸ συμβεβηκότων, μάθωμεν τί ἐστιν οὐσιῶδες καὶ τί συμβεβηκός.", "seq": 244}
{"id": "David_Passim_0245", "series": "CAG", "text": "ἰστέον ὅτι οὐσιῶδές ἐστιν ὃ παρὸν μὲν σώζει τὸν ἄνθρωπον, ἀπὸν δὲ φθείρει, ὥσπερ τὸ λογικόν·", "seq": 245}
{"id": "David_Passim_0246", "series": "CAG", "text": "τοῦτο γὰρ παρὸν μὲν σώζει τὸν ἄνθρωπον, ἀπὸν δὲ φθείρει·", "seq": 246}
{"id": "David_Passim_0247", "series": "CAG", "text": "ἀδύνατον γὰρ εἶναι ἄνθρωπον <καὶ> μὴ εἶναι λογικόν.", "seq": 247}
{"id": "David_Passim_0248", "series": "CAG", "text": "συμβεβηκὸς δέ ἐστιν ὃ οὔτε παρὸν σώζει οὔτε ἀπὸν φθείρει αὐτόν, ὥσπερ τὸ λευκόν·", "seq": 248}
{"id": "David_Passim_0249", "series": "CAG", "text": "τοῦτο γὰρ οὔτε παρὸν σώζει οὔτε ἀπὸν φθείρει τὸν ἄνθρωπον·", "seq": 249}
{"id": "David_Passim_0250", "series": "CAG", "text": "δύναται γὰρ ἄνθρωπος καὶ εἶναι λευκὸς καὶ μὴ εἶναι λευκός·", "seq": 250}
{"id": "David_Passim_0251", "series": "CAG", "text": "οὐδὲ γὰρ ἐὰν μή ἐστι λευκός, παρὰ τοῦτο οὐκ ἔστιν ἄνθρωπος.", "seq": 251}
{"id": "David_Passim_0252", "series": "CAG", "text": "καὶ πάλιν ὥσπερ τὸ ὀρθοπεριπατητικὸν καὶ πλατυώνυχον·", "seq": 252}
{"id": "David_Passim_0253", "series": "CAG", "text": "ταῦτα γὰρ οὔτε παρόντα σώζουσιν οὔτε ἀπόντα φθείρουσι τὸν ἄνθρωπον·", "seq": 253}
{"id": "David_Passim_0254", "series": "CAG", "text": "κἂν γὰρ μή ἐστιν ὀρθοπεριπατητικὸν ὁ ἄνθρωπος, ἀλλὰ τετραποδίζει, καὶ εἰ μὴ ἔχει ὄνυχας, οὐδὲν ἧττον ἄνθρωπός ἐστι.", "seq": 254}
{"id": "David_Passim_0255", "series": "CAG", "text": "Ταῦτα εἰπόντες ἔλθωμεν καὶ εἴπωμεν τί διαφέρει ὁρισμοῦ ὅρος.", "seq": 255}
{"id": "David_Passim_0256", "series": "CAG", "text": "ἰστέον ὅτι ὥσπερ ὁ ἄνθρωπος καὶ τὸ ζῷον καθολικῷ καὶ μερικῷ διαφέρουσιν ἀλλήλων (καὶ γὰρ ὁ μὲν ἄνθρωπος μερικώτερός ἐστι, τὸ δὲ ζῷον καθολικώτερον·", "seq": 256}
{"id": "David_Passim_0257", "series": "CAG", "text": "εἴ τι μὲν γὰρ ἄνθρωπος, τοῦτο καὶ ζῷον·", "seq": 257}
{"id": "David_Passim_0258", "series": "CAG", "text": "πᾶς γὰρ ἄνθρωπος ζῷόν ἐστιν·", "seq": 258}
{"id": "David_Passim_0259", "series": "CAG", "text": "οὐκ εἴ τι δὲ ζῷον, τοῦτο καὶ ἄνθρωπος·", "seq": 259}
{"id": "David_Passim_0260", "series": "CAG", "text": "οὐ πᾶν γὰρ ζῷον ἄνθρωπός ἐστιν·", "seq": 260}
{"id": "David_Passim_0261", "series": "CAG", "text": "οὐ μόνον γὰρ ἄνθρωπός ἐστι ζῷον ἀλλὰ καὶ ἵππος καὶ βοῦς καὶ κύων), τὸν αὐτὸν δὴ τρόπον ὁ ὁρισμὸς καὶ ὁ ὅρος τῷ καθολικῷ διαφέρουσι καὶ τῷ μερικῷ·", "seq": 261}
{"id": "David_Passim_0262", "series": "CAG", "text": "καὶ γὰρ ὁ μὲν ὁρισμὸς μερικώτερός ἐστιν, ὁ δὲ ὅρος καθολικώτερος·", "seq": 262}
{"id": "David_Passim_0263", "series": "CAG", "text": "εἴ τι μὲν γὰρ ὁρισμός, τοῦτο καὶ ὅρος, οὐκ εἴ τι δὲ ὅρος, τοῦτο καὶ ὁρισμός·", "seq": 263}
{"id": "David_Passim_0264", "series": "CAG", "text": "ὁ γὰρ ὅρος οὐ μόνον τὸν ὁρισμὸν δηλοῖ, τοῦτ᾿ ἔστι τὸν λόγον τὸν σύντομον τὸν δηλωτικὸν τῆς φύσεως τοῦ ὑποκειμένου πράγματος, ἀλλὰ καὶ τὸ ὁροθέσιον καὶ κατὰ τὸν Ἀριστοτέλην εἰς ὃν ἀναλύεται ἡ πρότασις·", "seq": 264}
{"id": "David_Passim_0265", "series": "CAG", "text": "λέγει γὰρ ὁ Ἀριστοτέλης ὅτι ‘ὅρον τόνδε καλῶ εἰς ὃν ἀναλύεται ἡ πρότασις, τό τε κατηγορούμενον καὶ καθ᾿ οὗ κατηγορεῖται’.", "seq": 265}
{"id": "David_Passim_0266", "series": "CAG", "text": "οἷον τὸ ‘Σωκράτης περιπατεῖ’ πρότασίς ἐστι·", "seq": 266}
{"id": "David_Passim_0267", "series": "CAG", "text": "τοῦτο ἀναλύεται εἰς τὸ Σωκράτης καὶ εἰς τὸ περιπατεῖ·", "seq": 267}
{"id": "David_Passim_0268", "series": "CAG", "text": "ἑκάτερον οὖν αὐτῶν, ὥς φησιν ὁ Ἀριστοτέλης, ὅρος καλεῖται·", "seq": 268}
{"id": "David_Passim_0269", "series": "CAG", "text": "ὅρος οὖν ἐστι καὶ τὸ Σωκράτης καὶ τὸ περιπατεῖ.", "seq": 269}
{"id": "David_Passim_0270", "series": "CAG", "text": "κατὰ οὖν τὸ καθολικὸν καὶ μερικὸν διαφέρουσιν ἀλλήλων ὁ ὁρισμὸς καὶ ὁ ὅρος.", "seq": 270}
{"id": "David_Passim_0271", "series": "CAG", "text": "πολλάκις δὲ καὶ τὸν ὁρισμὸν ὅρον καλοῦμεν τῷ καθολικῷ ὀνόματι κεχρημένοι, ὥσπερ καὶ τὸν ἄνθρωπον τῷ γενικῷ ὀνόματι ζῷον καλοῦμεν.", "seq": 271}
{"id": "David_Passim_0272", "series": "CAG", "text": "Μαθόντες οὖν τί διαφέρει ὁρισμὸς ὅρου, ἔλθωμεν καὶ εἴπωμεν τί διαφέρει ὁρισμὸς ὑπογραφικοῦ ὁρισμοῦ.", "seq": 272}
{"id": "David_Passim_0273", "series": "CAG", "text": "ἰστέον ὅτι διαφέρει ὁρισμὸς ὑπογραφικοῦ ὁρισμοῦ, ὅτι ὁ μὲν ὁρισμὸς μονοειδής ἐστι καὶ ἐξ οὐσιωδῶν φωνῶν μόνων εἴληπται, οἷον ἄνθρωπός ἐστι ζῷον λογικὸν θνητὸν νοῦ καὶ ἐπιστήμης δεκτικόν, ὁ δὲ ὑπογραφικὸς ὁρισμὸς μικτός ἐστι·", "seq": 273}
{"id": "David_Passim_0274", "series": "CAG", "text": "καὶ γὰρ εἴληπται ἔκ τε οὐσιωδῶν καὶ συμβεβηκότων καί, ὡς ἄν τις εἴποι, ἐξ ὁρισμοῦ καὶ ὑπογραφῆς σύγκειται, ὡς ὅταν εἴπωμεν ‘ἄνθρωπός ἐστι ζῷον λογικὸν θνητὸν νοῦ καὶ ἐπιστήμης δεκτικὸν ὀρθοπεριπατητικὸν πλατυώνυχον’.", "seq": 274}
{"id": "David_Passim_0275", "series": "CAG", "text": "καὶ ἰστέον ὅτι πρὸς μὲν τὸ γενέσθαι ὁρισμὸν δεῖ πάσας τὰς φωνὰς οὐσιώδεις εἶναι, οἷον ἄνθρωπός ἐστι ζῷον λογικὸν θνητὸν νοῦ καὶ ἐπιστήμης δεκτικόν, πρὸς δὲ τὸ γενέσθαι ὑπογραφικὸν ὁρισμὸν ἀρκεῖ μία μόνη προστεθεῖσα φωνὴ συμβεβηκός τι δηλοῦσα, οἷον ἄνθρωπός ἐστι ζῷον λογικὸν θνητὸν νοῦ καὶ ἐπιστήμης δεκτικὸν ὀρθοπεριπατητικόν.", "seq": 275}
{"id": "David_Passim_0276", "series": "CAG", "text": "καὶ ὥσπερ πρὸς μὲν τὸ γενέσθαι ἁρμονίαν δεῖ πάσας τὰς χορδὰς εὐαρμόστους εἶναι, πρὸς δὲ τὸ γενέσθαι ἀναρμοστίαν ἀρκεῖ καὶ μία μόνη χορδὴ παρατραπεῖσα, καὶ πάλιν ὥσπερ πρὸς μὲν τὸ γενέσθαι ὑγείαν δεῖ συμμετρίαν εἶναι τῶν κράσεων καὶ σύνθεσιν κατὰ φύσιν τῶν μορίων, πρὸς δὲ τὸ γενέσθαι νόσον ἀρκεῖ καὶ μία κρᾶσις παρατραπεῖσα καὶ ἓν μόριον μὴ ἔχον κατὰ φύσιν·", "seq": 276}
{"id": "David_Passim_0277", "series": "CAG", "text": "τὸν αὐτὸν δὴ τρόπον πρὸς μὲν τὸ γενέσθαι ὁρισμὸν δεῖ πάσας τὰς φωνὰς οὐσιώδεις εἶναι, πρὸς δὲ τὸ γενέσθαι ὑπογραφικὸν ὁρισμὸν ἀρκεῖ καὶ μία μόνη προστεθεῖσα φωνὴ ἐπουσιῶδές τι δηλοῦσα.", "seq": 277}
{"id": "David_Passim_0278", "series": "CAG", "text": "ταῦτα μὲν ἐν τούτοις.", "seq": 278}
{"id": "David_Passim_0279", "series": "CAG", "text": "Ἀποροῦσι δέ τινες πρὸς τὸ πρῶτον κεφάλαιον λέγοντες ὅτι κακῶς τοῦ ὁρισμοῦ ὁρισμὸν ἀποδεδώκατε·", "seq": 279}
{"id": "David_Passim_0280", "series": "CAG", "text": "ἀπαιτοῦμεν γὰρ ὑμᾶς κἀκείνου τοῦ ὁρισμοῦ ἄλλον ὁρισμὸν καὶ τοῦ ἄλλου ἄλλον, καὶ ἐπ᾿ ἄπειρον τὸ τοιοῦτον ἐκφέρεται καὶ οὐδέποτε εἰσόμεθα τί ἐστιν ὁρισμός.", "seq": 280}
{"id": "David_Passim_0281", "series": "CAG", "text": "ἀπολογοῦνται οὖν τινες λέγοντες ὅτι οὐχ ὡς ὁρισμὸν ὡρισάμεθα αὐτόν, ἀλλ᾿ ὡς ὁριστόν, ἤγουν ὡς πρᾶγμα ὑποκείμενον.", "seq": 281}
{"id": "David_Passim_0282", "series": "CAG", "text": "πρὸς οὓς ἔστιν εἰπεῖν ὅτι οὐδὲν ἧττον ἡ ἀπορία ἔμεινεν·", "seq": 282}
{"id": "David_Passim_0283", "series": "CAG", "text": "ἐροῦμεν γὰρ ἡμεῖς ὅτι κἀκείνου τοῦ ὁρισμοῦ ἀποδοτέον ὅρον ὡς ὁριστοῦ καὶ πάλιν τοῦ ἄλλου ὁρισμοῦ ὡς ὁριστοῦ, καὶ τοῦτο ὁμοίως ἐπ᾿ ἄπειρον ἐκφέρεται.", "seq": 283}
{"id": "David_Passim_0284", "series": "CAG", "text": "ἔστιν οὖν εἰπεῖν ὅτι ὥσπερ εἰσί τινα αὐτομέτρητα καὶ ἑτερομέτρητα (καὶ γὰρ ὁ δέκα ἀριθμὸς καὶ αὐτομέτρητός ἐστι καὶ ἑτερομέτρητος, καὶ αὐτομέτρητος μὲν καθὸ ἑαυτὸν μετρεῖ κατὰ τὰς ἐν αὐτῷ μονάδας.", "seq": 284}
{"id": "David_Passim_0285", "series": "CAG", "text": "ἑτερομέτρητος δὲ καθὸ ἄλλον ἀριθμὸν μετρεῖ·", "seq": 285}
{"id": "David_Passim_0286", "series": "CAG", "text": "μετρεῖ γὰρ τὸν εἴκοσι κατὰ τὸν δύο ἀριθμόν·", "seq": 286}
{"id": "David_Passim_0287", "series": "CAG", "text": "δὶς γὰρ δέκα εἴκοσι), τὸν αὐτὸν δὴ τρόπον ἔστι καὶ αὐθόριστος ὅρος καὶ ἑτερόριστος·", "seq": 287}
{"id": "David_Passim_0288", "series": "CAG", "text": "ἑτερόριστος μὲν ὅτι πάντας τοὺς ἄλλους ὁρισμοὺς ὁρίζεται, αὐθόριστος δὲ ὅτι καὶ ἑαυτὸν σὺν ἐκείνοις ὁρίζεται.", "seq": 288}
{"id": "David_Passim_0289", "series": "CAG", "text": "καὶ ὥσπερ ὁ ἄνθρωπος ὁριζόμενος ἄλλον ἄνθρωπον ὁρίζεται λέγων ὅτι ἄνθρωπός ἐστι ζῷον λογικὸν θνητὸν νοῦ καὶ ἐπιστήμης δεκτικόν, καὶ οὐ μόνον πάντας τοὺς ἀνθρώπους ὡρίσατο ἀλλὰ καὶ ἑαυτὸν ὡρίσατο ἅτε δὴ ἄνθρωπον ὄντα, οὕτω δὴ καὶ ὁ ὁρισμὸς τοῦ ὁρισμοῦ οὐ μόνον τοὺς ἄλλους ὁρισμοὺς ὡρίσατο, ἀλλὰ καὶ ἑαυτὸν ὡρίσατο ἅτε δὴ ὁρισμὸν ὄντα.", "seq": 289}
{"id": "David_Passim_0290", "series": "CAG", "text": "καὶ ταῦτα μὲν ἐν τούτοις.", "seq": 290}
{"id": "David_Passim_0291", "series": "CAG", "text": "Ἀποροῦσι δέ τινες πρὸς τὸ δεύτερον κεφάλαιον λέγοντες·", "seq": 291}
{"id": "David_Passim_0292", "series": "CAG", "text": "εἰ ἄρα ἡ οὐσία τιμιωτέρα ἐστὶ τῶν συμβεβηκότων, ὁ δὲ ὁρισμὸς ἐξ οὐσιωδῶν φωνῶν εἴληπται, ἡ δὲ ὑπογραφὴ ἀπὸ συμβεβηκότων, διὰ τί ὑπογραφικὸν ὁρισμὸν λέγομεν τὸ χεῖρον προτάξαντες καὶ μὴ ὁρισμὸν ὑπογραφικόν;", "seq": 292}
{"id": "David_Passim_0293", "series": "CAG", "text": "καὶ ἀπολογοῦνταί τινες λέγοντες ὅτι ἐπειδὴ κατὰ τὸν ποιητὴν τὰ χείρονα νικᾷ καὶ μάλιστα ἐν ταῖς ὀνομασίαις (ἡμίονον γὰρ λέγομεν ἐκ τοῦ χείρονος ὀνομάζοντες καὶ οὐχ ἡμίιππον), τούτου χάριν ὑπογραφικὸν ὁρισμὸν λέγομεν τὸ χεῖρον προτάξαντες.", "seq": 293}
{"id": "David_Passim_0294", "series": "CAG", "text": "ταῦτα μὲν οὗτοι.", "seq": 294}
{"id": "David_Passim_0295", "series": "CAG", "text": "ἔστι δὲ εἰπεῖν ὅτι πιθανή ἐστιν ἡ λύσις, πλὴν κακῶς ἠπόρησαν οἱ ἀπορήσαντες, πρῶτον μὲν ὅτι οὐδεὶς τῶν παλαιῶν εἶπεν ὅτι ὑπογραφικὸν ὁρισμὸν δεῖ λέγειν, καὶ οὐχ ὁρισμὸν ὑπογραφικόν, δεύτερον δὲ εἴτε οὕτως εἴπωμεν εἴτε οὕτως, οὐδὲν ἡ σημασία λυμαίνεται·", "seq": 295}
{"id": "David_Passim_0296", "series": "CAG", "text": "λέγει γὰρ ὁ Ἀριστοτέλης ὅτι τὰ ὀνόματα καὶ τὰ ῥήματα μετατιθέμενα τὸ αὐτὸ σημαίνουσι·", "seq": 296}
{"id": "David_Passim_0297", "series": "CAG", "text": "καὶ γὰρ τὸ ‘Σωκράτης περιπατεῖ’ καὶ τὸ ‘περιπατεῖ Σωκράτης’ τὸ αὐτὸ σημαίνουσι καὶ τὸ Πλάτωνος Ἀλκιβιάδης καὶ Ἀλκιβιάδης Πλάτωνος τὸ αὐτὸ σημαίνουσιν.", "seq": 297}
{"id": "David_Passim_0298", "series": "CAG", "text": "ἐν οἷς σὺν θεῷ ἡ πρᾶξις.", "seq": 298}
{"id": "David_Passim_0299", "series": "CAG", "text": "Πρᾶξις ζ΄.", "seq": 299}
{"id": "David_Passim_0300", "series": "CAG", "text": "Ἀρξώμεθα τοῦ τρίτου κεφαλαίου τοῦ λέγοντος πόθεν λέγεται ὁρισμός.", "seq": 300}
{"id": "David_Passim_0301", "series": "CAG", "text": "ἰστέον ὅτι ὁρισμὸς λέγεται ἀπὸ μεταφορᾶς τῶν ἐν τοῖς γηδίοις ὁροθεσίων·", "seq": 301}
{"id": "David_Passim_0302", "series": "CAG", "text": "καὶ γὰρ οἱ ἀρχαῖοι ἑκατέραν ἀμετρίαν ἐκφεύγοντες, τήν τε πλεονεξίαν καὶ τὴν μειονεξίαν, ἐφεῦρον τὰ ὁροθέσια, ἵνα διὰ τούτων τῶν μὲν οἰκείων ἀπολαύωσι, τῶν δὲ ἀλλοτρίων ἀπέχωνται.", "seq": 302}
{"id": "David_Passim_0303", "series": "CAG", "text": "οὕτως οὖν καὶ ὁ ὁρισμὸς περιορίζει τὸ πρᾶγμα τὸ ὑποκείμενον καὶ χωρίζει αὐτὸ ἐκ τῶν ἀλλοτρίων.", "seq": 303}
{"id": "David_Passim_0304", "series": "CAG", "text": "οἷον ἐπὶ τοῦ ὁρισμοῦ τοῦ ἀνθρώπου γυμνάσωμεν τὸν λόγον·", "seq": 304}
{"id": "David_Passim_0305", "series": "CAG", "text": "ἄνθρωπός ἐστι ζῷον λογικὸν θνητὸν νοῦ καὶ ἐπιστήμης δεκτικόν·", "seq": 305}
{"id": "David_Passim_0306", "series": "CAG", "text": "ἰδοὺ διὰ τοῦ εἰπεῖν ζῷον ἐχώρισα αὐτὸν ἐκ τῶν μὴ ὄντων ζῴων, οἷον ἐκ τῶν ἀψύχων, διὰ δὲ τοῦ εἰπεῖν λογικόν ἐκ τῶν μὴ ὄντων λογικῶν, οἷον τῶν ἀλόγων, διὰ δὲ τοῦ εἰπεῖν θνητόν ἐκ τῶν ἀθανάτων, διὰ δὲ τοῦ εἰπεῖν νοῦ καὶ ἐπιστήμης δεκτικόν ἐκ τῶν μακραιώνων νυμφῶν, τοῦτ᾿ ἔστιν ἐκ τῶν θνητῶν δαιμόνων·", "seq": 306}
{"id": "David_Passim_0307", "series": "CAG", "text": "εἰσὶ γὰρ δαίμονες θνητοὶ αἱ μακραίωνες νύμφαι, αἵτινες πολλὰ ἔτη ζῶσιν·", "seq": 307}
{"id": "David_Passim_0308", "series": "CAG", "text": "καὶ γὰρ ζῷά εἰσι καὶ θνητὰ καὶ λογικά, ἀλλ᾿ οὔκ εἰσι νοῦ καὶ ἐπιστήμης δεκτικά·", "seq": 308}
{"id": "David_Passim_0309", "series": "CAG", "text": "οὐ μανθάνουσι γὰρ ἀλλ᾿ οἴκοθεν ἔχουσι τῇ φύσει τὴν γνῶσιν καὶ πᾶσαν ἐπιστήμην.", "seq": 309}
{"id": "David_Passim_0310", "series": "CAG", "text": "μόνος δὲ ὁ ἄνθρωπός ἐστι νοῦ καὶ ἐπιστήμης δεκτικός·", "seq": 310}
{"id": "David_Passim_0311", "series": "CAG", "text": "καὶ γὰρ μανθάνει τὴν κατ᾿ ἐνέργειαν γνῶσιν.", "seq": 311}
{"id": "David_Passim_0312", "series": "CAG", "text": "ἰστέον δὲ ὅτι ἐν τοῖς ὅροις ἀντιπεπονθότως ἔχουσιν αἱ λέξεις πρὸς τὰ πράγματα·", "seq": 312}
{"id": "David_Passim_0313", "series": "CAG", "text": "ἡνίκα μὲν γὰρ ὁ ὅρος πλεονάσῃ ταῖς λέξεσιν, ἐλλείπει τοῖς πράγμασιν, οἷον ἐὰν εἴπω ‘ἄνθρωπός ἐστι ζῷον λογικὸν θνητὸν νοῦ καὶ ἐπιστήμης δεκτικὸν γραμματικόν’, ἐπλεόνασα μὲν ταῖς λέξεσιν, ἔλειψα δὲ τοῖς πράγμασιν (οὐδὲ γὰρ πάντα ἄνθρωπον ὡρισάμην ἀλλὰ τὸν γραμματικὸν μόνον), ἡνίκα δὲ ἐλλείψῃ ταῖς λέξεσι, πλεονάζει τοῖς πράγμασιν, οἷον ἐὰν εἴπω ‘ἄνθρωπός ἐστι ζῷον λογικὸν θνητόν’ ἐνέλιπον μὲν ταῖς λέξεσιν, ἐπλεόνασα δὲ τοῖς πράγμασιν·", "seq": 313}
{"id": "David_Passim_0314", "series": "CAG", "text": "οὐ γὰρ μόνον τὸν ἄνθρωπον ὡρισάμην, ἀλλὰ καὶ τὰς μακραίωνας νύμφας·", "seq": 314}
{"id": "David_Passim_0315", "series": "CAG", "text": "καὶ ταῦτα γὰρ ζῷά εἰσι καὶ λογικὰ καὶ θνητά.", "seq": 315}
{"id": "David_Passim_0316", "series": "CAG", "text": "καὶ ὡς ἔλεγεν Ὀλυμπιόδωρος ὁ φιλόσοφος, “θαυμαστόν τι ἐφεῦρεν ἡ φύσις μηχάνημα, ἔνδειαν πλουτοῦσαν καὶ πλοῦτον ὑποκρινόμενον ἔνδειαν”.", "seq": 316}
{"id": "David_Passim_0317", "series": "CAG", "text": "εἰ δέ τις ἀπορεῖ λέγων ὅτι ἐάν, ὡς εἰρήκαμεν, ἡνίκα πλεονάσῃ ταῖς λέξεσιν, ἐλλείπῃ τοῖς πράγμασιν, πῶς ἐὰν εἴπω ‘ἄνθρωπός ἐστι ζῷον λογικὸν θνητὸν ἀποθνῆσκον καὶ τὰ ἑξῆς’ καὶ πλεονάσω ταῖς λέξεσιν ὁ ὅρος, οὐκ ἐλλείπει τοῖς πράγμασιν (πάντα γὰρ ἄνθρωπον συμπεριέλαβον), λέγομεν ὅτι ἡ προστεθεῖσα λέξις οὐδὲν πλέον σημαίνει τῆς ὑποκειμένης·", "seq": 317}
{"id": "David_Passim_0318", "series": "CAG", "text": "ταὐτὸν γάρ ἐστιν κατὰ τὴν σημασίαν τὸ θνητόν καὶ τὸ ἀποθνῆσκον.", "seq": 318}
{"id": "David_Passim_0319", "series": "CAG", "text": "ἐπειδὴ οὖν οὐδὲν πλέον σημαίνει ἡ προστεθεῖσα λέξις, τούτου χάριν οὐκ ἐποίησεν ἔνδειαν πραγμάτων.", "seq": 319}
{"id": "David_Passim_0320", "series": "CAG", "text": "ταῦτα μὲν καὶ τὸ τρίτον κεφάλαιον.", "seq": 320}
{"id": "David_Passim_0321", "series": "CAG", "text": "Ἔλθωμεν δὲ καὶ ἐπὶ τὸ τέταρτον καὶ εἴπωμεν πόθεν λαμβάνονται οἱ ὁρισμοί.", "seq": 321}
{"id": "David_Passim_0322", "series": "CAG", "text": "ἰστέον ὅτι οἱ ὁρισμοὶ λαμβάνονται ἢ ἀπὸ τοῦ ὑποκειμένου ἢ ἀπὸ τοῦ τέλους ἢ ἀπὸ τοῦ συναμφοτέρου, τοῦτ᾿ ἔστιν ἀπὸ τοῦ ὑποκειμένου ἅμα καὶ τοῦ τέλους.", "seq": 322}
{"id": "David_Passim_0323", "series": "CAG", "text": "ἀλλὰ πρῶτον εἴπωμεν τί ἐστιν ὑποκείμενον καὶ τί ἐστι τέλος.", "seq": 323}
{"id": "David_Passim_0324", "series": "CAG", "text": "ἰστέον ὅτι ὑποκείμενόν ἐστι περὶ ὃ καταγίνεται ἡ τέχνη καὶ περὶ ὃ ἐνεργεῖ, τέλος δὲ οὗ καταστοχάζεται καὶ ᾧ χαρακτηρίζεται καὶ οὗ χάριν πάντα ποιεῖ.", "seq": 324}
{"id": "David_Passim_0325", "series": "CAG", "text": "οἷον τῆς μὲν τεκτονικῆς ὑποκείμενά εἰσι τὰ ξύλα (περὶ ταῦτα γὰρ καταγίνεται καὶ ἐνεργεῖ), τέλος δὲ τὸ ποιῆσαι σκάμνον ἢ θρόνον ἤ τι τοιοῦτον.", "seq": 325}
{"id": "David_Passim_0326", "series": "CAG", "text": "καὶ πάλιν τῆς ἀστρονομίας ὑποκείμενά εἰσι τὰ οὐράνια σώματα, τέλος δὲ οὐ τὸ ποιῆσαι ὅμοια τούτοις, ἀλλὰ τὸ εἰδέναι τὴν κίνησιν αὐτῶν.", "seq": 326}
{"id": "David_Passim_0327", "series": "CAG", "text": "οὕτως οὖν καὶ ἡ φιλοσοφία ἔχει καὶ ὑποκείμενον καὶ τέλος.", "seq": 327}
{"id": "David_Passim_0328", "series": "CAG", "text": "καὶ ὑποκείμενα μὲν ἔχει πάντα τὰ ὄντα τέλος δὲ τὴν γνῶσιν αὐτῶν, τοῦτ᾿ ἔστιν τὸ εἰδέναι αὐτὰ καὶ διὰ τούτου ὁμοιωθῆναι θεῷ·", "seq": 328}
{"id": "David_Passim_0329", "series": "CAG", "text": "καὶ γὰρ ὁ φιλόσοφος ὅμοιός ἐστι τῷ θεῷ, ὡς δηλοῖ καὶ ἡ Πυθία λέγουσα περὶ Λυκούργου νομοθέτου τε ὄντος καὶ φιλοσόφου (οἱ γὰρ πάλαι φιλόσοφοι καὶ νομοθέται ἦσαν)·", "seq": 329}
{"id": "David_Passim_0330", "series": "CAG", "text": "ἤλυθες, ὦ Λυκόεργε, ἐμὸν ποτὶ πίονα νηόν·", "seq": 330}
{"id": "David_Passim_0331", "series": "CAG", "text": "δίζω ἤ σε θεὸν μαντεύσομαι ἠὲ καὶ ἄνδρα.", "seq": 331}
{"id": "David_Passim_0332", "series": "CAG", "text": "ἀλλ᾿ ἔμπης σε θεὸν μαντεύσομαι, ὦ Λυκόεργε.", "seq": 332}
{"id": "David_Passim_0333", "series": "CAG", "text": "διστάζει δὲ οὐχ ὡς ἀγνοοῦσα τί αὐτὸν καλέσῃ καὶ δεομένη εἰς τοῦτο ἄλλης Πυθίας, ἀλλ᾿ ἵνα δείξῃ ἀμφήριστον τὴν τοῦ θεοῦ φύσιν καὶ τὴν τοῦ ἀνδρός, ὅθεν ἐπιφέρει", "seq": 333}
{"id": "David_Passim_0334", "series": "CAG", "text": "ἀλλ᾿ ἔμπης σε θεὸν μαντεύσομαι.", "seq": 334}
{"id": "David_Passim_0335", "series": "CAG", "text": "Ὅτι δὲ τέλειος φιλόσοφος ὅμοιός ἐστι τῷ θεῷ, δῆλον, ἐπειδὴ τοῖς αὐτοῖς χαρακτηρίζεται, οἷσπερ καὶ ὁ θεός·", "seq": 335}
{"id": "David_Passim_0336", "series": "CAG", "text": "ὥσπερ γὰρ ὁ θεὸς χαρακτηρίζεται τῷ ἀγαθῷ καὶ τῷ γνωστικῷ καὶ τῷ δυνατῷ, ὡς καὶ ἡ ποίησις δηλοῖ λέγουσα ἐπὶ μὲν τοῦ ἀγαθοῦ", "seq": 336}
{"id": "David_Passim_0337", "series": "CAG", "text": "θεοὶ δωτῆρες ἐάων.", "seq": 337}
{"id": "David_Passim_0338", "series": "CAG", "text": "ἔπι δὲ του γνωστικοῦ θεοὶ δέ τε πάντα ἴσασιν, ἔπι δὲ του δυνάτου θεοὶ δέ τε πάντα δύνανται,", "seq": 338}
{"id": "David_Passim_0339", "series": "CAG", "text": "τὸν αὐτὸν δὴ τρόπον καὶ ὁ τέλειος φιλόσοφος τοῖς τρισὶ τούτοις χαρακτηρίζεται, λέγω δὴ τῷ ἀγαθῷ καὶ τῷ γνωστικῷ καὶ τῷ δυνατῷ·", "seq": 339}
{"id": "David_Passim_0340", "series": "CAG", "text": "καὶ τῷ μὲν ἀγαθῷ, ὅτι ὥσπερ ὁ θεὸς προνοεῖται τῶν πάντων, οὕτω καὶ ὁ φιλόσοφος προνοεῖται τῶν ἀτελῶν ψυχῶν καὶ ἐπὶ τὸ τέλειον αὐτὰς ἄγει διὰ τοῦ ἀγνοούσας αὐτὰς ἐπὶ τὴν γνῶσιν μεταφέρειν·", "seq": 340}
{"id": "David_Passim_0341", "series": "CAG", "text": "τῷ δὲ γνωστικῷ, ὅτι ὥσπερ τὸ θεῖον πάντα γινώσκει, οὕτω καὶ ὁ τέλειος φιλόσοφος ἐπαγγέλλεται πάντα γινώσκειν·", "seq": 341}
{"id": "David_Passim_0342", "series": "CAG", "text": "τῷ δὲ δυνατῷ, ὅτι ὥσπερ τὸ θεῖον ὅσα δύναται καὶ βούλεται, οὕτω καὶ ὁ τέλειος φιλόσοφος ὅσα δύναται καὶ βούλεται.", "seq": 342}
{"id": "David_Passim_0343", "series": "CAG", "text": "ἀλλ᾿ ἐπὶ μὲν τοῦ θεοῦ ἀντιστρέφει (καὶ γὰρ ὅσα δύναται καὶ βούλεται καὶ ὅσα βούλεται καὶ δύναται), ἐπὶ δὲ τοῦ φιλοσόφου οὐκ ἀντιστρέφει·", "seq": 343}
{"id": "David_Passim_0344", "series": "CAG", "text": "ὅσα μὲν γὰρ δύναται, βούλεται, οὐχ ὅσα δὲ βούλεται, δύναται·", "seq": 344}
{"id": "David_Passim_0345", "series": "CAG", "text": "ἐὰν γὰρ βουληθῇ τι ἀδύνατον, οὐ δύναται τοῦτο ποιῆσαι·", "seq": 345}
{"id": "David_Passim_0346", "series": "CAG", "text": "οἷον ἐὰν βουληθῇ τῷ δακτύλῳ ἅψασθαι τοῦ οὐρανοῦ, οὐ δύναται τοῦτο ποιῆσαι.", "seq": 346}
{"id": "David_Passim_0347", "series": "CAG", "text": "καὶ ἀποροῦσί τινες λέγοντες·", "seq": 347}
{"id": "David_Passim_0348", "series": "CAG", "text": "πῶς φατε τὸν φιλόσοφον τῷ δυνατῷ παραπλησίως χαρακτηρίζεσθαι τῷ θεῷ, ὅπου γε ἐπὶ μὲν τοῦ θεοῦ ἀντιστρέφει, ὡς εἴρηται, ἐπὶ δὲ τοῦ φιλοσόφου οὐκ ἀντιστρέφει;", "seq": 348}
{"id": "David_Passim_0349", "series": "CAG", "text": "καὶ ἔστιν εἰπεῖν ὅτι τοῦτο λέγομεν, ἐπειδὴ ταῦτα βούλεται ὁ τέλειος φιλόσοφος καὶ τούτων ἐρᾷ, ὧν καὶ τυχεῖν δύναται·", "seq": 349}
{"id": "David_Passim_0350", "series": "CAG", "text": "τῶν γὰρ ἀδυνάτων οὐκ ἐρᾷ·", "seq": 350}
{"id": "David_Passim_0351", "series": "CAG", "text": "καὶ γὰρ κατὰ τοὺς Στωϊκοὺς μεγίστη ἔνδειά ἐστιν ἡ τῶν ὀρέξεων ἀπληστία.", "seq": 351}
{"id": "David_Passim_0352", "series": "CAG", "text": "ἰστέον δὲ ὅτι προϊόντες ἔχομεν δεῖξαι ὅτι ἄλλως πώς ἐστι τὸ γνωστικὸν παρὰ τῷ θεῷ καὶ τὸ ἀγαθὸν καὶ τὸ δυνατὸν καὶ ἄλλως πως παρὰ τῷ φιλοσόφῳ.", "seq": 352}
{"id": "David_Passim_0353", "series": "CAG", "text": "Δεῖ τοίνυν γινώσκειν ὅτι οἱ ὅροι ἀπὸ τοῦ ὑποκειμένου λαμβάνονται ἢ τοῦ τέλους ἢ ἀπὸ τοῦ συναμφοτέρου, τοῦτ᾿ ἔστιν ἀπὸ τοῦ ὑποκειμένου ἅμα καὶ τοῦ τέλους.", "seq": 353}
{"id": "David_Passim_0354", "series": "CAG", "text": "καὶ ἀπὸ τοῦ ὑποκειμένου μέν, ὡς ὅταν εἴπωμεν ὅτι ἰατρική ἐστι τέχνη περὶ τὰ ἀνθρώπεια σώματα καταγινομένη (περὶ ταῦτα γὰρ καταγίνεται), ἀπὸ τοῦ τέλους δέ, ὡς ὅταν εἴπωμεν ὅτι ἰατρική ἐστιν τέχνη ὑγείας περιποιητική (τέλος γὰρ τῆς ἰατρικῆς τὸ τὴν παροῦσαν ὑγείαν φυλάξαι ἢ τὴν ἀποῦσαν ἀνακαλέσασθαι), ἀπὸ τοῦ συναμφοτέρου δέ, ὡς ὅταν εἴπωμεν τοὺς δύο ὅρους συνάψαντες ‘ἰατρική ἐστι τέχνη περὶ τὰ ἀνθρώπεια σώματα καταγινομένη ὑγείας περιποιητική’.", "seq": 354}
{"id": "David_Passim_0355", "series": "CAG", "text": "οὕτως οὖν καὶ τὴν φιλοσοφίαν ὁριζόμεθα ἀπὸ μὲν τοῦ ὑποκειμένου, ὡς ὅταν εἴπωμεν ‘φιλοσοφία ἐστὶ γνῶσις θείων τε καὶ ἀνθρωπίνων πραγμάτων’, ἀπὸ δὲ τοῦ τέλους ‘φιλοσοφία ἐστὶν ὁμοίωσις θεῷ κατὰ τὸ δυνατὸν ἀνθρώπῳ’, ἀπὸ τοῦ συναμφοτέρου δέ, ὡς ὅταν εἴπωμεν ‘φιλοσοφία ἐστὶ γνῶσις θείων τε καὶ ἀνθρωπίνων πραγμάτων ὁμοίωσις θεῷ κατὰ τὸ δυνατὸν ἀνθρώπῳ’.", "seq": 355}
{"id": "David_Passim_0356", "series": "CAG", "text": "καὶ ταῦτα μὲν ἐν τούτοις.", "seq": 356}
{"id": "David_Passim_0357", "series": "CAG", "text": "Ἀποροῦσι δέ τινες λέγοντες ὅτι πῶς φατε τοὺς ὅρους ἢ ἀπὸ τοῦ ὑποκειμένου λαμβάνεσθαι ἢ ἀπὸ τοῦ τέλους ἢ ἀπὸ τοῦ συναμφοτέρου, ὅπου γε εἰώθαμεν λέγειν ὅτι πάντες οἱ ὅροι ἀπὸ γένους καὶ συστατικῶν διαφορῶν λαμβάνονται;", "seq": 357}
{"id": "David_Passim_0358", "series": "CAG", "text": "καὶ λέγουσί τινες ταύτην τὴν αἰτίαν, ὅτι ἐπὶ μὲν τῶν φυσικῶν πραγμάτων ἀπὸ γένους καὶ συστατικῶν διαφορῶν λαμβάνονται οἱ ὅροι, οἷον ὡς ἐπὶ τοῦ ἀνθρώπου, ἐπὶ δὲ τῶν τεχνῶν ἀπὸ τοῦ ὑποκειμένου λαμβάνονται ἢ ἀπὸ τοῦ τέλους ἢ ἐκ τοῦ συναμφοτέρου, ὡς ἐπὶ τοῦ προρρηθέντος παραδείγματος.", "seq": 358}
{"id": "David_Passim_0359", "series": "CAG", "text": "ταῦτα μὲν οὗτοι.", "seq": 359}
{"id": "David_Passim_0360", "series": "CAG", "text": "κακῶς δὲ λέγουσι, πρῶτον μὲν ὅτι τὴν ἀπορίαν οὐκ ἔλυσαν·", "seq": 360}
{"id": "David_Passim_0361", "series": "CAG", "text": "ἡ γὰρ ἀπορία ἔχει ὅτι πάντες οἱ ὅροι ἀπὸ γένους καὶ συστατικῶν διαφορῶν λαμβάνονται, οὗτοι δὲ εἶπον τινὰς μὲν τῶν ὅρων ἀπὸ γένους καὶ συστατικῶν διαφορῶν λαμβάνεσθαι, τινὰς δὲ ἢ ἀπὸ τοῦ ὑποκειμένου ἢ ἀπὸ τοῦ τέλους ἢ ἐκ τοῦ συναμφοτέρου, τοῦ ὑποκειμένου ἅμα καὶ τοῦ τέλους.", "seq": 361}
{"id": "David_Passim_0362", "series": "CAG", "text": "δεύτερον δὲ ὅτι κακῶς ἐπέλυσαν·", "seq": 362}
{"id": "David_Passim_0363", "series": "CAG", "text": "εὑρίσκομεν γὰρ καὶ ἐπὶ τῶν φυσικῶν τὸν ὅρον ἀπὸ τοῦ ὑποκειμένου καὶ τέλους λαμβανόμενον, ὡς ἐπὶ τοῦ θυμοῦ·", "seq": 363}
{"id": "David_Passim_0364", "series": "CAG", "text": "οὗτος γὰρ φυσικόν ἐστι καὶ ὅμως ἀπὸ τοῦ ὑποκειμένου καὶ τοῦ τέλους ὁριζόμεθα αὐτόν·", "seq": 364}
{"id": "David_Passim_0365", "series": "CAG", "text": "λέγομεν γὰρ ὅτι θυμός ἐστι ζέσις τοῦ περὶ καρδίαν αἵματος πρὸς ὄρεξιν ἀντιλυπήσεως.", "seq": 365}
{"id": "David_Passim_0366", "series": "CAG", "text": "καὶ ἰδοὺ ἡ μὲν ζέσις τοῦ περὶ τὴν καρδίαν αἵματος ἀπὸ τοῦ ὑποκειμένου ἐστί (καὶ γὰρ τῷ θυμῷ τὸ περὶ τὴν καρδίαν αἷμα ὑπόκειται), τὸ δὲ ‘πρὸς ὄρεξιν ἀντιλυπήσεως’ ἀπὸ τοῦ τέλους·", "seq": 366}
{"id": "David_Passim_0367", "series": "CAG", "text": "τέλος γὰρ τοῦ θυμοῦ τὸ ὀρέγεσθαι τοῦ λυπῆσαι τὸν ἀντιλυπήσαντα.", "seq": 367}
{"id": "David_Passim_0368", "series": "CAG", "text": "ταῦτα μὲν ἐν τούτοις.", "seq": 368}
{"id": "David_Passim_0369", "series": "CAG", "text": "ἔστι δὲ εἰπεῖν ὅτι καλῶς λέγομεν πάντας τοὺς ὅρους ἀπὸ γένους καὶ συστατικῶν διαφορῶν λαμβάνεσθαι·", "seq": 369}
{"id": "David_Passim_0370", "series": "CAG", "text": "καὶ γὰρ οἱ ἐκ τοῦ τέλους λαμβανόμενοι καὶ οἱ ἐκ τοῦ ὑποκειμένου καὶ οἱ ἐκ τοῦ συναμφοτέρου ἔχουσι καὶ γένος καὶ συστατικὰς διαφοράς, οἷον ἰατρική ἐστι τέχνη περὶ τὰ ἀνθρώπεια σώματα καταγινομένη·", "seq": 370}
{"id": "David_Passim_0371", "series": "CAG", "text": "ἰδοὺ ἐνταῦθα ἀντὶ γένους μὲν εἴληπται τὸ τέχνη, ἀντὶ δὲ συστατικῶν διαφορῶν αἱ λοιπαὶ λέξεις.", "seq": 371}
{"id": "David_Passim_0372", "series": "CAG", "text": "καὶ πάλιν ἰατρική ἐστι τέχνη ὑγείας περιποιητική·", "seq": 372}
{"id": "David_Passim_0373", "series": "CAG", "text": "ἰδοὺ ἐνταῦθα τὸ μὲν τέχνη ἀντὶ γένους εἴληπται, αἱ δὲ λοιπαὶ λέξεις ἀντὶ συστατικῶν διαφορῶν.", "seq": 373}
{"id": "David_Passim_0374", "series": "CAG", "text": "καὶ πάλιν ἰατρική ἐστι τέχνη περὶ τὰ ἀνθρώπεια σώματα καταγινομένη ὑγείας περιποιητική·", "seq": 374}
{"id": "David_Passim_0375", "series": "CAG", "text": "ἰδοὺ ἀντὶ μὲν γένους εἴληπται τὸ τέχνη, ἀντὶ δὲ συστατικῶν διαφορῶν αἱ λοιπαὶ λέξεις.", "seq": 375}
{"id": "David_Passim_0376", "series": "CAG", "text": "καὶ πάλιν φιλοσοφία ἐστὶ γνῶσις θείων τε καὶ ἀνθρωπίνων πραγμάτων·", "seq": 376}
{"id": "David_Passim_0377", "series": "CAG", "text": "ἰδοὺ ἐνταῦθα ἀντὶ μὲν γένους εἴληπται τὸ γνῶσις, ἀντὶ δὲ συστατικῶν διαφορῶν αἱ λοιπαὶ λέξεις.", "seq": 377}
{"id": "David_Passim_0378", "series": "CAG", "text": "ταῦτα μὲν ἔχει καὶ τὸ τέταρτον κεφάλαιον.", "seq": 378}
{"id": "David_Passim_0379", "series": "CAG", "text": "Πέμπτον δὲ ὑπάρχει κεφάλαιον, ἐν ᾧ ζητοῦμεν ποῖος τέλειος ὁρισμὸς καὶ ποῖος ἀτελής.", "seq": 379}
{"id": "David_Passim_0380", "series": "CAG", "text": "ἰστέον ὅτι τέλειος ὁρισμός ἐστιν ὁ ἀντιστρέφων πρὸς τὸ ὁριστόν, οἷον ὡς ὅταν εἴπωμεν ὅτι εἴ τι ἄνθρωπος, τοῦτο καὶ ζῷον λογικὸν θνητὸν νοῦ καὶ ἐπιστήμης δεκτικόν, καὶ εἴ τι ζῷον λογικὸν θνητὸν νοῦ καὶ ἐπιστήμης δεκτικόν, τοῦτο ἄνθρωπος.", "seq": 380}
{"id": "David_Passim_0381", "series": "CAG", "text": "ἀτελὴς δὲ ὁρισμός ἐστιν ὁ μὴ ἀντιστρέφων·", "seq": 381}
{"id": "David_Passim_0382", "series": "CAG", "text": "κακία γὰρ ὅρου ἐστὶ τὸ μὴ ἀντιστρέφειν.", "seq": 382}
{"id": "David_Passim_0383", "series": "CAG", "text": "τοῦτο δὲ γίνεται ἐκ τοῦ πλεονάζειν τὸν ὅρον ἢ ἐλλείπειν·", "seq": 383}
{"id": "David_Passim_0384", "series": "CAG", "text": "καὶ γὰρ οὗτος ὁ πλεονάζων ὅρος οὐκ ἀντιστρέφει, οἷον ἄνθρωπός ἐστι ζῷον λογικὸν θνητὸν νοῦ καὶ ἐπιστήμης δεκτικὸν γραμματικόν·", "seq": 384}
{"id": "David_Passim_0385", "series": "CAG", "text": "οὗτος γὰρ πλεονάζων οὐκ ἀντιστρέφει·", "seq": 385}
{"id": "David_Passim_0386", "series": "CAG", "text": "εἴ τι μὲν γὰρ ζῷον λογικὸν θνητὸν νοῦ καὶ ἐπιστήμης δεκτικὸν γραμματικόν, τοῦτο ἄνθρωπος, οὐκ εἴ τι δὲ ἄνθρωπος, τοῦτο ζῷον λογικὸν θνητὸν νοῦ καὶ ἐπιστήμης δεκτικὸν γραμματικόν·", "seq": 386}
{"id": "David_Passim_0387", "series": "CAG", "text": "οὐ γὰρ πᾶς ἄνθρωπος γραμματικός ἐστι.", "seq": 387}
{"id": "David_Passim_0388", "series": "CAG", "text": "ἀλλὰ μὴν οὐδὲ ὁ ἐλλείπων ὅρος ἀντιστρέφει·", "seq": 388}
{"id": "David_Passim_0389", "series": "CAG", "text": "οἷον ἄνθρωπός ἐστι ζῷον λογικόν·", "seq": 389}
{"id": "David_Passim_0390", "series": "CAG", "text": "ἰδοὺ γὰρ οὗτος ὁ ὅρος ἐλλείπων οὐκ ἀντιστρέφει·", "seq": 390}
{"id": "David_Passim_0391", "series": "CAG", "text": "εἴ τι μὲν γὰρ ἄνθρωπος, τοῦτο ζῷον λογικόν, οὐκ εἴ τι δὲ ζῷον λογικόν, τοῦτο ἄνθρωπος·", "seq": 391}
{"id": "David_Passim_0392", "series": "CAG", "text": "οὐ μόνον γὰρ ἄνθρωπός ἐστι ζῷον λογικόν, ἀλλὰ καὶ ἄγγελοι καὶ δαίμονες.", "seq": 392}
{"id": "David_Passim_0393", "series": "CAG", "text": "ταῦτα μὲν ἐν τούτοις.", "seq": 393}
{"id": "David_Passim_0394", "series": "CAG", "text": "Ζητήσωμεν δὲ λοιπὸν ποῖοι ἐκ τῶν προρρηθέντων ὅρων εἰσὶ τέλειοι.", "seq": 394}
{"id": "David_Passim_0395", "series": "CAG", "text": "ἰστέον ὅτι οἱ ἐκ τοῦ συναμφοτέρου, ἤγουν οἱ ἐξ ὑποκειμένου ἅμα καὶ τέλους, μᾶλλόν εἰσι τέλειοι (οἷον τεκτονική ἐστι τέχνη περὶ ξύλα καταγινομένη θρόνου περιποιητική), οἱ δὲ ἐκ τοῦ ὑποκειμένου μόνου ἢ καὶ ἀπὸ μόνου τοῦ τέλους ὡς ἐπὶ τὸ πλεῖστον οὔκ εἰσι τέλειοι, οἷον ἐὰν εἴπωμεν ‘ἰατρική ἐστι τέχνη περὶ τὰ ἀνθρώπεια σώματα καταγινομένη’, οὐκ ἀντιστρέφει·", "seq": 395}
{"id": "David_Passim_0396", "series": "CAG", "text": "εἴ τι μὲν γὰρ ἰατρική, τοῦτο τέχνη περὶ τὰ ἀνθρώπεια σώματα καταγινομένη, οὐκ εἴ τι δὲ τέχνη περὶ τὰ ἀνθρώπεια σώματα καταγινομένη, τοῦτο ἰατρική·", "seq": 396}
{"id": "David_Passim_0397", "series": "CAG", "text": "οὐ γὰρ μόνη ἡ ἰατρικὴ περὶ τὰ ἀνθρώπεια σώματα καταγίνεται, ἀλλὰ καὶ ἡ γυμναστικὴ καὶ ἡ κομμωτικὴ καὶ ἡ κουρευτική.", "seq": 397}
{"id": "David_Passim_0398", "series": "CAG", "text": "καὶ πάλιν ἐὰν εἴπω ὅτι θυμός ἐστι ζέσις τοῦ περὶ τὴν καρδίαν αἵματος, οὐκ ἀντιστρέφει·", "seq": 398}
{"id": "David_Passim_0399", "series": "CAG", "text": "εἴ τι μὲν γὰρ θυμός, τοῦτο ζέσις τοῦ περὶ τὴν καρδίαν αἵματος, οὐκ εἴ τι δὲ ζέσις τοῦ περὶ τὴν καρδίαν αἵματος, τοῦτο θυμός·", "seq": 399}
{"id": "David_Passim_0400", "series": "CAG", "text": "δύναται γὰρ ζέσις εἶναι τοῦ περὶ τὴν καρδίαν αἵματος καὶ ἀπὸ πυρετοῦ.", "seq": 400}
{"id": "David_Passim_0401", "series": "CAG", "text": "καὶ πάλιν ἐὰν εἴπω ὅτι ῥητορική ἐστι πειθοῦς δημιουργός, οὐκ ἀντιστρέφει·", "seq": 401}
{"id": "David_Passim_0402", "series": "CAG", "text": "εἴ τι μὲν γὰρ ῥητορική, τοῦτο πειθοῦς δημιουργός, οὐκ εἴ τι δὲ πειθοῦς δημιουργός, τοῦτο ῥητορική·", "seq": 402}
{"id": "David_Passim_0403", "series": "CAG", "text": "οὐ μόνη γὰρ ἡ ῥητορικὴ πειθοῦς δημιουργός, ἀλλὰ καὶ ἡ διαλεκτικὴ φιλοσοφία.", "seq": 403}
{"id": "David_Passim_0404", "series": "CAG", "text": "πρόσκειται δὲ ἀνωτέρω ‘ὡς ἐπὶ τὸ πλεῖστον οὔκ εἰσι τέλειοι οἱ ἀπὸ τοῦ ὑποκειμένου μόνου λαμβανόμενοι ἢ οἱ ἀπὸ τοῦ τέλους μόνου’, ἐπειδὴ ἔστιν ὅτε εὑρίσκεται καὶ ὁ ἐκ τοῦ ὑποκειμένου μόνου λαμβανόμενος ὅρος τέλειος, οἷον ὡς ἐπὶ τῆς ὑαλουργικῆς·", "seq": 404}
{"id": "David_Passim_0405", "series": "CAG", "text": "ἐὰν γὰρ εἴπωμεν ὅτι ὑαλουργική ἐστι τέχνη περὶ ὕαλον καταγινομένη, τέλειός ἐστιν ὅρος·", "seq": 405}
{"id": "David_Passim_0406", "series": "CAG", "text": "εἴ τι μὲν γὰρ ὑαλουργική ἐστι, τοῦτο τέχνη περὶ ὕαλον καταγινομένη, καὶ εἴ τι περὶ ὕαλον καταγινομένη, τοῦτο τέχνη ἐστὶν ὑαλουργική·", "seq": 406}
{"id": "David_Passim_0407", "series": "CAG", "text": "τῇ γὰρ ὑαλουργικῇ μόνῃ ὑπόκειται ὁ ὕαλος.", "seq": 407}
{"id": "David_Passim_0408", "series": "CAG", "text": "ἐπὶ δὲ τῆς φιλοσοφίας καὶ ἀπὸ τοῦ τέλους μόνου καὶ ἀπὸ τοῦ ὑποκειμένου τέλειός ἐστιν ὁρισμός.", "seq": 408}
{"id": "David_Passim_0409", "series": "CAG", "text": "καὶ ἀποροῦσί τινες λέγοντες διὰ τί ἐπὶ τῆς φιλοσοφίας ὁ ἐκ μόνου τοῦ ὑποκειμένου ὅρος τέλειός ἐστι καὶ ὁ ἐκ μόνου τοῦ τέλους.", "seq": 409}
{"id": "David_Passim_0410", "series": "CAG", "text": "καὶ ἔστιν εἰπεῖν, ἐπειδὴ καὶ τὸ ὑποκείμενον τῇ φιλοσοφίᾳ αὐτῇ μόνῃ ὑπόκειται καὶ οὐκ ἄλλῳ τινί (τῇ γὰρ φιλοσοφίᾳ μόνῃ ὑπόκειται πάντα τὰ ὄντα), καὶ πάλιν καὶ τὸ τέλος τῆς φιλοσοφίας αὐτῆς μόνης ἐστὶ τέλος·", "seq": 410}
{"id": "David_Passim_0411", "series": "CAG", "text": "μόνη γὰρ ἡ φιλοσοφία τὴν γνῶσιν πάντων τῶν ὄντων ἔχει καὶ δι᾿ αὐτῆς ὁμοιοῦται τῷ θεῷ.", "seq": 411}
{"id": "David_Passim_0412", "series": "CAG", "text": "ταῦτα καὶ τὸ πέμπτον κεφάλαιον καὶ ἡ παροῦσα πρᾶξις.", "seq": 412}
{"id": "David_Passim_0413", "series": "CAG", "text": "Πρᾶξις ζ΄.", "seq": 413}
{"id": "David_Passim_0414", "series": "CAG", "text": "Μεμαθηκότες τὸ πέμπτον κεφάλαιον ζητήσωμεν καὶ τὸ ἕκτον, ἐν ᾧ λέγομεν πόσοι καὶ ποῖοι τῆς φιλοσοφίας εἰσὶν ὁρισμοί.", "seq": 414}
{"id": "David_Passim_0415", "series": "CAG", "text": "εἰσὶ δὲ οὗτοι·", "seq": 415}
{"id": "David_Passim_0416", "series": "CAG", "text": "πρῶτος μὲν ὁ λέγων ‘φιλοσοφία ἐστὶ γνῶσις τῶν ὄντων ᾗ ὄντα ἐστί’, δεύτερος δὲ ‘γνῶσις θείων τε καὶ ἀνθρωπίνων πραγμάτων’, τρίτος ‘μελέτη θανάτου’, τέταρτος ‘ὁμοίωσις θεῷ κατὰ τὸ δυνατὸν ἀνθρώπῳ’, πέμπτος ‘τέχνη τεχνῶν καὶ ἐπιστήμη ἐπιστημῶν’, ἕκτος ‘φιλοσοφία ἐστὶ φιλία σοφίας’ καὶ ταῦτα μὲν τὸ ἕκτον κεφάλαιον.", "seq": 416}
{"id": "David_Passim_0417", "series": "CAG", "text": "Ἕβδομον δέ ἐστι κεφάλαιον, διὰ τί τοσοῦτοί εἰσιν οἱ τῆς φιλοσοφίας ὁρισμοὶ καὶ μήτε πλείονες μήτε ἐλάττονες.", "seq": 417}
{"id": "David_Passim_0418", "series": "CAG", "text": "καὶ ἔστιν εἰπεῖν δύο λύσεις, μίαν μὲν ἀπὸ διαιρέσεως, ἑτέραν δὲ ἀριθμητικήν.", "seq": 418}
{"id": "David_Passim_0419", "series": "CAG", "text": "ἔστι δὲ ἡ ἀπὸ διαιρέσεως αὕτη·", "seq": 419}
{"id": "David_Passim_0420", "series": "CAG", "text": "εἰσί τινα ὑφεστηκότα μέν, μὴ ὀνομαζόμενα δέ, ὡς ἐπὶ τῶν ὄντων ἐν τῷ βυθῷ καὶ ἐν τοῖς ἀβάτοις ὄρεσιν·", "seq": 420}
{"id": "David_Passim_0421", "series": "CAG", "text": "εἰσὶ γάρ τινα ἐν τῷ βυθῷ, ἅτινα εἰσὶ μέν, οὐκ ὀνομάζονται δὲ διὰ τὸ μὴ γινώσκεσθαι ὑφ᾿ ἡμῶν.", "seq": 421}
{"id": "David_Passim_0422", "series": "CAG", "text": "καὶ πάλιν εἰσί τινα ὀνομαζόμενα μέν, μὴ ὑφεστηκότα δέ, ὡς ἐπὶ τοῦ ἱπποκενταύρου·", "seq": 422}
{"id": "David_Passim_0423", "series": "CAG", "text": "τοῦτο γὰρ ὀνομάζεται μέν, οὐχ ὑφέστηκε δέ·", "seq": 423}
{"id": "David_Passim_0424", "series": "CAG", "text": "οὐ γὰρ ἔστιν ἱπποκένταυρος.", "seq": 424}
{"id": "David_Passim_0425", "series": "CAG", "text": "καὶ πάλιν εἰσί τινα καὶ ὀνομαζόμενα καὶ ὑφεστηκότα, ὥσπερ ὁ ἄνθρωπος καὶ αἱ τέχναι·", "seq": 425}
{"id": "David_Passim_0426", "series": "CAG", "text": "καὶ γὰρ ὀνομάζονται καὶ εἰσίν.", "seq": 426}
{"id": "David_Passim_0427", "series": "CAG", "text": "ἡ δὲ φιλοσοφία καὶ ὀνομάζεται καὶ ὑφέστηκεν, ὡς ἐν τῷ εἰ ἔστι μεμαθήκαμεν.", "seq": 427}
{"id": "David_Passim_0428", "series": "CAG", "text": "καὶ ἐν πρώτοις τὴν ὕπαρξιν ἔχει·", "seq": 428}
{"id": "David_Passim_0429", "series": "CAG", "text": "καὶ γὰρ ἡ φιλοσοφία μήτηρ τῶν τεχνῶν καὶ ἐπιστημῶν ἐστιν·", "seq": 429}
{"id": "David_Passim_0430", "series": "CAG", "text": "ἐξ αὐτῆς γὰρ τὰς ἀρχὰς καὶ αἱ τέχναι καὶ αἱ ἐπιστῆμαι λαμβάνουσιν.", "seq": 430}
{"id": "David_Passim_0431", "series": "CAG", "text": "οἷον ὁ γεωμέτρης λαμβάνει ὁμολογούμενον ὅτι σημεῖόν ἐστιν οὗ μέρος οὐδέν·", "seq": 431}
{"id": "David_Passim_0432", "series": "CAG", "text": "τούτου δὲ τὴν αἰτίαν ὁ φυσικὸς φιλόσοφος οἶδε.", "seq": 432}
{"id": "David_Passim_0433", "series": "CAG", "text": "καὶ πάλιν ὁ ἰατρὸς λαμβάνει ὁμολογούμενον ὅτι ἐκ τῶν τεσσάρων στοιχείων τὰ ἀνθρώπεια σώματα συνίστανται·", "seq": 433}
{"id": "David_Passim_0434", "series": "CAG", "text": "τούτου δὲ τὴν αἰτίαν ὁ φυσικὸς φιλόσοφος οἶδε.", "seq": 434}
{"id": "David_Passim_0435", "series": "CAG", "text": "καὶ πάλιν ὁ γραμματικὸς λαμβάνει ὁμολογούμενον ὅτι τὸ η καὶ τὸ ω μακρά εἰσι·", "seq": 435}
{"id": "David_Passim_0436", "series": "CAG", "text": "τούτου δὲ τὴν αἰτίαν ὁ μουσικὸς φιλόσοφος οἶδεν.", "seq": 436}
{"id": "David_Passim_0437", "series": "CAG", "text": "ἡ φιλοσοφία οὖν, ὡς εἴρηται, καὶ ὀνομάζεται καὶ ὑφέστηκε καὶ ἐν πρώτοις τὴν ὕπαρξιν ἔχει.", "seq": 437}
{"id": "David_Passim_0438", "series": "CAG", "text": "καὶ ἐπειδὴ μὲν ὀνομάζεται, ἔχει ἐκ τοῦ ὀνόματος ὅρον τὸν λέγοντα ‘φιλοσοφία ἐστὶ φιλία σοφίας’, ἐπειδὴ δὲ ἐν πρώτοις ἔχει τὴν ὕπαρξιν, ἔχει τὸν ἐκ τῆς ὑπεροχῆς ὅρον τὸν λέγοντα ‘φιλοσοφία ἐστὶ τέχνη τεχνῶν καὶ ἐπιστήμη ἐπιστημῶν’.", "seq": 438}
{"id": "David_Passim_0439", "series": "CAG", "text": "ἐπειδὴ δὲ ὑφέστηκεν, ἔχει καὶ ὑποκείμενον, ἔχει καὶ τέλος, καὶ ἑκάτερον τούτων διττόν·", "seq": 439}
{"id": "David_Passim_0440", "series": "CAG", "text": "πᾶσα γὰρ τέχνη καὶ ἐπιστήμη ἔχει καὶ ὑποκείμενον, ἔχει καὶ τέλος, καὶ ἑκάτερον τούτων διττόν·", "seq": 440}
{"id": "David_Passim_0441", "series": "CAG", "text": "ἔχει γὰρ προσεχὲς ὑποκείμενον, ἔχει καὶ πόρρω ὑποκείμενον, καὶ πάλιν ἔχει καὶ προσεχὲς τέλος καὶ πόρρω τέλος.", "seq": 441}
{"id": "David_Passim_0442", "series": "CAG", "text": "ἀλλ᾿ ἵνα σαφὲς ἡμῖν τὸ λεγόμενον γένηται.", "seq": 442}
{"id": "David_Passim_0443", "series": "CAG", "text": "γυμνάσωμεν τὸν λόγον ἐπὶ τῆς ναυπηγικῆς.", "seq": 443}
{"id": "David_Passim_0444", "series": "CAG", "text": "ἰστέον ὅτι ἡ ναυπηγικὴ ἔχει καὶ ὑποκείμενον, ἔχει καὶ τέλος, καὶ ἑκάτερον τούτων διττόν·", "seq": 444}
{"id": "David_Passim_0445", "series": "CAG", "text": "ἔχει γὰρ καὶ προσεχὲς ὑποκείμενον καὶ πόρρω ὑποκείμενον, καὶ πάλιν ἔχει προσεχὲς τέλος καὶ πόρρω τέλος.", "seq": 445}
{"id": "David_Passim_0446", "series": "CAG", "text": "καὶ προσεχὲς μὲν ὑποκείμενον ἔχει τὰ ἁπλῶς ξύλα, πόρρω δὲ ὑποκείμενον τὰ τοιάδε ξύλα, οἷον τὰ πεποιωμένα πρὸς τρόπιν καὶ πηδάλιον·", "seq": 446}
{"id": "David_Passim_0447", "series": "CAG", "text": "πρῶτον γὰρ ὁ ναυπηγὸς λαμβάνει τὰ ἁπλῶς ξύλα, καὶ εἶθ᾿ οὕτως ζητεῖ ποῖα πεποίωνται πρὸς τρόπιν καὶ πηδάλιον.", "seq": 447}
{"id": "David_Passim_0448", "series": "CAG", "text": "καὶ πάλιν προσεχὲς μὲν τέλος ἔχει τὸ ποιῆσαι ἁπλῶς ναῦν, πόρρω δὲ τέλος τὸ ποιῆσαι τοιάνδε ναῦν, οἷον ἢ δόρκωνα ἢ λύχνον.", "seq": 448}
{"id": "David_Passim_0449", "series": "CAG", "text": "οὕτως οὖν καὶ ἡ φιλοσοφία ἔχει καὶ ὑποκείμενον καὶ τέλος καὶ ἑκάτερον τούτων διττόν·", "seq": 449}
{"id": "David_Passim_0450", "series": "CAG", "text": "ἔχει γὰρ προσεχὲς ὑποκείμενον καὶ πόρρω καὶ τέλος ὁμοίως προσεχὲς καὶ πόρρω.", "seq": 450}
{"id": "David_Passim_0451", "series": "CAG", "text": "καὶ προσεχὲς μὲν ὑποκείμενον ἔχει τὰ ἁπλῶς ὄντα, πόρρω δὲ ὑποκείμενον τὰ τοιάδε ὄντα, οἷον τὰ θεῖα καὶ τὰ ἀνθρώπινα πράγματα.", "seq": 451}
{"id": "David_Passim_0452", "series": "CAG", "text": "καὶ πάλιν προσεχὲς μὲν τέλος ἔχει τὸ μελετᾶν τὸν θάνατον, ἤγουν τὸ νέκρωσιν ἀπεργάζεσθαι τῶν παθῶν, πόρρω δὲ τέλος ἔχει τὸ διὰ τούτου, ἤγουν διὰ τοῦ νέκρωσιν ἀπεργάζεσθαι τῶν παθῶν, ὁμοιοῦσθαι θεῷ κατὰ τὸ δυνατὸν ἀνθρώπῳ.", "seq": 452}
{"id": "David_Passim_0453", "series": "CAG", "text": "ἐπειδὴ οὖν ἡ φιλοσοφία ἔχει καὶ ὑποκείμενον καὶ τέλος καὶ ἑκάτερον τούτων διττόν, ὡς εἴρηται, τούτου χάριν καὶ ἄλλους τέσσαρας ὅρους ἔχει, δύο ἐκ τοῦ ὑποκειμένου, ἕνα μὲν ἐκ τοῦ προσεχοῦς ὑποκειμένου τὸν λέγοντα ὅτι ‘φιλοσοφία ἐστὶ γνῶσις τῶν ὄντων ᾗ ὄντα ἐστίν’, ἄλλον δὲ ἐκ τοῦ πόρρω ὑποκειμένου τὸν λέγοντα ὅτι ‘φιλοσοφία ἐστὶ γνῶσις θείων τε καὶ ἀνθρωπίνων πραγμάτων’, καὶ δύο ἐκ τοῦ τέλους, ἕνα μὲν ἐκ τοῦ προσεχοῦς τέλους τὸν λέγοντα ὅτι ‘φιλοσοφία ἐστὶ μελέτη θανάτου’, ἄλλον δὲ ἐκ τοῦ πόρρω τέλους τὸν λέγοντα ὅτι ‘φιλοσοφία ἐστὶν ὁμοίωσις θεῷ κατὰ τὸ δυνατὸν ἀνθρώπῳ’.", "seq": 453}
{"id": "David_Passim_0454", "series": "CAG", "text": "Αὕτη μὲν οὖν ἡ ἀπὸ διαιρέσεως λύσις ἡ δεικνῦσα διὰ τί ἕξ εἰσιν οἱ τῆς φιλοσοφίας ὁρισμοί.", "seq": 454}
{"id": "David_Passim_0455", "series": "CAG", "text": "ἡ δὲ ἀριθμητική ἐστιν αὕτη·", "seq": 455}
{"id": "David_Passim_0456", "series": "CAG", "text": "τῶν ἀριθμῶν οἱ μέν εἰσι τέλειοι οἱ δὲ ὑπερτέλειοι οἱ δὲ ἐλλιπεῖς, οἵτινες καὶ ἀτελεῖς καλοῦνται.", "seq": 456}
{"id": "David_Passim_0457", "series": "CAG", "text": "καὶ τέλειος μὲν ἀριθμός ἐστιν οὗ τὰ μέρη συντιθέμενα ἐξισοῦνται τῷ ὅλῳ, ὡς ἐπὶ τοῦ ἕξ·", "seq": 457}
{"id": "David_Passim_0458", "series": "CAG", "text": "τούτου γὰρ τὰ μέρη συντιθέμενα τὸν ἓξ ἀριθμὸν ἀποτελοῦσιν·", "seq": 458}
{"id": "David_Passim_0459", "series": "CAG", "text": "ἔχει γὰρ τὸ ἥμισυ τρία, τὸ τρίτον δύο καὶ τὸ ἕκτον μονάδα·", "seq": 459}
{"id": "David_Passim_0460", "series": "CAG", "text": "ἰδοὺ ἕξ·", "seq": 460}
{"id": "David_Passim_0461", "series": "CAG", "text": "τέταρτον γὰρ προσλαβεῖν οὐ δύναται, ἐπειδὴ ἐὰν προσλάβῃ τέταρτον, ἀναγκάζεται τμηθῆναι ἡ μονάς·", "seq": 461}
{"id": "David_Passim_0462", "series": "CAG", "text": "οἱ δὲ ἀριθμητικοὶ οὐ τέμνουσι τὴν μονάδα.", "seq": 462}
{"id": "David_Passim_0463", "series": "CAG", "text": "ὑπερτελὴς δὲ ἀριθμός ἐστιν οὗ τὰ μέρη συντιθέμενα ὑπὲρ τὸ ὅλον εὑρίσκονται, ὡς ἐπὶ τοῦ δώδεκα·", "seq": 463}
{"id": "David_Passim_0464", "series": "CAG", "text": "τούτου γὰρ τὰ μέρη συντιθέμενα τὸν ἓξ καὶ δέκα ἀριθμὸν ἀποτελοῦσιν·", "seq": 464}
{"id": "David_Passim_0465", "series": "CAG", "text": "ἔχει γὰρ τὸ ἥμισυ ἕξ, τὸ τρίτον τέσσαρα, τὸ τέταρτον τρία, τὸ ἕκτον δύο καὶ τὸ δωδέκατον μονάδα·", "seq": 465}
{"id": "David_Passim_0466", "series": "CAG", "text": "ἰδοὺ δεκαέξ.", "seq": 466}
{"id": "David_Passim_0467", "series": "CAG", "text": "ἐλλιπὴς δὲ ἀριθμὸς ἤτοι ἀτελής ἐστιν οὗ τὰ μέρη συντιθέμενα ἐλάττονα τοῦ ὅλου εὑρίσκονται, ὡς ἐπὶ τοῦ ὀκτώ·", "seq": 467}
{"id": "David_Passim_0468", "series": "CAG", "text": "τούτου γὰρ τὰ μέρη συντιθέμενα τὸν ἑπτὰ ἀριθμὸν ἀποτελοῦσιν·", "seq": 468}
{"id": "David_Passim_0469", "series": "CAG", "text": "ἔχει γὰρ τὸ ἥμισυ τέσσαρα, τὸ τέταρτον δύο καὶ τὸ ὄγδοον μονάδα·", "seq": 469}
{"id": "David_Passim_0470", "series": "CAG", "text": "ἰδοὺ ἑπτά.", "seq": 470}
{"id": "David_Passim_0471", "series": "CAG", "text": "τούτων οὖν οὕτως ἐχόντων ἐπειδὴ πρῶτος τέλειος ἀριθμὸς ὁ ἕξ ἐστιν (πρὸ αὐτοῦ γὰρ ἄλλος τέλειος οὐκ ἔστιν), τούτου χάριν ἕξ εἰσιν οἱ τῆς φιλοσοφίας ὁρισμοί·", "seq": 471}
{"id": "David_Passim_0472", "series": "CAG", "text": "ἔδει γὰρ τὴν μητέρα τῶν τεχνῶν καὶ ἐπιστημῶν τῷ πρώτῳ καὶ τελείῳ ἀριθμῷ κεκοσμῆσθαι.", "seq": 472}
{"id": "David_Passim_0473", "series": "CAG", "text": "ἐν οἷς σὺν θεῷ καὶ ἡ παροῦσα πρᾶξις.", "seq": 473}
{"id": "David_Passim_0474", "series": "CAG", "text": "Πρᾶξις η΄.", "seq": 474}
{"id": "David_Passim_0475", "series": "CAG", "text": "DIV=2$section Ἔλθωμεν ἐπὶ τὸ ὄγδοον κεφάλαιον καὶ εἴπωμεν τὴν τάξιν τῶν ὁρισμῶν τῆς φιλοσοφίας.", "seq": 475}
{"id": "David_Passim_0476", "series": "CAG", "text": "ἰστέον ὅτι ἓξ ὄντων τῶν τῆς φιλοσοφίας ὁρισμῶν ἔσχατός ἐστιν ὁ ἐκ τῆς ἐτυμολογίας ὁ λέγων ὅτι ‘φιλοσοφία ἐστὶ φιλία σοφίας’.", "seq": 476}
{"id": "David_Passim_0477", "series": "CAG", "text": "τῶν δὲ πέντε τῶν ἄλλων ἔσχατός ἐστιν ὁ ἐκ τῆς ὑπεροχῆς ὁ λέγων ὅτι ‘φιλοσοφία ἐστὶ τέχνη τεχνῶν καὶ ἐπιστήμη ἐπιστημῶν’.", "seq": 477}
{"id": "David_Passim_0478", "series": "CAG", "text": "τῶν δὲ τεσσάρων οἱ μὲν ἐκ τοῦ ὑποκειμένου εἰσὶ πρῶτοι, οἱ δὲ ἐκ τοῦ τέλους ἔσχατοι.", "seq": 478}
{"id": "David_Passim_0479", "series": "CAG", "text": "καὶ ἐν ἑκατέρῳ τούτων ὁ ἐκ τοῦ προσεχοῦς προτερεύει τοῦ ἐκ τοῦ πόρρω·", "seq": 479}
{"id": "David_Passim_0480", "series": "CAG", "text": "καὶ γὰρ ὁ ἐκ τοῦ προσεχοῦς ὑποκειμένου ὁ λέγων ὅτι ‘φιλοσοφία ἐστὶ γνῶσις τῶν ὄντων ᾗ ὄντα ἐστί’ προτερεύει τοῦ ἐκ τοῦ πόρρω ὑποκειμένου τοῦ λέγοντος ὅτι ‘φιλοσοφία ἐστὶν γνῶσις θείων τε καὶ ἀνθρωπίνων πραγμάτων’.", "seq": 480}
{"id": "David_Passim_0481", "series": "CAG", "text": "καὶ πάλιν ὁ ἐκ τοῦ προσεχοῦς τέλους ὁ λέγων ὅτι ‘φιλοσοφία ἐστὶ μελέτη θανάτου’ προτερεύει τοῦ ἐκ τοῦ πόρρω τέλους τοῦ λέγοντος ὅτι φιλοσοφία ἐστὶν ὁμοίωσις θεῷ κατὰ τὸ δυνατὸν ἀνθρώπῳ’·", "seq": 481}
{"id": "David_Passim_0482", "series": "CAG", "text": "ὥστε εἶναι τὴν τάξιν οὕτως·", "seq": 482}
{"id": "David_Passim_0483", "series": "CAG", "text": "πρῶτος μέν ἐστιν ὁ λέγων ὅτι ‘φιλοσοφία ἐστὶ γνῶσις τῶν ὄντων ᾗ ὄντα ἐστί’, δεύτερος ‘γνῶσις θείων τε καὶ ἀνθρωπίνων πραγμάτων’, τρίτος ‘μελέτη θανάτου’, τέταρτος ‘ὁμοίωσις θεῷ κατὰ τὸ δυνατὸν ἀνθρώπῳ’, πέμπτος ὁ λέγων ὅτι ‘φιλοσοφία ἐστὶ τέχνη τεχνῶν καὶ ἐπιστήμη ἐπιστημῶν’, ἕκτος δέ ἐστιν ὁ λέγων ὅτι ‘φιλοσοφία ἐστὶ φιλία σοφίας’.", "seq": 483}
{"id": "David_Passim_0484", "series": "CAG", "text": "ταῦτα εἰπόντες ἔλθωμεν καὶ εἴπωμεν τὴν αἰτίαν τῆς τάξεως αὐτῶν.", "seq": 484}
{"id": "David_Passim_0485", "series": "CAG", "text": "ἰστέον ὅτι ὁ ὁρισμὸς ὁ ἀπὸ τῆς ἐτυμολογίας ὁ λέγων ὅτι ‘φιλοσοφία ἐστὶ φιλία σοφίας’ τελευταίαν ἐπέχει τάξιν.", "seq": 485}
{"id": "David_Passim_0486", "series": "CAG", "text": "καὶ τοῦτο εὐλόγως·", "seq": 486}
{"id": "David_Passim_0487", "series": "CAG", "text": "πρῶτον γὰρ δεῖ ὑπάρχειν τὸ πρᾶγμα καὶ τελευταῖον ἐπιτίθεσθαι αὐτῷ ὄνομα, ὅθεν καὶ ὄνομα λέγεται οἱονεὶ τῷ ὄντι ὅμοιον·", "seq": 487}
{"id": "David_Passim_0488", "series": "CAG", "text": "καὶ γὰρ οὐχ ὡς ἔτυχεν ἐπετίθεσαν οἱ ἀρχαῖοι τὸ ὄνομα, ἀλλ᾿ ἁρμοζόντως τῷ ὑποκειμένῳ πράγματι, οἷον ἄνθρωπος λέγεται παρὰ τὸ ἀναθρεῖν καὶ ἀναλογίζεσθαι ἃ ὄπωπε, καὶ πάλιν ἵππος λέγεται παρὰ τὸ ἵπτασθαι τοῖς ποσίν.", "seq": 488}
{"id": "David_Passim_0489", "series": "CAG", "text": "οὕτως οὖν δεῖ ὑπάρχειν τὴν φιλοσοφίαν καὶ τελευταῖον ἐπιτίθεσθαι αὐτῇ ὄνομα καὶ καλεῖν αὐτὴν φιλοσοφίαν.", "seq": 489}
{"id": "David_Passim_0490", "series": "CAG", "text": "ἐπειδὴ οὖν τὸ ὄνομα τελευταίαν ἐπέχει τάξιν, τούτου χάριν καὶ ὁ ἀπὸ τῆς ὀνομασίας ἤγουν ὁ ἀπὸ τῆς ἐτυμολογίας ὅρος τελευταίαν ἐπέχει τάξιν.", "seq": 490}
{"id": "David_Passim_0491", "series": "CAG", "text": "ὁ δὲ ὅρος ὁ ἐκ τῆς ὑπεροχῆς ὁ λέγων ὅτι ‘φιλοσοφία ἐστὶ τέχνη τεχνῶν καὶ ἐπιστήμη ἐπιστημῶν’ ἔσχατος τῶν ἄλλων ἐστὶ διὰ τοιαύτην αἰτίαν·", "seq": 491}
{"id": "David_Passim_0492", "series": "CAG", "text": "τὰ κοινότερα προτερεύουσι τῶν ἰδίως τινὶ ὑπαρχόντων καὶ αὐτῷ μόνῳ τῷ πράγματι ἁρμοζόντων, ὥσπερ καὶ ἐπὶ τῶν ὅρων·", "seq": 492}
{"id": "David_Passim_0493", "series": "CAG", "text": "καὶ γὰρ καὶ ἐν τούτοις αἱ μὲν κοινότεραι λέξεις πρῶταί εἰσίν, αἱ δὲ ἰδίως αὐτῷ ὑπάρχουσαι καὶ τῷ ὁριστῷ μόνῳ ἁρμόζουσαι τελευταίαν ἐπέχουσι τάξιν, οἷον ὡς ἐπὶ τοῦ ‘ἄνθρωπός ἐστι ζῷον λογικὸν θνητὸν καὶ τὰ ἑξῆς’·", "seq": 493}
{"id": "David_Passim_0494", "series": "CAG", "text": "ἰδοὺ ἐνταῦθα αἱ μὲν κοινότεραι λέξεις πρῶταί εἰσιν, οἷον τὸ ζῷον (οὐ γὰρ μόνος ὁ ἄνθρωπός ἐστι ζῷον ἀλλὰ καὶ ἵππος καὶ κύων), καὶ πάλιν τὸ λογικόν (οὐ μόνον γὰρ ὁ ἄνθρωπός ἐστι, λογικὸν ἀλλὰ καὶ ἄγγελος καὶ δαίμων), ὁμοίως καὶ τὸ θνητόν (οὐ μόνον γὰρ ὁ ἄνθρωπός ἐστι θνητὸν ἀλλὰ καὶ αἱ μακραίωνες νύμφαι), αἱ δὲ ἰδίως αὐτῷ ὑπάρχουσαι καὶ τῷ ὁριστῷ μόνῳ ἁρμόζουσαι τελευταίαν ἐπέχουσι τάξιν·", "seq": 494}
{"id": "David_Passim_0495", "series": "CAG", "text": "τὸ γὰρ νοῦ καὶ ἐπιστήμης δεκτικὸν τῷ ἀνθρώπῳ μόνῳ ἁρμόζει·", "seq": 495}
{"id": "David_Passim_0496", "series": "CAG", "text": "μόνος γὰρ ὁ ἄνθρωπος μανθάνει τὴν κατ᾿ ἐνέργειαν γνῶσιν, αἱ δὲ μακραίωνες νύμφαι οὔκ εἰσι νοῦ καὶ ἐπιστήμης δεκτικαί·", "seq": 496}
{"id": "David_Passim_0497", "series": "CAG", "text": "οὐδὲ γὰρ μανθάνουσι τὴν κατ᾿ ἐνέργειαν γνῶσιν, ἀλλ᾿ οἴκοθεν αὐτὴν ἔχουσιν·", "seq": 497}
{"id": "David_Passim_0498", "series": "CAG", "text": "αὗται γὰρ φύσει πάντα ἴσασιν.", "seq": 498}
{"id": "David_Passim_0499", "series": "CAG", "text": "ἐπειδὴ οὖν τὰ κοινότερα προτερεύουσι τῶν ἰδίως τινὶ ὑπαρχόντων, τούτου χάριν καὶ οἱ ἀπὸ τοῦ ὑποκειμένου καὶ οἱ ἀπὸ τοῦ τέλους ὅροι προτερεύουσι τοῦ ἀπὸ τῆς ὑπεροχῆς ὅρου·", "seq": 499}
{"id": "David_Passim_0500", "series": "CAG", "text": "καὶ γὰρ κοινότερον μέν ἐστι τὸ ὑποκείμενον καὶ τὸ τέλος (οὐ μόνον γὰρ ἡ φιλοσοφία ἔχει καὶ ὑποκείμενον καὶ τέλος ἀλλὰ καὶ πᾶσα τέχνη καὶ πᾶσα ἐπιστήμη), ἰδίως δὲ ὑπάρχει τῇ φιλοσοφίᾳ ἡ ὑπεροχή·", "seq": 500}
{"id": "David_Passim_0501", "series": "CAG", "text": "μόνη γὰρ ἡ φιλοσοφία ὑπερέχει πασῶν τῶν τεχνῶν καὶ ἐπιστημῶν.", "seq": 501}
{"id": "David_Passim_0502", "series": "CAG", "text": "οἱ δὲ ἐκ τοῦ ὑποκειμένου ὅροι προτερεύουσι τῶν ἐκ τοῦ τέλους, ἐπειδὴ καὶ τὸ ὑποκείμενον προτερεύει τοῦ τέλους·", "seq": 502}
{"id": "David_Passim_0503", "series": "CAG", "text": "εἰ μὴ γὰρ ᾖ ὑποκείμενον, οὐδὲ τέλος εὑρίσκεται·", "seq": 503}
{"id": "David_Passim_0504", "series": "CAG", "text": "εἰ μὴ γὰρ ἔχει ὁ τέκτων ξύλα, οὐ δύναται ποιῆσαι θρόνον ἢ κλίνην ἤ τι τοιοῦτον.", "seq": 504}
{"id": "David_Passim_0505", "series": "CAG", "text": "οἱ δὲ ἐκ τοῦ προσεχοῦς προτερεύουσι τῶν ἐκ τοῦ πόρρω, οἷον ὁ ἐκ τοῦ προσεχοῦς ὑποκειμένου ὁ λέγων ὅτι ‘φιλοσοφία ἐστὶ γνῶσις τῶν ὄντων ᾗ ὄντα ἐστί’ προτερεύει τοῦ ἐκ τοῦ πόρρω ὑποκειμένου τοῦ λέγοντος ὅτι ‘φιλοσοφία ἐστὶ γνῶσις θείων τε καὶ ἀνθρωπίνων πραγμάτων’.", "seq": 505}
{"id": "David_Passim_0506", "series": "CAG", "text": "καὶ πάλιν ὁ ἐκ τοῦ προσεχοῦς τέλους ὁ λέγων ὅτι ‘φιλοσοφία ἐστὶ μελέτη θανάτου’ προτερεύει τοῦ ἐκ τοῦ πόρρω τέλους τοῦ λέγοντος ὅτι ‘φιλοσοφία ἐστιν ὁμοίωσις θεῷ κατὰ τὸ δυνατὸν ἀνθρώπῳ’, ἐπειδὴ τὸ προσεχὲς προτερεύει τοῦ πόρρω·", "seq": 506}
{"id": "David_Passim_0507", "series": "CAG", "text": "καὶ γὰρ τὸ προσεχὲς ἐγγύτερόν ἐστι καὶ δι᾿ αὐτοῦ ἐπὶ τὸ πόρρω ἐρχόμεθα·", "seq": 507}
{"id": "David_Passim_0508", "series": "CAG", "text": "καὶ γὰρ εἰ μὴ ἔχει ὁ τέκτων τὰ ἁπλῶς ξύλα, οὐ δύναται διακρῖναι τὰ τοιάδε ξύλα, οἷον τὰ πεποιωμένα καὶ τὰ οὐ πεποιωμένα, καὶ πάλιν ὁ φιλόσοφος εἰ μὴ μελετήσῃ τὸν θάνατον, τοῦτ᾿ ἔστι νέκρωσιν ἀπεργάσηται τῶν παθῶν, οὐ δύναται ὁμοιωθῆναι θεῷ.", "seq": 508}
{"id": "David_Passim_0509", "series": "CAG", "text": "ταῦτα μὲν περὶ τῆς τάξεως τῶν ἓξ ὁρισμῶν.", "seq": 509}
{"id": "David_Passim_0510", "series": "CAG", "text": "Ἰστέον δὲ ὅτι καὶ ἄλλους δύο ὅρους θέλουσί τινες ἐπεισφέρειν τῇ φιλοσοφίᾳ, ἕνα μὲν οἱ ἰατροὶ ἕνα δὲ ἕτεροι·", "seq": 510}
{"id": "David_Passim_0511", "series": "CAG", "text": "καὶ γὰρ οἱ ἰατροὶ θέλοντες τὴν οἰκείαν τέχνην σεμνῦναι, κατὰ τὸν ποιητὴν χρύσεα χαλκείων καταλλασσόμενοι, ὁρίζονται λέγοντες ὅτι ‘φιλοσοφία ἐστὶν ἰατρικὴ ψυχῶν, ἰατρικὴ δέ ἐστι φιλοσοφία σωμάτων.’", "seq": 511}
{"id": "David_Passim_0512", "series": "CAG", "text": "οὗτος δὲ ὁ ὅρος οὐκ εὖ ἔχει·", "seq": 512}
{"id": "David_Passim_0513", "series": "CAG", "text": "διάλληλον γὰρ ἔχει δεῖξιν, ἥτις διαβέβληται παρὰ τοῖς φιλοσόφοις, ἐπειδὴ ἡ διάλληλος δεῖξις ἐκ τοῦ ζητουμένου τὸ ζητούμενον κατασκευάζει, ὡς ὅταν εἴπωμεν ‘ποῦ μένει Πλάτων;’", "seq": 513}
{"id": "David_Passim_0514", "series": "CAG", "text": "‘ὅπου μένει Δίων’, καὶ ‘ποῦ μένει Δίων;’", "seq": 514}
{"id": "David_Passim_0515", "series": "CAG", "text": "‘ὅπου μένει Πλάτων’.", "seq": 515}
{"id": "David_Passim_0516", "series": "CAG", "text": "οὕτως οὖν καὶ ἐπὶ τούτοις τοῖς ὁρισμοῖς διάλληλός ἐστι δεῖξις·", "seq": 516}
{"id": "David_Passim_0517", "series": "CAG", "text": "τί γάρ ἐστι φιλοσοφία;", "seq": 517}
{"id": "David_Passim_0518", "series": "CAG", "text": "‘ἰατρικὴ ψυχῶν’, καὶ τί ἰατρική;", "seq": 518}
{"id": "David_Passim_0519", "series": "CAG", "text": "‘φιλοσοφία σωμάτων’·", "seq": 519}
{"id": "David_Passim_0520", "series": "CAG", "text": "καὶ ἰδοὺ ἐρωτώμενοι ‘τί ἐστιν ἰατρική;’", "seq": 520}
{"id": "David_Passim_0521", "series": "CAG", "text": "φασὶ ‘φιλοσοφία’, καὶ ‘τί φιλοσοφία;’", "seq": 521}
{"id": "David_Passim_0522", "series": "CAG", "text": "φασὶν ‘ἰατρική’, καὶ τὸ ζητούμενον ἐκ τοῦ ζητουμένου κατασκευάζουσιν.", "seq": 522}
{"id": "David_Passim_0523", "series": "CAG", "text": "ἄλλως τε δὲ εἰ καὶ δῶμεν τὸν ὅρον τὸν λέγοντα ὅτι ‘φιλοσοφία ἐστὶν ἰατρικὴ ψυχῶν’ καλῶς ἔχειν, ἐμπεριέχεται ἐκ τοῦ ὅρου τοῦ λέγοντος ὅτι ‘φιλοσοφία ἐστὶ μελέτη θανάτου’·", "seq": 523}
{"id": "David_Passim_0524", "series": "CAG", "text": "καὶ γὰρ τὸ μελετᾶν τὸν θάνατον ἤγουν τὸ νέκρωσιν ἀπεργάζεσθαι τῶν παθῶν οὐδὲν ἕτερόν ἐστιν εἰ μὴ τὸ ἰατρεῦσαι ψυχήν.", "seq": 524}
{"id": "David_Passim_0525", "series": "CAG", "text": "ἕτεροι δὲ ἄλλον ὅρον ἐπεισφέρουσι τῇ φιλοσοφίᾳ λέγοντες ‘φιλοσοφία ἐστὶ μεγίστη μουσική’·", "seq": 525}
{"id": "David_Passim_0526", "series": "CAG", "text": "οὕτω γὰρ ὁ Πλάτων ἐν τῷ Φαίδωνι ὁρίζεται αὐτήν.", "seq": 526}
{"id": "David_Passim_0527", "series": "CAG", "text": "οὗτος δὲ ὁ ὅρος ἐμπεριέχεται ἐκ τοῦ ὅρου ἀπὸ τῆς ὑπεροχῆς τοῦ λέγοντος ὅτι ‘φιλοσοφία ἐστὶ τέχνη τεχνῶν καὶ ἐπιστήμη ἐπιστημῶν’·", "seq": 527}
{"id": "David_Passim_0528", "series": "CAG", "text": "καὶ γὰρ ὁ λέγων αὐτὴν μεγίστην μουσικὴν ἀπὸ τῆς ὑπεροχῆς ἐστι.", "seq": 528}
{"id": "David_Passim_0529", "series": "CAG", "text": "ταῦτα μὲν τὸ ὄγδοον κεφάλαιον.", "seq": 529}
{"id": "David_Passim_0530", "series": "CAG", "text": "Ἔλθωμεν δὲ καὶ ἐπὶ τὸ ἔνατον καὶ εἴπωμεν τίνες ἐφεῦρον τούτους τοὺς ὅρους.", "seq": 530}
{"id": "David_Passim_0531", "series": "CAG", "text": "ἰστέον ὅτι οἱ δύο, ὁ ἀπὸ τοῦ ὑποκειμένου καὶ ὁ ἐκ τῆς ἐτυμολογίας, εἰς τὸν Πυθαγόραν ἀναφέρονται.", "seq": 531}
{"id": "David_Passim_0532", "series": "CAG", "text": "τοῦτο δὲ οὐκ ἔχομεν δεῖξαι ἀπὸ Πυθαγορείων συγγραμμάτων·", "seq": 532}
{"id": "David_Passim_0533", "series": "CAG", "text": "οὐκ ἐποίησε γὰρ συγγράμματα ὁ Πυθαγόρας·", "seq": 533}
{"id": "David_Passim_0534", "series": "CAG", "text": "ἔλεγε γὰρ ὅτι ‘οὐ βούλομαι ἐν ἀψύχοις τὰ ἐμὰ καταλιπεῖν (ἄψυχα δὲ ἐκάλει τὰ βιβλία), ἀλλ᾿ ἐν ἐμψύχοις ἤτοι ἐν τοῖς μαθηταῖς, οἵτινες καὶ ἐρωτώμενοι δύνανται ἀποκρίνασθαι’·", "seq": 534}
{"id": "David_Passim_0535", "series": "CAG", "text": "καὶ γὰρ ὁ ἄνθρωπος δύναται πρὸς τὴν ἀπορίαν ἀποκρίνασθαι, τὸ δὲ βιβλίον οὐ δύναται ἀποκρίνασθαι, καὶ ὡς ἔλεγέ τις τῶν Πυθαγορείων ‘οὐ δύνανται τὰ βιβλία διδάξαι με ἀεί, ἄλλα καὶ ἄλλα ἀεὶ περὶ τῶν αὐτῶν φθεγγόμενον’·", "seq": 535}
{"id": "David_Passim_0536", "series": "CAG", "text": "καὶ γὰρ τὸ βιβλίον ἀεὶ τὰ αὐτὰ περὶ τῶν αὐτῶν λέγει καὶ οὐ δύναται πρὸς τὸ ἐρωτώμενον ἀποκρίνασθαι, ὁ δὲ ἄνθρωπος δύναται πρὸς τὸ ἐρωτώμενον ἀποκρίνασθαι.", "seq": 536}
{"id": "David_Passim_0537", "series": "CAG", "text": "ὡς οὖν εἴρηται, ἐκ τῶν Πυθαγορείων συγγραμμάτων οὐκ ἔχομεν δεῖξαι ὅτι οὗτοι οἱ ὅροι εἰς Πυθαγόραν ἀναφέρονται·", "seq": 537}
{"id": "David_Passim_0538", "series": "CAG", "text": "οὐδὲ γὰρ συγγράμματα κατέλιπε·", "seq": 538}
{"id": "David_Passim_0539", "series": "CAG", "text": "μηδὲ γάρ τις οἰέσθω τὰ Χρυσᾶ ἔπη αὐτοῦ εἶναι, ἀλλά τις τῶν Πυθαγορείων ἐποίησε ταῦτα καὶ πρὸς τιμὴν ἐπέγραψε τὸ ὄνομα τοῦ οἰκείου διδασκάλου.", "seq": 539}
{"id": "David_Passim_0540", "series": "CAG", "text": "δείκνυμεν δὲ ὅτι οὗτοι οἱ ὅροι τοῦ Πυθαγόρου εἰσὶν ἐκ τῶν Πυθαγορείων·", "seq": 540}
{"id": "David_Passim_0541", "series": "CAG", "text": "καὶ γὰρ ὁ Νικόμαχος (εἷς δὲ οὗτος τῶν Πυθαγορείων) λέγει ὅτι ‘ὁ Πυθαγόρας οὕτως ὡρίζετο τὴν φιλοσοφίαν·", "seq": 541}
{"id": "David_Passim_0542", "series": "CAG", "text": "φιλοσοφία ἐστὶ γνῶσις τῶν ὄντων ᾗ ὄντα ἐστί, καὶ πάλιν γνῶσις θείων τε καὶ ἀνθρωπίνων πραγμάτων, καὶ πάλιν φιλοσοφία ἐστὶ φιλία σοφίας’.", "seq": 542}
{"id": "David_Passim_0543", "series": "CAG", "text": "οἱ δὲ δύο οἱ ἐκ τοῦ τέλους εἰς τὸν Πλάτωνα ἀναφέρονται, ὁ λέγων ὅτι ‘φιλοσοφία ἐστὶ μελέτη θανάτου’ καὶ πάλιν ὁ λέγων ὅτι ‘φιλοσοφία ἐστὶν ὁμοίωσις θεῷ κατὰ τὸ δυνατὸν ἀνθρώπῳ’·", "seq": 543}
{"id": "David_Passim_0544", "series": "CAG", "text": "καὶ γὰρ ἐν μὲν τῷ Φαίδωνι φαίνεται δοξάζων τὴν φιλοσοφίαν μελέτην θανάτου, δι᾿ ὧν φησι ‘κινδυνεύουσι γὰρ ὅσοι τυγχάνουσιν ὀρθῶς ἁπτόμενοι φιλοσοφίας λεληθέναι σφᾶς τε αὐτοὺς καὶ τοὺς ἄλλους μηδὲν ἕτερον μελετῶντες ἢ θνήσκειν τε καὶ τεθνάναι’, ἐν δὲ τῷ Θεαιτήτῳ φαίνεται δοξάζων αὐτὴν ὁμοίωσιν θεῷ κατὰ τὸ δυνατὸν ἀνθρώπῳ, δι᾿ ὧν φησιν ‘ἀλλ᾿ ἐπεί, ὦ Θεόδωρε (γεωμέτρης δὲ οὗτος), οὔτ᾿ ἀπολέσθαι τὰ κακὰ δυνατόν (ὑπεναντίον γάρ τι τῷ ἀγαθῷ εἶναι ἀνάγκη) οὔτ᾿ ἐν θεοῖς αὐτὰ ἱδρῦσθαι, τήνδε τὴν θνητὴν φύσιν καὶ τόνδε τὸν τόπον ἐξ ἀνάγκης περιπολεῖ.", "seq": 544}
{"id": "David_Passim_0545", "series": "CAG", "text": "διὸ δεῖ πειρᾶσθαι φεύγειν ἐνθένδε ἐκεῖσε ὅτι τάχιστα.", "seq": 545}
{"id": "David_Passim_0546", "series": "CAG", "text": "τίς οὖν ἡ φυγή ἐστιν;", "seq": 546}
{"id": "David_Passim_0547", "series": "CAG", "text": "ὁμοίωσις θεῷ κατὰ τὸ δυνατὸν ἀνθρώπῳ.", "seq": 547}
{"id": "David_Passim_0548", "series": "CAG", "text": "ὁμοίωσις δὲ θεῷ ἐστι τὸ ὅσιον καὶ δίκαιον γενέσθαι μετὰ φρονήσεως’.", "seq": 548}
{"id": "David_Passim_0549", "series": "CAG", "text": "ὁ δὲ ἐκ τῆς ὑπεροχῆς ὅρος ὁ λέγων ὅτι ‘φιλοσοφία ἐστὶ τέχνη τεχνῶν καὶ ἐπιστήμη ἐπιστημῶν’ εἰς τὸν Ἀριστοτέλην ἀναφέρεται·", "seq": 549}
{"id": "David_Passim_0550", "series": "CAG", "text": "οὕτω γὰρ τὴν φιλοσοφίαν ὁρίζεται ἐν τῇ Μετὰ τὰ φυσικά.", "seq": 550}
{"id": "David_Passim_0551", "series": "CAG", "text": "ἐν οἷς σὺν θεῷ καὶ ἡ παροῦσα πρᾶξις.", "seq": 551}
{"id": "David_Passim_0552", "series": "CAG", "text": "Πρᾶξις θ΄.", "seq": 552}
{"id": "David_Passim_0553", "series": "CAG", "text": "Μαθόντες πόσοι καὶ ποῖοι τῆς φιλοσοφίας εἰσὶν ὁρισμοὶ καὶ τὴν αἰτίαν δι᾿ ἣν τοσοῦτοί εἰσι καὶ τὴν τάξιν αὐτῶν καὶ τίνες ἐφεῦρον αὐτούς, ἔλθωμεν καὶ τούτους σαφηνίσωμεν εἰς μέσον αὐτοὺς ἀγαγόντες.", "seq": 553}
{"id": "David_Passim_0554", "series": "CAG", "text": "ἰστέον ὅτι πρῶτος ὅρος ἐστὶν ὁ λέγων ὅτι ‘φιλοσοφία ἐστὶ γνῶσις τῶν ὄντων ᾗ ὄντα ἐστί’.", "seq": 554}
{"id": "David_Passim_0555", "series": "CAG", "text": "καὶ δεῖ γινώσκειν ὅτι ἀντὶ μὲν γένους εἴληπται τὸ γνῶσις·", "seq": 555}
{"id": "David_Passim_0556", "series": "CAG", "text": "καὶ γὰρ ἡ γνῶσις κοινότερόν τί ἐστιν·", "seq": 556}
{"id": "David_Passim_0557", "series": "CAG", "text": "ἔστι γὰρ γνῶσις καθολικὴ καὶ γνῶσις μερικὴ καὶ πάλιν γνῶσις μετ᾿ αἰτίας καὶ γνῶσις ἄνευ αἰτίας, ὡς ἡ κατ᾿ ἐμπειρίαν γνῶσις.", "seq": 557}
{"id": "David_Passim_0558", "series": "CAG", "text": "αἱ δὲ λοιπαὶ λέξεις ἀντὶ συστατικῶν διαφορῶν λαμβάνονται διαχωρίζουσαι τὴν φιλοσοφίαν ἀπὸ τῶν ἄλλων τεχνῶν καὶ τῶν ἄλλων ἐπιστημῶν·", "seq": 558}
{"id": "David_Passim_0559", "series": "CAG", "text": "καὶ γὰρ ἡ φιλοσοφία μὲν πάντων τῶν ὄντων ἐστὶ γνῶσις, αἱ δὲ ἄλλαι τέχναι καὶ ἐπιστῆμαι οὐ πάντων τῶν ὄντων εἰσὶ γνώσεις ἀλλὰ τινῶν ὄντων·", "seq": 559}
{"id": "David_Passim_0560", "series": "CAG", "text": "καὶ γὰρ ἡ ἀστρονομία περὶ μόνους τοὺς ἀστέρας καταγίνεται καὶ ἡ ἰατρικὴ περὶ μόνα τὰ ἀνθρώπεια σώματα καταγίνεται καὶ ἡ τεκτονικὴ περὶ μόνα τὰ ξύλα καταγίνεται.", "seq": 560}
{"id": "David_Passim_0561", "series": "CAG", "text": "ταῦτα μὲν ἐν τούτοις.", "seq": 561}
{"id": "David_Passim_0562", "series": "CAG", "text": "Ἀποροῦσι δέ τινες λέγοντες·", "seq": 562}
{"id": "David_Passim_0563", "series": "CAG", "text": "διὰ τί εἶπε γνῶσις;", "seq": 563}
{"id": "David_Passim_0564", "series": "CAG", "text": "τί γάρ;", "seq": 564}
{"id": "David_Passim_0565", "series": "CAG", "text": "μόνη ἡ φιλοσοφία ἐστὶ γνῶσις καὶ οὐχὶ πᾶσα τέχνη;", "seq": 565}
{"id": "David_Passim_0566", "series": "CAG", "text": "καὶ ἐπιλυόμενοί τινες λέγουσιν ὅτι ἐπειδὴ αἱ τέχναι ὀλίγα μὲν γινώσκουσαι πολλὰ δὲ ἀγνοοῦσαι μᾶλλον ἄγνοιαί εἰσιν ἤπερ γνώσεις, ἡ δὲ φιλοσοφία ὡς πάντα γινώσκουσα κυρίως γνῶσίς ἐστι.", "seq": 566}
{"id": "David_Passim_0567", "series": "CAG", "text": "ταῦτα μὲν οὗτοι λέγουσιν ἐπιλυόμενοι.", "seq": 567}
{"id": "David_Passim_0568", "series": "CAG", "text": "ἔστι δὲ εἰπεῖν ὅτι περιττή ἐστιν ἡ ἀπορία·", "seq": 568}
{"id": "David_Passim_0569", "series": "CAG", "text": "κατὰ γὰρ τὸν λόγον αὐτῶν οὐδὲ τὸν ἄνθρωπον ὁριζόμενοι ὀφείλομεν λέγειν ζῷον, ἐπειδὴ οὐ μόνον ἄνθρωπός ἐστι ζῷον ἀλλὰ καὶ ἵππος καὶ βοῦς.", "seq": 569}
{"id": "David_Passim_0570", "series": "CAG", "text": "πάλιν ἀποροῦσι λέγοντες·", "seq": 570}
{"id": "David_Passim_0571", "series": "CAG", "text": "διὰ τί εἶπε μετὰ τοῦ ἄρθρου ‘γνῶσις τῶν ὄντων’ καὶ μὴ ἄνευ ἄρθρου ‘γνῶσις ὄντων’;", "seq": 571}
{"id": "David_Passim_0572", "series": "CAG", "text": "καὶ ἐπιλυόμενοι λέγουσιν ὅτι διὰ τοῦτο εἶπε μετὰ τοῦ ἄρθρου, ἵνα δείξῃ ὅτι ἔχουσι κοινωνίαν τὰ ὄντα·", "seq": 572}
{"id": "David_Passim_0573", "series": "CAG", "text": "καὶ γὰρ τὰ ὄντα καὶ ἄνω ἔχουσι κοινωνίαν κατὰ τὸ ποιητικὸν αἴτιον, ἤγουν κατὰ τὸ δημιουργικόν, καὶ κάτω κατὰ τὸ ὑλικόν, ὡς καὶ ὁ Πλάτων λέγει ‘συνέδησεν ὁ θεὸς τὰς κορυφὰς τῶν πραγμάτων ἄνω τε καὶ κάτω, ἄνω μὲν κατὰ τὸ ποιητικὸν αἴτιον, ἤγουν δημιουργικόν, κάτω δὲ κατὰ τὸ ὑλικόν’.", "seq": 573}
{"id": "David_Passim_0574", "series": "CAG", "text": "ταῦτα μὲν οὗτοι.", "seq": 574}
{"id": "David_Passim_0575", "series": "CAG", "text": "ἔστι δὲ εἰπεῖν πρὸς αὐτοὺς ὅτι κακῶς λέγετε·", "seq": 575}
{"id": "David_Passim_0576", "series": "CAG", "text": "οὐδὲ γὰρ τὸ ἄρθρον δηλοῖ κοινωνίαν ἀλλ᾿ ἢ ὅλως ἀναφορὰν καὶ ἀναπόλησιν προεγνωσμένου πράγματος·", "seq": 576}
{"id": "David_Passim_0577", "series": "CAG", "text": "ἐὰν γὰρ εἴπω ‘ἄνθρωπος ἦλθεν’, ἀγνοούμενόν τινα δηλῶ, ἐὰν δὲ εἴπω ‘ὁ ἄνθρωπος ἦλθε’, προεγνωσμένον τινὰ εἰσάγω.", "seq": 577}
{"id": "David_Passim_0578", "series": "CAG", "text": "ἔστιν οὖν εἰπεῖν ὅτι διὰ τοῦτο μετὰ τοῦ ἄρθρου εἶπεν οἷον ‘γνῶσις τῶν ὄντων’, ἵνα δηλώσῃ ὅτι πάντων τῶν ὄντων γνῶσίς ἐστιν ἡ φιλοσοφία καὶ οὐ τινῶν ὄντων·", "seq": 578}
{"id": "David_Passim_0579", "series": "CAG", "text": "εἰ γὰρ εἶπε χωρὶς ἄρθρου οἷον ‘γνῶσις ὄντων’, τὸ αὐτὸ ἔλεγεν ὡς εἰ ἔλεγε ‘γνῶσις τινῶν ὄντων’, ὡς καὶ ὁ Ἀριστοτέλης ἐν τῷ Περὶ ἑρμηνείας φησὶν ὅτι αἱ ἀπροσδιόριστοι προτάσεις ἰσοδυναμοῦσι ταῖς μερικαῖς προσδιωρισμέναις προτάσεσιν, οἷον ὁ λέγων ‘ἄνθρωπος περιπατεῖ’ τὸ αὐτὸ λέγει ὡς ἵνα λέγῃ ‘τίς ἄνθρωπος περιπατεῖ’.", "seq": 579}
{"id": "David_Passim_0580", "series": "CAG", "text": "αἱ δὲ μετὰ τοῦ ἄρθρου προτάσεις ἰσοδυναμοῦσι ταῖς καθολικαῖς προσδιωρισμέναις προτάσεσι·", "seq": 580}
{"id": "David_Passim_0581", "series": "CAG", "text": "καὶ γὰρ ‘ὁ ἄνθρωπος περιπατεῖ’ ἐὰν εἴπῃ τις, τὸ αὐτὸ λέγει ὡς ἵνα λέγῃ ‘πᾶς ἄνθρωπος περιπατεῖ’.", "seq": 581}
{"id": "David_Passim_0582", "series": "CAG", "text": "ἵνα οὖν δηλώσῃ ὅτι πάντων τῶν ὄντων ἐστὶ γνῶσις ἡ φιλοσοφία καὶ οὐ τινῶν ὄντων, τούτου χάριν εἶπε μετὰ τοῦ ἄρθρου.", "seq": 582}
{"id": "David_Passim_0583", "series": "CAG", "text": "πάλιν ἀποροῦσι λέγοντες·", "seq": 583}
{"id": "David_Passim_0584", "series": "CAG", "text": "διὰ τί εἶπε ‘γνῶσις τῶν ὄντων’ καὶ οὐκ εἶπε ‘καὶ τῶν μὴ ὄντων’;", "seq": 584}
{"id": "David_Passim_0585", "series": "CAG", "text": "καὶ ἔστιν εἰπεῖν ὅτι πρῶτον μὲν μὴ ὄντων οὐκ ἔστι γνῶσις (οὐδεὶς γὰρ τὰ μὴ ὄντα δύναται γνῶναι·", "seq": 585}
{"id": "David_Passim_0586", "series": "CAG", "text": "ἡ γὰρ γνῶσις τῶν ὄντων ἐστί), δεύτερον δὲ εἰ καὶ δῶμεν τῶν μὴ ὄντων εἶναι γνῶσιν, διὰ τοῦ εἰπεῖν ‘γνῶσις τῶν ὄντων’ συμπεριέλαβε καὶ τὰ ἀντικείμενα, λέγω δὴ τὰ μὴ ὄντα·", "seq": 586}
{"id": "David_Passim_0587", "series": "CAG", "text": "καὶ γὰρ ὁ γινώσκων τὸ ἓν τῶν ἀντικειμένων καὶ τὸ ἕτερον τῶν ἀντικειμένων γινώσκει·", "seq": 587}
{"id": "David_Passim_0588", "series": "CAG", "text": "οἷον ὁ γινώσκων ὅτι τὸ λευκόν ἐστι χρῶμα διακριτικὸν ὄψεως οἶδεν ὅτι τὸ μέλαν χρῶμα συγκριτικὸν ὄψεώς ἐστι.", "seq": 588}
{"id": "David_Passim_0589", "series": "CAG", "text": "ταῦτα μὲν ἐν τούτοις.", "seq": 589}
{"id": "David_Passim_0590", "series": "CAG", "text": "ἰστέον δὲ ὅτι ‘ᾗ ὄντα ἐστί’ προσέθηκεν, ἵνα δηλώσῃ πῶς γινώσκει ἡ φιλοσοφία τὰ ὄντα, τοῦτ᾿ ἔστιν ὅτι οὐ γινώσκει αὐτὰ κατὰ τὸ ποσόν·", "seq": 590}
{"id": "David_Passim_0591", "series": "CAG", "text": "οὐ γὰρ γινώσκει τὸ πόσοι ἄνθρωποί εἰσιν ἢ ἵπποι ἢ ἀστέρες, ἀλλὰ τὴν φύσιν αὐτῶν γινώσκει.", "seq": 591}
{"id": "David_Passim_0592", "series": "CAG", "text": "τοῦτο οὖν βούλεται δηλοῦν τὸ ‘φιλοσοφία ἐστὶ γνῶσις τῶν ὄντων ᾗ ὄντα ἐστί’, τοῦτ᾿ ἔστι καθὸ ὑπάρχουσι καὶ ὅπως ἔχουσι φύσεως·", "seq": 592}
{"id": "David_Passim_0593", "series": "CAG", "text": "οὕτω γὰρ γινώσκει αὐτά, ὡς ἔχουσι φύσεως.", "seq": 593}
{"id": "David_Passim_0594", "series": "CAG", "text": "Ταῦτα μὲν ἡ σαφήνεια τοῦ πρώτου ὅρου τοῦ λέγοντος ‘φιλοσοφία ἐστὶ γνῶσις τῶν ὄντων ᾗ ὄντα ἐστίν’.", "seq": 594}
{"id": "David_Passim_0595", "series": "CAG", "text": "ἔλθωμεν δὲ καὶ ἐπὶ τὸν δεύτερον ὅρον καὶ τοῦτον σαφηνίσωμεν.", "seq": 595}
{"id": "David_Passim_0596", "series": "CAG", "text": "ἰστέον ὅτι δεύτερος ὅρος τῆς φιλοσοφίας ἐστὶν ὁ λέγων ὅτι ‘φιλοσοφία ἐστὶ γνῶσις θείων τε καὶ ἀνθρωπίνων πραγμάτων’.", "seq": 596}
{"id": "David_Passim_0597", "series": "CAG", "text": "καὶ δεῖ γινώσκειν ὅτι ἡ μὲν γνῶσις ἀντὶ γένους εἴληπται, αἱ δὲ λοιπαὶ λέξεις ἀντὶ συστατικῶν διαφορῶν·", "seq": 597}
{"id": "David_Passim_0598", "series": "CAG", "text": "καὶ γὰρ ἡ φιλοσοφία περὶ τὰ θεῖα καὶ ἀνθρώπινα πράγματα καταγίνεται καὶ οὔτε τῶν θείων καταφρονεῖ διὰ τὸ καταγίνεσθαι περὶ τὰ ἀνθρώπινα οὔτε τῶν ἀνθρωπίνων ἀμελεῖ διὰ τὸ καταγίνεσθαι περὶ τὰ θεῖα, ἀλλὰ τῶν μὲν θείων ἐφίεται ὡς μαθητιῶσα τὰ δὲ ἀνθρώπινα κοσμεῖ ἐπὶ τὸ τέλειον αὐτὰ ἀνάγουσα.", "seq": 598}
{"id": "David_Passim_0599", "series": "CAG", "text": "ἀποροῦσι δέ τινες λέγοντες·", "seq": 599}
{"id": "David_Passim_0600", "series": "CAG", "text": "πῶς φατε τὴν φιλοσοφίαν γνῶσιν θείων τε καὶ ἀνθρωπίνων πραγμάτων εἶναι, εἴ γε οὐ μόνον περὶ τὰ θεῖα καὶ ἀνθρώπινα πράγματα καταγίνεται ἀλλὰ καὶ περὶ ἄλλα τινά·", "seq": 600}
{"id": "David_Passim_0601", "series": "CAG", "text": "διαλαμβάνει γὰρ περὶ οὐρανοῦ, ὅσπερ οὐκ ἔστι θεός, καὶ πάλιν Περὶ ζῴων ὁ Ἀριστοτέλης διαλαμβάνει, ἐν ᾧ οὐ μόνον περὶ ἀνθρώπων ἔγραψεν ἀλλὰ καὶ περὶ ἄλλων ζῴων, καὶ πάλιν περὶ φυτῶν, ἅπερ οὔτε θεός ἐστιν οὔτε ἄνθρωπος.", "seq": 601}
{"id": "David_Passim_0602", "series": "CAG", "text": "ἔστιν οὖν εἰπεῖν ὅτι ἐπειδὴ τῶν ὄντων τὰ μὲν ἀίδιά εἰσι τὰ δὲ φθαρτά, καὶ ἐν μὲν τοῖς ἀιδίοις τιμιώτερά εἰσι τὰ θεῖα ἐν δὲ τοῖς φθαρτοῖς τὰ ἀνθρώπινα, τούτου χάριν ἐμνημόνευσε τούτων μόνων ὡς τιμιωτέρων.", "seq": 602}
{"id": "David_Passim_0603", "series": "CAG", "text": "ἰστέον δὲ ὅτι ἑκάτερος τῶν ῥηθέντων ὅρων καὶ νικᾷ τὸν ἕτερον καὶ νικᾶται ὑπὸ τοῦ ἑτέρου·", "seq": 603}
{"id": "David_Passim_0604", "series": "CAG", "text": "καὶ γὰρ ὁ μὲν πρῶτος ὅρος νικᾷ τὸν δεύτερον τῇ ἀκριβείᾳ·", "seq": 604}
{"id": "David_Passim_0605", "series": "CAG", "text": "ἐδήλωσε γὰρ πῶς γινώσκει τὰ ὄντα ἡ φιλοσοφία διὰ τῆς προσθήκης ‘ᾗ ὄντα ἐστίν’.", "seq": 605}
{"id": "David_Passim_0606", "series": "CAG", "text": "ὁ δὲ δεύτερος ὅρος νικᾷ τὸν πρῶτον τῇ σαφηνείᾳ·", "seq": 606}
{"id": "David_Passim_0607", "series": "CAG", "text": "διὰ γὰρ τοῦ εἰπεῖν ‘γνῶσις θείων τε καὶ ἀνθρωπίνων πραγμάτων’ ἐδήλωσε περὶ ποῖα ὄντα καταγίνεται ἡ φιλοσοφία.", "seq": 607}
{"id": "David_Passim_0608", "series": "CAG", "text": "ἐν οἷς σὺν θεῷ καὶ ἡ παροῦσα πρᾶξις.", "seq": 608}
{"id": "David_Passim_0609", "series": "CAG", "text": "Πρᾶξις ι΄.", "seq": 609}
{"id": "David_Passim_0610", "series": "CAG", "text": "Τρίτος ὅρος ἐστὶν ὁ ἀπὸ τοῦ προσεχοῦς τέλους ὁ λέγων ὅτι ‘φιλοσοφία ἐστὶ μελέτη θανάτου’·", "seq": 610}
{"id": "David_Passim_0611", "series": "CAG", "text": "οὕτω γὰρ ὁρίζεται αὐτὴν ὁ Πλάτων ἐν τῷ Φαίδωνι, δι᾿ ὧν φησι ‘κινδυνεύουσι γὰρ ὅσοι τυγχάνουσιν ὀρθῶς ἁπτόμενοι φιλοσοφίας λεληθέναι σφᾶς τε αὐτοὺς καὶ τοὺς ἄλλους μηδὲν ἕτερον μελετῶντες ἢ θνήσκειν τε καὶ τεθνάναι’.", "seq": 611}
{"id": "David_Passim_0612", "series": "CAG", "text": "καλῶς δὲ τὰ δύο πρόσκεινται, τὸ θνήσκειν τε καὶ τεθνάναι·", "seq": 612}
{"id": "David_Passim_0613", "series": "CAG", "text": "διὰ μὲν γὰρ τοῦ θνήσκειν τὸ πρακτικὸν ἐδηλώθη·", "seq": 613}
{"id": "David_Passim_0614", "series": "CAG", "text": "ὁ γὰρ φιλόσοφος ἐν τῷ τελευτᾶν τὸ πρακτικὸν ἔχει·", "seq": 614}
{"id": "David_Passim_0615", "series": "CAG", "text": "τότε γὰρ νέκρωσιν ἀπεργάζεται τῶν παθῶν.", "seq": 615}
{"id": "David_Passim_0616", "series": "CAG", "text": "διὰ δὲ τοῦ τεθνάναι τὸ θεωρητικὸν ἐδηλώθη·", "seq": 616}
{"id": "David_Passim_0617", "series": "CAG", "text": "τὸ γὰρ τεθνάναι παρελθοῦσαν ἔχει τὴν σημασίαν, ὁ δὲ φιλόσοφος μετὰ τὸ τεθνάναι ἐστὶ θεωρητικός·", "seq": 617}
{"id": "David_Passim_0618", "series": "CAG", "text": "μετὰ γὰρ τὸ νεκρῶσαι τὰ πάθη καὶ καθαρθῆναι τὴν ψυχὴν πρὸς θεωρίαν ἀνατείνεται καὶ ἄρχεται θεολογεῖν·", "seq": 618}
{"id": "David_Passim_0619", "series": "CAG", "text": "εἰ μὴ γὰρ νέκρωσιν τῶν παθῶν ἀπεργάσηται καὶ καθαρθῇ τὴν ψυχήν, οὐ δύναται θεολογῆσαι·", "seq": 619}
{"id": "David_Passim_0620", "series": "CAG", "text": "κατὰ γὰρ τὸν Πλάτωνα ‘τὸ μὴ καθαρὸν καθαροῦ ἐφάπτεσθαι οὐχὶ θεμιτόν’.", "seq": 620}
{"id": "David_Passim_0621", "series": "CAG", "text": "ταῦτα μὲν ἐν τούτοις.", "seq": 621}
{"id": "David_Passim_0622", "series": "CAG", "text": "Ἀποροῦσι δέ τινες πρὸς τὸν Πλάτωνα λέγοντα τὴν φιλοσοφίαν μελέτην θανάτου λέγοντες·", "seq": 622}
{"id": "David_Passim_0623", "series": "CAG", "text": "τί φής, ὦ Πλάτων;", "seq": 623}
{"id": "David_Passim_0624", "series": "CAG", "text": "ὁ φιλόσοφος ἐξάγει ἤγουν ἀναιρεῖ ἑαυτὸν καὶ τυραννίδα μελετᾷ κατὰ τοῦ δημιουργοῦ βουλόμενος λῦσαι τὸν δεσμὸν ὃν ἐκεῖνος ἔδησεν, φημὶ δὲ τὸν τῆς ψυχῆς καὶ τοῦ σώματος;", "seq": 624}
{"id": "David_Passim_0625", "series": "CAG", "text": "ὅτι γὰρ οὐ δεῖ τινα ἑαυτὸν ἐξάγειν ἤγουν ἀναιρεῖν, δείκνυται διὰ πολλῶν ἐπιχειρημάτων, πρῶτον μὲν ἐξ αὐτοῦ τοῦ Πλάτωνος·", "seq": 625}
{"id": "David_Passim_0626", "series": "CAG", "text": "καὶ γὰρ αὐτὸς ὁ Πλάτων ἐν τῷ αὐτῷ διαλόγῳ φησὶν ὅτι ‘ὡς ἄρα ἔν τινι φρουρᾷ ἐσμεν καὶ οὐ δεῖ ταύτης ἑαυτὸν ἐξάγειν καὶ διαδιδράσκειν’.", "seq": 626}
{"id": "David_Passim_0627", "series": "CAG", "text": "δεύτερον δὲ εἰ ἄρα ὁ φιλόσοφος ὅμοιος τῷ θεῷ ἐστιν, ὡς ἐδείξαμεν ἀνωτέρω δείξαντες αὐτὸν διὰ τῶν αὐτῶν χαρακτηριζόμενον δι᾿ ὧνπερ καὶ τὸ θεῖον, ὁ δὲ ὅμοιος τῷ θεῷ οὐκ ἐξάγει ἤγουν οὐκ ἀναιρεῖ ἑαυτόν, δῆλον ὅτι οὐδὲ ὁ φιλόσοφος ἀναιρεῖ ἑαυτόν, κἂν μελετᾷ τὸν θάνατον·", "seq": 627}
{"id": "David_Passim_0628", "series": "CAG", "text": "ὅτι γὰρ ὁ ὅμοιος τῷ θεῷ οὐκ ἀναιρεῖ ἑαυτόν, δῆλον, εἴ γε ὁ ἀναιρῶν ἑαυτὸν οὐ μόνον οὐκ ἔστιν ὅμοιος τῷ θεῷ ἀλλὰ καὶ ἐναντίος αὐτῷ ἐστι βουλόμενος λῦσαι τὸν δεσμὸν ὃν ἐκεῖνος ἔδησε, τοῦτ᾿ ἔστι διαχωρίσαι τὴν ψυχὴν ἀπὸ τοῦ σώματος.", "seq": 628}
{"id": "David_Passim_0629", "series": "CAG", "text": "τρίτον δὲ τὸ θεῖον οὐδέποτε ἑαυτὸ χωρίζει ἐκ τοῦ δευτερεύοντος, λέγω δὴ τοῦ ἀνθρώπου, ἀλλὰ παρὰ τὴν ἀνεπιτηδειότητα τοῦ ἀνθρώπου δοκεῖ ἑαυτὸ χωρίζειν ἐξ αὐτοῦ·", "seq": 629}
{"id": "David_Passim_0630", "series": "CAG", "text": "οἷόν τί ἐστι τὸ λεγόμενον·", "seq": 630}
{"id": "David_Passim_0631", "series": "CAG", "text": "ὥσπερ τὸ ἡλιακὸν φῶς πάντας ἐξ ἴσου φωτίζει, ἀλλὰ παρὰ τὴν ἀνεπιτηδειότητα τοῦ ὀργάνου δοκεῖ τοὺς μὲν μᾶλλον φωτίζειν τοὺς δὲ ἧττον (εὑρίσκονται γὰρ τινὲς μὲν ἔχοντες καλοὺς ὀφθαλμοὺς τινὲς δὲ ἀσθενεῖς, καὶ ἐκ τούτου οἱ μὲν νομίζουσι τὸν ἥλιον λαμπρότερον εἶναι οἱ δὲ ἀμαυρότερον), τὸν αὐτὸν τρόπον καὶ τὸ θεῖον οὐδέποτε χωρίζει ἑαυτὸ ἐκ τοῦ ἀνθρώπου ἀλλὰ πάντων ἐξ ἴσου προνοεῖται, παρὰ δὲ τὴν ἀσθένειαν τοῦ δεχομένου δοκεῖ ἑαυτὸ χωρίζειν ἐξ ἐκείνου·", "seq": 631}
{"id": "David_Passim_0632", "series": "CAG", "text": "καὶ γὰρ ὁ κακὸς ἄνθρωπος ἑαυτὸν χωρίζει ἐκ τοῦ θείου.", "seq": 632}
{"id": "David_Passim_0633", "series": "CAG", "text": "οὕτως οὖν καὶ ὁ φιλόσοφος οὐκ ὤφειλε μελετῆσαι θάνατον καὶ χωρίσαι τὴν ψυχὴν ἐκ τοῦ δευτερεύοντος, φημὶ δὴ ἀπὸ τοῦ σώματος·", "seq": 633}
{"id": "David_Passim_0634", "series": "CAG", "text": "καὶ γὰρ τὸ σῶμα φθαρτὸν ὂν χεῖρόν ἐστι τῆς ψυχῆς ἀθανάτου οὔσης.", "seq": 634}
{"id": "David_Passim_0635", "series": "CAG", "text": "τέταρτον δὲ εἰ ἄρα ἡ ἀρετὴ μεγίστη εὐδαιμονία ἐστί, χῶρος δὲ τῶν ἀρετῶν ἐστιν ἡ φιλοσοφία (διὰ γὰρ τῆς φιλοσοφίας τὰς ἀρετὰς προσκτώμεθα), ὁ δὲ εὐδαίμων καὶ ὁ κατ᾿ ἀρετὴν ζῶν οὐκ ἀνιᾶται οὔτε ἐπὶ ταῖς σωματικαῖς συμφοραῖς οὔτε ἐπὶ τοῖς ἐκτὸς ἤγουν τοῖς χρήμασιν, ὁ δὲ μὴ ἀνιώμενος μήτε ἐπὶ ταῖς σωματικαῖς συμφοραῖς μήτε ἐπὶ τοῖς ἐκτὸς ἑαυτὸν οὐκ ἀναιρεῖ, δῆλον ὅτι καὶ ὁ φιλόσοφος ὡς κατ᾿ ἀρετὴν ζῶν ἑαυτὸν οὐκ ἀναιρεῖ, <οὐκ ἀνιώμενος> οὔτε ἐπὶ ταῖς σωματικαῖς συμφοραῖς οὔτε ἐπὶ τοῖς ἐκτός, ἐπεὶ οἱ ἀνιώμενοι ἐπὶ ταῖς σωματικαῖς συμφοραῖς καὶ ἐπὶ τοῖς ἐκτὸς ἀκούσονται τοῦ ἐκ τοῦ Ἱπποκράτους λεγομένου·", "seq": 635}
{"id": "David_Passim_0636", "series": "CAG", "text": "ἐπ᾿ ἀλλοτρίαις γὰρ συμφοραῖς ἰδίας καρποῦνται λύπας.", "seq": 636}
{"id": "David_Passim_0637", "series": "CAG", "text": "ἄλλως τε δὲ τοῦτο δηλοῖ καὶ ὁ Πλωτῖνος, τοῦτ᾿ ἔστιν ὅτι ὁ κατ᾿ ἀρετὴν ζῶν οὐκ ἀνιᾶται οὔτε ἐπὶ ταῖς σωματικαῖς συμφοραῖς οὔτε ἐπὶ τοῖς ἐκτός·", "seq": 637}
{"id": "David_Passim_0638", "series": "CAG", "text": "καὶ γὰρ οὗτος ἐρωτηθεὶς ἔκ τινος ὅτι ‘ὁ ἐν τῇ ζωῇ Πριαμικαῖς περιπεσὼν συμφοραῖς καὶ Ἰλιάδα κακῶν περιβεβλημένος καὶ μετὰ τελευτὴν ἐρριμμένος ἄταφος εὐδαίμων ἐστὶν ἢ οὔ;’", "seq": 638}
{"id": "David_Passim_0639", "series": "CAG", "text": "ἀπεκρίνατο λέγων ‘ἄπαγε τῆς μικρολογίας·", "seq": 639}
{"id": "David_Passim_0640", "series": "CAG", "text": "οὐ γὰρ ἀφαιρεῖταί τις ψυχικὴν ἀρετήν’.", "seq": 640}
{"id": "David_Passim_0641", "series": "CAG", "text": "Τούτου οὖν οὕτως ἔχοντος τί ἔχομεν εἰπεῖν περὶ τοῦ Πλάτωνος πῇ μὲν λέγοντος ὅτι δεῖ μελετᾶν τὸν θάνατον, πῇ δὲ λέγοντος ὅτι οὐ δεῖ τινα ἑαυτὸν ἀναιρεῖν;", "seq": 641}
{"id": "David_Passim_0642", "series": "CAG", "text": "ἆρα ἐναντιοῦται ἑαυτῷ ἢ οὔ;", "seq": 642}
{"id": "David_Passim_0643", "series": "CAG", "text": "καὶ ἔστιν εἰπεῖν ὅτι οὐκ ἐναντιοῦται ἑαυτῷ.", "seq": 643}
{"id": "David_Passim_0644", "series": "CAG", "text": "ἀλλ᾿ ἵνα δείξωμεν ὅτι οὐκ ἐναντιοῦται ἑαυτῷ, εἴπωμεν ὀλίγα τινά.", "seq": 644}
{"id": "David_Passim_0645", "series": "CAG", "text": "ἰστέον ὅτι ἡ ζωὴ ἀντίκειται τῷ θανάτῳ·", "seq": 645}
{"id": "David_Passim_0646", "series": "CAG", "text": "ἡ μὲν γὰρ ζωὴ ἕξις ἐστὶ καὶ αἰτία τοῦ εἶναι ἡμᾶς, ὁ δὲ θάνατος στέρησις.", "seq": 646}
{"id": "David_Passim_0647", "series": "CAG", "text": "καὶ τούτων ἑκάτερον διττόν ἐστιν·", "seq": 647}
{"id": "David_Passim_0648", "series": "CAG", "text": "καὶ γὰρ ἡ ζωὴ διττή ἐστιν·", "seq": 648}
{"id": "David_Passim_0649", "series": "CAG", "text": "ἔστι γὰρ φυσική, ἔστι καὶ προαιρετική.", "seq": 649}
{"id": "David_Passim_0650", "series": "CAG", "text": "καὶ φυσικὴ μὲν ζωή ἐστι συνάφεια τῆς ψυχῆς καὶ τοῦ σώματος, καθ᾿ ἣν χορηγεῖ τῷ σώματι ἡ ψυχὴ αἴσθησιν καὶ κίνησιν, καθ᾿ ἣν ἅπαντες ζῶμεν, καθ᾿ ἣν τὸ σῶμα δεσμεῖ τὴν ψυχήν, ὅθεν καὶ δέμας λέγεται οἱονεὶ δεσμὸς τῆς ψυχῆς, ὅθεν καὶ σῶμα λέγεται οἱονεὶ σῆμα καὶ τάφος τῆς ψυχῆς.", "seq": 650}
{"id": "David_Passim_0651", "series": "CAG", "text": "προαιρετικὴ δὲ ζωή ἐστιν, ἡνίκα τὸ χεῖρον νικᾷ τὸ κρεῖττον, τοῦτ᾿ ἔστιν ὡς ὅταν ἡ ψυχὴ νικᾶται ἐκ τῶν σωματικῶν ἡδυπαθειῶν, ἥτις ζωὴ καὶ ἀκόλαστός ἐστι, τοῦτ᾿ ἔστιν οὐ σώφρων.", "seq": 651}
{"id": "David_Passim_0652", "series": "CAG", "text": "φυσικὸς δὲ θάνατός ἐστιν ὁ διαχωρισμὸς τῆς ψυχῆς ἐκ τοῦ σώματος, καθ᾿ ὃν ἅπαντες τελευτῶμεν.", "seq": 652}
{"id": "David_Passim_0653", "series": "CAG", "text": "προαιρετικὸς δὲ θάνατός ἐστιν ἡ κατ᾿ ἀρετὴν ζωή, τοῦτ᾿ ἔστιν ὡς ὅταν τοῦ ζῴου σωζομένου μελέτη γίνηται τοῦ θανάτου διὰ τοῦ νέκρωσιν ἀπεργάζεσθαι τῶν παθῶν.", "seq": 653}
{"id": "David_Passim_0654", "series": "CAG", "text": "τούτων οὖν οὕτως ἐχόντων τέσσαρά τινα ἐκ τούτων συνάγονται·", "seq": 654}
{"id": "David_Passim_0655", "series": "CAG", "text": "τὸ εἶναι, τὸ μὴ εἶναι, τὸ κακῶς εἶναι.", "seq": 655}
{"id": "David_Passim_0656", "series": "CAG", "text": "καὶ εἶναι μέν ἐστιν ἡ φυσικὴ ζωή, μὴ εἶναι δὲ ὁ φυσικὸς θάνατος, εὖ εἶναι δὲ ὁ προαιρετικὸς θάνατος, κακῶς δὲ εἶναι ἡ προαιρετικὴ ζωή.", "seq": 656}
{"id": "David_Passim_0657", "series": "CAG", "text": "ἡνίκα οὖν ὁ Πλάτων λέγει ὡς δεῖ μελετᾶν τὸν θάνατον, τὸν προαιρετικὸν θάνατον δεῖ νοεῖν, τοῦτ᾿ ἔστι τὸν κατ᾿ ἀρετὴν θάνατον, ἤγουν τὴν νέκρωσιν τῶν παθῶν.", "seq": 657}
{"id": "David_Passim_0658", "series": "CAG", "text": "ἡνίκα δὲ λέγει ὅτι οὐ δεῖ τινα ἑαυτὸν ἀναιρεῖν, τὸν φυσικὸν θάνατον δεῖ νοεῖν, καθ᾿ ὃν ἅπαντες τελευτῶμεν.", "seq": 658}
{"id": "David_Passim_0659", "series": "CAG", "text": "ταῦτα μὲν ἐν τούτοις.", "seq": 659}
{"id": "David_Passim_0660", "series": "CAG", "text": "Ἰστέον δὲ ὅτι Κλεόμβροτός τις νομίζων ὅτι ὁ Πλάτων τὸν φυσικὸν θάνατον λέγει τὸν φιλόσοφον μελετᾶν, ῥίψας ἑαυτὸν ἐκ τοῦ τείχους ἐτελεύτησε.", "seq": 660}
{"id": "David_Passim_0661", "series": "CAG", "text": "περὶ οὗ φησιν ὁ Καλλίμαχος οὕτως·", "seq": 661}
{"id": "David_Passim_0662", "series": "CAG", "text": "Εἴπας ‘Ἥλιε, χαῖρε’ Κλεόμβροτος Ἀμβρακιώτης ἥλατ᾿ ἀφ᾿ ὑψηλοῦ τείχεος εἰς Ἀίδην, ἄξιον οὔτι παθὼν θανάτου κακόν, ἀλλὰ Πλάτωνος ἓν τὸ περὶ ψυχῆς γράμμ’ ἀναλεξάμενος.", "seq": 662}
{"id": "David_Passim_0663", "series": "CAG", "text": "πρὸς τοῦτο δὲ εἶπεν Ὀλυμπιόδωρος ὁ φιλόσοφος", "seq": 663}
{"id": "David_Passim_0664", "series": "CAG", "text": "εἰ μὴ γράμμα Πλάτωνος ἐμὴν ἐπέδησεν ἐρωήν, ἤδη λυγρὸν ἔλυσα βίου πολυκηδέα δεσμόν,", "seq": 664}
{"id": "David_Passim_0665", "series": "CAG", "text": "τοῦτ᾿ ἔστιν εἰ μὴ ὠφελήθην ἐκ Πλάτωνος τρόπον εὐζωΐας, προέκρινα ἂν μὴ εἶναι ἢ κακῶς εἶναι·", "seq": 665}
{"id": "David_Passim_0666", "series": "CAG", "text": "καὶ γάρ, ὡς ἐμάθομεν, ὁ Πλάτων λέγει ὅτι οὐ δεῖ τινα ἑαυτὸν ἀναιρεῖν.", "seq": 666}
{"id": "David_Passim_0667", "series": "CAG", "text": "ἵνα δὲ μὴ πολλοὶ γένωνται Κλεόμβροτοι, προσθῶμεν ἐν τῷ ὅρῳ τινὰ τῆς αὐτῆς σημασίας φυλαττομένης καὶ εἴπωμεν αὐτὸν οὕτως·", "seq": 667}
{"id": "David_Passim_0668", "series": "CAG", "text": "‘φιλοσοφία ἐστὶ μελέτη θανάτου τοῦ ζῴου σωζομένου’, τοῦτ᾿ ἔστιν οὐ τοῦ φυσικοῦ ἀλλὰ τοῦ προαιρετικοῦ θανάτου.", "seq": 668}
{"id": "David_Passim_0669", "series": "CAG", "text": "ἐν οἷς σὺν θεῷ καὶ ἡ παροῦσα πρᾶξις.", "seq": 669}
{"id": "David_Passim_0670", "series": "CAG", "text": "Πρᾶξις ια΄.", "seq": 670}
{"id": "David_Passim_0671", "series": "CAG", "text": "Ἐπειδὴ ὁ Πλάτων τὴν φιλοσοφίαν μελέτην θανάτου ὡρίσατο, νομίσαντες οἱ Στωϊκοὶ ὅτι θάνατον τὸν φυσικὸν λέγει ἔρχονται καὶ παραδιδόασι τρόπους τινάς, καθ᾿ οὓς εὐλόγως τις ἀναιρεῖ ἑαυτόν, καὶ λέγουσιν ὅτι ἐπειδὴ ὁ βίος συμποσίῳ μεγάλῳ ἔοικε, δῆλον ὅτι καθ᾿ ὅσους τρόπους τὸ συμπόσιον διαλύεται, κατὰ τοσούτους τρόπους τις εὐλόγως ἀναιρεῖ ἑαυτόν·", "seq": 671}
{"id": "David_Passim_0672", "series": "CAG", "text": "καὶ γάρ, ὥς φασι, κατὰ ἓξ τρόπους διαλύεται τὸ συμπόσιον·", "seq": 672}
{"id": "David_Passim_0673", "series": "CAG", "text": "καὶ γὰρ δι᾿ ἔνδειαν βρωμάτων εὐλόγως ἀνίστανται οἱ ἑστιώμενοι καὶ διαλύεται τὸ συμπόσιον·", "seq": 673}
{"id": "David_Passim_0674", "series": "CAG", "text": "οὕτως οὖν καὶ δι᾿ ἔνδειαν χρημάτων εὐλόγως τις ἀναιρεῖ ἑαυτὸν βουλόμενος μὴ καταδαπανᾶσθαι ὑπὸ λιμοῦ, ὡς καὶ ὁ Θέογνις τοῦτο δηλοῖ πρὸς Κύρνον τινὰ οὕτω λέγων·", "seq": 674}
{"id": "David_Passim_0675", "series": "CAG", "text": "χρὴ πενίην φεύγοντα καὶ ἐς μεγακήτεα πόντον ῥιπτεῖν καὶ πετρῶν, Κύρνε, κατ᾿ ἠλιβάτων.", "seq": 675}
{"id": "David_Passim_0676", "series": "CAG", "text": "ἰστέον δὲ ὅτι οὐ λέγει ὡς δεῖ τὸν πένητα ἀναιρεῖν ἑαυτόν, ἀλλὰ λέγει ὅτι δεῖ τὸν πένητα πανταχοῦ σπείρειν, καὶ ἐν ἀβάτοις πέτραις καὶ ἐν θαλάσσῃ, εἰ ἔστιν εἰπεῖν, ὅπως τοῦ λιμοῦ ἐλευθερωθῇ.", "seq": 676}
{"id": "David_Passim_0677", "series": "CAG", "text": "πάλιν διαλύεται τὸ συμπόσιον διὰ τὸ εἶναι κακόχυμα καὶ δηλητηριώδη τὰ βρώματα·", "seq": 677}
{"id": "David_Passim_0678", "series": "CAG", "text": "καὶ γὰρ τοιούτων ὄντων τῶν βρωμάτων εὐλόγως ἀνίστανται οἱ ἑστιώμενοι καὶ διαλύεται τὸ συμπόσιον.", "seq": 678}
{"id": "David_Passim_0679", "series": "CAG", "text": "οὕτως οὖν καὶ τοῦ σώματος κακοχύμου ὄντος καὶ ἀνεπιτηδείου πρὸς τὸ δέξασθαι τὰς ψυχικὰς ἀρετὰς εὐλόγως τις ἀναιρεῖ ἑαυτὸν βουλόμενος τῆς νόσου ἀπαλλαγῆναι.", "seq": 679}
{"id": "David_Passim_0680", "series": "CAG", "text": "ὅθεν καί τις Κυνικὸς φιλόσοφος ἡμίξηρος ὢν προσῆλθεν Ἰουλιανῷ τῷ βασιλεῖ λέγων αὐτῷ ταῦτα·", "seq": 680}
{"id": "David_Passim_0681", "series": "CAG", "text": "ἥμισύ μου τέθνηκε, τὸ δ᾿ ἥμισυ δέρκεται ἠώς·", "seq": 681}
{"id": "David_Passim_0682", "series": "CAG", "text": "οἴκτειρον, βασιλεῦ, Κυνικὸν ἡμίτομον,", "seq": 682}
{"id": "David_Passim_0683", "series": "CAG", "text": "τοῦτ᾿ ἔστιν κέλευσον ἢ ἵνα περιοδευθῶ ἢ ἵνα φονευθῶ.", "seq": 683}
{"id": "David_Passim_0684", "series": "CAG", "text": "ὁ δὲ εἶπε πρὸς αὐτὸν", "seq": 684}
{"id": "David_Passim_0685", "series": "CAG", "text": "ἀμφοτέρους ἀδικεῖς, καὶ Πλουτέα καὶ Φαέθοντα, τὸν μὲν ἔτ᾿ εἰσορόων, τοῦ δ᾿ ἀπολειπόμενος.", "seq": 685}
{"id": "David_Passim_0686", "series": "CAG", "text": "πάλιν διαλύεται τὸ συμπόσιον διὰ περίστασίν τινα ἰδικήν·", "seq": 686}
{"id": "David_Passim_0687", "series": "CAG", "text": "καὶ γὰρ τοῦ ἑστιάτορος ἐξαίφνης ἢ ἀρρωστήσαντος ἢ ἀκούσαντος φίλων ἀπώλειαν ἀνίστανται οἱ ἑστιώμενοι καὶ διαλύεται τὸ συμπόσιον.", "seq": 687}
{"id": "David_Passim_0688", "series": "CAG", "text": "οὕτως οὖν καὶ ἰδικῆς τινος περιστάσεως καταλαβούσης εὐλόγως τις ἀναιρεῖ ἑαυτόν.", "seq": 688}
{"id": "David_Passim_0689", "series": "CAG", "text": "ὅθεν καὶ Πυθαγορεία τις γυνὴ ἡ καὶ Θεανὼ λεγομένη κρατηθεῖσα ὑπὸ τοῦ ἐν Σικελίᾳ τυράννου καὶ ἐρωτωμένη διὰ τί οὐ τρώγουσιν οἱ Πυθαγόρειοι κυάμους, ἔλεγε ‘φάγοιμι ἂν ἢ εἴποιμι’.", "seq": 689}
{"id": "David_Passim_0690", "series": "CAG", "text": "καὶ πάλιν ἐκείνου λέγοντος αὐτῇ ‘οὐκοῦν φάγε’, ἔλεγεν ‘εἴποιμι ἂν ἢ φάγοιμι’.", "seq": 690}
{"id": "David_Passim_0691", "series": "CAG", "text": "καὶ οὕτω καταδάκνουσα τὴν γλῶσσαν ἐτελεύτησε.", "seq": 691}
{"id": "David_Passim_0692", "series": "CAG", "text": "πάλιν διαλύεται τὸ συμπόσιον διὰ μέθην·", "seq": 692}
{"id": "David_Passim_0693", "series": "CAG", "text": "καὶ γὰρ μεθυόντων τῶν ἑστιωμένων εὐλόγως διαλύεται τὸ συμπόσιον.", "seq": 693}
{"id": "David_Passim_0694", "series": "CAG", "text": "οὕτως οὖν εὐλόγως τις ἀναιρεῖ ἑαυτόν, ἡνίκα ἔλθῃ ἐν τῷ ἐσχάτῳ γήρᾳ καὶ ἄρξηται ληρεῖν καὶ παραφρονεῖν.", "seq": 694}
{"id": "David_Passim_0695", "series": "CAG", "text": "πάλιν διαλύεται τὸ συμπόσιον, ἡνίκα οἱ ἑστιώμενοι ἄρχονται μάχεσθαι ἀλλήλοις καὶ ἀθέμιτά τινα πρὸς ἑαυτοὺς διαπράττεσθαι.", "seq": 695}
{"id": "David_Passim_0696", "series": "CAG", "text": "οὕτως οὖν εὐλόγως τις ἀναιρεῖ ἑαυτόν, ἡνίκα κρατηθεὶς ὑπὸ πολεμίων ἀναγκάζεται ἀθέμιτά τινα διαπράξασθαι, τοῦτ᾿ ἔστιν ἢ μητρογαμῆσαι ἢ φαγεῖν τι ἀθέμιτον.", "seq": 696}
{"id": "David_Passim_0697", "series": "CAG", "text": "πάλιν διαλύεται τὸ συμπόσιον διὰ κοινὴν περίστασιν·", "seq": 697}
{"id": "David_Passim_0698", "series": "CAG", "text": "καὶ γὰρ κοινῆς περιστάσεως καταλαβούσης, οἷον ἐμπρησμοῦ ἢ ἐπιδρομῆς βαρβάρων, ἀνίστανται οἱ ἑστιώμενοι καὶ εὐλόγως διαλύεται τὸ συμπόσιον.", "seq": 698}
{"id": "David_Passim_0699", "series": "CAG", "text": "οὕτως οὖν εὐλόγως τις ἀναιρεῖ ἑαυτὸν διὰ κοινὴν περίστασιν, οἷον ὡς ὅταν πολεμίων ἐπελθόντων τῇ πόλει καὶ μελλόντων αὐτὴν πορθεῖν ὁ πολίτης τῷ φόβῳ νικώμενος ἀναιρεῖ ἑαυτόν.", "seq": 699}
{"id": "David_Passim_0700", "series": "CAG", "text": "ταῦτα μὲν οὗτοι.", "seq": 700}
{"id": "David_Passim_0701", "series": "CAG", "text": "Ἰστέον δὲ ὅτι ἕτεροί τινες τρεῖς μόνους τρόπους παραδιδόασι, καθ᾿ οὓς εὐλόγως τις ἀναιρεῖ ἑαυτόν·", "seq": 701}
{"id": "David_Passim_0702", "series": "CAG", "text": "φασὶ γὰρ ὅτι φύσει ἡ ζωὴ τριττή ἐστιν·", "seq": 702}
{"id": "David_Passim_0703", "series": "CAG", "text": "ἢ γὰρ ἀρίστη ἐστὶν ἢ μέση ἢ χειρίστη.", "seq": 703}
{"id": "David_Passim_0704", "series": "CAG", "text": "ἡνίκα οὖν ἐστί τις ἐν τῇ ἀρίστῃ ζωῇ ἢ ἐν τῇ μέσῃ καὶ ὁρᾷ ἑαυτὸν μᾶλλον ἐπὶ τὸ χεῖρον ἐκκλίνοντα, εὐλόγως ἀναιρεῖ ἑαυτόν.", "seq": 704}
{"id": "David_Passim_0705", "series": "CAG", "text": "πάλιν ἡνίκα τις ἐν τῇ χειρίστῃ ζωῇ ἐστι καὶ ὁρᾷ ἑαυτὸν ἀεὶ ἐν τοῖς αὐτοῖς ὄντα καὶ μηδέποτε ἐπὶ τὴν ἀρίστην μετερχόμενον, εὐλόγως ἀναιρεῖ ἑαυτόν.", "seq": 705}
{"id": "David_Passim_0706", "series": "CAG", "text": "ταῦτα μὲν ἐν τούτοις.", "seq": 706}
{"id": "David_Passim_0707", "series": "CAG", "text": "Ἔστι δὲ εἰπεῖν ὅτι οὔτε εὐλόγως οὔτε ἀλόγως δεῖ τινα ἀναιρεῖν ἑαυτόν (ὁ γὰρ τοῦτο ποιῶν τῷ δημιουργῷ ἐναντιοῦται καὶ τυραννίδα κατ᾿ αὐτοῦ μελετᾷ βουλόμενος λῦσαι τὸν δεσμόν, ὃν ἐκεῖνος ἔδησε, φημὶ δὲ τὸ διαχωρίσαι τὴν ψυχὴν ἐκ τοῦ σώματος), καὶ δεῖ πείθεσθαι τῷ Πλάτωνι λέγοντι ‘ὡς ἄρα ἔν τινι φρουρᾷ ἐσμεν καὶ οὐ δεῖ ταύτης ἑαυτὸν ἐξάγειν καὶ ἀποδιδράσκειν, ἀλλὰ δεῖ μένειν τὸν δήσαντα, ἄχρις ἂν αὐτὸς λύσῃ’·", "seq": 707}
{"id": "David_Passim_0708", "series": "CAG", "text": "αὗται γὰρ αἱ περιστάσεις αἱ συμβαίνουσαι οὐ συμβαίνουσι διὰ τό τινα ἑαυτὸν ἀναιρεῖν ἀλλὰ διὰ τὸ δοκιμάζεσθαι τὴν ψυχήν·", "seq": 708}
{"id": "David_Passim_0709", "series": "CAG", "text": "ὥσπερ γὰρ ὁ ἄριστος κυβερνήτης οὐκ ἐν γαλήνῃ ἀλλ᾿ ἐν ζάλῃ δοκιμάζεται, τὸν αὐτὸν τρόπον καὶ ἡ ἀρίστη ψυχὴ ἐν ταῖς περιστάσεσι δοκιμάζεται.", "seq": 709}
{"id": "David_Passim_0710", "series": "CAG", "text": "ὅθεν οἱ Περιπατητικοὶ καὶ βουλόμενοι τὸ καρτερικὸν τῆς ψυχῆς ἐνδείξασθαι ἔλεγον ‘ὦ Ζεῦ, ὄρεξον ἡμῖν περιστάσεις’.", "seq": 710}
{"id": "David_Passim_0711", "series": "CAG", "text": "ἐν οἷς σὺν θεῷ ἡ πρᾶξις.", "seq": 711}
{"id": "David_Passim_0712", "series": "CAG", "text": "Πρᾶξις ιβ΄.", "seq": 712}
{"id": "David_Passim_0713", "series": "CAG", "text": "Ἄνεισιν ἐντεῦθεν ὁ Πλάτων ἐπὶ τὸ πόρρω τέλος, καὶ οὐχ ἁπλῶς ἐπὶ τὸ πόρρω, ἀλλ᾿ ἐπὶ τὸ πορρωτάτω καὶ οὗ ἐπέκεινα οὐκ ἔστιν ἀνελθεῖν·", "seq": 713}
{"id": "David_Passim_0714", "series": "CAG", "text": "ὁρίζεται γὰρ τὴν φιλοσοφίαν ‘ὁμοίωσιν θεῷ κατὰ τὸ δυνατὸν ἀνθρώπῳ’·", "seq": 714}
{"id": "David_Passim_0715", "series": "CAG", "text": "τί γὰρ οὕτω μακάριον ἐν τῷ βίῳ καὶ πρέπον ἀνθρώπῳ τέλος ὡς τὸ ὁμοιωθῆναί τινα θεῷ;", "seq": 715}
{"id": "David_Passim_0716", "series": "CAG", "text": "ἰστέον δὲ ὅτι λέγουσί τινες ὅτι οὐ δύναται ὁ φιλόσοφος ἅτε δὴ ἄνθρωπος ὢν ὁμοιοῦσθαι θεῷ, καὶ τοῦτο κατασκευάζουσιν οὕτως·", "seq": 716}
{"id": "David_Passim_0717", "series": "CAG", "text": "ἡ οὐσία θεοῦ καὶ ἀνθρώπου διάφορος, ὡς καὶ ὁ ποιητὴς δηλοῖ λέγων", "seq": 717}
{"id": "David_Passim_0718", "series": "CAG", "text": "ἐπεὶ οὔ ποτε φῦλον ὁμοῖον ἀθανάτων τε θεῶν χαμαὶ ἐρχομένων τ᾿ ἀνθρώπων.", "seq": 718}
{"id": "David_Passim_0719", "series": "CAG", "text": "ὧν δὲ αἱ οὐσίαι διάφοροι, τούτων διάφοροι καὶ αἱ τελειότητες·", "seq": 719}
{"id": "David_Passim_0720", "series": "CAG", "text": "οἷον ἄλλη ἐστὶν ἡ οὐσία τοῦ ἀνθρώπου καὶ ἄλλη τοῦ ἵππου, καὶ ἄλλη ἡ τελειότης τοῦ ἵππου παρὰ τὸν ἄνθρωπον.", "seq": 720}
{"id": "David_Passim_0721", "series": "CAG", "text": "εἰ ἄρα οὖν ἡ οὐσία θεοῦ καὶ ἀνθρώπου διάφορός ἐστιν, ὧν δὲ αἱ οὐσίαι διάφοροι, τούτων διάφοροι καὶ αἱ τελειότητες, δῆλον ὅτι ἄλλη τελειότης ἐστὶ τοῦ θεοῦ παρὰ τὸν ἄνθρωπον·", "seq": 721}
{"id": "David_Passim_0722", "series": "CAG", "text": "ἄρα οὖν οὐκ ἔστιν ἡ φιλοσοφία ὁμοίωσις θεῷ.", "seq": 722}
{"id": "David_Passim_0723", "series": "CAG", "text": "Ἵνα δὲ τὴν ἀπορίαν ταύτην ἐπιλύσωμεν, εἴπωμεν ἐπὶ ποίου σημαινομένου λέγομεν ἐνταῦθα τὸ ὅμοιον.", "seq": 723}
{"id": "David_Passim_0724", "series": "CAG", "text": "ἀλλὰ πρῶτον εἴπωμεν ποσαχῶς λέγεται τὸ ὅμοιον.", "seq": 724}
{"id": "David_Passim_0725", "series": "CAG", "text": "ἰστέον ὅτι τὸ ὅμοιον τετραχῶς λέγεται·", "seq": 725}
{"id": "David_Passim_0726", "series": "CAG", "text": "λέγεται γὰρ ὅμοιον, ἡνίκα ἡ αὐτὴ ποιότης ἐν ὅλῳ τῷ εἴδει θεωρῆται, οἷον ὡς ὅταν ὅλους τοὺς Αἰθίοπας λέγωμεν ὁμοίους εἶναι κατὰ τὸ μέλαν καὶ ὅλους τοὺς κύκνους ὁμοίους εἶναι κατὰ τὸ λευκόν.", "seq": 726}
{"id": "David_Passim_0727", "series": "CAG", "text": "πάλιν λέγεται ὅμοιον, ἡνίκα ἡ αὐτὴ ποιότης ἐν διαφόροις εἴδεσι θεωρῆται κατὰ τὸ μᾶλλον καὶ ἧττον, οἷον ὡς ὅταν τὸ πέπερι τὸ λευκὸν καὶ τὸ μέλαν λέγωμεν ὅμοιον εἶναι κατὰ τὸ θερμόν·", "seq": 727}
{"id": "David_Passim_0728", "series": "CAG", "text": "ἀμφότερα γὰρ θερμά ἐστιν, ἀλλὰ κατὰ τὸ μᾶλλον καὶ ἧττον·", "seq": 728}
{"id": "David_Passim_0729", "series": "CAG", "text": "τὸ μὲν γὰρ μέλαν πέπερι μᾶλλον θερμόν ἐστι, τὸ δὲ λευκὸν ἧττον θερμόν ἐστιν.", "seq": 729}
{"id": "David_Passim_0730", "series": "CAG", "text": "πάλιν λέγεται ὅμοιον, ἡνίκα διάφοροι ποιότητες καὶ αἱ αὐταὶ ἐν διαφόροις εἴδεσιν εὑρεθῶσιν, οἷον ὡς ὅταν τὴν φάσσαν καὶ τὴν περιστερὰν ὅμοια λέγωμεν εἶναι, ἐπειδὴ ὥσπερ ἡ φάσσα διαφόρους ποιότητας ἔχει (ἔχει γὰρ μέλαν, λευκόν, ξανθόν), οὕτω καὶ ἡ περιστερὰ διαφόρους καὶ τὰς αὐτὰς ποιότητας ἔχει·", "seq": 730}
{"id": "David_Passim_0731", "series": "CAG", "text": "ἔχει γὰρ καὶ αὕτη μέλαν, ξανθόν, λευκόν.", "seq": 731}
{"id": "David_Passim_0732", "series": "CAG", "text": "πάλιν ὅμοιον λέγεται ὡς ἐπὶ τῆς εἰκόνος καὶ τοῦ παραδείγματος, οἷον ὡς ὅταν τὴν εἰκόνα Σωκράτους ὁμοίαν εἶναι λέγωμεν τῷ Σωκράτει.", "seq": 732}
{"id": "David_Passim_0733", "series": "CAG", "text": "ἰστέον δὲ ὅτι παράδειγμα λέγεται τὸ ἀρχέτυπον καὶ οἱονεὶ πρὸς ὃ ἐγένετο ἡ εἰκών·", "seq": 733}
{"id": "David_Passim_0734", "series": "CAG", "text": "οἷον παράδειγμα τῆς εἰκόνος Σωκράτους λέγομεν τὸν Σωκράτην·", "seq": 734}
{"id": "David_Passim_0735", "series": "CAG", "text": "πρὸς γὰρ τοῦτον ἐγένετο ἡ εἰκὼν αὐτοῦ.", "seq": 735}
{"id": "David_Passim_0736", "series": "CAG", "text": "κατὰ τοῦτο οὖν τὸ σημαινόμενον λέγομεν τὸν φιλόσοφον ὅμοιον τῷ θεῷ εἶναι·", "seq": 736}
{"id": "David_Passim_0737", "series": "CAG", "text": "ὥσπερ γὰρ τὴν εἰκόνα Σωκράτους λέγομεν ὁμοίαν εἶναι τῷ Σωκράτει, εἰ καὶ ἄλλο ἐστὶν ἡ εἰκὼν τοῦ Σωκράτους καὶ ἄλλος ὁ Σωκράτης (ἡ μὲν γὰρ ἄψυχός ἐστιν, ὁ δὲ ἔμψυχος), κατὰ τοῦτο τὸ σημαινόμενον λέγομεν τὸν φιλόσοφον ὅμοιον εἶναι τῷ θεῷ, εἰ καὶ ἄλλη ἐστὶν ἡ οὐσία τοῦ θεοῦ καὶ ἄλλη τοῦ ἀνθρώπου·", "seq": 737}
{"id": "David_Passim_0738", "series": "CAG", "text": "ὅτι γὰρ ὁ φιλόσοφος ὅμοιός ἐστι τῷ θεῷ, δῆλον ἐντεῦθεν·", "seq": 738}
{"id": "David_Passim_0739", "series": "CAG", "text": "οἷς γὰρ τὸ θεῖον χαρακτηρίζεται, τούτοις καὶ ὁ τέλειος φιλόσοφος χαρακτηρίζεται·", "seq": 739}
{"id": "David_Passim_0740", "series": "CAG", "text": "καὶ γὰρ τρισὶ τὸ θεῖον χαρακτηρίζεται, τῷ τε ἀγαθῷ καὶ τῷ γνωστικῷ καὶ τῷ δυνατῷ, καὶ ὁ τέλειος φιλόσοφος τοῖς αὐτοῖς χαρακτηρίζεται, φημὶ δὲ τῷ τε ἀγαθῷ καὶ τῷ γνωστικῷ καὶ τῷ δυνατῷ, καὶ τῷ μὲν ἀγαθῷ, ὅτι ὥσπερ τὸ θεῖον πάντων προνοεῖται, οὕτω καὶ ὁ τέλειος φιλόσοφος τῶν ἀτελῶν ψυχῶν προνοεῖται διὰ τῆς γνώσεως (καὶ γὰρ τὴν ἀτελῆ ψυχὴν ἤγουν τὴν ἀγνοοῦσαν ἐπὶ τὸ τέλειον μεταφέρει διὰ τῆς γνώσεως), τῷ δὲ γνωστικῷ, ὅτι ὥσπερ τὸ θεῖον πάντα γινώσκει, οὕτω καὶ ὁ τέλειος φιλόσοφος πάντα ἐπαγγέλλεται γινώσκειν, τῷ δὲ δυνατῷ, ὅτι ὥσπερ τὸ θεῖον ὅσα δύναται, καὶ βούλεται, οὕτω καὶ ὁ τέλειος φιλόσοφος ὅσα δύναται, καὶ βούλεται.", "seq": 740}
{"id": "David_Passim_0741", "series": "CAG", "text": "ταῦτα μὲν ἐν τούτοις.", "seq": 741}
{"id": "David_Passim_0742", "series": "CAG", "text": "Ἀποροῦσι δέ τινες·", "seq": 742}
{"id": "David_Passim_0743", "series": "CAG", "text": "πῶς φατε τὸν φιλόσοφον ὁμοιοῦσθαι τῷ θεῷ τῷ τε ἀγαθῷ καὶ τῷ γνωστικῷ καὶ τῷ δυνατῷ, εἴ γε κατὰ τὸν ποιητὴν", "seq": 743}
{"id": "David_Passim_0744", "series": "CAG", "text": "οὔ ποτε φῦλον ὁμοῖον ἀθανάτων τε θεῶν χαμαὶ ἐρχομένων τ᾿ ἀνθρώπων;", "seq": 744}
{"id": "David_Passim_0745", "series": "CAG", "text": "πρὸς οὓς ἔστιν εἰπεῖν ὅτι διὰ τοῦτο πρόσκειται ἐν τῷ ὅρῳ ‘κατὰ τὸ δυνατὸν ἀνθρώπῳ’·", "seq": 745}
{"id": "David_Passim_0746", "series": "CAG", "text": "ὡς γάρ ἐστι δυνατὸν καὶ ἐφικτὸν ἀνθρώπῳ, δοκεῖ ὁμοιοῦσθαι ὁ φιλόσοφος τῷ θεῷ, ἐπεὶ οὐχ ὡσαύτως ἐστὶν οὔτε τὸ ἀγαθὸν οὔτε τὸ γνωστικὸν οὔτε τὸ δυνατὸν παρὰ τῷ θεῷ καὶ παρὰ τῷ ἀνθρώπῳ·", "seq": 746}
{"id": "David_Passim_0747", "series": "CAG", "text": "καὶ γὰρ ἄλλως πώς ἐστι τὸ ἀγαθὸν παρὰ τῷ θεῷ καὶ ἄλλως πως παρὰ τῷ ἀνθρώπῳ·", "seq": 747}
{"id": "David_Passim_0748", "series": "CAG", "text": "καὶ γὰρ τὸ ἀγαθὸν συνουσίωται τῷ θεῷ καὶ οὐσία τοῦ θεοῦ ἐστιν ἡ ἀγαθότης, ὅθεν καὶ ἀδυναμίαν λέγεται ἔχειν κακοῦ δι᾿ ὑπερβολὴν ἀγαθότητος, ὥσπερ καὶ ὁ ἥλιος ἀνεπίδεκτος λέγεται εἶναι τοῦ σκότους δι᾿ ὑπερβολὴν φωτός.", "seq": 748}
{"id": "David_Passim_0749", "series": "CAG", "text": "ὁ δὲ ἄνθρωπος κατὰ μέθεξιν ἔχει τὸ ἀγαθόν, ὅθεν καὶ δεκτικός ἐστι κακίας, ὥσπερ καὶ ὁ ἀὴρ κατὰ μέθεξιν λέγεται ἔχειν τὸ φῶς (τοῦ γὰρ ἡλίου ἀνατέλλοντος φωτίζεται), ὅθεν καὶ δεκτικός ἐστι σκότους·", "seq": 749}
{"id": "David_Passim_0750", "series": "CAG", "text": "δύνοντος γὰρ τοῦ ἡλίου σκοτίζεται.", "seq": 750}
{"id": "David_Passim_0751", "series": "CAG", "text": "καὶ πάλιν ἄλλως πώς ἐστι τὸ γνωστικὸν παρὰ τῷ θεῷ καὶ ἄλλως πως παρὰ τῷ ἀνθρώπῳ·", "seq": 751}
{"id": "David_Passim_0752", "series": "CAG", "text": "καὶ γὰρ ὁ μὲν θεὸς ἀεὶ καὶ ἅμα πάντα γινώσκει καὶ οὐκ ἔστι χρόνος ἡνίκα οὐ γινώσκει, ὁ δὲ ἄνθρωπος οὔτε ἀεὶ οὔτε ἅμα πάντα γινώσκει·", "seq": 752}
{"id": "David_Passim_0753", "series": "CAG", "text": "ἰδοὺ γὰρ τὸ νεωστὶ τικτόμενον παιδίον οὐδὲν γινώσκει ἐνεργείᾳ ἀλλὰ δυνάμει λέγεται γινώσκειν, καὶ πάλιν ἐνδέχεταί τινα σήμερον μὲν εἰ τύχοι γινώσκειν αὔριον δὲ ἐπιλαθέσθαι τοῦ γινωσκομένου καὶ μὴ γινώσκειν αὐτό.", "seq": 753}
{"id": "David_Passim_0754", "series": "CAG", "text": "ἀλλ᾿ οὔτε δὲ ἅμα πάντα γινώσκει ἀλλὰ κατὰ μέρος·", "seq": 754}
{"id": "David_Passim_0755", "series": "CAG", "text": "ἐν μὲν γὰρ τῷδε τῷ χρόνῳ τόδε γινώσκει καὶ ἐν ἄλλῳ ἄλλο, ὡς δηλοῖ καὶ ὁ Πλάτων λέγων ‘ἀγαπητόν, ὅτῳ κἂν ἐν γήρᾳ σοφία τε καὶ φρόνησις παρῇ’.", "seq": 755}
{"id": "David_Passim_0756", "series": "CAG", "text": "καὶ πάλιν ἄλλως πώς ἐστι τὸ δυνατὸν παρὰ τῷ θεῷ καὶ ἄλλως πως παρὰ τῷ ἀνθρώπῳ·", "seq": 756}
{"id": "David_Passim_0757", "series": "CAG", "text": "καὶ γὰρ ἐπὶ μὲν τοῦ θεοῦ ἀντιστρέφει·", "seq": 757}
{"id": "David_Passim_0758", "series": "CAG", "text": "ὅσα γὰρ βούλεται, δύναται καὶ ὅσα δύναται, βούλεται καὶ οὐδὲν ἀδύνατόν ἐστι παρὰ τῷ θεῷ.", "seq": 758}
{"id": "David_Passim_0759", "series": "CAG", "text": "ἐπὶ δὲ τοῦ φιλοσόφου οὐκ ἀντιστρέφει·", "seq": 759}
{"id": "David_Passim_0760", "series": "CAG", "text": "ὅσα μὲν γὰρ δύναται, βούλεται, οὐχ ὅσα δὲ βούλεται, δύναται·", "seq": 760}
{"id": "David_Passim_0761", "series": "CAG", "text": "καὶ γὰρ ἐὰν βουληθῇ ἀδύνατόν τι ποιῆσαι, οἱονεὶ ἅψασθαι τοῦ οὐρανοῦ τῷ δακτύλῳ ἢ δημιουργῆσαι οὐρανόν, οὐ δύναται τοῦτο ποιῆσαι.", "seq": 761}
{"id": "David_Passim_0762", "series": "CAG", "text": "εἰ δέ τις εἴποι ‘ἀλλ᾿ οὐ βούλεταί τι ἀδύνατον ὁ τέλειος φιλόσοφος, ἀλλὰ τούτων ἐρᾷ, ὧν καὶ τυχεῖν δύναται·", "seq": 762}
{"id": "David_Passim_0763", "series": "CAG", "text": "κατὰ γὰρ τοὺς Στωϊκοὺς μεγίστη ἔνδειά ἐστιν ἡ τῶν ὀρέξεων ἀπληστία’, λέγομεν ὅτι ὡς γινώσκων τὴν τῆς οἰκείας φύσεως ἀσθένειαν οὐ βούλεταί τι ἀδύνατον, ἀλλ᾿ ὧν δύναται τυχεῖν, τούτων καὶ ἐρᾷ, παρὰ μέντοι τῷ θεῷ οὐδέν ἐστιν ἀδύνατον.", "seq": 763}
{"id": "David_Passim_0764", "series": "CAG", "text": "ταῦτα μὲν ἐν τούτοις.", "seq": 764}
{"id": "David_Passim_0765", "series": "CAG", "text": "Ἀποροῦσι δέ τινες λέγοντες·", "seq": 765}
{"id": "David_Passim_0766", "series": "CAG", "text": "ποῦ ὡρίσατο ὁ Πλάτων οὕτω τὴν φιλοσοφίαν ‘ὁμοίωσιν θεῷ κατὰ τὸ δυνατὸν ἀνθρώπῳ’;", "seq": 766}
{"id": "David_Passim_0767", "series": "CAG", "text": "καὶ ἔστιν εἰπεῖν ὅτι ἐν τῷ Θεαιτήτῳ·", "seq": 767}
{"id": "David_Passim_0768", "series": "CAG", "text": "ἐκεῖ γὰρ πρὸς Θεόδωρόν τινα γεωμέτρην ποιούμενος τὸν λόγον λέγει οὕτως·", "seq": 768}
{"id": "David_Passim_0769", "series": "CAG", "text": "‘ἀλλ᾿ ἐπεί, ὦ Θεόδωρε, οὔτ᾿ ἀπολέσθαι τὰ κακὰ δύναται (ὑπεναντίον γάρ τι τῷ ἀγαθῷ εἶναι ἀνάγκη), οὔτ᾿ ἐν θεοῖς ταῦτα ἱδρῦσθαι, τήνδε τὴν θνητὴν φύσιν καὶ τόνδε τὸν τόπον περιπολεῖ ἐξ ἀνάγκης.", "seq": 769}
{"id": "David_Passim_0770", "series": "CAG", "text": "διὸ χρὴ πειρᾶσθαι φεύγειν ἐνθένδε ἐκεῖσε ὅτι τάχιστα.", "seq": 770}
{"id": "David_Passim_0771", "series": "CAG", "text": "τίς οὖν ἐστιν ἡ φυγή;", "seq": 771}
{"id": "David_Passim_0772", "series": "CAG", "text": "ὁμοίωσις θεῷ κατὰ τὸ δυνατὸν ἀνθρώπῳ.", "seq": 772}
{"id": "David_Passim_0773", "series": "CAG", "text": "ὁμοίωσις δέ ἐστι τὸ ὅσιον καὶ δίκαιον γενέσθαι μετὰ φρονήσεως’.", "seq": 773}
{"id": "David_Passim_0774", "series": "CAG", "text": "πάλιν ἀποροῦσιν ὅτι οὐχ ὡρίσατο τὴν φιλοσοφίαν ἀλλὰ τὴν φυγὴν τῶν κακῶν.", "seq": 774}
{"id": "David_Passim_0775", "series": "CAG", "text": "πρὸς οὓς ἔστιν εἰπεῖν ὅτι καὶ ἡ φυγὴ τῶν κακῶν οὐδὲν ἕτερόν ἐστιν εἰ μὴ φιλοσοφία·", "seq": 775}
{"id": "David_Passim_0776", "series": "CAG", "text": "εἰ γὰρ ἡ φιλοσοφία νέκρωσιν ἀπεργάζεται τῶν παθῶν, ὡς ἀνωτέρω ἐλέγομεν ὁριζόμενοι αὐτὴν μελέτην θανάτου, ἡ δὲ νέκρωσις τῶν παθῶν οὐδὲν ἕτερόν ἐστιν εἰ μὴ φυγὴ τῶν κακῶν, δῆλον ὅτι τὴν φιλοσοφίαν ὡρίσατο.", "seq": 776}
{"id": "David_Passim_0777", "series": "CAG", "text": "ἄλλως τε δὲ εἰ ἄρα ἡ δικαιοσύνη καὶ ἡ φρόνησις ἀρεταί εἰσι, χωρίον δὲ τῶν ἀρετῶν ἡ φιλοσοφία ἐστί (διὰ γὰρ τῆς φιλοσοφίας τὰς ἀρετὰς προσκτώμεθα), δῆλον ὅτι διὰ τοῦ εἰπεῖν ‘ὅσιον καὶ δίκαιον γενέσθαι μετὰ φρονήσεως’ τὴν φιλοσοφίαν ὡρίσατο.", "seq": 777}
{"id": "David_Passim_0778", "series": "CAG", "text": "ἔτι δὲ διὰ μὲν τοῦ εἰπεῖν ‘μετὰ φρονήσεως’ τὸ θεωρητικὸν ὡρίσατο·", "seq": 778}
{"id": "David_Passim_0779", "series": "CAG", "text": "εἰ γὰρ φρόνησίς ἐστιν ἡ τελειότης τοῦ λόγου, τέλος δὲ τοῦ θεωρητικοῦ ἡ τελειότης τοῦ λόγου ἐστί, τοῦτ᾿ ἔστιν ἡ τοῦ λόγου εἴδησις, δῆλον ὅτι διὰ τοῦ εἰπεῖν ‘μετὰ φρονήσεως’ τὸ θεωρητικὸν ὡρίσατο.", "seq": 779}
{"id": "David_Passim_0780", "series": "CAG", "text": "διὰ δὲ τοῦ εἰπεῖν ‘τὸ ὅσιον καὶ δίκαιον’ τὸ πρακτικὸν ὡρίσατο·", "seq": 780}
{"id": "David_Passim_0781", "series": "CAG", "text": "εἰ γὰρ τὸ ὅσιον καὶ δίκαιον ἀρετὴ ἤθους ἐστί, τέλος δὲ τοῦ πρακτικοῦ ἡ ἀρετὴ τοῦ ἤθους ἐστὶν ἤγουν ὁ τοῦ ἤθους καλλωπισμός, δῆλον ὅτι διὰ τοῦ εἰπεῖν ‘ὅσιον καὶ δίκαιον’ τὸ πρακτικὸν ὡρίσατο.", "seq": 781}
{"id": "David_Passim_0782", "series": "CAG", "text": "ταῦτα μὲν ἐν τούτοις.", "seq": 782}
{"id": "David_Passim_0783", "series": "CAG", "text": "Ἀποροῦσι δέ τινες λέγοντες·", "seq": 783}
{"id": "David_Passim_0784", "series": "CAG", "text": "διὰ τί τὰ δύο πρόσκεινται, τοῦτ᾿ ἔστι τὸ ὅσιον καὶ τὸ δίκαιον;", "seq": 784}
{"id": "David_Passim_0785", "series": "CAG", "text": "καί τινες ἐπιλυόμενοι λέγουσιν ὅτι τὸ ὅσιον ἐπίτασίς ἐστι τοῦ δικαίου, ὅθεν καὶ τοὺς πάνυ ὄντας ἀδίκους ἀνοσίους λέγομεν.", "seq": 785}
{"id": "David_Passim_0786", "series": "CAG", "text": "κρεῖττον δέ ἐστιν εἰπεῖν ὅτι διαφέρει ὅσιον δικαίου·", "seq": 786}
{"id": "David_Passim_0787", "series": "CAG", "text": "καὶ γὰρ δίκαιος μὲν λέγεται ὁ τὴν ἰσότητα τοῖς ὁμοειδέσι φυλάττων, ὅσιος δὲ ὁ περὶ τὰ θεῖα ἐσπουδακώς·", "seq": 787}
{"id": "David_Passim_0788", "series": "CAG", "text": "ὅτι γὰρ διαφέρει τὸ ὅσιον τοῦ δικαίου, δηλοῖ ὁ Πλάτων ποιήσας <δύο> διαλόγους καὶ ἐν τινὶ μὲν αὐτῶν ἐπιγράψας “Περὶ δικαίου ἢ περὶ πολιτείας”, ἐν τινὶ δὲ αὐτῶν “Εὐθύφρων ἢ περὶ ὁσίου”, ἐν ᾧ περὶ τῶν θείων διαλαμβάνει.", "seq": 788}
{"id": "David_Passim_0789", "series": "CAG", "text": "ταῦτα μὲν ἐν τούτοις.", "seq": 789}
{"id": "David_Passim_0790", "series": "CAG", "text": "ἀποροῦσι δέ τινες λέγοντες·", "seq": 790}
{"id": "David_Passim_0791", "series": "CAG", "text": "εἰ ἄρα τέσσαρές εἰσιν αἱ ἀρεταὶ τῆς ψυχῆς, ἀνδρία δικαιοσύνη σωφροσύνη φρόνησις, διὰ τί μιᾶς μόνης ἐνταῦθα ἐμνημόνευσε, φημὶ δὴ τῆς δικαιοσύνης;", "seq": 791}
{"id": "David_Passim_0792", "series": "CAG", "text": "πρὸς οὓς ἔστιν εἰπεῖν ὅτι πρῶτον μὲν καὶ τῆς φρονήσεως ἐμνημόνευσεν·", "seq": 792}
{"id": "David_Passim_0793", "series": "CAG", "text": "εἶπε γὰρ ‘τὸ ὅσιον καὶ δίκαιον γενέσθαι μετὰ φρονήσεως’.", "seq": 793}
{"id": "David_Passim_0794", "series": "CAG", "text": "δεύτερον δέ, εἰ καὶ αὐτῆς ἐμνημόνευσε μόνης, οὐδὲν ἄτοπόν ἐστιν, ὡς δείξομεν·", "seq": 794}
{"id": "David_Passim_0795", "series": "CAG", "text": "ἰστέον γὰρ ὅτι τριμεροῦς οὔσης τῆς ψυχῆς (ἔστι γὰρ λόγος θυμὸς καὶ ἐπιθυμία) τέσσαρές εἰσιν αἱ ἀρεταὶ τῆς ψυχῆς·", "seq": 795}
{"id": "David_Passim_0796", "series": "CAG", "text": "ἔστι γὰρ ἀνδρία δικαιοσύνη σωφροσύνη φρόνησις.", "seq": 796}
{"id": "David_Passim_0797", "series": "CAG", "text": "καὶ τοῦτο εἰκότως·", "seq": 797}
{"id": "David_Passim_0798", "series": "CAG", "text": "δεῖ γὰρ ἕκαστον μέρος τῆς ψυχῆς ἰδίᾳ κεκοσμῆσθαι ἀρετῇ, ὅθεν ὁ μὲν λόγος τῇ φρονήσει κεκόσμηται, ὁ δὲ θυμὸς τῇ ἀνδρίᾳ, ἡ δὲ ἐπιθυμία τῇ σωφροσύνῃ.", "seq": 798}
{"id": "David_Passim_0799", "series": "CAG", "text": "καὶ ἐπειδὴ οὐ μόνον δεῖ ἕκαστον τῶν μερῶν ἰδίᾳ κεκοσμῆσθαι ἀρετῇ ἀλλὰ καὶ τὴν πρὸς ἄλληλα ἁρμονίαν καὶ εὐταξίαν φυλάττειν δεῖ, τούτου χάριν ἡ δικαιοσύνη διὰ πάντων πεφοίτηκεν, ἵνα μὴ ἐν ἑνὶ μόνῳ μέρει ἀλλ᾿ ἐν πᾶσι θεωρουμένη τοῖς μέρεσιν ἁρμονίαν καὶ εὐταξίαν φυλάξῃ.", "seq": 799}
{"id": "David_Passim_0800", "series": "CAG", "text": "καὶ ὥσπερ ἐν τῷ παντὶ ὁρῶμεν τὰ μὲν μόνως ἄρχοντα οἷον τὰ θεῖα, τὰ δὲ καὶ ἄρχοντα καὶ ἀρχόμενα οἷον τὰ ἀνθρώπεια (ταῦτα γὰρ καὶ ἄρχονται ἐκ τῶν θείων καὶ ἄρχουσι τῶν ἀλόγων ζῴων), τὰ δὲ μόνως ἀρχόμενα ὥσπερ τὰ ἄλογα ζῷα, τὸν αὐτὸν τρόπον καὶ ἐν τῷ ἀνθρώπῳ μικρῷ κόσμῳ ὄντι κατὰ τὸν Δημόκριτον ταῦτα θεωροῦνται, καὶ τὰ μὲν μόνως ἄρχουσιν ὥσπερ ὁ λόγος, τὰ δὲ καὶ ἄρχονται καὶ ἄρχουσιν ὥσπερ ὁ θυμός (ἄρχεται μὲν γὰρ οὗτος ἐκ τοῦ λόγου, ἄρχει δὲ τῆς ἐπιθυμίας), τὰ δὲ μόνως ἄρχονται ὥσπερ ἡ ἐπιθυμία.", "seq": 800}
{"id": "David_Passim_0801", "series": "CAG", "text": "τούτων οὖν οὕτως ἐχόντων ἐπειδὴ ἡ δικαιοσύνη ὑπὲρ τὰς ἄλλας ἀρετάς ἐστιν ὥσπερ διὰ πάντων φοιτῶσα καὶ τὴν εὐταξίαν αὐτῶν φυλάττουσα, τούτου χάριν αὐτῆς ὡς ἀναγκαιοτάτης ἐμνήσθη.", "seq": 801}
{"id": "David_Passim_0802", "series": "CAG", "text": "τρίτον δὲ τῆς δικαιοσύνης μνημονεύσας καὶ τὰς ἄλλας ἀρετὰς συμπεριέλαβε·", "seq": 802}
{"id": "David_Passim_0803", "series": "CAG", "text": "καὶ γὰρ αἱ ἐπιστημονικαὶ ἀρεταὶ ἤγουν αἱ μετὰ λόγου ἀλλήλαις ἕπονται·", "seq": 803}
{"id": "David_Passim_0804", "series": "CAG", "text": "καὶ γὰρ ὁ μετὰ λόγου ὢν σώφρων, τοῦτ᾿ ἔστιν ὁ γινώσκων διὰ τί ἐστι σώφρων, οἷον ὁ γινώσκων ὅτι δεῖ τινα εἶναι σώφρονα, ἐπειδὴ ἐκ τῆς ἀκολασίας ἀδικίαι καὶ πλεονεξίαι γίνονται, ὁ τοιοῦτος ἐξ ἀνάγκης καὶ ἀνδρεῖός ἐστι, διότι τὰ πάθη ὑποτάττει, ὁ τοιοῦτος δὲ καὶ φρόνιμός ἐστιν (οἶδε γὰρ τὴν αἰτίαν, δι᾿ ἣν δεῖ τινα εἶναι σώφρονα), ὁ τοιοῦτος δὲ καὶ δίκαιός ἐστι·", "seq": 804}
{"id": "David_Passim_0805", "series": "CAG", "text": "καὶ γὰρ ἐκ τῶν σωματικῶν ἡδυπαθειῶν ἀδικίαι γίνονται.", "seq": 805}
{"id": "David_Passim_0806", "series": "CAG", "text": "πρόσκειται δὲ ‘αἱ ἐπιστημονικαὶ ἀρεταί’ διὰ τὰς φυσικάς·", "seq": 806}
{"id": "David_Passim_0807", "series": "CAG", "text": "φυσικαὶ δέ εἰσιν αἱ ἀπὸ κράσεως οὖσαι·", "seq": 807}
{"id": "David_Passim_0808", "series": "CAG", "text": "αὗται γὰρ οὐχ ἕπονται ἀλλήλαις·", "seq": 808}
{"id": "David_Passim_0809", "series": "CAG", "text": "καὶ γὰρ ὁ ἀπὸ κράσεως ὢν σώφρων οὐ πάντως ἐστὶ καὶ ἀνδρεῖος ἢ φρόνιμος ἢ δίκαιος·", "seq": 809}
{"id": "David_Passim_0810", "series": "CAG", "text": "αὗται γὰρ καὶ ἀνδραποδώδεις καὶ ἄλογοι καλοῦνται, καὶ ἀνδραποδώδεις μέν, διότι ἐξ ἀνάγκης ταῖς κράσεσιν ἕπονται·", "seq": 810}
{"id": "David_Passim_0811", "series": "CAG", "text": "καὶ γὰρ ὁ ψυχροτέρας ὢν κράσεως ἐξ ἀνάγκης ἐστὶ σώφρων.", "seq": 811}
{"id": "David_Passim_0812", "series": "CAG", "text": "ἄλογοι δὲ καλοῦνται, ἢ ἐπειδὴ ὁ ἐκ κράσεως ὢν σώφρων οὐ πάντως μετὰ λόγου ἐστὶ σώφρων (οὐδὲ γὰρ πάντως γινώσκει τὴν αἰτίαν, δι᾿ ἣν δεῖ τινα εἶναι σώφρονα), ἢ ἄλογοι λέγονται, ἐπειδὴ καὶ ἐν τοῖς ἀλόγοις ζῴοις θεωροῦνται, ὥσπερ ἡ μὲν τρυγὼν ἐκ φύσεώς ἐστι σώφρων ἡ δὲ ἀλώπηξ φρόνιμος ὁ δὲ λέων ἀνδρεῖος ὁ δὲ πελαργὸς δίκαιος·", "seq": 812}
{"id": "David_Passim_0813", "series": "CAG", "text": "καὶ γὰρ οὗτος γηράσαντα τὸν πατέρα γηροτροφεῖ.", "seq": 813}
{"id": "David_Passim_0814", "series": "CAG", "text": "ἢ καὶ πάλιν ‘ἐπιστημονικαί’ πρόσκειται διὰ τὰς ἠθικὰς ἀρετάς·", "seq": 814}
{"id": "David_Passim_0815", "series": "CAG", "text": "ἠθικαὶ δέ εἰσιν αἱ ἀπὸ παραδόσεώς τινος καὶ παραγγελίας οὖσαι, οἷον ὡς ὅταν τις ἀπὸ παραδόσεως ἢ παραγγελίας τινός ἐστι σώφρων.", "seq": 815}
{"id": "David_Passim_0816", "series": "CAG", "text": "αὗται δὲ οὐχ ἕπονται ἀλλήλαις·", "seq": 816}
{"id": "David_Passim_0817", "series": "CAG", "text": "καὶ γὰρ ἐνδέχεταί τινα εἶναι σώφρονα ἀπὸ παραδόσεως καὶ μὴ εἶναι φρόνιμον.", "seq": 817}
{"id": "David_Passim_0818", "series": "CAG", "text": "ἐν οἷς ἡ πρᾶξις.", "seq": 818}
{"id": "David_Passim_0819", "series": "CAG", "text": "Πράξις ιγ΄.", "seq": 819}
{"id": "David_Passim_0820", "series": "CAG", "text": "Μετὰ τὸ τὸν Πλάτωνα καὶ τὸν Πυθαγόραν διχῶς ὁρίσασθαι τὴν φιλοσοφίαν, τὸν μὲν ἐκ τοῦ ὑποκειμένου τὸν δὲ ἐκ τοῦ τέλους, ἔρχεται ὁ Σταγειρίτης, φημὶ δὴ ὁ Ἀριστοτέλης (Στάγειρα γάρ ἐστι πόλις τῆς Μακεδονίας, ὅθεν ἦν ὁ Ἀριστοτέλης), καὶ ὁρίζεται αὐτὴν οὐ σμικρόν τι φρονῶν, καθὸ μονοειδῶς αὐτὴν ὡρίσατο ἑκατέρου ἐκείνων διχῶς αὐτὴν ὁρισαμένου, ἀλλὰ μέγα καὶ ἐπηρμένον φρονῶν, καθὸ ἐκ τῆς ὑπεροχῆς αὐτὴν ὡρίσατο λέγων ‘φιλοσοφία ἐστὶ τέχνη τεχνῶν καὶ ἐπιστήμη ἐπιστημῶν’.", "seq": 820}
{"id": "David_Passim_0821", "series": "CAG", "text": "ἀλλὰ δεῖ ζητῆσαι τί βούλεται ἑκάτερος τῶν ἀναδιπλασιασμῶν, τοῦτ᾿ ἔστι τέχνη τεχνῶν καὶ ἐπιστήμη ἐπιστημῶν·", "seq": 821}
{"id": "David_Passim_0822", "series": "CAG", "text": "ἤρκει γὰρ εἰπεῖν ὅτι φιλοσοφία ἐστὶ τέχνη καὶ ἐπιστήμη.", "seq": 822}
{"id": "David_Passim_0823", "series": "CAG", "text": "καὶ ἔστιν εἰπεῖν ὅτι διὰ τοῦ πρώτου ἀναδιπλασιασμοῦ, τοῦ τέχνη τεχνῶν, βασιλεῖ παρείκασε τὴν φιλοσοφίαν, διὰ δὲ τοῦ δευτέρου ἀναδιπλασιασμοῦ, τοῦτ᾿ ἔστι τοῦ ἐπιστήμη ἐπιστημῶν, θεῷ·", "seq": 823}
{"id": "David_Passim_0824", "series": "CAG", "text": "ὥσπερ γὰρ ἄρχοντα ἀρχόντων λέγοντες δηλοῦμεν τὸν βασιλέα, τὸν αὐτὸν τρόπον καὶ τέχνην τεχνῶν λέγοντες τὴν φιλοσοφίαν βασιλεῖ αὐτὴν παρεικάζομεν.", "seq": 824}
{"id": "David_Passim_0825", "series": "CAG", "text": "καὶ πάλιν ὥσπερ βασιλέα βασιλέων λέγοντες δηλοῦμεν τὸν θεόν, τὸν αὐτὸν τρόπον καὶ ἐπιστήμην ἐπιστημῶν λέγοντες τὴν φιλοσοφίαν θεῷ αὐτὴν παρεικάζομεν·", "seq": 825}
{"id": "David_Passim_0826", "series": "CAG", "text": "καὶ γὰρ κρείττων ἡ ἐπιστήμη τῆς τέχνης, καθὸ ἡ ἐπιστήμη δίδωσι τῇ τέχνῃ τὰς ἀρχάς·", "seq": 826}
{"id": "David_Passim_0827", "series": "CAG", "text": "καὶ γὰρ ὁ γραμματικὸς οἶδε μὲν ὅτι τὸ η καὶ τὸ ω μακρά ἐστι, τὴν δὲ αἰτίαν τῇ μουσικῇ παραπέμπει.", "seq": 827}
{"id": "David_Passim_0828", "series": "CAG", "text": "ὥσπερ δὲ ὁ βασιλεὺς οὐ ῥυποῖ ἑαυτὸν ἀμέσως τῷ πολλῷ ὄχλῳ διαλεγόμενος, ἀλλ᾿ ἵστησιν ἄρχοντας, δι᾿ ὧν καὶ τῶν ἐσχάτων φροντίδα ποεῖται, τὸν αὐτὸν τρόπον καὶ ἡ φιλοσοφία προβάλλεται τὰς τέχνας, δι᾿ ὧν τὰ ὑποβεβλημένα αὐτῇ γινώσκει.", "seq": 828}
{"id": "David_Passim_0829", "series": "CAG", "text": "καὶ πάλιν ὥσπερ τὸ θεῖον ἔχει δυνάμεις τινάς, δι᾿ ὧν τῶν τῇδε προνοεῖται, οὕτω καὶ ἡ φιλοσοφία προβάλλεται τὰς ἐπιστήμας, δι᾿ ὧν τὰ ὑποβεβλημένα αὐτῇ γινώσκει.", "seq": 829}
{"id": "David_Passim_0830", "series": "CAG", "text": "Ἄλλως τε δὲ διὰ τοῦτο εἶπε τὴν φιλοσοφίαν τέχνην τεχνῶν καὶ ἐπιστήμην ἐπιστημῶν, ἐπειδὴ ὃν λόγον ἔχουσι τὰ ὑποκείμενα πρὸς τὰς τέχνας καὶ ἐπιστήμας, τοῦτον τὸν λόγον ἔχουσι καὶ αἱ ἐπιστῆμαι καὶ αἱ τέχναι πρὸς τὴν φιλοσοφίαν·", "seq": 830}
{"id": "David_Passim_0831", "series": "CAG", "text": "καὶ γὰρ τῇ ἰατρικῇ ὑπόκεινται τὰ ἀνθρώπεια σώματα, τῇ δὲ φιλοσοφίᾳ αὐτὴ ἡ ἰατρικὴ ὑπόκειται.", "seq": 831}
{"id": "David_Passim_0832", "series": "CAG", "text": "καὶ πάλιν τῇ ἀστρονομίᾳ ὑπόκεινται τὰ οὐράνια σώματα, τῇ δὲ φιλοσοφίᾳ αὐτὴ ἡ ἀστρονομία ὑπόκειται.", "seq": 832}
{"id": "David_Passim_0833", "series": "CAG", "text": "ἔτι δὲ διὰ τοῦτο εἶπε τὴν φιλοσοφίαν τέχνην τεχνῶν καὶ ἐπιστήμην ἐπιστημῶν, ἐπειδὴ αὕτη μὲν τὴν φύσιν τῶν πραγμάτων γινώσκει, τὰ δὲ παρεπόμενα δίδωσι γινώσκειν ταῖς τέχναις καὶ ἐπιστήμαις·", "seq": 833}
{"id": "David_Passim_0834", "series": "CAG", "text": "καὶ γὰρ αὕτη λαμβάνουσα κατὰ τὴν γνῶσιν τὸ εἶδος καὶ τὴν ὕλην ἀποτελεῖ τὰ τέσσαρα στοιχεῖα καὶ ἐκ τούτων ἀποτελεῖ τὰ ὁμοιομερῆ καὶ ἐκ τῶν ὁμοιομερῶν τὰ ὀργανικὰ καὶ ἐκ τούτων τὸ ἀνθρώπειον σῶμα, καὶ λοιπὸν τὰ ἄλλα δίδωσι γινώσκειν τῇ ἰατρικῇ, φημὶ δὲ τὴν νόσον καὶ τὴν ὑγίειαν, οὐχ ὡς ἀγνοοῦσα αὐτά (γινώσκει γὰρ καὶ ταῦτα), ἀλλ᾿ ὡς μὴ βουλομένη καταρρυποῦν ἑαυτὴν καὶ ἐπὶ τὰ ἔσχατα ἔρχεσθαι.", "seq": 834}
{"id": "David_Passim_0835", "series": "CAG", "text": "καὶ πάλιν ἡ φιλοσοφία γινώσκει τὴν φύσιν τῆς φωνῆς, τὰ δὲ παρεπόμενα δίδωσι τῇ γραμματικῇ, τοῦτ᾿ ἔστι τοὺς τόνους καὶ τὰ πνεύματα.", "seq": 835}
{"id": "David_Passim_0836", "series": "CAG", "text": "καὶ πάλιν ἡ φιλοσοφία γινώσκει τὰ σχήματα καὶ τὴν φύσιν τῆς γεωμετρίας, τὰ δὲ λοιπὰ δίδωσι τῇ γεωμετρίᾳ γινώσκειν, οἷον ὅτι τὸ σημεῖον ἀμερές ἐστιν.", "seq": 836}
{"id": "David_Passim_0837", "series": "CAG", "text": "ἔτι δὲ διὰ τοῦτο εἶπε τὴν φιλοσοφίαν τέχνην τεχνῶν καὶ ἐπιστήμην ἐπιστημῶν, ἐπειδὴ ταῖς τέχναις καὶ ταῖς ἐπιστήμαις αὕτη δίδωσι τὰς ἀρχάς·", "seq": 837}
{"id": "David_Passim_0838", "series": "CAG", "text": "καὶ γὰρ ἡ γραμματική, ὡς εἴρηται, οἶδεν ὅτι τὸ η καὶ τὸ ω μακρά ἐστι, τὴν δὲ αἰτίαν οὐκ οἶδεν, ἀλλὰ παραπέμπει ταύτην τῇ μουσικῇ.", "seq": 838}
{"id": "David_Passim_0839", "series": "CAG", "text": "καὶ πάλιν ὁ ἰατρὸς οἶδεν ὅτι ἐκ τῶν τεσσάρων στοιχείων τὰ ἀνθρώπεια συνίστανται σώματα, τὴν δὲ αἰτίαν παραπέμπει τῇ φυσικῇ φιλοσοφίᾳ.", "seq": 839}
{"id": "David_Passim_0840", "series": "CAG", "text": "καὶ πάλιν ὁ γεωμέτρης οἶδεν ὅτι τὸ σημεῖον ἀμερές ἐστι, τὴν δὲ αἰτίαν παραπέμπει τῇ φυσικῇ φιλοσοφίᾳ·", "seq": 840}
{"id": "David_Passim_0841", "series": "CAG", "text": "οὐδὲ γὰρ οἶδε τὴν αἰτίαν, δι᾿ ἣν τὸ σημεῖον ἀμερές ἐστι.", "seq": 841}
{"id": "David_Passim_0842", "series": "CAG", "text": "πάλιν ἡ ῥητορικὴ κέχρηται τῷ τοιῷδε δικαίῳ, τοῦτ᾿ ἔστι τῷ πολιτικῷ, τὴν δὲ φύσιν οὐκ οἶδε τοῦ δικαίου, ἀλλὰ ταύτην ὁ φιλόσοφος οἶδεν.", "seq": 842}
{"id": "David_Passim_0843", "series": "CAG", "text": "ὅθεν ἀγνοοῦντες οἱ ῥήτορες τὴν φύσιν τοῦ δικαίου μᾶλλον αἱροῦνται ἀδικεῖν ἤπερ ἀδικεῖσθαι, ὁ δὲ φιλόσοφος ὡς γινώσκων τὴν φύσιν τοῦ δικαίου οὐδὲν μὲν τούτων αἱρεῖται, εἰ δὲ καὶ συμβῇ αἱρεῖσθαί τι τούτων τὸν φιλόσοφον, μᾶλλον αἱρεῖται ἀδικεῖσθαι ἢ ἀδικεῖν·", "seq": 843}
{"id": "David_Passim_0844", "series": "CAG", "text": "καὶ γὰρ λέγουσιν ὅτι οὐ δύναταί τίς τινος ψυχὴν ἀδικῆσαι, εἰ μὴ ἄρα αὐτὸς τὴν ἰδίαν ψυχὴν ἀδικήσῃ ἄδικά τινα καὶ ἄτοπα διαπραττόμενος·", "seq": 844}
{"id": "David_Passim_0845", "series": "CAG", "text": "καὶ γὰρ ὁ ἀδικῶν τινα ἢ περὶ τὸ σῶμα αὐτὸν ἀδικεῖ διὰ τοῦ πληγὰς αὐτῷ ἐπιφέρειν ἢ περὶ τὰ ἐκτός, ἤγουν τὰ χρήματα, διὰ τοῦ ἀφαρπάζειν τὴν οὐσίαν αὐτοῦ.", "seq": 845}
{"id": "David_Passim_0846", "series": "CAG", "text": "αὐτὸς δὲ τὴν ὕπαρξιν ἐν τῇ ψυχῇ ἔχει·", "seq": 846}
{"id": "David_Passim_0847", "series": "CAG", "text": "τὸ γὰρ σῶμα ὄργανόν ἐστι τῆς ψυχῆς.", "seq": 847}
{"id": "David_Passim_0848", "series": "CAG", "text": "ὅθεν λέγομεν ὅτι ἔστιν ἐγὼ καὶ ἐμὸν καὶ τὰ τοῦ ἐμοῦ, καὶ ἐγώ μὲν ἔλεγον τὴν ψυχήν, καθὸ ἕκαστος τὴν ὕπαρξιν ἐν τῇ ψυχῇ ἔχει, ἐμόν δὲ ἔλεγον τὸ σῶμα (καὶ γὰρ ὄργανον τῆς ψυχῆς τὸ σῶμά ἐστι), τὰ τοῦ ἐμοῦ δὲ ἔλεγον τὰ ἐκτός·", "seq": 848}
{"id": "David_Passim_0849", "series": "CAG", "text": "καὶ γὰρ τὰ κτήματα τοῦ σώματός εἰσιν.", "seq": 849}
{"id": "David_Passim_0850", "series": "CAG", "text": "ὁ οὖν ἀδικῶν εἰ μὴ τὴν ἰδίαν ψυχὴν οὐκ ἀδικεῖ.", "seq": 850}
{"id": "David_Passim_0851", "series": "CAG", "text": "Ἰστέον δὲ ὅτι οὐ μόναις ταῖς ἐπιστήμαις καὶ ταῖς λογικαῖς τέχναις ἡ φιλοσοφία δίδωσι τὰς ἀρχὰς ἀλλὰ καὶ ταῖς βαναύσοις τέχναις.", "seq": 851}
{"id": "David_Passim_0852", "series": "CAG", "text": "ἰστέον δὲ ὅτι βάναυσοι τέχναι καταχρηστικῶς μὲν πᾶσαι αἱ ἄλογοι λέγονται, κυρίως δὲ αἱ διὰ πυρὸς ἐργαζόμεναι λέγονται βάναυσοι παρὰ τὸ βαίνειν περὶ τὸν αὐσόν·", "seq": 852}
{"id": "David_Passim_0853", "series": "CAG", "text": "αὐσὸς δέ ἐστιν ἡ κάμινος παρὰ τὸ ἀτμόν τινα ἀφιέναι·", "seq": 853}
{"id": "David_Passim_0854", "series": "CAG", "text": "καὶ γὰρ ὁ τέκτων γινώσκει μὲν ὅτι τῇ στάθμῃ, ἤγουν τῷ σχοινίῳ, διακρίνεται τὰ ὀρθὰ καὶ τὰ καμπύλα ξύλα, ὅθεν καὶ ὁ ποιητὴς δηλοῖ λέγων", "seq": 854}
{"id": "David_Passim_0855", "series": "CAG", "text": "ἐπὶ στάθμην ἴθυνε,", "seq": 855}
{"id": "David_Passim_0856", "series": "CAG", "text": "τὴν δὲ αἰτίαν, δι᾿ ἣν τῇ στάθμῃ διακρίνεται, οὐκ οἶδεν ἀλλὰ παραπέμπει τὴν αἰτίαν τῷ φιλοσόφῳ·", "seq": 856}
{"id": "David_Passim_0857", "series": "CAG", "text": "τούτου γὰρ τὴν αἰτίαν ὁ γεωμέτρης οἶδε.", "seq": 857}
{"id": "David_Passim_0858", "series": "CAG", "text": "ταῦτα μὲν ἐν τούτοις.", "seq": 858}
{"id": "David_Passim_0859", "series": "CAG", "text": "ἰστέον δὲ ὅτι ἄλογοι τέχναι λέγονται οὐ παρὰ τὸ μὴ ἔχειν λόγον καὶ αἰτίαν, εἰ καὶ μὴ ὁ τεχνίτης ἐπίσταται τὴν αἰτίαν, ἀλλ᾿ ἐπειδὴ δύναταί τις καὶ μὴ φθεγγόμενος μετέρχεσθαι αὐτάς·", "seq": 859}
{"id": "David_Passim_0860", "series": "CAG", "text": "δύναται γὰρ ὁ τέκτων καὶ μὴ λαλῶν ἀποτελέσαι θρόνον.", "seq": 860}
{"id": "David_Passim_0861", "series": "CAG", "text": "ἰστέον δὲ ὅτι οὐ μόνον τὰς ἀρχὰς ταῖς τέχναις καὶ ταῖς ἐπιστήμαις ἡ φιλοσοφία δίδωσιν, ἀλλὰ καὶ ἐπανορθοῦται τὰ ἐν αὐταῖς ἡμαρτημένα·", "seq": 861}
{"id": "David_Passim_0862", "series": "CAG", "text": "καὶ γὰρ οἱ μὲν γραμματικοὶ τὴν φωνὴν ὁρίζονται πληγὴν ἀέρος, ὁ δὲ φιλόσοφος διορθούμενος λέγει ὅτι κακῶς ἔχει ὁ ὅρος·", "seq": 862}
{"id": "David_Passim_0863", "series": "CAG", "text": "οὐδὲ γὰρ ἀντιστρέφει·", "seq": 863}
{"id": "David_Passim_0864", "series": "CAG", "text": "εἴ τι μὲν γὰρ φωνή, τοῦτο πληγὴ ἀέρος, οὐκ εἴ τι δὲ πληγὴ ἀέρος, τοῦτο φωνή·", "seq": 864}
{"id": "David_Passim_0865", "series": "CAG", "text": "καὶ γὰρ ἐὰν ἐρίῳ πλήξω τὸν ἀέρα, οὐκ ἀποτελεῖ φωνήν.", "seq": 865}
{"id": "David_Passim_0866", "series": "CAG", "text": "θέλουσι δὲ οἱ εὖ ἔχοντες ὅροι ἀντιστρέφειν, ὡς ἐμάθομεν.", "seq": 866}
{"id": "David_Passim_0867", "series": "CAG", "text": "ὁρίζονται δὲ τὴν φωνὴν οὕτως·", "seq": 867}
{"id": "David_Passim_0868", "series": "CAG", "text": "φωνή ἐστιν ἀποτέλεσμα τοῦ ἐν ἡμῖν ἀποτεθησαυρισμένου πνεύματος διοδευομένη διὰ τραχείας ἀρτηρίας καὶ εἰδοποιουμένη διὰ γλώττης καὶ ἐπιγλωττίδος.", "seq": 868}
{"id": "David_Passim_0869", "series": "CAG", "text": "ἔτι δὲ διὰ τοῦτο εἶπε τὴν φιλοσοφίαν τέχνην τεχνῶν καὶ ἐπιστήμην ἐπιστημῶν, ἐπειδὴ αἱ τέχναι καὶ αἱ ἐπιστῆμαι κέχρηνται καὶ ὅροις καὶ διαιρέσεσι καὶ ἀποδείξεσι·", "seq": 869}
{"id": "David_Passim_0870", "series": "CAG", "text": "μήτηρ δὲ τούτων ἡ φιλοσοφία ἐστίν.", "seq": 870}
{"id": "David_Passim_0871", "series": "CAG", "text": "ἐν οἷς ἡ πρᾶξις.", "seq": 871}
{"id": "David_Passim_0872", "series": "CAG", "text": "Πρᾶξις ιδ΄.", "seq": 872}
{"id": "David_Passim_0873", "series": "CAG", "text": "Ἐπειδὴ ἀνωτέρω ὅλον ὡς ὅλον τὸν ὁρισμὸν μεμαθήκαμεν, ἔλθωμεν καὶ τὰ μέρη αὐτοῦ πολυπραγμονήσωμεν.", "seq": 873}
{"id": "David_Passim_0874", "series": "CAG", "text": "ἰστέον δὲ ὅτι φασί τινες ὡς ὅτι κακῶς τὴν φιλοσοφίαν τέχνην τεχνῶν εἴπατε εἶναι·", "seq": 874}
{"id": "David_Passim_0875", "series": "CAG", "text": "εἰ γὰρ τέχνη τεχνῶν ἐστι, δῆλον ὅτι καὶ τέχνη ἐστίν·", "seq": 875}
{"id": "David_Passim_0876", "series": "CAG", "text": "εἰ δὲ τέχνη ἐστί, δῆλον ὅτι πταιστή ἐστιν, ὅπερ ἄτοπον.", "seq": 876}
{"id": "David_Passim_0877", "series": "CAG", "text": "πρὸς οὓς ἔστιν εἰπεῖν ὅτι οὐ πάντως τὰ ἅμα λεγόμενα καὶ ἰδίᾳ λέγεται·", "seq": 877}
{"id": "David_Passim_0878", "series": "CAG", "text": "ἰδοὺ γὰρ λέγεται νεκρὸς ἄνθρωπος, καὶ οὐ δύναται λέγεσθαι ἄνθρωπος, διότι οὐκ ἔχει τὰ ἴδια τοῦ ἀνθρώπου·", "seq": 878}
{"id": "David_Passim_0879", "series": "CAG", "text": "οὔτε γὰρ ἔμψυχός ἐστιν οὔτε αἰσθητικός.", "seq": 879}
{"id": "David_Passim_0880", "series": "CAG", "text": "καὶ πάλιν λέγεται λιθίνη ναῦς, καὶ οὐ λέγεται μόνον ναῦς, διότι οὐ νήχεται ὥσπερ ἡ ναῦς.", "seq": 880}
{"id": "David_Passim_0881", "series": "CAG", "text": "καὶ πάλιν ὡς ἐπὶ τοῦ γρίφου ἤγουν τοῦ αἰνίγματος τοῦ λέγοντος ‘ἄνθρωπος οὐκ ἄνθρωπος, ἄνθρωπος δὲ ὅμως, ὄρνιν οὐκ ὄρνιν, ὄρνιν δ᾿ ὅμως, ἐπὶ ξύλου καὶ οὐ ξύλου καθημένην λίθῳ τε καὶ οὐ λίθῳ βαλὼν διώλεσε’·", "seq": 881}
{"id": "David_Passim_0882", "series": "CAG", "text": "λέγει δὲ ὅτι εὐνοῦχος νυκτερίδα καθημένην ἐν νάρθηκι ῥίψας κίσσηριν ἐφόνευσε.", "seq": 882}
{"id": "David_Passim_0883", "series": "CAG", "text": "καὶ ἄνθρωπον μὲν οὐκ ἄνθρωπον ἐκάλεσε τὸν εὐνοῦχον, ἄνθρωπον μέν, διότι ἐπιδέχεται τὸν ὅρον τοῦ ἀνθρώπου (καὶ αὐτὸς γὰρ ζῷον λογικὸν θνητὸν νοῦ καὶ ἐπιστήμης δεκτικόν ἐστιν), οὐκ ἄνθρωπον δέ, διότι οὐ γεννᾷ ὅμοιον ἑαυτῷ ὥσπερ ὁ τέλειος ἄνθρωπος.", "seq": 883}
{"id": "David_Passim_0884", "series": "CAG", "text": "ὄρνιν οὐκ ὄρνιν τὴν νυκτερίδα ἐκάλεσεν, ὄρνιν μέν, διότι ἵπταται, οὐκ ὄρνιν δέ, διότι οὐκ ᾠοτοκεῖ ὥσπερ τὰ ἄλλα ὄρνεα ἀλλὰ ζῳοτοκεῖ, καὶ πάλιν ἡ νυκτερὶς σάρκινα πτερὰ ἔχει, ὅπερ τοῖς ἄλλοις ὀρνέοις οὐ παρέπεται.", "seq": 884}
{"id": "David_Passim_0885", "series": "CAG", "text": "ξύλον δὲ καὶ οὐ ξύλον τὸν νάρθηκα ἐκάλεσε, ξύλον μέν, διότι ξυλοειδές ἐστιν, οὐ ξύλον δέ, διότι οὐκ ἔστι στερέμνιον ὥσπερ τὰ ἄλλα ξύλα.", "seq": 885}
{"id": "David_Passim_0886", "series": "CAG", "text": "λίθον δὲ καὶ οὐ λίθον τὴν κίσσηριν εἶπε, λίθον μέν, διότι λιθοειδές ἐστιν, οὐ λίθον δέ, διότι οὐκ ἔστι στερρά, ὥσπερ οἱ ἄλλοι λίθοι, ἀλλὰ σομφώδης, ἤγουν χαῦνόν τί ἐστιν.", "seq": 886}
{"id": "David_Passim_0887", "series": "CAG", "text": "ὡς οὖν εἴρηται, οὐ πάντως τὰ ἅμα λεγόμενα καὶ ἰδίᾳ λέγονται, ὥσπερ καὶ ἐκ τοῦ ἐναντίου οὐ πάντως τὰ ἰδίᾳ λεγόμενα καὶ ἅμα δύνανται λέγεσθαι·", "seq": 887}
{"id": "David_Passim_0888", "series": "CAG", "text": "ὑποκείσθω γάρ τις Σίμων τὴν τέχνην σκυτεὺς καὶ τοὺς μὲν τρόπους ἀγαθὸς τὴν δὲ τέχνην φαῦλος·", "seq": 888}
{"id": "David_Passim_0889", "series": "CAG", "text": "ἐπὶ τούτου τὰ ἰδίᾳ λεγόμενα καὶ ἅμα οὐ δύναται λέγεσθαι·", "seq": 889}
{"id": "David_Passim_0890", "series": "CAG", "text": "οἷόν τι λέγω ‘Σίμων σκυτεύς ἐστι’, καὶ πάλιν ‘Σίμων ἀγαθός ἐστιν’, οὐ δύναμαι δὲ ταῦτα ἅμα εἰπεῖν πάντα, οἷον ‘Σίμων σκυτεὺς ἀγαθός ἐστιν’, ἐπεὶ εὑρίσκεται ἀγαθός ἐπὶ τοῦ σκυτέως, ὅπερ ἄτοπον·", "seq": 890}
{"id": "David_Passim_0891", "series": "CAG", "text": "ὑπεθέμεθα γὰρ αὐτὸν κατὰ τὴν τέχνην φαῦλον.", "seq": 891}
{"id": "David_Passim_0892", "series": "CAG", "text": "ὥστε οὖν ὁ εἰπὼν τέχνην τεχνῶν τὴν φιλοσοφίαν οὐκ εἶπεν αὐτὴν τέχνην·", "seq": 892}
{"id": "David_Passim_0893", "series": "CAG", "text": "ὡς γὰρ εἴρηται, οὐ πάντως τὰ ἅμα λεγόμενα καὶ ἰδίᾳ λέγονται.", "seq": 893}
{"id": "David_Passim_0894", "series": "CAG", "text": "ἄλλως τε δὲ εἰ καὶ τέχνην αὐτὴν εἶπεν, οὐδὲν ἄτοπον·", "seq": 894}
{"id": "David_Passim_0895", "series": "CAG", "text": "πολλάκις γὰρ τὸ τῆς τέχνης ὄνομα καὶ ἐπὶ τῆς ἐπιστήμης λαμβάνεται·", "seq": 895}
{"id": "David_Passim_0896", "series": "CAG", "text": "καὶ γὰρ ὁ Πλάτων ἐν τῷ Γοργίᾳ τῷ διαλόγῳ τὴν ἐπιστήμην τέχνην ἐκάλεσε·", "seq": 896}
{"id": "David_Passim_0897", "series": "CAG", "text": "φησὶ γὰρ ‘τίνος σε φῶμεν τέχνης ἐπιστήμονα;’", "seq": 897}
{"id": "David_Passim_0898", "series": "CAG", "text": "ἀντὶ τοῦ ἐπιστήμης·", "seq": 898}
{"id": "David_Passim_0899", "series": "CAG", "text": "ὁ γὰρ ἐπιστήμων ἐπιστήμης ἐστὶν ἐπιστήμων.", "seq": 899}
{"id": "David_Passim_0900", "series": "CAG", "text": "ἐν δὲ τῷ Σοφιστῇ τῷ διαλόγῳ τὸν δημιουργὸν τεχνίτην ἐκάλεσε, καὶ ταῦτα πάντα ἀπταίστως γινώσκοντα.", "seq": 900}
{"id": "David_Passim_0901", "series": "CAG", "text": "ἔτι δὲ εἰ ἄρα οὗτος ὁ ὅρος ἐκ τῆς ὑπεροχῆς ἐστιν, ὁ δὲ ὑπερέχων οὐκ ἔστι ταὐτὸν τῷ ὑπερεχομένῳ ἀλλὰ κρείττων, δῆλον ὅτι καὶ ἡ φιλοσοφία ὡς ὑπερέχουσα τῆς τέχνης οὐκ ἔστι ταὐτὸν τῇ τέχνῃ.", "seq": 901}
{"id": "David_Passim_0902", "series": "CAG", "text": "ταῦτα μὲν ἐν τούτοις.", "seq": 902}
{"id": "David_Passim_0903", "series": "CAG", "text": "λέγουσι δέ τινες·", "seq": 903}
{"id": "David_Passim_0904", "series": "CAG", "text": "διὰ τί τὴν φιλοσοφίαν ἐπιστήμην ἐπιστημῶν ἐκάλεσε;", "seq": 904}
{"id": "David_Passim_0905", "series": "CAG", "text": "τί γάρ;", "seq": 905}
{"id": "David_Passim_0906", "series": "CAG", "text": "ἔστιν ἄλλη ἐπιστήμη παρὰ ταύτην;", "seq": 906}
{"id": "David_Passim_0907", "series": "CAG", "text": "καὶ ἔστιν εἰπεῖν ὅτι διττή ἐστιν ἡ ἐπιστήμη, ἡ μὲν ἐνυπόθετος ἡ δὲ ἀνυπόθετος.", "seq": 907}
{"id": "David_Passim_0908", "series": "CAG", "text": "καὶ ἐνυπόθετος μέν ἐστιν ἡ λαμβάνουσα ἀρχὰς δεομένας ἀποδείξεων καὶ ὧν τὴν αἰτίαν ἀγνοεῖ, οἷον ὡς ὅταν ὁ γεωμέτρης λάβῃ ὁμολογούμενον ὅτι τὸ σημεῖον ἀμερές ἐστι, καὶ τούτου τὴν αἰτίαν οὐκ οἶδεν ἀλλὰ παραπέμπει τῷ φυσικῷ φιλοσόφῳ.", "seq": 908}
{"id": "David_Passim_0909", "series": "CAG", "text": "ἀνυπόθετος δέ ἐστιν ἡ λαμβάνουσα κοινὰς ἐννοίας μὴ δεομένας ἀποδείξεων, οἷον ὡς ὅταν εἴπωμεν ὅτι ὁ θεὸς ἀγαθός ἐστιν·", "seq": 909}
{"id": "David_Passim_0910", "series": "CAG", "text": "αὕτη γὰρ κοινὴ ἔννοιά ἐστι·", "seq": 910}
{"id": "David_Passim_0911", "series": "CAG", "text": "πᾶς γὰρ ὁμολογεῖ ὅτι ὁ θεὸς ἀγαθός ἐστι καὶ οὐ δέεται τοῦτο ἀποδείξεως.", "seq": 911}
{"id": "David_Passim_0912", "series": "CAG", "text": "ταῦτα μὲν ἐν τούτοις.", "seq": 912}
{"id": "David_Passim_0913", "series": "CAG", "text": "Ἐπειδὴ δὲ τέχνης καὶ ἐπιστήμης ἐποιησάμεθα μνήμην, ἔλθωμεν καὶ περὶ τούτων διαλάβωμεν.", "seq": 913}
{"id": "David_Passim_0914", "series": "CAG", "text": "ἀλλὰ πρὸ τούτου ὀλίγα τινὰ περὶ γνώσεως εἴπωμεν.", "seq": 914}
{"id": "David_Passim_0915", "series": "CAG", "text": "ἰστέον ὅτι ἡ γνῶσις ἢ μερική ἐστιν ἢ καθόλου καὶ ἢ μετὰ λόγου ἐστὶν ἢ ἄνευ λόγου, ὥστε ἐκ τούτων τέσσαρά τινα γίνεσθαι·", "seq": 915}
{"id": "David_Passim_0916", "series": "CAG", "text": "ἔστι γὰρ πεῖρα, ἐμπειρία, τέχνη, ἐπιστήμη.", "seq": 916}
{"id": "David_Passim_0917", "series": "CAG", "text": "καὶ πεῖρα μέν ἐστιν ἡ ἑνὸς πράγματος ἄλογος γνῶσις, οἷον ὡς ὅταν τις ἓν μόνον ἐπίσταται βοήθημα καὶ τούτῳ κέχρηται μὴ γινώσκων τὴν αἰτίαν μηδὲ τὸ πῶς ὤφειλε χρήσασθαι αὐτῷ.", "seq": 917}
{"id": "David_Passim_0918", "series": "CAG", "text": "ἐμπειρία δέ ἐστιν ἡ τῶν καθόλου ἄλογος γνῶσις, οἷον ὡς ἐπὶ τῶν ἐμπειρικῶν ἰατρῶν·", "seq": 918}
{"id": "David_Passim_0919", "series": "CAG", "text": "οὗτοι γὰρ πολλὰ βοηθήματα γινώσκουσι, τὴν δὲ αἰτίαν οὐ γινώσκουσιν.", "seq": 919}
{"id": "David_Passim_0920", "series": "CAG", "text": "ἐμπειρία οὖν ἐστι μνήμη καὶ τήρησις ἄλογος ἀνθρωπίνη τῶν πολλάκις καὶ ὡσαύτως ὀφθέντων·", "seq": 920}
{"id": "David_Passim_0921", "series": "CAG", "text": "ὁ γὰρ ἐμπειρικὸς ἰατρὸς μνημονεύων καὶ τηρῶν τὰ πολλάκις καὶ ὡσαύτως ὀφθέντα κέχρηται τοῖς βοηθήμασι.", "seq": 921}
{"id": "David_Passim_0922", "series": "CAG", "text": "τέχνη δέ ἐστιν ἡ τῶν καθόλου γνῶσις μετὰ λόγου, ἢ τέχνη ἐστὶν ἕξις ὁδῷ βαδίζουσα μετὰ φαντασίας·", "seq": 922}
{"id": "David_Passim_0923", "series": "CAG", "text": "καὶ γὰρ ἡ τέχνη ἕξις τις καὶ γνῶσίς ἐστιν, ἀλλὰ καὶ ὁδῷ βαδίζει·", "seq": 923}
{"id": "David_Passim_0924", "series": "CAG", "text": "πάντα γὰρ κατὰ τάξιν ποιεῖ.", "seq": 924}
{"id": "David_Passim_0925", "series": "CAG", "text": "μετὰ φαντασίας δὲ πρόσκειται διὰ τὴν φύσιν·", "seq": 925}
{"id": "David_Passim_0926", "series": "CAG", "text": "καὶ γὰρ ἡ φύσις ἕξις ἐστίν (ἔχει γὰρ τὸ εἶναι ἐν τοῖς ἔχουσιν αὐτήν, οἷον ἐν ἀνθρώπῳ, ἐν λίθῳ, ἐν ξύλῳ) καὶ ὁδῷ βαδίζει (κατὰ γὰρ τάξιν προέρχεται), ἀλλ᾿ οὐ μετὰ φαντασίας ὥσπερ ἡ τέχνη·", "seq": 926}
{"id": "David_Passim_0927", "series": "CAG", "text": "καὶ γὰρ ὁ τεχνίτης κεχρημένος τῷ λόγῳ, ἡνίκα βούλεται τι ποιῆσαι, πρότερον διατυποῖ ἐν ἑαυτῷ ὃ βούλεται ποιῆσαι καὶ εἶθ᾿ οὕτως ἀποτελεῖ αὐτό, ἡ δὲ φύσις οὐδὲν τοιοῦτον ποιεῖ·", "seq": 927}
{"id": "David_Passim_0928", "series": "CAG", "text": "οὐδὲ γὰρ προδιατυποῖ ἐν ἑαυτῇ ὃ βούλεται κατασκευάσαι.", "seq": 928}
{"id": "David_Passim_0929", "series": "CAG", "text": "ἢ πάλιν τέχνη ἐστὶ σύστημα ἐκ καταλήψεων ἐμπειρίᾳ συγγεγυμνασμένη πρός τι τέλος εὔχρηστον τῶν ἐν τῷ βίῳ.", "seq": 929}
{"id": "David_Passim_0930", "series": "CAG", "text": "ἡ δὲ σαφήνεια τοῦ ὅρου τοῦτον ἔχει τὸν τρόπον·", "seq": 930}
{"id": "David_Passim_0931", "series": "CAG", "text": "τέχνη ἐστὶ ‘σύστημα ἐκ καταλήψεων’, τοῦτ᾿ ἔστιν ἄθροισμα ἐξ ἐφευρέσεων (καὶ γὰρ τῶν μὲν τόδε ἐφευρηκότων τῶν δὲ τόδε ἀπετελέσθη ἡ τέχνη), ‘ἐμπειρίᾳ συγγεγυμνασμένη’, τοῦτ᾿ ἔστι δεδοκιμασμένη μετὰ πολυπειρίας (καὶ γὰρ μετὰ πολυπειρίας δοκιμάζονται τὰ θεωρήματα καὶ οὕτως ἀνατιθέασιν αὐτὰ τῇ τέχνῃ), ‘πρός τι τέλος εὔχρηστον τῶν ἐν τῷ βίῳ’ πρόσκειται διὰ τὰς ματαιοτεχνίας καὶ κακοτεχνίας·", "seq": 931}
{"id": "David_Passim_0932", "series": "CAG", "text": "αὗται γὰρ οὐκ εὐχρηστοῦσι τῷ βίῳ.", "seq": 932}
{"id": "David_Passim_0933", "series": "CAG", "text": "καὶ ματαιοτεχνία μέν ἐστιν ἡ μήτε ὠφελοῦσα τὸν βίον μήτε βλάπτουσα ὡς ἐπὶ τοῦ νευροβάτου καὶ τοῦ κοντοπαίκτου, κακοτεχνία δέ ἐστιν ἡ πρὸς τῷ μὴ ὠφελεῖν τὸν βίον καὶ βλάπτουσα ὡς ἐπὶ τῶν γοήτων·", "seq": 933}
{"id": "David_Passim_0934", "series": "CAG", "text": "οὗτοι γὰρ πρὸς οἷς οὐκ ὠφελοῦσι τὸν βίον ἀλλὰ καὶ βλάπτουσιν αὐτόν.", "seq": 934}
{"id": "David_Passim_0935", "series": "CAG", "text": "ταῦτα μὲν καὶ περὶ τῆς τέχνης.", "seq": 935}
{"id": "David_Passim_0936", "series": "CAG", "text": "ἐπιστήμη δέ ἐστιν ἡ τῶν καθόλου ἄπταιστος καὶ ἀμετακίνητος γνῶσις (ἀπταίστως γὰρ γινώσκει τὰ γινωσκόμενα), ἢ γνῶσις ἄπταιστος τῶν ὑποκειμένων αὐτῇ πραγμάτων, καθὸ ἔχουσι φύσεως·", "seq": 936}
{"id": "David_Passim_0937", "series": "CAG", "text": "ὡς γὰρ ἔχουσι φύσεως καὶ οἱονεὶ τὴν φύσιν τῶν ὑποκειμένων αὐτῇ πραγμάτων γινώσκει.", "seq": 937}
{"id": "David_Passim_0938", "series": "CAG", "text": "ταῦτα μὲν ἐν τούτοις περὶ τῆς ἐπιστήμης.", "seq": 938}
{"id": "David_Passim_0939", "series": "CAG", "text": "Ἀποροῦσι δέ τινες λέγοντες·", "seq": 939}
{"id": "David_Passim_0940", "series": "CAG", "text": "εἰ ἄρα καὶ ἡ τέχνη μετὰ λόγου πάντα ποιεῖ καὶ ἡ ἐπιστήμη μετὰ λόγου πάντα ποιεῖ, κατὰ τί διαφέρουσιν ἀλλήλων;", "seq": 940}
{"id": "David_Passim_0941", "series": "CAG", "text": "καὶ λέγουσί τινες ὅτι διαφέρει ἡ ἐπιστήμη τῆς τέχνης, καθὸ ἡ μὲν ἐπιστήμη ἄπταιστός ἐστιν ἡ δὲ τέχνη πταιστή.", "seq": 941}
{"id": "David_Passim_0942", "series": "CAG", "text": "πρὸς οὓς ἔστιν εἰπεῖν ὅτι κακῶς λέγετε·", "seq": 942}
{"id": "David_Passim_0943", "series": "CAG", "text": "καὶ γὰρ ἡ τέχνη κατὰ τοὺς οἰκείους λόγους ἄπταιστός ἐστιν, ἀλλὰ παρὰ τὴν τοῦ ὑποκειμένου αἰτίαν δοκεῖ πταιστὴ εἶναι, ὡς μετ᾿ ὀλίγον δείξομεν.", "seq": 943}
{"id": "David_Passim_0944", "series": "CAG", "text": "ἔστιν οὖν εἰπεῖν ὅτι διαφέρει ἡ ἐπιστήμη τῆς τέχνης κατὰ τὸ ὑποκείμενον·", "seq": 944}
{"id": "David_Passim_0945", "series": "CAG", "text": "καὶ γὰρ ἡ μὲν τέχνη περὶ τὰ ῥευστὰ καταγίνεται καὶ μὴ ἀεὶ ὡσαύτως ἔχοντα·", "seq": 945}
{"id": "David_Passim_0946", "series": "CAG", "text": "οἷον ἡ ἰατρικὴ περὶ τὰ ἀνθρώπεια σώματα καταγίνεται, ἅτινα ῥευστά εἰσι καὶ οὐκ ἀεὶ ὡσαύτως ἔχουσι.", "seq": 946}
{"id": "David_Passim_0947", "series": "CAG", "text": "καὶ πάλιν ἡ γραμματικὴ περὶ λέξεις καταγίνεται, αἵτινες οὐκ ἀεὶ ὡσαύτως ἔχουσι·", "seq": 947}
{"id": "David_Passim_0948", "series": "CAG", "text": "καὶ γὰρ αἱ λέξεις ἄλλοτε ἄλλως ἔχουσι·", "seq": 948}
{"id": "David_Passim_0949", "series": "CAG", "text": "ποτὲ μὲν γὰρ τοιῶσδέ εἰσιν εἰσφερόμεναι ποτὲ δὲ τοιῶσδε.", "seq": 949}
{"id": "David_Passim_0950", "series": "CAG", "text": "ὅθεν νομίζονται αἱ τέχναι πταισταὶ εἶναι.", "seq": 950}
{"id": "David_Passim_0951", "series": "CAG", "text": "τοῦτο δὲ γίνεται παρὰ τὴν τοῦ ὑποκειμένου αἰτίαν·", "seq": 951}
{"id": "David_Passim_0952", "series": "CAG", "text": "καὶ γὰρ τοῦ ὑποκειμένου ῥευστοῦ ὄντος καὶ ἄλλοτε ἄλλως ἔχοντος γίνεται ἀποτυχία καὶ νομίζεται ἡ τέχνη πταιστὴ εἶναι.", "seq": 952}
{"id": "David_Passim_0953", "series": "CAG", "text": "οἷον τοῦ ἰατροῦ βουλομένου δοῦναί τινι καθάρσιον ἐν δέοντι καιρῷ ἐξαίφνης ἐτράπη τὸ κατάστημα τοῦ ἀέρος καὶ τὸ ὑποκείμενον ῥευστὸν ὂν ἄλλως ἔσχε, καὶ δεδωκότος τοῦ ἰατροῦ τὸ καθάρσιον οὐδὲν ὠφελήθη ὁ κάμνων διὰ τὸ στέγνωσιν γενέσθαι περὶ τὴν ἐπιφάνειαν καὶ μὴ γενέσθαι ἔκκρισιν δι᾿ ἱδρώτων.", "seq": 953}
{"id": "David_Passim_0954", "series": "CAG", "text": "καὶ ὅσον μὲν κατὰ τοὺς λόγους τῆς ἰατρικῆς ὠφελεῖτο πάντως ὁ κάμνων, ἀλλ᾿ ἐπειδὴ τὸ ὑποκείμενον ῥευστόν ἐστι καὶ ἄλλως ἔσχε, τούτου χάριν ἐγένετο ἡ ἀποτυχία.", "seq": 954}
{"id": "David_Passim_0955", "series": "CAG", "text": "ἡ δὲ ἐπιστήμη περὶ τὰ ἀεὶ ὡσαύτως ἔχοντα καταγίνεται·", "seq": 955}
{"id": "David_Passim_0956", "series": "CAG", "text": "διαλαμβάνει γὰρ περὶ τοῦ καθόλου ἀνθρώπου καὶ περὶ τοῦ καθόλου ἵππου, ἅτινα ἀεὶ ὡσαύτως ἔχουσι·", "seq": 956}
{"id": "David_Passim_0957", "series": "CAG", "text": "κατὰ τοῦτο οὖν διαφέρει ἡ ἐπιστήμη τῆς τέχνης, καὶ ὅτι ἡ μὲν ἐπιστήμη ἀεὶ τῷ λόγῳ κέχρηται (καὶ γὰρ ἡ ἀστρονομία λόγῳ μόνῳ κατορθοῦται), ἡ δὲ τέχνη ἢ ἔργῳ μόνῳ κέχρηται, ὡς ἐπὶ τῆς ζωγραφικῆς (ὁ γὰρ ζωγράφος ἔργῳ μόνῳ κέχρηται·", "seq": 957}
{"id": "David_Passim_0958", "series": "CAG", "text": "δύναται γὰρ καὶ μὴ λαλῶν ζωγραφῆσαι), ἢ ἐπίσης καὶ ἔργῳ καὶ λόγῳ κέχρηται ὡς ἐπὶ τῆς κιθαρῳδίας (αὕτη γὰρ ἐπίσης καὶ ἔργῳ καὶ λόγῳ κέχρηται·", "seq": 958}
{"id": "David_Passim_0959", "series": "CAG", "text": "καὶ γὰρ κρούει ταῖς χερσὶ καὶ ᾄδει τῷ στόματι·", "seq": 959}
{"id": "David_Passim_0960", "series": "CAG", "text": "κιθαρῳδίαν δὲ εἶπον, οὐ μὴν κιθαριστικήν, ἐπειδὴ ἐκείνη μόνον κρούει ταῖς χερσίν, οὐ μὴν καὶ ᾄδει), ἢ μᾶλλον μὲν λόγῳ κέχρηται ἧττον δὲ ἔργῳ ὡς ἐπὶ τῆς γραμματικῆς (αὕτη γὰρ μᾶλλον μὲν λόγῳ κέχρηται ὡς ἐν τῷ ἐξηγεῖσθαι, ἧττον δὲ ἔργῳ ὡς ἐν τῷ ποιεῖν τόνους ἢ στιγμάς), ἢ μᾶλλον μὲν ἔργῳ κέχρηται ἧττον δὲ λόγῳ ὡς ἐπὶ τῆς ἰατρικῆς·", "seq": 960}
{"id": "David_Passim_0961", "series": "CAG", "text": "αὕτη γὰρ μᾶλλον μὲν ἔργῳ κέχρηται, ὡς ἡνίκα σφυγμολογεῖ καὶ προσφέρει βοηθήματα, ἧττον δὲ τῷ λόγῳ, ὡς ἡνίκα ἐρωτᾷ τὰ προκαταρκτικὰ αἴτια καὶ λέγει τὴν αἰτίαν τῆς νόσου.", "seq": 961}
{"id": "David_Passim_0962", "series": "CAG", "text": "ἐν οἷς σὺν θεῷ καὶ ἡ παροῦσα πρᾶξις.", "seq": 962}
{"id": "David_Passim_0963", "series": "CAG", "text": "Πρᾶξις ιεʹ.", "seq": 963}
{"id": "David_Passim_0964", "series": "CAG", "text": "Ἀρχὴ καὶ πέρας ἡμῖν γενέσθω ὁ Πυθαγόρας·", "seq": 964}
{"id": "David_Passim_0965", "series": "CAG", "text": "καὶ γὰρ τῷ ἀνδρὶ φίλιόν ἐστι τὸ εἰς ἑαυτὸν συννεύειν καὶ τὴν ἀρχὴν συνάπτειν τῷ πέρατι, ὥσπερ καὶ ὁ κύκλος·", "seq": 965}
{"id": "David_Passim_0966", "series": "CAG", "text": "καὶ γὰρ ἐν τῷ κύκλῳ συνημμένη ἐστὶν ἡ ἀρχὴ τῷ πέρατι.", "seq": 966}
{"id": "David_Passim_0967", "series": "CAG", "text": "οὕτως οὖν καὶ αὐτὸς καὶ ἀρχὴ καὶ πέρας ἡμῖν γέγονεν, ἀρχὴ μέν, διότι οἱ αὐτοῦ ὅροι ἐν τῇ ἀρχῇ προῆλθον οἱ λέγοντες ‘φιλοσοφία ἐστὶ γνῶσις τῶν ὄντων ᾗ ὄντα ἐστί’ καὶ πάλιν ‘γνῶσις θείων τε καὶ ἀνθρωπίνων πραγμάτων’, πέρας δέ, διότι πάλιν ὁ αὐτοῦ ὅρος ἐν τῷ πέρατι προῆλθεν ὁ λέγων ὅτι ‘φιλοσοφία ἐστὶ φιλία σοφίας’.", "seq": 967}
{"id": "David_Passim_0968", "series": "CAG", "text": "ἰστέον δὲ ὅτι λαμβάνονταί τινες τοῦ παρόντος ὅρου λέγοντες ὅτι οἱ εὖ ἔχοντες ὅροι ἀντιστρέφειν θέλουσιν, ὁ δὲ παρὼν ὅρος οὐκ ἀντιστρέφει·", "seq": 968}
{"id": "David_Passim_0969", "series": "CAG", "text": "εἴ τι μὲν γὰρ φιλοσοφία, τοῦτο φιλία σοφίας, οὐκ εἴ τι δὲ φιλία σοφίας, τοῦτο φιλοσοφία·", "seq": 969}
{"id": "David_Passim_0970", "series": "CAG", "text": "καὶ γὰρ πᾶσα τέχνη ἐφίεται τοῦ ἰδίου ὑποκειμένου.", "seq": 970}
{"id": "David_Passim_0971", "series": "CAG", "text": "ἔστιν οὖν εἰπεῖν ὅτι καλῶς ἔχει ὁ παρὼν ὅρος, ἐπειδὴ Πυθαγόρου ἐστί·", "seq": 971}
{"id": "David_Passim_0972", "series": "CAG", "text": "πρῶτος γὰρ ὁ Πυθαγόρας τὸ τῆς σοφίας ὄνομα φερόμενον καὶ ἐπὶ τῶν βαναύσων τεχνῶν, ὡς καὶ ὁ ποιητὴς δηλοῖ λέγων", "seq": 972}
{"id": "David_Passim_0973", "series": "CAG", "text": "ἐπεὶ σοφὸς ἤραρε τέκτων,", "seq": 973}
{"id": "David_Passim_0974", "series": "CAG", "text": "τὸ σοφός κατὰ τοῦ τέκτονος θείς, ἀφώρισεν ἐπὶ τῆς ἐν τῷ ὄντι γνώσεως·", "seq": 974}
{"id": "David_Passim_0975", "series": "CAG", "text": "πρῶτος γὰρ οὗτος σοφίαν ἐκάλεσε μόνην τὴν τοῦ ὄντος γνῶσιν ἤγουν τοῦ θείου·", "seq": 975}
{"id": "David_Passim_0976", "series": "CAG", "text": "κυρίως γὰρ ὄντα τὰ θεῖα λέγεται ὡς ἀεὶ ὑπάρχοντα·", "seq": 976}
{"id": "David_Passim_0977", "series": "CAG", "text": "ὂν γάρ ἐστι τὸ ἀεὶ ὡσαύτως ἔχον καὶ μηδέποτε ἐξιστάμενον.", "seq": 977}
{"id": "David_Passim_0978", "series": "CAG", "text": "τὴν ἔφεσιν οὖν τῆς σοφίας τοῦ ὄντος ἤγουν τοῦ θείου φιλοσοφίαν ἐκάλεσεν.", "seq": 978}
{"id": "David_Passim_0979", "series": "CAG", "text": "ἰστέον δὲ ὅτι καὶ μᾶλλον τὸ τῆς σοφίας ὄνομα κυρίως ἐπὶ τῶν θείων ὤφειλε λέγεσθαι, ἐπειδὴ σοφία λέγεται οἱονεὶ σαοφία τις οὖσα, τοῦτ᾿ ἔστιν ἡ τὸ φῶς σώζουσα·", "seq": 979}
{"id": "David_Passim_0980", "series": "CAG", "text": "καὶ γὰρ τὰ θεῖα ἄυλα ὄντα καὶ μὴ ὄντα δεκτικὰ τῶν ἐναντίων σώζουσι τὸ φῶς τῆς οἰκείας φύσεως, τὰ δὲ ἔνυλα ἤγουν τὰ τῇδε ὡς ὄντα δεκτικὰ τῶν ἐναντίων οὐ σώζουσι τὸ φῶς τῆς οἰκείας φύσεως ἀλλ᾿ ἐπισκοτίζονται διὰ τῶν ἐναντίων.", "seq": 980}
{"id": "David_Passim_0981", "series": "CAG", "text": "καὶ ἀποροῦσί τινες λέγοντες·", "seq": 981}
{"id": "David_Passim_0982", "series": "CAG", "text": "εἰ ἄρα τὰ θεῖα κατὰ τὴν φύσιν σαφῆ εἰσι, πῶς ἡμῖν ἀσαφῆ εἰσι;", "seq": 982}
{"id": "David_Passim_0983", "series": "CAG", "text": "καὶ ἔστιν εἰπεῖν ὅτι ὥσπερ ὁ ἥλιος φύσει φωτεινὸς ὢν ταῖς νυκτερίσι δοκεῖ ἀμυδρότερος διὰ τὸ ἀνεπιτήδειον τοῦ ὀργάνου, τοῦτ᾿ ἔστι διὰ τὸ ἐν ἡμέρᾳ μὴ καθορᾶν, τὸν αὐτὸν τρόπον καὶ τὰ θεῖα κατὰ τὴν φύσιν σαφῆ καὶ εἰλικρινῆ ὄντα ἡμῖν ἀσαφῆ εἰσι διὰ τὸ τὸ τῆς ψυχῆς ὄμμα ὑπὸ τῆς σωματικῆς ἀχλύος ἤγουν διὰ τῶν ἡδυπαθειῶν ἐπισκοτίζεσθαι.", "seq": 983}
{"id": "David_Passim_0984", "series": "CAG", "text": "ταῦτα μὲν ἐν τούτοις.", "seq": 984}
{"id": "David_Passim_0985", "series": "CAG", "text": "Ἰστέον δὲ ὅτι ἡ φιλοσοφία πολλοῖς ἀναβαθμοῖς κέχρηται·", "seq": 985}
{"id": "David_Passim_0986", "series": "CAG", "text": "καὶ γὰρ πολλοῖς ἀναβαθμοῖς κέχρηταί τις, ἵνα γνῷ τὴν φιλοσοφίαν·", "seq": 986}
{"id": "David_Passim_0987", "series": "CAG", "text": "θέλει γὰρ γινώσκειν τὰς πέντε γνωστικὰς δυνάμεις.", "seq": 987}
{"id": "David_Passim_0988", "series": "CAG", "text": "εἰσὶ δὲ αὗται·", "seq": 988}
{"id": "David_Passim_0989", "series": "CAG", "text": "αἴσθησις, φαντασία, δόξα, διάνοια καὶ νοῦς.", "seq": 989}
{"id": "David_Passim_0990", "series": "CAG", "text": "καὶ αἴσθησις μέν ἐστιν ἡ τοῦ παρόντος μερικὴ γνῶσις·", "seq": 990}
{"id": "David_Passim_0991", "series": "CAG", "text": "καὶ γὰρ ἡ αἴσθησις τοῦ παρόντος ἀντιλαμβάνεται·", "seq": 991}
{"id": "David_Passim_0992", "series": "CAG", "text": "ἡ γὰρ ὅρασις εἰ μὴ θεωρήσῃ τι, οὐ δύναται ἀντιλαβέσθαι αὐτοῦ, καὶ πάλιν ἡ ἀκοὴ οὐ δύναται ψόφου ἀντιλαβέσθαι, εἰ μὴ πλησίον ᾖ ὁ ψόφος.", "seq": 992}
{"id": "David_Passim_0993", "series": "CAG", "text": "φαντασία δέ ἐστιν ἡ τοῦ ἀπόντος μερικὴ γνῶσις, οἷον ὡς ὅταν χθὲς θεωρήσας ἄνθρωπον σήμερον φαντασθῶ αὐτὸν ἤγουν ἀναπολήσω αὐτόν·", "seq": 993}
{"id": "David_Passim_0994", "series": "CAG", "text": "κατὰ τοῦτο γὰρ διαφέρει ἡ φαντασία τῆς ψιλῆς ἐπινοίας, ὅτι ἡ μὲν φαντασία τῶν ὄντων ἐστὶν ἀναπόλησις (καὶ γὰρ τὸ ὀφθὲν φαντάζεται καὶ ἀναπολεῖ τις), ἡ δὲ ψιλὴ ἐπίνοια τῶν μὴ ὄντων ἐστὶ διατύπωσις, ὡς ὅταν τις τραγέλαφον ἢ ἱπποκένταυρον ἀναπλάττηται·", "seq": 994}
{"id": "David_Passim_0995", "series": "CAG", "text": "ταῦτα γὰρ οὐκ εἰσίν.", "seq": 995}
{"id": "David_Passim_0996", "series": "CAG", "text": "ἡ δὲ δόξα διττή ἐστιν·", "seq": 996}
{"id": "David_Passim_0997", "series": "CAG", "text": "ἢ γὰρ μετὰ λόγου ἐστὶν ἢ ἄνευ λόγου, καὶ ἄνευ μὲν λόγου, ὡς ὅταν τις τὴν λογικὴν ψυχὴν δοξάζῃ ἀθάνατον εἶναι μὴ λέγων αἰτίαν, μετὰ λόγου δέ, ὡς ὅταν τις τὴν λογικὴν ψυχὴν δοξάζῃ ἀθάνατον εἶναι λέγων αἰτίαν.", "seq": 997}
{"id": "David_Passim_0998", "series": "CAG", "text": "καὶ ἰστέον ὅτι δόξα μετὰ λόγου ἐστὶ τὸ συμπέρασμα τῶν προτάσεων, οἷον ἡ ψυχὴ αὐτοκίνητος, τὸ αὐτοκίνητον ἀεικίνητον, τὸ ἀεικίνητον ἀθάνατον ὥσπερ ἄγγελος, ἡ ψυχὴ ἄρα ἀθάνατος.", "seq": 998}
{"id": "David_Passim_0999", "series": "CAG", "text": "ἰδοὺ τὸ συμπέρασμα τῶν προτάσεων, λέγω δὴ τὸ ‘ἡ ψυχὴ ἄρα ἀθάνατος’.", "seq": 999}
{"id": "David_Passim_1000", "series": "CAG", "text": "τοῦτο δέ, ὃ αἱ προτάσεις συνεπέραναν, δόξα μετὰ λόγου λέγεται.", "seq": 1000}
{"id": "David_Passim_1001", "series": "CAG", "text": "διάνοια δέ ἐστιν ἡ τῶν καθόλου μετὰ λόγου γνῶσις·", "seq": 1001}
{"id": "David_Passim_1002", "series": "CAG", "text": "κατὰ τοῦτο γὰρ διαφέρει ἡ διάνοια τῆς μετὰ λόγου δόξης, ὅτι ἡ μὲν μετὰ λόγου δόξα συμπέρασμά ἐστιν, ὡς εἴρηται, τῶν προτάσεων, ἡ δὲ διάνοια λαμβάνουσα τὰς προτάσεις ὁμολογουμένας κατασκευάζει τὸ ζητούμενον·", "seq": 1002}
{"id": "David_Passim_1003", "series": "CAG", "text": "λαμβάνουσα γὰρ ὁμολογούμενον ὅτι ἡ ψυχὴ αὐτοκίνητός ἐστι καὶ ὅτι τὸ αὐτοκίνητον ἀεικίνητον καὶ ὅτι εἴ τι ἀεικίνητον, ἀθάνατον, κατασκευάζει ἐκ τούτου τὸ ζητούμενον, φημὶ δὲ τὸ ὅτι ἡ ψυχὴ ἀθάνατός ἐστιν.", "seq": 1003}
{"id": "David_Passim_1004", "series": "CAG", "text": "ὁ δὲ νοῦς ἁπλῇ προσβολῇ, τοῦτ᾿ ἔστιν εὐθέως καὶ κατ᾿ αὐτὸν [ἄνευ λόγου] τὸν χρόνον, πάντα τὰ ὑποπίπτοντα αὐτῷ γινώσκει, τοῦτ᾿ ἔστι τὰ νοητά.", "seq": 1004}
{"id": "David_Passim_1005", "series": "CAG", "text": "τούτων οὖν οὕτως ἐχόντων ἐκ μὲν τῆς αἰσθήσεως καὶ τῆς φαντασίας ἐγείρεται ἡ πεῖρα (καὶ γὰρ καὶ αὕτη μερική ἐστι γνῶσις), ἐκ δὲ τῆς ἄνευ λόγου δόξης ἐγείρεται ἡ ἐμπειρία·", "seq": 1005}
{"id": "David_Passim_1006", "series": "CAG", "text": "καὶ γὰρ καὶ αὕτη ἄνευ λόγου γινώσκει τὰ γινωσκόμενα ὥσπερ καὶ ἡ δόξα ἡ ἄλογος.", "seq": 1006}
{"id": "David_Passim_1007", "series": "CAG", "text": "καὶ μὴν καὶ ἐκ τῆς αἰσθήσεως καὶ τῆς φαντασίας ἐγείρεται ἡ ἐμπειρία·", "seq": 1007}
{"id": "David_Passim_1008", "series": "CAG", "text": "καὶ γὰρ ἐκ τῶν μερικῶν συνίσταται·", "seq": 1008}
{"id": "David_Passim_1009", "series": "CAG", "text": "δοκιμάζοντες γὰρ ἓν καὶ ἕκαστον τῶν βοηθημάτων καὶ φανταζόμενοι αὐτὰ ἀλόγως ἤγουν ἀναπολοῦντες αὐτὰ ἀποτελοῦνται ἐμπειρικοί.", "seq": 1009}
{"id": "David_Passim_1010", "series": "CAG", "text": "ἰστέον ὅτι ἡνίκα μὲν ἐκ τῆς αἰσθήσεως καὶ τῆς φαντασίας ἐγείρεται ἡ ἐμπειρία, τότε αὐτοψία λέγεται (καὶ γὰρ αὐτόπτης ἐγένετο ὁ ἐμπειρικὸς τῆς φύσεως τῶν βοηθημάτων καὶ αὐτὸς διὰ τῆς αἰσθήσεως καὶ τῆς φαντασίας βασανίσας ἕκαστον τῶν βοηθημάτων ἔγνω τὴν φύσιν αὐτῶν), ἡνίκα δὲ ἐκ τῆς δόξης τῆς ἀλόγου ἐγείρεται ἡ ἐμπειρία, καλεῖται ἱστορία, ὡς ὅταν <τις> νομίσῃ τὴν φύσιν τοῦδε τοῦ βοηθήματος τοιάνδε εἶναι, οὐ πειραθεὶς αὐτὸς ἀλλ᾿ ἀπ᾿ ἄλλων ἀκούσας καὶ τοῦτο δοξάσας.", "seq": 1010}
{"id": "David_Passim_1011", "series": "CAG", "text": "ἡ δὲ τέχνη ἐγείρεται ἔκ τε τῆς μετὰ λόγου δόξης καὶ τῆς διανοίας·", "seq": 1011}
{"id": "David_Passim_1012", "series": "CAG", "text": "καὶ γὰρ καὶ αὕτη ὁμοίως αὐταῖς τὰ καθόλου μετὰ λόγου γινώσκει.", "seq": 1012}
{"id": "David_Passim_1013", "series": "CAG", "text": "ἡ δὲ ἐπιστήμη ἐγείρεται ἔκ τε τῆς διανοίας καὶ τοῦ νοῦ·", "seq": 1013}
{"id": "David_Passim_1014", "series": "CAG", "text": "ἡνίκα μὲν ἀρχὰς λαμβάνῃ δεομένας ἀποδείξεων, οἷον τὸ σημεῖον ἀμερές ἐστι (τοῦτο γὰρ ὡς δεόμενον ἀποδείξεως) ἐκ τῆς διανοίας ἐγείρεται, ἡνίκα δὲ ἢ ὅρους λαμβάνῃ ἢ κοινὰς ἐννοίας μὴ δεομένας ἀποδείξεων, οἷον ὅτι ὁ θεὸς φιλάνθρωπός ἐστι (τοῦτο γὰρ παρὰ πᾶσιν ὁμολογεῖται καὶ οὐ δέεται ἀποδείξεως), τότε ἐκ τοῦ νοῦ ἐγείρεται.", "seq": 1014}
{"id": "David_Passim_1015", "series": "CAG", "text": "ὥστε οὐ μόνον κατὰ τὰ λεχθέντα ἐν τῇ προτέρᾳ πράξει διαφέρει ἡ τέχνη τῆς ἐπιστήμης ἀλλὰ καὶ κατὰ τοῦτο, ὅτι ἡ μὲν τέχνη ἔκ τε τῆς δόξης τῆς μετὰ λόγου καὶ τῆς διανοίας ἐγείρεται, ἡ δὲ ἐπιστήμη ἔκ τε τῆς διανοίας καὶ τοῦ νοῦ.", "seq": 1015}
{"id": "David_Passim_1016", "series": "CAG", "text": "δέδεικται οὖν διὰ τούτων τῶν προλεχθέντων ὅτι πολλοῖς ἀναβαθμοῖς κέχρηται ἡ φιλοσοφία καὶ ὅτι κάλλιστον πάντων ἐστὶν ἡ φιλοσοφία, ὡς καὶ ὁ Πλάτων πρός τινα Θεόδωρον γεωμέτρην ποιούμενος τὸν λόγον δηλοῖ λέγων ὅτι ‘τοιοῦτόν τι, ὦ Θεόδωρε, οὔτε ἧκέ ποτε εἰς ἀνθρώπους οὔτε ἥξει ποτὲ δωρηθὲν ἐκ θεοῦ’.", "seq": 1016}
{"id": "David_Passim_1017", "series": "CAG", "text": "Τούτων οὕτως ἐχόντων ἔγνωμεν ὅτι ἕξ εἰσιν ὁρισμοὶ τῆς φιλοσοφίας καὶ τὴν αἰτίαν ἔγνωμεν.", "seq": 1017}
{"id": "David_Passim_1018", "series": "CAG", "text": "οὐ μόνον δὲ τοῦτο ἔγνωμεν, ἀλλ᾿ ὅτι καὶ τέσσαρές εἰσι διαφοραὶ τῶν ὁρισμῶν τῆς φιλοσοφίας·", "seq": 1018}
{"id": "David_Passim_1019", "series": "CAG", "text": "οἱ μὲν γὰρ ἀπὸ τοῦ ὑποκειμένου ἐλήφθησαν, οἷον ὁ λέγων ὅτι ‘φιλοσοφία ἐστὶ γνῶσις τῶν ὄντων ᾗ ὄντα ἐστί’ καὶ ὁ λέγων ὅτι ‘φιλοσοφία ἐστὶ γνῶσις θείων τε καὶ ἀνθρωπίνων πραγμάτων’, οἱ δὲ ἐκ τοῦ τέλους, ὁ λέγων ὅτι ‘φιλοσοφία ἐστὶ μελέτη θανάτου’ καὶ ὁ λέγων ὅτι ‘φιλοσοφία ἐστὶ ὁμοίωσις θεῷ κατὰ τὸ δυνατὸν ἀνθρώπῳ’, ὁ δὲ ἐκ τῆς ὑπεροχῆς ὁ λέγων ὅτι ‘φιλοσοφία ἐστὶ τέχνη τεχνῶν καὶ ἐπιστήμη ἐπιστημῶν’, ὁ δὲ ἐκ τῆς ἐτυμολογίας ὁ λέγων ὅτι ‘φιλοσοφία ἐστὶ φιλία σοφίας’.", "seq": 1019}
{"id": "David_Passim_1020", "series": "CAG", "text": "διὰ τοῦτο δὲ τέσσαρές εἰσι διαφοραὶ τῶν ὁρισμῶν τῆς φιλοσοφίας, ὅτι ὁ τέσσαρα ἀριθμὸς πάνυ ἦν τίμιος παρὰ τοῖς Πυθαγορείοις, ὡς καὶ αὐτοὶ ὀμνύοντες εἰς τὸν Πυθαγόραν δηλοῦσι λέγοντες ‘ναὶ μὰ τὸν ἁμετέραις ψυχαῖς παραδόντα τετρακτὺν παγὰν ἀεννάου φύσεως’, τοῦτ᾿ ἔστι ‘ναὶ μὰ τὸν Πυθαγόραν τὸν παραδόντα ἡμῖν τὸν τέσσαρα ἀριθμὸν τὴν πηγὴν τῆς ἀεννάου φύσεως’.", "seq": 1020}
{"id": "David_Passim_1021", "series": "CAG", "text": "πηγὴν δὲ τῆς ἀεννάου φύσεως ἐκάλεσε τὸν τέσσαρα ἀριθμόν, ἐπειδὴ ἐκ τῶν τεσσάρων στοιχείων συνίσταται τὰ ἡμέτερα σώματα (διὰ τοῦτο γὰρ ὁ τέσσαρα ἀριθμὸς πάνυ ἦν τίμιος παρὰ τοῖς Πυθαγορείοις), ἢ ἐπειδὴ καὶ τέσσαρά εἰσι τὰ στοιχεῖα, οἷον γῆ ὕδωρ ἀὴρ πῦρ, ἢ ἐπειδὴ καὶ τέσσαρές εἰσιν αἱ ἀρεταὶ τῆς ψυχῆς, οἷον ἀνδρία δικαιοσύνη σωφροσύνη φρόνησις, ἢ ἐπειδὴ ὁ τέσσαρα ἀριθμὸς συντιθέμενος μετὰ τῶν πρὸ αὐτοῦ ἀποτελεῖ τὸν δέκα ἀριθμόν·", "seq": 1021}
{"id": "David_Passim_1022", "series": "CAG", "text": "καὶ γὰρ προσλαμβάνων τὸν τρία ἀποτελεῖ τὸν ἑπτὰ ἀριθμόν, καὶ πάλιν προσλαμβάνων τὸν δύο ἀποτελεῖ τὸν ἐννέα, καὶ πάλιν προσλαμβάνων τὴν μονάδα ἀποτελεῖ τὸν δέκα.", "seq": 1022}
{"id": "David_Passim_1023", "series": "CAG", "text": "καὶ τὸν δέκα δὲ ἀριθμὸν τίμιον ἔλεγον, καθὸ ὁ δέκα ἀριθμὸς τῶν πρὸ αὐτοῦ ἀριθμῶν δεκτικός ἐστιν, ὅθεν καὶ δεκὰς λέγεται οἱονεὶ δεχάς τις οὖσα.", "seq": 1023}
{"id": "David_Passim_1024", "series": "CAG", "text": "ἐν οἷς σὺν θεῷ καὶ ἡ παροῦσα πρᾶξις.", "seq": 1024}
{"id": "David_Passim_1025", "series": "CAG", "text": "Πρᾶξις ις΄.", "seq": 1025}
{"id": "David_Passim_1026", "series": "CAG", "text": "Ἐπειδὴ ἐν τοῖς προλαβοῦσιν εἰρήκαμεν ἀριθμητικὴν αἰτίαν δεικνύουσαν διὰ τί ἕξ εἰσιν οἱ τῆς φιλοσοφίας ὁρισμοί, ἐντεῦθεν λαβόντες οἱ ἐξηγηταὶ ἀφορμὴν ἔρχονται καὶ διαλαμβάνουσι περὶ τῶν ἀριθμῶν τῶν ὄντων ἄχρι τῆς δεκάδος, καί φασιν ὅτι μονὰς λέγεται παρὰ τὸ μένειν·", "seq": 1026}
{"id": "David_Passim_1027", "series": "CAG", "text": "καὶ γὰρ ἡ μονὰς ἐφ᾿ ὃν ἂν γένηται ἀριθμὸν φυλάττει τὸ αὐτὸ εἶδος, οἷον τὰ ἅπαξ τρία τρία, ἅπαξ τέσσαρα τέσσαρα, ἅπαξ πέντε πέντε·", "seq": 1027}
{"id": "David_Passim_1028", "series": "CAG", "text": "ἰδοὺ ἐπὶ τούτων προσελθοῦσα ἡ μονὰς τὸ αὐτὸ εἶδος ἐφύλαξε καὶ οὐκ ἐποίησεν ἕτερον ἀριθμόν.", "seq": 1028}
{"id": "David_Passim_1029", "series": "CAG", "text": "εἰ δέ τις εἴποι ‘ἰδοὺ λέγω μία καὶ τέσσαρα, καὶ οὐκέτι φυλάττεται ὁ αὐτὸς ἀριθμὸς ἀλλὰ γίνεται ὁ πέντε’, λέγομεν ὅτι ἐνταῦθα σύνθεσις γέγονε καὶ τούτου χάριν οὐκ ἐφυλάχθη ὁ αὐτὸς ἀριθμός.", "seq": 1029}
{"id": "David_Passim_1030", "series": "CAG", "text": "τούτων οὖν οὕτως ἐχόντων λέγομεν ὅτι οὐκ ἔστιν ἡ μονὰς ἀριθμὸς ἀλλ᾿ ἀρχὴ ἀριθμοῦ.", "seq": 1030}
{"id": "David_Passim_1031", "series": "CAG", "text": "καὶ εἴ τις εἴποι ‘εἰ ἄρα ἀρχή ἐστιν ἀριθμοῦ, πῶς λέγετε αὐτὴν μὴ εἶναι ἀριθμόν;’", "seq": 1031}
{"id": "David_Passim_1032", "series": "CAG", "text": "λέγομεν ὅτι οὐ πάντως ἡ ἀρχή τινος ταὐτόν ἐστιν ἐκείνῳ οὗ τινος λέγεται εἶναι ἀρχή·", "seq": 1032}
{"id": "David_Passim_1033", "series": "CAG", "text": "καὶ γὰρ ἀρχὴ τοῦ οἴκου ὁ θεμέλιός ἐστι, καὶ οὐκ ἔστιν ὁ θεμέλιος οἶκος.", "seq": 1033}
{"id": "David_Passim_1034", "series": "CAG", "text": "οὕτως οὖν καὶ τὴν μονάδα ἐνδέχεται εἶναι ἀρχὴν ἀριθμοῦ καὶ μὴ εἶναι ἀριθμόν·", "seq": 1034}
{"id": "David_Passim_1035", "series": "CAG", "text": "ὅτι μὲν γὰρ οὐκ ἔστιν ἡ μονὰς ἀριθμός, δείκνυμεν ὀλίγα τινὰ προειπόντες.", "seq": 1035}
{"id": "David_Passim_1036", "series": "CAG", "text": "ἰστέον ὅτι ἡνίκα ἐν τοῖς ἀριθμοῖς τὴν ἐπί πρόθεσιν λέγομεν, πολυπλασιασμός ἐστιν, οἷον πέντε ἐπὶ πέντε εἰκοσιπέντε (ἀντὶ γὰρ τοῦ πεντάκις πέντε), καὶ πάλιν τρία ἐπὶ τρία ἐννέα (ἀντὶ γὰρ τοῦ τρὶς τρία), ἡνίκα δὲ ὁ καί σύνδεσμός ἐστιν, σύνθεσίς ἐστιν, οἷον τρία καὶ τρία ἕξ, τέσσαρα καὶ τέσσαρα ὀκτώ.", "seq": 1036}
{"id": "David_Passim_1037", "series": "CAG", "text": "τούτων οὖν οὕτως ἐχόντων οἱ ἀριθμοὶ πολυπλασιαζόμενοι ἐφ᾿ ἑαυτοὺς μείζονα ἀριθμὸν ἀποτελοῦσιν ἤπερ συντιθέμενοι ἑαυτοῖς, οἷον τρὶς τρία ἐννέα, τρία δὲ καὶ τρία ἕξ·", "seq": 1037}
{"id": "David_Passim_1038", "series": "CAG", "text": "ἰδοὺ δὴ πολυπλασιασθεὶς μὲν ὁ τρία τὸν ἐννέα ἀριθμὸν ἀπετέλεσε, συντεθεὶς δὲ τὸν ἕξ, ὁ δὲ ἐννέα μείζων ἐστὶ τοῦ ἕξ.", "seq": 1038}
{"id": "David_Passim_1039", "series": "CAG", "text": "καὶ πάλιν τετράκις τέσσαρα δεκαέξ, τέσσαρα δὲ καὶ τέσσαρα ὀκτώ.", "seq": 1039}
{"id": "David_Passim_1040", "series": "CAG", "text": "εἰ ἄρα οὖν ἡ μονὰς ἐκ τοῦ ἐναντίου συντιθεμένη μείζονα ἀριθμὸν ἀποτελεῖ ἤπερ πολυπλασιαζομένη, δῆλον ὅτι οὐκ ἔστιν ἀριθμός·", "seq": 1040}
{"id": "David_Passim_1041", "series": "CAG", "text": "καὶ γὰρ ἅπαξ μὲν μία μία ἐστίν, μία δὲ καὶ μία δύο.", "seq": 1041}
{"id": "David_Passim_1042", "series": "CAG", "text": "ταῦτα μὲν περὶ τῆς μονάδος.", "seq": 1042}
{"id": "David_Passim_1043", "series": "CAG", "text": "ἡ δὲ δυὰς λέγεται παρὰ τὸ διιέναι καὶ διαπορεύεσθαι·", "seq": 1043}
{"id": "David_Passim_1044", "series": "CAG", "text": "πρώτη γὰρ ἡ δυὰς διεχώρισεν ἑαυτὴν ἐκ τῆς μονάδος·", "seq": 1044}
{"id": "David_Passim_1045", "series": "CAG", "text": "καὶ γὰρ τῆς μονάδος ἕνωσιν δηλούσης πρώτη μετὰ τὴν μονάδα ἡ δυὰς ἐπεισῆλθεν διαχωρισμὸν δηλοῦσα.", "seq": 1045}
{"id": "David_Passim_1046", "series": "CAG", "text": "ἰστέον δὲ ὅτι οὐδὲ ἡ δυὰς κυρίως ἐστὶν ἀριθμός·", "seq": 1046}
{"id": "David_Passim_1047", "series": "CAG", "text": "καὶ γάρ, ὡς ἐμάθομεν, οἱ ἀριθμοὶ πολυπλασιαζόμενοι ἐφ᾿ ἑαυτοὺς μείζονα ἀριθμὸν ἀποτελοῦσιν ἤπερ συντιθέμενοι ἑαυτοῖς, ἡ δὲ δυὰς καὶ συντιθεμένη καὶ πολυπλασιαζομένη τὸν αὐτὸν ἀριθμὸν ἀποτελεῖ·", "seq": 1047}
{"id": "David_Passim_1048", "series": "CAG", "text": "δὶς γὰρ δύο τέσσαρα καὶ δύο καὶ δύο τέσσαρα·", "seq": 1048}
{"id": "David_Passim_1049", "series": "CAG", "text": "ἄρα οὖν οὐκ ἔστιν ἀριθμός.", "seq": 1049}
{"id": "David_Passim_1050", "series": "CAG", "text": "καὶ ἄλλως δὲ οὐκ ἔστιν ἀριθμὸς ἡ δυάς·", "seq": 1050}
{"id": "David_Passim_1051", "series": "CAG", "text": "πᾶς γὰρ ἄρτιος ἀριθμὸς ἀφαιρούμενος ἤτοι ἀποβάλλων μονάδα ποιεῖ περιττὸν καὶ πάλιν προσλαμβάνων μονάδα ποιεῖ περιττόν, οἷον ὁ τέσσαρα ἀποβάλλων μονάδα ποιεῖ τὸν τρία περιττὸν καὶ πάλιν προσλαμβάνων μονάδα ποιεῖ τὸν πέντε ὁμοίως περιττόν.", "seq": 1051}
{"id": "David_Passim_1052", "series": "CAG", "text": "εἰ οὖν ὁ δύο ἀριθμὸς προσλαμβάνων μὲν μονάδα ποιεῖ τὸν τρία περιττὸν ἀποβάλλων δὲ μονάδα οὐκέτι ποιεῖ περιττόν (ὁ γὰρ δύο ἀποβάλλων μονάδα τὸ ἓν ποιεῖ·", "seq": 1052}
{"id": "David_Passim_1053", "series": "CAG", "text": "ἡ δὲ μονὰς οὐκ ἔστιν ἀριθμός), ἄρα οὖν ὁ δύο οὐκ ἔστιν ἀριθμός.", "seq": 1053}
{"id": "David_Passim_1054", "series": "CAG", "text": "καὶ ἄλλως οὐκ ἔστιν ἀριθμὸς ἡ δυάς, ἐπειδὴ πᾶς ἀριθμὸς ἐκ πλήθους μονάδων σύγκειται, ἡ δὲ δυὰς οὐ σύγκειται ἐκ πλήθους μονάδων·", "seq": 1054}
{"id": "David_Passim_1055", "series": "CAG", "text": "ἀπὸ γὰρ τριῶν ἐστι τὸ πλῆθος.", "seq": 1055}
{"id": "David_Passim_1056", "series": "CAG", "text": "τινὲς δὲ λέγουσιν ὅτι ἡ δυὰς ἀριθμός ἐστι·", "seq": 1056}
{"id": "David_Passim_1057", "series": "CAG", "text": "καὶ γὰρ πᾶς ἀριθμὸς τῶν ἐφ᾿ ἑκάτερα αὐτοῦ συντιθεμένων ἀριθμῶν τὸ ἥμισυ ποιεῖ·", "seq": 1057}
{"id": "David_Passim_1058", "series": "CAG", "text": "οἷον ὁ πέντε μεταξὺ τοῦ τέσσαρα καὶ τοῦ ἕξ ἐστι, ταῦτα συντιθέμενα τὸν δέκα ἀριθμὸν ἀποτελοῦσιν, οὗτινος ἥμισύ ἐστιν ὁ πέντε.", "seq": 1058}
{"id": "David_Passim_1059", "series": "CAG", "text": "καὶ πάλιν ὁ ἓξ μεταξὺ τοῦ πέντε καὶ τοῦ ἑπτά ἐστι, ταῦτα συντιθέμενα τὸν δώδεκα ἀποτελοῦσιν, οὗτινος ἥμισύ ἐστιν ὁ ἕξ.", "seq": 1059}
{"id": "David_Passim_1060", "series": "CAG", "text": "πάλιν δὲ ὁ ἑπτὰ μεταξὺ τοῦ ἓξ καὶ τοῦ ὀκτώ ἐστι, ταῦτα συντιθέμενα τὸν δεκατέσσαρα ἀποτελοῦσιν, οὗτινος ἥμισύ ἐστιν ὁ ἑπτά.", "seq": 1060}
{"id": "David_Passim_1061", "series": "CAG", "text": "εἰ ἄρα οὖν ὁ δύο τῶν ἐφ᾿ ἑκάτερα αὐτοῦ συντιθεμένων ἀριθμῶν τὸ ἥμισυ ποιεῖ (μεταξὺ γὰρ τῆς μονάδος καὶ τοῦ τρία ὁ δύο ἐστί, ταῦτα δὲ συντιθέμενα τὸν τέσσαρα ἀριθμὸν ἀποτελοῦσιν, οὗτινος ἥμισύ ἐστιν ὁ δύο), δῆλον ὅτι ὁ δύο ἀριθμός ἐστιν.", "seq": 1061}
{"id": "David_Passim_1062", "series": "CAG", "text": "ταῦτα μὲν ἐκεῖνοι.", "seq": 1062}
{"id": "David_Passim_1063", "series": "CAG", "text": "ἰστέον δὲ ὅτι εἴ τις τὴν ἀκρίβειαν σκοπήσει, εὑρήσει ὅτι οὐχ ἁρμόζει οὗτος ὁ κανὼν τῷ δύο ἀριθμῷ·", "seq": 1063}
{"id": "David_Passim_1064", "series": "CAG", "text": "καὶ γὰρ ἡ δυὰς οὐκ ἔχει ἐφ᾿ ἑκάτερα μέρη ἀριθμόν·", "seq": 1064}
{"id": "David_Passim_1065", "series": "CAG", "text": "μεταξὺ γὰρ τῆς μονάδος καὶ τοῦ τρία ἐστὶν ἀριθμοῦ, ἡ δὲ μονὰς οὐκ ἔστιν ἀριθμός, ὡς δέδεικται.", "seq": 1065}
{"id": "David_Passim_1066", "series": "CAG", "text": "ἰστέον δὲ ὅτι καὶ ἡ δυὰς ἀρχή ἐστιν ἀριθμοῦ.", "seq": 1066}
{"id": "David_Passim_1067", "series": "CAG", "text": "καὶ ἀποροῦσί τινες λέγοντες·", "seq": 1067}
{"id": "David_Passim_1068", "series": "CAG", "text": "πῶς ἐνδέχεται τὴν δυάδα εἶναι ἀρχὴν ἀριθμοῦ, ὅπου ἅπαξ τὴν μονάδα εἴπατε ἀρχὴν ἀριθμοῦ;", "seq": 1068}
{"id": "David_Passim_1069", "series": "CAG", "text": "ἀλλ᾿ ἵνα τὴν ἀπορίαν ταύτην ἐπιλυσώμεθα, ὀλίγα τινὰ ἔξωθεν εἴπωμεν.", "seq": 1069}
{"id": "David_Passim_1070", "series": "CAG", "text": "Ἰστέον ὅτι τῶν ἀριθμῶν οἱ μὲν ἄρτιοί εἰσιν οἱ δὲ περιττοί.", "seq": 1070}
{"id": "David_Passim_1071", "series": "CAG", "text": "καὶ περιττοὶ μέν εἰσιν οἱ μὴ δυνάμενοι εἰς ἴσα διαιρεῖσθαι, οἷον ὥσπερ ὁ πέντε·", "seq": 1071}
{"id": "David_Passim_1072", "series": "CAG", "text": "οὗτος γὰρ οὐ διαιρεῖται εἰς ἴσα·", "seq": 1072}
{"id": "David_Passim_1073", "series": "CAG", "text": "εἰς τρία γὰρ καὶ δύο διαιρεῖται·", "seq": 1073}
{"id": "David_Passim_1074", "series": "CAG", "text": "οὐ δυνάμεθα γὰρ διαιρεῖν αὐτὸν εἰς δύο ἥμισυ καὶ εἰς δύο ἥμισυ, ἐπειδὴ οἱ ἀριθμητικοὶ οὐ τέμνουσι τὴν μονάδα.", "seq": 1074}
{"id": "David_Passim_1075", "series": "CAG", "text": "καὶ πάλιν ὁ ἑπτά·", "seq": 1075}
{"id": "David_Passim_1076", "series": "CAG", "text": "οὐδὲ οὗτος γὰρ εἰς ἴσα διαιρεῖται·", "seq": 1076}
{"id": "David_Passim_1077", "series": "CAG", "text": "εἰς τρία γὰρ καὶ τέσσαρα διαιρεῖται.", "seq": 1077}
{"id": "David_Passim_1078", "series": "CAG", "text": "ἄρτιοι δέ εἰσιν οἱ δυνάμενοι εἰς ἴσα διαιρεῖσθαι, ὥσπερ ὁ τέσσαρα ἀριθμός·", "seq": 1078}
{"id": "David_Passim_1079", "series": "CAG", "text": "οὗτος γὰρ εἰς ἴσα διαιρεῖται·", "seq": 1079}
{"id": "David_Passim_1080", "series": "CAG", "text": "εἰς δύο γὰρ καὶ δύο διαιρεῖται.", "seq": 1080}
{"id": "David_Passim_1081", "series": "CAG", "text": "καὶ πάλιν ὡς ἐπὶ τοῦ ἕξ·", "seq": 1081}
{"id": "David_Passim_1082", "series": "CAG", "text": "καὶ οὗτος γὰρ εἰς ἴσα διαιρεῖται·", "seq": 1082}
{"id": "David_Passim_1083", "series": "CAG", "text": "εἰς τρία γὰρ καὶ τρία διαιρεῖται.", "seq": 1083}
{"id": "David_Passim_1084", "series": "CAG", "text": "δεῖ δὲ καὶ τοῦτο γινώσκειν, ὅτι οἱ μὲν περιττοὶ ἀριθμοὶ μόνως εἰς ἄνισα διαιροῦνται, οἷον ὡς ἐπὶ τοῦ πέντε (οὗτος γὰρ εἰς τρία καὶ δύο διαιρεῖται), οἱ δὲ ἄρτιοι καὶ εἰς ἴσα καὶ εἰς ἄνισα διαιροῦνται·", "seq": 1084}
{"id": "David_Passim_1085", "series": "CAG", "text": "καὶ γὰρ τὸν ἕξ ἀριθμὸν δύναμαι καὶ εἰς ἴσα διαιρεῖν, οἷον εἰς τρία καὶ τρία, δύναμαι καὶ εἰς ἄνισα, οἷον εἰς τέσσαρα καὶ δύο.", "seq": 1085}
{"id": "David_Passim_1086", "series": "CAG", "text": "ὅθεν καὶ κατὰ τοῦτο οὐκ ἔστιν ἡ δυὰς κυρίως ἀριθμός, καθὸ ἄρτιος ἀριθμὸς οὖσα εἰς ἴσα μόνον διαιρεῖται (εἰς μονάδα γὰρ καὶ μονάδα διαιρεῖται), οὐ μὴν καὶ εἰς ἄνισα.", "seq": 1086}
{"id": "David_Passim_1087", "series": "CAG", "text": "τούτων οὕτως ἐχόντων ἡ μὲν μονὰς ἀρχὴ πάντων τῶν ἀριθμῶν ἐστι, τοῦτ᾿ ἔστι καὶ τῶν περιττῶν καὶ τῶν ἀρτίων, ἡ δὲ δυὰς μόνων τῶν ἀρτίων ἀριθμῶν ἐστιν ἀρχή·", "seq": 1087}
{"id": "David_Passim_1088", "series": "CAG", "text": "αὕτη γὰρ ἀποτελεῖ τοὺς ἀρτίους ἀριθμούς·", "seq": 1088}
{"id": "David_Passim_1089", "series": "CAG", "text": "καὶ γὰρ διπλασιαζομένη μὲν τὸν τέσσαρα ἀριθμὸν ἀποτελεῖ, ὅστις ἄρτιός ἐστι, τριπλασιαζομένη δὲ τὸν ἓξ ἀποτελεῖ, καὶ αὐτὸς δὲ ἄρτιός ἐστιν, καὶ ἐπὶ τῶν ἑξῆς ὁμοίως.", "seq": 1089}
{"id": "David_Passim_1090", "series": "CAG", "text": "εἰ δέ τις εἴποι ‘τί οὖν;", "seq": 1090}
{"id": "David_Passim_1091", "series": "CAG", "text": "μόνους τοὺς ἀρτίους ἀριθμοὺς ἀποτελεῖ ἡ δυάς;", "seq": 1091}
{"id": "David_Passim_1092", "series": "CAG", "text": "καὶ μὴν καὶ περιττοὺς ἀποτελεῖ·", "seq": 1092}
{"id": "David_Passim_1093", "series": "CAG", "text": "ἰδοὺ γὰρ προσλαμβάνουσα τὴν μονάδα τὸν τρία ἀποτελεῖ, ὅστις περιττός ἐστιν·", "seq": 1093}
{"id": "David_Passim_1094", "series": "CAG", "text": "οὐ διαιρεῖται γὰρ εἰς ἴσα·", "seq": 1094}
{"id": "David_Passim_1095", "series": "CAG", "text": "εἰς μονάδα γὰρ καὶ δυάδα διαιρεῖται·", "seq": 1095}
{"id": "David_Passim_1096", "series": "CAG", "text": "οὐδὲ γὰρ δυνάμεθα διαιρεῖν εἰς ἓν ἥμισυ καὶ ἓν ἥμισυ, ἐπειδή, ὡς εἴρηται, οἱ ἀριθμητικοὶ οὐ τέμνουσι τὴν μονάδα’, λέγομεν ὅτι οὐκ ἔστιν αἴτιος τοῦ ἀποτελεσθῆναι τὸν περιττὸν ἀριθμὸν εἰ μὴ ἡ μονὰς προσελθοῦσα, ἐπειδὴ ἡ δυὰς πάντως ἄρτιον ἀριθμὸν ἀποτελεῖ, ὡς εἴρηται ἀνωτέρω·", "seq": 1096}
{"id": "David_Passim_1097", "series": "CAG", "text": "πρὸς ἑαυτὴν γὰρ διπλασιαζομένη καὶ τριπλασιαζομένη καὶ ἁπλῶς εἰπεῖν πολλάκις πρὸς ἑαυτὴν πολλαπλασιαζομένη πάντως ἀρτίους ἀριθμοὺς ἀποτελεῖ.", "seq": 1097}
{"id": "David_Passim_1098", "series": "CAG", "text": "καὶ ἄλλως δὲ ἡ δυὰς οὐκ ἔστιν ἀριθμός, εἴπερ πᾶς ἀριθμὸς καὶ ἀρχὴν ἔχει καὶ μέσον καὶ τελευταῖον **.", "seq": 1098}
{"id": "David_Passim_1099", "series": "CAG", "text": "ταῦτα μὲν περὶ τῆς δυάδος.", "seq": 1099}
{"id": "David_Passim_1100", "series": "CAG", "text": "Ὁ δὲ τρία ἀριθμὸς οὕτως ὠνομάσθη παρὰ τὸ ἀτειρής τις εἶναι καὶ ἀκαταπόνητος.", "seq": 1100}
{"id": "David_Passim_1101", "series": "CAG", "text": "οὕτω δὲ λέγεται διὰ τὸ μὴ δύνασθαι αὐτὸν εἰς ἴσα διαιρεῖσθαι·", "seq": 1101}
{"id": "David_Passim_1102", "series": "CAG", "text": "εἰς μονάδα γὰρ καὶ δυάδα διαιρεῖται·", "seq": 1102}
{"id": "David_Passim_1103", "series": "CAG", "text": "οὐδὲ γὰρ δυνάμεθα διαιρεῖν αὐτὸν εἰς ἓν ἥμισυ καὶ ἓν ἥμισυ, ἐπειδή, ὡς εἴρηται, οἱ ἀριθμητικοὶ οὐ τέμνουσι τὴν μονάδα.", "seq": 1103}
{"id": "David_Passim_1104", "series": "CAG", "text": "εἰ δέ τις εἴποι ‘τούτῳ τῷ λόγῳ ἕκαστος περιττὸς ἀριθμὸς οὕτως ὤφειλε λέγεσθαι παρὰ τὸ ἀτειρὴς εἶναι καὶ ἀκαταπόνητος, τοῦτ᾿ ἔστι παρὰ τὸ μὴ δύνασθαι διαιρεῖσθαι εἰς ἴσα, οἷον ὡς ἐπὶ τοῦ πέντε καὶ τοῦ ἑπτά·", "seq": 1104}
{"id": "David_Passim_1105", "series": "CAG", "text": "οὗτοι γὰρ οὐ διαιροῦνται εἰς ἴσα·", "seq": 1105}
{"id": "David_Passim_1106", "series": "CAG", "text": "ὁ μὲν γὰρ πέντε εἰς τρία καὶ δύο διαιρεῖται, ὁ δὲ ἑπτὰ εἰς τρία καὶ τέσσαρα’, λέγομεν ὅτι ὁ τρία ὡς προτερεύων αὐτῶν τούτου χάριν τὴν ὀνομασίαν προϋφήρπασεν.", "seq": 1106}
{"id": "David_Passim_1107", "series": "CAG", "text": "ἰστέον δὲ ὅτι ὁ τρία ἀριθμός ἐστιν·", "seq": 1107}
{"id": "David_Passim_1108", "series": "CAG", "text": "ἐὰν γὰρ τὸν τρία μὴ εἴπωμεν εἶναι ἀριθμόν, ἐπειδὴ ὁ δύο οὐκ ἔστιν ἀριθμός, τούτῳ τῷ λόγῳ οὐδὲ ὁ τέσσαρά ἐστιν ἀριθμός, ἐπειδὴ οὐκ ἔστιν ὁ τρία ἀριθμός, ἀλλ᾿ οὐδὲ ὁ πέντε ἐστὶν ἀριθμός, ἐπειδὴ οὐδὲ ὁ τέσσαρα, καὶ ἐπέκεινα εἰς ἀπέραντον.", "seq": 1108}
{"id": "David_Passim_1109", "series": "CAG", "text": "ἀλλ᾿ οὖν ὁ τρία ἀριθμός ἐστι·", "seq": 1109}
{"id": "David_Passim_1110", "series": "CAG", "text": "καὶ γὰρ πολυπλασιαζόμενος μείζονα ἀριθμὸν ἀποτελεῖ ἤπερ συντιθέμενος·", "seq": 1110}
{"id": "David_Passim_1111", "series": "CAG", "text": "τρία γὰρ ἐπὶ τρία ἐννέα, τρία δὲ καὶ τρία ἕξ·", "seq": 1111}
{"id": "David_Passim_1112", "series": "CAG", "text": "ἰδοὺ πολυπλασιασθεὶς μὲν τὸν ἐννέα ἀριθμὸν ἀπετέλεσε, συντεθεὶς δὲ τὸν ἕξ, ὁ δὲ ἐννέα μείζων ἐστὶ τοῦ ἕξ.", "seq": 1112}
{"id": "David_Passim_1113", "series": "CAG", "text": "τοῦτο δέ, ὡς εἴρηται ἀνωτέρω, ἴδιόν ἐστι τῶν ἀριθμῶν, οἷον τετράκις τέσσαρα δεκαέξ, τέσσαρα δὲ καὶ τέσσαρα ὀκτώ, ὅθεν ἐδείχθη ἡ μονὰς καὶ ἡ δυὰς μὴ οὖσαι ἀριθμοί.", "seq": 1113}
{"id": "David_Passim_1114", "series": "CAG", "text": "ἄλλως τε δὲ ὁ τρία ἀριθμός ἐστιν, καθὸ ἐκ πλήθους μονάδων σύγκειται, ὅπερ ἴδιόν ἐστιν ἀριθμοῦ·", "seq": 1114}
{"id": "David_Passim_1115", "series": "CAG", "text": "πᾶς γὰρ ἀριθμὸς ἐκ πλήθους μονάδων σύγκειται, οἷον ὁ τέσσαρα καὶ ὁ πέντε καὶ ὁ ἓξ καὶ οἱ ἑξῆς.", "seq": 1115}
{"id": "David_Passim_1116", "series": "CAG", "text": "κατὰ τοῦτο δὲ δοκεῖ ὁ τρία μὴ εἶναι ἀριθμός, καθὸ οὐκ ἔχει ἐφ᾿ ἑκάτερα αὐτοῦ τὰ μέρη ἀριθμούς·", "seq": 1116}
{"id": "David_Passim_1117", "series": "CAG", "text": "ὁ γὰρ τρία μεταξὺ τοῦ τέσσαρα καὶ τοῦ δύο ἐστίν, ὁ δὲ δύο, ὡς δέδεικται, οὐκ ἔστιν ἀριθμός.", "seq": 1117}
{"id": "David_Passim_1118", "series": "CAG", "text": "πλὴν ἀριθμός ἐστιν ὁ τρία διὰ τὰς προλεχθείσας αἰτίας.", "seq": 1118}
{"id": "David_Passim_1119", "series": "CAG", "text": "Πρᾶξις ιζ΄.", "seq": 1119}
{"id": "David_Passim_1120", "series": "CAG", "text": "Εἰπόντες οὖν περὶ τῆς μονάδος καὶ τῆς δυάδος καὶ τῆς τριάδος ἔλθωμεν καὶ περὶ τῶν ἑξῆς ἀριθμῶν διαλάβωμεν.", "seq": 1120}
{"id": "David_Passim_1121", "series": "CAG", "text": "ἰστέον ὅτι τετρὰς λέγεται οἱονεὶ ἑδράς τις οὖσα, τοῦτ᾿ ἔστιν ἑδραία καὶ μόνιμος·", "seq": 1121}
{"id": "David_Passim_1122", "series": "CAG", "text": "ἰστέον γὰρ ὅτι τὸ τετράγωνον σχῆμα ἡ τετρὰς ἀποτελεῖ, τὸ δὲ τετράγωνον σχῆμα διὰ τὸ κατὰ πολλὰ μέρη τῆς γῆς ἅπτεσθαι δυσμόχλευτόν ἐστι·", "seq": 1122}
{"id": "David_Passim_1123", "series": "CAG", "text": "καὶ γὰρ ὁ τετράγωνος λίθος ὡς κατὰ πολλὰ μέρη τῆς γῆς ἁπτόμενος δυσχερῶς κινεῖται, ὁ δὲ κίων ἐὰν κλιθῇ εἰς τὸ πλάγιον, ἐπειδὴ οὐχ ἅπτεται τῆς γῆς κατὰ πολλὰ μέρη, εὐχερῶς κινεῖται.", "seq": 1123}
{"id": "David_Passim_1124", "series": "CAG", "text": "διὰ τὸ ἑδραῖον οὖν καὶ μόνιμον ἐκλήθη τετράς.", "seq": 1124}
{"id": "David_Passim_1125", "series": "CAG", "text": "πεντὰς δὲ λέγεται οἱονεὶ ἓν καὶ πᾶς·", "seq": 1125}
{"id": "David_Passim_1126", "series": "CAG", "text": "καὶ γὰρ ὁ πέντε ἀριθμὸς ἀπὸ τῆς μονάδος σύγκειται καὶ τῆς τετράδος, ἡ δὲ τετρὰς πᾶς λέγεται, ἢ ἐπειδὴ τέσσαρά εἰσι τὰ στοιχεῖα, ἐξ ὧν πάντα τὰ σώματα σύγκειται, ἢ ἐπειδὴ ὁ τέσσαρα ἀριθμὸς μετὰ τῶν πρὸ αὐτοῦ συντιθέμενος τὴν δεκάδα ἀποτελεῖ·", "seq": 1126}
{"id": "David_Passim_1127", "series": "CAG", "text": "προσλαμβάνων μὲν γὰρ τὸν τρία ἀριθμὸν ἀποτελεῖ τὸν ἑπτά, προσλαμβάνων δὲ τὸν δύο ἀποτελεῖ τὸν ἐννέα, προσλαμβάνων δὲ καὶ τὴν μονάδα ἀποτελεῖ τὴν δεκάδα.", "seq": 1127}
{"id": "David_Passim_1128", "series": "CAG", "text": "ἑξὰς δὲ λέγεται οἱονεὶ ἐξισὰς παρὰ τὸ ἐξισοῦσθαι τοῖς οἰκείοις μέρεσι·", "seq": 1128}
{"id": "David_Passim_1129", "series": "CAG", "text": "καὶ γάρ, ὡς ἐμάθομεν ἀνωτέρω λέγοντες διὰ τί ἕξ εἰσιν οἱ τῆς φιλοσοφίας ὁρισμοί, ὁ ἓξ τέλειός ἐστιν, ἐπειδὴ τὰ μέρη αὐτοῦ συντιθέμενα ἐξισοῦνται τῷ ὅλῳ·", "seq": 1129}
{"id": "David_Passim_1130", "series": "CAG", "text": "πῶς δὲ ἐξισοῦνται τῷ ὅλῳ;", "seq": 1130}
{"id": "David_Passim_1131", "series": "CAG", "text": "ὡς ἐκεῖ εἴρηται.", "seq": 1131}
{"id": "David_Passim_1132", "series": "CAG", "text": "ἑπτὰς δὲ λέγεται οἱονεὶ σεπτὰς παρὰ τὸ σεβάσμιον καὶ τίμιον·", "seq": 1132}
{"id": "David_Passim_1133", "series": "CAG", "text": "καὶ γὰρ ὁ ἑπτά ἀριθμὸς τίμιός ἐστιν, ὅθεν καὶ ἑπτά εἰσιν αἱ ἡμέραι τῆς ἑβδομάδος καὶ ἑπτὰ οἱ ἀστέρες οἱ πλανώμενοι καὶ ἑπτὰ <τὰ> φωνήεντα.", "seq": 1133}
{"id": "David_Passim_1134", "series": "CAG", "text": "ὁ δὲ ἑπτά ἀριθμὸς λέγεται καὶ καιρὸς καὶ Ἀθηνᾶ, καὶ καιρὸς μέν, ἐπειδὴ κατὰ τοῦτον τὸν καιρὸν γίνονται αἱ ἡλικίαι (καὶ γὰρ τῷ ἑβδόμῳ μηνὶ ὀδοντοφυοῦσιν οἱ παῖδες καὶ τῷ ἑβδόμῳ ἐνιαυτῷ ἀμείβουσι τοὺς ὀδόντας), Ἀθηνᾶ δὲ λέγεται, ἐπειδὴ ὥσπερ μυθεύουσιν τὴν Ἀθηνᾶν παρθένον εἶναι καὶ ἀμήτορα (ἐκ τῆς κεφαλῆς γὰρ τοῦ Διός, ὡς μυθεύουσιν, ἐξῆλθε), τὸν αὐτὸν τρόπον καὶ ὁ ἑπτά ἀριθμὸς μόνος ἐκ τῶν ὄντων ἐντὸς τῆς δεκάδος οὔτε τίκτεται κατὰ πολλαπλασιασμὸν ἐξ ἄλλου ἀριθμοῦ οὔτε τίκτει κατὰ πολλαπλασιασμὸν ἄλλον ἀριθμὸν ἐντὸς τῆς δεκάδος·", "seq": 1134}
{"id": "David_Passim_1135", "series": "CAG", "text": "δεῖ γὰρ γινώσκειν ὅτι τῶν ἀριθμῶν τῶν ὄντων ἐντὸς τῆς δεκάδος οἱ μὲν τίκτουσι πολλαπλασιαζόμενοι, οἱ δὲ τίκτονται, οἱ δὲ καὶ τίκτουσι καὶ τίκτονται, οἷον ὁ τέσσαρα τίκτεται ἐκ τοῦ δύο (δὶς γὰρ δύο τέσσαρα), ἀλλὰ καὶ τίκτει τὸν ὀκτώ·", "seq": 1135}
{"id": "David_Passim_1136", "series": "CAG", "text": "δὶς γὰρ τέσσαρα ὀκτώ.", "seq": 1136}
{"id": "David_Passim_1137", "series": "CAG", "text": "καὶ πάλιν ὁ ἐννέα τίκτεται (τρὶς γὰρ τρία ἐννέα), αὐτὸς δὲ ὁ ἐννέα πολλαπλασιαζόμενος οὐ τίκτει ἀριθμὸν ἐντὸς τῆς δεκάδος·", "seq": 1137}
{"id": "David_Passim_1138", "series": "CAG", "text": "δὶς γὰρ ἐννέα ὀκτωκαίδεκα, ὁ δὲ ὀκτωκαίδεκα οὐκ ἔστιν ἐντὸς τῆς δεκάδος.", "seq": 1138}
{"id": "David_Passim_1139", "series": "CAG", "text": "καὶ πάλιν ὁ πέντε τίκτει τὸν δέκα·", "seq": 1139}
{"id": "David_Passim_1140", "series": "CAG", "text": "δὶς γὰρ πέντε δέκα.", "seq": 1140}
{"id": "David_Passim_1141", "series": "CAG", "text": "τούτων οὖν οὕτως ἐχόντων ὁ ἑπτὰ οὐ τίκτει κατὰ πολλαπλασιασμὸν ἄλλον ἀριθμὸν πρὸ τῆς δεκάδος (δὶς γὰρ ἑπτὰ δεκατέσσαρα, ὁ δὲ δεκατέσσαρα ἀριθμὸς οὐκ ἔστιν ἐντὸς τῆς δεκάδος), οὔτε δὲ τίκτεται ἐξ ἄλλου ἀριθμοῦ κατὰ πολλαπλασιασμόν.", "seq": 1141}
{"id": "David_Passim_1142", "series": "CAG", "text": "εἰ δέ τις εἴποι ὅτι ὁ ἑπτὰ καὶ τίκτει καὶ τίκτεται (προσλαμβάνων γὰρ μονάδα ἀποτελεῖ τὸν ὀκτώ, ἀποτελεῖται δὲ ἐκ τοῦ ἓξ προσελθούσης τῆς μονάδος), λέγομεν ὅτι αὕτη σύνθεσίς ἐστιν, οὐ μὴν πολλαπλασιασμός.", "seq": 1142}
{"id": "David_Passim_1143", "series": "CAG", "text": "ὀγδοὰς δὲ λέγεται οἱονεὶ ἀγοδυὰς παρὰ τὸ δύο ἄγειν·", "seq": 1143}
{"id": "David_Passim_1144", "series": "CAG", "text": "καὶ γὰρ διχοτομουμένη ἔρχεται ἄχρι τῆς μονάδος·", "seq": 1144}
{"id": "David_Passim_1145", "series": "CAG", "text": "διαιρεῖται γὰρ εἰς τέσσαρα καὶ τέσσαρα, καὶ πάλιν εἰς δύο καὶ δύο, καὶ αὖθις εἰς μονάδα καὶ μονάδα.", "seq": 1145}
{"id": "David_Passim_1146", "series": "CAG", "text": "εἰ δέ τις εἴποι ὅτι τούτῳ τῷ λόγῳ καὶ ἡ τετρὰς ὤφειλεν ὀγδοὰς λέγεσθαι, διότι καὶ αὕτη διχοτομουμένη ἔρχεται ἄχρι τῆς μονάδος (καὶ γὰρ διαιρεῖται εἰς δύο καὶ δύο, καὶ πάλιν εἰς μονάδα καὶ μονάδα), λέγομεν ὅτι αἱ ἐτυμολογίαι οὐκ ἀντιστρέφουσιν·", "seq": 1146}
{"id": "David_Passim_1147", "series": "CAG", "text": "ἰδοὺ γὰρ λέγεται σῖτος παρὰ τὸ σείεσθαι, καὶ οὐ μόνον ὁ σῖτος σείεται ἀλλὰ καὶ ἡ κριθὴ καὶ οἱ ἄλλοι καρποί, καὶ οὐ παρὰ τοῦτο λέγει τις ὅτι ὤφειλον καὶ οἱ ἄλλοι καρποὶ σῖτος λέγεσθαι.", "seq": 1147}
{"id": "David_Passim_1148", "series": "CAG", "text": "διὰ τοῦτο οὖν λέγεται ὀγδοάς, διότι διὰ μέσου ἄλλου ἀριθμοῦ ἄγει τὸν δύο·", "seq": 1148}
{"id": "David_Passim_1149", "series": "CAG", "text": "διὰ μέσου γὰρ τοῦ τέσσαρα ἄγει τὸν δύο ὁ ὀκτώ·", "seq": 1149}
{"id": "David_Passim_1150", "series": "CAG", "text": "καὶ γὰρ ὁ ὀκτὼ ἀπὸ τοῦ τέσσαρα συνίσταται (δὶς γὰρ τέσσαρα ὀκτώ), ὁ δὲ τέσσαρα ἔχει ἐν ἑαυτῷ τὸν δύο.", "seq": 1150}
{"id": "David_Passim_1151", "series": "CAG", "text": "παρὰ οὖν τὸ διὰ μέσου ἄλλου ἀριθμοῦ ἄγειν τὸν δύο λέγεται ὀγδοὰς οἱονεὶ ἀγοδυάς τις οὖσα.", "seq": 1151}
{"id": "David_Passim_1152", "series": "CAG", "text": "ἐννεὰς δὲ λέγεται παρὰ τὸ ἓν καὶ νέον.", "seq": 1152}
{"id": "David_Passim_1153", "series": "CAG", "text": "καὶ γὰρ αὕτη πολλαπλασιαζομένη ἕνα νέον ἀριθμὸν φέρει καθ᾿ ὕφεσιν μιᾶς μονάδος ἀπὸ τοῦ ἐννέα ἄχρι τῆς μονάδος, οἱονεὶ δὶς ἐννέα δεκαοκτώ, τρὶς ἐννέα εἰκοσιεπτά, τετράκις ἐννέα τριακονταέξ, καὶ ἑξῆς ὁμοίως.", "seq": 1153}
{"id": "David_Passim_1154", "series": "CAG", "text": "ὅρα οὖν πῶς ὁ ἐννέα πολλαπλασιαζόμενος κατὰ πρόβασιν ἀφαίρεσιν πάσχει μιᾶς μονάδος.", "seq": 1154}
{"id": "David_Passim_1155", "series": "CAG", "text": "δεκὰς δὲ λέγεται οἱονεὶ δεχάς τις οὖσα·", "seq": 1155}
{"id": "David_Passim_1156", "series": "CAG", "text": "καὶ γὰρ ὁ δέκα δέχεται ἤγουν περιέχει ἐν ἑαυτῷ ἅπαντας τοὺς πρὸ αὐτοῦ ἀριθμούς·", "seq": 1156}
{"id": "David_Passim_1157", "series": "CAG", "text": "περιέχει γὰρ καὶ τὴν μονάδα καὶ τὴν δυάδα καὶ τοὺς ἑξῆς.", "seq": 1157}
{"id": "David_Passim_1158", "series": "CAG", "text": "ἐν οἷς σὺν θεῷ καὶ ἡ παροῦσα πρᾶξις.", "seq": 1158}
{"id": "David_Passim_1159", "series": "CAG", "text": "Πρᾶξις ιη΄.", "seq": 1159}
{"id": "David_Passim_1160", "series": "CAG", "text": "Ἐπειδὴ διὰ τῶν ὁρισμῶν ὡς ἕν τι οὖσαν τὴν φιλοσοφίαν μεμαθήκαμεν, ἔλθωμεν καὶ ὡς πολυσχιδῆ αὐτὴν οὖσαν διαιρέσει καθυποβάλωμεν·", "seq": 1160}
{"id": "David_Passim_1161", "series": "CAG", "text": "διὰ γὰρ τῆς διαιρέσεως ἀκριβῶς τὰ μέρη αὐτῆς μανθάνομεν, διὰ δὲ τῶν μερῶν ἀκριβῶς τὸ ὅλον γινώσκομεν.", "seq": 1161}
{"id": "David_Passim_1162", "series": "CAG", "text": "ἄλλως τε δὲ καὶ διὰ διαιρέσεως μανθάνομεν τὰ μέρη αὐτῆς, καὶ λοιπὸν γινώσκοντες τὰ μέρη αὐτῆς εὑρίσκομεν ποῖα συγγράμματα τῆς φιλοσοφίας ὑπὸ ποῖα μέρη ἀνάγονται, ἵνα μὴ ἀγνοοῦντες τὰ μέρη αὐτῆς νομίσωμεν τὰ μὲν ὑπὸ τὸ πρακτικὸν ἀναγόμενα ὑπὸ τὸ θεωρητικὸν ἀνάγεσθαι τὰ δὲ ὑπὸ τὸ θεωρητικὸν ἀναγόμενα ὑπὸ τὸ πρακτικὸν ἀνάγεσθαι.", "seq": 1162}
{"id": "David_Passim_1163", "series": "CAG", "text": "ἔλθωμεν οὖν καὶ διαιρέσει καθυποβάλωμεν τὴν φιλοσοφίαν.", "seq": 1163}
{"id": "David_Passim_1164", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ διαιρέσεως ἐμνημονεύσαμεν, ἵνα μὴ περὶ ἀγνοουμένου πράγματος ποιησώμεθα τὴν ζήτησιν, ἔλθωμεν καὶ εἴπωμεν τί ἐστι διαίρεσις καὶ τί ἐπιδιαίρεσις καὶ τί ὑποδιαίρεσις.", "seq": 1164}
{"id": "David_Passim_1165", "series": "CAG", "text": "ἰστέον ὅτι διαίρεσις μέν ἐστιν ἡ πρώτη τομὴ τοῦ ὑποκειμένου πράγματος, οἷον ὡς ὅταν εἴπωμεν ὅτι τῶν ζῴων τὰ μέν εἰσι λογικὰ τὰ δὲ ἄλογα.", "seq": 1165}
{"id": "David_Passim_1166", "series": "CAG", "text": "ἐπιδιαίρεσις δέ ἐστιν ἡ τοῦ αὐτοῦ πράγματος δευτέρα τομὴ καθ᾿ ἕτερον τρόπον γινομένη, οἷον ὡς ὅταν πάλιν τὸ ζῷον ἄλλως διέλωμεν λέγοντες ὅτι τῶν ζῴων τὰ μὲν θνητά εἰσι τὰ δὲ ἀθάνατα.", "seq": 1166}
{"id": "David_Passim_1167", "series": "CAG", "text": "ὑποδιαίρεσις δέ ἐστιν ἡ τοῦ διαιρεθέντος σκέλους τομή, οἷον ὡς ὅταν διαιροῦντες τὸ ζῷον εἰς λογικὸν καὶ ἄλογον τὸ λογικὸν ὑποδιέλωμεν εἴς τε θνητὸν καὶ ἀθάνατον καὶ πάλιν τὸ θνητὸν ὑποδιέλωμεν εἰς ἄνθρωπον ἵππον κύνα καὶ τὰ τοιαῦτα.", "seq": 1167}
{"id": "David_Passim_1168", "series": "CAG", "text": "Οὕτως οὖν καὶ ἡ φιλοσοφία διαιρεῖται εἰς θεωρητικὸν καὶ πρακτικόν.", "seq": 1168}
{"id": "David_Passim_1169", "series": "CAG", "text": "καὶ διὰ μὲν τοῦ θεωρητικοῦ γινώσκει πάντα τὰ ὄντα, διὰ δὲ τοῦ πρακτικοῦ κατόρθωσιν ποιεῖται τῶν ἠθῶν.", "seq": 1169}
{"id": "David_Passim_1170", "series": "CAG", "text": "ἄξιον δὲ ζητῆσαι διὰ τί ἡ φιλοσοφία εἰς δύο διῃρέθη, φημὶ δὴ εἰς θεωρητικὸν καὶ πρακτικόν, καὶ μὴ εἰς ἓν ἢ εἰς πλείονα.", "seq": 1170}
{"id": "David_Passim_1171", "series": "CAG", "text": "καὶ ἔστιν εἰπεῖν ὅτι εἰς ἓν μὲν οὐκ ἠδύνατο διαιρεῖσθαι, ἐπειδὴ οὐδέποτε διαίρεσις περὶ ἓν καταγίνεται ἀλλὰ περὶ διάφορα·", "seq": 1171}
{"id": "David_Passim_1172", "series": "CAG", "text": "διαίρεσις γὰρ λέγεται παρὰ τὸ διαιρεῖν καὶ διαχωρίζειν τόδε ἐκ τοῦδε, οἷον ὡς ὅταν εἴπω ‘τῶν ζῴων τὰ μὲν λογικά εἰσι τὰ δὲ ἄλογα’.", "seq": 1172}
{"id": "David_Passim_1173", "series": "CAG", "text": "εἰς δύο δὲ διῃρέθη καὶ οὐκ εἰς πλείονα διὰ τρεῖς αἰτίας.", "seq": 1173}
{"id": "David_Passim_1174", "series": "CAG", "text": "καὶ πρώτη μέν ἐστιν αὕτη·", "seq": 1174}
{"id": "David_Passim_1175", "series": "CAG", "text": "διὰ τοῦτο ἡ φιλοσοφία εἰς θεωρητικὸν καὶ πρακτικὸν διῃρέθη, ἐπειδὴ συνουσίωται ἡμῖν καὶ τὸ θεωρητικὸν καὶ τὸ πρακτικόν, καὶ τὸ θεωρητικὸν μέν, ὡς δηλοῦσι καὶ οἱ παῖδες καὶ ἁπλῶς εἰπεῖν πάντες φιλοπευστεῖς ὄντες, τοῦτ᾿ ἔστι φιλομαθεῖς (ἕκαστος γὰρ φιλεῖ τὸ μανθάνειν τι), τὸ δὲ πρακτικόν, ὡς δηλοῖ ἡ ψυχὴ μηδέποτε ἠρεμοῦσα·", "seq": 1175}
{"id": "David_Passim_1176", "series": "CAG", "text": "καὶ γὰρ ἐν τῷ καθεύδειν οὐκ ἠρεμεῖ φανταζομένη τὰ ἐνύπνια.", "seq": 1176}
{"id": "David_Passim_1177", "series": "CAG", "text": "ἀλλὰ καὶ ἡνίκα ἠρεμοῦμεν μὴ ἔχοντές τι πρᾶξαι, ἢ τρίχα τίλλομεν ἢ κάρφος κινοῦμεν ἤ τι τοιοῦτον.", "seq": 1177}
{"id": "David_Passim_1178", "series": "CAG", "text": "ἐπειδὴ οὖν συνουσίωται ἡμῖν τὸ θεωρητικὸν καὶ πρακτικόν, τούτου χάριν καὶ ἡ φιλοσοφία εἰς δύο διαιρεῖται, τοῦτ᾿ ἔστιν εἰς θεωρητικὸν καὶ πρακτικόν.", "seq": 1178}
{"id": "David_Passim_1179", "series": "CAG", "text": "δευτέρα δὲ αἰτία ἐστὶν αὕτη·", "seq": 1179}
{"id": "David_Passim_1180", "series": "CAG", "text": "ἡ φιλοσοφία, ὡς ἐμάθομεν, ὁμοίωσίς ἐστι θεῷ.", "seq": 1180}
{"id": "David_Passim_1181", "series": "CAG", "text": "ἐπειδὴ οὖν ἡ φιλοσοφία ὁμοίωσίς ἐστι θεῷ, διττὰς δὲ δυνάμεις ἔχει τὸ θεῖον, τὰς μὲν θεωρητικὰς τὰς δὲ πρακτικάς (καὶ θεωρητικὰς μὲν καθὸ γινώσκει πάντα, πρακτικὰς δὲ καθὸ πάντα δημιουργεῖ), τούτου χάριν καὶ ἡ φιλοσοφία εἰς δύο διαιρεῖται, τοῦτ᾿ ἔστιν εἰς θεωρητικὸν καὶ πρακτικόν.", "seq": 1181}
{"id": "David_Passim_1182", "series": "CAG", "text": "καὶ διὰ μὲν τοῦ θεωρητικοῦ μιμεῖται τὰς θεωρητικὰς καὶ γνωστικὰς δυνάμεις τοῦ θεοῦ (διὰ γὰρ τούτων πάντα γινώσκει τὰ ὄντα), διὰ δὲ τοῦ πρακτικοῦ μιμεῖται τὰς πρακτικὰς δυνάμεις·", "seq": 1182}
{"id": "David_Passim_1183", "series": "CAG", "text": "διὰ γὰρ τούτων τῶν ἀτελεστέρων ψυχῶν προνοεῖται διὰ τὸ ἀπὸ τῆς ἀγνοίας ἐπὶ τὴν γνῶσιν αὐτὰς μεταφέρειν.", "seq": 1183}
{"id": "David_Passim_1184", "series": "CAG", "text": "τρίτη δὲ αἰτία ἐστὶν αὕτη·", "seq": 1184}
{"id": "David_Passim_1185", "series": "CAG", "text": "ἡ φιλοσοφία σκοπὸν ἔχει τὴν ψυχὴν κοσμῆσαι.", "seq": 1185}
{"id": "David_Passim_1186", "series": "CAG", "text": "ἐπειδὴ δὲ ἡ φιλοσοφία σκοπὸν ἔχει τὴν ψυχὴν κοσμῆσαι, διττὰς δὲ δυνάμεις ἔχει ἡ ψυχή, τὰς μὲν γνωστικὰς τὰς δὲ ζωτικάς, καὶ γνωστικὰς μὲν αἴσθησιν φαντασίαν δόξαν διάνοιαν καὶ νοῦν, περὶ ὧν ἀνωτέρω ἐμάθομεν, ζωτικὰς δὲ βούλησιν προαίρεσιν θυμὸν καὶ ἐπιθυμίαν, τούτου χάριν καὶ ἡ φιλοσοφία εἰς δύο διαιρεῖται, τοῦτ᾿ ἔστιν εἰς θεωρητικὸν καὶ πρακτικόν, ἵνα διὰ μὲν τοῦ θεωρητικοῦ τὰς γνωστικὰς δυνάμεις τῆς ψυχῆς κοσμήσῃ, διὰ δὲ τοῦ πρακτικοῦ τὰς ζωτικάς·", "seq": 1186}
{"id": "David_Passim_1187", "series": "CAG", "text": "καὶ γὰρ τὸ πρακτικὸν διδάσκει ἡμᾶς τὸ κρατεῖν τοῦ θυμοῦ καὶ μὴ ἐρᾶν τῶν μὴ προσηκόντων.", "seq": 1187}
{"id": "David_Passim_1188", "series": "CAG", "text": "Ταῦτα μὲν περὶ τοῦ εἰς δύο διαιρεῖσθαι τὴν φιλοσοφίαν, τοῦτ᾿ ἔστιν εἰς θεωρητικὸν καὶ πρακτικόν.", "seq": 1188}
{"id": "David_Passim_1189", "series": "CAG", "text": "ἰστέον δὲ ὅτι ἑκάτερον τούτων νικᾷ τὸ ἕτερον καὶ νικᾶται ὑπὸ τοῦ ἑτέρου·", "seq": 1189}
{"id": "David_Passim_1190", "series": "CAG", "text": "καὶ γὰρ τὸ θεωρητικὸν νικᾷ τὸ πρακτικὸν κατὰ τὸ ὑποκείμενον, ὅτι τῷ μὲν θεωρητικῷ πάντα τὰ ὄντα ὑπόκεινται πρὸς γνῶσιν τῷ δὲ πρακτικῷ μόναι αἱ ἀνθρώπιναι ψυχαί·", "seq": 1190}
{"id": "David_Passim_1191", "series": "CAG", "text": "μόνας γὰρ τὰς ἀνθρωπίνας ψυχὰς κοσμεῖ τὸ πρακτικόν, οὐ μὴν καὶ τὰς τῶν ἀλόγων, τὸ δὲ θεωρητικὸν καὶ τὰς τῶν ἀλόγων φύσεις ἐπίσταται.", "seq": 1191}
{"id": "David_Passim_1192", "series": "CAG", "text": "τὸ δὲ πρακτικὸν νικᾷ τὸ θεωρητικὸν κατὰ τὸ τέλος·", "seq": 1192}
{"id": "David_Passim_1193", "series": "CAG", "text": "τέλος μὲν γὰρ τοῦ θεωρητικοῦ ἡ ἀλήθεια, τοῦ δὲ πρακτικοῦ τέλος ἐστὶ τὸ ἀγαθόν·", "seq": 1193}
{"id": "David_Passim_1194", "series": "CAG", "text": "διὰ γὰρ τοῦ πρακτικοῦ κοσμεῖ τις τὸ οἰκεῖον ἦθος καὶ ἐκκόπτει τὰ πάθη (τοῦτο δὲ ἀγαθόν ἐστι), διὰ δὲ τοῦ θεωρητικοῦ θεωρεῖ τις τὴν ἐν τοῖς οὖσιν ἀλήθειαν.", "seq": 1194}
{"id": "David_Passim_1195", "series": "CAG", "text": "τὸ δὲ ἀγαθὸν τιμιώτερόν ἐστι τοῦ ἀληθοῦς ὡς περιεκτικώτερον·", "seq": 1195}
{"id": "David_Passim_1196", "series": "CAG", "text": "καὶ γὰρ εἴ τι μὲν ἀληθές, τοῦτο καὶ ἀγαθόν, οὐκ εἴ τι δὲ ἀγαθόν, τοῦτο καὶ ἀληθές·", "seq": 1196}
{"id": "David_Passim_1197", "series": "CAG", "text": "ἔστι γὰρ ὅτε καὶ ψεῦδος ἀγαθόν, ὡς ἐπὶ τούτου τοῦ παραδείγματος·", "seq": 1197}
{"id": "David_Passim_1198", "series": "CAG", "text": "οἷον παρέθετό τίς τινι ξίφος σωφρονῶν καὶ ἐν καιρῷ μανίας ἦλθε θέλων λαβεῖν αὐτό, ἵνα ἄτοπά τινα διαπράξηται, ὁ δὲ γνοὺς ἠρνήσατο λέγων ‘οὐδὲν δέδωκάς μοι’ καὶ ἐψεύσατο, ἵνα μὴ ἐκεῖνος ἄτοπα πράξῃ λαβὼν τὸ ξίφος·", "seq": 1198}
{"id": "David_Passim_1199", "series": "CAG", "text": "καὶ ἰδοὺ ψεῦδος ἀγαθόν.", "seq": 1199}
{"id": "David_Passim_1200", "series": "CAG", "text": "καὶ πάλιν λησταὶ κατεδίωκόν τινα, ἵνα αὐτὸν φονεύσωσιν, οἵτινες ὑπαντηθέντες τινὶ ἠρώτων περὶ τοῦ διωκομένου, ὁ δὲ καίπερ εἰδὼς ἠρνήσατο μὴ ἰδεῖν, καὶ ἐσώθη ὁ φεύγων·", "seq": 1200}
{"id": "David_Passim_1201", "series": "CAG", "text": "καὶ ἰδοὺ ψεῦδος ἀγαθόν.", "seq": 1201}
{"id": "David_Passim_1202", "series": "CAG", "text": "Πρᾶξις ιθ΄.", "seq": 1202}
{"id": "David_Passim_1203", "series": "CAG", "text": "Ἐπειδὴ τὴν φιλοσοφίαν εἰς θεωρητικὸν καὶ πρακτικὸν διείλομεν, ἕκαστον δὲ τούτων τῶν διαιρεθέντων σκελῶν ὑποδιαιρεῖται, ἔλθωμεν καὶ ὑποδιέλωμεν αὐτά.", "seq": 1203}
{"id": "David_Passim_1204", "series": "CAG", "text": "ἀλλὰ πρῶτον τὸ θεωρητικὸν ὑποδιέλωμεν·", "seq": 1204}
{"id": "David_Passim_1205", "series": "CAG", "text": "καὶ γὰρ τοῦτο δοκεῖ τιμιώτερον εἶναι τοῦ πρακτικοῦ, ἐπειδὴ τῷ μὲν θεωρητικῷ πάντα τὰ ὄντα ὑπόκεινται πρὸς γνῶσιν, τῷ δὲ πρακτικῷ μόναι αἱ ἀνθρώπιναι ψυχαί·", "seq": 1205}
{"id": "David_Passim_1206", "series": "CAG", "text": "μόνας γὰρ τὰς ἀνθρωπίνας ψυχὰς κοσμεῖ, οὐ μὴν καὶ τὰς τῶν ἀλόγων.", "seq": 1206}
{"id": "David_Passim_1207", "series": "CAG", "text": "ἰστέον δὲ ὅτι ἄλλως ὁ Πλάτων τὸ θεωρητικὸν διαιρεῖ καὶ ἄλλως ὁ Ἀριστοτέλης·", "seq": 1207}
{"id": "David_Passim_1208", "series": "CAG", "text": "καὶ γὰρ ὁ Πλάτων ὑποδιαιρεῖ τὸ θεωρητικὸν εἰς φυσιολογικὸν καὶ θεολογικόν, τὸ δὲ μαθηματικὸν οὐκ ἠβούλετο μέρος εἶναι τῆς φιλοσοφίας ἀλλὰ προγύμνασμά τι, ὥσπερ ἡ γραμματικὴ καὶ ἡ ῥητορική, ὅθεν καὶ πρὸ τοῦ ἀκροατηρίου τοῦ οἰκείου ἐπέγραφεν “ἀγεωμέτρητος μηδεὶς εἰσίτω.”", "seq": 1208}
{"id": "David_Passim_1209", "series": "CAG", "text": "τοῦτο δὲ ἐπέγραφεν, ἐπειδὴ εἰς τὰ πολλὰ ὁ Πλάτων θεολογεῖ καὶ περὶ θεολογίαν καταγίνεται, συμβάλλεται δὲ εἰς εἴδησιν τῆς θεολογίας τὸ μαθηματικόν, οὗτινος μέρος ἐστὶν ἡ γεωμετρία.", "seq": 1209}
{"id": "David_Passim_1210", "series": "CAG", "text": "ὁ δὲ Ἀριστοτέλης ὑποδιαιρεῖ τὸ θεωρητικὸν εἰς φυσιολογικόν, μαθηματικόν, θεολογικόν·", "seq": 1210}
{"id": "David_Passim_1211", "series": "CAG", "text": "καὶ γὰρ τὸ μαθηματικὸν μέρος τῆς φιλοσοφίας ἐδόξασε·", "seq": 1211}
{"id": "David_Passim_1212", "series": "CAG", "text": "καὶ αὐτὸ γὰρ ἐπιστήμη ἐστί.", "seq": 1212}
{"id": "David_Passim_1213", "series": "CAG", "text": "ταῦτα μὲν ἐν τούτοις.", "seq": 1213}
{"id": "David_Passim_1214", "series": "CAG", "text": "Ἄξιον δὲ ζητῆσαι διὰ τί εἰς τρία ὑποδιαιρεῖται τὸ θεωρητικόν, τοῦτ᾿ ἔστιν εἰς φυσιολογικόν, μαθηματικόν, θεολογικόν.", "seq": 1214}
{"id": "David_Passim_1215", "series": "CAG", "text": "καὶ ἔστιν εἰπεῖν ταύτην τὴν ἀπολογίαν·", "seq": 1215}
{"id": "David_Passim_1216", "series": "CAG", "text": "τῷ θεωρητικῷ πάντα τὰ ὄντα ὑπόκεινται πρὸς γνῶσιν, τὰ δὲ ὄντα τριττά ἐστιν·", "seq": 1216}
{"id": "David_Passim_1217", "series": "CAG", "text": "ἢ γὰρ καὶ τῇ ὑποστάσει καὶ τῇ ἐπινοίᾳ ἔνυλά εἰσιν ὥσπερ ξύλον, λίθος, ὀστοῦν (ταῦτα γὰρ καὶ τῇ ὑποστάσει ἔνυλά εἰσι καὶ τῇ ἐπινοίᾳ·", "seq": 1217}
{"id": "David_Passim_1218", "series": "CAG", "text": "οὐδὲ γὰρ δύναταί τις ξύλον ἢ λίθον ἢ ὀστοῦν ἐπινοῆσαι ἄυλον), ἢ καὶ τῇ ὑποστάσει καὶ τῇ ἐπινοίᾳ ἄυλά εἰσιν ὥσπερ ἄγγελος, θεός, ψυχὴ ἡ ἄνευ σώματος οὖσα (ταῦτα γὰρ καὶ τῇ ὑποστάσει ἄυλά εἰσι καὶ τῇ ἐπινοίᾳ·", "seq": 1218}
{"id": "David_Passim_1219", "series": "CAG", "text": "οὐδὲ γὰρ δύναταί τις ἐπινοῆσαι θεὸν ἢ ἄγγελον ἢ ψυχὴν ἄνευ σώματος οὖσαν ἔνυλον), ἢ τῇ μὲν ὑποστάσει ἔνυλά εἰσι τῇ δὲ ἐπινοίᾳ ἄυλα ὥσπερ τὰ σχήματα·", "seq": 1219}
{"id": "David_Passim_1220", "series": "CAG", "text": "καὶ γὰρ ταῦτα τῇ μὲν ὑποστάσει ἔνυλά εἰσιν (οὐδὲ γὰρ δύναται τρίγωνον ἢ τετράγωνον ἤ τι τοιοῦτον σχῆμα ἄνευ ὕλης συστῆναι·", "seq": 1220}
{"id": "David_Passim_1221", "series": "CAG", "text": "ἢ γὰρ ἐν ξύλῳ ἔχει τὴν ὕπαρξιν ἢ ἐν λίθῳ ἢ ἐν χαλκῷ ἢ ἔν τινι τοιούτῳ), τῇ δὲ ἐπινοίᾳ ἄυλά εἰσι·", "seq": 1221}
{"id": "David_Passim_1222", "series": "CAG", "text": "καὶ γὰρ ἡνίκα τις φαντάζεται καὶ ἀναπολεῖ τὸ σχῆμα αὐτὸ καθ᾿ ἑαυτό, ἀνατυποῖ αὐτὸ ἐν τῇ οἰκείᾳ διανοίᾳ·", "seq": 1222}
{"id": "David_Passim_1223", "series": "CAG", "text": "ὥσπερ γὰρ ὁ κηρὸς ἀναματτόμενος τὴν σφραγῖδα ἐκ τοῦ δακτυλίου αὐτὴν μόνην τὴν σφραγῖδα ἀναμάττεται, οὐ μὴν ἀφαιρεῖταί τι ἐκ τοῦ δακτυλίου, τὸν αὐτὸν τρόπον καὶ ἡ διάνοια φανταζομένη τὰ σχήματα οὐκ ἀφαιρεῖταί τι ἐκ τῆς ὕλης, ἀλλ᾿ αὐτὸ μόνον τὸ σχῆμα φαντάζεται καὶ διατυποῖ ἐν ἑαυτῇ.", "seq": 1223}
{"id": "David_Passim_1224", "series": "CAG", "text": "ἐπειδὴ οὖν τῷ θεωρητικῷ πάντα τὰ ὄντα ὑπόκεινται πρὸς γνῶσιν, τὰ δὲ ὄντα, ὡς εἴρηται, τριττά εἰσι, τούτου χάριν καὶ τὸ θεωρητικὸν εἰς τρία διαιρεῖται, εἰς φυσιολογικόν, μαθηματικόν, θεολογικόν.", "seq": 1224}
{"id": "David_Passim_1225", "series": "CAG", "text": "καὶ ἰστέον ὅτι τὸ μὲν φυσιολογικὸν καταγίνεται περὶ τὰ καὶ τῇ ὑποστάσει καὶ τῇ ἐπινοίᾳ ἔνυλα (ζητεῖ γὰρ περὶ τῶν τεσσάρων στοιχείων πῶς σύγκεινται), τὸ δὲ θεολογικὸν καταγίνεται περὶ τὰ καὶ τῇ ὑποστάσει καὶ τῇ ἐπινοίᾳ ἄυλα, τὸ δὲ μαθηματικὸν καταγίνεται περὶ τὰ τῇ μὲν ὑποστάσει ἔνυλα τῇ δὲ ἐπινοίᾳ ἄυλα.", "seq": 1225}
{"id": "David_Passim_1226", "series": "CAG", "text": "Τούτων οὖν οὕτως ἐχόντων ἔλθωμεν καὶ εἴπωμεν περὶ τῆς τάξεως αὐτῶν.", "seq": 1226}
{"id": "David_Passim_1227", "series": "CAG", "text": "ἰστέον ὅτι τὸ φυσιολογικὸν πρώτην ἔχει τάξιν ὡς σύντροφον καὶ πλησιάζον ἡμῖν, ἅτε δὴ πάντῃ ἔνυλον ὄν.", "seq": 1227}
{"id": "David_Passim_1228", "series": "CAG", "text": "τὸ δὲ μαθηματικὸν μέσον ἐστὶ τοῦ τε φυσιολογικοῦ καὶ θεολογικοῦ ὡς καὶ τῶν δύο μετέχον·", "seq": 1228}
{"id": "David_Passim_1229", "series": "CAG", "text": "καὶ γὰρ ἔνυλόν ἐστιν ὁμοίως τῷ φυσιολογικῷ καὶ ἄυλον ὁμοίως τῷ θεολογικῷ·", "seq": 1229}
{"id": "David_Passim_1230", "series": "CAG", "text": "ὡς εἴρηται γάρ, τὸ μαθηματικὸν τῇ μὲν ὑποστάσει ἔνυλόν ἐστι τῇ δὲ ἐπινοίᾳ ἄυλον.", "seq": 1230}
{"id": "David_Passim_1231", "series": "CAG", "text": "τὸ δὲ θεολογικὸν ἐξ ἀνάγκης ὕστερόν ἐστιν·", "seq": 1231}
{"id": "David_Passim_1232", "series": "CAG", "text": "οὐδὲ γὰρ δύναται εἶναι μετὰ τὸ φυσιολογικόν, ἐπειδὴ οὐ δεῖ ἀπὸ τῶν πάντῃ ἐνύλων εὐθέως ἐπὶ τὰ πάντῃ ἄυλα ἔρχεσθαι, ἐπεὶ πάσχομεν ὃ πάσχουσιν οἱ πολὺν χρόνον ἐν σκότει διάγοντες καὶ εὐθὺς πρὸς τὸν ἥλιον θεωροῦντες·", "seq": 1232}
{"id": "David_Passim_1233", "series": "CAG", "text": "οἱ γὰρ πολὺν χρόνον ἐν σκότει διατρίβοντες καὶ εὐθέως εἰς τὸν ἥλιον θεωροῦντες ἀποτυφλοῦνται.", "seq": 1233}
{"id": "David_Passim_1234", "series": "CAG", "text": "οὕτως οὖν οὐ δεῖ ἀπὸ τῶν πάντῃ ἐνύλων εὐθέως ἐπὶ τὰ πάντῃ ἄυλα ἔρχεσθαι·", "seq": 1234}
{"id": "David_Passim_1235", "series": "CAG", "text": "οὕτω γὰρ αἰνιττομένη ἡ ποίησις λέγει περὶ Ὤτου καὶ Ἐφιάλτου ταῦτα·", "seq": 1235}
{"id": "David_Passim_1236", "series": "CAG", "text": "Ὄσσαν ἐπ᾿ Οὐλύμπῳ μέμασαν θέμεν, αὐτὰρ ἐπ᾿ Ὄσσῃ Πήλιον εἰνοσίφυλλον, ἵν᾿ οὐρανὸς ἀμβατὸς εἴη.", "seq": 1236}
{"id": "David_Passim_1237", "series": "CAG", "text": "καὶ κατὰ μὲν τὸ φαινόμενον τοῦτο λέγει ὅτι ὁ Ὦτος καὶ ὁ Ἐφιάλτης ἠθέλησαν θεῖναι ὄρη ἐπάνω ἀλλήλων, βουλόμενοι μηχανήσασθαι τὴν εἰς οὐρανὸν ἄνοδον, ἀλληγορικῶς δὲ νοούμενα ταῦτα δηλοῦσιν ὅτι ἐκεῖνοι εὐθέως ἀπὸ τῶν φυσικῶν καὶ πάντῃ ἐνύλων πραγμάτων ἐπὶ τὴν γνῶσιν τῶν θείων ἠβουλήθησαν ἐπιπηδῆσαι.", "seq": 1237}
{"id": "David_Passim_1238", "series": "CAG", "text": "ἀπὸ οὖν τοῦ μαθηματικοῦ δεῖ ἐπὶ τὰ θεολογικὰ ἔρχεσθαι.", "seq": 1238}
{"id": "David_Passim_1239", "series": "CAG", "text": "ὅτι δὲ τοῦτο ἀληθές ἐστιν, δηλοῖ ὁ Πλάτων περὶ τοῦ μαθηματικοῦ διαλεγόμενος καὶ λέγων ὅτι ‘αὕτη ὁδός, ταῦτα μαθήματα, εἴτε ῥᾴδια εἴτε χαλεπά, ταύτῃ ἰτέον, ἀμελεῖν δὲ οὐ δεῖ’, τοῦτ᾿ ἔστιν ὅτι ὁδῷ κεχρημένους τοῖς μαθήμασι διὰ τούτων δεῖ βαδίσαι ἐπὶ τὰ θεολογικά.", "seq": 1239}
{"id": "David_Passim_1240", "series": "CAG", "text": "καὶ ὁ Πλωτῖνος δὲ τοῦτο δηλοῖ λέγων ‘παραδοτέον δὲ τοῖς νέοις τὰ μαθήματα πρὸς συνεθισμὸν τῆς ἀσωμάτου φύσεως, δι᾿ ὧν τὴν ἀσώματον φύσιν γινώσκουσιν.’", "seq": 1240}
{"id": "David_Passim_1241", "series": "CAG", "text": "ἰστέον δὲ ὅτι ἐοίκασι τὰ μαθηματικὰ κλίμακι καὶ γεφύρᾳ·", "seq": 1241}
{"id": "David_Passim_1242", "series": "CAG", "text": "ὥσπερ γὰρ ἐν τῇ κλίμακι ἀπὸ τῶν κάτω ἐπὶ τὰ ἄνω ἐρχόμεθα καὶ ἐν τῇ γεφύρᾳ δὲ ἀπὸ τοῦδε τοῦ μέρους εἰς τὸ ἐξ ἐναντίας μέρος ἐρχόμεθα, οὕτω καὶ διὰ τοῦ μαθηματικοῦ ἐπὶ τὸ θεολογικὸν ἐρχόμεθα·", "seq": 1242}
{"id": "David_Passim_1243", "series": "CAG", "text": "καὶ γὰρ συμβάλλεται τὸ μαθηματικὸν εἰς τὴν εἴδησιν τοῦ θεολογικοῦ.", "seq": 1243}
{"id": "David_Passim_1244", "series": "CAG", "text": "ταῦτα μὲν ἐν τούτοις.", "seq": 1244}
{"id": "David_Passim_1245", "series": "CAG", "text": "Ἀποροῦσι δέ τινες λέγοντες·", "seq": 1245}
{"id": "David_Passim_1246", "series": "CAG", "text": "εἰ ἄρα οὐ μόνον τὸ μαθηματικὸν μανθάνεται ἀλλὰ καὶ τὸ φυσιολογικὸν καὶ τὸ θεολογικόν, διὰ τί τοῦτο μόνον λέγεται μαθηματικὸν καὶ μὴ κἀκεῖνα λέγονται μαθηματικά;", "seq": 1246}
{"id": "David_Passim_1247", "series": "CAG", "text": "καὶ ἐπιλύονται λέγοντες ὅτι τὸ φυσιολογικὸν οὐ δύναται λέγεσθαι μαθηματικόν, ἐπειδὴ τοῦτο πάντῃ ἔνυλον ὂν καὶ ἀεὶ ἐν ῥοῇ καὶ ἀπορροῇ ὂν καὶ ἄλλοτε ἄλλως ἔχον οὐχ ὑποπίπτει ἀκριβεῖ γνώσει, ἀλλὰ τυχὸν σήμερον μὲν τοιῶσδε γινώσκεται αὔριον δὲ τοιῶσδε διὰ τὸ ἄλλως ἔχειν.", "seq": 1247}
{"id": "David_Passim_1248", "series": "CAG", "text": "ἀλλ᾿ οὔτε δὲ τὸ θεολογικὸν δύναται λέγεσθαι μαθηματικόν, ἐπειδὴ τὰ θεῖα ἅτε δὴ ἀόρατα ὄντα καὶ ἀκατάληπτα εἰκασμῷ μᾶλλον γινώσκονται ἤπερ ἀκριβεῖ γνώσει.", "seq": 1248}
{"id": "David_Passim_1249", "series": "CAG", "text": "ἐξ ἀνάγκης οὖν τοῦτο λέγεται μαθηματικὸν μόνον.", "seq": 1249}
{"id": "David_Passim_1250", "series": "CAG", "text": "ἄλλως τε δὲ διὰ τοῦτο αὐτὸ μόνον λέγεται μαθηματικόν, ἐπειδὴ αὐτὸ διδάσκει ἡμᾶς πῶς δεῖ μανθάνειν τὰ πράγματα·", "seq": 1250}
{"id": "David_Passim_1251", "series": "CAG", "text": "εἰ γὰρ καὶ ἐν τῇ λογικῇ τοῦτο διδάσκει ἡμᾶς ὁ Ἀριστοτέλης, ἀλλ᾿ οὖν ἐκ τοῦ μαθηματικοῦ ἔλαβε τὴν ἀφορμήν.", "seq": 1251}
{"id": "David_Passim_1252", "series": "CAG", "text": "ἔτι δέ, ὥς φασιν οἱ Πυθαγόρειοι, διὰ τοῦτο μόνον λέγεται μαθηματικόν, ἐπειδὴ ἐν τῇ διανοίᾳ ἔχει τὴν ὕπαρξιν·", "seq": 1252}
{"id": "David_Passim_1253", "series": "CAG", "text": "μόνη γὰρ ἡ διάνοια μανθάνει·", "seq": 1253}
{"id": "David_Passim_1254", "series": "CAG", "text": "ὁ γὰρ νοῦς ἁπλῇ προσβολῇ πάντα γινώσκει.", "seq": 1254}
{"id": "David_Passim_1255", "series": "CAG", "text": "ταῦτα ἐν οἷς σὺν θεῷ καὶ ἡ παροῦσα πρᾶξις.", "seq": 1255}
{"id": "David_Passim_1256", "series": "CAG", "text": "Πρᾶξις κ΄.", "seq": 1256}
{"id": "David_Passim_1257", "series": "CAG", "text": "Διελόντες τὸ θεωρητικὸν εἰς φυσιολογικόν, μαθηματικόν, θεολογικόν, ἔλθωμεν καὶ ἕκαστον τούτων διέλωμεν.", "seq": 1257}
{"id": "David_Passim_1258", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ ἡ διαίρεσις τοῦ φυσιολογικοῦ καὶ θεολογικοῦ πολυσχιδής ἐστι καὶ μείζονος ἀκροάσεως δέεται, ταύτην ταῖς μείζοσι πραγματείαις παραπέμψωμεν, ἔλθωμεν δὲ νῦν καὶ τὴν διαίρεσιν τοῦ μαθηματικοῦ εἴπωμεν τὴν σαφεστέραν·", "seq": 1258}
{"id": "David_Passim_1259", "series": "CAG", "text": "ἔστι γὰρ καὶ ἄλλη πολυσχιδής, ἥτις ἐν ταῖς μεγάλαις πραγματείαις λεχθήσεται, πλὴν καὶ ἡ λεχθησομένη διαίρεσις ἀκριβῶς ἔχει.", "seq": 1259}
{"id": "David_Passim_1260", "series": "CAG", "text": "ἰστέον ὅτι πέντε κεφάλαια ἔχομεν περὶ τοῦ μαθηματικοῦ εἰπεῖν, καὶ ἔστι πρῶτον κεφάλαιον ἐν ᾧ λέγομεν πόσα καὶ ποῖά εἰσι τὰ εἴδη τοῦ μαθηματικοῦ, δεύτερον δὲ ἐν ᾧ λέγομεν διὰ τί τοσαῦτά εἰσι, τρίτον ἐν ᾧ λέγομεν τὴν τάξιν αὐτῶν, τέταρτον ἐν ᾧ λέγομεν τίνων εἰσὶν εὑρέματα, πέμπτον δὲ ἐν ᾧ λέγομεν τίνα παράκειται τοῖς τοιούτοις εἴδεσιν.", "seq": 1260}
{"id": "David_Passim_1261", "series": "CAG", "text": "Ἔλθωμεν οὖν ἐπὶ τὸ πρῶτον καὶ εἴπωμεν πόσα καὶ ποῖά εἰσιν εἴδη τοῦ μαθηματικοῦ.", "seq": 1261}
{"id": "David_Passim_1262", "series": "CAG", "text": "ἰστέον οὖν ὅτι τέσσαρά εἰσιν εἴδη τοῦ μαθηματικοῦ, ἀριθμητική, μουσική, γεωμετρία, ἀστρονομία.", "seq": 1262}
{"id": "David_Passim_1263", "series": "CAG", "text": "ἔλθωμεν δὲ καὶ ἐπὶ τὸ δεύτερον καὶ εἴπωμεν διὰ τί τοσαῦτα εἴδη εἰσὶ τοῦ μαθηματικοῦ.", "seq": 1263}
{"id": "David_Passim_1264", "series": "CAG", "text": "ἰστέον ὅτι τὸ μαθηματικὸν περὶ τὸ ποσὸν καταγίνεται·", "seq": 1264}
{"id": "David_Passim_1265", "series": "CAG", "text": "ἢ γὰρ περὶ τοὺς ἀριθμοὺς καταγίνεται ὥσπερ ἡ ἀριθμητική (τοῦτο δὲ ποσόν ἐστιν), ἢ περὶ τὰς σχέσεις τῶν φθόγγων ὥσπερ ἡ μουσική (καὶ τοῦτο δὲ ποσόν ἐστι·", "seq": 1265}
{"id": "David_Passim_1266", "series": "CAG", "text": "ζητεῖ γὰρ ποῖα τὸν διπλάσιον λόγον ἔχουσι καὶ ποῖα τὸν ἐν ἡμιολίῳ), ἢ περὶ τὰ διαστήματα τῆς γῆς καταγίνεται ὥσπερ ἡ γεωμετρία (καὶ τοῦτο δὲ ποσόν ἐστιν), ἢ περὶ τὰς κινήσεις τῶν οὐρανίων σωμάτων καταγίνεται ὥσπερ ἡ ἀστρονομία·", "seq": 1266}
{"id": "David_Passim_1267", "series": "CAG", "text": "καὶ τοῦτο δὲ ποσόν ἐστιν·", "seq": 1267}
{"id": "David_Passim_1268", "series": "CAG", "text": "ἔχουσι γάρ τινα διαστήματα.", "seq": 1268}
{"id": "David_Passim_1269", "series": "CAG", "text": "τούτων οὖν οὕτως ἐχόντων καὶ γνωσθέντων ὅτι τὰ μαθηματικὰ περὶ τὸ ποσὸν καταγίνεται, δεῖ γινώσκειν ὅτι τὸ ποσὸν διττόν ἐστιν·", "seq": 1269}
{"id": "David_Passim_1270", "series": "CAG", "text": "ἢ γὰρ συνεχές ἐστιν ἢ διωρισμένον.", "seq": 1270}
{"id": "David_Passim_1271", "series": "CAG", "text": "καὶ συνεχὲς μὲν ποσόν ἐστιν οὗ τὰ μόρια εἰς ἕνα ὅρον συνάπτονται, ὥσπερ ἐπὶ τοῦ τοίχου·", "seq": 1271}
{"id": "David_Passim_1272", "series": "CAG", "text": "οὗτος γὰρ συνεχὲς ποσόν ἐστι·", "seq": 1272}
{"id": "David_Passim_1273", "series": "CAG", "text": "καὶ γὰρ ἐὰν τέμῃς τοῦτον δυνάμει εἰς πολλοὺς τόμους, πάντα τὰ μόρια τὰ τμηθέντα εἰς ἕνα ὅρον συνάπτονται·", "seq": 1273}
{"id": "David_Passim_1274", "series": "CAG", "text": "καὶ γὰρ τοῦτο τὸ τμῆμα μετὰ τοῦ ἄλλου συνημμένον ἐστὶ διὰ τῆς γραμμῆς τῆς νοητῶς παραληφθείσης ἐν τῷ γενέσθαι τὴν τομήν·", "seq": 1274}
{"id": "David_Passim_1275", "series": "CAG", "text": "καὶ γὰρ τῆς γραμμῆς τῆς δυνάμει τὴν τομὴν ποιησάσης μεταξὺ οὔσης τῶν δυνάμει τμηθέντων εὑρίσκεται τόδε τὸ μέρος συναπτόμενον τῇ γραμμῇ καὶ τὸ ἄλλο τῇ γραμμῇ ὁμοίως καὶ διὰ τῆς γραμμῆς συνάπτονται ἀλλήλοις·", "seq": 1275}
{"id": "David_Passim_1276", "series": "CAG", "text": "δυνάμει γὰρ τῇ τομῇ καθυπεβλήθησαν, οὐ μὴν ἐνεργείᾳ, ἵνα καὶ διαχωρισθῶσιν ἀλλήλων.", "seq": 1276}
{"id": "David_Passim_1277", "series": "CAG", "text": "διωρισμένον δὲ ποσόν ἐστι τὸ διακεχωρισμένον καὶ μὴ ἔχον τι μεταξὺ τὸ ὀφεῖλον συνάφειαν ποιήσασθαι τοῦδε πρὸς τόδε, ὡς ἐπὶ τῶν ἀριθμῶν·", "seq": 1277}
{"id": "David_Passim_1278", "series": "CAG", "text": "καὶ γὰρ ὁ δέκα ἀριθμὸς διακεχωρισμένος ἐστίν·", "seq": 1278}
{"id": "David_Passim_1279", "series": "CAG", "text": "εἴτε γὰρ ἀπὸ μονάδων λάβῃς αὐτὸν συγκείμενον εἴτε ἀπὸ τοῦ πέντε καὶ τοῦ πέντε, οὐκ ἔχει ἄλλον ἀριθμὸν μεταξὺ τὸν ὀφείλοντα συνάφειαν τοῦδε τοῦ ἀριθμοῦ ποιήσασθαι πρὸς τόνδε·", "seq": 1279}
{"id": "David_Passim_1280", "series": "CAG", "text": "ἐὰν γὰρ προσλάβῃ ἕτερον ἀριθμόν, εὑρίσκεται ἐκπίπτων τοῦ δέκα μείζων γενόμενος.", "seq": 1280}
{"id": "David_Passim_1281", "series": "CAG", "text": "καὶ τούτων δὲ ἑκάτερον διττόν ἐστι·", "seq": 1281}
{"id": "David_Passim_1282", "series": "CAG", "text": "καὶ γὰρ καὶ τὸ διωρισμένον ποσὸν διττόν ἐστι·", "seq": 1282}
{"id": "David_Passim_1283", "series": "CAG", "text": "τὸ μὲν γάρ ἐστι καθ᾿ ἑαυτό, τὸ δὲ κατὰ σχέσιν.", "seq": 1283}
{"id": "David_Passim_1284", "series": "CAG", "text": "καὶ καθ᾿ ἑαυτὸ μέν, ὡς ὅταν τοὺς ἀριθμοὺς αὐτοὺς καθ᾿ ἑαυτοὺς λάβωμεν, οἷον ὡς ὅταν τὸν δέκα αὐτὸν καθ᾿ ἑαυτὸν λάβωμεν καὶ μὴ ἐξετάσωμεν αὐτὸν πρὸς ἄλλον ἀριθμόν.", "seq": 1284}
{"id": "David_Passim_1285", "series": "CAG", "text": "κατὰ σχέσιν δέ, ὡς ὅταν τόνδε τὸν ἀριθμὸν ἐξετάσωμεν πρὸς τόνδε, οἷον ὡς ὅταν τὸν δέκα ἐξετάσωμεν πρὸς τὸν πέντε λέγοντες ὅτι ὁ δέκα διπλάσιον λόγον ἔχει πρὸς τὸν πέντε.", "seq": 1285}
{"id": "David_Passim_1286", "series": "CAG", "text": "καὶ πάλιν τὸ συνεχὲς ποσὸν διττόν ἐστι·", "seq": 1286}
{"id": "David_Passim_1287", "series": "CAG", "text": "τὸ μὲν γὰρ ἀκίνητόν ἐστι, τὸ δὲ κινητόν.", "seq": 1287}
{"id": "David_Passim_1288", "series": "CAG", "text": "καὶ ἀκίνητον μὲν ὥσπερ ἡ γῆ (αὕτη γὰρ ἀκίνητός ἐστιν·", "seq": 1288}
{"id": "David_Passim_1289", "series": "CAG", "text": "οὐδὲ γὰρ ἀπέρχεται ἐκ τοῦδε τοῦ τόπου εἰς τόνδε τὸν τόπον), κινητὸν δὲ ὥσπερ ὁ οὐρανός·", "seq": 1289}
{"id": "David_Passim_1290", "series": "CAG", "text": "οὗτος γὰρ ἀεὶ κινεῖται.", "seq": 1290}
{"id": "David_Passim_1291", "series": "CAG", "text": "τούτων οὖν οὕτως ἐχόντων ἐπειδὴ τὸ μαθηματικὸν περὶ τὸ ποσὸν καταγίνεται, τὸ δὲ ποσόν, ὡς εἴρηται, διττόν ἐστιν (ἢ γὰρ συνεχές ἐστιν ἢ διωρισμένον), ἑκάτερον δὲ τούτων διττόν ἐστιν (ἔστι γὰρ ποσὸν διωρισμένον καθ᾿ ἑαυτὸ καὶ ποσὸν διωρισμένον κατὰ σχέσιν καὶ ποσὸν συνεχὲς ἀκίνητον καὶ ποσὸν συνεχὲς κινούμενον), τούτου χάριν πρὸς ἀναλογίαν τῶν τεσσάρων τούτων τῶν συναγομένων ἐκ τοῦ ποσοῦ τοῦ τε διωρισμένου καὶ τοῦ συνεχοῦς τέσσαρά εἰσι τὰ εἴδη τοῦ μαθηματικοῦ, οἷον ἀριθμητική, μουσική, γεωμετρία, ἀστρονομία.", "seq": 1291}
{"id": "David_Passim_1292", "series": "CAG", "text": "καὶ ἡ μὲν ἀριθμητικὴ καταγίνεται περὶ τὸ ποσὸν τὸ διωρισμένον τὸ καθ᾿ ἑαυτό, ἡ δὲ μουσικὴ περὶ τὸ ποσὸν τὸ διωρισμένον τὸ κατὰ σχέσιν, ἡ δὲ γεωμετρία περὶ τὸ ποσὸν τὸ συνεχὲς τὸ ἀκίνητον, ἡ δὲ ἀστρονομία περὶ τὸ ποσὸν τὸ συνεχὲς τὸ κινούμενον.", "seq": 1292}
{"id": "David_Passim_1293", "series": "CAG", "text": "ταῦτα μὲν καὶ τὸ δεύτερον κεφάλαιον.", "seq": 1293}
{"id": "David_Passim_1294", "series": "CAG", "text": "Ἔλθωμεν δὲ καὶ ἐπὶ τὸ τρίτον καὶ εἴπωμεν τὴν τάξιν αὐτῶν.", "seq": 1294}
{"id": "David_Passim_1295", "series": "CAG", "text": "ἰστέον ὅτι ἡ ἀριθμητικὴ καὶ ἡ μουσικὴ προτερεύουσι τῆς γεωμετρίας καὶ ἀστρονομίας, ἐπειδὴ ἡ μὲν ἀριθμητικὴ καὶ ἡ μουσικὴ περὶ τὸ ποσὸν τὸ διωρισμένον καταγίνονται, ἡ δὲ γεωμετρία καὶ ἡ ἀστρονομία περὶ τὸ ποσὸν τὸ συνεχές·", "seq": 1295}
{"id": "David_Passim_1296", "series": "CAG", "text": "τιμιώτερον δὲ τὸ ποσὸν τὸ διωρισμένον τοῦ ποσοῦ τοῦ συνεχοῦς·", "seq": 1296}
{"id": "David_Passim_1297", "series": "CAG", "text": "καὶ γὰρ τὸ ποσὸν τὸ διωρισμένον δύναται ἀσυγχύτως δέξασθαι διάφορα εἴδη·", "seq": 1297}
{"id": "David_Passim_1298", "series": "CAG", "text": "ἰδοὺ γὰρ ὁ κεʹ ἀριθμὸς ὢν ποσὸν διωρισμένον δέχεται ἀσυγχύτως διάφορα εἴδη·", "seq": 1298}
{"id": "David_Passim_1299", "series": "CAG", "text": "ἔστι γὰρ καὶ κύκλος καὶ τετράγωνος.", "seq": 1299}
{"id": "David_Passim_1300", "series": "CAG", "text": "καὶ κύκλος μέν, ὅτι ὥσπερ ἐν τῷ κύκλῳ ἡ ἀρχὴ τῷ πέρατι συνάπτεται, οὕτω καὶ ἐνταῦθα ἄρχεται ἀπὸ τοῦ πέντε ἐν τῷ πολλαπλασιασμῷ καὶ εἰς αὐτὸν λήγει ἀποτελούμενος, οἷον πεντάκις πέντε εἰκοσιπέντε·", "seq": 1300}
{"id": "David_Passim_1301", "series": "CAG", "text": "ἰδοὺ καὶ ἐν τῷ πολλαπλασιασμῷ ἀπὸ τοῦ πέντε ἄρχεται καὶ ἀποτελούμενος εἰς τὸν πέντε καταλήγει.", "seq": 1301}
{"id": "David_Passim_1302", "series": "CAG", "text": "τετράγωνος δὲ λέγεται, ἐπειδὴ πᾶς ἀριθμὸς εἰς ἑαυτὸν πολλαπλασιαζόμενος τετράγωνον ἀριθμὸν ἀποτελεῖ, οἷον τρὶς τρία ἐννέα, τετράκις τέσσαρα δεκαέξ·", "seq": 1302}
{"id": "David_Passim_1303", "series": "CAG", "text": "οὕτως οὖν καὶ πεντάκις πέντε εἰκοσιπέντε.", "seq": 1303}
{"id": "David_Passim_1304", "series": "CAG", "text": "τὸ δὲ ποσὸν τὸ συνεχὲς οὐ δύναται ἀσυγχύτως διάφορα εἴδη ἐπιδέξασθαι·", "seq": 1304}
{"id": "David_Passim_1305", "series": "CAG", "text": "ἰδοὺ γὰρ ἐν τῷ κηρῷ, ὅσπερ ἐστὶ συνεχὲς ποσόν, ἐὰν ποιήσῃ τις εἶδος Ἕκτορος, οὐ δύναται ποιῆσαι ἄλλο εἶδος, εἰ μὴ ἀφανισθῇ τὸ πρῶτον εἶδος, ἐπεὶ σύγχυσις γίνεται.", "seq": 1305}
{"id": "David_Passim_1306", "series": "CAG", "text": "ἐπειδὴ οὖν τὸ ποσὸν τὸ διωρισμένον τιμιώτερόν ἐστι τοῦ ποσοῦ τοῦ συνεχοῦς, τούτου χάριν ἡ ἀριθμητικὴ καὶ ἡ μουσικὴ ὡς περὶ τὸ ποσὸν τὸ διωρισμένον καταγινόμεναι προτερεύουσι τῆς γεωμετρίας καὶ τῆς ἀστρονομίας ὡς τούτων περὶ τὸ ποσὸν τὸ συνεχὲς καταγινομένων.", "seq": 1306}
{"id": "David_Passim_1307", "series": "CAG", "text": "ἡ δὲ ἀριθμητικὴ προτερεύει τῆς μουσικῆς, ἐπειδὴ ἡ μὲν ἀριθμητική, ὡς ἀνωτέρω εἴρηται, περὶ τὸ ποσὸν τὸ καθ᾿ ἑαυτὸ καταγίνεται, ἡ δὲ μουσικὴ περὶ τὸ ποσὸν τὸ κατὰ σχέσιν·", "seq": 1307}
{"id": "David_Passim_1308", "series": "CAG", "text": "προτερεύει δὲ τὸ καθ᾿ ἑαυτὸ τοῦ κατὰ σχέσιν, ἐπειδὴ πρῶτον δεῖ ἁπλῶς τι εἶναι καὶ τότε ἐν σχέσει πρὸς ἕτερον παραλαμβάνεσθαι.", "seq": 1308}
{"id": "David_Passim_1309", "series": "CAG", "text": "ἡ δὲ γεωμετρία προτερεύει τῆς ἀστρονομίας, ἐπειδὴ ἡ μὲν γεωμετρία περὶ τὸ ποσὸν τὸ συνεχὲς τὸ ἀκίνητον καταγίνεται, ἡ δὲ ἀστρονομία περὶ τὸ ποσὸν τὸ συνεχὲς τὸ κινούμενον καταγίνεται·", "seq": 1309}
{"id": "David_Passim_1310", "series": "CAG", "text": "προτερεύει δὲ τὸ ἀκίνητον τοῦ κινουμένου·", "seq": 1310}
{"id": "David_Passim_1311", "series": "CAG", "text": "ἀρχὴ γὰρ κινήσεως ἡ ἠρεμία ἐστίν·", "seq": 1311}
{"id": "David_Passim_1312", "series": "CAG", "text": "ὁ γὰρ μέλλων κινεῖσθαι ἀπὸ ἠρεμίας προέρχεται.", "seq": 1312}
{"id": "David_Passim_1313", "series": "CAG", "text": "αὕτη μὲν οὖν ἐστιν ἡ αἰτία τῆς τάξεως αὐτῶν.", "seq": 1313}
{"id": "David_Passim_1314", "series": "CAG", "text": "Ἔστι δὲ καὶ ἄλλην αἰτίαν εἰπεῖν οὕτως.", "seq": 1314}
{"id": "David_Passim_1315", "series": "CAG", "text": "ἀναλογεῖ μὲν ἡ ἀριθμητικὴ τῇ μονάδι, ἡ δὲ μουσικὴ τῇ δυάδι, ἡ δὲ γεωμετρία τῇ τριάδι, ἡ δὲ ἀστρονομία τῇ τετράδι.", "seq": 1315}
{"id": "David_Passim_1316", "series": "CAG", "text": "πρὸς ἀναλογίαν οὖν τῆς τάξεως τῶν ἀριθμῶν ἐκτήσαντο καὶ ταύτην τὴν τάξιν·", "seq": 1316}
{"id": "David_Passim_1317", "series": "CAG", "text": "καὶ γὰρ ἡ ἀριθμητικὴ τῇ μονάδι ἀναλογεῖ (περὶ γὰρ τὸ καθ᾿ ἑαυτὸ ποσὸν καταγίνεται, τὸ δὲ καθ᾿ ἑαυτὸ ἕν τί ἐστιν), ἡ δὲ μουσικὴ τῇ δυάδι ἀναλογεῖ (καὶ γὰρ περὶ τὸ ἐν σχέσει ποσὸν καταγίνεται, ἡ δὲ σχέσις τὸ ἐλάχιστον ἐπὶ δύο λαμβάνεται), ἡ δὲ γεωμετρία ἀναλογεῖ τῇ τριάδι (καὶ γὰρ ἡ γεωμετρία περὶ τὰ ἐπίπεδα σχήματα καταγίνεται, πρῶτον δὲ σχῆμα τὸ τρίγωνόν ἐστιν·", "seq": 1317}
{"id": "David_Passim_1318", "series": "CAG", "text": "οὔτε γὰρ μία γραμμὴ οὔτε δύο γραμμαὶ ἀποτελοῦσι σχῆμα), ἡ δὲ ἀστρονομία ἀναλογεῖ τῇ τετράδι·", "seq": 1318}
{"id": "David_Passim_1319", "series": "CAG", "text": "καὶ γὰρ ἡ ἀστρονομία περὶ τὰ οὐράνια σώματα καταγίνεται, πᾶν δὲ σῶμα τριχῇ διαστατόν ἐστιν·", "seq": 1319}
{"id": "David_Passim_1320", "series": "CAG", "text": "ἔχει γὰρ μῆκος πλάτος βάθος.", "seq": 1320}
{"id": "David_Passim_1321", "series": "CAG", "text": "ἕκαστον δὲ τούτων ὑπὸ δύο ὅρων περιέχεται ἤγουν δύο πέρατα ἔχει, ἐξ ὧν περιέχεται·", "seq": 1321}
{"id": "David_Passim_1322", "series": "CAG", "text": "καὶ γὰρ καὶ τὸ μῆκος ἔνθεν καὶ ἔνθεν περιέχεται καὶ τὸ πλάτος ὁμοίως καὶ τὸ βάθος, ὥστε συνάγεσθαι ἓξ ὅρους ἤγουν πέρατα.", "seq": 1322}
{"id": "David_Passim_1323", "series": "CAG", "text": "ἐκ δὲ τούτων τῶν ἓξ τέσσαρα γίνονται·", "seq": 1323}
{"id": "David_Passim_1324", "series": "CAG", "text": "καὶ γὰρ τὸ ἓν πέρας κοινόν ἐστι τῶν δύο·", "seq": 1324}
{"id": "David_Passim_1325", "series": "CAG", "text": "τὸ γὰρ πέρας τοῦ πλάτους εὑρίσκεται ἀρχὴ τοῦ μήκους ἢ τοῦ βάθους.", "seq": 1325}
{"id": "David_Passim_1326", "series": "CAG", "text": "ἐπειδὴ οὖν ἡ ἀστρονομία περὶ τὰ οὐράνια σώματα καταγίνεται, πᾶν δὲ σῶμα τριχῇ διαστατόν ἐστιν (ἔχει γὰρ μῆκος πλάτος βάθος, ταῦτα δὲ τέσσαρας ὅρους ἤγουν τέσσαρα πέρατα ἔχουσι), τούτου χάριν λέγουσιν αὐτὴν τῇ τετράδι ἀναλογεῖν.", "seq": 1326}
{"id": "David_Passim_1327", "series": "CAG", "text": "ἔχομεν οὖν διὰ τί πρώτη ἐστὶν ἡ ἀριθμητικὴ καὶ δευτέρα ἡ μουσικὴ καὶ τρίτη ἡ γεωμετρία καὶ τετάρτη ἡ ἀστρονομία.", "seq": 1327}
{"id": "David_Passim_1328", "series": "CAG", "text": "ἐν οἷς καὶ τὸ τρίτον κεφάλαιον.", "seq": 1328}
{"id": "David_Passim_1329", "series": "CAG", "text": "Ἔλθωμεν δὲ καὶ ἐπὶ τὸ τέταρτον καὶ εἴπωμεν τίνων εἰσὶν εὑρέματα.", "seq": 1329}
{"id": "David_Passim_1330", "series": "CAG", "text": "ἰστέον ὅτι τὴν ἀριθμητικὴν οἱ Φοίνικες εὗρον ὡς ἐμπορικοὶ ὄντες καὶ δεόμενοι τῶν ἀριθμῶν εἰς τὰς ψήφους.", "seq": 1330}
{"id": "David_Passim_1331", "series": "CAG", "text": "τὴν δὲ μουσικὴν οἱ Θρᾷκες·", "seq": 1331}
{"id": "David_Passim_1332", "series": "CAG", "text": "ἐκεῖθεν γὰρ ἦν ὁ Ὀρφεύς, ὅστις λέγεται εὑρηκέναι τὴν μουσικήν·", "seq": 1332}
{"id": "David_Passim_1333", "series": "CAG", "text": "Θρᾷξ γὰρ ὁ Ὀρφεύς.", "seq": 1333}
{"id": "David_Passim_1334", "series": "CAG", "text": "ἐπενόησε δὲ ἐμβατήρια μέλη διεγείροντα πρὸς θυμὸν αὐτοὺς ὡς ἄγαν ὄντας πολεμικούς·", "seq": 1334}
{"id": "David_Passim_1335", "series": "CAG", "text": "ἡ γὰρ ψῦξις ἀποκλείουσα τὸ θερμὸν ἐν τῷ βάθει δριμύτερον αὐτὸ ποιεῖ, ὅθεν καὶ θυμώδεις εἰσὶ καὶ πολεμικοὶ τῇ βίᾳ τοῦ θερμοῦ καὶ ὀρχηστικοὶ δὲ διὰ τὰς ἑτοίμους φυγὰς τῶν βελῶν·", "seq": 1335}
{"id": "David_Passim_1336", "series": "CAG", "text": "ἔστι γὰρ καὶ πυρρίχιος παρ᾿ αὐτοῖς ὄρχησις, ὅ ἐστιν ἐνόπλιος, κατὰ τὸ εἰρημένον τῷ ποιητῇ", "seq": 1336}
{"id": "David_Passim_1337", "series": "CAG", "text": "Μηριόνη, τάχα κέν σε καὶ ὀρχηστήν περ ἐόντα.", "seq": 1337}
{"id": "David_Passim_1338", "series": "CAG", "text": "τὴν δὲ γεωμετρίαν οἱ Αἰγύπτιοι εὗρον ἐξ ἀνάγκης·", "seq": 1338}
{"id": "David_Passim_1339", "series": "CAG", "text": "καὶ γὰρ τοῦ Νείλου συνεχῶς ἀνιόντος καὶ τὴν Αἴγυπτον ἐπικλύζοντος σύγχυσις τῶν ὁροθεσίων ἐγίνετο καὶ ἤρχοντο οἱ Αἰγύπτιοι εἰς μάχην καὶ ἐφόνευον ἀλλήλους καὶ λοιπὸν ἐκεῖθεν ἐπενόησαν μέτρον τι, δι᾿ οὗ ἐμέτρουν τὴν γῆν καὶ ἑκάστου τὸ ἴδιον ἐφυλάττετο·", "seq": 1339}
{"id": "David_Passim_1340", "series": "CAG", "text": "ὅπερ μέτρον καὶ ἄκαιναν ἐκάλουν διὰ τὸ μὴ καίνειν, ὅ ἐστι φονεύειν, ἐπειδὴ δι᾿ αὐτοῦ ἐστερήθησαν τοῦ καίνειν καὶ φονεύειν.", "seq": 1340}
{"id": "David_Passim_1341", "series": "CAG", "text": "οὕτως τῆς γεωμετρίας ἐξ ἀνάγκης ἀνεφάνη τὸ χρήσιμον.", "seq": 1341}
{"id": "David_Passim_1342", "series": "CAG", "text": "τὴν δὲ ἀστρονομίαν οἱ Χαλδαῖοι·", "seq": 1342}
{"id": "David_Passim_1343", "series": "CAG", "text": "καὶ γὰρ ἐν τῷ κλίματι, ἐν ᾧ εἰσιν οὗτοι, καθαρός ἐστιν ὁ οὐρανὸς καὶ ἀνέφελος, καὶ εὐχερῶς ἐκεῖθεν ἐπενόησαν τὴν περὶ τῶν οὐρανίων σωμάτων διδασκαλίαν ἤγουν τὴν ἀστρονομίαν.", "seq": 1343}
{"id": "David_Passim_1344", "series": "CAG", "text": "ταῦτα μὲν καὶ τὸ τέταρτον κεφάλαιον.", "seq": 1344}
{"id": "David_Passim_1345", "series": "CAG", "text": "Ἔλθωμεν δὲ ἐπὶ τὸ πέμπτον καὶ εἴπωμεν τί παράκειται τούτοις τοῖς εἴδεσιν.", "seq": 1345}
{"id": "David_Passim_1346", "series": "CAG", "text": "ἰστέον ὅτι τῇ ἀριθμητικῇ ἡ λογιστικὴ παράκειται.", "seq": 1346}
{"id": "David_Passim_1347", "series": "CAG", "text": "διαφέρουσι δὲ ἀλλήλων, ὅτι ἡ μὲν ἀριθμητικὴ τὴν φύσιν αὐτὴν τῶν ἀριθμῶν ζητεῖ καὶ περὶ τοῦ καθ᾿ ἑαυτὸν νοουμένου ἀριθμοῦ διαλαμβάνει καὶ οὐ τέμνει τὴν μονάδα, ἡ δὲ λογιστικὴ περὶ τοῦ ἐν τοῖς πράγμασι θεωρουμένου ἀριθμοῦ διαλαμβάνει·", "seq": 1347}
{"id": "David_Passim_1348", "series": "CAG", "text": "ἀντὶ γὰρ τῆς μονάδος λαμβάνει ἢ ἕνα ἄνθρωπον ἢ ἕνα ἵππον ἢ πηχυαῖον ξύλον καὶ τέμνει τὴν μονάδα εἰς ἥμισυ τρίτον ἕκτον καὶ εἰς τὰ τοιαῦτα.", "seq": 1348}
{"id": "David_Passim_1349", "series": "CAG", "text": "τῇ δὲ μουσικῇ ἡ ἔνυλος μουσικὴ παράκειται.", "seq": 1349}
{"id": "David_Passim_1350", "series": "CAG", "text": "καὶ ἰστέον ὅτι ἡ μὲν μουσικὴ τῷ λόγῳ μόνῳ κέχρηται, ἡ δὲ ἔνυλος μουσικὴ τοῖς ὀργάνοις οἷον τοῖς κυμβάλοις καὶ τοῖς αὐλοῖς.", "seq": 1350}
{"id": "David_Passim_1351", "series": "CAG", "text": "τῇ δὲ γεωμετρίᾳ ἡ γεωδαισία παράκειται.", "seq": 1351}
{"id": "David_Passim_1352", "series": "CAG", "text": "καὶ ἡ μὲν γεωμετρία τὸν λόγον τῶν μεγεθῶν καὶ τῶν σχημάτων παραδίδωσιν, ἡ δὲ γεωδαισία κέχρηται τῷ ἔργῳ καὶ τέμνει τὴν γῆν, ὅθεν καὶ γεωδαισία λέγεται παρὰ τὸν δασμὸν ἤτοι τὸν μερισμὸν τῆς γῆς.", "seq": 1352}
{"id": "David_Passim_1353", "series": "CAG", "text": "τῇ δὲ ἀστρονομίᾳ ἡ σφαιρικὴ παράκειται.", "seq": 1353}
{"id": "David_Passim_1354", "series": "CAG", "text": "ἀλλ᾿ ἡ μὲν ἀστρονομία περὶ μόνα τὰ οὐράνια σώματα καταγίνεται, ἡ δὲ σφαιρικὴ περὶ πᾶσαν σφαῖραν καταγίνεται·", "seq": 1354}
{"id": "David_Passim_1355", "series": "CAG", "text": "λέγει γὰρ τὰ συμβαίνοντα ἑκάστῃ σφαίρᾳ, εἴτε ὀστρακίνη εἴη εἴτε ξυλίνη εἴτε λιθίνη, σκοποῦσα τὰ ὑπάρχοντα πάσῃ σφαίρᾳ, οὐ μόνῃ τῇ οὐρανίᾳ, ὡς Θεοδόσιος ἐν τοῖς σφαιρικοῖς διαλαμβάνει.", "seq": 1355}
{"id": "David_Passim_1356", "series": "CAG", "text": "καὶ ἔστιν ἡ σφαιρικὴ ἀυλοτέρα τῆς ἀστρονομίας ὡς διαλαμβάνουσα περὶ τῆς τῷ λόγῳ θεωρουμένης σφαίρας.", "seq": 1356}
{"id": "David_Passim_1357", "series": "CAG", "text": "ἰστέον δὲ ὅτι φησὶν ὁ Ὀλυμπιόδωρος ὡς τῶν μὲν ἄλλων μαθηματικῶν εἰδῶν μέχρι τοῦ νῦν φυλάττεται λείψανα, οἷον τῆς ἀριθμητικῆς τῆς γεωμετρίας τῆς ἀστρονομίας·", "seq": 1357}
{"id": "David_Passim_1358", "series": "CAG", "text": "περὶ δὲ τῆς μουσικῆς φησιν", "seq": 1358}
{"id": "David_Passim_1359", "series": "CAG", "text": "ἡμεῖς [μὲν] τῆς κλέος [ἐσθλὸν] οἶον ἀκούομεν οὐδέ τι ἴδμεν.", "seq": 1359}
{"id": "David_Passim_1360", "series": "CAG", "text": "οὐδὲ γάρ, φησί, σώζεται λείψανα τῆς μουσικῆς.", "seq": 1360}
{"id": "David_Passim_1361", "series": "CAG", "text": "ἰστέον δὲ ὅτι εἰσὶ μέχρι τοῦ νῦν βιβλία μουσικά.", "seq": 1361}
{"id": "David_Passim_1362", "series": "CAG", "text": "πάνυ δὲ συμβάλλεται ἡ μουσικὴ οὐ μόνον ταῖς τῶν ἀλόγων ψυχαῖς ἀλλὰ καὶ τῶν λογικῶν.", "seq": 1362}
{"id": "David_Passim_1363", "series": "CAG", "text": "ὅτι δὲ συμβάλλεται ταῖς ψυχαῖς τῶν ἀλόγων, δηλοῦσι τὰ πρόβατα ἑπόμενα τῇ ποιμενικῇ σύριγγι ὥσπερ ὑπὸ τῆς φωνῆς ἡδυνόμενα.", "seq": 1363}
{"id": "David_Passim_1364", "series": "CAG", "text": "ὅτι δὲ καὶ τῇ ψυχῇ τῶν λογικῶν ζῴων συμβάλλεται, δηλοῖ ἡ ἐν πολέμῳ σάλπιγξ τὴν ψυχὴν διεγείρουσα, καὶ τὰ θεατρικὰ δὲ ὄργανα δηλοῦσι τὴν ψυχὴν χαλῶντα διὰ τὸ ποιεῖν αὐτὴν ἥδεσθαι.", "seq": 1364}
{"id": "David_Passim_1365", "series": "CAG", "text": "ταῦτα ἐν οἷς σὺν θεῷ ἡ παροῦσα πρᾶξις.", "seq": 1365}
{"id": "David_Passim_1366", "series": "CAG", "text": "Πρᾶξις κα΄.", "seq": 1366}
{"id": "David_Passim_1367", "series": "CAG", "text": "Μαθόντες ὅτι ἡ φιλοσοφία διαιρεῖται εἰς θεωρητικὸν καὶ πρακτικὸν καὶ ὅτι τὸ θεωρητικὸν διαιρεῖται εἰς φυσιολογικόν, μαθηματικόν, θεολογικόν, ἔλθωμεν καὶ εἴπωμεν κατὰ ποῖον τρόπον τῆς διαιρέσεως ἐγένετο ἐπὶ τούτων ἡ διαίρεσις·", "seq": 1367}
{"id": "David_Passim_1368", "series": "CAG", "text": "τοῦ γὰρ πρακτικοῦ τὴν διαίρεσιν ἐν τοῖς ἑξῆς λέγομεν.", "seq": 1368}
{"id": "David_Passim_1369", "series": "CAG", "text": "ἀλλ᾿ ἵνα τοῦτο μάθωμεν, εἴπωμεν πόσοι καὶ ποῖοί εἰσιν οἱ διαιρετικοὶ τρόποι.", "seq": 1369}
{"id": "David_Passim_1370", "series": "CAG", "text": "ἰστέον ὅτι φασί τινες ὀκτὼ εἶναι τοὺς διαιρετικοὺς τρόπους.", "seq": 1370}
{"id": "David_Passim_1371", "series": "CAG", "text": "εἰσὶ δὲ οὗτοι·", "seq": 1371}
{"id": "David_Passim_1372", "series": "CAG", "text": "οἱ ἀπὸ γένους εἰς εἴδη, ἀπὸ εἰδῶν εἰς ἄτομα, ἀπὸ ὅλων εἰς μέρη (καὶ τοῦτο διχῶς·", "seq": 1372}
{"id": "David_Passim_1373", "series": "CAG", "text": "ἢ γὰρ εἰς ὁμοιομερῆ γίνεται ἡ διαίρεσις ἢ εἰς ἀνομοιομερῆ), ἀπὸ ὁμωνύμου φωνῆς εἰς διάφορα σημαινόμενα, ἀπὸ οὐσίας εἰς συμβεβηκότα, ἀπὸ συμβεβηκότων εἰς οὐσίας, ἀπὸ συμβεβηκότος πάλιν εἰς συμβεβηκότα, ἀφ᾿ ἑνὸς πρὸς ἕν.", "seq": 1373}
{"id": "David_Passim_1374", "series": "CAG", "text": "καὶ ἀπὸ μὲν γένους εἰς εἴδη, ὡς ὅταν τὸ ζῷον διέλωμεν εἰς λογικὸν καὶ ἄλογον (τὸ γὰρ ζῷον γένος ἐστὶ καὶ διαιρεῖται εἰς εἴδη, οἷον εἰς λογικὸν καὶ ἄλογον), ἀπὸ δὲ εἰδῶν εἰς ἄτομα, ὡς ὅταν τὸν καθόλου ἄνθρωπον διέλωμεν εἰς Σωκράτην Πλάτωνα Ἀλκιβιάδην καὶ τοὺς λοιπούς, ἀπὸ ὅλων εἰς μέρη ὁμοιομερῆ, ὡς ὅταν τὴν ὅλην φλέβα τέμωμεν εἰς μικρὰς φλέβας (ἐνταῦθα γὰρ ἀπὸ ὅλου ἐγένετο ἡ διαίρεσις καὶ εἰς ὁμοιομερῆ·", "seq": 1374}
{"id": "David_Passim_1375", "series": "CAG", "text": "καὶ γὰρ ὁμοιομερῆ λέγεται τὰ ἀλλήλοις καὶ τῷ ὅλῳ ὁμωνύμως λεγόμενα ὡς ἐπὶ τῆς φλεβὸς τῆς τεμνομένης εἰς μικρὰς φλέβας·", "seq": 1375}
{"id": "David_Passim_1376", "series": "CAG", "text": "καὶ γὰρ ἕκαστον τούτων ὁμωνύμως καὶ τῷ ὅλῳ καὶ τοῖς λοιποῖς φλὲψ λέγεται), ἀπὸ ὅλων δὲ εἰς μέρη ἀνομοιομερῆ, ὡς ὅταν τὴν κεφαλὴν ὅλην διέλωμεν εἰς ὦτα ῥῖνα ὀφθαλμούς (ἐνταῦθα γὰρ ἀπὸ ὅλου ἐγένετο ἡ διαίρεσις εἰς ἀνομοιομερῆ·", "seq": 1376}
{"id": "David_Passim_1377", "series": "CAG", "text": "καὶ γὰρ ἀνομοιομερῆ λέγεται τὰ μήτε ἀλλήλοις μήτε τῷ ὅλῳ ὁμωνύμως λεγόμενα·", "seq": 1377}
{"id": "David_Passim_1378", "series": "CAG", "text": "οὔτε γὰρ τὰ ὦτα λέγεται κεφαλὴ οὔτε ἡ ῥὶν οὔτε οἱ ὀφθαλμοί.", "seq": 1378}
{"id": "David_Passim_1379", "series": "CAG", "text": "οὔτε δὲ ἀλλήλοις ὁμωνύμως λέγονται·", "seq": 1379}
{"id": "David_Passim_1380", "series": "CAG", "text": "οὔτε γὰρ τὸ οὖς λέγεται ῥὶν οὔτε ἡ ῥὶν ὀφθαλμός), ἀπὸ ὁμωνύμου δὲ φωνῆς εἰς διάφορα σημαινόμενα, ὡς ὅταν ἡ κύων φωνὴ διαιρῆται εἴς τε τὸν θαλάττιον κύνα καὶ τὸν χερσαῖον καὶ τὸν ἀστρῷον, ἀπὸ οὐσίας δὲ εἰς συμβεβηκότα, ὡς ὅταν εἴπωμεν ὅτι τῶν ἀνθρώπων οἱ μὲν λευκοὶ οἱ δὲ μέλανες (ἐνταῦθα γὰρ εἰς τὸ λευκὸν καὶ τὸ μέλαν, ἅτινα συμβεβηκότα εἰσίν, ἐγένετο ἡ διαίρεσις), ἀπὸ συμβεβηκότος δὲ εἰς οὐσίας, ὡς ὅταν εἴπωμεν ὅτι τοῦ λευκοῦ τὸ μέν ἐστι χιὼν τὸ δὲ ψιμύθιον τὸ δὲ κύκνος (ἀπὸ γὰρ τοῦ λευκοῦ, ὅπερ ἐστὶ συμβεβηκός, ἐγένετο ἡ διαίρεσις εἰς χιόνα καὶ κύκνον καὶ ψιμύθιον, ἅτινα οὐσίαι εἰσίν), ἀπὸ συμβεβηκότος δὲ εἰς συμβεβηκότα, ὡς ὅταν εἴπωμεν ὅτι τῶν λευκῶν τὰ μὲν θερμά ἐστι τὰ δὲ ψυχρά, καὶ θερμὰ μὲν ὡς ἐπὶ τῆς ἀσβέστου, ψυχρὰ δὲ ὡς ἐπὶ τῆς χιόνος (ἰδοὺ γὰρ ἐνταῦθα ἀπὸ τοῦ λευκοῦ, ὅπερ ἐστὶ συμβεβηκός, ἐγένετο ἡ διαίρεσις εἰς θερμὸν καὶ ψυχρόν, ἅτινα καὶ αὐτὰ συμβεβηκότα εἰσίν), ἀφ᾿ ἑνὸς δὲ καὶ πρὸς ἕν, ὡς ὅταν ἀπὸ μὲν τῆς ἰατρικῆς εἴπωμεν ἰατρικὸν βιβλίον ἰατρικὸν φάρμακον ἰατρικὴ ἔμπλαστρος (ἰδοὺ ταῦτα ἀφ᾿ ἑνός εἰσιν·", "seq": 1380}
{"id": "David_Passim_1381", "series": "CAG", "text": "ἀπὸ γὰρ μιᾶς τῆς ἰατρικῆς ὠνομάσθησαν), πρὸς ἓν δέ, ὡς ὅταν ἀπὸ τοῦ τέλους, φημὶ δὲ τῆς ὑγείας, εἴπωμεν ὑγιεινὸν βιβλίον ὑγιεινὸν φάρμακον ὑγιεινὴ ἔμπλαστρος·", "seq": 1381}
{"id": "David_Passim_1382", "series": "CAG", "text": "πρὸς ἓν γὰρ πρᾶγμα, τὴν ὑγίειαν, ἀφορῶντες ὠνομάσαμεν αὐτά.", "seq": 1382}
{"id": "David_Passim_1383", "series": "CAG", "text": "ταῦτα μὲν οὕτως.", "seq": 1383}
{"id": "David_Passim_1384", "series": "CAG", "text": "Ἔστι δὲ εἰπεῖν ὅτι οὐκ εἰσὶ κυρίως τρόποι διαιρετικοὶ ὀκτὼ ἀλλὰ τρεῖς·", "seq": 1384}
{"id": "David_Passim_1385", "series": "CAG", "text": "ὁ ἀπὸ γένους εἰς εἴδη, ὁ ἀπὸ ὅλων εἰς μέρη καὶ ὁ ἀπὸ ὁμωνύμου φωνῆς εἰς διάφορα σημαινόμενα·", "seq": 1385}
{"id": "David_Passim_1386", "series": "CAG", "text": "οἱ γὰρ ἄλλοι τρόποι οὐ δύνανται συστῆναι·", "seq": 1386}
{"id": "David_Passim_1387", "series": "CAG", "text": "οὐ γὰρ δύναται ἀπὸ εἰδῶν εἰς ἄτομα γίνεσθαι διαίρεσις, ἐπειδὴ τὰ ἄτομα ἄπειρά εἰσι·", "seq": 1387}
{"id": "David_Passim_1388", "series": "CAG", "text": "καὶ γὰρ οἱ κατὰ μέρος ἄνθρωποι ἄπειροί εἰσι καὶ ἀπερίληπτοι.", "seq": 1388}
{"id": "David_Passim_1389", "series": "CAG", "text": "ἄπειροι δὲ ὄντες καὶ ἀπερίληπτοι οὐ δύνανται διαιρέσει καθυποβληθῆναι·", "seq": 1389}
{"id": "David_Passim_1390", "series": "CAG", "text": "ἐν ὅσῳ γάρ τις θέλει διαιρέσει τοὺς ἐν τῇδε τῇ πόλει ἀνθρώπους καθυποβάλλειν, οἱ μὲν γεννῶνται οἱ δὲ φθείρονται, καὶ οὐδέποτε τοῦ τέλους ἐφικνεῖται.", "seq": 1390}
{"id": "David_Passim_1391", "series": "CAG", "text": "ἀλλ᾿ οὔτε δὲ ἀπὸ συμβεβηκότος εἰς οὐσίας γίνεται διαίρεσις·", "seq": 1391}
{"id": "David_Passim_1392", "series": "CAG", "text": "τὸ γὰρ λέγειν ὅτι τοῦ λευκοῦ τὸ μέν ἐστι κύκνος τὸ δὲ ψιμύθιον τὸ δὲ χιὼν οὐκ ἔστι διαίρεσις συμβεβηκότος εἰς οὐσίας·", "seq": 1392}
{"id": "David_Passim_1393", "series": "CAG", "text": "οὐδὲ γὰρ τὸ λευκὸν τὸ καθ᾿ ἑαυτὸ θεωρούμενον διεῖλον, ἀλλὰ τὸ σῶμα τὸ λευκόν, ὅπερ ἐστὶν οὐσία·", "seq": 1393}
{"id": "David_Passim_1394", "series": "CAG", "text": "οὐδὲ γὰρ δύνανται τὴν λευκότητα διελεῖν εἰς ψιμύθιον καὶ κύκνον καὶ χιόνα, ἐπειδὴ ἡ λευκότης συμβεβηκός ἐστι, ταῦτα δὲ οὐσίαι εἰσίν, οὐ δύναται δὲ τὸ συμβεβηκὸς εἰς οὐσίας διαιρεῖσθαι·", "seq": 1394}
{"id": "David_Passim_1395", "series": "CAG", "text": "καὶ γὰρ τὸ διαιρούμενον εἰς ὅμοια θέλει διαιρεῖσθαι, οὐκ εἰς ἀνόμοια, οἷον τὸ ζῷον εἰς ζῷα διαιρεῖται, οὐ μὴν εἰς μὴ ζῷα, καὶ τὸ λογικὸν εἰς λογικά, οὐ μὴν εἰς ἄλογα, καὶ τὸ θνητὸν εἰς θνητά, οὐ μὴν εἰς ἀθάνατα.", "seq": 1395}
{"id": "David_Passim_1396", "series": "CAG", "text": "πῶς οὖν τὸ συμβεβηκὸς εἰς οὐσίας δύναται διαιρεῖσθαι;", "seq": 1396}
{"id": "David_Passim_1397", "series": "CAG", "text": "ἀλλ᾿ οὔτε δὲ ἀπὸ οὐσίας εἰς συμβεβηκότα γίνεται διαίρεσις·", "seq": 1397}
{"id": "David_Passim_1398", "series": "CAG", "text": "τὸ γὰρ λέγειν ὅτι τῶν ἀνθρώπων οἱ μέν εἰσι λευκοὶ οἱ δὲ μέλανες οὐκ ἔστι διαίρεσις ἀπὸ οὐσίας εἰς συμβεβηκότα ἀλλ᾿ ἀπὸ οὐσίας εἰς οὐσίας ἐχούσας συμβεβηκότα·", "seq": 1398}
{"id": "David_Passim_1399", "series": "CAG", "text": "εἰς γὰρ ἀνθρώπους μέλανας καὶ λευκοὺς ἐγένετο ἡ διαίρεσις, οἵτινες οὐσίαι εἰσίν.", "seq": 1399}
{"id": "David_Passim_1400", "series": "CAG", "text": "ἀλλ᾿ οὔτε δὲ ἀπὸ συμβεβηκότος εἰς συμβεβηκότα γίνεται διαίρεσις·", "seq": 1400}
{"id": "David_Passim_1401", "series": "CAG", "text": "ἢ γὰρ ἀπὸ γένους εἰς εἴδη γίνεται ἡ διαίρεσις, ὡς ὅταν εἴπωμεν ὅτι τὸ χρῶμα διαιρεῖται εἰς εἴδη λευκὸν καὶ μέλαν (τὸ χρῶμα γὰρ γένος ἐστὶ καὶ διαιρεῖται εἰς εἴδη λευκὸν καὶ μέλαν, ὅπερ ἀνάγεται ὑπὸ τὸν διαιρετικὸν τρόπον τὸν ἀπὸ γένους εἰς εἴδη), ἢ ὡς ἀπὸ οὐσίας εἰς οὐσίας, καὶ οὐκέτι ἀπὸ συμβεβηκότος εἰς συμβεβηκότα γίνεται ἡ διαίρεσις·", "seq": 1401}
{"id": "David_Passim_1402", "series": "CAG", "text": "τὸ γὰρ λέγειν ὅτι τῶν λευκῶν τὰ μὲν θερμά εἰσι τὰ δὲ ψυχρὰ ἀπὸ οὐσίας εἰς οὐσίας ἐστὶ διαίρεσις·", "seq": 1402}
{"id": "David_Passim_1403", "series": "CAG", "text": "τὸ γὰρ σῶμα τὸ λευκόν, ὅπερ ἐστὶν οὐσία, διεῖλον εἰς σῶμα θερμὸν καὶ ψυχρόν.", "seq": 1403}
{"id": "David_Passim_1404", "series": "CAG", "text": "καὶ ταῦτα δὲ οὐσίαι εἰσίν·", "seq": 1404}
{"id": "David_Passim_1405", "series": "CAG", "text": "οὐδὲ γὰρ δύνανται τὸ λευκὸν καθ᾿ ἑαυτὸ θεωρούμενον ἤγουν τὴν λευκότητα διελεῖν εἰς σῶμα θερμὸν καὶ ψυχρόν, ἐπειδὴ τὸ λευκὸν καθ᾿ ἑαυτὸ θεωρούμενον οὔτε θερμόν ἐστιν οὔτε ψυχρόν.", "seq": 1405}
{"id": "David_Passim_1406", "series": "CAG", "text": "ἀλλ᾿ οὔτε δὲ τὰ ἀφ᾿ ἑνὸς καὶ πρὸς ἕν ἐστι διαίρεσις, ἀλλὰ ἀπαρίθμησις·", "seq": 1406}
{"id": "David_Passim_1407", "series": "CAG", "text": "τὰ γὰρ ἀφ᾿ ἑνὸς καὶ πρὸς ἓν ἀόριστα καὶ ἀπερίληπτά εἰσι·", "seq": 1407}
{"id": "David_Passim_1408", "series": "CAG", "text": "δύναται γάρ τις εἰπεῖν ‘ἰατρικὸν βιβλίον ἰατρικὴ δίαιτα ἰατρικὴ ἔμπλαστρος ἰατρικὸς οἶνος ἰατρικὸν ἔλαιον’ καὶ ἄλλα ἄπειρα, καὶ πάλιν ‘ὑγιεινὸς οἶνος ὑγιεινὴ δίαιτα ὑγιεινὸν βιβλίον’.", "seq": 1408}
{"id": "David_Passim_1409", "series": "CAG", "text": "ἄπειρα δὲ καὶ ἀπερίληπτα ὄντα πῶς δύνανται διαιρέσει καθυποβληθῆναι;", "seq": 1409}
{"id": "David_Passim_1410", "series": "CAG", "text": "ὥστε οὖν κυρίως τρεῖς τρόποι εἰσὶ μόνοι διαιρετικοί·", "seq": 1410}
{"id": "David_Passim_1411", "series": "CAG", "text": "ὁ ἀπὸ γένους εἰς εἴδη, ὁ ἀπὸ ὅλων εἰς μέρη, ὁ ἀπὸ ὁμωνύμου φωνῆς εἰς διάφορα σημαινόμενα.", "seq": 1411}
{"id": "David_Passim_1412", "series": "CAG", "text": "Ἔστι δὲ ἀπὸ διαιρέσεώς τινος παραδοῦναι τοὺς διαιρετικοὺς τρόπους τούς τε κυρίως καὶ τοὺς ἀσυστάτους·", "seq": 1412}
{"id": "David_Passim_1413", "series": "CAG", "text": "ἔστι γὰρ εἰπεῖν ὅτι τὸ διαιρούμενον ἢ καθ᾿ ἑαυτὸ διαιρεῖται ἢ κατὰ συμβεβηκός.", "seq": 1413}
{"id": "David_Passim_1414", "series": "CAG", "text": "καὶ εἰ μὲν καθ᾿ ἑαυτό, ἢ ὡς πρᾶγμα διαιρεῖται ἢ ὡς φωνή.", "seq": 1414}
{"id": "David_Passim_1415", "series": "CAG", "text": "καὶ εἰ μὲν ὡς πρᾶγμα, γίνεται ὁ ἀπὸ ὅλων εἰς μέρη καὶ ὁ ἀπὸ εἰδῶν εἰς ἄτομα καὶ ὁ ἀφ᾿ ἑνὸς <καὶ> πρὸς ἕν (ταῦτα γὰρ ὡς πράγματα διαιροῦνται), εἰ δὲ ὡς φωνή, γίνεται ὁ ἀπὸ ὁμωνύμου φωνῆς εἰς διάφορα σημαινόμενα.", "seq": 1415}
{"id": "David_Passim_1416", "series": "CAG", "text": "εἰ δὲ κατὰ συμβεβηκός, γίνονται οἱ λοιποὶ τρόποι, τοῦτ᾿ ἔστιν ὁ ἀπὸ οὐσίας εἰς συμβεβηκότα καὶ ὁ ἀπὸ συμβεβηκότος εἰς οὐσίας καὶ ὁ ἀπὸ συμβεβηκότος εἰς συμβεβηκότα·", "seq": 1416}
{"id": "David_Passim_1417", "series": "CAG", "text": "ταῦτα γὰρ κατὰ συμβεβηκὸς ἐγένοντο·", "seq": 1417}
{"id": "David_Passim_1418", "series": "CAG", "text": "ἐπειδὴ γὰρ συνέβη τῶν ἀνθρώπων τοὺς μὲν λευκοὺς εἶναι τοὺς δὲ μέλανας, τούτου χάριν ἐκ τοῦ συμβάντος ἐπενόησαν ἄλλον τρόπον διαιρέσεως καὶ εἶπον ὅτι ἔστι καὶ ὁ ἀπὸ οὐσίας εἰς συμβεβηκότα.", "seq": 1418}
{"id": "David_Passim_1419", "series": "CAG", "text": "καὶ πάλιν ἐπειδὴ συνέβη τῶν λευκῶν τὰ μὲν εἶναι θερμὰ τὰ δὲ ψυχρά, ἐκ τοῦ συμβάντος ἐπενόησαν ἄλλον τρόπον διαιρέσεως καὶ εἶπον ὅτι ἔστι καὶ ὁ ἀπὸ συμβεβηκότου εἰς συμβεβηκότα.", "seq": 1419}
{"id": "David_Passim_1420", "series": "CAG", "text": "καὶ ἐπὶ τοῦ ἄλλου δέ, φημὶ τοῦ ἀπὸ συμβεβηκότος εἰς οὐσίας, τὸ αὐτὸ ἔστιν εἰπεῖν.", "seq": 1420}
{"id": "David_Passim_1421", "series": "CAG", "text": "ταῦτα ἐν οἷς σὺν θεῷ καὶ ἡ παροῦσα πρᾶξις.", "seq": 1421}
{"id": "David_Passim_1422", "series": "CAG", "text": "Πρᾶξις κβ΄.", "seq": 1422}
{"id": "David_Passim_1423", "series": "CAG", "text": "Εἰπόντες τοὺς διαιρετικοὺς τρόπους, ἔλθωμεν καὶ εἴπωμεν κατὰ ποῖον τρόπον διαιρεῖται ἡ φιλοσοφία εἰς θεωρητικὸν καὶ πρακτικόν.", "seq": 1423}
{"id": "David_Passim_1424", "series": "CAG", "text": "ἰστέον ὅτι ἀπὸ γένους εἰς εἴδη οὐ δύναται διαιρεῖσθαι, ἐπειδὴ ἐν τοῖς ἀντιδιαιρουμένοις εἴδεσιν οὐκ ἔστι τὸ πρότερον καὶ ὕστερον·", "seq": 1424}
{"id": "David_Passim_1425", "series": "CAG", "text": "οἷον τὸ ζῷον διαιρεῖται εἰς λογικὸν καὶ ἄλογον, καὶ οὔτε τὸ λογικὸν πρότερον ἐγένετο οὔτε τὸ ἄλογον, ἀλλ᾿ ἅμα ἐγένοντο.", "seq": 1425}
{"id": "David_Passim_1426", "series": "CAG", "text": "εἰ δὲ ἐν τούτοις ἐστὶ τὸ πρότερον καὶ ὕστερον (πρότερον γάρ ἐστι τὸ θεωρητικὸν καὶ ὕστερον τὸ πρακτικόν·", "seq": 1426}
{"id": "David_Passim_1427", "series": "CAG", "text": "διὰ γὰρ τῆς θεωρίας καὶ τοῦ λόγου ἔρχεταί τις ἐπὶ τὴν πρᾶξιν καὶ ῥυθμίζει ἑαυτόν, ἐπεὶ εἰ μὴ τοῦτο γένηται, εὑρίσκεται ἡ πρᾶξις ἄλογος), δῆλον ὅτι οὐκ ἐγένετο ἡ διαίρεσις ὡς ἀπὸ γένους εἰς εἴδη.", "seq": 1427}
