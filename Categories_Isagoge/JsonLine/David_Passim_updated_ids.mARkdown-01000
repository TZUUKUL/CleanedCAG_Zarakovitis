{"id": "David_Passim_1499", "series": "CAG", "text": "καὶ γὰρ τὸ ζῳόφυτον μετέχει τοῦ ζῴου καὶ τοῦ φυτοῦ, ὡς καὶ ἡ ὀνομασία δηλοῖ’.", "seq": 1499}
{"id": "David_Passim_1500", "series": "CAG", "text": "πρὸς οὓς ἔστιν εἰπεῖν ὅτι ἐν τοῖς ἑξῆς δείκνυμεν τὴν διαίρεσιν ταύτην κακῶς ἔχουσαν.", "seq": 1500}
{"id": "David_Passim_1501", "series": "CAG", "text": "πάλιν ἀντιτιθέντες λέγουσιν ὅτι ‘ἰδοὺ ἡ ῥητορικὴ γένος οὖσα εἰς τρία εἴδη διαιρεῖται·", "seq": 1501}
{"id": "David_Passim_1502", "series": "CAG", "text": "διαιρεῖται γὰρ εἰς δικανικόν, συμβουλευτικόν, πανηγυρικόν’.", "seq": 1502}
{"id": "David_Passim_1503", "series": "CAG", "text": "πρὸς οὓς ἔστιν εἰπεῖν ὅτι οὐ καλῶς ἔχει αὕτη ἡ διαίρεσις·", "seq": 1503}
{"id": "David_Passim_1504", "series": "CAG", "text": "οὐδέποτε γὰρ τὰ ἀντιδιαιρούμενα εἴδη ἔχουσι χρονικὴν διαφοράν·", "seq": 1504}
{"id": "David_Passim_1505", "series": "CAG", "text": "οἷον τὸ λογικὸν καὶ ἄλογον ἀντιδιαιρούμενα εἴδη ὄντα οὐκ ἔχουσι χρονικὴν διαφοράν·", "seq": 1505}
{"id": "David_Passim_1506", "series": "CAG", "text": "οὐδὲ γὰρ λέγομεν ὅτι τὸ μὲν λογικὸν περὶ τὸν παρελθόντα χρόνον καταγίνεται τὸ δὲ ἄλογον περὶ τὸν μέλλοντα.", "seq": 1506}
{"id": "David_Passim_1507", "series": "CAG", "text": "εἰ ἄρα δὲ ταῦτα ἔχουσι χρονικὴν διαφοράν (καὶ γὰρ τὸ μὲν συμβουλευτικὸν περὶ τὸν μέλλοντα χρόνον καταγίνεται·", "seq": 1507}
{"id": "David_Passim_1508", "series": "CAG", "text": "ὁ γὰρ συμβουλεύων περὶ τῶν μελλόντων συμβουλεύει·", "seq": 1508}
{"id": "David_Passim_1509", "series": "CAG", "text": "τὸ δὲ δικανικὸν περὶ τὸν παρεληλυθότα·", "seq": 1509}
{"id": "David_Passim_1510", "series": "CAG", "text": "καὶ γὰρ ὁ κρινόμενος περὶ τῶν παρελθόντων κρίνεται·", "seq": 1510}
{"id": "David_Passim_1511", "series": "CAG", "text": "τὸ δὲ πανηγυρικὸν περὶ τὸν ἐνεστῶτα·", "seq": 1511}
{"id": "David_Passim_1512", "series": "CAG", "text": "αὔξησις γάρ ἐστι τῶν προσόντων καὶ ὑπαρχόντων ἀγαθῶν), δῆλον ὅτι οὔκ εἰσιν εἴδη κυρίως ὡς ἀπὸ γένους διαιρούμενα.", "seq": 1512}
{"id": "David_Passim_1513", "series": "CAG", "text": "ἄλλως τε δὲ ἐν τοῖς ἀντιδιαιρουμένοις εἴδεσι τὰ τέλη οὐ συνυπάρχουσι·", "seq": 1513}
{"id": "David_Passim_1514", "series": "CAG", "text": "καὶ γὰρ τέλος τοῦ μὲν λογικοῦ ἐστι τὸ κεχρῆσθαι λόγῳ τοῦ δὲ ἀλόγου τὸ μὴ κεχρῆσθαι λόγῳ, οὔτε δὲ τὸ τέλος τοῦ λογικοῦ ὑπάρχει ἐν τῷ τέλει τοῦ ἀλόγου οὔτε τὸ τέλος τοῦ ἀλόγου ἐν τῷ τέλει τοῦ λογικοῦ·", "seq": 1514}
{"id": "David_Passim_1515", "series": "CAG", "text": "εἰ ἄρα δὲ τὰ τέλη τούτων συνυπάρχουσι (καὶ γὰρ τοῦ δικανικοῦ μὲν τέλος ἐστὶ τὸ δίκαιον τοῦ δὲ συμβουλευτικοῦ τὸ συμφέρον τοῦ δὲ πανηγυρικοῦ τὸ ἀγαθόν, τὸ δὲ ἀγαθὸν συμφέρον καὶ δίκαιόν ἐστι καὶ τὸ δίκαιον συμφέρον καὶ ἀγαθὸν καὶ τὸ συμφέρον δίκαιον καὶ ἀγαθόν), δῆλον ὅτι οὐκ ἐγένετο ἡ διαίρεσις ὡς ἀπὸ γένους εἰς εἴδη.", "seq": 1515}
{"id": "David_Passim_1516", "series": "CAG", "text": "κακῶς οὖν ἔχει ἡ διαίρεσις τῆς ῥητορικῆς.", "seq": 1516}
{"id": "David_Passim_1517", "series": "CAG", "text": "ταῦτα μὲν οὖν ἐν τούτοις.", "seq": 1517}
{"id": "David_Passim_1518", "series": "CAG", "text": "Ἀλλ᾿ οὔτε δὲ ὡς ὅλον εἰς μέρη διῃρέθη τὸ θεωρητικόν·", "seq": 1518}
{"id": "David_Passim_1519", "series": "CAG", "text": "οὔτε γὰρ εἰς ὁμοιομερῆ δύναται εἶναι ἡ διαίρεσις οὔτε εἰς ἀνομοιομερῆ·", "seq": 1519}
{"id": "David_Passim_1520", "series": "CAG", "text": "καὶ γὰρ εἰς ὁμοιομερῆ μὲν οὐ δύναται γενέσθαι ἡ διαίρεσις, ἐπειδὴ εἰ καὶ τῷ ὅλῳ ὁμωνύμως λέγονται (λέγονται γὰρ ταῦτα θεωρητικὰ ὁμωνύμως τῷ θεωρητικῷ), ἀλλ᾿ οὖν ἀλλήλοις οὐ λέγονται ὁμωνύμως·", "seq": 1520}
{"id": "David_Passim_1521", "series": "CAG", "text": "οὔτε γὰρ τὸ φυσιολογικὸν λέγεται μαθηματικὸν οὔτε τὸ μαθηματικὸν λέγεται θεολογικόν·", "seq": 1521}
{"id": "David_Passim_1522", "series": "CAG", "text": "ὁμοιομερῆ δέ εἰσιν, ὡς ἀνωτέρω εἴρηται, τὰ καὶ ἀλλήλοις καὶ τῷ ὅλῳ ὁμωνύμως λεγόμενα.", "seq": 1522}
{"id": "David_Passim_1523", "series": "CAG", "text": "ἀλλ᾿ οὔτε δὲ εἰς ἀνομοιομερῆ δύναται εἶναι ἡ διαίρεσις, ἐπειδὴ εἰ καὶ ἀλλήλοις μὴ λέγονται ὁμωνύμως (οὐ γὰρ λέγεται τὸ φυσιολογικὸν μαθηματικὸν οὔτε τὸ μαθηματικὸν θεολογικόν), ἀλλ᾿ οὖν τῷ ὅλῳ ὁμωνύμως λέγονται·", "seq": 1523}
{"id": "David_Passim_1524", "series": "CAG", "text": "καλοῦνται γὰρ θεωρητικὰ ὁμωνύμως τῷ ὅλῳ·", "seq": 1524}
{"id": "David_Passim_1525", "series": "CAG", "text": "ἀνομοιομερῆ δέ εἰσιν, ὡς ἀνωτέρω εἴρηται, τὰ μήτε ἀλλήλοις μήτε τῷ ὅλῳ ὁμωνύμως λεγόμενα.", "seq": 1525}
{"id": "David_Passim_1526", "series": "CAG", "text": "ἀλλ᾿ οὔτε δὲ ὡς ἀπὸ εἴδους εἰς ἄτομα ἐγένετο ἡ διαίρεσις οὔτε ὡς ἀπὸ οὐσίας εἰς συμβεβηκότα οὔτε ὡς ἀπὸ συμβεβηκότος εἰς οὐσίας οὔτε ὡς ἀπὸ συμβεβηκότος εἰς συμβεβηκότα οὔτε ὡς ἀπὸ ὁμωνύμου φωνῆς εἰς διάφορα σημαινόμενα διὰ τὰς αἰτίας τὰς εἰρημένας περὶ τοῦ θεωρητικοῦ καὶ τοῦ πρακτικοῦ.", "seq": 1526}
{"id": "David_Passim_1527", "series": "CAG", "text": "ἀλλ᾿ εἰσὶ τῶν ἀφ᾿ ἑνός·", "seq": 1527}
{"id": "David_Passim_1528", "series": "CAG", "text": "ἀφ᾿ ἑνὸς γὰρ τοῦ θεωρητικοῦ καὶ τὸ φυσιολογικὸν λέγεται θεωρητικὸν καὶ τὸ μαθηματικὸν καὶ τὸ θεολογικόν.", "seq": 1528}
{"id": "David_Passim_1529", "series": "CAG", "text": "ταῦτα μὲν περὶ τῆς διαιρέσεως τοῦ θεωρητικοῦ.", "seq": 1529}
{"id": "David_Passim_1530", "series": "CAG", "text": "Ἔλθωμεν δὲ καὶ ζητήσωμεν περὶ τῆς διαιρέσεως τοῦ μαθηματικοῦ, πῶς διαιρεῖται τὸ μαθηματικὸν εἰς ἀριθμητικήν, μουσικήν, γεωμετρίαν, ἀστρονομίαν.", "seq": 1530}
{"id": "David_Passim_1531", "series": "CAG", "text": "καὶ ἔστιν εἰπεῖν ὅτι οὐκ ἐγένετο ὡς ἀπὸ γένους εἰς εἴδη ἡ διαίρεσις, ἐπειδή, ὡς εἴρηται ἀνωτέρω, ἐν τοῖς ἀντιδιαιρουμένοις εἴδεσιν οὐκ ἔστι τὸ πρότερον καὶ ὕστερον·", "seq": 1531}
{"id": "David_Passim_1532", "series": "CAG", "text": "εἰ ἄρα δὲ ἐνταῦθά ἐστι τὸ πρότερον καὶ ὕστερον (πρώτη γάρ ἐστιν ἡ ἀριθμητικὴ καὶ δευτέρα ἡ μουσικὴ καὶ τρίτη ἡ γεωμετρία καὶ τετάρτη ἡ ἀστρονομία), δῆλον ὅτι οὐκ ἔστιν ἡ διαίρεσις ὡς ἀπὸ γένους εἰς εἴδη.", "seq": 1532}
{"id": "David_Passim_1533", "series": "CAG", "text": "ἀλλ᾿ οὔτε δὲ ὡς ἀπὸ ὅλου εἰς μέρη, ἐπειδὴ οὔτε εἰς ὁμοιομερῆ δύναται εἶναι οὔτε εἰς ἀνομοιομερῆ διὰ τὴν αἰτίαν τὴν εἰρημένην περὶ τοῦ φυσιολογικοῦ, μαθηματικοῦ, θεολογικοῦ·", "seq": 1533}
{"id": "David_Passim_1534", "series": "CAG", "text": "καὶ γὰρ ταῦτα, φημὶ δὲ ἡ ἀριθμητικὴ καὶ ἡ μουσικὴ καὶ ἡ γεωμετρία καὶ ἡ ἀστρονομία, ἀλλήλοις μὲν οὐ λέγονται ὁμωνύμως (οὔτε γὰρ ἡ ἀριθμητικὴ λέγεται μουσικὴ οὔτε ἡ γεωμετρία ἀστρονομία), τῷ δὲ ὅλῳ ὁμωνύμως λέγονται·", "seq": 1534}
{"id": "David_Passim_1535", "series": "CAG", "text": "πάντα γὰρ ὁμωνύμως τῇ μαθηματικῇ μαθηματικὰ λέγονται καὶ τούτου χάριν κωλύονται καὶ ἀνομοιομερῆ εἶναι καὶ ὁμοιομερῆ.", "seq": 1535}
{"id": "David_Passim_1536", "series": "CAG", "text": "καὶ ὁμοιομερῆ μέν, ἐπειδή, ὡς εἴρηται, τὰ ὁμοιομερῆ καὶ ἀλλήλοις καὶ τῷ ὅλῳ ὁμωνύμως λέγονται, ταῦτα δὲ μόνῳ τῷ ὅλῳ ὁμωνύμως λέγονται.", "seq": 1536}
{"id": "David_Passim_1537", "series": "CAG", "text": "ἀνομοιομερῆ δὲ κωλύονται εἶναι, ἐπειδή, ὡς εἴρηται, τὰ ἀνομοιομερῆ οὔτε τῷ ὅλῳ οὔτε ἀλλήλοις ὁμωνύμως λέγονται.", "seq": 1537}
{"id": "David_Passim_1538", "series": "CAG", "text": "ἀλλ᾿ οὔτε δὲ ὡς ἀπὸ εἴδους εἰς ἄτομα δύναται γενέσθαι ἡ διαίρεσις οὔτε ὡς ἀπὸ οὐσίας εἰς συμβεβηκότα οὔτε ὡς ἀπὸ συμβεβηκότος εἰς οὐσίας οὔτε ὡς ἀπὸ συμβεβηκότος εἰς συμβεβηκότα οὔτε ὡς ἀπὸ ὁμωνύμου φωνῆς εἰς διάφορα σημαινόμενα διὰ τὰς αἰτίας τὰς εἰρημένας περὶ τοῦ θεωρητικοῦ καὶ πρακτικοῦ, ἀλλ᾿ εἰσὶ τῶν ἀφ᾿ ἑνός·", "seq": 1538}
{"id": "David_Passim_1539", "series": "CAG", "text": "ἀπὸ ἑνὸς γὰρ τοῦ μαθηματικοῦ λέγονται πάντα μαθηματικά.", "seq": 1539}
{"id": "David_Passim_1540", "series": "CAG", "text": "ἐν οἷς σὺν θεῷ καὶ ἡ παροῦσα πρᾶξις.", "seq": 1540}
{"id": "David_Passim_1541", "series": "CAG", "text": "Πρᾶξις κγ΄.", "seq": 1541}
{"id": "David_Passim_1542", "series": "CAG", "text": "Εἰπόντες τὴν διαίρεσιν τοῦ θεωρητικοῦ ἔλθωμεν καὶ ἐπὶ τὴν διαίρεσιν τοῦ πρακτικοῦ·", "seq": 1542}
{"id": "David_Passim_1543", "series": "CAG", "text": "εἰ γὰρ καὶ μετὰ τὸ θεωρητικόν ἐστι διὰ τὸ ἐκ τοῦ θεωρητικοῦ ἔρχεσθαι ἐπὶ τὸ πρακτικὸν καὶ μετὰ λόγου κοσμεῖν τὸ ἦθος καὶ ὑποτάσσειν τὰ πάθη, ἀλλ᾿ οὖν οὐ δεῖ καταφρονεῖν αὐτοῦ, ἐπειδή, ὥς φησιν ὁ Πλάτων, ‘φιλόσοφον ἐγὼ οὐ καλῶ τὸν πολλὰ εἰδότα καὶ πολλὰ ἀποστηθίσαι δυνάμενον, ἀλλὰ τὸν ἀκηλίδωτον καὶ ἄρρυπον βίον κτησάμενον’.", "seq": 1543}
{"id": "David_Passim_1544", "series": "CAG", "text": "ἀναγκαίως γάρ ἐστι φιλόσοφος οὐχ ὁ πολλὰ εἰδὼς ἀλλ᾿ ὁ τῶν παθῶν κρατῶν, καὶ αὐτὸς δὲ διὰ τοῦ λόγου τῶν παθῶν κρατεῖ ὡς λογικός.", "seq": 1544}
{"id": "David_Passim_1545", "series": "CAG", "text": "ἔλθωμεν οὖν καὶ εἴπωμεν τὴν διαίρεσιν τοῦ πρακτικοῦ.", "seq": 1545}
{"id": "David_Passim_1546", "series": "CAG", "text": "Ἀλλ᾿ ἰστέον ὅτι ἄλλως τὸ πρακτικὸν διαιροῦσιν οἱ Ἀριστοτελικοὶ καὶ ἄλλως οἱ Πλατωνικοί·", "seq": 1546}
{"id": "David_Passim_1547", "series": "CAG", "text": "οἱ γὰρ Ἀριστοτελικοὶ εἰς τρία αὐτὸ διαιροῦσιν, εἰς ἠθικόν, οἰκονομικόν, πολιτικόν.", "seq": 1547}
{"id": "David_Passim_1548", "series": "CAG", "text": "εἰκότως δὲ εἰς τρία διαιρεῖται, ἐπειδὴ ὁ κοσμῶν ἦθος ἢ ἑνὸς ἦθος κοσμεῖ καὶ γίνεται τὸ ἠθικὸν ἢ οἴκου καὶ γίνεται τὸ οἰκονομικὸν ἢ πόλεως καὶ γίνεται τὸ πολιτικόν·", "seq": 1548}
{"id": "David_Passim_1549", "series": "CAG", "text": "ὅτι γάρ, φασίν, εἰς τὰ τρία ταῦτα διαιρεῖται, δείκνυται διὰ τῶν συγγραμμάτων Ἀριστοτέλους·", "seq": 1549}
{"id": "David_Passim_1550", "series": "CAG", "text": "καὶ γὰρ ὁ Ἀριστοτέλης ἔγραψε τὰ ἠθικά, ἐν οἷς περὶ ἤθους διαλέγεται, ἔγραψε δὲ καὶ τὰ οἰκονομικά, ἐν οἷς περὶ διοικήσεως οἴκου διαλέγεται (ἔνθα λέγει ὅτι τέσσαρά τινα δεῖ συνδραμεῖν εἰς σύστασιν οἴκου·", "seq": 1550}
{"id": "David_Passim_1551", "series": "CAG", "text": "σχέσιν ἀνδρὸς πρὸς γυναῖκα, στοργὴν πατρὸς πρὸς τέκνα, δέος οἰκετῶν πρὸς δεσπότην, καὶ ἵνα ᾖ σύμμετρα τὰ ἐξιόντα τοῖς εἰσιοῦσιν·", "seq": 1551}
{"id": "David_Passim_1552", "series": "CAG", "text": "ἑκατέρα γὰρ ἀμετρία αἰσχρά ἐστιν·", "seq": 1552}
{"id": "David_Passim_1553", "series": "CAG", "text": "εἴτε γὰρ πολλὰ εὑρεθῶσι τὰ εἰσιόντα ὀλίγα δὲ τὰ ἐξιόντα, αἰσχρόν τι συμβαίνει·", "seq": 1553}
{"id": "David_Passim_1554", "series": "CAG", "text": "ὁ γὰρ τοιοῦτος φιλάργυρος εὑρίσκεται.", "seq": 1554}
{"id": "David_Passim_1555", "series": "CAG", "text": "εἴτε πάλιν ὀλίγα εὑρεθῶσι τὰ εἰσιόντα πολλὰ δὲ τὰ ἐξιόντα, αἰσχρόν τι συμβαίνει·", "seq": 1555}
{"id": "David_Passim_1556", "series": "CAG", "text": "εὑρίσκεται γὰρ ὁ τοιοῦτος ἄσωτος), ἔγραψε δὲ καὶ τὰ πολιτικά, ἐν οἷς λέγει πῶς δεῖ πόλιν διοικεῖν.", "seq": 1556}
{"id": "David_Passim_1557", "series": "CAG", "text": "ὁμοίως δὲ καὶ ὁ Πλάτων ἔγραψε πολιτικά·", "seq": 1557}
{"id": "David_Passim_1558", "series": "CAG", "text": "τὸν αὐτὸν δὲ σκοπὸν ἔχει τῷ Ἀριστοτέλει.", "seq": 1558}
{"id": "David_Passim_1559", "series": "CAG", "text": "ἰστέον δὲ ὅτι ἐν μὲν τῷ Πολιτικῷ συγγράμματι ἕνα σκοπὸν ἔχει καὶ ὁ Ἀριστοτέλης καὶ ὁ Πλάτων (ἀμφότεροι γὰρ λέγουσι πῶς δεῖ διοικεῖσθαι πόλιν), ἐν δὲ τῷ Περὶ πολιτείας διάφορός ἐστι καὶ ὁ σκοπὸς καὶ ἡ ἐπιγραφή·", "seq": 1559}
{"id": "David_Passim_1560", "series": "CAG", "text": "καὶ ἡ μὲν ἐπιγραφή, ὅτι ὁ μὲν Πλάτων ἑνικῶς ἐπέγραψε Πολιτεία ὁ δὲ Ἀριστοτέλης πληθυντικῶς Πολιτεῖαι, ὁ δὲ σκοπός ἐστι διάφορος, ὅτι ὁ μὲν Ἀριστοτέλης λέγει πῶς ἐπολιτεύοντο οἱ ἀρχαῖοι οἷον οἱ Ἀργεῖοι, οἱ Βοιωτοί, ὁ δὲ Πλάτων λέγει πόσα εἴδη πολιτειῶν καὶ πῶς δεῖ πολιτεύεσθαι.", "seq": 1560}
{"id": "David_Passim_1561", "series": "CAG", "text": "ταῦτα μὲν ἐν τούτοις.", "seq": 1561}
{"id": "David_Passim_1562", "series": "CAG", "text": "Οἱ δὲ Πλατωνικοὶ λαμβάνονται τῆς διαιρέσεως λέγοντες ὅτι κακῶς ἡ παροῦσα διαίρεσις ἔχει·", "seq": 1562}
{"id": "David_Passim_1563", "series": "CAG", "text": "οὐδέποτε γὰρ γένος εἰς τρία εἴδη διαιρεῖται, ἀλλὰ πάντως εἰς δύο, οἷον τὸ ζῷον εἰς λογικὸν καὶ ἄλογον, τὸ χρῶμα εἰς λευκὸν καὶ μέλαν.", "seq": 1563}
{"id": "David_Passim_1564", "series": "CAG", "text": "ἄλλως τε δὲ οὐδέποτε τὰ ἀντιδιαιρούμενα εἴδη τὸ αὐτὸ τέλος ἔχουσιν, οἷον τὸ λογικὸν καὶ τὸ ἄλογον οὐκ ἔχουσι τὸ αὐτὸ τέλος (τὸ μὲν γὰρ λογικὸν τέλος ἔχει τὸ κεχρῆσθαι λόγῳ, τὸ δὲ ἄλογον τὸ μὴ κεχρῆσθαι λόγῳ), ταῦτα δὲ τὸ αὐτὸ τέλος ἔχουσι·", "seq": 1564}
{"id": "David_Passim_1565", "series": "CAG", "text": "καὶ γὰρ καὶ τὸ ἠθικὸν καὶ τὸ οἰκονομικὸν καὶ τὸ πολιτικὸν τὸ αὐτὸ τέλος ἔχουσι, φημὶ δὲ τὸ κοσμεῖν τὸ ἦθος.", "seq": 1565}
{"id": "David_Passim_1566", "series": "CAG", "text": "ἔτι δὲ οὐδέποτε τὸ ποσὸν τὸ αὐτὸ εἶδος ἐναλλάττει, οἷον τὸ μικρὸν τρίγωνον καὶ τὸ μέγα τρίγωνον τοῦ αὐτοῦ εἴδους εἰσὶ τῷ ποσῷ διαφέροντα.", "seq": 1566}
{"id": "David_Passim_1567", "series": "CAG", "text": "ἐν δὲ τοῖς ἀντιδιαιρουμένοις εἴδεσιν οὐκ ἔστι τὸ αὐτὸ εἶδος·", "seq": 1567}
{"id": "David_Passim_1568", "series": "CAG", "text": "ἄλλο γὰρ εἶδος τοῦ λογικοῦ καὶ ἄλλο τοῦ ἀλόγου.", "seq": 1568}
{"id": "David_Passim_1569", "series": "CAG", "text": "τὸ δὲ ἠθικὸν καὶ τὸ οἰκονομικὸν καὶ τὸ πολιτικὸν ἑνὸς εἴδους εἰσίν·", "seq": 1569}
{"id": "David_Passim_1570", "series": "CAG", "text": "οὐκ ἐπειδὴ γὰρ τὸ μὲν ἠθικὸν ἑνὸς ἦθος κοσμεῖ τὸ δὲ οἰκονομικὸν πλειόνων τὸ δὲ πολιτικὸν ὅλης τῆς πόλεως, παρὰ τοῦτο καὶ διάφορά εἰσιν εἴδη·", "seq": 1570}
{"id": "David_Passim_1571", "series": "CAG", "text": "καὶ γὰρ καὶ ἡ δικαιοσύνη ἡ ἐν μιᾷ ψυχῇ θεωρουμένη καὶ ἡ δικαιοσύνη ἡ ἐν πολλαῖς ψυχαῖς θεωρουμένη ἡ αὐτὴ κατὰ φύσιν ἐστί.", "seq": 1571}
{"id": "David_Passim_1572", "series": "CAG", "text": "ἔτι δὲ οὐδέποτε ἐν τοῖς ἀντιδιαιρουμένοις εἴδεσι τὸ ἕτερον ἐν τῷ ἑτέρῳ θεωρεῖται (οὐδὲ γὰρ τὸ λογικὸν ἐν τῷ ἀλόγῳ θεωρεῖται οὔτε τὸ ἄλογον ἐν τῷ λογικῷ)·", "seq": 1572}
{"id": "David_Passim_1573", "series": "CAG", "text": "εἰ δὲ καὶ τὸ ἠθικὸν καὶ τὸ οἰκονομικὸν ἐν τῷ πολιτικῷ θεωροῦνται (καὶ γὰρ ὁ δυνάμενος κοσμῆσαι πόλιν καὶ οἶκον δύναται κοσμῆσαι καὶ ἕνα), δῆλον ὅτι οὔκ εἰσιν διάφορα.", "seq": 1573}
{"id": "David_Passim_1574", "series": "CAG", "text": "ἔτι δὲ οὐδέποτε ἓν εἶδος μόνον ἰσοδυναμεῖ τῷ γένει (οὔτε γὰρ τὸ λογικὸν μόνον ἰσοδυναμεῖ τῷ ζῴῳ οὔτε τὸ ἄλογον μόνον, ἀλλὰ τὰ δύο ἅμα), τὸ δὲ πολιτικὸν μόνον ἰσοδυναμεῖ τῷ πρακτικῷ·", "seq": 1574}
{"id": "David_Passim_1575", "series": "CAG", "text": "εἰ γὰρ κατ᾿ αὐτούς, φασί, τὸ πρακτικὸν διαιρεῖται εἰς ἠθικὸν καὶ οἰκονομικὸν καὶ πολιτικόν, τὸ δὲ πολιτικὸν περιέχει ἐν ἑαυτῷ καὶ τὸ ἠθικὸν καὶ τὸ οἰκονομικόν (καὶ γὰρ ὁ δυνάμενος πόλιν κοσμῆσαι δύναται καὶ ἕνα κοσμῆσαι καὶ οἶκον), δῆλον ὅτι ἰσοδυναμεῖ τὸ πολιτικὸν τῷ πρακτικῷ.", "seq": 1575}
{"id": "David_Passim_1576", "series": "CAG", "text": "εἰ δὲ ἰσοδυναμεῖ αὐτῷ, δῆλον ὅτι κακῶς ἐγένετο ἡ διαίρεσις.", "seq": 1576}
{"id": "David_Passim_1577", "series": "CAG", "text": "ταῦτα ἐν οἷς σὺν θεῷ ἡ παροῦσα πρᾶξις.", "seq": 1577}
{"id": "David_Passim_1578", "series": "CAG", "text": "Πρᾶξις κδ΄.", "seq": 1578}
{"id": "David_Passim_1579", "series": "CAG", "text": "Λαβόμενοι οἱ Πλατωνικοὶ τῆς Ἀριστοτελικῆς διαιρέσεως τοῦ πρακτικοῦ ἔρχονται καὶ διαιροῦσι τὸ πρακτικὸν εἰς δύο, εἰς νομοθετικὸν καὶ δικαστικόν.", "seq": 1579}
{"id": "David_Passim_1580", "series": "CAG", "text": "καὶ τοῦτο εὐλόγως·", "seq": 1580}
{"id": "David_Passim_1581", "series": "CAG", "text": "ὁ γὰρ φιλόσοφος ἢ τίθησι νόμους, δι᾿ ὧν ὤφειλεν ἀεὶ τὸ ἦθος κοσμεῖν, καὶ γίνεται τὸ νομοθετικόν, ἢ δικάζει κατὰ τοὺς ἐκτεθέντας νόμους καὶ γίνεται τὸ δικαστικόν.", "seq": 1581}
{"id": "David_Passim_1582", "series": "CAG", "text": "καὶ ὃν λόγον ἔχει τὸ νομοθετικὸν πρὸς τὰς πόλεις φυλάττον τὰ ἐν αὐταῖς δίκαια, τοῦτον τὸν λόγον ἔχει καὶ τὸ δικαστικὸν πρὸς τὸ νομοθετικὸν φυλάττον τὰ ἐν αὐτῷ παραγγέλματα·", "seq": 1582}
{"id": "David_Passim_1583", "series": "CAG", "text": "τὸ γὰρ ἠθικὸν καὶ οἰκονομικὸν καὶ πολιτικὸν ὕλης τάξιν ἐπέχουσι πρὸς τὸ νομοθετικὸν καὶ δικαστικόν·", "seq": 1583}
{"id": "David_Passim_1584", "series": "CAG", "text": "καὶ γὰρ ὁ νομοθετῶν ἢ ἑνὸς ἦθος κοσμεῖ ἢ οἴκου ἢ πόλεως διὰ τοῦ νόμους τιθέναι, καθ᾿ οὓς ὤφειλεν ἕκαστος πολιτεύεσθαι.", "seq": 1584}
{"id": "David_Passim_1585", "series": "CAG", "text": "καὶ ὁ δικάζων δὲ ὁμοίως ἢ ἑνὶ δικάζει ἢ οἴκῳ ἢ πόλει.", "seq": 1585}
{"id": "David_Passim_1586", "series": "CAG", "text": "τοῦτο δὲ αὐτό, φημὶ δὲ τὸ νομοθετικὸν καὶ δικαστικόν, καὶ ὁ ποιητὴς αἰνιττόμενος λέγει ὅτι ὁ Μίνως καὶ ὁ Ῥαδάμανθυς ἀδελφοὶ ἦσαν (ἀμφότεροι γὰρ εἶχον πατέρα τὸν Δία), καὶ ὁ μὲν Μίνως ἦν νομοθέτης ὁ δὲ Ῥαδάμανθυς δικαστής, τοῦτο αἰνιττόμενος ὅτι καὶ τὸ νομοθετικὸν καὶ τὸ δικαστικὸν ἀπὸ ἑνὸς τοῦ πρακτικοῦ ἐτέχθησαν.", "seq": 1586}
{"id": "David_Passim_1587", "series": "CAG", "text": "φησὶ δὲ πάλιν ὅτι ὁ μὲν Μίνως πρεσβύτερος ἦν κατὰ τὸν χρόνον ὁ δὲ Ῥαδάμανθυς μεταγενέστερος, τοῦτο αἰνιττόμενος ὅτι τὸ νομοθετικὸν πρὸ τοῦ δικαστικοῦ ἐστι·", "seq": 1587}
{"id": "David_Passim_1588", "series": "CAG", "text": "καὶ γὰρ εἰ μὴ πρότερον θῇ τις νόμους, οὐ δύναται κατ᾿ αὐτοὺς δικάσαι.", "seq": 1588}
{"id": "David_Passim_1589", "series": "CAG", "text": "ἰστέον δὲ ὅτι οὐκ ἐγένετο ἡ διαίρεσις τοῦ πρακτικοῦ εἰς τὸ νομοθετικὸν καὶ δικαστικὸν ὡς ἀπὸ γένους εἰς εἴδη, ἐπειδὴ τὰ εἴδη τὰ ἀπὸ γένους διαιρούμενα οὐκ ἐπιδέχονται τὸ πρότερον καὶ ὕστερον·", "seq": 1589}
{"id": "David_Passim_1590", "series": "CAG", "text": "οἷον τὸ ζῷον διαιρεῖται εἰς λογικὸν καὶ ἄλογον, καὶ οὔτε τὸ λογικὸν πρότερόν ἐστιν οὔτε τὸ ἄλογον, ἀλλ᾿ ἅμα ἐγένοντο.", "seq": 1590}
{"id": "David_Passim_1591", "series": "CAG", "text": "εἰ δὲ τὸ νομοθετικὸν πρὸ τοῦ δικαστικοῦ ἐστιν (εἰ μὴ γάρ τις θῇ πρῶτον νόμους, οὐ δύναται κατ᾿ αὐτοὺς δικάσαι), δῆλον ὅτι οὐκ ἐγένετο ἡ διαίρεσις ὡς ἀπὸ γένους εἰς εἴδη.", "seq": 1591}
{"id": "David_Passim_1592", "series": "CAG", "text": "τοῖς δὲ αὐτοῖς λόγοις χρώμενος, οἷσπερ ἐχρησάμεθα καὶ ἐπὶ τοῦ φυσιολογικοῦ καὶ μαθηματικοῦ καὶ θεολογικοῦ, εὑρήσεις ὅτι οὐδὲ καθ᾿ ἕνα τῶν ἄλλων τρόπων ἐγένετο ἡ διαίρεσις, ἀλλ᾿ εἰσὶ τῶν ἀφ᾿ ἑνός·", "seq": 1592}
{"id": "David_Passim_1593", "series": "CAG", "text": "ἀφ᾿ ἑνὸς γὰρ τοῦ πρακτικοῦ καὶ τὸ νομοθετικὸν καὶ τὸ δικαστικὸν λέγεται πρακτικόν.", "seq": 1593}
{"id": "David_Passim_1594", "series": "CAG", "text": "Μαθόντες οὖν διὰ τῶν προλαβόντων τί ἐστιν ἡ φιλοσοφία, ἔλθωμεν καὶ ἐπὶ τὸ ὁποῖόν τί ἐστιν.", "seq": 1594}
{"id": "David_Passim_1595", "series": "CAG", "text": "ἀλλὰ καὶ τοῦτο διὰ τῶν προλαβόντων μεμαθήκαμεν, φημὶ δὲ διά τε τῶν ὁρισμῶν καὶ τῆς διαιρέσεως.", "seq": 1595}
{"id": "David_Passim_1596", "series": "CAG", "text": "καὶ διὰ μὲν τῆς διαιρέσεως ἐμάθομεν ὅτι θεωρητική ἐστι καὶ πρακτική·", "seq": 1596}
{"id": "David_Passim_1597", "series": "CAG", "text": "εἰς γὰρ ταῦτα τὰ δύο διείλομεν τὴν φιλοσοφίαν, φημὶ δὴ εἰς θεωρητικὸν καὶ πρακτικόν.", "seq": 1597}
{"id": "David_Passim_1598", "series": "CAG", "text": "εἰ δέ τις εἴποι ὅτι οὐ μόνον ἡ φιλοσοφία ἐστὶ θεωρητικὴ καὶ πρακτική, ἀλλὰ καὶ αἱ τέχναι εἰσὶ θεωρητικαὶ καὶ πρακτικαί (ἰδοὺ γὰρ ἡ ἰατρικὴ καὶ θεωρητική ἐστιν, ὡς ἡνίκα διαγινώσκει τὸ νόσημα καὶ λέγει τὰς αἰτίας τὸ πόθεν γέγονε, καὶ πρακτική, ὡς ἡνίκα ἢ καθάρσιον δίδωσιν ἢ φλεβοτομεῖ), λέγομεν ὅτι κυρίως μόνη ἡ φιλοσοφία ἐστὶ θεωρητικὴ καὶ πρακτική.", "seq": 1598}
{"id": "David_Passim_1599", "series": "CAG", "text": "καὶ θεωρητικὴ μὲν κυρίως μόνη ἐστίν, ὅτι αἱ μὲν τέχναι οὐ πάντα τὰ ὄντα γινώσκουσιν, ἀλλὰ περὶ τὰ ἔνυλα μόνα καταγίνονται, ἐπεὶ περὶ τὰ θεῖα οὐ καταγίνονται, ἡ δὲ φιλοσοφία περὶ πάντα τὰ ὄντα καταγίνεται·", "seq": 1599}
{"id": "David_Passim_1600", "series": "CAG", "text": "καὶ γὰρ καὶ περὶ τὰ θεῖα καταγίνεται.", "seq": 1600}
{"id": "David_Passim_1601", "series": "CAG", "text": "ὅθεν καὶ θεωρητικὴ μᾶλλον αὕτη μόνη κυρίως λέγεται·", "seq": 1601}
{"id": "David_Passim_1602", "series": "CAG", "text": "θεωρία γὰρ λέγεται παρὰ τὸ τὰ θεῖα ὁρᾶν.", "seq": 1602}
{"id": "David_Passim_1603", "series": "CAG", "text": "ἀλλὰ καὶ πρακτικὴ μόνη κυρίως ἐστὶν ἡ φιλοσοφία, ἐπειδὴ αἱ μὲν τέχναι ἢ περὶ τὸ σῶμα ἐνεργοῦσιν, ὥσπερ ἡ ἰατρικὴ περὶ τὸ ἀνθρώπινον σῶμα ἐνεργεῖ, ἢ περὶ τὰ ἐκτὸς ὥσπερ ἡ τεκτονικὴ καὶ ἡ χαλκευτικὴ καὶ ἡ οἰκοδομική·", "seq": 1603}
{"id": "David_Passim_1604", "series": "CAG", "text": "αὗται γὰρ οὐκ ἐνεργοῦσι περὶ τὸ ἀνθρώπινον σῶμα, ἀλλὰ περὶ τὰ ἐκτὸς καὶ περὶ τὰς περιουσίας·", "seq": 1604}
{"id": "David_Passim_1605", "series": "CAG", "text": "ἡ μὲν γὰρ θρόνον καὶ σκάμνον καὶ τὰ τοιαῦτα ποιεῖ ἡ δὲ ξέστην καὶ τὰ τοιαῦτα ἡ δὲ οἶκον, ἅτινα τῶν ἐκτὸς καὶ τῶν περιουσιῶν εἰσιν.", "seq": 1605}
{"id": "David_Passim_1606", "series": "CAG", "text": "ἡ δὲ φιλοσοφία περὶ τὴν ψυχὴν ἐνεργεῖ·", "seq": 1606}
{"id": "David_Passim_1607", "series": "CAG", "text": "καὶ γὰρ τὸ τῆς ψυχῆς ὄμμα ὑπὸ τῶν σωματικῶν ἡδυπαθειῶν ἀμβλυῶττον καὶ ἐπισκοτιζόμενον διὰ τῆς φιλοσοφίας ἐγείρεσθαι καὶ φωτίζεσθαι πέφυκεν.", "seq": 1607}
{"id": "David_Passim_1608", "series": "CAG", "text": "αὕτη δὲ ἡ περὶ τὴν ψυχὴν ἐνέργεια ἀναγκαιοτέρα τῶν ἐνεργειῶν ἐστι τῶν περὶ τὸ σῶμα καὶ τὰ ἐκτὸς καταγινομένων, ὅσον ἐστὶ ψυχὴ σώματος καὶ τῶν ἐκτὸς ἀναγκαιοτέρα.", "seq": 1608}
{"id": "David_Passim_1609", "series": "CAG", "text": "ὥστε οὖν κυρίως μόνη ἡ φιλοσοφία πρακτικὴ λέγεται.", "seq": 1609}
{"id": "David_Passim_1610", "series": "CAG", "text": "Ἔγνωσται οὖν, ὡς εἴρηται, διὰ τῆς διαιρέσεως ὁποῖόν τί ἐστιν ἡ φιλοσοφία·", "seq": 1610}
{"id": "David_Passim_1611", "series": "CAG", "text": "ἐμάθομεν γὰρ ὅτι θεωρητική ἐστι καὶ πρακτική.", "seq": 1611}
{"id": "David_Passim_1612", "series": "CAG", "text": "ἀλλὰ καὶ διὰ τῶν ὁρισμῶν ἔγνωμεν ὁποῖόν τί ἐστι·", "seq": 1612}
{"id": "David_Passim_1613", "series": "CAG", "text": "καὶ γὰρ διὰ τῶν ἐκ τοῦ ὑποκειμένου ὁρισμῶν διά τε τοῦ λέγοντος ὅτι ‘φιλοσοφία ἐστὶ γνῶσις τῶν ὄντων ᾗ ὄντα ἐστί’ καὶ διὰ τοῦ λέγοντος ‘γνῶσις θείων τε καὶ ἀνθρωπίνων πραγμάτων’ ἐμάθομεν ὅτι θεωρητική ἐστιν ἡ φιλοσοφία, διὰ δὲ τοῦ ὅρου τοῦ ἐκ τῆς ὑπεροχῆς τοῦ λέγοντος ὅτι ‘φιλοσοφία ἐστὶ τέχνη τεχνῶν καὶ ἐπιστήμη ἐπιστημῶν’ ἐμάθομεν ὅτι ἀρχική ἐστι, διὰ δὲ τοῦ ὅρου τοῦ ἐκ τοῦ προσεχοῦς τέλους τοῦ λέγοντος ὅτι ‘φιλοσοφία ἐστὶ μελέτη θανάτου’ ἐμάθομεν ὅτι καθαρτική ἐστι (καὶ γὰρ τὸ μελέτη θανάτου οὐδὲν ἕτερόν ἐστιν εἰ μὴ ἡ νέκρωσις τῶν παθῶν ἤγουν ἡ κάθαρσις τῆς ψυχῆς ἐκ τῶν παθῶν), διὰ δὲ τοῦ ὅρου τοῦ ἐκ τοῦ πόρρω τέλους τοῦ λέγοντος ὅτι ‘φιλοσοφία ἐστὶν ὁμοίωσις θεῷ κατὰ τὸ δυνατὸν ἀνθρώπῳ’ ἐμάθομεν ὅτι πολιτική ἐστι·", "seq": 1613}
{"id": "David_Passim_1614", "series": "CAG", "text": "καὶ γὰρ ὁ πολιτικὸς φιλόσοφος θέλει καὶ κατὰ τὴν γνῶσιν καὶ κατὰ τὴν πρᾶξιν ἐφ᾿ ὅσον ἐστὶ δυνατὸν ἀνθρώπῳ μιμεῖσθαι τὸ θεῖον, καὶ κατὰ τὴν γνῶσιν μὲν ἵνα πάντα τὰ ὄντα γινώσκῃ, κατὰ τὴν πρᾶξιν δὲ ἵνα τὰ ἤθη κοσμῇ καὶ εὐταξίαν τινὰ φυλάττῃ ἐν τῷ ἀνθρώπῳ διὰ τῶν ἀρετῶν.", "seq": 1614}
{"id": "David_Passim_1615", "series": "CAG", "text": "καὶ ἔστιν ὡς ἐν συντόμῳ εἰπεῖν ὅτι δύο μερῶν ὄντων τῆς φιλοσοφίας, φημὶ δὲ τοῦ θεωρητικοῦ καὶ τοῦ πρακτικοῦ, ἓξ δὲ ὁρισμῶν οἱ μὲν τῶν ὁρισμῶν τὸ θεωρητικὸν μέρος τῆς φιλοσοφίας περιέχουσιν, οἱ δὲ τὸ πρακτικόν, οἱ δὲ τὸ θεωρητικὸν ἅμα καὶ πρακτικόν·", "seq": 1615}
{"id": "David_Passim_1616", "series": "CAG", "text": "καὶ γὰρ οἱ δύο οἱ ἐκ τοῦ ὑποκειμένου οἷον ὁ ‘φιλοσοφία ἐστὶ γνῶσις τῶν ὄντων ᾗ ὄντα ἐστί’ καὶ ὁ λέγων ὅτι ‘φιλοσοφία ἐστὶ γνῶσις θείων τε καὶ ἀνθρωπίνων πραγμάτων’ καὶ ὁ ἐκ τῆς ὑπεροχῆς ὁ λέγων ὅτι ‘φιλοσοφία ἐστὶ τέχνη τεχνῶν καὶ ἐπιστήμη ἐπιστημῶν’ τὸ θεωρητικὸν μέρος τῆς φιλοσοφίας περιέχουσι·", "seq": 1616}
{"id": "David_Passim_1617", "series": "CAG", "text": "καὶ γὰρ ὁ ἐκ τῆς ὑπεροχῆς τὸ θεωρητικὸν περιέχει·", "seq": 1617}
{"id": "David_Passim_1618", "series": "CAG", "text": "τοῦτο γὰρ δηλοῖ ὁ ἐκ τῆς ὑπεροχῆς, ὅτι ἡ φιλοσοφία δίδωσι τὰς ἀρχὰς ταῖς τέχναις καὶ ταῖς ἄλλαις ἐπιστήμαις γινώσκουσα αὐτάς.", "seq": 1618}
{"id": "David_Passim_1619", "series": "CAG", "text": "ὁ δὲ εἷς ὁ ἀπὸ τοῦ προσεχοῦς τέλους ὁ λέγων ὅτι ‘φιλοσοφία ἐστὶ μελέτη θανάτου’ καὶ ὁ ἀπὸ τῆς ἐτυμολογίας ὁ λέγων ὅτι ‘φιλοσοφία ἐστὶ φιλία σοφίας’ τὸ πρακτικὸν μέρος τῆς φιλοσοφίας περιέχουσι·", "seq": 1619}
{"id": "David_Passim_1620", "series": "CAG", "text": "καὶ γὰρ τὸ μελετᾶν τὸν θάνατον ἤγουν τὸ νέκρωσιν τῶν παθῶν ἀπεργάζεσθαι τοῦ πρακτικοῦ ἐστιν, ὁμοίως καὶ τὸ ἐφίεσθαι τῆς σοφίας τοῦ πρακτικοῦ ἐστιν.", "seq": 1620}
{"id": "David_Passim_1621", "series": "CAG", "text": "ὁ δὲ ὅρος ὁ ἀπὸ τοῦ πόρρω τέλους ὁ λέγων ὅτι ‘φιλοσοφία ἐστὶν ὁμοίωσις θεῷ κατὰ τὸ δυνατὸν ἀνθρώπῳ’ περιέχει καὶ τὸ θεωρητικὸν μέρος τῆς φιλοσοφίας καὶ τὸ πρακτικόν·", "seq": 1621}
{"id": "David_Passim_1622", "series": "CAG", "text": "καὶ γὰρ ὁ θέλων ὁμοιοῦσθαι τῷ θεῷ ἐφ᾿ ὅσον ἀνθρώπῳ δυνατὸν θέλει καὶ κατὰ τὴν γνῶσιν ὁμοιοῦσθαι αὐτῷ καὶ κατὰ τὴν πρᾶξιν.", "seq": 1622}
{"id": "David_Passim_1623", "series": "CAG", "text": "καὶ κατὰ τὴν γνῶσιν μὲν ἵνα γινώσκῃ πάντα, κατὰ τὴν πρᾶξιν δὲ ἵνα κοσμῇ τὰ ἤθη καὶ εὐταξίαν φυλάττῃ ἐν τῷ ἀνθρώπῳ διὰ τῶν ἀρετῶν.", "seq": 1623}
{"id": "David_Passim_1624", "series": "CAG", "text": "Μαθόντες οὖν ὁποῖόν τί ἐστιν ἡ φιλοσοφία, ἔλθωμεν καὶ μάθωμεν τὸ διὰ τί ἐστιν·", "seq": 1624}
{"id": "David_Passim_1625", "series": "CAG", "text": "οὐδὲ γὰρ μάτην ἐστὶν ἡ φιλοσοφία, εἴ γε, ὥς φησιν ὁ Πλάτων πρός τινα Θεόδωρον ποιούμενος τοὺς λόγους, ‘τοιοῦτόν τι, ὦ Θεόδωρε, ἀγαθὸν οὔτε ἧκέ ποτε εἰς ἀνθρώπους δωρηθὲν ἐκ θεοῦ οὔτε ἥξει ποτέ’.", "seq": 1625}
{"id": "David_Passim_1626", "series": "CAG", "text": "ἰστέον οὖν ὅτι διὰ τοῦτό ἐστιν ἡ φιλοσοφία διὰ τὸ κοσμεῖν τὰς τῶν ἀνθρώπων ψυχὰς καὶ διὰ τὸ ἐκ τοῦ ἀχλυώδους καὶ ὑλώδους τούτου βίου μεταφέρειν τὴν ψυχὴν ἐπὶ τὰ θεῖα καὶ ἄυλα κατὰ τὴν Ὁμηρικὴν Ἀθηνᾶν,", "seq": 1626}
{"id": "David_Passim_1627", "series": "CAG", "text": "ὄφρ᾿ εὖ γιγνώσκῃ ἠμὲν θεὸν ἠδὲ καὶ ἄνδρα.", "seq": 1627}
{"id": "David_Passim_1628", "series": "CAG", "text": "δεῖ γὰρ γινώσκειν ὅτι ἡ ψυχὴ διττὰς ἔχει δυνάμεις·", "seq": 1628}
{"id": "David_Passim_1629", "series": "CAG", "text": "τὰς μὲν γὰρ γνωστικὰς ἔχει, τὰς δὲ ζωτικάς.", "seq": 1629}
{"id": "David_Passim_1630", "series": "CAG", "text": "καὶ γνωστικαὶ μέν εἰσιν αὗται·", "seq": 1630}
{"id": "David_Passim_1631", "series": "CAG", "text": "νοῦς διάνοια δόξα αἴσθησις φαντασία.", "seq": 1631}
{"id": "David_Passim_1632", "series": "CAG", "text": "ζωτικαὶ δὲ αὗται·", "seq": 1632}
{"id": "David_Passim_1633", "series": "CAG", "text": "βούλησις καὶ προαίρεσις, θυμὸς καὶ ἐπιθυμία.", "seq": 1633}
{"id": "David_Passim_1634", "series": "CAG", "text": "καὶ ἐν ἑκατέρῳ τούτων αἱ μὲν λογικαί εἰσιν αἱ δὲ ἄλογοι·", "seq": 1634}
{"id": "David_Passim_1635", "series": "CAG", "text": "καὶ γὰρ ἐν ταῖς γνωστικαῖς δυνάμεσιν αἱ μέν εἰσι λογικαὶ αἱ δὲ ἄλογοι, καὶ λογικαὶ μέν εἰσι νοῦς διάνοια καὶ δόξα ἡ μετὰ λόγου, ἄλογοι δὲ αἴσθησις φαντασία καὶ δόξα ἡ ἄλογος·", "seq": 1635}
{"id": "David_Passim_1636", "series": "CAG", "text": "καὶ γὰρ καὶ ἡ ἄλογος αἴσθησις καὶ ἐν τοῖς ἀλόγοις ζῴοις θεωρεῖται καὶ ἡ φαντασία ὁμοίως·", "seq": 1636}
{"id": "David_Passim_1637", "series": "CAG", "text": "καὶ γὰρ τὸ ἄλογον ζῷον ἐὰν πολλάκις παρέλθῃ ἐκ τόπου, φαντάζεται αὐτὸν καὶ γνωρίζει αὐτόν, ὅθεν καὶ τὰ πολλὰ τῶν ἀλόγων ζῴων ἀφ᾿ ἑαυτῶν εἰς τὴν οἰκείαν φάτνην ἐπέρχονται.", "seq": 1637}
{"id": "David_Passim_1638", "series": "CAG", "text": "ἡ δὲ ἄλογος δόξα ἄλογος λέγεται οὐ διότι καὶ ἐν τοῖς ἀλόγοις ζῴοις θεωρεῖται, ἀλλ᾿ ἄλογος λέγεται διότι αἰτίας ἐστέρηται, οἷον ὡς ὅταν τις δοξάζῃ τὴν ψυχὴν ἀθάνατον εἶναι, μὴ λέγων αἰτίαν, ἀλλὰ λέγων ‘οὕτω παρέλαβον’.", "seq": 1638}
{"id": "David_Passim_1639", "series": "CAG", "text": "καὶ ἐν ταῖς ζωτικαῖς δὲ δυνάμεσιν αἱ μέν εἰσι λογικαὶ αἱ δὲ ἄλογοι.", "seq": 1639}
{"id": "David_Passim_1640", "series": "CAG", "text": "καὶ λογικαὶ μέν εἰσι βούλησις καὶ προαίρεσις (αὗται γὰρ ἐν τοῖς λογικοῖς μόνοις ζῴοις θεωροῦνται, οὐ μὴν καὶ ἐν τοῖς ἀλόγοις·", "seq": 1640}
{"id": "David_Passim_1641", "series": "CAG", "text": "τὰ γὰρ ἄλογα ζῷα οὐκ ἔχουσι βούλησιν καὶ προαίρεσιν), ἄλογοι δέ εἰσι θυμὸς καὶ ἐπιθυμία·", "seq": 1641}
{"id": "David_Passim_1642", "series": "CAG", "text": "καὶ γὰρ καὶ τὰ ἄλογα ζῷα καὶ θυμοῦνται καὶ ἐπιθυμοῦσι.", "seq": 1642}
{"id": "David_Passim_1643", "series": "CAG", "text": "τούτων οὖν οὕτως ἐχόντων διὰ τοῦτο ἐπενοήθη ἡ φιλοσοφία διὰ τὸ τὰς τῶν ἀνθρώπων ψυχὰς κοσμεῖν, καὶ τὰς μὲν γνωστικὰς δυνάμεις κοσμεῖν διὰ τοῦ θεωρητικοῦ τὰς δὲ ζωτικὰς διὰ τοῦ πρακτικοῦ, ἤγουν διὰ τοῦ ποιεῖν ἡμᾶς κρατεῖν θυμοῦ καὶ ἐπιθυμίας καὶ μὴ ἐᾶν ἡμᾶς παρὰ τὸ δέον μήτε θυμοῦσθαι μήτε ἐπιθυμεῖν.", "seq": 1643}
{"id": "David_Passim_1644", "series": "CAG", "text": "ταῦτα μὲν ἐν τούτοις, ἐν οἷς σὺν θεῷ καὶ ἡ παροῦσα πρᾶξις καὶ τὰ προλεγόμενα τῆς φιλοσοφίας.", "seq": 1644}
{"id": "David_Passim_1645", "series": "CAG", "text": "ΠΡΟΛΕΓΟΜΕΝΑ ΣΥΝ ΘΕΩΙ ΤΗΣ ΠΟΡΦΥΡΙΟΥ ΕΙΣΑΓΩΓΗΣ ΑΠΟ ΦΩΝΗΣ ΔΑΒΙΔ ΤΟΥ ΘΕΟΦΙΛΕΣΤΑΤΟΥ ΚΑΙ ΘΕΟΦΡΟΝΟΣ ΦΙΛΟΣΟΦΟΥ.", "seq": 1645}
{"id": "David_Passim_1646", "series": "CAG", "text": "<Πρᾶξις α΄>.", "seq": 1646}
{"id": "David_Passim_1647", "series": "CAG", "text": "Μέλλοντες σὺν θεῷ ἄρχεσθαι τοῦ παρόντος συγγράμματος τὰ εἰωθότα ὑπὸ τῶν ἐξηγητῶν ζητεῖσθαι κεφάλαια, ὀκτὼ τὸν ἀριθμὸν ὄντα, ζητήσωμεν.", "seq": 1647}
{"id": "David_Passim_1648", "series": "CAG", "text": "κεφάλαια δὲ ταῦτα λέγονται, διότι τὸ κῦρος παντὸς τοῦ λόγου ἐπέχουσιν·", "seq": 1648}
{"id": "David_Passim_1649", "series": "CAG", "text": "ὥσπερ γὰρ ἡ κεφαλὴ τὸ κῦρος παντὸς τοῦ ζῴου ἐπέχει, διότι αἱ αἰσθήσεις ἐν αὐτῇ εἰσιν ἢ διότι τὴν βασιλεύουσαν τῶν αἰσθήσεων, φημὶ δὴ τὴν ὅρασιν, αὐτὴ ἔχει, τὸν αὐτὸν τρόπον καὶ ταῦτα τὰ λεγόμενα κεφάλαια τὸ κῦρος παντὸς τοῦ λόγου ἐπέχουσιν.", "seq": 1649}
{"id": "David_Passim_1650", "series": "CAG", "text": "εἰσὶ δέ, ὡς εἴρηται, τὰ ὀκτὼ τὸν ἀριθμὸν κεφάλαια ταῦτα·", "seq": 1650}
{"id": "David_Passim_1651", "series": "CAG", "text": "οἷον ὁ σκοπός, τὸ χρήσιμον, τὸ γνήσιον, ἡ αἰτία τῆς ἐπιγραφῆς, ἡ εἰς τὰ κεφάλαια διαίρεσις, ἡ τάξις, ὁ διδασκαλικὸς τρόπος καὶ ἡ ὑπὸ τί μέρος ἀναφορά.", "seq": 1651}
{"id": "David_Passim_1652", "series": "CAG", "text": "Οὐ περιττὸν δέ τι ποιοῦντες ταῦτα ζητοῦσιν, ἀλλὰ βουλόμενοι προθυμοτέρους τοὺς ἀναγινώσκοντας ἀπεργάσασθαι·", "seq": 1652}
{"id": "David_Passim_1653", "series": "CAG", "text": "καὶ γὰρ τὸν σκοπὸν ζητοῦσιν, ἐπειδὴ ὁ σκοπὸς ἐν συντόμῳ περιέχει πάντα τὰ ἐν τῷ λόγῳ λεγόμενα καὶ ἕξιν τινὰ ἐν τῷ ἀναγινώσκοντι τίθησι [δῆλον ὅτι πάντα τὰ ἐν τῷ λόγῳ λεγόμενα δεῖ πρὸς τὸν σκοπὸν ἀπευθύνεσθαι]·", "seq": 1653}
{"id": "David_Passim_1654", "series": "CAG", "text": "ὁ γὰρ τὸν σκοπὸν ἀγνοῶν ὀκνηρότερος ἐπὶ τὸ σύγγραμμα ἔρχεται, ὥσπερ οἱ μακρὰν ὁδὸν ἀπιόντες καὶ ἀγνοοῦντες ποῦ ἀπέρχονται.", "seq": 1654}
{"id": "David_Passim_1655", "series": "CAG", "text": "καὶ ἁπλῶς εἰπεῖν ὁ τὸν σκοπὸν ἀγνοῶν ἔοικε τυφλῷ βαδίζοντι καὶ πολλὰ μοχθοῦντι·", "seq": 1655}
{"id": "David_Passim_1656", "series": "CAG", "text": "καὶ γὰρ ὁ τὸν σκοπὸν ἀγνοῶν οὐκ ἐπίσταται τί ἀναγινώσκει, ἀλλὰ νομίζει πάντα τὰ ἐν τῷ λόγῳ λεγόμενα μάτην λέγεσθαι.", "seq": 1656}
{"id": "David_Passim_1657", "series": "CAG", "text": "εὐλόγως δὲ καὶ τὸ χρήσιμον ζητοῦσιν, ἐπειδὴ ἐὰν γινώσκῃ ἕκαστος τὸ ἐκ τοῦ συγγράμματος ἀναφυόμενον χρήσιμον, προθυμότερον ἀναγινώσκει τὸ σύγγραμμα.", "seq": 1657}
{"id": "David_Passim_1658", "series": "CAG", "text": "καὶ τὴν αἰτίαν δὲ τῆς ἐπιγραφῆς εὐλόγως ζητοῦσιν, ἐπειδὴ εἰ καὶ θέλει ἡ ἐπιγραφὴ σύμφωνος εἶναι τῷ σκοπῷ καὶ τὸν σκοπὸν ἐν συντόμῳ περιέχειν (οἷον ὥσπερ ἐπιγέγραπται Περὶ οὐρανοῦ, ἐπειδὴ περὶ οὐρανοῦ σκοπὸν ἔχει διαλαβεῖν), ἀλλ᾿ οὖν πολλάκις ἀσαφὴς εὑρίσκεται ἡ ἐπιγραφή, ὥσπερ Ἀριστοτέλης ἐπέγραψεν Ἀναλυτικὰ βουλόμενος Περὶ συλλογισμῶν ἐπιγράψαι, ἐπειδὴ περὶ συλλογισμῶν διαλαμβάνει ἐκεῖ.", "seq": 1658}
{"id": "David_Passim_1659", "series": "CAG", "text": "ἐπειδὴ οὖν πολλάκις ἀσαφὴς εὑρίσκεται ἡ ἐπιγραφή, εὐλόγως ζητεῖται ἡ αἰτία τῆς ἐπιγραφῆς.", "seq": 1659}
{"id": "David_Passim_1660", "series": "CAG", "text": "εὐλόγως δὲ καὶ τὸ γνήσιον ζητεῖται, ἐπειδὴ γινώσκοντες ὅτι γνήσιόν ἐστι τοῦ ἀνδρὸς τὸ σύγγραμμα διὰ τὸ ἀξίωμα τοῦ ἀνδρὸς προθυμότερον αὐτὸ ἀναγινώσκομεν·", "seq": 1660}
{"id": "David_Passim_1661", "series": "CAG", "text": "καὶ γὰρ πολλοὶ οὔκ εἰσιν ἱκανοὶ κρῖναι εἴτε καλῶς ἔχουσι τὰ ἐν τῷ συγγράμματι λεγόμενα εἴτε οὔ, ἀλλ᾿ ἀγαπητὸν ἡγοῦνται τὸ ἀκολουθῆσαι τῇ δόξῃ τοῦ ἀνδρός.", "seq": 1661}
{"id": "David_Passim_1662", "series": "CAG", "text": "ἢ διὰ τοῦτο ζητεῖται τὸ γνήσιον, ἐπειδὴ εἰσὶ καὶ νόθα συγγράμματα.", "seq": 1662}
{"id": "David_Passim_1663", "series": "CAG", "text": "Γίνεται δὲ νόθον σύγγραμμα κατὰ τέσσαρας τρόπους·", "seq": 1663}
{"id": "David_Passim_1664", "series": "CAG", "text": "ἢ γὰρ δι᾿ ὁμωνυμίαν, καὶ ταύτην διττήν·", "seq": 1664}
{"id": "David_Passim_1665", "series": "CAG", "text": "ἢ γὰρ δι᾿ ὁμωνυμίαν τῶν συγγραψαμένων ἢ δι᾿ ὁμωνυμίαν τῶν συγγραμμάτων.", "seq": 1665}
{"id": "David_Passim_1666", "series": "CAG", "text": "καὶ δι᾿ ὁμωνυμίαν τῶν συγγραψαμένων, ὡς ὅταν εὑρεθῶσι δύο τινὲς ὁμωνύμως λεγόμενοι καὶ ποιήσῃ ὁ μὲν εἷς σύγγραμμα Περὶ ψυχῆς ὁ δὲ ἕτερος σύγγραμμα Περὶ οὐρανοῦ·", "seq": 1666}
{"id": "David_Passim_1667", "series": "CAG", "text": "τότε γὰρ διὰ τὴν ὁμωνυμίαν τῶν συγγραψαμένων νοθεία γίνεται τῶν συγγραμμάτων·", "seq": 1667}
{"id": "David_Passim_1668", "series": "CAG", "text": "νομίζεται γὰρ τὸ τούτου ἐκείνου εἶναι καὶ τὸ ἐκείνου τούτου.", "seq": 1668}
{"id": "David_Passim_1669", "series": "CAG", "text": "δι᾿ ὁμωνυμίαν δὲ τῶν συγγραμμάτων, ὡς ὅταν εὑρεθῶσί τινες διαφόρῳ ὀνόματι λεγόμενοι καὶ ποιήσωσιν ἀμφότεροι συγγράμματα τὸν αὐτὸν σκοπὸν ἔχοντα, οἷον ἀμφότεροι Περὶ ψυχῆς, καὶ μὴ ἐπιγράψωσι τὰ οἰκεῖα ὀνόματα ἀλλὰ μόνον τὸ τοῦ συγγράμματος ὄνομα·", "seq": 1669}
{"id": "David_Passim_1670", "series": "CAG", "text": "τότε γὰρ διὰ τὴν τῶν συγγραμμάτων ὁμωνυμίαν νοθεία γίνεται·", "seq": 1670}
{"id": "David_Passim_1671", "series": "CAG", "text": "νομίζεται γὰρ τὸ ἐκείνου τοῦ ἄλλου εἶναι καὶ τὸ τοῦ ἄλλου ἐκείνου.", "seq": 1671}
{"id": "David_Passim_1672", "series": "CAG", "text": "Κατὰ δεύτερον δὲ τρόπον γίνεται νόθον σύγγραμμα διὰ φιλοτιμίαν ἤτοι κενοδοξίαν, ὡς ὅταν τις εὑρεθῇ ἀφανὴς καὶ εὐτελὴς καὶ βουλόμενος ποιῆσαι τὸ οἰκεῖον σύγγραμμα ἀναγινώσκεσθαι ἐπιγράψῃ ὄνομα ἀρχαίου καὶ ἐνδόξου ἀνδρός, ἵνα διὰ τῆς ἀξιοπιστίας τοῦ ἀνδρὸς δεκτὸν τὸ παρὸν αὐτοῦ φαίνηται σύγγραμμα.", "seq": 1672}
{"id": "David_Passim_1673", "series": "CAG", "text": "Κατὰ τρίτον δὲ τρόπον γίνεται νόθον σύγγραμμα δι᾿ αἰσχροκέρδειαν, ὡς ὅταν τις βουλόμενος πόρον ἑαυτῷ περιποιήσασθαι ποιήσῃ σύγγραμμα καὶ ἐπιγράψῃ ἀρχαίου τινὸς ὄνομα, ὅπερ καὶ ἐπὶ τοῦ Πεισιστράτου φασὶ γενέσθαι·", "seq": 1673}
{"id": "David_Passim_1674", "series": "CAG", "text": "καὶ γὰρ λέγουσιν ὅτι ὁ Πεισίστρατος χύδην φερομένους τοὺς Ὁμήρου στίχους ἠβουλήθη συναγαγεῖν καὶ διώρισε μισθόν τινα τοῖς φέρουσιν αὐτῷ Ὁμηρικοὺς στίχους, καὶ λοιπὸν οἱ πολλοὶ δι᾿ αἰσχροκέρδειαν ἐπλάττοντο στίχους καὶ ὡς Ὁμήρου ὄντας ἐπέφερον αὐτῷ κέρδος ἐντεῦθεν προσκτώμενοι.", "seq": 1674}
{"id": "David_Passim_1675", "series": "CAG", "text": "Κατὰ τέταρτον δὲ τρόπον γίνεται νόθον σύγγραμμα δι᾿ εὔνοιαν τοῦ οἰκείου διδασκάλου·", "seq": 1675}
{"id": "David_Passim_1676", "series": "CAG", "text": "καὶ γὰρ πολλοὶ ποιοῦσι συγγράμματα καὶ διὰ τὴν εὔνοιαν τὴν πρὸς τὸν διδάσκαλον τὸ ὄνομα τοῦ οἰκείου διδασκάλου ἐπιγράφουσιν, ὅπερ καὶ οἱ Πυθαγόρειοι ἐποίησαν·", "seq": 1676}
{"id": "David_Passim_1677", "series": "CAG", "text": "καὶ γὰρ οὗτοι ἐποίησαν τὰ Χρυσᾶ ἔπη καὶ πρὸς τιμὴν τοῦ οἰκείου διδασκάλου ἐπέγραψαν τὸ ὄνομα αὐτοῦ.", "seq": 1677}
{"id": "David_Passim_1678", "series": "CAG", "text": "ἐπειδὴ οὖν, ὡς εἴρηται, πολλά εἰσι νόθα συγγράμματα, τούτου χάριν ἀναγκαίως ζητεῖται τὸ γνήσιον, ἵνα γνῶμεν εἰ ἄρα αὐτοῦ εἰσιν ἢ ἄλλου.", "seq": 1678}
{"id": "David_Passim_1679", "series": "CAG", "text": "Διακρίνονται δὲ τὰ γνήσια συγγράμματα τῇ τε ὕλῃ καὶ τῷ εἴδει·", "seq": 1679}
{"id": "David_Passim_1680", "series": "CAG", "text": "τῇ ὕλῃ μὲν τῇ φράσει ἤγουν ταῖς λέξεσι, τῷ εἴδει δὲ τοῦτ᾿ ἔστι τοῖς θεωρήμασι·", "seq": 1680}
{"id": "David_Passim_1681", "series": "CAG", "text": "καὶ γὰρ διὰ τῆς φράσεως καὶ τῶν θεωρημάτων γινώσκομεν εἰ ἄρα αὐτοῦ εἰσι ἢ οὔ·", "seq": 1681}
{"id": "David_Passim_1682", "series": "CAG", "text": "εἰ γὰρ εὕρωμεν τὴν φράσιν καὶ τὰ θεωρήματα συνήθη τῷ ἀνδρί, γινώσκομεν ὅτι αὐτοῦ ἐστι τὸ σύγγραμμα.", "seq": 1682}
{"id": "David_Passim_1683", "series": "CAG", "text": "Εὐλόγως δὲ καὶ ἡ εἰς τὰ κεφάλαια διαίρεσις ζητεῖται, ἐπειδὴ γινώσκοντες τὰ ἐν τοῖς κεφαλαίοις λεγόμενα ἀκριβῶς τὸ ὅλον γινώσκομεν·", "seq": 1683}
{"id": "David_Passim_1684", "series": "CAG", "text": "καὶ γὰρ ὥσπερ γινώσκοντες ἐκ ποίων μερῶν συνίσταται ὁ ἄνθρωπος ἀκριβῶς τὸ ὅλον γινώσκομεν, οὕτω καὶ τὰ ἐν τοῖς κεφαλαίοις λεγόμενα γινώσκοντες ἀκριβῶς τὸ ὅλον γινώσκομεν.", "seq": 1684}
{"id": "David_Passim_1685", "series": "CAG", "text": "εὐλόγως δὲ καὶ ἡ τάξις ζητεῖται, ἵνα μὴ τὰ ὀφείλοντα πρῶτα ἀναγινώσκεσθαι τελευταῖα ἀναγνῶμεν ἢ ἐκ τοῦ ἐναντίου τὰ ὀφείλοντα τελευταῖα ἀναγινώσκεσθαι πρῶτα ἀναγνῶμεν.", "seq": 1685}
{"id": "David_Passim_1686", "series": "CAG", "text": "εὐλόγως δὲ καὶ ὁ διδασκαλικὸς τρόπος ζητεῖται, ἵνα γνῶμεν ποίῳ διδασκαλικῷ τρόπῳ κέχρηται·", "seq": 1686}
{"id": "David_Passim_1687", "series": "CAG", "text": "καὶ γάρ, ὡς ἐν τοῖς ἑξῆς μαθησόμεθα, πολλοί εἰσι διδασκαλικοὶ τρόποι.", "seq": 1687}
{"id": "David_Passim_1688", "series": "CAG", "text": "εὐλόγως δὲ καὶ ἡ ὑπὸ τί μέρος ἀναφορὰ ζητεῖται, ἵνα μὴ νομίσωμεν τὰ μὲν ὑπὸ τὸ θεωρητικὸν ἀναγόμενα ὑπὸ τὸ πρακτικὸν ἀνάγεσθαι, τὰ δὲ ὑπὸ τὸ πρακτικὸν ὑπὸ τὸ θεωρητικόν.", "seq": 1688}
{"id": "David_Passim_1689", "series": "CAG", "text": "ἐν οἷς σὺν θεῷ καὶ ἡ πρᾶξις.", "seq": 1689}
{"id": "David_Passim_1690", "series": "CAG", "text": "Πρᾶξις β΄.", "seq": 1690}
{"id": "David_Passim_1691", "series": "CAG", "text": "Μαθόντες τὰ εἰωθότα λέγεσθαι κεφάλαια ἔλθωμεν καὶ ζητήσωμεν αὐτὰ καὶ ἐπὶ τοῦ παρόντος συγγράμματος ὀκτὼ τὸν ἀριθμὸν ὄντα.", "seq": 1691}
{"id": "David_Passim_1692", "series": "CAG", "text": "ἀλλὰ πρῶτον περὶ τοῦ σκοποῦ διαλάβωμεν.", "seq": 1692}
{"id": "David_Passim_1693", "series": "CAG", "text": "ἰστέον ὅτι ὁ σκοπὸς καὶ συμπεφώνηται καὶ διαπεφώνηται·", "seq": 1693}
{"id": "David_Passim_1694", "series": "CAG", "text": "καὶ συμπεφώνηται μέν, ἐπειδὴ πάντες ὁμολογοῦσιν ὅτι σκοπὸν ἔχει περὶ τῶν πέντε φωνῶν διαλαβεῖν, τοῦτ᾿ ἔστι περὶ γένους περὶ εἴδους περὶ διαφορᾶς περὶ ἰδίου περὶ συμβεβηκότος.", "seq": 1694}
{"id": "David_Passim_1695", "series": "CAG", "text": "καὶ τοῦτο πιστοῦται ἐξ αὐτοῦ·", "seq": 1695}
{"id": "David_Passim_1696", "series": "CAG", "text": "καὶ γὰρ αὐτὸς λέγει ἐν τῷ προοιμίῳ ὅτι ἀναγκαῖόν ἐστιν εἰπεῖν τί γένος καὶ τί εἶδος καὶ τί διαφορὰ καὶ τί ἴδιον καὶ τί συμβεβηκός.", "seq": 1696}
{"id": "David_Passim_1697", "series": "CAG", "text": "διαπεφώνηται δέ, ἐπειδὴ οἱ μὲν λέγουσιν ὅτι οὐ δι᾿ ἄλλο τι διαλαμβάνει περὶ τῶν πέντε φωνῶν εἰ μὴ δι᾿ αὐτάς, τοῦτ᾿ ἔστι διὰ τὸ παραστῆσαι ἡμῖν τὸ ἐξ αὐτῶν ἀναφυόμενον χρήσιμον, ἕτεροι δὲ λέγουσιν ὅτι διὰ τὰς Κατηγορίας Ἀριστοτέλους διαλαμβάνει περὶ αὐτῶν·", "seq": 1697}
{"id": "David_Passim_1698", "series": "CAG", "text": "ἐπειδὴ γὰρ ὁ Ἀριστοτέλης ἐν ταῖς Κατηγορίαις περὶ πάντων τῶν ὄντων διαλαμβάνει, εἰς δὲ τὴν τῶν ὄντων διδασκαλίαν συμβάλλονται ἡμῖν αἱ φωναί (διὰ γὰρ τῶν φωνῶν δηλοῦνται τὰ πράγματα), τούτου χάριν περὶ τῶν πέντε φωνῶν διαλαμβάνει.", "seq": 1698}
{"id": "David_Passim_1699", "series": "CAG", "text": "ἄλλοι δὲ λέγουσιν ὅτι διὰ τοῦτο περὶ τῶν πέντε φωνῶν διαλαμβάνει, ἐπειδὴ αἱ πέντε φωναὶ συμβάλλονται ἡμῖν εἰς πᾶσαν φωνὴν ὑπὸ τὴν φιλοσοφίαν οὖσαν·", "seq": 1699}
{"id": "David_Passim_1700", "series": "CAG", "text": "ὥσπερ γὰρ οἱ γραμματικοὶ ἐπενόησαν τὰ ὀκτὼ μέρη τοῦ λόγου ὑφ᾿ ἃ πᾶσα λέξις Ἑλληνικὴ ἀνάγεται, καὶ ὥσπερ οἱ ῥήτορες ἐπενόησαν τὰς δεκατρεῖς στάσεις ὑφ᾿ ἃς πᾶν πολιτικὸν ζήτημα ἀνάγεται, καὶ ὥσπερ ὁ Ἀριστοτέλης ἐπενόησε τὰς δέκα κατηγορίας ὑφ᾿ ἃς πάντα τὰ ὄντα ἀνάγονται, οὕτω καὶ πᾶσα φωνὴ ὑπὸ τὴν φιλοσοφίαν οὖσα ὑπὸ τὰς πέντε φωνὰς ἀνάγεται·", "seq": 1700}
{"id": "David_Passim_1701", "series": "CAG", "text": "ἢ γὰρ γένος ἐστὶν ἢ εἶδος ἢ διαφορὰ ἢ ἴδιον ἢ συμβεβηκός.", "seq": 1701}
{"id": "David_Passim_1702", "series": "CAG", "text": "Ὅτι γὰρ πέντε εἰσὶν αἱ φωναί, δείκνυται ἐκ διαιρέσεως τοιαύτης·", "seq": 1702}
{"id": "David_Passim_1703", "series": "CAG", "text": "ἡ φωνὴ διττή ἐστιν·", "seq": 1703}
{"id": "David_Passim_1704", "series": "CAG", "text": "ἢ γὰρ ἔναρθρός ἐστιν ἢ ἄναρθρος.", "seq": 1704}
{"id": "David_Passim_1705", "series": "CAG", "text": "καὶ ἔναρθρος μὲν ἡ ἐκ διανοίας προβαλλομένη ὥσπερ ἡ τοῦ ἀνθρώπου, ἄναρθρος δὲ ὥσπερ ἡ τῶν ἀλόγων ζῴων καὶ ὁ ἦχος ὁ ἀπὸ λίθου ἢ ξύλου γινόμενος.", "seq": 1705}
{"id": "David_Passim_1706", "series": "CAG", "text": "καὶ ἑκατέρα δὲ τούτων διττή ἐστιν·", "seq": 1706}
{"id": "David_Passim_1707", "series": "CAG", "text": "ἢ γὰρ σημαντική ἐστιν ἢ ἀσήμαντος.", "seq": 1707}
{"id": "David_Passim_1708", "series": "CAG", "text": "καὶ ἔναρθρος μὲν καὶ σημαντικὴ ὥσπερ ἐπὶ τοῦ ἄνθρωπος καὶ ἵππος·", "seq": 1708}
{"id": "David_Passim_1709", "series": "CAG", "text": "αὗται γὰρ καὶ ἔναρθροί εἰσι, καθὸ ἀνθρώπων εἰσὶ φωναί, καὶ σημαντικαί, καθὸ κατὰ πραγμάτων τίθενται.", "seq": 1709}
{"id": "David_Passim_1710", "series": "CAG", "text": "ἔναρθρος δὲ καὶ ἀσήμαντος ὡς ἐπὶ τοῦ ἱπποκένταυρος·", "seq": 1710}
{"id": "David_Passim_1711", "series": "CAG", "text": "τοῦτο γὰρ ἀσήμαντόν ἐστιν, ἐπειδὴ οὐ τίθεται κατὰ πράγματος·", "seq": 1711}
{"id": "David_Passim_1712", "series": "CAG", "text": "οὔτε γὰρ ἔστιν ἱπποκένταυρος.", "seq": 1712}
{"id": "David_Passim_1713", "series": "CAG", "text": "ἄναρθρος δὲ καὶ σημαντικὴ ὡς ἐπὶ τῆς ὑλακῆς τῶν κυνῶν·", "seq": 1713}
{"id": "David_Passim_1714", "series": "CAG", "text": "αὕτη γὰρ καὶ ἄναρθρός ἐστι, καθὸ οὐκ ἔστιν ἀνθρώπου φωνή, καὶ σημαντική, καθὸ δηλοῖ παρουσίαν ἢ ξένου ἢ φίλου.", "seq": 1714}
{"id": "David_Passim_1715", "series": "CAG", "text": "ἄναρθρος δὲ καὶ ἀσήμαντος ὡς ἐπὶ τοῦ ἤχου τοῦ ἐκ λίθου ἢ ξύλου γινομένου·", "seq": 1715}
