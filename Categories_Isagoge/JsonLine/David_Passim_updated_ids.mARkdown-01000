{"id": "David_Passim_1718", "series": "CAG", "text": "Τούτων οὖν οὕτως ἐχόντων οἱ φιλόσοφοι περὶ τῆς ἀνάρθρου φωνῆς οὐ διαλαμβάνουσιν οὔτε δὲ περὶ τῆς ἐνάρθρου καὶ ἀσημάντου φωνῆς·", "seq": 1718}
{"id": "David_Passim_1719", "series": "CAG", "text": "οὗτοι γὰρ περὶ πράγματα καταγινόμενοι τῶν σημαινομένων φροντίζουσι.", "seq": 1719}
{"id": "David_Passim_1720", "series": "CAG", "text": "περὶ τούτων δὲ τοῖς γραμματικοῖς μελέτω·", "seq": 1720}
{"id": "David_Passim_1721", "series": "CAG", "text": "οὗτοι γὰρ ὡς περὶ φωνὰς καταγινόμενοι οὐ πάνυ τῶν σημαινομένων φροντίζουσι.", "seq": 1721}
{"id": "David_Passim_1722", "series": "CAG", "text": "περὶ δὲ τῆς ἐνάρθρου καὶ σημαντικῆς φωνῆς διαλαμβάνουσιν οἱ φιλόσοφοι, καὶ περὶ ταύτης οὐ πάσης·", "seq": 1722}
{"id": "David_Passim_1723", "series": "CAG", "text": "ἰστέον γὰρ ὅτι ἡ ἔναρθρος καὶ σημαντικὴ φωνὴ διττή ἐστιν·", "seq": 1723}
{"id": "David_Passim_1724", "series": "CAG", "text": "ἢ γὰρ μερική ἐστιν ἢ καθόλου.", "seq": 1724}
{"id": "David_Passim_1725", "series": "CAG", "text": "καὶ μερικὴ μέν, ὡς ὅταν εἴπωμεν ‘Σωκράτης’ ‘Πλάτων’ (ταῦτα γὰρ μερικά εἰσι), καθόλου δέ, ὡς ὅταν εἴπωμεν ‘ἄνθρωπος’ ‘ἵππος’·", "seq": 1725}
{"id": "David_Passim_1726", "series": "CAG", "text": "ταῦτα γὰρ καθόλου εἰσι.", "seq": 1726}
{"id": "David_Passim_1727", "series": "CAG", "text": "περὶ οὖν τῆς μερικῆς οὐ διαλαμβάνουσιν, ἐπειδὴ τὰ μερικὰ ἀόριστα καὶ ἀπερίληπτά εἰσιν, ἀλλὰ περὶ τῆς καθόλου διαλαμβάνουσιν.", "seq": 1727}
{"id": "David_Passim_1728", "series": "CAG", "text": "Αὕτη οὖν ἡ ἔναρθρος καὶ σημαντικὴ καθόλου φωνὴ διττή ἐστιν·", "seq": 1728}
{"id": "David_Passim_1729", "series": "CAG", "text": "ἢ γὰρ οὐσιώδης ἐστὶν ἢ ἐπουσιώδης.", "seq": 1729}
{"id": "David_Passim_1730", "series": "CAG", "text": "ἐπουσιῶδες δὲ λέγεται τὸ ἐπὶ τῆς οὐσίας ὄν.", "seq": 1730}
{"id": "David_Passim_1731", "series": "CAG", "text": "ἑκάτερον δὲ τούτων διττόν ἐστιν·", "seq": 1731}
{"id": "David_Passim_1732", "series": "CAG", "text": "καὶ γὰρ τὸ ἐπουσιῶδες διττόν ἐστιν·", "seq": 1732}
{"id": "David_Passim_1733", "series": "CAG", "text": "ἢ γὰρ μιᾷ φύσει ἁρμόζει ἢ πολλαῖς φύσεσι.", "seq": 1733}
{"id": "David_Passim_1734", "series": "CAG", "text": "καὶ εἰ μὲν πολλαῖς φύσεσιν ἁρμόζει, γίνεται τὸ κοινῶς συμβεβηκός, ὅπερ διττόν ἐστιν·", "seq": 1734}
{"id": "David_Passim_1735", "series": "CAG", "text": "ἢ γὰρ χωριστόν ἐστιν ἢ ἀχώριστον.", "seq": 1735}
{"id": "David_Passim_1736", "series": "CAG", "text": "καὶ χωριστὸν μέν ἐστιν ὡς ἐπὶ τοῦ κινεῖσθαι (τοῦτο γὰρ χωριστὸν συμβεβηκός ἐστι·", "seq": 1736}
{"id": "David_Passim_1737", "series": "CAG", "text": "δύναται γάρ τις μὴ ἀεὶ κινεῖσθαι, ἀλλὰ δύναται καὶ ἠρεμεῖν.", "seq": 1737}
{"id": "David_Passim_1738", "series": "CAG", "text": "τοῦτο δὲ πολλαῖς φύσεσιν ἁρμόζει·", "seq": 1738}
{"id": "David_Passim_1739", "series": "CAG", "text": "καὶ γὰρ παντὶ ζῴῳ παρέπεται τὸ κινεῖσθαι), ἀχώριστον δὲ ὡς τὸ λευκὸν τοῦ κύκνου καὶ τὸ μέλαν τοῦ κόρακος·", "seq": 1739}
{"id": "David_Passim_1740", "series": "CAG", "text": "ταῦτα γὰρ ἀχώριστα συμβεβηκότα εἰσίν·", "seq": 1740}
{"id": "David_Passim_1741", "series": "CAG", "text": "οὔτε γὰρ ὁ κύκνος δύναται μὴ εἶναι λευκὸς οὔτε ὁ κόραξ δύναται μὴ εἶναι μέλας.", "seq": 1741}
{"id": "David_Passim_1742", "series": "CAG", "text": "ταῦτα δὲ πολλαῖς φύσεσιν ἁρμόζει·", "seq": 1742}
{"id": "David_Passim_1743", "series": "CAG", "text": "οὐ μόνον γὰρ ὁ κόραξ ἐστὶ μέλας ἀλλὰ καὶ ὁ Αἰθίοψ, καὶ πάλιν οὐ μόνον ὁ κύκνος ἐστὶ λευκὸς ἀλλὰ καὶ ἡ χιὼν καὶ τὸ ψιμύθιον.", "seq": 1743}
{"id": "David_Passim_1744", "series": "CAG", "text": "εἰ δὲ μιᾷ φύσει ἁρμόζει, γίνεται τὸ ἴδιον ἐπουσιῶδες, ὡς ὅταν εἴπωμεν τοῦ μὲν ἀνθρώπου ἴδιον εἶναι τὸ γελαστικὸν τοῦ δὲ ἵππου τὸ χρεμετιστικόν.", "seq": 1744}
{"id": "David_Passim_1745", "series": "CAG", "text": "ὅθεν καὶ ἴδια λέγονται παρὰ τὸ ἰδίως μιᾷ φύσει ὑπάρχειν·", "seq": 1745}
{"id": "David_Passim_1746", "series": "CAG", "text": "καὶ γὰρ μόνῳ τῷ ἀνθρώπῳ παρέπεται τὸ γελᾶν καὶ μόνῳ τῷ ἵππῳ τὸ χρεμετίζειν.", "seq": 1746}
{"id": "David_Passim_1747", "series": "CAG", "text": "Καὶ τὸ οὐσιῶδες δὲ πάλιν διττόν ἐστιν·", "seq": 1747}
{"id": "David_Passim_1748", "series": "CAG", "text": "ἢ γὰρ μιᾷ φύσει ἁρμόζει ἢ πολλαῖς φύσεσι.", "seq": 1748}
{"id": "David_Passim_1749", "series": "CAG", "text": "καὶ εἰ μὲν πολλαῖς φύσεσιν ἁρμόζει, ἢ ἐν τῷ τί ἐστι κατηγορεῖται καὶ γίνεται τὸ γένος (ἐρωτώμενοι γὰρ τί ἐστιν ἄνθρωπος τὸ γένος ἀποκρινόμεθα λέγοντες ‘ζῷον’, ὅπερ πολλαῖς ἁρμόζει φύσεσιν·", "seq": 1749}
{"id": "David_Passim_1750", "series": "CAG", "text": "οὐ μόνον γὰρ ὁ ἄνθρωπος ζῷον ἀλλὰ καὶ ὁ ἵππος καὶ ὁ κύων καὶ ὁ βοῦς), ἢ ἐν τῷ ὁποῖόν τί ἐστι κατηγορεῖται καὶ γίνεται ἡ διαφορά·", "seq": 1750}
{"id": "David_Passim_1751", "series": "CAG", "text": "ἐρωτώμενοι γὰρ ὁποῖόν τί ἐστιν ἄνθρωπος λέγομεν ὅτι λογικόν, τὴν διαφορὰν ἀποκρινόμενοι.", "seq": 1751}
{"id": "David_Passim_1752", "series": "CAG", "text": "τοῦτο δὲ πολλαῖς φύσεσιν ἁρμόζει·", "seq": 1752}
{"id": "David_Passim_1753", "series": "CAG", "text": "οὐ μόνον γὰρ ὁ ἄνθρωπός ἐστι λογικόν, ἀλλὰ καὶ ἄγγελος καὶ δαίμων.", "seq": 1753}
{"id": "David_Passim_1754", "series": "CAG", "text": "εἰ δὲ μιᾷ φύσει ἁρμόζει, ἢ πάλιν ἐν τῷ τί ἐστι κατηγορεῖται καὶ γίνεται τὸ εἶδος (ἐρωτώμενοι γὰρ τί ἐστι Σωκράτης καὶ λέγοντες ὅτι ἄνθρωπος τὸ εἶδος ἀποκρινόμεθα, τοῦτο δὲ μιᾷ φύσει ἁρμόζει·", "seq": 1754}
{"id": "David_Passim_1755", "series": "CAG", "text": "μόνοις γὰρ τοῖς ἀνθρώποις ἁρμόζει ἡ τοῦ ἀνθρώπου φωνή), ἢ ἐν τῷ ὁποῖόν τί ἐστι κατηγορεῖται καὶ γίνεται τὸ οὐσιῶδες ἴδιον, οἷον ὡς ὅταν ἐρωτώμενοι ὁποῖόν τί ἐστιν ὁ ἄνθρωπος εἴπωμεν ‘νοῦ καὶ ἐπιστήμης δεκτικόν’·", "seq": 1755}
{"id": "David_Passim_1756", "series": "CAG", "text": "τοῦτο γὰρ ἰδίως μόνῳ τῷ ἀνθρώπῳ πρόσεστιν.", "seq": 1756}
{"id": "David_Passim_1757", "series": "CAG", "text": "Πέντε οὖν οὐσῶν τῶν φωνῶν, ὡς ἐδίδαξεν ἡ διαίρεσις (ἔστι γὰρ γένος εἶδος διαφορὰ ἴδιον συμβεβηκός), πέντε εἰσὶ καὶ οἱ τρόποι τῶν κατηγοριῶν τῶν φωνῶν, τοῦτ᾿ ἔστι πέντε τρόποι εἰσὶν οἱ κατὰ τῶν φωνῶν τούτων φερόμενοι·", "seq": 1757}
{"id": "David_Passim_1758", "series": "CAG", "text": "ἔστι γὰρ τί ἐστιν, ὁποῖόν τί ἐστιν, ὁποῖόν ἐστι καὶ ποῖόν ἐστι καὶ πῶς ἔχει.", "seq": 1758}
{"id": "David_Passim_1759", "series": "CAG", "text": "καὶ τὸ μὲν γένος καὶ τὸ εἶδος ἐν τῷ τί ἐστι κατηγοροῦνται (ἐρωτώμενοι γὰρ τί ἐστι τὸ προσιὸν ἢ ἄνθρωπος λέγομεν ἢ ζῷον, καὶ ἰδοὺ τὸ μὲν ζῷον γένος ἐστὶ τὸ δὲ ἄνθρωπος εἶδος), ἡ δὲ διαφορὰ καὶ τὸ ἴδιον οὐσιῶδες ἐν τῷ ὁποῖόν τί ἐστι κατηγοροῦνται (ἐρωτώμενοι γὰρ ὁποῖον τί ἐστι τὸ προσιὸν ἢ λογικὸν λέγομεν ἢ νοῦ καὶ ἐπιστήμης δεκτικόν, καὶ ἰδοὺ τὸ μὲν λογικὸν διαφορά ἐστι τὸ δὲ νοῦ καὶ ἐπιστήμης δεκτικὸν ἴδιον οὐσιῶδες), τὸ δὲ ἴδιον ἐπουσιῶδες ἐν τῷ ὁποῖόν ἐστι κατηγορεῖται (ἐρωτώμενοι γὰρ ὁποῖόν ἐστιν ὁ ἄνθρωπος λέγομεν γελαστικὸν καὶ ὁποῖόν ἐστιν ὁ ἵππος λέγομεν χρεμετιστικόν), τὸ δὲ ἀχώριστον συμβεβηκὸς ἐν τῷ ποῖόν ἐστι κατηγορεῖται (ἐρωτώμενοι γὰρ ποῖόν ἐστιν ὁ κόραξ λέγομεν μέλαν καὶ ποῖόν ἐστι κύκνος λέγομεν λευκόν), τὸ δὲ χωριστὸν συμβεβηκὸς ἐν τῷ πῶς ἔχει κατηγορεῖται·", "seq": 1759}
{"id": "David_Passim_1760", "series": "CAG", "text": "ἐρωτώμενοι γὰρ πῶς ἔχει Σωκράτης λέγομεν ὅτι ὑγιαίνει ἢ κινεῖται.", "seq": 1760}
{"id": "David_Passim_1761", "series": "CAG", "text": "δέδεικται οὖν ὅτι πέντε εἰσὶν αἱ φωναί·", "seq": 1761}
{"id": "David_Passim_1762", "series": "CAG", "text": "ἔστι γὰρ γένος εἶδος διαφορὰ ἴδιον καὶ συμβεβηκός.", "seq": 1762}
{"id": "David_Passim_1763", "series": "CAG", "text": "καὶ πέντε τρόποι οἱ κατὰ τῶν φωνῶν τούτων φερόμενοι·", "seq": 1763}
{"id": "David_Passim_1764", "series": "CAG", "text": "ἔστι γὰρ τί ἐστιν, ὁποῖόν τί ἐστιν, ὁποῖόν ἐστι, ποῖόν ἐστι καὶ πῶς ἔχει.", "seq": 1764}
{"id": "David_Passim_1765", "series": "CAG", "text": "Ἀποροῦσι δέ τινες λέγοντες ὅτι οὐκ εἰσὶ μόναι πέντε φωναὶ ἀλλὰ καὶ ἕξ·", "seq": 1765}
{"id": "David_Passim_1766", "series": "CAG", "text": "ἔστι γὰρ γένος εἶδος διαφορὰ συμβεβηκὸς ἴδιον οὐσιῶδες καὶ ἴδιον ἐπουσιῶδες.", "seq": 1766}
{"id": "David_Passim_1767", "series": "CAG", "text": "πρὸς οὓς ἔστιν εἰπεῖν ὅτι περὶ φωνῶν ἐστιν ὁ λόγος, μία δὲ φωνή ἐστι τὸ ἴδιον οὐσιῶδες καὶ τὸ ἴδιον ἐπουσιῶδες·", "seq": 1767}
{"id": "David_Passim_1768", "series": "CAG", "text": "εἴτε γὰρ οὐσιῶδές ἐστιν εἴτε ἐπουσιῶδες, ἴδιον λέγεται.", "seq": 1768}
{"id": "David_Passim_1769", "series": "CAG", "text": "ἐπεὶ κατὰ τοῦτον τὸν λόγον πλείονες τῶν ἓξ φωνῶν εἰσιν·", "seq": 1769}
{"id": "David_Passim_1770", "series": "CAG", "text": "ἔστι γὰρ συμβεβηκὸς χωριστόν, ἔστι δὲ καὶ ἀχώριστον, ἀλλὰ μία φωνή ἐστι καὶ τὸ χωριστὸν συμβεβηκὸς καὶ τὸ ἀχώριστον·", "seq": 1770}
{"id": "David_Passim_1771", "series": "CAG", "text": "εἴτε γὰρ χωριστόν ἐστιν εἴτε ἀχώριστον, συμβεβηκὸς λέγεται.", "seq": 1771}
{"id": "David_Passim_1772", "series": "CAG", "text": "ταῦτα μὲν ἐν τούτοις.", "seq": 1772}
{"id": "David_Passim_1773", "series": "CAG", "text": "Ἰστέον δὲ ὅτι οὐσιῶδες μέν ἐστιν ὃ παρὸν μὲν σώζει ἀπὸν δὲ φθείρει, ὡς ἐπὶ τοῦ λογικοῦ·", "seq": 1773}
{"id": "David_Passim_1774", "series": "CAG", "text": "τοῦτο γὰρ οὐσιωδῶς πρόσεστι τῷ ἀνθρώπῳ·", "seq": 1774}
{"id": "David_Passim_1775", "series": "CAG", "text": "παρὸν μὲν γὰρ σώζει τὸν ἄνθρωπον, ἀπὸν δὲ φθείρει αὐτόν·", "seq": 1775}
{"id": "David_Passim_1776", "series": "CAG", "text": "οὐ δύναται γὰρ ἄνθρωπος χωρὶς τοῦ λογικοῦ εἶναι.", "seq": 1776}
{"id": "David_Passim_1777", "series": "CAG", "text": "ἐπουσιῶδες δέ ἐστιν ὃ οὔτε παρὸν σώζει οὔτε ἀπὸν φθείρει, ὡς ἐπὶ τοῦ λευκοῦ·", "seq": 1777}
{"id": "David_Passim_1778", "series": "CAG", "text": "τοῦτο γὰρ οὔτε παρὸν σώζει τὸν ἄνθρωπον οὔτε ἀπὸν φθείρει·", "seq": 1778}
{"id": "David_Passim_1779", "series": "CAG", "text": "ἐνδέχεται γὰρ τὸν ἄνθρωπον καὶ εἶναι λευκὸν καὶ μὴ εἶναι καὶ ὅμως συνίστασθαι.", "seq": 1779}
{"id": "David_Passim_1780", "series": "CAG", "text": "τὸ δὲ λευκὸν τοῦ κύκνου καὶ τὸ μέλαν τοῦ Αἰθίοπος ἀχώριστά εἰσι συμβεβηκότα·", "seq": 1780}
{"id": "David_Passim_1781", "series": "CAG", "text": "οὔτε γὰρ κύκνον ἐνδέχεται μὴ εἶναι λευκὸν οὔτε Αἰθίοπα μὴ εἶναι μέλανα.", "seq": 1781}
{"id": "David_Passim_1782", "series": "CAG", "text": "ταῦτα ἔχομεν εἰπεῖν περὶ τοῦ σκοποῦ.", "seq": 1782}
{"id": "David_Passim_1783", "series": "CAG", "text": "ἐν οἷς καὶ ἡ δευτέρα πρᾶξις.", "seq": 1783}
{"id": "David_Passim_1784", "series": "CAG", "text": "Πρᾶξις γ΄.", "seq": 1784}
{"id": "David_Passim_1785", "series": "CAG", "text": "Μαθόντες τὸν σκοπὸν τοῦ παρόντος συγγράμματος ἔλθωμεν ἐπὶ τὸ χρήσιμον.", "seq": 1785}
{"id": "David_Passim_1786", "series": "CAG", "text": "ἰστέον ὅτι τὸ χρήσιμον τοῦ παρόντος συγγράμματος τριττόν ἐστι·", "seq": 1786}
{"id": "David_Passim_1787", "series": "CAG", "text": "χρησιμεύει γὰρ καὶ εἰς τὰς Κατηγορίας Ἀριστοτέλους καὶ εἰς πᾶσαν τὴν φιλοσοφίαν καὶ εἰς τὰς διαλεκτικὰς μεθόδους.", "seq": 1787}
{"id": "David_Passim_1788", "series": "CAG", "text": "καὶ εἰς μὲν τὰς Κατηγορίας Ἀριστοτέλους χρησιμεύει, ὅτι ἐν ταῖς Κατηγορίαις διδάσκει ἡμᾶς ὁ Ἀριστοτέλης περὶ τῶν δέκα γενικωτάτων γενῶν, διδάσκει δὲ ἡμᾶς ἐν τῷ παρόντι συγγράμματι τί ἐστι γένος καὶ πάλιν ὅτι τὰ γένη τῶν εἰδῶν εἰσι γένη καὶ διὰ τῶν διαφορῶν διαιροῦνται εἰς τὰ εἴδη·", "seq": 1788}
{"id": "David_Passim_1789", "series": "CAG", "text": "καὶ γὰρ τὸ ζῷον, ὅπερ ἐστὶ γένος, διὰ τῶν διαφορῶν, φημὶ δὲ διὰ τοῦ λογικοῦ καὶ τοῦ ἀλόγου, διαιρεῖται εἰς τὰ εἴδη, οἷον εἰς τὸ λογικὸν ζῷον καὶ εἰς τὸ ἄλογον ζῷον.", "seq": 1789}
{"id": "David_Passim_1790", "series": "CAG", "text": "διδάσκει δὲ ἡμᾶς ἐν τῷ παρόντι συγγράμματι καὶ τί ἐστιν εἶδος καὶ τί ἐστι διαφορά.", "seq": 1790}
{"id": "David_Passim_1791", "series": "CAG", "text": "καὶ πάλιν ἐπειδὴ τὰ γενικώτατα γένη ὅρους οὐκ ἐπιδέχονται (ὁ γὰρ ὅρος ἀπὸ γένους καὶ συστατικῶν διαφορῶν σύγκειται, οἷον ὁ ἄνθρωπός ἐστι ζῷον λογικὸν θνητὸν νοῦ καὶ ἐπιστήμης δεκτικόν·", "seq": 1791}
{"id": "David_Passim_1792", "series": "CAG", "text": "ἰδοὺ τὸ μὲν ζῷον γένος ἐστὶν αἱ δὲ λοιπαὶ συστατικαὶ διαφοραί.", "seq": 1792}
{"id": "David_Passim_1793", "series": "CAG", "text": "τὰ δὲ γενικώτατα γένη οὐκ ἔχουσιν ὑπεραναβεβηκὸς γένος τὸ ὀφεῖλον τεθῆναι ἐν τῷ ὅρῳ·", "seq": 1793}
{"id": "David_Passim_1794", "series": "CAG", "text": "τούτου χάριν οὐκ ἐπιδέχονται ὅρον, ἀλλὰ διὰ ἰδίου δηλοῦνται), διδάσκει [δὲ] ἡμᾶς ἐν τῷ παρόντι συγγράμματι τί ἐστιν ἴδιον.", "seq": 1794}
{"id": "David_Passim_1795", "series": "CAG", "text": "καὶ πάλιν ἐπεὶ τὰ πολλὰ τῶν δέκα γενικωτάτων γενῶν συμβεβηκότα εἰσὶν οἷον τὸ ποιὸν καὶ τὸ ποσόν, διδάσκει ἡμᾶς ἐν τῷ παρόντι συγγράμματι τί ἐστι συμβεβηκός.", "seq": 1795}
{"id": "David_Passim_1796", "series": "CAG", "text": "Δέδεικται οὖν ὅτι χρησιμεύει τὸ παρὸν σύγγραμμα εἰς τὰς Ἀριστοτέλους Κατηγορίας.", "seq": 1796}
{"id": "David_Passim_1797", "series": "CAG", "text": "εἰς πᾶσαν δὲ τὴν φιλοσοφίαν χρησιμεύει τὸ παρὸν σύγγραμμα οὕτως·", "seq": 1797}
{"id": "David_Passim_1798", "series": "CAG", "text": "εἰ ἄρα αἱ Ἀριστοτέλους Κατηγορίαι εἰς πᾶσαν τὴν φιλοσοφίαν συμβάλλονται (εἰσαγωγαὶ γάρ εἰσι τῆς φιλοσοφίας καὶ δι᾿ αὐτῶν πάντα τὰ ὄντα διδασκόμεθα), συμβάλλεται δὲ ἡ παροῦσα πραγματεία εἰς τὰς Ἀριστοτέλους Κατηγορίας, ὡς δέδεικται, δῆλον ὅτι διὰ μέσου τῶν Κατηγοριῶν συμβάλλεται ἡμῖν τὸ παρὸν σύγγραμμα καὶ εἰς πᾶσαν τὴν φιλοσοφίαν.", "seq": 1798}
{"id": "David_Passim_1799", "series": "CAG", "text": "συμβάλλεται δέ, ὡς εἴρηται, τὸ παρὸν σύγγραμμα καὶ εἰς τὰς διαλεκτικὰς μεθόδους.", "seq": 1799}
{"id": "David_Passim_1800", "series": "CAG", "text": "ἀλλὰ πρῶτον εἴπωμεν διὰ τί λέγονται διαλεκτικαὶ μέθοδοι καὶ πόσαι εἰσὶ καὶ τὴν τάξιν αὐτῶν, καὶ οὕτω λέγωμεν πῶς συμβάλλεται τὸ παρὸν σύγγραμμα καὶ εἰς τὰς διαλεκτικὰς μεθόδους.", "seq": 1800}
{"id": "David_Passim_1801", "series": "CAG", "text": "Ἰστέον δὲ ὅτι διαλεκτικαὶ ἐλέγοντο, ἐπειδὴ ἐν τῷ διαλέγεσθαι ἀνεφαίνοντο·", "seq": 1801}
{"id": "David_Passim_1802", "series": "CAG", "text": "ἐν γὰρ τῷ διαλέγεσθαι καὶ διῄρουν καὶ ὡρίζοντο καὶ ἀποδείξεσιν ἐκέχρηντο καὶ τῇ ἀναλύσει.", "seq": 1802}
{"id": "David_Passim_1803", "series": "CAG", "text": "εἰσὶ δὲ τέσσαρες αἱ διαλεκτικαὶ μέθοδοι·", "seq": 1803}
{"id": "David_Passim_1804", "series": "CAG", "text": "ἔστι γὰρ διαιρετικὴ ὁριστικὴ ἀποδεικτικὴ ἀναλυτική.", "seq": 1804}
{"id": "David_Passim_1805", "series": "CAG", "text": "καὶ διαιρετικῆς μὲν ἔργον ἐστὶ τὸ λαμβάνειν τὰ γένη καὶ διαιρεῖν αὐτὰ εἰς εἴδη, ὁριστικῆς δὲ ἔργον ἐστὶ τὸ ὁρίζεσθαι τὰ πράγματα, ἀποδεικτικῆς δὲ τὸ ἀποδείξεσι πιστοῦσθαι τὰ λεγόμενα.", "seq": 1805}
{"id": "David_Passim_1806", "series": "CAG", "text": "ἔστι δὲ ἡ πίστις τριττή·", "seq": 1806}
{"id": "David_Passim_1807", "series": "CAG", "text": "ἢ γὰρ ἐκ τῶν καθόλου τὰ μερικὰ πιστοῦνται ἢ ἐκ τῶν μερικῶν τὰ καθόλου ἢ ἐκ τοῦ ἴσου τὸ ἴσον.", "seq": 1807}
{"id": "David_Passim_1808", "series": "CAG", "text": "καὶ ἡνίκα μὲν ἐκ τῶν καθόλου τὰ μερικὰ κανονίζονται, λέγεται ἀπόδειξις, οἷον ὡς ὅταν βουλόμενοι δεῖξαι ὅτι ὁ ἄνθρωπος ἔμψυχός ἐστιν ἐκ τῶν καθόλου τοῦτο πιστωσώμεθα λέγοντες ὅτι ‘ὁ ἄνθρωπος ζῷόν ἐστι, πᾶν ζῷον ἔμψυχόν ἐστιν, ὁ ἄνθρωπος ἄρα ἔμψυχός ἐστιν’.", "seq": 1808}
{"id": "David_Passim_1809", "series": "CAG", "text": "ἡνίκα δὲ ἐκ τῶν μερικῶν τὰ καθόλου κανονίζομεν, λέγεται ἐπαγωγή, οἷον ὡς ὅταν βουλόμενοι δεῖξαι ὅτι πᾶν ζῷον τὴν κάτω γένυν κινεῖ ἐκ τῶν μερικῶν τοῦτο πιστωσώμεθα λέγοντες ὅτι ‘ὁ ἄνθρωπος τὴν κάτω γένυν κινεῖ, ὁ ἵππος τὴν κάτω γένυν κινεῖ, πᾶν ζῷον ἄρα τὴν κάτω γένυν κινεῖ’.", "seq": 1809}
{"id": "David_Passim_1810", "series": "CAG", "text": "ἡνίκα δὲ ἐκ τοῦ ἴσου τὸ ἴσον κανονίζομεν, λέγεται τὸ τοιοῦτον παράδειγμα οἷον ὡς ἐπὶ τοῦ Διονυσίου·", "seq": 1810}
{"id": "David_Passim_1811", "series": "CAG", "text": "βουλόμενος γάρ τις μὴ δοθῆναι τῷ Διονυσίῳ στρατὸν εἰσέρχεται καὶ κέχρηται παραδείγματι τῷ Πεισιστράτῳ λέγων ὅτι ‘μὴ δῶμεν τῷ Διονυσίῳ στρατόν, ἵνα μὴ τυραννήσῃ ὡς ὁ Πεισίστρατος’.", "seq": 1811}
{"id": "David_Passim_1812", "series": "CAG", "text": "ἰστέον δὲ ὅτι εἷς κυρίως τρόπος ἐστὶν ἀποδείξεως ὁ ἀπὸ τῶν καθόλου τὰ μερικὰ κανονίζων·", "seq": 1812}
{"id": "David_Passim_1813", "series": "CAG", "text": "οὗτος γὰρ ὄντως ἀναγκαίως ἔχει·", "seq": 1813}
{"id": "David_Passim_1814", "series": "CAG", "text": "ὁ γὰρ λόγος ὁ κανονίζων ἀπὸ τῶν καθόλου τὰ μερικὰ ἀναγκαίως ἀληθεύει·", "seq": 1814}
{"id": "David_Passim_1815", "series": "CAG", "text": "ἀνάγκη γὰρ πᾶσα τὸν ἄνθρωπον, εἴ γε ζῷόν ἐστιν, ὁμοίως πᾶσι τοῖς ζῴοις ἔμψυχον εἶναι.", "seq": 1815}
{"id": "David_Passim_1816", "series": "CAG", "text": "ὁ δὲ κανονίζων ἀπὸ τῶν μερικῶν τὰ καθόλου οὐκ ἔστι κυρίως τρόπος ἀποδείξεως, ἐπειδὴ οὐ δύναταί τις πᾶσι τοῖς μερικοῖς ἐπεξελθεῖν ἀπείροις καὶ ἀπεριλήπτοις οὖσιν, ἵνα κανονίσῃ ἐκ τῶν μερικῶν τὰ καθόλου.", "seq": 1816}
{"id": "David_Passim_1817", "series": "CAG", "text": "ἄλλως τε δὲ οὔτε ἀληθεύει πάντως ὁ λόγος ὁ ἐκ τῶν μερικῶν τὰ καθόλου κανονίζων·", "seq": 1817}
{"id": "David_Passim_1818", "series": "CAG", "text": "τὸ γὰρ λέγειν ὅτι ‘ὁ ἄνθρωπος τὴν κάτω γένυν κινεῖ, ὁ ἵππος τὴν κάτω γένυν κινεῖ, πᾶν ἄρα ζῷον τὴν κάτω γένυν κινεῖ’ οὐκ ἀληθεύει·", "seq": 1818}
{"id": "David_Passim_1819", "series": "CAG", "text": "οὔτε γὰρ ὁ κροκόδειλος οὔτε ὁ φοίνιξ τὸ ὄρνεον οὔτε ὁ δελφὶν τὴν κάτω γένυν κινοῦσιν, ἀλλὰ τὴν ἄνω.", "seq": 1819}
{"id": "David_Passim_1820", "series": "CAG", "text": "ἀλλ᾿ οὔτε δὲ ὁ ἐκ τοῦ ἴσου τὸ ἴσον κανονίζων ἐστὶ κυρίως τρόπος ἀποδείξεως·", "seq": 1820}
{"id": "David_Passim_1821", "series": "CAG", "text": "οὐδὲ γὰρ πάντως ἀληθεύει·", "seq": 1821}
{"id": "David_Passim_1822", "series": "CAG", "text": "οὔτε γὰρ εἰ ὁ Πεισίστρατος ἐτυράννησε, πάντως καὶ ὁ Διονύσιος τυραννήσει, οὔτε εἰ πλεύσας τις ἐναυάγησε, πάντως καὶ ἄλλος πλέων ναυαγήσει.", "seq": 1822}
{"id": "David_Passim_1823", "series": "CAG", "text": "Ἀναλυτικῆς δὲ ἔργον ἐστὶ τὸ διαλύειν τι εἰς ἐκεῖνα, ἐξ ὧν καὶ συνίσταται, οἷον ὡς ὅταν λαμβάνων τις τὸν ἄνθρωπον διαλύῃ αὐτὸν εἰς χεῖρας καὶ πόδας καὶ κεφαλὴν καὶ σάρκας καὶ ὀστέα, καὶ ταῦτα ἀναλύῃ εἰς τὰ τέσσαρα στοιχεῖα, ἐξ ὧν καὶ σύγκειται, καὶ τὰ τέσσαρα στοιχεῖα εἰς ὕλην καὶ εἰς εἶδος, ἐξ ὧν καὶ συνίσταται.", "seq": 1823}
{"id": "David_Passim_1824", "series": "CAG", "text": "ἰστέον δὲ ὅτι ἄλλο ἐστὶ διάλυσις καὶ ἄλλο ἀνάλυσις·", "seq": 1824}
{"id": "David_Passim_1825", "series": "CAG", "text": "ἡ μὲν γὰρ διάλυσις ἐπὶ τῶν μερῶν λέγεται, ἡ δὲ ἀνάλυσις ἐπὶ τῶν τεσσάρων στοιχείων.", "seq": 1825}
{"id": "David_Passim_1826", "series": "CAG", "text": "διαφέρουσι δὲ τὰ μέρη τῶν τεσσάρων στοιχείων, ὅτι τὰ μέρη οἰκείαν περιγραφὴν ἔχουσι καὶ περιωρισμένα εἰσί (καὶ γὰρ περιώρισται πόθεν ἕως ποῦ ἐστιν ἡ χεὶρ καὶ πόθεν ἕως ποῦ ἐστιν ὁ πούς), τὰ δὲ τέσσαρα στοιχεῖα οὐκ ἔχουσι περιγραφὴν οὐδέ εἰσι περιωρισμένα·", "seq": 1826}
{"id": "David_Passim_1827", "series": "CAG", "text": "οὐδὲ γάρ ἐστι περιωρισμένον πόθεν ἕως ποῦ ἐν τῷ ἀνθρώπῳ ἐστὶ τὸ ὕδωρ καὶ πόθεν ἕως ποῦ ἡ γῆ καὶ πόθεν ἕως ποῦ τὸ πῦρ καὶ πόθεν ἕως ποῦ ὁ ἀήρ.", "seq": 1827}
{"id": "David_Passim_1828", "series": "CAG", "text": "ταῦτα μὲν ἐν τούτοις.", "seq": 1828}
{"id": "David_Passim_1829", "series": "CAG", "text": "Ἡ δὲ τάξις αὐτῶν ἐστι τοιαύτη·", "seq": 1829}
{"id": "David_Passim_1830", "series": "CAG", "text": "ἡ διαιρετικὴ προτερεύει τῆς ὁριστικῆς, ἐπειδὴ καὶ ἡ διαίρεσις προτερεύει τοῦ ὁρισμοῦ·", "seq": 1830}
{"id": "David_Passim_1831", "series": "CAG", "text": "καὶ γὰρ λαμβάνων τις ἐκ τῆς διαιρέσεως τὰ χρειώδη ἀποτελεῖ τὸν ὅρον, οἷον βουλόμενος ὁρίσασθαι τὸν ἄνθρωπον λαμβάνει τὸ γένος, φημὶ δὲ τὸ ζῷον, καὶ ἐκ τῆς διαιρέσεως τοῦ ζῴου τῆς εἰς λογικὸν καὶ ἄλογον λαμβάνει τὸ λογικὸν καὶ ἐκ τῆς διαιρέσεως τοῦ λογικοῦ τῆς εἰς θνητὸν καὶ ἀθάνατον λαμβάνει τὸ θνητόν.", "seq": 1831}
{"id": "David_Passim_1832", "series": "CAG", "text": "ἐπειδὴ οὖν λαμβάνων τις ἐκ τῆς διαιρέσεως τὰ χρειώδη ἀποτελεῖ τὸν ὅρον, εὐλόγως ἡ διαιρετικὴ προτερεύει τῆς ὁριστικῆς.", "seq": 1832}
{"id": "David_Passim_1833", "series": "CAG", "text": "ἡ δὲ ὁριστικὴ προτερεύει τῆς ἀποδεικτικῆς, ἐπειδή, ὥς φησιν ὁ Ἀριστοτέλης, ‘ἀρχὴ ἀποδείξεως ὁ ὁρισμός ἐστιν’·", "seq": 1833}
{"id": "David_Passim_1834", "series": "CAG", "text": "ἡ γὰρ ἀπόδειξις τὴν φύσιν τοῦ ὑποκειμένου πράγματος παρίστησι, καὶ οἱ ὁρισμοὶ δὲ τὴν φύσιν τῶν πραγμάτων παριστῶσιν.", "seq": 1834}
{"id": "David_Passim_1835", "series": "CAG", "text": "ἡ δὲ ἀναλυτικὴ τελευταίαν ἔχει τάξιν, ἐπειδὴ ἐναντίως πως ἔχει πρὸς τὰ ἄλλα·", "seq": 1835}
{"id": "David_Passim_1836", "series": "CAG", "text": "καὶ γὰρ ἡ ἀναλυτικὴ ἐναντίως ἔχει πρὸς τὴν διαιρετικήν, ὅτι ἡ μὲν διαιρετικὴ ἀπὸ ἁπλοῦ τινος ἄρχεται καὶ εἰς σύνθετά τινα τελευτᾷ (καὶ γὰρ λαμβάνει τις τὴν οὐσίαν ἁπλοῦν τι οὖσαν καὶ διαιρῶν αὐτὴν καταντᾷ ἄχρι τοῦ ἀνθρώπου καὶ ἵππου καὶ κυνός, ἅτινα σύνθετά τινά εἰσιν), ἡ δὲ ἀναλυτικὴ ἀπὸ συνθέτου ἄρχεται καὶ εἰς ἁπλᾶ καταντᾷ·", "seq": 1836}
{"id": "David_Passim_1837", "series": "CAG", "text": "καὶ γὰρ ὁ ἀναλυτικὸς λαμβάνων τὸν ἄνθρωπον, ὅπερ σύνθετόν τί ἐστι, διαιρεῖ αὐτὸν ἄχρι τῆς ὕλης καὶ τοῦ εἴδους, ἅπερ ἁπλᾶ τινά εἰσι.", "seq": 1837}
{"id": "David_Passim_1838", "series": "CAG", "text": "πρὸς δὲ τὴν ὁριστικὴν ἐναντίως πως ἡ ἀναλυτική, ὅτι ἡ μὲν ὁριστικὴ ἐκ διαφόρων μίαν φύσιν ποιεῖ (καὶ γὰρ ἐκ τοῦ ζῷον λογικὸν θνητὸν νοῦ καὶ ἐπιστήμης δεκτικὸν μίαν φύσιν ἀποτελεῖ, τὸν ἄνθρωπον), ἡ δὲ ἀναλυτικὴ τοὐναντίον ἐξ ἑνός τινος διάφορα ποιεῖ·", "seq": 1838}
{"id": "David_Passim_1839", "series": "CAG", "text": "καὶ γὰρ λαμβάνει τὸν ἄνθρωπον ἕν τι ὄντα καὶ διαλύει αὐτὸν εἰς διάφορα, οἷον εἰς χεῖρας πόδας κεφαλὴν φλέβας σάρκας ὀστᾶ.", "seq": 1839}
{"id": "David_Passim_1840", "series": "CAG", "text": "πρὸς δὲ τὴν ἀποδεικτικὴν ἐναντίως ἔχει ἡ ἀναλυτική, ὅτι ἡ μὲν ἀποδεικτικὴ ἐκ συλλογισμῶν συνίσταται (βουλόμενοι γὰρ δεῖξαι τὸν ἄνθρωπον ἔμψυχον διὰ συλλογισμοῦ τοῦτο δεικνύομεν λέγοντες ὅτι ‘ὁ ἄνθρωπος ζῷον, πᾶν ζῷον ἔμψυχον, ὁ ἄνθρωπος ἄρα ἔμψυχον’), ὁ δὲ συλλογισμός, ὡς καὶ ἡ ὀνομασία δηλοῖ, συλλογή ἐστι λόγων, ἡ δὲ ἀναλυτικὴ τοὐναντίον διάλυσιν ποιεῖται·", "seq": 1840}
{"id": "David_Passim_1841", "series": "CAG", "text": "καὶ γὰρ τοὺς συλλογισμοὺς εἰς λόγους διαλύει καὶ τοὺς λόγους εἰς λέξεις.", "seq": 1841}
{"id": "David_Passim_1842", "series": "CAG", "text": "ταῦτα μὲν καὶ περὶ τῆς τάξεως.", "seq": 1842}
{"id": "David_Passim_1843", "series": "CAG", "text": "Ἔλθωμεν δὲ καὶ δείξωμεν πῶς χρησιμεύει τὸ παρὸν σύγγραμμα εἰς τὰς διαλεκτικὰς μεθόδους.", "seq": 1843}
{"id": "David_Passim_1844", "series": "CAG", "text": "ἰστέον ὅτι εἰς τὴν διαιρετικὴν χρησιμεύει οὕτως·", "seq": 1844}
{"id": "David_Passim_1845", "series": "CAG", "text": "ὥσπερ ἐν τοῖς ἔξω ἐστὶ τὸ διαιροῦν καὶ τὸ διαιρούμενον καὶ τὰ εἰς ἃ γίνεται ἡ διαίρεσις οἷον ὡς ἐπὶ τῆς τεκτονικῆς (ἔστι γὰρ ὁ πρίων ὁ διαιρῶν καὶ τὸ ξύλον τὸ διαιρούμενον καὶ αἱ σανίδες εἰς ἃς ἐγένετο ἡ διαίρεσις), οὕτω καὶ ἐνταῦθά ἐστι τὸ διαιροῦν καὶ τὸ διαιρούμενον καὶ τὰ εἰς ἃ ἐγένετο ἡ διαίρεσις, καὶ διαιρούμενον μέν ἐστι τὸ γένος (τοῦτο γάρ ἐστι τὸ διαιρούμενον) διαιροῦν δὲ αἱ συστατικαὶ διαφοραί (καὶ γὰρ αἱ συστατικαὶ διαφοραί εἰσιν αἱ διαιροῦσαι·", "seq": 1845}
{"id": "David_Passim_1846", "series": "CAG", "text": "τὸ γὰρ λογικὸν προσερχόμενον τῷ ζῴῳ διαιρεῖ αὐτὸ ἐκ τοῦ ἀλόγου ζῴου), διῃρημένα δέ εἰσι τὰ εἴδη·", "seq": 1846}
{"id": "David_Passim_1847", "series": "CAG", "text": "καὶ γὰρ τὰ εἴδη εἰσὶ τὰ ἐκ τῶν γενῶν διῃρημένα.", "seq": 1847}
{"id": "David_Passim_1848", "series": "CAG", "text": "συμβάλλεται οὖν ἡμῖν τὸ παρὸν σύγγραμμα εἰς τὴν διαιρετικήν, ἐπειδὴ διδάσκει ἡμᾶς τί ἐστι γένος καὶ τί εἶδος καὶ τί διαφορὰ καὶ λέγει ὅτι τὸ μὲν γένος τῇ ὕλῃ ἀναλογεῖ ἡ δὲ συστατικὴ διαφορὰ τῷ εἴδει·", "seq": 1848}
{"id": "David_Passim_1849", "series": "CAG", "text": "ὥσπερ γὰρ ἡ ἀνείδεος ὕλη κοινῶς πᾶσι τοῖς ζῴοις ὑπόκειται (πάντα γὰρ τὰ ζῷα ἐξ ὕλης καὶ εἴδους σύγκειται), προσερχόμενον δὲ τὸ εἶδος εἰδοποιεῖ αὐτὰ καὶ ποιεῖ τὸ μὲν ἄνθρωπον τὸ δὲ ἵππον, οὕτω καὶ τὸ γένος κοινῶς πᾶσι τοῖς εἴδεσιν ὑπόκειται (καὶ γὰρ τὸ ζῷον πᾶσι τοῖς εἴδεσιν αὐτοῦ ὑπόκειται), προσερχομένη δὲ ἡ διαφορὰ εἰδοποιεῖ αὐτὸ καὶ ποιεῖ τὸ μὲν λογικὸν ζῷον τὸ δὲ ἄλογον.", "seq": 1849}
{"id": "David_Passim_1850", "series": "CAG", "text": "εἰς δὲ τὴν ὁριστικὴν χρησιμεύει οὕτως·", "seq": 1850}
{"id": "David_Passim_1851", "series": "CAG", "text": "ὁ ὅρος ἀπὸ γένους καὶ συστατικῶν διαφορῶν σύγκειται, οἷον ἄνθρωπός ἐστι ζῷον λογικὸν θνητὸν νοῦ καὶ ἐπιστήμης δεκτικόν (ἰδοὺ τὸ μὲν ζῷον γένος ἐστίν, αἱ δὲ λοιπαὶ λέξεις συστατικαὶ διαφοραί)·", "seq": 1851}
{"id": "David_Passim_1852", "series": "CAG", "text": "διδάσκει δὲ ἡμᾶς τὸ παρὸν σύγγραμμα τί γένος καὶ τί συστατικαὶ διαφοραί.", "seq": 1852}
{"id": "David_Passim_1853", "series": "CAG", "text": "εἰς δὲ τὴν ἀποδεικτικὴν χρησιμεύει, ὅτι, ὡς ἐμάθομεν, ἡ ὁριστικὴ ἀρχή ἐστιν ἀποδείξεως·", "seq": 1853}
{"id": "David_Passim_1854", "series": "CAG", "text": "εἰ ἄρα οὖν εἰς τὴν ὁριστικὴν χρησιμεύει τὸ παρὸν σύγγραμμα, ὡς δέδεικται, δῆλον ὅτι διὰ μέσου τῆς ὁριστικῆς καὶ εἰς τὴν ἀποδεικτικὴν χρησιμεύει.", "seq": 1854}
{"id": "David_Passim_1855", "series": "CAG", "text": "εἰς δὲ τὴν ἀναλυτικὴν χρησιμεύει, ἐπειδὴ τὰ φυσικὰ πράγματα εἰς ὕλην καὶ εἶδος ἀναλύονται, ἐξ ὧν καὶ σύγκεινται·", "seq": 1855}
{"id": "David_Passim_1856", "series": "CAG", "text": "διδάσκει δὲ ἡμᾶς ὅτι ἀναλογεῖ τῇ μὲν ὕλῃ τὸ γένος τῷ δὲ εἴδει ἡ διαφορά.", "seq": 1856}
{"id": "David_Passim_1857", "series": "CAG", "text": "ἐν οἷς ἡ πρᾶξις.", "seq": 1857}
{"id": "David_Passim_1858", "series": "CAG", "text": "Πρᾶξις δ΄.", "seq": 1858}
{"id": "David_Passim_1859", "series": "CAG", "text": "Μαθόντες τὸν σκοπὸν καὶ τὸ χρήσιμον ἔλθωμεν καὶ εἴπωμεν τὴν αἰτίαν τῆς ἐπιγραφῆς.", "seq": 1859}
{"id": "David_Passim_1860", "series": "CAG", "text": "ἰστέον ὅτι ἐπιγέγραπται τὸ παρὸν σύγγραμμα Πορφυρίου Εἰσαγωγή, Πορφυρίου τοῦ Φοίνικος τοῦ μαθητοῦ Πλωτίνου τοῦ Λυκοπολίτου (ἡ δὲ Λυκόπολις ἐν Αἰγύπτῳ ἐστί), περὶ οὗ εἴρηται ὅτι", "seq": 1860}
{"id": "David_Passim_1861", "series": "CAG", "text": "οὐ πολλοὺς Αἴγυπτος, ἐπὴν δὲ τέκῃ, μέγα τίκτει.", "seq": 1861}
{"id": "David_Passim_1862", "series": "CAG", "text": "περὶ τούτου δὲ λέγει ὁ Πορφύριος ὅτι Πλωτῖνος ὁ καθ᾿ ἡμᾶς ἐῴκει μὲν αἰσχυνομένῳ, ὅτιπερ ἐν σώματι ἦν, βουλομένων δέ τινων ἀναθέσθαι αὐτῷ εἰκόνα ἔφη ὅτι ‘ἀρκεῖ μοι τὸ ἐκ τῆς φύσεως εἴδωλον, τοῦτ᾿ ἔστι τὸ σῶμα, μὴ καὶ εἰδώλου εἴδωλον ἔχειν’.", "seq": 1862}
{"id": "David_Passim_1863", "series": "CAG", "text": "εἰδώλου δὲ εἴδωλον τὴν εἰκόνα ἔφη·", "seq": 1863}
{"id": "David_Passim_1864", "series": "CAG", "text": "τοῦ γὰρ σώματός ἐστιν ἐκτύπωμα.", "seq": 1864}
{"id": "David_Passim_1865", "series": "CAG", "text": "ἰστέον δὲ ὅτι Πορφυρίου μαθητὴς ἦν ὁ Ἰάμβλιχος, περὶ ὧν, φημὶ δὲ τοῦ Πορφυρίου καὶ τοῦ Ἰαμβλίχου, εἶπεν ἡ Πυθία ‘ἔνθους ὁ Σύρος, πολυμαθὴς ὁ Φοίνιξ’, Φοίνικα πολυμαθῆ λέγουσα τὸν Πορφύριον (ἀπὸ γὰρ Φοινίκης ἦν), ἔνθουν δὲ Σύρον τὸν Ἰάμβλιχον (οὗτος γὰρ Σύρος ἦν)·", "seq": 1865}
{"id": "David_Passim_1866", "series": "CAG", "text": "ἔνθουν δὲ αὐτὸν λέγει, ἐπειδὴ περὶ τὰ θεῖα ἐνησχολεῖτο.", "seq": 1866}
{"id": "David_Passim_1867", "series": "CAG", "text": "Εἰσαγωγή δὲ ἐπιγέγραπται, ἐπειδὴ αὕτη εἰσάγει ἡμᾶς εἰς πᾶσαν τὴν φιλοσοφίαν·", "seq": 1867}
{"id": "David_Passim_1868", "series": "CAG", "text": "καὶ γὰρ διδάσκει ἡμᾶς περὶ τῶν πέντε φωνῶν, φημὶ δὴ περὶ γένους καὶ εἴδους καὶ διαφορᾶς καὶ ἰδίου καὶ συμβεβηκότος, ὑφ᾿ ἃς πᾶσα φωνὴ ὑπὸ τὴν φιλοσοφίαν οὖσα ἀνάγεται.", "seq": 1868}
{"id": "David_Passim_1869", "series": "CAG", "text": "εὐλόγως δὲ Εἰσαγωγή ἐπέγραψε καὶ οὐ Περὶ εἰσαγωγῆς, ἵνα δραστικώτερον δείξῃ τὸ σύγγραμμα καὶ ὅτι αὐτὴν τὴν εἰσαγωγὴν διδάσκει ἡμᾶς·", "seq": 1869}
{"id": "David_Passim_1870", "series": "CAG", "text": "αἱ γὰρ τοιαῦται ἐπιγραφαί, φημὶ δὴ αἱ ἄνευ τῆς προθέσεως, δραστικώτερον παριστῶσι τὸ σύγγραμμα, οἷον Πλάτωνος Φαίδων, Πλάτωνος Ἀλκιβιάδης·", "seq": 1870}
{"id": "David_Passim_1871", "series": "CAG", "text": "αἱ γὰρ μετὰ τῆς προθέσεως ὕφεσιν καὶ μείωσίν τινα εἰσάγουσιν, οἷον Περὶ ψυχῆς, Περὶ κρισίμων ἡμερῶν.", "seq": 1871}
{"id": "David_Passim_1872", "series": "CAG", "text": "Ἔλθωμεν δὲ καὶ ἐπὶ τὸ γνήσιον.", "seq": 1872}
{"id": "David_Passim_1873", "series": "CAG", "text": "ἰστέον ὅτι ἐκ πολλῶν δείκνυται γνήσιον Πορφυρίου τὸ παρὸν σύγγραμμα·", "seq": 1873}
{"id": "David_Passim_1874", "series": "CAG", "text": "καὶ γὰρ καὶ ἐκ τοῦ προοιμίου (πρὸς γὰρ Χρυσαόριόν τινα ὕπατον Ῥώμης ποιεῖται τὴν προσφώνησιν, πρὸς ὃν καὶ ἐν ἄλλοις αὐτοῦ συγγράμμασι προσφωνεῖ), καὶ ὅτι μέμνηται τοῦ συγγράμματος τούτου καὶ ἐν ἄλλοις αὐτοῦ συγγράμμασι, καὶ ὅτι σαφηνείας ἐνταῦθα φροντίζει, ὅπερ ἴδιον αὐτοῦ·", "seq": 1874}
{"id": "David_Passim_1875", "series": "CAG", "text": "καὶ γὰρ τριῶν ὄντων τρόπων, καθ᾿ οὓς ἡ ἀσάφεια γίνεται, ὡς ἐν τῷ προοιμίῳ μαθησόμεθα, αὐτὸς πάνυ τῆς σαφηνείας φροντίζει.", "seq": 1875}
{"id": "David_Passim_1876", "series": "CAG", "text": "ταῦτα μὲν καὶ τὸ γνήσιον.", "seq": 1876}
{"id": "David_Passim_1877", "series": "CAG", "text": "Ἔλθωμεν δὲ καὶ ἐπὶ τὴν τάξιν.", "seq": 1877}
{"id": "David_Passim_1878", "series": "CAG", "text": "ἰστέον ὅτι πρὸ πάσης τῆς φιλοσοφίας ἐστὶ τὸ παρὸν σύγγραμμα·", "seq": 1878}
{"id": "David_Passim_1879", "series": "CAG", "text": "εἰ γάρ, ὡς ἐμάθομεν ἐν τῷ χρησίμῳ, τὸ παρὸν σύγγραμμα εἰς τὰς Ἀριστοτέλους Κατηγορίας συμβάλλεται, αἱ δὲ Ἀριστοτέλους Κατηγορίαι πρώτην τάξιν ἔχουσι (πρὸ γὰρ ὅλης τῆς φιλοσοφίας εἰσί), δῆλον ὅτι εὐλόγως καὶ τὸ παρὸν σύγγραμμα πρὸ πάσης τῆς φιλοσοφίας ἐστί·", "seq": 1879}
{"id": "David_Passim_1880", "series": "CAG", "text": "καὶ γὰρ ὡς συμβαλλόμενον εἰς τὰς Ἀριστοτέλους Κατηγορίας προτέτακται αὐτῶν, προτετάμενον δὲ αὐτῶν ἐξ ἀνάγκης καὶ πρὸ πάσης τῆς φιλοσοφίας ἐστί·", "seq": 1880}
{"id": "David_Passim_1881", "series": "CAG", "text": "καὶ γὰρ αἱ Ἀριστοτέλους Κατηγορίαι πρὸ πάσης εἰσὶ τῆς φιλοσοφίας.", "seq": 1881}
{"id": "David_Passim_1882", "series": "CAG", "text": "ἄλλως τε δὲ τὸ παρὸν σύγγραμμα εἰσαγωγή ἐστι πάσης τῆς φιλοσοφίας·", "seq": 1882}
{"id": "David_Passim_1883", "series": "CAG", "text": "καὶ γὰρ διὰ τούτου εἰσαγόμεθα εἰς πᾶσαν τὴν φιλοσοφίαν διδασκόμενοι τὰς πέντε φωνάς, τοῦτ᾿ ἔστι τί γένος καὶ τί εἶδος καὶ τί διαφορὰ καὶ τί ἴδιον καὶ τί συμβεβηκός·", "seq": 1883}
{"id": "David_Passim_1884", "series": "CAG", "text": "εἰσαγωγὴ δὲ οὖσα πάσης τῆς φιλοσοφίας εὐλόγως πρὸ πάσης τῆς φιλοσοφίας ἐστί·", "seq": 1884}
{"id": "David_Passim_1885", "series": "CAG", "text": "καὶ γὰρ αἱ εἰσαγωγαὶ πρότεραι θέλουσιν εἶναι τῶν ὧν εἰσιν εἰσαγωγαί.", "seq": 1885}
{"id": "David_Passim_1886", "series": "CAG", "text": "ταῦτα μὲν καὶ ἡ τάξις.", "seq": 1886}
{"id": "David_Passim_1887", "series": "CAG", "text": "Ἔλθωμεν δὲ καὶ εἴπωμεν τὴν εἰς τὰ κεφάλαια διαίρεσιν.", "seq": 1887}
{"id": "David_Passim_1888", "series": "CAG", "text": "ἰστέον ὅτι τὸ παρὸν σύγγραμμα διαιρεῖται εἰς δύο τμήματα.", "seq": 1888}
{"id": "David_Passim_1889", "series": "CAG", "text": "καὶ ἐν μὲν τῷ πρώτῳ τμήματι λέγει τί ἐστιν ἑκάστη τῶν πέντε φωνῶν, οἷον τί ἐστι γένος, τί ἐστιν εἶδος καὶ τὰ ἑξῆς, ἐν δὲ τῷ δευτέρῳ τμήματι παραδίδωσι τὰς κοινωνίας καὶ τὰς διαφορὰς αὐτῶν.", "seq": 1889}
{"id": "David_Passim_1890", "series": "CAG", "text": "καὶ ὅσον μὲν κατὰ τὴν ἀκρίβειαν ἤρκει τὸ εἰπεῖν τί ἐστιν ἑκάστη τῶν φωνῶν (καὶ γὰρ ὁ γινώσκων τί ἐστιν ἑκάστη τῶν φωνῶν γινώσκει καὶ κατὰ τί κοινωνοῦσι καὶ κατὰ τί διαφέρουσιν), ἀλλ᾿ ἐπειδὴ πρὸς εἰσαγομένους ποιεῖται τὸν λόγον καὶ πρὸς Χρυσαόριόν τινα ὕπατον Ῥώμης πολιτικοῖς ἐνασχολούμενον πράγμασιν, ἠβουλήθη σαφεστέραν τὴν διδασκαλίαν ποιήσασθαι καὶ κατ᾿ ἰδίαν παραδοῦναι τὰς κοινωνίας καὶ τὰς διαφορὰς αὐτῶν.", "seq": 1890}
{"id": "David_Passim_1891", "series": "CAG", "text": "τινὲς δὲ λέγουσιν ὅτι εἰς τρία τμήματα διαιρεῖ τὴν παροῦσαν πραγματείαν, καὶ ἐν μὲν τῷ πρώτῳ παραδίδωσι τί ἐστιν ἑκάστη τῶν πέντε φωνῶν, ἐν δὲ τῷ δευτέρῳ λέγει τὰς κοινωνίας αὐτῶν, ἐν δὲ τῷ τρίτῳ τὰς διαφοράς.", "seq": 1891}
{"id": "David_Passim_1892", "series": "CAG", "text": "καὶ εἰ μὲν ἐν ἄλλῳ τόπῳ παρεδίδου τὰς κοινωνίας αὐτῶν καὶ ἐν ἄλλῳ τόπῳ τὰς διαφοράς, καλῶς ἂν ἔλεγον·", "seq": 1892}
{"id": "David_Passim_1893", "series": "CAG", "text": "ὅπου δὲ ἅμα κοινωνίαν καὶ διαφορὰν παραδίδωσι καὶ ἐν τῷ αὐτῷ τόπῳ τὰ δύο παραδίδωσι, δῆλον ὅτι οὐ δυνάμεθα τοῦτο δύο τμήματα εἰπεῖν·", "seq": 1893}
{"id": "David_Passim_1894", "series": "CAG", "text": "καὶ γὰρ μετὰ τὸ εἰπεῖν κοινωνίαν λέγει διαφορὰν καὶ πάλιν μετὰ τὸ εἰπεῖν διαφορὰν λέγει κοινωνίαν.", "seq": 1894}
{"id": "David_Passim_1895", "series": "CAG", "text": "ταῦτα μὲν καὶ ἡ εἰς τὰ κεφάλαια διαίρεσις.", "seq": 1895}
{"id": "David_Passim_1896", "series": "CAG", "text": "Ἔλθωμεν δὲ καὶ ἐπὶ τὸν διδασκαλικὸν τρόπον καὶ εἴπωμεν ποίῳ τρόπῳ διδασκαλικῷ κέχρηται.", "seq": 1896}
{"id": "David_Passim_1897", "series": "CAG", "text": "ἰστέον ὅτι τεσσάρων ὄντων τῶν διδασκαλικῶν τρόπων κατὰ τὸν Ἀριστοτέλην, οἷον διαιρετικοῦ ὁριστικοῦ ἀποδεικτικοῦ ἀναλυτικοῦ, τοῖς τέσσαρσι τρόποις κέχρηται·", "seq": 1897}
{"id": "David_Passim_1898", "series": "CAG", "text": "καὶ γὰρ καὶ τῷ διαιρετικῷ κέχρηται, ἡνίκα διαιρεῖ τὴν οὐσίαν εἰς σῶμα καὶ ἀσώματον καὶ εἰς τὰ ἑξῆς.", "seq": 1898}
{"id": "David_Passim_1899", "series": "CAG", "text": "ὁμοίως δὲ καὶ τῷ ὁριστικῷ, ἡνίκα ὑπογράφει τὰς πέντε φωνάς·", "seq": 1899}
{"id": "David_Passim_1900", "series": "CAG", "text": "καὶ γὰρ ἡ ὑπογραφὴ εἰκών ἐστι τοῦ ὁρισμοῦ.", "seq": 1900}
{"id": "David_Passim_1901", "series": "CAG", "text": "καὶ τῷ ἀποδεικτικῷ, ἡνίκα ἀποδείκνυσι πῶς θεωροῦνται ἐν τῷ γένει αἱ διαφοραί, ἆρα δυνάμει ἢ ἐνεργείᾳ.", "seq": 1901}
{"id": "David_Passim_1902", "series": "CAG", "text": "καὶ τῷ ἀναλυτικῷ, ἡνίκα τὰς ὑπογραφὰς τῶν πέντε φωνῶν ἀναλύει εἰς τὰς λέξεις.", "seq": 1902}
{"id": "David_Passim_1903", "series": "CAG", "text": "καὶ ἑκάστην τῶν λέξεων σαφηνίζει λέγων διὰ τί ἑκάστη τούτων πρόσκειται ἐν τῇ ὑπογραφῇ, καὶ πάλιν διαλαμβάνει περὶ τῆς ὕλης καὶ τοῦ εἴδους, εἰς ἃ τὰ φυσικὰ πράγματα ἀναλύονται, καὶ λέγει ὅτι τῇ μὲν ὕλῃ τὸ γένος ἀναλογεῖ, τῷ δὲ εἴδει ἡ διαφορά.", "seq": 1903}
{"id": "David_Passim_1904", "series": "CAG", "text": "ταῦτα μὲν καὶ περὶ τοῦ διδασκαλικοῦ τρόπου.", "seq": 1904}
{"id": "David_Passim_1905", "series": "CAG", "text": "Ἔλθωμεν δὲ καὶ εἴπωμεν τὴν ὑπὸ τί μέρος ἀναφοράν.", "seq": 1905}
{"id": "David_Passim_1906", "series": "CAG", "text": "ἰστέον ὅτι τὸ παρὸν σύγγραμμα ὑπὸ τὴν λογικὴν ἀνακτέον, ἡ δὲ λογικὴ εἴτε μέρος ἐστὶ τῆς φιλοσοφίας εἴτε ὄργανον ἐν ταῖς Κατηγορίαις μαθησόμεθα.", "seq": 1906}
{"id": "David_Passim_1907", "series": "CAG", "text": "ταῦτα ἔχει ἡ παροῦσα πρᾶξις καὶ τὰ προλεγόμενα τῆς Πορφυρίου Εἰσαγωγῆς.", "seq": 1907}
{"id": "David_Passim_1908", "series": "CAG", "text": "ΣΧΟΛΙΑ ΣΥΝ ΘΕΩΙ ΕΙΣ ΤΗΝ ΕΙΣΑΓΩΓΗΝ ΠΟΡΦΥΡΙΟΥ ΑΠΟ ΦΩΝΗΣ ΔΑΒΙΔ ΤΟΥ ΘΕΟΦΙΛΕΣΤΑΤΟΥ ΚΑΙ ΘΕΟΦΡΟΝΟΣ ΦΙΛΟΣΟΦΟΥ.", "seq": 1908}
{"id": "David_Passim_1909", "series": "CAG", "text": "<Πρᾶξις α΄.", "seq": 1909}
{"id": "David_Passim_1910", "series": "CAG", "text": ">.", "seq": 1910}
{"id": "David_Passim_1911", "series": "CAG", "text": "Ἐπειδὴ κόρον ἔχειν τῶν προοιμίων ἡγούμεθα (πάντων γὰρ κόρος ἐστὶ τῶν ἐφ᾿ ἡμῖν πλὴν τῶν ἀρετῶν), σπουδαιότερον αὐτοὺς τοὺς ἀγῶνας ὑποδυσώμεθα ἐπ᾿ αὐτήν που ἀφικόμενοι τῆς μετὰ χεῖρας λέξεως τὴν ἐξήγησιν.", "seq": 1911}
{"id": "David_Passim_1912", "series": "CAG", "text": "αὕτη τοίνυν ἡ προκειμένη λέξις, φημὶ δὴ τὸ προοίμιον, διττὴν ἔχει τὴν παράδοσιν·", "seq": 1912}
{"id": "David_Passim_1913", "series": "CAG", "text": "ἐν μὲν γὰρ τῷ πρώτῳ προοιμίῳ τρία τινὰ παραδίδωσι, τὸν σκοπὸν τὸ χρήσιμον καὶ τὸν τρόπον τῆς διδασκαλίας, ἐν δὲ τῷ δευτέρῳ προοιμίῳ αἰτίας τινὰς παραδίδωσι τῶν λεχθησομένων.", "seq": 1913}
{"id": "David_Passim_1914", "series": "CAG", "text": "Ἐν τῷ πρώτῳ προοιμίῳ τὸ μὲν χρήσιμον καταμερίσας ὁ φιλόσοφος τὸ μὲν προέταξε τὸ δὲ μετέταξε τοῦ σκοποῦ μεσαζομένου.", "seq": 1914}
{"id": "David_Passim_1915", "series": "CAG", "text": "ἄξιον δὲ ζητῆσαι τί δήποτε οὕτως ἔταξε.", "seq": 1915}
{"id": "David_Passim_1916", "series": "CAG", "text": "καί φαμεν ὅτι θεωρῶν ὁ φιλόσοφος τοὺς εἰσαγομένους ἑλκομένους τε καὶ ἀνθελκομένους ἐξ ἑκατέρων, φημὶ δὴ τοῦ σκοποῦ καὶ τοῦ χρησίμου, μέσην ὁδὸν βαδίζων ὁ Πορφύριος συνεκέρασε τῷ σκοπῷ τὸ χρήσιμον καὶ μεταξὺ τοῦ χρησίμου τὸν σκοπὸν ἔθηκε·", "seq": 1916}
{"id": "David_Passim_1917", "series": "CAG", "text": "καὶ γὰρ ὁ σκοπὸς πρὸς ἑαυτὸν ἀνθέλκει ἡμᾶς, ἐπειδὴ ἀπὸ τούτου ἄρξασθαι δεῖ, εἴ γε κατὰ τὸν Πλάτωνα ‘μία ἐστὶ ἀρχὴ τοῦ καλῶς βουλεύεσθαι, τὸ εἰδέναι περὶ ὅτου ἐστὶν ἡ σκέψις, ἢ τοῦ παντὸς ἁμαρτάνειν ἀνάγκη’·", "seq": 1917}
{"id": "David_Passim_1918", "series": "CAG", "text": "ὁ γὰρ τὸν σκοπὸν τοῦ συγγράμματος ἀγνοῶν οὐδ᾿ ὅλως παρακολουθεῖ τοῖς λεγομένοις.", "seq": 1918}
{"id": "David_Passim_1919", "series": "CAG", "text": "τὸ δὲ χρήσιμον πρὸς ἑαυτὸ ἡμᾶς ἀνθέλκει, ἐπειδὴ γινώσκοντες τὰ ἐκ τοῦ συγγράμματος ἀναφυόμενον χρήσιμον προθυμότερον αὐτὸ ἀναγινώσκομεν·", "seq": 1919}
{"id": "David_Passim_1920", "series": "CAG", "text": "καὶ γὰρ εἰ μή τις θαυμάσει τι, οὐκ ἔρχεται εἰς τὸ ζητῆσαί τι περὶ αὐτοῦ·", "seq": 1920}
{"id": "David_Passim_1921", "series": "CAG", "text": "οἷον ὁ πλέων τοῦ πλοίου κινουμένου νομίζει τὴν γῆν κινεῖσθαι, καὶ εἰ μὴ θαυμάσει τὸ γινόμενον, οὐδὲ ἔρχεται εἰς ζήτησιν τούτου, τοῦτ᾿ ἔστιν οὐ ζητεῖ πόθεν γίνεται τοῦτο.", "seq": 1921}
{"id": "David_Passim_1922", "series": "CAG", "text": "ὅθεν καὶ τὴν Ἶριν τὴν ἄγγελον τῶν θεῶν Θαύμαντος θυγατέρα ἔλεγον ἀλληγορικῶς νοοῦντες τὴν φιλοσοφίαν·", "seq": 1922}
{"id": "David_Passim_1923", "series": "CAG", "text": "καὶ γὰρ τὴν Ἶριν τὴν φιλοσοφίαν λέγουσιν εἶναι·", "seq": 1923}
{"id": "David_Passim_1924", "series": "CAG", "text": "ὥσπερ γὰρ ἡ Ἶρις μυθεύεται παρὰ τοῖς ποιηταῖς ἄγγελος εἶναι τῶν θεῶν, οὕτω καὶ ἡ φιλοσοφία ἄγγελός ἐστι τῶν θεῶν·", "seq": 1924}
{"id": "David_Passim_1925", "series": "CAG", "text": "αὕτη γὰρ ἀπαγγέλλει ἡμῖν τὰ θεῖα, εἴ γε γνῶσις θείων τε καὶ ἀνθρωπίνων πραγμάτων ἐστί.", "seq": 1925}
{"id": "David_Passim_1926", "series": "CAG", "text": "Θαύμαντος δὲ θυγατέρα αὐτὴν ἔλεγον, ἐπειδὴ ἀρχὴ τῆς φιλοσοφίας τὸ θαῦμά ἐστιν·", "seq": 1926}
{"id": "David_Passim_1927", "series": "CAG", "text": "εἰ γὰρ μὴ θαυμάσει τίς τι, οὐδὲ ἔρχεται εἰς τὸ ζητῆσαί τι περὶ αὐτοῦ·", "seq": 1927}
{"id": "David_Passim_1928", "series": "CAG", "text": "οἷον εἰ μὴ θαυμάσει τις τὴν ἶριν τὴν οὖσαν ἐν τῷ οὐρανῷ, οὐδὲ ἔρχεται εἰς τὸ ζητῆσαι πόθεν γίνεται τοῦτο.", "seq": 1928}
{"id": "David_Passim_1929", "series": "CAG", "text": "διὰ τοῦτο οὖν ἀπὸ τοῦ χρησίμου δεῖ ἄρχεσθαι, ἐπειδή, ὡς εἴρηται, γινώσκοντες τὸ ἐκ τοῦ συγγράμματος ἀναφυόμενον χρήσιμον προθυμότερον ἀναγινώσκομεν τὸ σύγγραμμα.", "seq": 1929}
{"id": "David_Passim_1930", "series": "CAG", "text": "ἄλλως τε δὲ καὶ κατὰ τὸν Πίνδαρον ‘χρὴ παντὸς ἔργου πρόσωπον θέμεναι θηλαυγές’, ὥσπερ καὶ ἐπὶ τῶν οἴκων·", "seq": 1930}
{"id": "David_Passim_1931", "series": "CAG", "text": "δεῖ γὰρ τὰ τῶν οἴκων προπύλαια λαμπρὰ εἶναι, ἵνα διὰ τούτων ἅπας θαυμάσῃ καὶ τὰ ἔσω·", "seq": 1931}
{"id": "David_Passim_1932", "series": "CAG", "text": "οὕτως οὖν δεῖ τὸ χρήσιμον εὐθέως ἐν τῷ προοιμίῳ εἶναι, ἵνα πᾶς εὐθέως γινώσκων τὸ χρήσιμον προθυμότερος ἔλθῃ ἐπὶ τὴν ἀνάγνωσιν τοῦ συγγράμματος.", "seq": 1932}
{"id": "David_Passim_1933", "series": "CAG", "text": "ἑκατέρου οὖν ὡς εἴρηται τούτων, τοῦ τε χρησίμου καὶ τοῦ σκοποῦ, πρὸς ἑαυτὸ ἡμᾶς ἀνθέλκοντος τὴν μέσην ὁδὸν βαδίζων ὁ Πορφύριος συνεκέρασε τὸ χρήσιμον τῷ σκοπῷ καὶ μεταξὺ τοῦ χρησίμου τὸν σκοπὸν ἔθηκε·", "seq": 1933}
{"id": "David_Passim_1934", "series": "CAG", "text": "τριττοῦ γὰρ ὄντος τοῦ χρησίμου, ὡς ἐν τῷ προοιμίῳ εἴρηται, τοῦ παρόντος συγγράμματος (χρησιμεύει γάρ, ὡς εἴρηται, καὶ εἰς τὰς Ἀριστοτέλους Κατηγορίας καὶ εἰς πᾶσαν τὴν φιλοσοφίαν καὶ εἰς τὰς διαλεκτικὰς μεθόδους), εὐθέως ἐν τῷ προοιμίῳ τίθησι τοὺς δύο τρόπους τοῦ χρησίμου καὶ μετὰ ταῦτα τὸν σκοπὸν καὶ τελευταῖον τὸν τρίτον τρόπον τοῦ χρησίμου·", "seq": 1934}
{"id": "David_Passim_1935", "series": "CAG", "text": "φησὶ γὰρ οὕτως·", "seq": 1935}
{"id": "David_Passim_1936", "series": "CAG", "text": "1.", "seq": 1936}
{"id": "David_Passim_1937", "series": "CAG", "text": "3 Ὄντος ἀναγκαίου, Χρυσαόριε, καὶ εἰς τὴν τῶν παρὰ Ἀριστοτέλει Κατηγοριῶν διδασκαλίαν τοῦ γνῶναι τί γένος καὶ τί διαφορὰ τί τε εἶδος καὶ τί ἴδιον καὶ τί συμβεβηκός, εἴς τε τὴν τῶν ὁρισμῶν ἀπόδοσιν καὶ ὅλως εἰς τὰ περὶ διαιρέσεως καὶ ἀποδείξεως.", "seq": 1937}
{"id": "David_Passim_1938", "series": "CAG", "text": "Καὶ ἰδοὺ διὰ μὲν τοῦ εἰπεῖν καὶ εἰς τὴν τῶν παρὰ Ἀριστοτέλει κατηγοριῶν διδασκαλίαν ἐδήλωσεν ὅτι οὐ μόνον εἰς τὰς Ἀριστοτέλους Κατηγορίας χρησιμεύει τὸ παρὸν σύγγραμμα ἀλλὰ καὶ εἰς πᾶσαν τὴν φιλοσοφίαν·", "seq": 1938}
{"id": "David_Passim_1939", "series": "CAG", "text": "ὁ γὰρ καί σύνδεσμος καὶ ἄλλου τινός ἐστι δηλωτικός, οἷον ὡς ὅταν εἴπωμεν ‘καὶ γράφει’·", "seq": 1939}
{"id": "David_Passim_1940", "series": "CAG", "text": "ἐὰν γὰρ εἴπωμεν μετὰ τοῦ καί συνδέσμου, δηλοῦμεν ὅτι καὶ ἄλλο τι ποιεῖ.", "seq": 1940}
{"id": "David_Passim_1941", "series": "CAG", "text": "οὕτως οὖν εἰπὼν μετὰ τοῦ καί συνδέσμου καὶ εἰς τὴν τῶν παρὰ Ἀριστοτέλει Κατηγοριῶν διδασκαλίαν ἐδήλωσεν ὅτι καὶ εἰς ἄλλο τι χρησιμεύει.", "seq": 1941}
{"id": "David_Passim_1942", "series": "CAG", "text": "εἰπὼν δὲ τοῦ γνῶναι τί διαφορὰ καὶ τί εἶδος καὶ τὰ ἑξῆς ἐδήλωσε τὸν σκοπόν·", "seq": 1942}
{"id": "David_Passim_1943", "series": "CAG", "text": "σκοπὸν γὰρ ἔχει περὶ τούτων διαλαβεῖν.", "seq": 1943}
{"id": "David_Passim_1944", "series": "CAG", "text": "εἰπὼν δὲ εἴς τε τὴν τῶν ὁρισμῶν ἀπόδοσιν καὶ ὅλως εἰς τὰ περὶ διαιρέσεως καὶ ἀποδείξεως τὸν τρίτον τρόπον τοῦ χρησίμου ἐδήλωσε, τοῦτ᾿ ἔστιν ὅτι χρησιμεύει τὸ παρὸν σύγγραμμα καὶ εἰς τὰς διαλεκτικὰς μεθόδους, εἰς τὴν διαιρετικὴν ὁριστικὴν ἀποδεικτικὴν καὶ ἀναλυτικήν.", "seq": 1944}
{"id": "David_Passim_1945", "series": "CAG", "text": "παραδίδωσι δὲ καὶ τὸν διδασκαλικὸν τρόπον, ὡς ἐν τοῖς ἑξῆς μαθησόμεθα.", "seq": 1945}
{"id": "David_Passim_1946", "series": "CAG", "text": "ταῦτα μὲν ἐν τούτοις.", "seq": 1946}
{"id": "David_Passim_1947", "series": "CAG", "text": "Ἄξιον δὲ ζητῆσαι διὰ τί οὕτως ἐποιήσατο τὴν τάξιν ὁ Πορφύριος τῶν πέντε φωνῶν, τοῦτ᾿ ἔστι διὰ τί πρῶτον τὸ γένος ἔθηκε καὶ δεύτερον τὴν διαφορὰν τρίτον τὸ εἶδος τέταρτον τὸ ἴδιον καὶ πέμπτον τὸ συμβεβηκός.", "seq": 1947}
{"id": "David_Passim_1948", "series": "CAG", "text": "ἀλλὰ πρὸ τούτου ὀλίγα τινὰ ἔξωθεν εἴπωμεν.", "seq": 1948}
{"id": "David_Passim_1949", "series": "CAG", "text": "ἰστέον ὅτι ἐπειδὴ τὰ μερικὰ ἄλλοτε ἄλλως ἔχουσι καὶ ἀεὶ ἐν φθορᾷ εἰσι καὶ ἐν ἀλλαγῇ καὶ στάσεως οὐδεμιᾶς μετέχουσι, τούτου χάριν ἡ φιλοσοφία μιμουμένη τὴν φύσιν ἐπενόησε τὰ καθόλου, ἅτινα ἀεὶ ὡσαύτως ἔχουσιν (ἀεὶ γὰρ ὁ καθόλου ἄνθρωπος ὡσαύτως ἔχει), περὶ ἃ καὶ καταγίνεται.", "seq": 1949}
{"id": "David_Passim_1950", "series": "CAG", "text": "τὰ δὲ μερικὰ λέγεται καὶ καθ᾿ ἕκαστον καὶ ἄτομα.", "seq": 1950}
{"id": "David_Passim_1951", "series": "CAG", "text": "καὶ καθ᾿ ἕκαστον μὲν λέγεται, ἐπειδὴ δύναται ἕκαστον τούτων καθ᾿ ἑαυτὸ παραλαμβάνεσθαι, ἄτομα δὲ λέγονται, οὐκ ἐπειδὴ οὐ τέμνονται (τέμνονται γὰρ ὡς ὅλον εἰς μέρη·", "seq": 1951}
{"id": "David_Passim_1952", "series": "CAG", "text": "τέμνεται γὰρ <ὁ Σωκράτης> εἰς χεῖρας καὶ πόδας καὶ κεφαλήν), ἀλλ᾿ ἄτομα λέγονται, ἐπειδὴ ὥσπερ τὸ γένος διαιρεῖται εἰς εἴδη, οἷον τὸ ζῷον εἰς ἄνθρωπον ἵππον καὶ κύνα, καὶ τὰ εἴδη εἰς ἄτομα, οἷον ὁ καθόλου ἄνθρωπος εἰς Σωκράτην Πλάτωνα Ἀλκιβιάδην, τὸν αὐτὸν τρόπον οὐ διαιρεῖται ταῦτα εἰς τέλειά τινα·", "seq": 1952}
{"id": "David_Passim_1953", "series": "CAG", "text": "εἰ γὰρ καὶ ὁ Σωκράτης διαιρεῖται εἰς χεῖρας πόδας καὶ κεφαλήν, ἀλλ᾿ οὖν εἰς τέλειά τινα οὐ διαιρεῖται·", "seq": 1953}
{"id": "David_Passim_1954", "series": "CAG", "text": "οὔτε γὰρ ἡ χεὶρ καθ᾿ ἑαυτὴν οὖσα τέλειόν τί ἐστιν οὔτε ὁ ποὺς καθ᾿ ἑαυτὸν ὢν οὔτε ἡ κεφαλὴ καθ᾿ ἑαυτὴν οὖσα.", "seq": 1954}
{"id": "David_Passim_1955", "series": "CAG", "text": "διὰ τοῦτο οὖν λέγεται ταῦτα ἄτομα, ἐπειδὴ ὡς εἴρηται οὐ διαιροῦνται εἰς τέλειά τινα.", "seq": 1955}
{"id": "David_Passim_1956", "series": "CAG", "text": "πάλιν ἄτομα λέγεται, ἐπειδὴ διαιρούμενα οὐ σώζει τὸ οἰκεῖον εἶδος·", "seq": 1956}
{"id": "David_Passim_1957", "series": "CAG", "text": "καὶ γὰρ Σωκράτης διαιρούμενος εἰς χεῖρας πόδας καὶ κεφαλὴν οὐ σώζει τὸ οἰκεῖον εἶδος·", "seq": 1957}
{"id": "David_Passim_1958", "series": "CAG", "text": "οὐ γὰρ ἡ χεὶρ κατ᾿ ἰδίαν λέγεται Σωκράτης οὔτε ὁ ποὺς οὔτε ἡ κεφαλή, ἀλλ᾿ ἅμα πάντα τὰ μέρη.", "seq": 1958}
{"id": "David_Passim_1959", "series": "CAG", "text": "διὰ τοῦτο δὲ τὰ ἄτομα διαιρούμενα οὐ σώζει τὸ οἰκεῖον εἶδος, ἐπειδὴ ὡς ὅλον εἰς μέρη διαιροῦνται, τὰ δὲ ὡς ὅλον εἰς μέρη διαιρούμενα οὐ σώζει τὸ οἰκεῖον εἶδος·", "seq": 1959}
{"id": "David_Passim_1960", "series": "CAG", "text": "ἐὰν γὰρ διαιρεθῶσιν, οὐκέτι φυλάττουσι τὸ αὐτὸ εἶδος, ὅπερ εἶχον καὶ πρότερον.", "seq": 1960}
{"id": "David_Passim_1961", "series": "CAG", "text": "λέγουσι δέ τινες ὅτι κακῶς λέγετε τὰ ὡς ὅλον εἰς μέρη διαιρούμενα μὴ σώζειν τὸ οἰκεῖον εἶδος·", "seq": 1961}
{"id": "David_Passim_1962", "series": "CAG", "text": "ἰδοὺ γὰρ ὁ καθόλου ἄνθρωπος ὅλον τι ὢν διαιρεῖται εἰς τοὺς κατὰ μέρος ἀνθρώπους, οἷον εἰς Σωκράτην Πλάτωνα καὶ Ἀλκιβιάδην, καὶ φυλάττει τὸ αὐτὸ εἶδος·", "seq": 1962}
{"id": "David_Passim_1963", "series": "CAG", "text": "καὶ γὰρ ὁ Σωκράτης ἄνθρωπός ἐστι καὶ ὁ Πλάτων ὁμοίως καὶ ὁ Ἀλκιβιάδης.", "seq": 1963}
{"id": "David_Passim_1964", "series": "CAG", "text": "πρὸς οὓς ἔστιν εἰπεῖν ὅτι οὐκ ἔστι τοῦτο ὅλον, ἀλλὰ καθόλου·", "seq": 1964}
{"id": "David_Passim_1965", "series": "CAG", "text": "ἄλλο γάρ ἐστι τὸ ὅλον καὶ ἄλλο τὸ καθόλου·", "seq": 1965}
{"id": "David_Passim_1966", "series": "CAG", "text": "τὸ μὲν γὰρ καθόλου ὁμοειδῶς ἐν ἑκάστῳ τῶν εἰδῶν αὐτοῦ καὶ τῶν ἀτόμων θεωρεῖται, οἷον τὸ καθόλου ζῷον ὁμοειδῶς ἐν παντὶ τῶν εἰδῶν αὐτοῦ θεωρεῖται·", "seq": 1966}
{"id": "David_Passim_1967", "series": "CAG", "text": "καὶ γὰρ ὁ ἄνθρωπος ζῷόν ἐστι καὶ ὁ ἵππος ζῷόν ἐστι καὶ ὁ κύων ὁμοίως.", "seq": 1967}
{"id": "David_Passim_1968", "series": "CAG", "text": "καὶ ἐν παντὶ δὲ τῶν ἀτόμων αὐτοῦ ὁμοτίμως θεωρεῖται·", "seq": 1968}
{"id": "David_Passim_1969", "series": "CAG", "text": "καὶ γὰρ καὶ ὁ Σωκράτης ζῷόν ἐστι καὶ ὁ Πλάτων.", "seq": 1969}
{"id": "David_Passim_1970", "series": "CAG", "text": "τὸ δὲ ὅλον οὐ θεωρεῖται ὁμοτίμως ἐν παντὶ τῶν μερῶν·", "seq": 1970}
{"id": "David_Passim_1971", "series": "CAG", "text": "καὶ γὰρ ὁ Σωκράτης οὐ θεωρεῖται ἐν χειρὶ μόνῃ ἢ ἐν ποδὶ μόνῳ ἢ ἐν τῇ κεφαλῇ μόνῃ ἀλλ᾿ ἐν ὅλοις ἅμα τοῖς μέρεσιν·", "seq": 1971}
{"id": "David_Passim_1972", "series": "CAG", "text": "οὔτε γὰρ ἡ χεὶρ τοῦ Σωκράτους Σωκράτης ἐστὶν οὔτε ἡ κεφαλή, ἀλλ᾿ ἅμα πάντα τὰ μέρη.", "seq": 1972}
{"id": "David_Passim_1973", "series": "CAG", "text": "Ἔλθωμεν τοίνυν καὶ εἴπωμεν περὶ τῆς τάξεως τῶν πέντε φωνῶν.", "seq": 1973}
{"id": "David_Passim_1974", "series": "CAG", "text": "ἰστέον ὅτι, ὡς ἐμάθομεν ἐν τῷ σκοπῷ, ἡνίκα τὴν διαίρεσιν τῆς φωνῆς ἐποιούμεθα, τὸ γένος καὶ τὸ εἶδος καὶ ἡ διαφορὰ οὐσιώδη εἰσί, τὸ δὲ ἴδιον καὶ τὸ συμβεβηκὸς ἐπουσιώδη.", "seq": 1974}
{"id": "David_Passim_1975", "series": "CAG", "text": "ἔστι δὲ καὶ τὸ ἴδιον πολλάκις οὐσιῶδες, ὡς ἐκεῖ μεμαθήκαμεν.", "seq": 1975}
{"id": "David_Passim_1976", "series": "CAG", "text": "ἐπειδὴ οὖν τὸ γένος καὶ ἡ διαφορὰ καὶ τὸ εἶδος μόνως οὐσιώδη εἰσί, τὸ δὲ συμβεβηκὸς ἐπουσιῶδες καὶ τὸ ἴδιον ὁμοίως (εἰ καὶ εὕρηται οὐσιῶδες, ἀλλ᾿ οὖν οὐκ ἀεί ἐστιν οὐσιῶδες), τούτου χάριν τὸ γένος καὶ ἡ διαφορὰ καὶ τὸ εἶδος προτερεύουσι τοῦ τε ἰδίου καὶ τοῦ συμβεβηκότος·", "seq": 1976}
{"id": "David_Passim_1977", "series": "CAG", "text": "τὸ γὰρ οὐσιῶδες τιμιώτερον τοῦ ἐπουσιώδους ἐστίν, εἴ γε τὸ μὲν οὐσιῶδες παρὸν μὲν σώζει ἀπὸν δὲ φθείρει (καὶ γὰρ τὸ λογικὸν παρὸν μὲν συνίστησι τὸν ἀνθρώπων ἀπὸν δὲ φθείρει αὐτόν·", "seq": 1977}
{"id": "David_Passim_1978", "series": "CAG", "text": "τοῦ γὰρ λογικοῦ ἀπόντος οὐδὲ ἄνθρωπός ἐστι), τὸ δὲ ἐπουσιῶδες ἤγουν τὸ ἐπὶ τῆς οὐσίας ὄν, τοῦτ᾿ ἔστι τὸ συμβεβηκός, οὔτε παρὸν σώζει οὔτε ἀπὸν φθείρει·", "seq": 1978}
{"id": "David_Passim_1979", "series": "CAG", "text": "καὶ γὰρ τὸ λευκὸν οὔτε παρὸν συνίστησι τὸν ἄνθρωπον οὔτε ἀπὸν φθείρει αὐτόν·", "seq": 1979}
{"id": "David_Passim_1980", "series": "CAG", "text": "ἐνδέχεται γὰρ μὴ ὄντα λευκὸν τὸν ἄνθρωπον ἀλλὰ μέλανα ἄνθρωπον εἶναι.", "seq": 1980}
{"id": "David_Passim_1981", "series": "CAG", "text": "τούτου οὖν χάριν, ὡς εἴρηται, τὸ γένος καὶ ἡ διαφορὰ καὶ τὸ εἶδος προτερεύουσι τοῦ ἰδίου καὶ τοῦ συμβεβηκότος.", "seq": 1981}
{"id": "David_Passim_1982", "series": "CAG", "text": "τὸ δὲ γένος προτερεύει τῆς διαφορᾶς, ἐπειδὴ τὸ γένος περιέχει ἐν ἑαυτῷ τὰς διαφοράς·", "seq": 1982}
{"id": "David_Passim_1983", "series": "CAG", "text": "καὶ γὰρ τὸ καθόλου ζῷον περιέχει ἐν ἑαυτῷ καὶ τὸ λογικὸν καὶ τὸ ἄλογον.", "seq": 1983}
{"id": "David_Passim_1984", "series": "CAG", "text": "ἡ δὲ διαφορὰ προτερεύει τοῦ εἴδους, ἐπειδὴ ἡ διαφορὰ καθολικωτέρα ἐστὶ τοῦ εἴδους·", "seq": 1984}
{"id": "David_Passim_1985", "series": "CAG", "text": "καὶ γὰρ τὸ λογικὸν τοῦ ἀνθρώπου καθολικώτερόν ἐστι·", "seq": 1985}
{"id": "David_Passim_1986", "series": "CAG", "text": "φέρεται γὰρ κατὰ πλειόνων·", "seq": 1986}
{"id": "David_Passim_1987", "series": "CAG", "text": "οὐ μόνον γὰρ ὁ ἄνθρωπος λογικός ἐστιν ἀλλὰ καὶ ἄγγελος καὶ δαίμων.", "seq": 1987}
{"id": "David_Passim_1988", "series": "CAG", "text": "τὸ δὲ εἶδος προτερεύει τοῦ ἰδίου, ἐπειδὴ τὸ μὲν εἶδος μόνως οὐσιῶδές ἐστι, τὸ δὲ ἴδιον οὐκ ἔστι μόνως οὐσιῶδες, ὡς εἴρηται·", "seq": 1988}
{"id": "David_Passim_1989", "series": "CAG", "text": "τὰ δὲ οὐσιώδη, ὡς δέδεικται, τιμιώτερά εἰσι τῶν ἐπουσιωδῶν.", "seq": 1989}
{"id": "David_Passim_1990", "series": "CAG", "text": "τὸ δὲ ἴδιον προτερεύει τοῦ συμβεβηκότος, ἐπειδὴ τὸ μὲν συμβεβηκὸς μόνως ἐπουσιῶδές ἐστι, τὸ δὲ ἴδιον καὶ οὐσιῶδες καὶ ἐπουσιῶδες·", "seq": 1990}
{"id": "David_Passim_1991", "series": "CAG", "text": "εὐλόγως οὖν προτερεύει τὸ ἴδιον·", "seq": 1991}
{"id": "David_Passim_1992", "series": "CAG", "text": "καὶ γάρ, ὡς δέδεικται, τὸ οὐσιῶδες τιμιώτερόν ἐστι τοῦ ἐπουσιώδους.", "seq": 1992}
{"id": "David_Passim_1993", "series": "CAG", "text": "κατ᾿ ἄλλον δὲ λόγον προτερεύει τὸ ἴδιον τοῦ συμβεβηκότος, ὅτι τὸ μὲν ἴδιον ἀντιστρέφει (δύναμαι γὰρ εἰπεῖν ὅτι εἴ τι ἄνθρωπος, καὶ γελαστικόν, καὶ εἴ τι γελαστικόν, καὶ ἄνθρωπος·", "seq": 1993}
{"id": "David_Passim_1994", "series": "CAG", "text": "μόνῳ γὰρ τῷ ἀνθρώπῳ τὸ γελαστικὸν ἕπεται), τὸ δὲ συμβεβηκὸς οὐκ ἀντιστρέφει·", "seq": 1994}
{"id": "David_Passim_1995", "series": "CAG", "text": "οὐ δύναμαι γὰρ εἰπεῖν ὅτι εἴ τι κύκνος, λευκόν, καὶ εἴ τι λευκόν, κύκνος·", "seq": 1995}
{"id": "David_Passim_1996", "series": "CAG", "text": "οὐ γὰρ ἀληθεύει ὁ λόγος·", "seq": 1996}
{"id": "David_Passim_1997", "series": "CAG", "text": "ἰδοὺ γὰρ καὶ ἡ χιὼν καὶ τὸ ψιμύθιον λευκά εἰσι καὶ οὔκ εἰσι κύκνοι.", "seq": 1997}
{"id": "David_Passim_1998", "series": "CAG", "text": "ταῦτα ἔχει καὶ ἡ παροῦσα πρᾶξις.", "seq": 1998}
{"id": "David_Passim_1999", "series": "CAG", "text": "Πρᾶξις β΄.", "seq": 1999}
{"id": "David_Passim_2000", "series": "CAG", "text": "1.", "seq": 2000}
{"id": "David_Passim_2001", "series": "CAG", "text": "3 Ὄντος ἀναγκαίου.", "seq": 2001}
{"id": "David_Passim_2002", "series": "CAG", "text": "Τινὲς αἰτιῶνται τὴν ἀρχὴν ὡς κακῶς ἔχουσαν·", "seq": 2002}
{"id": "David_Passim_2003", "series": "CAG", "text": "φασὶ γάρ·", "seq": 2003}
{"id": "David_Passim_2004", "series": "CAG", "text": "εἰ τὸ ὂν ὁμώνυμόν ἐστι, τὸ δὲ ὁμώνυμον ἀόριστον, ἀόριστον ἄρα τὸ ὄν·", "seq": 2004}
{"id": "David_Passim_2005", "series": "CAG", "text": "οὐ δεῖ δὲ τὴν ἀρχὴν ἀπὸ ἀορίστων ποιεῖσθαι.", "seq": 2005}
{"id": "David_Passim_2006", "series": "CAG", "text": "πρὸς δὲ τοῦτό φαμεν ὅτι οὐκ ἔστιν ὁμώνυμον τὸ ὄν, ὡς καὶ ἤδη ἐδείχθη ἐν τοῖς προτέροις, ἀλλ᾿ ἀφ᾿ ἑνός·", "seq": 2006}
{"id": "David_Passim_2007", "series": "CAG", "text": "τίνα δέ εἰσι τὰ ἀφ᾿ ἑνός, τελείως ἐν ταῖς Κατηγορίαις εἰσόμεθα.", "seq": 2007}
{"id": "David_Passim_2008", "series": "CAG", "text": "ἔτι δέ φασιν·", "seq": 2008}
{"id": "David_Passim_2009", "series": "CAG", "text": "διὰ τί οὐ προέταξε τὸ ἀναγκαῖον τοῦ ὄντος;", "seq": 2009}
{"id": "David_Passim_2010", "series": "CAG", "text": "καὶ λέγομεν πρὸς τοῦτο τρεῖς αἰτίας·", "seq": 2010}
{"id": "David_Passim_2011", "series": "CAG", "text": "πρῶτον μὲν ὅτι ὡς καθολικώτερον τὸ ὂν τοῦ ἀναγκαίου προέταξεν·", "seq": 2011}
{"id": "David_Passim_2012", "series": "CAG", "text": "εἴ τι μὲν γὰρ ἀναγκαῖον, τοῦτο καὶ ὄν ἐστιν, οὐκ εἴ τι δὲ ὄν, τοῦτο καὶ ἀναγκαῖον.", "seq": 2012}
{"id": "David_Passim_2013", "series": "CAG", "text": "εἰ προέταξεν οὖν τὸ ἀναγκαῖον, οὐκέτι τοῦ ὄντος ἐδέετο.", "seq": 2013}
{"id": "David_Passim_2014", "series": "CAG", "text": "δεύτερον δὲ διὰ τὸ εὐφραδές·", "seq": 2014}
{"id": "David_Passim_2015", "series": "CAG", "text": "εἰ γὰρ εἶπεν οὕτως ‘ἀναγκαίου ὄντος’, οὐχ οὕτως ἔμελλεν εὔφωνος εἶναι ἡ φράσις ἔχουσα τὸ κεχηνός.", "seq": 2015}
{"id": "David_Passim_2016", "series": "CAG", "text": "τρίτον ἵνα ἀπὸ τῶν γενικωτάτων ἄρξηται·", "seq": 2016}
{"id": "David_Passim_2017", "series": "CAG", "text": "οὕτως οὖν βουλόμενος ὁ Πορφύριος ἄρξασθαι τὸ ὂν προέταξε.", "seq": 2017}
{"id": "David_Passim_2018", "series": "CAG", "text": "Πάλιν ζητοῦσί τινες διὰ τί ἀναγκαίου εἶπε καὶ οὐχὶ δικαίου ἢ ἀγαθοῦ ἢ χρησίμου.", "seq": 2018}
{"id": "David_Passim_2019", "series": "CAG", "text": "πρὸς τοῦτο ἀπολογούμεθα ἀπὸ διττῆς τινος διαιρέσεως, πρώτης μὲν οὕτως·", "seq": 2019}
{"id": "David_Passim_2020", "series": "CAG", "text": "ἰστέον ὅτι δύο ταῦτα ἀλλήλοις παράκεινται, τὸ ἀγαθὸν καὶ τὸ χρήσιμον.", "seq": 2020}
{"id": "David_Passim_2021", "series": "CAG", "text": "τὸ δὲ χρήσιμον τέμνεται εἰς δύο, εἰς τὸ ὁμώνυμον τῷ γένει χρήσιμον καὶ εἰς τὸ ἀναγκαῖον.", "seq": 2021}
{"id": "David_Passim_2022", "series": "CAG", "text": "καὶ ἀγαθὸν μέν ἐστι τὸ δι᾿ ἑαυτὸ αἱρετόν, οἷον εὐδαιμονία εὐσέβεια.", "seq": 2022}
{"id": "David_Passim_2023", "series": "CAG", "text": "χρήσιμον δέ ἐστι τὸ ἀντιδιαστελλόμενον τῷ ἀναγκαίῳ, ὅπερ οὔτε παρὸν σώζει οὔτε ἀπὸν φθείρει, ὡς ἡ τοιάδε ἐσθής.", "seq": 2023}
{"id": "David_Passim_2024", "series": "CAG", "text": "ἀναγκαῖον δὲ ὃ παρὸν μὲν σώζει ἀπὸν δὲ φθείρει, ὡς ἡ ἀναπνοή.", "seq": 2024}
{"id": "David_Passim_2025", "series": "CAG", "text": "πάλιν τὸ ἀναγκαῖον ἑξαχῶς λέγεται·", "seq": 2025}
{"id": "David_Passim_2026", "series": "CAG", "text": "λέγεται γὰρ ἀναγκαῖον ἡ ὕλη, ὡς αἱ σανίδες τοῦ πλοίου πρὸς τὴν τούτου κατασκευήν.", "seq": 2026}
{"id": "David_Passim_2027", "series": "CAG", "text": "λέγεται ἀναγκαῖον ὡς τὸ λογικὸν τοῦ ἀνθρώπου.", "seq": 2027}
{"id": "David_Passim_2028", "series": "CAG", "text": "λέγεται ἀναγκαῖον καὶ τὸ βίᾳ, ὡς ὅταν εἴπωμεν ὅτι ἀναγκαίως ὁ τεμνόμενος τελευτᾷ.", "seq": 2028}
{"id": "David_Passim_2029", "series": "CAG", "text": "λέγεται ἀναγκαῖον καὶ τὸ ἕπεσθαι, ὡς ὅταν εἴπωμεν ὅτι ἀναγκαίως αἱ προτάσεις ἔχουσι τὸ συμπέρασμα·", "seq": 2029}
{"id": "David_Passim_2030", "series": "CAG", "text": "ἕπεται γὰρ ταῖς προτάσεσι τὸ συμπέρασμα.", "seq": 2030}
{"id": "David_Passim_2031", "series": "CAG", "text": "λέγεται δὲ ἀναγκαῖον καὶ τὸ δι᾿ ἑαυτὸ μὲν φευκτὸν δι᾿ ἕτερον δὲ αἱρετόν, ὡς τὸ φλεβότομον·", "seq": 2031}
{"id": "David_Passim_2032", "series": "CAG", "text": "δι᾿ ἑαυτὸ μὲν γὰρ φευκτόν ἐστιν, ἐπειδὴ ὀδύνην ποιεῖ, δι᾿ ἕτερον δὲ αἱρετόν, ἐπειδὴ κενοῖ τὴν ὕλην.", "seq": 2032}
{"id": "David_Passim_2033", "series": "CAG", "text": "λέγεται δὲ ἀναγκαῖον καὶ τὸ καὶ δι᾿ ἑαυτὸ αἱρετὸν καὶ δι᾿ ἕτερον, ὡς ἡ ὑγίεια καὶ δι᾿ ἑαυτὴν μέν ἐστιν αἱρετή (οὐδὲν γὰρ ἔχει ἀποβολῆς ἄξιον), καὶ δι᾿ ἕτερον δὲ αἱρετή ἐστι, διὰ τὰς ψυχικὰς ἐνεργείας·", "seq": 2033}
{"id": "David_Passim_2034", "series": "CAG", "text": "αἱ γὰρ ψυχικαὶ ἐνέργειαι διὰ τῆς ὑγιείας προέρχονται.", "seq": 2034}
{"id": "David_Passim_2035", "series": "CAG", "text": "αἱ δὲ πέντε φωναὶ καὶ δι᾿ ἑαυτάς εἰσιν ἀρεταί, ἐπειδὴ πάντως ὀφείλομεν γινώσκειν τί ἐστιν ἑκάστη αὐτῶν, ἀλλὰ καὶ δι᾿ ἕτερόν εἰσιν αἱρεταί·", "seq": 2035}
{"id": "David_Passim_2036", "series": "CAG", "text": "συμβάλλονται γὰρ ἡμῖν καὶ εἰς τὰς Κατηγορίας Ἀριστοτέλους καὶ εἰς πᾶσαν τὴν φιλοσοφίαν καὶ τὰ τοιαῦτα.", "seq": 2036}
{"id": "David_Passim_2037", "series": "CAG", "text": "Δεύτερον δὲ ἀπὸ τοιᾶσδε διαιρέσεως·", "seq": 2037}
{"id": "David_Passim_2038", "series": "CAG", "text": "τῶν ὄντων τὰ μέν ἐστι δι᾿ ἑαυτὰ αἱρετὰ τὰ δὲ δι᾿ ἕτερα, καὶ αἱρετὰ μὲν δι᾿ ἑαυτὰ ὡς ἡ εὐδαιμονία (ταύτην γὰρ αἱρούμεθα ἔχειν δι᾿ ἑαυτήν), αἱρετὰ δὲ δι᾿ ἕτερα ὡς ἡ ἐσθής·", "seq": 2038}
{"id": "David_Passim_2039", "series": "CAG", "text": "αὕτη γὰρ δι᾿ ἑαυτὴν οὐκ ἔστιν αἱρετή, ἀλλὰ διὰ τὸ θάλπειν τὸ ἡμέτερον σῶμα.", "seq": 2039}
{"id": "David_Passim_2040", "series": "CAG", "text": "τῶν δὲ δι᾿ ἕτερον αἱρετῶν διαφορά τίς ἐστι·", "seq": 2040}
{"id": "David_Passim_2041", "series": "CAG", "text": "τούτων γὰρ τὰ μὲν ἀπαραίτητά ἐστι τὰ δὲ παραίτησιν ἐπιδεχόμενα, καὶ ἀπαραίτητα μὲν ὡς ἡ ἀναπνοή (πάντως γὰρ δεῖται ταύτης πᾶν ἔμψυχον ζῷον·", "seq": 2041}
{"id": "David_Passim_2042", "series": "CAG", "text": "χωρὶς γὰρ ταύτης τὸ ἔμψυχον θερμὸν οὐ γίνεται), παραίτησιν δ᾿ ἐπιδεχόμενα ὡς ἡ ἐσθής·", "seq": 2042}
{"id": "David_Passim_2043", "series": "CAG", "text": "δύναται γὰρ χωρὶς ταύτης εἶναι τὰ ἔμψυχα ζῷα.", "seq": 2043}
{"id": "David_Passim_2044", "series": "CAG", "text": "τούτων οὖν τὰ ἀπαραίτητα λέγεται ἀναγκαῖα, τὰ δὲ παραίτησιν ἐπιδεχόμενα χρήσιμα, τὰ δὲ δι᾿ ἑαυτὰ αἱρετὰ ἀγαθά.", "seq": 2044}
{"id": "David_Passim_2045", "series": "CAG", "text": "καλῶς οὖν ἀναγκαίου εἶπε καὶ οὐ χρησίμου οὔτε ἀγαθοῦ·", "seq": 2045}
{"id": "David_Passim_2046", "series": "CAG", "text": "τὸ γὰρ ἀναγκαῖον δηλοῖ τὸ ἀπαραίτητον·", "seq": 2046}
{"id": "David_Passim_2047", "series": "CAG", "text": "ἀπαραίτητον γὰρ ὑπάρχει ἡμῖν πάντως τὰς πέντε φωνὰς γνῶναι.", "seq": 2047}
{"id": "David_Passim_2048", "series": "CAG", "text": "χρήσιμον δ᾿ οὐκ ἠδύνατο εἰπεῖν, ἐπειδὴ παραίτησιν ἐπιδέχεται τὸ χρήσιμον, τοῦτο δὲ ἀπαραίτητόν ἐστιν.", "seq": 2048}
{"id": "David_Passim_2049", "series": "CAG", "text": "ἀγαθὸν δὲ ὁμοίως οὐκ ἠδύνατο εἰπεῖν, ἐπειδὴ τὸ ἀγαθὸν δι᾿ ἑαυτὸ αἱρετόν ἐστι, τοῦτο δὲ τὸ παρὸν σύγγραμμα οὐ δι᾿ ἑαυτὸ μόνον αἱρετόν ἐστιν, ἀλλὰ καὶ διὰ πᾶσαν τὴν φιλοσοφίαν.", "seq": 2049}
{"id": "David_Passim_2050", "series": "CAG", "text": "1.", "seq": 2050}
{"id": "David_Passim_2051", "series": "CAG", "text": "3 Χρυσαόριε.", "seq": 2051}
{"id": "David_Passim_2052", "series": "CAG", "text": "Ἴσμεν αὐτοῦ φίλον εἶναι τὸν Χρυσαόριον, πρὸς ὃν ἐξεφώνησε τὸ παρὸν σύγγραμμα.", "seq": 2052}
{"id": "David_Passim_2053", "series": "CAG", "text": "1.", "seq": 2053}
{"id": "David_Passim_2054", "series": "CAG", "text": "3 Καὶ εἰς τὴν τῶν παρὰ Ἀριστοτέλει Κατηγοριῶν διδασκαλίαν.", "seq": 2054}
{"id": "David_Passim_2055", "series": "CAG", "text": "Ὧδε τὸ πλεῖστον μέρος τοῦ χρησίμου ἐμφαίνει·", "seq": 2055}
{"id": "David_Passim_2056", "series": "CAG", "text": "καὶ γὰρ καὶ εἰς τὰς Κατηγορίας φησὶ συμβάλλεσθαι καὶ εἰς πᾶσαν τὴν φιλοσοφίαν·", "seq": 2056}
{"id": "David_Passim_2057", "series": "CAG", "text": "τοῦτο γὰρ δηλοῖ ὁ καί σύνδεσμος.", "seq": 2057}
{"id": "David_Passim_2058", "series": "CAG", "text": "σαφὲς δέ ἐστι καθὸ εἰς τὰς Κατηγορίας φησίν, ἀσαφὲς δὲ καθὸ ὁ καί σύνδεσμος ἔξωθεν δηλοῖ πᾶσαν τὴν φιλοσοφίαν.", "seq": 2058}
{"id": "David_Passim_2059", "series": "CAG", "text": "ζητοῦσι δέ τινες διὰ τί εἰρηκὼς τῶν Κατηγοριῶν λέγει τῶν παρὰ Ἀριστοτέλει·", "seq": 2059}
{"id": "David_Passim_2060", "series": "CAG", "text": "ἤρκει γὰρ τῶν Κατηγοριῶν εἰπεῖν.", "seq": 2060}
{"id": "David_Passim_2061", "series": "CAG", "text": "καί τινές φασιν ὅτι πρὸς ἀντιδιαστολὴν ἄλλων εἶπε παρὰ Ἀριστοτέλει·", "seq": 2061}
{"id": "David_Passim_2062", "series": "CAG", "text": "βούλεται γὰρ δεῖξαι ὅτι συμβάλλεται εἰς τὰς Κατηγορίας Ἀριστοτέλους καὶ οὐκ ἄλλων·", "seq": 2062}
{"id": "David_Passim_2063", "series": "CAG", "text": "ἔγραψε γὰρ καὶ Θεόφραστος καὶ Εὔδημος περὶ κατηγοριῶν κατὰ μίμησιν τοῦ οἰκείου διδασκάλου.", "seq": 2063}
{"id": "David_Passim_2064", "series": "CAG", "text": "κακῶς δὲ οὗτοι ἐπελύσαντο·", "seq": 2064}
{"id": "David_Passim_2065", "series": "CAG", "text": "εἰ γὰρ ἅπαξ συμβάλλεται ταῖς Κατηγορίαις Ἀριστοτέλους, καὶ πάσαις ταῖς Κατηγορίαις συμβάλλεται.", "seq": 2065}
{"id": "David_Passim_2066", "series": "CAG", "text": "τοῦτο δὲ ἔδει εἰπεῖν ὅτι ἐκ τοῦ μείζονος θέλει δεῖξαι ὅτι πάσαις ταῖς Κατηγορίαις συμβάλλεται, εἰ καὶ ταῖς Ἀριστοτέλους.", "seq": 2066}
{"id": "David_Passim_2067", "series": "CAG", "text": "ζητοῦσι δὲ διὰ τί τὸ πλεῖστον μέρος τοῦ χρησίμου προέταξε τοῦ σκοποῦ.", "seq": 2067}
{"id": "David_Passim_2068", "series": "CAG", "text": "φαμὲν δὲ ὅτι τοῦτο ἐποίησε Πλάτωνι παρακολουθῶν παρακελευομένῳ προτάττειν τὸ χρήσιμον, ἵν᾿, ὡς εἴπομεν ἀνωτέρω, διὰ τοῦ χρησίμου θαῦμα ἡμῖν ἐπέλθῃ, ἐκ δὲ τοῦ θαύματος ζήτησις, ἐκ δὲ τῆς ζητήσεως τὸ φιλοσοφεῖν.", "seq": 2068}
{"id": "David_Passim_2069", "series": "CAG", "text": "1.", "seq": 2069}
{"id": "David_Passim_2070", "series": "CAG", "text": "4 Τοῦ γνῶναι τί γένος τί διαφορὰ τί εἶδος τί ἴδιον καὶ τί συμβεβηκός.", "seq": 2070}
{"id": "David_Passim_2071", "series": "CAG", "text": "Τούτων τὴν τάξιν ἀνωτέρω εἴπομεν.", "seq": 2071}
{"id": "David_Passim_2072", "series": "CAG", "text": "1.", "seq": 2072}
{"id": "David_Passim_2073", "series": "CAG", "text": "5 Εἴς τε τὴν τῶν ὁρισμῶν ἀπόδοσιν καὶ ὅλως εἰς τὰ περὶ διαιρέσεως καὶ ἀποδείξεως χρησίμης οὔσης τῆς τούτων θεωρίας.", "seq": 2073}
{"id": "David_Passim_2074", "series": "CAG", "text": "Μάθωμεν οὖν τί ἐστι διαίρεσις καὶ ὁρισμὸς καὶ ἀπόδειξις καὶ ἀνάλυσις καὶ οὕτως ἐπὶ τὴν ἐξήγησιν χωρῶμεν.", "seq": 2074}
{"id": "David_Passim_2075", "series": "CAG", "text": "διαίρεσίς ἐστιν ἡ ἀπὸ γένους ἐπὶ εἶδος χωροῦσα, οἷον οὐσία εἰς σῶμα καὶ ἀσώματον καὶ τὰ ἑξῆς, ὁρισμός ἐστιν ὁ ἐκ γένους καὶ συστατικῶν διαφορῶν συνιστάμενος, ἀπόδειξίς ἐστιν ἡ διὰ συλλογισμῶν καὶ προτάσεων γινομένη, † τὸ ὂν ποτὲ μὲν ἀγαθὸν δεικνῦσα ποτὲ δὲ κακόν.", "seq": 2075}
{"id": "David_Passim_2076", "series": "CAG", "text": "κακὸν μὲν οὖν οὕτως·", "seq": 2076}
{"id": "David_Passim_2077", "series": "CAG", "text": "ἡ ἡδονὴ σύνεστι τῇ οἰκείᾳ λύπῃ, τὸ δὲ λυποῦν κακόν, ἡ ἡδονὴ ἄρα κακόν.", "seq": 2077}
{"id": "David_Passim_2078", "series": "CAG", "text": "πῶς δὲ σύνεστιν ἡ ἡδονὴ τῇ λύπῃ;", "seq": 2078}
{"id": "David_Passim_2079", "series": "CAG", "text": "ἐπειδὴ εἰ μὴ πρότερον διψήσεις, οὐχ ἡδὺ ποτοῦ μεταλαβεῖν, εἰ μὴ πρότερον πεινήσεις, οὐχ ἡδὺ βρώσεως μεταλαβεῖν.", "seq": 2079}
{"id": "David_Passim_2080", "series": "CAG", "text": "τὸ δὲ θαυμαστόν, ὅτι ἐναντίως ἔχοντα τὰ τοιαῦτα ἀλλήλοις συναυξάνονται καὶ συμμειοῦνται·", "seq": 2080}
{"id": "David_Passim_2081", "series": "CAG", "text": "ὅσον γὰρ διψῇς, τοσοῦτον ποτοῦ μεταλαμβάνειν ἡδύ.", "seq": 2081}
{"id": "David_Passim_2082", "series": "CAG", "text": "ἀγαθὸν δὲ δεικνύει τὴν ἡδονὴν οὕτως·", "seq": 2082}
{"id": "David_Passim_2083", "series": "CAG", "text": "ἡ ἡδονὴ ἐφετόν, τὸ ἐφετὸν ἀγαθόν, ἡ ἡδονὴ ἄρα ἀγαθόν.", "seq": 2083}
{"id": "David_Passim_2084", "series": "CAG", "text": "εἰ δὲ εἴποι τις ‘τί οὖν;", "seq": 2084}
{"id": "David_Passim_2085", "series": "CAG", "text": "τὸ ἥδεσθαι μοιχεύειν ἢ κλέπτειν ἀγαθόν ἐστι;’", "seq": 2085}
{"id": "David_Passim_2086", "series": "CAG", "text": "φαμὲν ὅτι ἐκείνῳ τῷ ταῦτα μελετῶντι ἀγαθὸν φαίνεται τῇ ἀλόγῳ δόξῃ ἑπομένῳ.", "seq": 2086}
{"id": "David_Passim_2087", "series": "CAG", "text": "ἀναλυτικὴ δὲ ἡ ἀναλύουσα τὴν σύνθεσιν·", "seq": 2087}
{"id": "David_Passim_2088", "series": "CAG", "text": "οἷον τὸ ζῷον λογικὸν θνητὸν δηλοῖ τὸν ἄνθρωπον, ἀναλύει δὲ αὐτὸν εἰς λογικὸν ζῷον καὶ εἰς ἄλογον ζῷον καὶ εἰς τὰ τοιαῦτα.", "seq": 2088}
{"id": "David_Passim_2089", "series": "CAG", "text": "εἴπομεν δὲ ἀνωτέρω πῶς ἐξ ἐναντίας φέρεται πρὸς τὰς ἄλλας τρεῖς διαλεκτικὰς μεθόδους.", "seq": 2089}
{"id": "David_Passim_2090", "series": "CAG", "text": "χωρὶς δὲ ταύτης οὐδεμία συνίσταται τέχνη·", "seq": 2090}
{"id": "David_Passim_2091", "series": "CAG", "text": "θὲς γὰρ οἶκον εἶναι τελείως ἔχοντα τὰ οἰκεῖα, τοῦτον δὲ ἀναλύεις ἀπὸ τῆς στέγης κατιὼν ἐπὶ τοὺς θεμελίους·", "seq": 2091}
{"id": "David_Passim_2092", "series": "CAG", "text": "εἰ δὲ κατὰ σαυτὸν ἐνθυμηθῇς ὅτι δεῖ σε ὀροφῶσαι οἶκον, διὰ τὴν στέγην καὶ τοὺς τοίχους ἐπινοεῖς καὶ διὰ τοὺς τοίχους τοὺς θεμελίους.", "seq": 2092}
{"id": "David_Passim_2093", "series": "CAG", "text": "ὥστε οὖν αὕτη ἐστὶν ἡ συνιστῶσα τὴν τέχνην.", "seq": 2093}
{"id": "David_Passim_2094", "series": "CAG", "text": "Ἀποροῦσι δέ τινες λέγοντες διὰ τί τῆς διαιρέσεως προέταξε τὸν ὁρισμόν, καίτοι ἐδείχθη ὅτι θέλει ἡ διαίρεσις τοῦ ὁρισμοῦ προτερεύειν.", "seq": 2094}
{"id": "David_Passim_2095", "series": "CAG", "text": "καί τινες ὑπὲρ τούτου ἀπολογοῦνται ὅτι διὰ τοῦτο προέταξε τὸν ὁρισμόν, ὅτι δι᾿ αὐτοῦ πανταχοῦ ὁρίζει τὴν φύσιν τῶν προκειμένων φωνῶν καὶ πάνυ αὐτοῦ δέεται.", "seq": 2095}
{"id": "David_Passim_2096", "series": "CAG", "text": "τινὲς δὲ πρὸς τούτους ἀντιλέγοντές φασιν ὅτι οὐχ οὕτως·", "seq": 2096}
{"id": "David_Passim_2097", "series": "CAG", "text": "καὶ γὰρ ὁμοίως πανταχοῦ διαιρεῖ τὰς προηγουμένας φωνὰς καὶ δέεται τῆς διαιρέσεως.", "seq": 2097}
{"id": "David_Passim_2098", "series": "CAG", "text": "κακῶς δὲ οὗτοι ἐλάβοντο τῶν πρώτων·", "seq": 2098}
{"id": "David_Passim_2099", "series": "CAG", "text": "οὔτε γὰρ εἰρηκότες ὅτι πάνυ δεόμενος τοῦ ὁρισμοῦ αὐτὸν προέταξε, λέγουσιν ὅτι οὐ δέεται τῆς διαιρέσεως.", "seq": 2099}
{"id": "David_Passim_2100", "series": "CAG", "text": "διὰ δὲ τὸ μᾶλλον αὐτὸν προέταξεν·", "seq": 2100}
{"id": "David_Passim_2101", "series": "CAG", "text": "οὐδὲ γὰρ διὰ τῆς διαιρέσεως δηλοῖ ἡμῖν τὴν φύσιν ὡς ἐν τῷ ὁρισμῷ.", "seq": 2101}
{"id": "David_Passim_2102", "series": "CAG", "text": "Πάλιν ἀποροῦσί τινες λέγοντες διὰ τί τῆς ἀναλυτικῆς οὐκ ἐμνημόνευσε.", "seq": 2102}
{"id": "David_Passim_2103", "series": "CAG", "text": "καί φασί τινες ὅτι αὕτη ἡ ἀναλυτικὴ μέθοδος φυσική τίς ἐστιν, οἷον ἡ ἀναλύουσα τὰ φυσικὰ πράγματα, ὅτι ὁ ἄνθρωπος σύγκειται ἐκ τεσσάρων χυμῶν, οἱ χυμοὶ ἐκ τῶν τροφῶν, αἱ τροφαὶ ἐκ τῶν καρπῶν, οἱ καρποὶ ἐκ τῶν φυτῶν, τὰ φυτὰ ἐκ τῶν τεσσάρων στοιχείων, τὰ τέσσαρα στοιχεῖα ἐξ ὕλης καὶ εἴδους.", "seq": 2103}
{"id": "David_Passim_2104", "series": "CAG", "text": "λέγομεν πρὸς τοῦτο ὅτι τριττὴ ἡ παρὰ τοῖς φιλοσόφοις ἀνάλυσις·", "seq": 2104}
{"id": "David_Passim_2105", "series": "CAG", "text": "ἔστι γὰρ ἢ φυσικὴ ἢ λογική, καὶ αὕτη διττή.", "seq": 2105}
{"id": "David_Passim_2106", "series": "CAG", "text": "καὶ φυσικὴ μέν ἐστιν οἷον εἴπομεν τρόπον.", "seq": 2106}
{"id": "David_Passim_2107", "series": "CAG", "text": "λογικὴ δὲ ἢ ἐν προτάσεσιν ἢ ἐν συλλογισμοῖς.", "seq": 2107}
{"id": "David_Passim_2108", "series": "CAG", "text": "καὶ ἐν μὲν προτάσεσιν, ὅταν τὴν δοθεῖσαν πρότασιν ἀναλύῃ εἰς τοὺς ὅρους, οἷον ‘Σωκράτης φιλοσοφεῖ’.", "seq": 2108}
{"id": "David_Passim_2109", "series": "CAG", "text": "ταύτην τὴν πρότασιν ἀναλύει εἰς τὸ ‘Σωκράτης’ καὶ εἰς τὸ ‘φιλοσοφεῖ’ καὶ λέγει ὅτι τὸ μὲν ‘Σωκράτης’ ὄνομά ἐστι τὸ δὲ ‘φιλοσοφεῖ’ ῥῆμα.", "seq": 2109}
{"id": "David_Passim_2110", "series": "CAG", "text": "ἐν δὲ συλλογισμοῖς, ὡς ὅταν λάβωμεν τὸ ζητούμενον ὡς ὁμολογούμενον (ὅταν κατὰ σύνθεσιν ἀγορεύηται τὸ προκείμενον) καὶ καταντήσωμεν εἴς τι ὁμολογούμενον, οἷον εἰ ἀθάνατός ἐστιν ἡ ψυχή (τοῦτο τὸ ζητούμενον λαμβάνομεν ὡς ὁμολογούμενον, ἐπειδὴ ἀθάνατός ἐστιν ἡ ψυχή), εἰσὶν ἀμοιβαὶ τῶν φαύλων καὶ ἀγαθῶν πράξεων, εἰ δὲ εἰσὶν ἀμοιβαί, εἰσὶ τὰ ὑπὸ γῆν δικαιωτήρια, εἰ δὲ εἰσὶ τὰ ὑπὸ γῆν δικαιωτήρια, ἔστι τὸ δικαζόμενον, εἰ δὲ ἔστι τὸ δικαζόμενον, ἔστιν ἄρα καὶ ὁ δικάζων, εἰ δὲ ἔστι δικαστής, ἔστι καὶ προνοητὴς καὶ πρόνοια.", "seq": 2110}
{"id": "David_Passim_2111", "series": "CAG", "text": "καὶ ὅρα πῶς κατηντήσαμεν εἰς τὴν πρόνοιαν, ἥτις ὁμολογεῖται παρὰ πᾶσιν οὖσα.", "seq": 2111}
{"id": "David_Passim_2112", "series": "CAG", "text": "ὅθεν πάλιν κατὰ σύνθεσιν λέγω·", "seq": 2112}
{"id": "David_Passim_2113", "series": "CAG", "text": "ἐπειδὴ ἔστι πρόνοια καὶ δικαστής, δῆλον ὅτι εἰσὶ τὰ ὑπὸ γῆν δικαιωτήρια, εἰ δὲ εἰσὶ ταῦτα, δῆλον ὅτι καὶ ἀμοιβαὶ φαύλων καὶ ἀγαθῶν πράξεων, εἰ δὲ εἰσὶν ἀμοιβαί, ἔστι τὸ κρινόμενον, εἰ δὲ ἔστι τὸ κρινόμενον, ἀθάνατος ἄρα ἡ ψυχή.", "seq": 2113}
{"id": "David_Passim_2114", "series": "CAG", "text": "διὰ τί οὖν εἴασε καὶ ταύτας τὰς ἀναλυτικάς;", "seq": 2114}
{"id": "David_Passim_2115", "series": "CAG", "text": "καὶ λέγομεν ὅτι εἰρηκὼς τὴν διαίρεσιν καὶ τὸν ὁρισμὸν καὶ τὴν ἀπόδειξιν συμπεριέλαβε καὶ τὴν ἀνάλυσιν·", "seq": 2115}
{"id": "David_Passim_2116", "series": "CAG", "text": "πανταχοῦ γὰρ θεωρεῖται·", "seq": 2116}
{"id": "David_Passim_2117", "series": "CAG", "text": "ἐν μιᾷ γὰρ ἑκάστῃ νοεῖται·", "seq": 2117}
{"id": "David_Passim_2118", "series": "CAG", "text": "ὅπου γὰρ σύνθεσις, πάντως ἔστιν ἐκεῖ καὶ ἀνάλυσις·", "seq": 2118}
{"id": "David_Passim_2119", "series": "CAG", "text": "ἔστι δὲ ἐν πᾶσι σύνθεσις.", "seq": 2119}
{"id": "David_Passim_2120", "series": "CAG", "text": "ἄλλως τε δὲ εἰρηκὼς τὴν διαίρεσιν καὶ τὸν ὁρισμὸν καὶ τὴν ἀπόδειξιν πολλῷ μᾶλλον τὴν ἀνάλυσιν ἐδίδαξε·", "seq": 2120}
{"id": "David_Passim_2121", "series": "CAG", "text": "διὰ γὰρ τὴν ἀνάλυσιν καὶ αὗται λαμβάνονται·", "seq": 2121}
{"id": "David_Passim_2122", "series": "CAG", "text": "ἀμέλει ὡς αὐτῆς τιμιωτέρας οὔσης ἐξ αὐτῆς τὴν ἐπιγραφὴν ἐποίησεν ὁ Ἀριστοτέλης, καίτοι περὶ πασῶν διαλαβών, τὰ Ἀναλυτικά.", "seq": 2122}
{"id": "David_Passim_2123", "series": "CAG", "text": "ἔστι δὲ καὶ ἄλλως εἰπεῖν·", "seq": 2123}
{"id": "David_Passim_2124", "series": "CAG", "text": "αἱ προκείμεναι φωναὶ καθολικαί εἰσιν, ὡς εἴρηται·", "seq": 2124}
{"id": "David_Passim_2125", "series": "CAG", "text": "ἡ οὖν ἀνάλυσις οὐ μόνον τῶν καθόλου ἐστὶν ἀλλὰ καὶ τῶν καθ᾿ ἕκαστα·", "seq": 2125}
{"id": "David_Passim_2126", "series": "CAG", "text": "δύναμαι γὰρ ἀναλύειν τὸν Σωκράτην εἰς ψυχὴν καὶ σῶμα.", "seq": 2126}
{"id": "David_Passim_2127", "series": "CAG", "text": "ἐπειδὴ οὖν καὶ τῶν καθ᾿ ἕκαστά ἐστιν ἀνάλυσις, αἱ δὲ προκείμεναι φωναὶ τῶν καθόλου εἰσί, πολλάκις οὐκ ἠνέσχετο τὴν ἀναλυτικὴν ἀριθμῆσαι.", "seq": 2127}
{"id": "David_Passim_2128", "series": "CAG", "text": "Ἰστέον δὲ ὅτι ὧδε τὸ λεῖπον τοῦ χρησίμου εἰσφέρει.", "seq": 2128}
{"id": "David_Passim_2129", "series": "CAG", "text": "ἀποροῦσι δέ τινες λέγοντες διὰ τί λέγει χρησίμης οὔσης, καίτοι ἐδείχθη ὡς τὸ χρήσιμον παραίτησιν ἐπιδέχεται καὶ διὰ τοῦτο τὸ ἀναγκαῖον ἀντ᾿ αὐτοῦ ἔταξε.", "seq": 2129}
{"id": "David_Passim_2130", "series": "CAG", "text": "λέγομεν δὲ ὅτι δύναται ὧδε νοεῖσθαι τὸ χρήσιμον ἀναγκαῖον·", "seq": 2130}
{"id": "David_Passim_2131", "series": "CAG", "text": "φέρεται γὰρ τὸ χρήσιμον καὶ ἐπὶ τοῦ ἀναγκαίου·", "seq": 2131}
{"id": "David_Passim_2132", "series": "CAG", "text": "ὥσπερ γὰρ τὸ ὄνομα φέρεται καὶ ἐπὶ ῥήματος καὶ συνδέσμου (ταῦτα δὲ λέγομεν ὀνόματα καθὸ ὀνομάζονται, κυρίως δὲ αὐτὸ τὸ ὄνομα ὄνομα λέγεται), οὕτως καὶ τὸ χρήσιμον φέρεται καὶ ἐπὶ τοῦ ἀναγκαίου·", "seq": 2132}
{"id": "David_Passim_2133", "series": "CAG", "text": "χρήσιμον δὲ κυρίως λέγεται τὸ παραίτησιν ἐπιδεχόμενον.", "seq": 2133}
{"id": "David_Passim_2134", "series": "CAG", "text": "ἄλλως τε δέ φαμεν ὅτι δικαίως μὲν ἐκεῖ ἀναγκαῖον λέγει ὧδε δὲ χρήσιμον, ἐπειδὴ τῶν πέντε φωνῶν αἱ μέν εἰσιν οὐσιώδεις αἱ δὲ ἐπουσιώδεις.", "seq": 2134}
{"id": "David_Passim_2135", "series": "CAG", "text": "αἱ μὲν οὖν οὐσιώδεις ἀναγκαῖαί εἰσιν εἰς ὁρισμοὺς καὶ εἰς ἀποδείξεις, αἱ δὲ ἐπουσιώδεις χρήσιμοι, ἐπειδὴ αἱ ὑπογραφαὶ ἐκ τῶν ἐπουσιωδῶν προέρχονται.", "seq": 2135}
{"id": "David_Passim_2136", "series": "CAG", "text": "ἀφορῶν οὖν πρὸς τὰς οὐσιώδεις φωνὰς εἶπεν ἀναγκαίου, ἀφορῶν δὲ πρὸς τὰς ἐπουσιώδεις εἶπε χρησίμης.", "seq": 2136}
{"id": "David_Passim_2137", "series": "CAG", "text": "ἐν οἷς καὶ ἡ παροῦσα πρᾶξις.", "seq": 2137}
{"id": "David_Passim_2138", "series": "CAG", "text": "Πρᾶξις γ΄.", "seq": 2138}
{"id": "David_Passim_2139", "series": "CAG", "text": "1.", "seq": 2139}
{"id": "David_Passim_2140", "series": "CAG", "text": "7 Σύντομόν σοι παράδοσιν ποιούμενος.", "seq": 2140}
{"id": "David_Passim_2141", "series": "CAG", "text": "Ἐντεῦθεν τὸν τρόπον τῆς διδασκαλίας διδάσκει ὁ Πορφύριος·", "seq": 2141}
{"id": "David_Passim_2142", "series": "CAG", "text": "φησὶ γὰρ ὅτι δεινοῖς θεωρήμασιν οὐ βούλομαι ὁμιλεῖν·", "seq": 2142}
{"id": "David_Passim_2143", "series": "CAG", "text": "ἐκ τούτων γὰρ ἀσάφειά τις γίνεται.", "seq": 2143}
{"id": "David_Passim_2144", "series": "CAG", "text": "ἐπειδὴ δὲ ἐμνήσθημεν ἀσαφείας, φέρε διδάξωμεν πόθεν ἡ ἀσάφεια τίκτεται.", "seq": 2144}
{"id": "David_Passim_2145", "series": "CAG", "text": "γίνεται τοίνυν ἡ ἀσάφεια ἢ ἀπὸ τῆς λέξεως ἢ ἀπὸ τῶν θεωρημάτων.", "seq": 2145}
{"id": "David_Passim_2146", "series": "CAG", "text": "καὶ ἀπὸ μὲν θεωρημάτων, ὡς ἔχει τὰ Ἡρακλείτεια·", "seq": 2146}
{"id": "David_Passim_2147", "series": "CAG", "text": "ταῦτα γὰρ βαθέα καὶ δεινὰ ὑπάρχει·", "seq": 2147}
{"id": "David_Passim_2148", "series": "CAG", "text": "περὶ γὰρ τῶν συγγραμμάτων Ἡρακλείτου εἴρηται δεῖσθαι βαθέος κολυμβητοῦ.", "seq": 2148}
{"id": "David_Passim_2149", "series": "CAG", "text": "ἀπὸ δὲ λέξεως γίνεται διττῶς ἡ ἀσάφεια·", "seq": 2149}
{"id": "David_Passim_2150", "series": "CAG", "text": "ἢ γὰρ διὰ τὸ μῆκος τῆς φράσεως γίνεται ἀσάφεια, ὡς ἔχει τὰ Γαλήνεια (κἂν γὰρ εὐφραδῆ εἰσιν, ἀλλ᾿ οὖν διὰ τὸ μῆκος ἀσαφῆ εἰσιν), ἢ διὰ τὴν ποιότητα τῆς λέξεως, ὡς ἔχει τὰ Ἀριστογένεια·", "seq": 2150}
{"id": "David_Passim_2151", "series": "CAG", "text": "οὗτος γὰρ ‘καὶ ἡδὺν πόνον καὶ ἐνσεσαγμένον’ φησί, ποῖος δὲ πόνος ἡδὺς καὶ ἐνσεσαγμένος οὐκ οἴδαμεν.", "seq": 2151}
{"id": "David_Passim_2152", "series": "CAG", "text": "τί δαὶ ἀπὸ πολλῶν τοῦτο δεικνύειν ἐπιχειροῦμεν ἡμῶν εὐπορούντων τοῦτο αὐτὸ ἀπὸ τῶν ἀρχηγῶν καὶ προστατῶν τῆς φιλοσοφίας δεῖξαι, Πλάτωνός τε καὶ Ἀριστοτέλους;", "seq": 2152}
{"id": "David_Passim_2153", "series": "CAG", "text": "τούτων γὰρ ὁ μὲν εἷς τὴν ἀσάφειαν διὰ τῶν φράσεων ποιεῖν ἐπετήδευσεν, ὁ δὲ ἕτερος διὰ τῶν θεωρημάτων·", "seq": 2153}
{"id": "David_Passim_2154", "series": "CAG", "text": "τὰ μὲν γὰρ Ἀριστοτελικὰ θεωρήματα εὐχερῆ εἰσιν, ἡ δὲ φράσις δύσκολος.", "seq": 2154}
{"id": "David_Passim_2155", "series": "CAG", "text": "ἀμέλει εἰ νοήσεις τί ἐστιν ἐντελέχεια καὶ ποσὸν καὶ δύναμις, ἡδέα καὶ εὐχερῆ φαίνεταί σοι τὰ λεγόμενα·", "seq": 2155}
{"id": "David_Passim_2156", "series": "CAG", "text": "ὥστε οὖν ἡ φράσις ἐστὶ δυσχερής.", "seq": 2156}
{"id": "David_Passim_2157", "series": "CAG", "text": "τὰ δὲ Πλατωνικὰ θεωρήματα πάνυ τι δύσκολά εἰσι καὶ δυσχερῆ καὶ ἁπλῶς εἰπεῖν πάσῃ δόξῃ σχεδὸν ἑπόμενα (ὅτι δέ ἐστι τοῦτο ἀληθές, σαφὲς ἐκ τοῦ δύνασθαι ἑκάστην ἐξήγησιν ἁρμόζειν αὐτὰ πρὸς ἃ βούλεται), ἡ δὲ φράσις εὐχερὴς καὶ ὁμαλὴ καὶ ἁπλῶς εἰπεῖν Πλατωνική.", "seq": 2157}
{"id": "David_Passim_2158", "series": "CAG", "text": "Ἐπειδὴ δὲ οὐχ οἱ τυχόντες ἄνδρες ἀσάφειαν ποιεῖν ἐν τοῖς ἰδίοις συγγράμμασιν ἐπετήδευον, φέρε μάθωμεν τίνος χάριν τῆς ἀσαφείας αὐτοῖς μελέτη γέγονεν·", "seq": 2158}
{"id": "David_Passim_2159", "series": "CAG", "text": "οὔτε γὰρ ὁ θεὸς οὔτε ἡ φύσις οὔτε ἔμφρων ἀνὴρ μάτην τι ἐργάζεται.", "seq": 2159}
{"id": "David_Passim_2160", "series": "CAG", "text": "εἰ οὖν καὶ ἔμφρονες ἄνδρες τοῦτο ἐπετήδευον ἐργάζεσθαι, σαφὲς ὅτι πάντως διὰ τὶ τοῦτο ἐπετήδευον·", "seq": 2160}
{"id": "David_Passim_2161", "series": "CAG", "text": "οὕτω γὰρ καὶ ὁ Ὅμηρος διὰ μύθων τὴν ἰδίαν φιλοσοφίαν ἐδίδαξε·", "seq": 2161}
{"id": "David_Passim_2162", "series": "CAG", "text": "τούτου δὲ πρὸς τὴν φράσιν προσέχων τις οὐ δύναται τὰ βάθη τῆς διανοίας καταλαβεῖν·", "seq": 2162}
{"id": "David_Passim_2163", "series": "CAG", "text": "ἄλλα γὰρ τὰ φρασθέντα καὶ ἄλλα τὰ μεθερμηνευόμενα κατὰ ἀλληγορίαν.", "seq": 2163}
{"id": "David_Passim_2164", "series": "CAG", "text": "περὶ τούτου δὲ Ἀπολλώνιος ὁ Τυανεὺς ἔφη ‘ὁ πάντα εἰπὼν καὶ πάντα σιγήσας’.", "seq": 2164}
{"id": "David_Passim_2165", "series": "CAG", "text": "διὰ τοῦτο γινώσκων ὁ Πλάτων τὸ βάθος τῶν θεωρημάτων ποικίλον παρεκελεύετο μὴ ἀναγινώσκειν τοὺς νέους τὸν Ὅμηρον, ἵνα μὴ τῇ φράσει προσέχοντες οἰηθῶσι εἶναι τὸν νοῦν κατὰ τὴν φράσιν καὶ οὕτως ἐπιμείνωσιν ἔχοντες·", "seq": 2165}
{"id": "David_Passim_2166", "series": "CAG", "text": "ἀγαπᾷ γὰρ τῶν νέων ἡ ἀκοὴ σώζειν τῶν οἰκείων διδασκάλων τὴν φωνήν·", "seq": 2166}
{"id": "David_Passim_2167", "series": "CAG", "text": "νομίζει γὰρ ἀληθῆ λέγειν αὐτὸν ἄνδρα θεὸν τρῶσαι, καὶ πολλάκις τοῦτο οὕτως ἔχειν οἰόμενος ταῦτα διαπράξασθαι βουληθείη.", "seq": 2167}
{"id": "David_Passim_2168", "series": "CAG", "text": "τελείοις οὖν περὶ τὴν ἀκρίβειαν τῶν θεωρημάτων καταγινομένοις ἡ Ὁμηρικὴ ποίησις πεποίηται.", "seq": 2168}
{"id": "David_Passim_2169", "series": "CAG", "text": "πεποίηται τοίνυν ἡ ἀσάφεια τῶν θεωρημάτων καὶ τῆς λέξεως, ἵνα τοὺς νόθους διακρίνῃ ἐκ τῶν γνησίων·", "seq": 2169}
{"id": "David_Passim_2170", "series": "CAG", "text": "ἄτοπον γάρ, εἰ τὰ ἄλογα ζῷα τὰ γνήσια γεννήματα διακρίνειν σπεύδει ἐκ τῶν νόθων, ὁ δὲ ἄνθρωπος οὐ ταὐτόν τι χαίρων ποιήσει ἔχων τὸν λόγον, ᾧ ῥυθμίζεται ἀνθρώπου φύσις·", "seq": 2170}
{"id": "David_Passim_2171", "series": "CAG", "text": "ὁ γοῦν ἀετὸς τὰ ἴδια τέκνα μαθεῖν σπεύδων εἰ γνήσιά εἰσιν ἀνταυγάζειν πρὸς τὴν ἀκτῖνα τοῦ ἡλίου ποιεῖ, καὶ εἰ μὲν γνήσια ᾖ, ἀκινήτοις ὀφθαλμοῖς δέχεται τὰς βολὰς τῶν ἀκτίνων, εἰ δὲ νόθα, οὐκ ἐνατενίζειν πρὸς τὴν ἔκλαμψιν τῶν ἀκτίνων οἷά τέ ἐστι, τὸ νόθον ἐκ τούτου ἐμφαίνοντα.", "seq": 2171}
{"id": "David_Passim_2172", "series": "CAG", "text": "τούτου οὖν χάριν οἱ παλαιοὶ τοὺς γνησίους βουλόμενοι ἐκ τῶν νόθων διακρίνειν ἀσάφειάν τινα ἐποίουν, ἵνα εἰ μέν τις γνήσιος ᾖ, τὴν ἀσάφειαν τῶν θεωρημάτων ἤτοι τῆς λέξεως μὴ εὐλαβούμενος ἑαυτὸν ἀπαγγέλλῃ γνήσιον εἶναι καὶ δι᾿ ἔρωτα τῶν λόγων κόπον καὶ πόνον φέρῃ (ὁ γὰρ γνήσιος ὅσον ὁρᾷ αὐξανομένην ἀσάφειαν, τοσοῦτον σπουδαίως καθοπλίζεται, ἵνα τὸ ξένον καὶ δυσχερὲς κατορθωσάμενος μέγιστος ἐν λόγοις ὀφθείη), εἰ δὲ νόθος εἴη, εὐθέως τὴν ἀσάφειαν ὁρῶν τὴν ἀπαλλαγὴν εὐκταίαν ἡγήσηται, ἔρωτα πρὸς τοὺς λόγους οὐδένα ἔχων, οὗ τὴν ἀπουσίαν καὶ παρουσίαν ὁ † βίος τὴν αὐτὴν ἡγήσεται.", "seq": 2172}
{"id": "David_Passim_2173", "series": "CAG", "text": "Ἀλλὰ μὴν καὶ τῶν τοιούτων ἥψατο Πυθαγόρας·", "seq": 2173}
{"id": "David_Passim_2174", "series": "CAG", "text": "οὗτος γὰρ μαθεῖν βουλόμενος τοὺς γνησίως καὶ νόθως ἔχοντας πρὸς τὸν ἑαυτῶν διδάσκαλον τοὺς νέους ἀεὶ ἠρώτα ποῖα ἂν ἴδοιεν ἐνύπνια, γινώσκων ἀπὸ τῶν μεθ᾿ ἡμέραν ἐνθυμήσεων καὶ κινήσεων γίνεσθαι τὰς νυκτερινὰς φαντασίας·", "seq": 2174}
{"id": "David_Passim_2175", "series": "CAG", "text": "εἴ τι γὰρ προῄρηται ἡ ψυχή, τοῦτο καὶ ἠρεμοῦντος τοῦ σώματος φαντάζεται.", "seq": 2175}
{"id": "David_Passim_2176", "series": "CAG", "text": "ἔλεγεν οὖν ὅτι εἰ γνησίως τις ἔχει πρὸς τὰ ἀναγνώσματα, δηλοῖ ἡ νυκτερινὴ φαντασία ἄγγελος οὖσα τῶν μεθ᾿ ἡμέραν βουλευμάτων.", "seq": 2176}
{"id": "David_Passim_2177", "series": "CAG", "text": "Πλάτων δὲ τὸ τοιοῦτον γνῶναι βουλόμενος οὐ μόνον δι᾿ ἀσαφείας τῶν θεωρημάτων ἀλλὰ καὶ διὰ συμποσίων τὴν πεῖραν ἐποιεῖτο, γινώσκων τότε τὸν ἐρωτώμενον τὸ ἀληθὲς ἐκφαίνειν, ὅταν ὁ οἶνος ἁπαλύνῃ τὴν καρδίαν καὶ πρὸς τὸ ψεῦδος κινεῖσθαι νωχαλὴν ἀπεργάσηται.", "seq": 2177}
{"id": "David_Passim_2178", "series": "CAG", "text": "ποῖον δὲ τούτων ἀκριβῆ τὴν ἀλήθειαν θηρᾶν ὑπονοήσεις;", "seq": 2178}
{"id": "David_Passim_2179", "series": "CAG", "text": "Πλάτωνα προδήλως, ὅτι εἰ μὲν ἀνοίκειον καὶ ἀλλότριον τῆς φιλοσοφίας ὑπάρχει τὸ συμποσίοις ἐμβυθίζεσθαι τὴν ψυχήν, ἀλλὰ ὁ οἶνος τὴν ἀλήθειαν τίκτει, ὅταν τὴν καρδίαν καὶ τὴν διάνοιαν ἁπαλύνῃ·", "seq": 2179}
{"id": "David_Passim_2180", "series": "CAG", "text": "τὰ γοῦν ἐνύπνια οὐ πάντως ἐκ τῶν νέων οὕτως ἀπαγγέλλονται, ὡς καὶ ὤφθησαν·", "seq": 2180}
{"id": "David_Passim_2181", "series": "CAG", "text": "πολλάκις γὰρ διά τινα λήθην ἢ πλέον λέγουσιν ἢ ἔλαττον ἢ τὰ πολλὰ ψεύδονται ἢ ἀλλάσσουσιν.", "seq": 2181}
{"id": "David_Passim_2182", "series": "CAG", "text": "ἐφ᾿ οἷς ἡ παροῦσα θεωρία.", "seq": 2182}
{"id": "David_Passim_2183", "series": "CAG", "text": "1.", "seq": 2183}
{"id": "David_Passim_2184", "series": "CAG", "text": "7 Σύντομόν σοι παράδοσιν ποιούμενος.", "seq": 2184}
{"id": "David_Passim_2185", "series": "CAG", "text": "Ὁρᾷς πῶς τὴν σαφήνειαν πανταχοῦ θέλει φυλάξαι·", "seq": 2185}
{"id": "David_Passim_2186", "series": "CAG", "text": "ὧδε γὰρ λέγων σύντομον ἐδήλωσεν ὅτι οὐ ποιεῖ ἀσάφειαν διὰ μῆκος φράσεως.", "seq": 2186}
{"id": "David_Passim_2187", "series": "CAG", "text": "1.", "seq": 2187}
{"id": "David_Passim_2188", "series": "CAG", "text": "7 Πειράσομαι.", "seq": 2188}
{"id": "David_Passim_2189", "series": "CAG", "text": "Τὸ πειράσομαι αἰτιῶνται·", "seq": 2189}
{"id": "David_Passim_2190", "series": "CAG", "text": "τοῦτο γὰρ ἀλλότριον φιλοσόφου ὑπάρχει, τὸ ἐνδοιαστικῶς λέγειν τι.", "seq": 2190}
{"id": "David_Passim_2191", "series": "CAG", "text": "ἔχει δὲ ἀπολογίαν ὅτι μετριάζων τοῦτο λέγει, ὅπερ μᾶλλον πρέπει φιλοσόφῳ, ἢ ὅτι ὁ Χρυσαόριος μᾶλλον στρατηγίαις ἤπερ λόγοις σχολάζων οὐκ ἦν λογικὸς πάνυ, καὶ διὰ τοῦτο εἶπε πειράσομαι ἀντὶ τοῦ πεῖραν ποιήσομαι πρὸς τὴν σὴν φύσιν.", "seq": 2191}
{"id": "David_Passim_2192", "series": "CAG", "text": "1.", "seq": 2192}
{"id": "David_Passim_2193", "series": "CAG", "text": "7 Ἐν εἰσαγωγῆς τρόπῳ.", "seq": 2193}
{"id": "David_Passim_2194", "series": "CAG", "text": "Καὶ ὧδε τὴν ἀσάφειαν φεύγει·", "seq": 2194}
{"id": "David_Passim_2195", "series": "CAG", "text": "ἐν γὰρ τῷ λέγειν ἐν εἰσαγωγῆς τρόπῳ ἔδειξεν ὅτι τὴν ποιότητα τῆς λέξεως ἄγνωστον οὐ ποιεῖ ὥσπερ τὸ ἐνσεσαγμένον·", "seq": 2195}
{"id": "David_Passim_2196", "series": "CAG", "text": "αἱ γὰρ εἰσαγωγαὶ δυσχερεῖς λέξεις οὐ θέλουσιν ἔχειν.", "seq": 2196}
{"id": "David_Passim_2197", "series": "CAG", "text": "1.", "seq": 2197}
{"id": "David_Passim_2198", "series": "CAG", "text": "8 Τὰ παρὰ τοῖς πρεσβυτέροις ἐπελθεῖν.", "seq": 2198}
{"id": "David_Passim_2199", "series": "CAG", "text": "Τὰ παρακολουθήσαντα τοῖς φιλοσόφοις·", "seq": 2199}
{"id": "David_Passim_2200", "series": "CAG", "text": "ἐφυλάξατο γὰρ τὸ μὴ οἰκειοποιεῖσθαι τὰ ἀλλότρια.", "seq": 2200}
{"id": "David_Passim_2201", "series": "CAG", "text": "λέγει οὖν ὅτι οὐκ ἐμὰ λέγω, ἀλλ᾿ ἅπερ ὠφελήθην παρὰ τῶν πρεσβυτέρων, ταῦτα λέγω.", "seq": 2201}
{"id": "David_Passim_2202", "series": "CAG", "text": "1.", "seq": 2202}
{"id": "David_Passim_2203", "series": "CAG", "text": "8 Τῶν μὲν βαθυτέρων ἀπεχόμενος ζητημάτων.", "seq": 2203}
{"id": "David_Passim_2204", "series": "CAG", "text": "Ὁμοίως καὶ ὧδε τὴν ἀσάφειαν φεύγει·", "seq": 2204}
{"id": "David_Passim_2205", "series": "CAG", "text": "φησὶ γὰρ ὅτι τῶν δεινῶν καὶ ὑψηλῶν ζητημάτων ἀπέχομαι.", "seq": 2205}
{"id": "David_Passim_2206", "series": "CAG", "text": "1.", "seq": 2206}
{"id": "David_Passim_2207", "series": "CAG", "text": "9 Τῶν δὲ ἁπλουστέρων συμμέτρως στοχαζόμενος.", "seq": 2207}
{"id": "David_Passim_2208", "series": "CAG", "text": "Τὸ στοχαζόμενος πάλιν αἰτιῶνται·", "seq": 2208}
{"id": "David_Passim_2209", "series": "CAG", "text": "οὐ δεῖ γὰρ ἐπ᾿ ἀμφιβόλῳ λέγειν τὸν φιλόσοφον.", "seq": 2209}
{"id": "David_Passim_2210", "series": "CAG", "text": "τοῦτο δὲ ἔχει ἀπολογίαν ὁμοίαν τῷ πρώτῳ, ἐπειδὴ μετριάζειν βούλεται.", "seq": 2210}
{"id": "David_Passim_2211", "series": "CAG", "text": "Πραξις δ΄.", "seq": 2211}
{"id": "David_Passim_2212", "series": "CAG", "text": "1.", "seq": 2212}
{"id": "David_Passim_2213", "series": "CAG", "text": "9 Αὐτίκα.", "seq": 2213}
{"id": "David_Passim_2214", "series": "CAG", "text": "Κατὰ τὸ οἰκεῖον ἐπάγγελμα βαδίζων ὁ Πορφύριος πανταχοῦ τὴν σαφήνειαν αὐτάδελφον θυγατέρα τοῦ οἰκείου συγγράμματος παρίστησι·", "seq": 2214}
{"id": "David_Passim_2215", "series": "CAG", "text": "φησὶ γὰρ ὅτι ἀσαφῶς τι οὐ βούλομαι λέγειν διὰ τὴν πρὸς τὴν νεολαίαν φειδώ τε καὶ συμπάθειαν.", "seq": 2215}
{"id": "David_Passim_2216", "series": "CAG", "text": "ἵνα δὲ μηδεὶς εἴπῃ ‘πῶς γὰρ ἠδύνατο ποιῆσαί τι σαφὲς ἀσαφές;", "seq": 2216}
{"id": "David_Passim_2217", "series": "CAG", "text": "ἔστι γάρ τινα ὁμολογούμενα ἅτινα ἀσάφειαν παντελῶς οὐκ ἔχει, ὡς τὸ δὶς δύο τέσσαρα καὶ ὁ θεὸς ἀγαθός ἐστι’, λέγει ὅτι ἠδυνάμην βαθέως αὐτὰ ζητῆσαι καὶ δεινῶς εἰ ἐν ἐπινοίᾳ ἐστὶν ἢ ὑφέστηκε.", "seq": 2217}
{"id": "David_Passim_2218", "series": "CAG", "text": "τί δέ ἐστιν ‘ἐν ἐπινοίᾳ ἐστὶν ἢ ὑφέστηκεν’;", "seq": 2218}
{"id": "David_Passim_2219", "series": "CAG", "text": "ἐν ἐπινοίᾳ ἐστὶν οὗπερ γένεσις μὲν ἡ ἡμετέρα ἐπίνοια, φθορὰ δὲ ἡ ἡμετέρα λήθη·", "seq": 2219}
{"id": "David_Passim_2220", "series": "CAG", "text": "οἷον ἐννοοῦμεν εἶναι τραγέλαφον ὃν ἡ φύσις οὐκ ἐδημιούργησεν, ἀλλ᾿ ἡ ἡμετέρα ἐπίνοια τὴν φύσιν τυραννήσασα καθ᾿ ἑαυτὴν ἐπενόησέ τι ἐκ τράγου καὶ ἐλάφου, ὅπερ ἡ φύσις ἠγνόησε.", "seq": 2220}
{"id": "David_Passim_2221", "series": "CAG", "text": "τοῦτο δὲ σώζει ὅσον περὶ αὐτοῦ ἐνθυμεῖται καὶ λογίζεται, ἀπόλλυσι δὲ αὐτὸ ὅταν ἐπιλάθηται.", "seq": 2221}
{"id": "David_Passim_2222", "series": "CAG", "text": "ὥστε γένεσις μὲν ἡ ἡμετέρα ἐπίνοια φθορὰ δὲ ἡ ἡμετέρα λήθη.", "seq": 2222}
{"id": "David_Passim_2223", "series": "CAG", "text": "ὑφίστασθαι δέ φαμεν ὅπερ ἡ φύσις δημιουργεῖ καὶ γινώσκει, ὅπερ ἡ ἡμετέρα διάνοια οὔτε σώζει περὶ αὐτοῦ λογιζομένη οὔτε φθείρει ἐπιλανθανομένη αὐτοῦ, οἷον ὁ ἄνθρωπος καὶ ὁ κύων τῆς φύσεως δημιουργήματά ἐστι·", "seq": 2223}
{"id": "David_Passim_2224", "series": "CAG", "text": "περὶ τούτων κἂν ἐνθυμηθῇ τις κἄν τε μή, ἡ οὐσία οὐ φθείρεται οὔτε σώζεται.", "seq": 2224}
{"id": "David_Passim_2225", "series": "CAG", "text": "καλῶς οὖν ἔλεγεν ὅτι οὐ βούλομαι ζητῆσαι εἰ ἔστι γένος ἢ διαφορά, ἵνα μὴ ποικίλη καὶ δεινὴ ὀφθῇ τούτων ἡ διδασκαλία.", "seq": 2225}
{"id": "David_Passim_2226", "series": "CAG", "text": "τινὲς δὲ λέγουσι·", "seq": 2226}
{"id": "David_Passim_2227", "series": "CAG", "text": "τί γάρ;", "seq": 2227}
{"id": "David_Passim_2228", "series": "CAG", "text": "ἀμφεβάλλετο ὅλως τοῦτο, εἰ ἔστι γένος ἢ διαφορά, ὅτι λέγει ὅτι ἠδυνάμην ποιῆσαι αὐτὴν ποικίλην, ζητῶν εἴ ἐστιν ἢ μὴ ἔστιν;", "seq": 2228}
{"id": "David_Passim_2229", "series": "CAG", "text": "καί φαμεν ὅτι καὶ ἀμφεβάλλετο παρὰ τοῖς παλαιοῖς, εἰ ἔστι γένος καὶ εἶδος·", "seq": 2229}
{"id": "David_Passim_2230", "series": "CAG", "text": "ἔλεγε γὰρ ὁ Ἀντισθένης μὴ εἶναι γένος μήτε εἶδος·", "seq": 2230}
{"id": "David_Passim_2231", "series": "CAG", "text": "φησὶ γὰρ ‘ἄνθρωπον ὁρῶ, ἀνθρωπότητα δὲ οὐχ ὁρῶ, ἵππον ὁρῶ, ἱππότητα δὲ οὐχ ὁρῶ, ὥστε οὖν οὐκ ἔστι τὸ καθόλου’.", "seq": 2231}
{"id": "David_Passim_2232", "series": "CAG", "text": "ληρῶδες δὲ τὸ τοιοῦτον·", "seq": 2232}
{"id": "David_Passim_2233", "series": "CAG", "text": "οὔτε γὰρ πάντα τὰ ὄντα ὑποπίπτει ταῖς αἰσθήσεσιν.", "seq": 2233}
{"id": "David_Passim_2234", "series": "CAG", "text": "τούτῳ δὲ τῷ λόγῳ τὰ πολλὰ τῶν ὄντων οὐκ ἔστι·", "seq": 2234}
{"id": "David_Passim_2235", "series": "CAG", "text": "τὰ γὰρ θεῖα αἰσθήσει οὐχ ὑποπίπτει, καὶ ὅμως ἔστιν·", "seq": 2235}
{"id": "David_Passim_2236", "series": "CAG", "text": "ἀλλὰ μὴν οὔτε λογικὴ οὔτε ἄλογος ψυχὴ οὔτε φυσικὴ ἔστι, καθὸ αἰσθήσει οὐχ ὑποπίπτει.", "seq": 2236}
{"id": "David_Passim_2237", "series": "CAG", "text": "ἄλλως τε δὲ αἰσθήσεσιν οὐ δεῖ καταπιστεύειν·", "seq": 2237}
{"id": "David_Passim_2238", "series": "CAG", "text": "ἰδοὺ γὰρ ὁ ἥλιος ποδιαῖος ἡμῖν φαίνεται τῶν πραγμάτων δεικνύντων αὐτὸν ἑκατονταεβδομηκονταπλασίονα τῆς γῆς ὑπάρχειν.", "seq": 2238}
{"id": "David_Passim_2239", "series": "CAG", "text": "καὶ τῶν πραγμάτων δεικνύντων ἡμῖν τὴν ἐν ὕδασι κώπην μὴ κεκλάσθαι, ἡ ὅρασις λέγει αὐτὴν μὴ εἶναι ὑγιῆ.", "seq": 2239}
{"id": "David_Passim_2240", "series": "CAG", "text": "πάλιν ἐν νηὶ καθημένων ἡμῶν καὶ τῶν παρ᾿ αἰγιαλὸν δοκούντων ἡμῖν κινεῖσθαι, τὰ πράγματα ψεῦδος εἶναι τὸ τοιοῦτον ἐπαγγέλλονται.", "seq": 2240}
{"id": "David_Passim_2241", "series": "CAG", "text": "δείξαντες οὖν ἀδίκως τὸν Ἀντισθένην τῶν καθόλου ἀναίρεσιν ποιησάμενον φέρε κατασκευάσωμεν πῶς ἔστι, πρῶτον δι᾿ ὁρισμοῦ αὐτὰ παραδόντες.", "seq": 2241}
{"id": "David_Passim_2242", "series": "CAG", "text": "καθόλου τοίνυν ἐστὶ τὸ ἓν τῷ ἀριθμῷ κατ᾿ εἶδος, ὑπὸ πολλῶν δὲ μετεχόμενον.", "seq": 2242}
{"id": "David_Passim_2243", "series": "CAG", "text": "ἓν τῷ ἀριθμῷ εἴπομεν, καθὸ ἕν τί ἐστιν.", "seq": 2243}
{"id": "David_Passim_2244", "series": "CAG", "text": "ἐπειδὴ δὲ καὶ ἡ ὕλη ἕν τί ἐστι, προσεθήκαμεν τὸ κατ᾿ εἶδος·", "seq": 2244}
{"id": "David_Passim_2245", "series": "CAG", "text": "κἂν γὰρ ἕν τι ὑπάρχῃ ἡ ὕλη, ἀλλ᾿ οὐ κατ᾿ εἶδος.", "seq": 2245}
{"id": "David_Passim_2246", "series": "CAG", "text": "ὅτι δὲ οὐ καθόλου ἐστὶν οὐδὲ μερικόν, ἐντελῶς εἰσόμεθα ἐν φυσικοῖς λόγοις γινόμενοι.", "seq": 2246}
{"id": "David_Passim_2247", "series": "CAG", "text": "ὑπὸ πολλῶν δὲ μετεχόμενον, ἐπειδὴ ἓν ὑπάρχον ἐν πολλοῖς θεωρεῖται.", "seq": 2247}
{"id": "David_Passim_2248", "series": "CAG", "text": "πῶς δὲ ἕν τι ὑπάρχον ἐν πολλοῖς θεωρεῖται, εἰσόμεθα·", "seq": 2248}
{"id": "David_Passim_2249", "series": "CAG", "text": "τὰ ἄτομα κοινωνεῖ πάντως ἢ κατὰ τὸ αὐτὸ ἢ κατὰ τὸ ὅμοιον·", "seq": 2249}
{"id": "David_Passim_2250", "series": "CAG", "text": "οἷον ὁ Σωκράτης καὶ ὁ Ἀλκιβιάδης καὶ ὁ Πλάτων πάντως κατά τι κοινωνοῦσι καὶ εἰ μὲν κατὰ τὸ αὐτὸ κοινωνοῦσιν, αὐτόθεν ἔχομεν τὸ ζητούμενον (τὸ αὐτὸ γὰρ ἕν ἐστιν, ὥστε τὸ εἶδος ἕν τί ἐστιν ὑπὸ πολλῶν δὲ μετεχόμενον), εἰ δὲ κατὰ τὸ ὅμοιον κοινωνοῦσιν, ἢ κατὰ ἕν τι κοινωνοῦσιν ἢ κατὰ πολλά.", "seq": 2250}
{"id": "David_Passim_2251", "series": "CAG", "text": "καὶ εἰ μὲν κατὰ ἕν τι, τὸ ζητούμενον ἔχομεν, εἰ δὲ κατὰ πολλά, ζητοῦμεν πάλιν καὶ τὰ πολλὰ κατὰ τί κοινωνοῦσι, κατὰ πολλὰ ἢ κατὰ ἕν τι.", "seq": 2251}
{"id": "David_Passim_2252", "series": "CAG", "text": "καὶ εἰ εἴπῃς κατὰ πολλά, πάλιν ἡ αὐτὴ ζήτησις μένει, ἕως οὗ εἰς ἕν τι λήξῃ τὰ πολλὰ κατὰ τὴν κοινωνίαν, ἢ ἐπ᾿ ἄπειρόν τι χωρεῖ ἡ ζήτησις·", "seq": 2252}
{"id": "David_Passim_2253", "series": "CAG", "text": "κατὰ γὰρ ἕν τι κοινωνεῖ τὰ πολλά.", "seq": 2253}
{"id": "David_Passim_2254", "series": "CAG", "text": "καλῶς οὖν ἔχει ὁ ὁρισμὸς ὁ λέγων τὸ καθόλου ἓν τῷ ἀριθμῷ κατ᾿ εἶδος ὑπὸ πολλῶν δὲ μετεχόμενον.", "seq": 2254}
{"id": "David_Passim_2255", "series": "CAG", "text": "Μηδεὶς δὲ ὑπονοησάτω τὸν φιλόσοφον τῷ κατὰ παράλειψιν σχήματι χρήσασθαι·", "seq": 2255}
{"id": "David_Passim_2256", "series": "CAG", "text": "τούτῳ γὰρ κέχρηνται οἱ ῥήτορες οἱ δεινοὶ ὄντες, τὸ τοιοῦτον δὲ σιωπῆς μὲν ἐπάγγελμα ἐμφαίνει, λόγου δὲ μηχάνημα·", "seq": 2256}
{"id": "David_Passim_2257", "series": "CAG", "text": "δοκῶν γάρ τις σιωπᾶν διὰ μεθόδου τὰ ὑπονοούμενα σιωπᾶσθαι λέγει οἷον ‘ἐῶ λέγειν ὅτι κλέπτης εἶ’, ‘οὐ θέλω δὲ εἰπεῖν ὅτι ἱερόσυλος εἶ’, καὶ τὰ τοιαῦτα.", "seq": 2257}
{"id": "David_Passim_2258", "series": "CAG", "text": "τοιούτῳ δὲ οὐκ ἐχρήσατο ὁ φιλόσοφος, ἐπεὶ εἰ ἔλεγεν ‘ἐῶ εἰπεῖν’, τινὲς ἔλεγον αὐτὰ μὴ εἶναι·", "seq": 2258}
{"id": "David_Passim_2259", "series": "CAG", "text": "ἐδόκει γὰρ ἂν αὐτὰ λέγειν σιωπὴν ἐπαγγειλάμενος, αὐτὸς δέ φησιν, κἂν εἰσὶν <ἐν> ἐπινοίᾳ κἂν ὑφέστηκε, περὶ τούτου διαλαμβάνειν οὐ βούλομαι.", "seq": 2259}
{"id": "David_Passim_2260", "series": "CAG", "text": "Πρᾶξις ε΄.", "seq": 2260}
{"id": "David_Passim_2261", "series": "CAG", "text": "Πηγὴν σαφοῦς διδασκαλίας τὸ σύγγραμμα ἔδειξας, ὦ Πορφύριε, σαφήνειαν ῥέουσαν πανταχοῦ τῆς νεολαίας φειδόμενος·", "seq": 2261}
{"id": "David_Passim_2262", "series": "CAG", "text": "λέγεις γὰρ δύνασθαί σε εἴτε ἐν ψιλαῖς ἐπινοίαις κεῖται τὰ προκείμενα εἴτε ὑφέστηκε ζητῆσαι·", "seq": 2262}
{"id": "David_Passim_2263", "series": "CAG", "text": "τῶν γὰρ εἶναι λεγομένων τὰ μὲν ἐν ψιλαῖς ἐπινοίαις κεῖται τὰ δὲ ἐν ἰδίαις ὑποστάσεσι συνέστηκε, καὶ τῶν ἐν ἰδίαις ὑποστάσεσι συνισταμένων τὰ μὲν σώματά εἰσι τὰ δὲ ἀσώματα, καὶ τῶν ἀσωμάτων τὰ μὲν καθ᾿ ἑαυτὰ ὑφίσταται ἔχοντα οἰκείαν ὑπόστασιν, ὡς θεὸς νοῦς ψυχή, τὰ δὲ ἐν ὕλῃ, καὶ τῶν ὑφισταμένων ἐν τῇ ὕλῃ τὰ μὲν χωριστά εἰσι τῆς ὕλης, ὡς παρὰ Πλάτωνι αἱ ἰδέαι, τὰ δὲ ἀχώριστα τῆς ὕλης, ὡς τὰ φυσικὰ εἴδη οἷον θερμότης ψυχρότης, τὰ δὲ πῇ μὲν χωριστὰ πῇ δὲ ἀχώριστα, ὡς τὰ σχήματα καὶ τὰ μαθηματικά.", "seq": 2263}
{"id": "David_Passim_2264", "series": "CAG", "text": "λέγεις οὖν δύνασθαί σε εἴτε ἐν ψιλαῖς ἐπινοίαις ἐστὶ τὰ προκείμενα εἴτε ὑφέστηκε ζητῆσαι.", "seq": 2264}
{"id": "David_Passim_2265", "series": "CAG", "text": "ἀλλὰ μὴν καὶ εἰ ὁμολογεῖται ὑφίστασθαι, λέγεις δύνασθαι πάνυ βαθέως καὶ ὑψηλῶς περὶ αὐτῶν ζητῆσαι, εἴτε ἀσώματά εἰσιν εἴτε τριχῇ διαστατά.", "seq": 2265}
{"id": "David_Passim_2266", "series": "CAG", "text": "ὅτι δὲ ἀναγκαία ἡ ζήτησις ὑπάρχει, σαφὲς ἐκ τοῦ λέγειν τινὰς πάντα τὰ ὄντα σώματα εἶναι, ὥσπερ οἱ Στωϊκοί, ἄνδρες γηγενεῖς καὶ σπαρτοὶ ἀπὸ δρυὸς καὶ πέτρης κατὰ τὴν ποίησιν·", "seq": 2266}
{"id": "David_Passim_2267", "series": "CAG", "text": "οὗτοι γὰρ οὐδὲ τῆς προσηγορίας τῆς φιλοσοφίας μετέχειν ἤμελλον, εἰ μὴ ὅτι διὰ μεγαλορρημοσύνης τῶν ὀνομάτων αὐτὴν ἐκόσμησαν·", "seq": 2267}
{"id": "David_Passim_2268", "series": "CAG", "text": "φασὶ γὰρ τὸν φιλόσοφον μόνον πλούσιον μόνον βασιλέα μόνον εὐτυχῆ.", "seq": 2268}
{"id": "David_Passim_2269", "series": "CAG", "text": "καὶ μόνον μὲν πλούσιον, καθὸ τοῖς ἑαυτοῦ ἀρκεῖται καὶ ἄλλου οὐ δέεται (τοῦτο γάρ ἐστι πλουσίου, εἰ καὶ τὰ μάλιστα καὶ τοῦτο ὁ παρὼν καιρὸς ἐνόθευσε κόρον τοῦ πορίζειν μὴ ἔχειν τοὺς πλουτοῦντας δεικνύων), μόνος δὲ βασιλεύς, καθὸ τῶν πολεμίων ἐπικρατεῖ, θυμοῦ τε καὶ ἐπιθυμίας (τοῦτο γὰρ βασιλέως ἐστὶ τεκμήριον), μόνος δὲ εὐτυχής, καθὸ τούτων ἐφίεται ἃ καὶ δύναται καὶ ταῦτα δύναται ὧν ἐφίεται·", "seq": 2269}
{"id": "David_Passim_2270", "series": "CAG", "text": "ἐφίεται γὰρ ἀρετὴν ἀεὶ προσπορίζειν.", "seq": 2270}
{"id": "David_Passim_2271", "series": "CAG", "text": "οὗτοι οὖν διχόθεν συγκεκροτημένοι τὴν μὲν γνῶσιν χαμαιπετῆ καὶ εὐτελῆ κέκτηνται λέγοντες πάντα τὰ ὄντα σώματα εἶναι, τὸ παρ᾿ αὐτοῖς δὲ θεῖον λεπτομερὲς σῶμα διὰ πάντων διῆκον (τοῦτο δὲ τὸ παρ᾿ αὐτοῖς ὅσιον), τὴν δὲ ζωὴν ὑπερέχουσαν.", "seq": 2271}
{"id": "David_Passim_2272", "series": "CAG", "text": "Ἐπειδὴ δὲ τοιαύτη ζήτησις καὶ ἀμφιβολία παρὰ τοῖς παλαιοῖς γέγονεν, <τῶν μὲν> Ἀριστοτελικῶν καὶ Πλατωνικῶν λεγόντων τῶν ὄντων τὰ μὲν εἶναι ἀσώματα τὰ δὲ τριχῇ διαστατά, τῶν δὲ Στωϊκῶν πάντα τὰ ὄντα σώματα εἶναι λεγόντων, δῆλον ὅτι καὶ τὰ γένη καὶ τὰ εἴδη, φέρε κατὰ τὴν συνήθη διδασκαλίαν δείξωμεν τὰς προκειμένας φωνὰς ἀσωμάτους κατὰ ἓξ τοιούτους λόγους.", "seq": 2272}
{"id": "David_Passim_2273", "series": "CAG", "text": "πρῶτον τὸ σῶμα οὐδέποτε ἐν μείζονι καὶ ἐλάττονι ὡσαύτως ἔχεται, οἷον ἐν τῷ ἐλέφαντι καὶ τῷ μύρμηκι οὐ τὸ αὐτὸ μέγεθος τῆς κεφαλῆς ὁρᾶται, ἐν τῷ Αἴαντι καὶ τῷ Τυδείδῃ οὐχ ὁ αὐτὸς βραχίων ὁρᾶται·", "seq": 2273}
{"id": "David_Passim_2274", "series": "CAG", "text": "εἰ οὖν τὸ γένος καὶ τὸ εἶδος ἐν μείζονι καὶ ἐλάττονι ὡσαύτως ἔχονται, σαφὲς ὅτι ἀσώματά εἰσίν·", "seq": 2274}
{"id": "David_Passim_2275", "series": "CAG", "text": "ἐν γὰρ τῷ ἐλέφαντι καὶ τῷ μύρμηκι τὸ αὐτὸ ζῶον ὑπάρχει·", "seq": 2275}
{"id": "David_Passim_2276", "series": "CAG", "text": "οὐ γάρ φαμεν τὸν ἐλέφαντα τοῦ μύρμηκος πλέον ζῆν, οὐδὲ τὸν Αἴαντα τοῦ Τυδέως πλέον τι ζῆν ἢ ἀνθρωπότητος πλέον ἔχειν.", "seq": 2276}
{"id": "David_Passim_2277", "series": "CAG", "text": "ἐντεῦθεν δὲ ἔχομεν προσπόρισμα, ὅτι καὶ αἱ σχέσεις·", "seq": 2277}
{"id": "David_Passim_2278", "series": "CAG", "text": "ἀσώματοί εἰσι.", "seq": 2278}
{"id": "David_Passim_2279", "series": "CAG", "text": "τί δέ ἐστι σχέσις;", "seq": 2279}
{"id": "David_Passim_2280", "series": "CAG", "text": "τὸ λέγειν ὅτι τὸ ἥμισυ τῶν δέκα πέντε, τὸ δὶς πέντε δέκα, καὶ τὸ ἥμισυ τῶν ἑξήκοντα τριάκοντα, τὸ δὶς τριάκοντα ἑξήκοντα.", "seq": 2280}
{"id": "David_Passim_2281", "series": "CAG", "text": "ταῦτα δὲ καὶ τῶν πρός τί εἰσι·", "seq": 2281}
{"id": "David_Passim_2282", "series": "CAG", "text": "λέγων γὰρ ἥμισυ σημαίνεις τὸ διπλάσιον (τὸ γὰρ ἥμισυ τοῦ διπλασίου ἐστὶν ἥμισυ), καὶ λέγων διπλάσιον δηλοῖς τὸ ἥμισυ·", "seq": 2282}
{"id": "David_Passim_2283", "series": "CAG", "text": "τὸ γὰρ διπλάσιον ἡμίσεός ἐστι διπλάσιον.", "seq": 2283}
{"id": "David_Passim_2284", "series": "CAG", "text": "διὰ τί δὲ ἀσώματοι αἱ σχέσεις;", "seq": 2284}
{"id": "David_Passim_2285", "series": "CAG", "text": "ἐπειδὴ καὶ ἐν μείζονι καὶ ἐν ἐλάττονι ὡσαύτως ἔχουσι·", "seq": 2285}
{"id": "David_Passim_2286", "series": "CAG", "text": "τὸ γὰρ ἥμισυ δύναται καὶ ἐπὶ μείζονος καὶ ἐπ᾿ ἐλάττονος τάττεσθαι, καὶ τὸ διπλάσιον ὡσαύτως·", "seq": 2286}
{"id": "David_Passim_2287", "series": "CAG", "text": "ἐπὶ γὰρ τῶν δέκα δύναται καὶ διπλάσιον καὶ ἥμισυ λέγεσθαι, ἀλλὰ καὶ ἐπὶ τῶν ἑξήκοντα ὡσαύτως.", "seq": 2287}
{"id": "David_Passim_2288", "series": "CAG", "text": "δεύτερον δὲ οὐδέποτε σῶμα ὅλον ὡς ὅλον πᾶσι μεταδίδοται (οἷον ἀπὸ χοίνικος εἰ λάβοις τι καὶ ἄλλο ὀλίγον τι, ἐν ἑκατέροις ὁ χοῖνιξ οὐ θεωρεῖται ὅλος ὡς ὅλος)·", "seq": 2288}
{"id": "David_Passim_2289", "series": "CAG", "text": "τὸ οὖν γένος καὶ τὸ εἶδος ἐν πᾶσιν ὅλα ὡς ὅλα θεωρεῖται·", "seq": 2289}
{"id": "David_Passim_2290", "series": "CAG", "text": "ἡ γὰρ ἀνθρωπότης ὅλη ὡς ὅλη ἐν ἐμοὶ θεωρεῖται καὶ τὸ ζῷον ὅλον ὡς ὅλον, ὁμοίως δὲ καὶ ἐν Σωκράτει καὶ Ἀλκιβιάδῃ καὶ Πλάτωνι·", "seq": 2290}
{"id": "David_Passim_2291", "series": "CAG", "text": "ἀσώματα ἄρα τὰ τοιαῦτα.", "seq": 2291}
{"id": "David_Passim_2292", "series": "CAG", "text": "ἔχομεν ἐντεῦθεν ὅτι καὶ ὁ προφορικὸς λόγος ἀσώματός ἐστιν·", "seq": 2292}
{"id": "David_Passim_2293", "series": "CAG", "text": "ἐν πᾶσι γὰρ ὅλος ὡς ὅλος νοεῖται, οἷον εἰ φωνήσῃ τις καὶ εἴπῃ ‘Σωκράτης’, πάντες ὡσαύτως ἀκούουσι τὸ ‘Σωκράτης’ καὶ ὅλον ὡς ὅλον ἔχουσιν·", "seq": 2293}
{"id": "David_Passim_2294", "series": "CAG", "text": "οὐ γὰρ σὺ τὸ ἥμισυ ἀκούεις καὶ ἄλλος τὸ ἥμισυ.", "seq": 2294}
{"id": "David_Passim_2295", "series": "CAG", "text": "τρίτον πᾶν σῶμα σώματι προστιθέμενον αὔξησιν ποιεῖται τοῦ δεχομένου τὴν προσθήκην (οἷον κυαθιαῖον μέτρον εἰ ἐκχύσῃς εἰς ἄλλο κυαθιαῖον, διπλάσιον γίνεται τὸ δεχόμενον)·", "seq": 2295}
{"id": "David_Passim_2296", "series": "CAG", "text": "εἰ οὖν προστιθέμενον τὸ γένος καὶ τὸ εἶδος τῷ Σωκράτει ὁμολογουμένως οὐδὲν προστίθησιν, ὁμολογουμένως ἀσώματά ἐστι.", "seq": 2296}
{"id": "David_Passim_2297", "series": "CAG", "text": "καὶ ἄλλως·", "seq": 2297}
{"id": "David_Passim_2298", "series": "CAG", "text": "πᾶν σῶμα ἢ κατ᾿ αὔξησιν ἢ κατ᾿ ἀλλοίωσιν ἢ κατὰ μείωσιν κινεῖται·", "seq": 2298}
{"id": "David_Passim_2299", "series": "CAG", "text": "τὰ δὲ γένη καὶ τὰ εἴδη οὐδὲ κατ᾿ αὔξησιν οὐδὲ κατ᾿ ἀλλοίωσιν οὐδὲ κατὰ μείωσιν κινεῖται·", "seq": 2299}
{"id": "David_Passim_2300", "series": "CAG", "text": "φανερὸν ὅτι ἀσώματά εἰσιν.", "seq": 2300}
{"id": "David_Passim_2301", "series": "CAG", "text": "ἐντεῦθεν ἔχομεν προσπόρισμα, ὅτι καὶ αἱ ποιότητες, τὸ λευκὸν καὶ τὸ μέλαν, τὸ ψυχρὸν καὶ τὸ θερμόν, ἀσώματοί εἰσιν·", "seq": 2301}
{"id": "David_Passim_2302", "series": "CAG", "text": "ἰδοὺ γὰρ προστιθέμεναι τῷ Σωκράτει καὶ τῷ Ἀλκιβιάδῃ οὐδεμίαν προσθήκην ποιοῦνται.", "seq": 2302}
{"id": "David_Passim_2303", "series": "CAG", "text": "τέταρτον οὐδέποτε ταὐτὸν σῶμα ἐν ταὐτῷ καιρῷ ἐν πᾶσι θεωρεῖται (κἂν γὰρ τὸ ὅμοιον, ἀλλ᾿ οὖν οὐ τὸ αὐτό·", "seq": 2303}
{"id": "David_Passim_2304", "series": "CAG", "text": "οὐ γὰρ τὸ ὅμοιον ταὐτόν ἐστιν, οἷον εἰ φανείη ὀστοῦν ἐλέφαντος ἐν τῇ σῇ ὠμοπλάτῃ, οὐ ταὐτόν ἐστι καὶ τῷ ὄντι ἐν τῇ ὠμοπλάτῃ Ὀρέστου)·", "seq": 2304}
{"id": "David_Passim_2305", "series": "CAG", "text": "εἰ οὖν τὸ γένος καὶ τὸ εἶδος ἐν τῷ αὐτῷ καιρῷ ἐν πολλοῖς θεωρεῖται, ὁμολογουμένως οὐκ ἔστι σώματα.", "seq": 2305}
{"id": "David_Passim_2306", "series": "CAG", "text": "ἔχομεν ἐντεῦθεν ὅτι καὶ ἡ ἀνείδεος ὕλη ἀσώματος ὑπάρχει ἐν τῷ αὐτῷ καιρῷ ἐν πᾶσιν ὑπάρχουσα ἢ πάντα ἔχουσα.", "seq": 2306}
{"id": "David_Passim_2307", "series": "CAG", "text": "πέμπτον οὐδέποτε τὰ σώματα μεριζόμενα τὸ ἓν εἶδος ἢ ποσὸν φυλάττει (οἷον εἰ ἔστι στατὴρ καὶ μερίζεται εἰς πολλά, οὐδέποτε τὸ ἓν εἶδος ἢ τὸ ποσὸν σώζει)·", "seq": 2307}
{"id": "David_Passim_2308", "series": "CAG", "text": "τὰ δὲ γένη καὶ τὰ εἴδη σώζουσι τὸ οἰκεῖον εἶδος μεριζόμενα εἰς Σωκράτην καὶ Πλάτωνα καὶ τοὺς λοιπούς·", "seq": 2308}
{"id": "David_Passim_2309", "series": "CAG", "text": "ὁμολογουμένως ἀσώματά εἰσιν.", "seq": 2309}
{"id": "David_Passim_2310", "series": "CAG", "text": "ἕκτον εἰ πᾶν σῶμα ἐξ ὕλης καὶ εἴδους συνέστηκεν, ἔστι δὲ τὸ γένος καὶ τὸ εἶδος σῶμα, εὑρεθήσεται τὸ εἶδος ἐξ ὕλης καὶ εἴδους συνιστάμενον, ὅπερ ἐστὶ γελοῖον·", "seq": 2310}
{"id": "David_Passim_2311", "series": "CAG", "text": "οὐδεὶς γὰρ λέγει εἶδος ἐξ εἴδους συγκεῖσθαι.", "seq": 2311}
{"id": "David_Passim_2312", "series": "CAG", "text": "ταῦτα ἔχει ἡ θεωρία καὶ ἡ παροῦσα πρᾶξις.", "seq": 2312}
{"id": "David_Passim_2313", "series": "CAG", "text": "Πρᾶξις ς΄.", "seq": 2313}
{"id": "David_Passim_2314", "series": "CAG", "text": "Ὅρα πῶς ὁ Πορφύριος φειδοῦς ἕνεκα τῶν νέων τὴν σαφήνειαν πανταχοῦ θηρεύων τὴν ἀσάφειαν ἀποβάλλεται·", "seq": 2314}
{"id": "David_Passim_2315", "series": "CAG", "text": "φησὶ γὰρ ὅτι εἰ καὶ ὑφέστηκεν ὁμολογουμένως καὶ ὑφεστῶτα ἀσώματά ἐστι τὰ προκείμενα, ἠδυνάμην πάλιν βαθέως περὶ τούτων ποιήσασθαι τὴν ζήτησιν, εἰ πρὸ πολλῶν εἰσιν ἢ ἐν πολλοῖς ἢ ἐπὶ τοῖς πολλοῖς.", "seq": 2315}
{"id": "David_Passim_2316", "series": "CAG", "text": "πρὸ πολλῶν δέ ἐστι τὸ ἐν τῇ γνώσει τοῦ θεοῦ ὑπάρχον ἤτοι τὸ ἔχον τὴν αἰτίαν ἐκ τῆς τοῦ θεοῦ δημιουργίας, ἐν πολλοῖς δὲ τὸ ὑπάρχον ἐν τῇ ὕλῃ, ἐπὶ τοῖς πολλοῖς δὲ τὸ εἰς γνῶσιν τῆς ἡμετέρας διανοίας ἐρχόμενον.", "seq": 2316}
{"id": "David_Passim_2317", "series": "CAG", "text": "[σκόπει δὲ ὅτι πανταχοῦ τὸ πολλοῖς εἰρήκαμεν διὰ τὰς καθόλου·", "seq": 2317}
{"id": "David_Passim_2318", "series": "CAG", "text": "αὗται γὰρ αἱ φωναὶ καθολικαὶ οὖσαι τῶν πολλῶν δέονται.]", "seq": 2318}
{"id": "David_Passim_2319", "series": "CAG", "text": "ἐπειδὴ δὲ καὶ δυσχερῆ τὰ λεγόμενα φαίνεται, φέρε παραδείγματι αὐτὰ καθυποβάλλωμεν.", "seq": 2319}
{"id": "David_Passim_2320", "series": "CAG", "text": "χρυσοῦν δακτύλιον ἀριστέως ἐκτύπωμα ἔχοντα διανόει μοι εἰς πολλοὺς κηροὺς τὴν εἰκόνα τοῦ ἀριστέως μετατιθέμενον, τινὰ δὲ ταύτας τὰς εἰκόνας θεώμενον καὶ κατὰ τὴν ἰδίαν διάνοιαν πάσας ἀναπολεῖν καὶ γινώσκειν μελετῶντα, καὶ τὸν μὲν δακτύλιον λέγε πρὸ τῶν πολλῶν (οὗτος γὰρ καὶ πρὶν ἢ γένωνται πολλαὶ σφραγῖδες ἐν τῷ κηρῷ γέγονε), τοὺς δὲ τύπους τοὺς ἐν τῷ κηρῷ ἐν τοῖς πολλοῖς, τὸν δὲ ἄνθρωπον τὸν ἔχοντα ταύτας τὰς εἰκόνας ἐν τῇ ἰδίᾳ διανοίᾳ ἐπὶ τοῖς πολλοῖς·", "seq": 2320}
{"id": "David_Passim_2321", "series": "CAG", "text": "οὗτος γὰρ δικαίως ἐπὶ τοῖς πολλοῖς λέγεται, καθὸ μετὰ τὰς πολλὰς σφραγῖδας τοῦ κηροῦ ἐρχόμενος ταύτας ἐν τῷ ἰδίῳ νῷ διανοεῖται.", "seq": 2321}
{"id": "David_Passim_2322", "series": "CAG", "text": "ἴσως δὲ ἀπορήσει τις ἡμῖν λέγων ὅτι ἄτοπόν ἐστι λέγειν τὰς προκειμένας φωνὰς ἐν τῇ ἡμετέρᾳ διανοίᾳ ὑπάρχειν, ἡμῶν δειξάντων ἀνωτέρω τὰ ἐν ψιλῇ ἐπινοίᾳ ἐν τῇ ἡμετέρᾳ διανοίᾳ ὑφίστασθαι.", "seq": 2322}
{"id": "David_Passim_2323", "series": "CAG", "text": "πρὸς ὃν ἐροῦμεν ὅτι διττόν ἐστι τὸ λεγόμενον·", "seq": 2323}
{"id": "David_Passim_2324", "series": "CAG", "text": "ἐκεῖ μὲν γὰρ ψιλὴν διάνοιαν ἐλέγομεν, ἥτις τὰ μὴ ἐγνωσμένα τῇ φύσει καθ᾿ ἑαυτὴν διανοεῖται ἐξ ἐλάφου καὶ τράγου ἕν τι ποιοῦσα τὴν φύσιν βιαζομένη, ὧδε δὲ ἀκριβῆ διάνοιαν λέγω τὴν γινώσκουσαν ἀκριβῶς τῆς φύσεως τὰ δημιουργήματα.", "seq": 2324}
{"id": "David_Passim_2325", "series": "CAG", "text": "Ἐπεὶ οὖν ἐδίδαξεν ἡμᾶς τὸ παράδειγμα τὸ λεγόμενον, φέρε καὶ τὴν περὶ τούτου δοκοῦσαν διαφωνίαν Ἀριστοτέλους καὶ Πλάτωνος εἴπωμεν, ὕστερον δὲ καὶ αὐτοὺς διαιτήσωμεν.", "seq": 2325}
{"id": "David_Passim_2326", "series": "CAG", "text": "θαυμαστὸν δέ τι συνέβη ἐπὶ ταύτης τῆς διαιρέσεως·", "seq": 2326}
{"id": "David_Passim_2327", "series": "CAG", "text": "ἐπὶ μὲν γὰρ τῶν ἄλλων ἐφ᾿ ἑκάτερα ψεῦδος εἶναι καὶ ἀληθὲς οὐκ ἠδύνατο·", "seq": 2327}
{"id": "David_Passim_2328", "series": "CAG", "text": "οὐ γὰρ ἐδύνω ψεύσασθαι καὶ εἰπεῖν ὅτι οὔτε ὑφέστηκεν οὔτε ἐν ψιλῇ ἐπινοίᾳ ὑπάρχει, οὔτε πάλιν ἀληθὲς εἰπεῖν ὅτι καὶ ὑφέστηκε καὶ ἐν ψιλῇ ἐπινοίᾳ ὑπάρχει, οὔτε ὁμοίως ψεῦδος εἰπεῖν ὅτι οὔτε σώματά ἐστιν οὔτε ἀσώματα, οὐδὲ πάλιν ἀληθεῦσαι ὅτι καὶ σώματά ἐστι καὶ ἀσώματα.", "seq": 2328}
{"id": "David_Passim_2329", "series": "CAG", "text": "ἐπὶ δὲ τῆς προκειμένης διαιρέσεως δύναται ἐφ᾿ ἑκάτερα τὸ ἀληθὲς εἶναι·", "seq": 2329}
{"id": "David_Passim_2330", "series": "CAG", "text": "οὔτε γὰρ ἑνὸς ἀληθοῦς δεικνυμένου τὰ ἕτερα ψεύδει καθυποβάλλονται, ὥσπερ καὶ ἐπὶ τῶν πρώτων συνέβη·", "seq": 2330}
{"id": "David_Passim_2331", "series": "CAG", "text": "δυνατὸν γὰρ λέγειν ὅτι καὶ πρὸ πολλῶν ἐστι καὶ ἐν πολλοῖς καὶ ἐπὶ τοῖς πολλοῖς·", "seq": 2331}
{"id": "David_Passim_2332", "series": "CAG", "text": "οὕτω γὰρ καὶ Πλάτων δοξάζει·", "seq": 2332}
{"id": "David_Passim_2333", "series": "CAG", "text": "φησὶ γὰρ ὅτι καὶ γίνεται καὶ ἔστι καὶ ἐν σχέσει ὑπάρχει, καὶ ἐν μὲν τῷ λέγειν ‘γίνεται’ ἐδήλωσε τὸ πρὸ πολλῶν (ὡς ἵνα νοήσῃς τὸν δακτύλιον πρὸ τῶν σφραγίδων γινόμενον), ἐν δὲ τῷ λέγειν ‘καὶ ἔστιν’ ἐδήλωσεν ὅτι καὶ ἐν πολλοῖς ἐστι, τοῦτ᾿ ἔστι τὸ ἐν τῇ ὕλῃ, ἐν δὲ τῷ λέγειν ὅτι ‘καὶ ἐν σχέσει’ ἐδήλωσεν ὅτι καὶ ἐπὶ τοῖς πολλοῖς ἐστι·", "seq": 2333}
{"id": "David_Passim_2334", "series": "CAG", "text": "γνῶσις γὰρ καὶ ἡ σχέσις.", "seq": 2334}
{"id": "David_Passim_2335", "series": "CAG", "text": "Ἀριστοτέλης δὲ τὸ ἐπὶ τοῖς πολλοῖς δοξάζει, οὐχὶ δὲ καὶ τὸ πρὸ πολλῶν·", "seq": 2335}
{"id": "David_Passim_2336", "series": "CAG", "text": "φησὶ γὰρ ὅτι ἐν σχέσει ἐστί, καὶ ταῦτα ἐν πολλοῖς ὁμολογεῖ, τὸ πρὸ πολλῶν δὲ οὔ φησιν εἶναι·", "seq": 2336}
{"id": "David_Passim_2337", "series": "CAG", "text": "λέγει γὰρ ὅτι τῶν ἐνεργειῶν αἱ μέν εἰσιν οὐσιώδεις αἱ δὲ ἐπουσιώδεις, καὶ οὐσιώδεις μὲν αἱ τῆς φύσεως (αὗται γὰρ λόγου οὐ δέονται·", "seq": 2337}
{"id": "David_Passim_2338", "series": "CAG", "text": "ἡ γὰρ φύσις οὐσίαν ἔχει τὸ ἐνεργεῖν, καὶ ταῦτα ἐκτὸς λόγου.", "seq": 2338}
{"id": "David_Passim_2339", "series": "CAG", "text": "ἡ οὖν φύσις χωρὶς τοῦ λόγου ἐνεργοῦσα λόγον οὐκ ἔχει, ἡ δὲ γνῶσις πάντως διὰ λόγου γίνεται.", "seq": 2339}
{"id": "David_Passim_2340", "series": "CAG", "text": "εἰ οὖν οὐκ ἔστι παρὰ τῷ θεῷ τῶν δημιουργημάτων γνῶσις, οὐκοῦν οὐδὲ τὸ πρὸ πολλῶν ὑπάρχει), ἐπουσιώδεις δέ εἰσιν αἱ ἐνέργειαι τοῦ τέκτονος καὶ τῶν ὁμοίων·", "seq": 2340}
{"id": "David_Passim_2341", "series": "CAG", "text": "αὗται γὰρ λόγου δέονται·", "seq": 2341}
{"id": "David_Passim_2342", "series": "CAG", "text": "οὐ γὰρ ἀπὸ φύσεως ἔχει ὁ τέκτων τὸ ἐνεργεῖν, ἐπεὶ οὐκ ἐπαύετο ἂν ἐνεργῶν·", "seq": 2342}
{"id": "David_Passim_2343", "series": "CAG", "text": "ἡ γὰρ φύσις οὐ παύεται ἐνεργοῦσα.", "seq": 2343}
{"id": "David_Passim_2344", "series": "CAG", "text": "οἱ δὲ ταῦτα λέγοντες καταψεύδονται Ἀριστοτέλους·", "seq": 2344}
{"id": "David_Passim_2345", "series": "CAG", "text": "πανταχοῦ γὰρ λέγει μὴ εἶναι πρᾶξιν χωρὶς γνώσεως μήτε γνῶσιν χωρὶς πράξεως.", "seq": 2345}
{"id": "David_Passim_2346", "series": "CAG", "text": "πόθεν δὲ ἡ πλάνη γέγονε λέξωμεν.", "seq": 2346}
{"id": "David_Passim_2347", "series": "CAG", "text": "Διαφορὰ τῶν Πλατωνικῶν δογμάτων οὐκ ὀλίγη γέγονε·", "seq": 2347}
{"id": "David_Passim_2348", "series": "CAG", "text": "τινὲς γὰρ τῶν Πλατωνικῶν ἔλεγον ὅτι κατὰ τοῦτό φαμεν τὸ πρὸ πολλῶν εἶναι, καθὸ λόγῳ παρὰ τῷ θεῷ τὰ πάντα δημιουργεῖται.", "seq": 2348}
{"id": "David_Passim_2349", "series": "CAG", "text": "ἄλλοι δὲ ἔλεγον ὅτι κατὰ τοῦτό φαμεν πρὸ πολλῶν, ὅτι εἰσίν τινες ἰδέαι αὐθυπόστατοι λόγον μὴ ἔχουσαι αἴσθησιν δέ, ὧν κατ᾿ εἰκόνα πάντα δημιουργεῖ ὁ θεός.", "seq": 2349}
{"id": "David_Passim_2350", "series": "CAG", "text": "ἄλλοι δὲ ἔλεγον τινὰς ἰδέας αἴσθησιν μὴ ἐχούσας εἶναι, ὧν κατ᾿ εἰκόνα πάντα δημιουργεῖ ὁ θεός·", "seq": 2350}
{"id": "David_Passim_2351", "series": "CAG", "text": "ἔλεγον γὰρ εἶναι καθολικὸν βοῦν, εἰς ὃν ἀφορῶν ὁ θεὸς δημιουργεῖ τὸν παρ᾿ ἡμῖν βοῦν, καὶ καθολικὸν ἄνθρωπον, εἰς ὃν ἀφορῶν ὁ θεὸς δημιουργεῖ τὸν παρ᾿ ἡμῖν ἄνθρωπον, ὅλα δὲ τὰ τοιαῦτα προϋπάρχειν τῆς ἡμῶν γενέσεως.", "seq": 2351}
{"id": "David_Passim_2352", "series": "CAG", "text": "διὰ τοῦτο οὖν τὸ πρὸ τῶν πολλῶν διάφορον ἐφαίνετο.", "seq": 2352}
{"id": "David_Passim_2353", "series": "CAG", "text": "διὸ καὶ ὁ Ἀριστοτέλης ἔδοξε μὴ δοξάζειν τὸ πρὸ πολλῶν τούτοις μὴ συγκατατιθέμενος·", "seq": 2353}
{"id": "David_Passim_2354", "series": "CAG", "text": "οὗτοι γὰρ ἀδυναμίαν τοῦ θεοῦ δεικνύουσιν αἰσθήσεως αὐτὸν δεῖσθαι λέγοντες.", "seq": 2354}
{"id": "David_Passim_2355", "series": "CAG", "text": "τὸ δὲ μέγιστον·", "seq": 2355}
{"id": "David_Passim_2356", "series": "CAG", "text": "εἰ ἔχει τὰ τοιαῦτα αἴσθησιν, διὰ τί μὴ ὁρῶμεν αὐτὰ ἢ ψηλαφῶμεν;", "seq": 2356}
{"id": "David_Passim_2357", "series": "CAG", "text": "δεύτερον οἱ λέγοντες ὅτι αὐθυπόστατοί εἰσιν αἱ ἰδέαι αἴσθησιν δὲ μὴ ἔχουσαι, ὧν κατ᾿ εἰκόνα ὁ θεὸς δημιουργεῖ, οὐκ ὀλίγα πταίουσιν·", "seq": 2357}
{"id": "David_Passim_2358", "series": "CAG", "text": "οὗτοι γὰρ καὶ τὰς ἰδέας παραδείγματα ὑποτιθέασι, ταῦτα δὲ τὰ παραδείγματα πρὸ τῆς δημιουργίας τοῦ θεοῦ·", "seq": 2358}
{"id": "David_Passim_2359", "series": "CAG", "text": "πάντως γὰρ εἰ κατ᾿ εἰκόνα αὐτῶν δημιουργεῖ ὁ θεός, αὗται προτερεύουσι τῶν δημιουργημάτων·", "seq": 2359}
{"id": "David_Passim_2360", "series": "CAG", "text": "ὥσπερ γὰρ <εἰ> ἀποβλέψει ζωγράφος τις εἰς Σωκράτην καὶ τούτου τὴν εἰκόνα ποιήσει, προτερεύειν λέξομεν τῆς εἰκόνος τὸν Σωκράτην, οὕτω καὶ τὰς ἰδέας τῆς τοῦ θεοῦ δημιουργίας, ὅπερ ἄτοπον.", "seq": 2360}
{"id": "David_Passim_2361", "series": "CAG", "text": "τῷ μὲν οὖν λέγοντι τοῦ θεοῦ τὴν δημιουργίαν μετὰ λόγου εἶναι συγκατατίθεται ὁ Ἀριστοτέλης, ἀλλὰ μὴν οὐ μόνον τὸ πρὸ πολλῶν καὶ ἐπὶ τοῖς πολλοῖς δοξάζει, ἀλλὰ καὶ τὸ ἐν τοῖς πολλοῖς·", "seq": 2361}
{"id": "David_Passim_2362", "series": "CAG", "text": "ἐν γὰρ τῇ Μετὰ τὰ φυσικὰ περὶ τῶν τοιούτων λέγων παραδείγματι αὐτὰ καθυπέβαλλε φάσκων ὅτι ὥσπερ ὁ ἄρχων ἔχει τὴν τάξιν ἐν ἑαυτῷ πρότερον, καὶ εἶθ᾿ οὕτως ὕστερον ἐκ ταύτης ἢ ἐν τῷ στρατοπέδῳ γίνεται ἢ ἐν τῇ πόλει, οὕτω καὶ τὰ τοιαῦτα <πρῶτον μὲν> παρὰ τῷ θεῷ ἐστιν, ὕστερον δὲ ἐν τῇ ὕλῃ·", "seq": 2362}
{"id": "David_Passim_2363", "series": "CAG", "text": "πρῶτον γὰρ αὐτὰ γινώσκει ὁ θεός, καὶ ὕστερον δημιουργεῖ αὐτὰ ἡ φύσις.", "seq": 2363}
{"id": "David_Passim_2364", "series": "CAG", "text": "ὅταν οὖν ἔλεγεν ὁ Ἀριστοτέλης δημιουργεῖν τὴν φύσιν χωρὶς λόγου, τοῦτο ἐβούλετο δεῖξαι ὅτι αὐτὰ ἡ μὲν φύσις οὐ γινώσκει, δημιουργοῦσα δὲ τὸν θεὸν οὐ λανθάνει.", "seq": 2364}
{"id": "David_Passim_2365", "series": "CAG", "text": "ἐν οἷς καὶ ἡ παροῦσα θεωρία.", "seq": 2365}
{"id": "David_Passim_2366", "series": "CAG", "text": "Πρᾶξις ζ.", "seq": 2366}
{"id": "David_Passim_2367", "series": "CAG", "text": "Τῶν ἀγώνων τὰ ἔπαθλα τοῖς καθόλου τριχῶς χαρισάμενοι, ὅτι οὐκ ἐν ψιλαῖς ἐπινοίαις ἐστὶν ἀλλ᾿ ὑφέστηκε, καὶ ὅτι οὐ σώματα ἀλλ᾿ ἀσώματα, καὶ ὅτι πρὸ τῶν πολλῶν εἰσι καὶ ἐν τοῖς πολλοῖς καὶ ἐπὶ τοῖς πολλοῖς, φέρε τὰ τούτοις ἀντικείμενα παρατιθέμενοι τὸ ἀκριβὲς εἰσόμεθα·", "seq": 2367}
{"id": "David_Passim_2368", "series": "CAG", "text": "τινὲς γάρ φασι μὴ ὑφίστασθαι ταῦτα, ἀλλ᾿ ἐν ψιλαῖς ἐπινοίαις ὑπάρχειν, μήτε ἀσώματα ἀλλὰ σώματα, πρὸ τῶν πολλῶν ἢ ἐν τοῖς πολλοῖς οὔ φασιν αὐτὰ εἶναι, ἀλλ᾿ ἐπὶ τοῖς πολλοῖς.", "seq": 2368}
{"id": "David_Passim_2369", "series": "CAG", "text": "καὶ πρὸς μὲν τὸ πρῶτον οὕτω λέγουσιν, ὅτι ἐν ψιλαῖς ἐπινοίαις εἰσὶ καὶ οὐχ ὑφεστήκασιν·", "seq": 2369}
{"id": "David_Passim_2370", "series": "CAG", "text": "εἰ γὰρ τὰ μὴ ἐκ φύσεως δεδημιουργημένα, σώτειραν δὲ μόνην τὴν ἡμετέραν διάνοιαν ἔχοντά φαμεν ἐν ψιλαῖς ἐπινοίαις εἶναι ὥσπερ τὸν τραγέλαφον (οὗτος γὰρ τῇ φύσει ἀγνοεῖται ὁμολογουμένως), καὶ τὰ καθόλου ἐν ψιλαῖς ἐπινοίαις ὑπάρχει ἐκ φύσεως μὴ ἔχοντα τὸ εἶναι, ἀλλ᾿ ἐν τῇ ἡμετέρᾳ διανοίᾳ σωζόμενα.", "seq": 2370}
{"id": "David_Passim_2371", "series": "CAG", "text": "πρὸς δὲ τὸ δεύτερον πάλιν ἀντιλέγουσι φάσκοντες ὅτι σώματά ἐστι τὰ καθόλου·", "seq": 2371}
{"id": "David_Passim_2372", "series": "CAG", "text": "τὴν αὐτὴν γὰρ φύσιν ἔχει τοῖς μερικοῖς καὶ τὸν αὐτὸν ὁρισμὸν δέχεται.", "seq": 2372}
{"id": "David_Passim_2373", "series": "CAG", "text": "εἰ οὖν ἔστι τις καθόλου ἄνθρωπος, ὤφειλε καὶ τὸν ὁρισμὸν δέχεσθαι τὸν τοῦ ἀνθρώπου, ζῷον λογικὸν καὶ τὰ ἑξῆς.", "seq": 2373}
{"id": "David_Passim_2374", "series": "CAG", "text": "καὶ εἰ μὲν οὐ δέχεται, λέγομεν ὅτι οὐδὲ ἔστι καθόλου, εἰ δὲ δέχεται, πάντως σῶμά ἐστι·", "seq": 2374}
{"id": "David_Passim_2375", "series": "CAG", "text": "τὸ γὰρ ζῷον λογικὸν σῶμα πάντως δηλοῖ.", "seq": 2375}
{"id": "David_Passim_2376", "series": "CAG", "text": "ἔχομεν δὲ καὶ πορίσματος μοῖραν ὅτι οὔκ εἰσιν ἀίδια τὰ καθόλου·", "seq": 2376}
{"id": "David_Passim_2377", "series": "CAG", "text": "δηλοῖ γὰρ τὸ θνητὸν ‘ζῷον λογικὸν θνητόν’·", "seq": 2377}
{"id": "David_Passim_2378", "series": "CAG", "text": "τὸ γὰρ θνητὸν πάντως θνήσκει.", "seq": 2378}
{"id": "David_Passim_2379", "series": "CAG", "text": "ἀλλ᾿ ἴσως εἴποι τις ὅτι δυνάμει ἔχει τὸ θνήσκειν, οὐκ ἀποθνήσκει δέ.", "seq": 2379}
{"id": "David_Passim_2380", "series": "CAG", "text": "τοῦτο δὲ ὑπόψυχρον·", "seq": 2380}
{"id": "David_Passim_2381", "series": "CAG", "text": "τὸ γὰρ δύναμιν ἔχον πάντως εἰς ἐνέργειαν χωρεῖ μὴ ἐπιλείποντος τοῦ χρόνου, ἐπεὶ μάτην ἔχει τὸ δύνασθαι·", "seq": 2381}
{"id": "David_Passim_2382", "series": "CAG", "text": "οἷον ἄνθρωπος γραμματικὸς δυνάμει ἐστί, πάντως δὲ γραμματικὸς ἔσται τοῦ χρόνου μὴ ἐπιλείποντος.", "seq": 2382}
{"id": "David_Passim_2383", "series": "CAG", "text": "ἀλλὰ μὴν οὔτε ὅλως ὑφέστηκε τὰ καθόλου·", "seq": 2383}
{"id": "David_Passim_2384", "series": "CAG", "text": "τῶν γὰρ μερικῶν σωμάτων ὄντων καὶ τὸ καθόλου σῶμα ἔσται, εἶναι δὲ σῶμα καὶ ἀσώματον τὸ αὐτὸ ἀδύνατον·", "seq": 2384}
{"id": "David_Passim_2385", "series": "CAG", "text": "οὐκ ἔστιν ἄρα τὰ καθόλου.", "seq": 2385}
{"id": "David_Passim_2386", "series": "CAG", "text": "πρὸς τὸ τρίτον φασὶν ὅτι οὐκ ἔστι τὸ πρὸ τῶν πολλῶν, εἴ γε μαρτυρεῖ ὁ Ἀριστοτέλης λέγων ‘τὰ γὰρ εἴδη χαιρέτω·", "seq": 2386}
{"id": "David_Passim_2387", "series": "CAG", "text": "τερετίσματα γάρ ἐστι’·", "seq": 2387}
{"id": "David_Passim_2388", "series": "CAG", "text": "ταῦτα γὰρ ἔλεγόν τινες ἰδέας εἶναι αὐθυποστάτους, ἃς ψέγει ὁ φιλόσοφος.", "seq": 2388}
{"id": "David_Passim_2389", "series": "CAG", "text": "ἔτι δέ φησι ‘τὸ γὰρ καθόλου ζῷον οὐκ ἔστιν, εἰ δὲ ἔστιν, ὕστερόν ἐστι’.", "seq": 2389}
{"id": "David_Passim_2390", "series": "CAG", "text": "τοῦτο δὲ ἐμφαίνει ὅτι πρὸ τῶν πολλῶν οὐκ ἔστιν, εἰ δὲ ἔστι καθόλου ὅλως (τοῦτο γὰρ ἀμφέβαλεν ὁ Ἀριστοτέλης), ἐν τῇ ἡμετέρᾳ διανοίᾳ ἐστί, τοῦτ᾿ ἔστιν ἐπὶ τοῖς πολλοῖς·", "seq": 2390}
{"id": "David_Passim_2391", "series": "CAG", "text": "τοῦτο γὰρ δηλοῖ τὸ ‘ὕστερόν ἐστιν’.", "seq": 2391}
{"id": "David_Passim_2392", "series": "CAG", "text": "ἀλλὰ μὴν οὔτε ἐν τοῖς πολλοῖς ἔστι·", "seq": 2392}
{"id": "David_Passim_2393", "series": "CAG", "text": "τί γὰρ λέγεις;", "seq": 2393}
{"id": "David_Passim_2394", "series": "CAG", "text": "ἢ μίαν φύσιν ἐρεῖς καθ᾿ ἑαυτὴν ὑφίστασθαι ὑπὸ πολλῶν δὲ μετέχεσθαι (τοῦτο γὰρ ἴδιον τῶν καθόλου), ἢ πολλὰς ἐν πολλοῖς θεωρεῖσθαι;", "seq": 2394}
{"id": "David_Passim_2395", "series": "CAG", "text": "καὶ εἰ μὲν μίαν εἴπῃς καθ᾿ ἑαυτὴν ὑφίστασθαι, ψεύδῃ (τοῦτο γὰρ εὐθύνας δέδωκεν ἐν τῷ πρὸ τοῦ ἐπιχειρήματι), εἰ δὲ πολλάς, τοῦτο καθόλου μᾶλλον οὐκ ἔστιν, ἀλλὰ μερικόν.", "seq": 2395}
{"id": "David_Passim_2396", "series": "CAG", "text": "τὸ ἐπὶ τοῖς πολλοῖς δὲ μόνον φασὶν εἶναι.", "seq": 2396}
{"id": "David_Passim_2397", "series": "CAG", "text": "τοῦτο δὲ τὸ ἐπὶ τοῖς πολλοῖς καθόλου οὐ καθὸ ἐν τοῖς πολλοῖς ὑπάρχει, διὰ τοῦτο καθόλου λέγεται (δύναται γὰρ καὶ ἐν Σωκράτει μόνῳ τὸ καθόλου νοεῖσθαι), ἀλλὰ καθὸ εἰς Πλάτωνα ἀποβλέπων τὸν πρὸ αὐτοῦ τοιοῦτον ἐθεασάμην καὶ τὸν μετ᾿ αὐτὸν ὁμοίως.", "seq": 2397}
{"id": "David_Passim_2398", "series": "CAG", "text": "καθόλου δὲ ῥηθήσεται, καθὸ προγεγενημένοις καὶ οὖσι καὶ μεταγενεστέροις ἁρμόζει.", "seq": 2398}
{"id": "David_Passim_2399", "series": "CAG", "text": "ἐὰν οὖν εἷς μόνος ὑπολειφθῇ, αὐτὸν καθόλου λέξω διὰ τὸ πάντας τοιούτους εἶναι.", "seq": 2399}
{"id": "David_Passim_2400", "series": "CAG", "text": "σώζεται δὲ τοῦτο ἐν τῇ ἡμετέρᾳ διανοίᾳ·", "seq": 2400}
{"id": "David_Passim_2401", "series": "CAG", "text": "ἀποβλέπων γὰρ εἰς Σωκράτην καὶ εἰς ἄλλον τῆς αὐτῆς μετέχοντα φύσεώς φημι εἶναι τὸ καθόλου.", "seq": 2401}
{"id": "David_Passim_2402", "series": "CAG", "text": "Τί οὖν;", "seq": 2402}
{"id": "David_Passim_2403", "series": "CAG", "text": "καλῶς εἰρήκασι πρὸς ἅπαντα;", "seq": 2403}
{"id": "David_Passim_2404", "series": "CAG", "text": "φαμὲν ὅτι οὔ·", "seq": 2404}
{"id": "David_Passim_2405", "series": "CAG", "text": "οὔτε γὰρ ἐν ψιλαῖς ἐπινοίαις ὑπάρχει, ὡς ἔλεγον, ἀλλ᾿ ὑφέστηκεν, οὐ καθ᾿ ἑαυτὰ δέ, ἀλλ᾿ ἐν τῇ ἡμετέρᾳ διανοίᾳ·", "seq": 2405}
{"id": "David_Passim_2406", "series": "CAG", "text": "εἰ γὰρ ἐκεῖ τὰ μὴ ὄντα φαμὲν ἐν ψιλαῖς ἐπινοίαις ὑπάρχειν, τὸν τραγέλαφον καὶ τὰ ὅμοια, οὐκ ἔστιν ἄρα τὰ καθόλου ἐν ψιλαῖς ἐπινοίαις·", "seq": 2406}
{"id": "David_Passim_2407", "series": "CAG", "text": "ἀπὸ γὰρ τῶν ὄντων αὐτὰ λαμβάνομεν ἐν τῇ ἡμετέρᾳ διανοίᾳ, ἀπὸ Σωκράτους καὶ Ἀλκιβιάδου καὶ τῶν τοιούτων, ἐπιγινώσκοντες εἶναι τὸ καθόλου·", "seq": 2407}
{"id": "David_Passim_2408", "series": "CAG", "text": "τοῦτο δὲ τῶν ὄντων ἐστί.", "seq": 2408}
{"id": "David_Passim_2409", "series": "CAG", "text": "ταῦτα οὖν ἐν τῇ ἡμετέρᾳ διανοίᾳ σώζεται·", "seq": 2409}
{"id": "David_Passim_2410", "series": "CAG", "text": "καθ᾿ ἑαυτὰ γὰρ οὐχ ὑφίσταται.", "seq": 2410}
{"id": "David_Passim_2411", "series": "CAG", "text": "πρὸς τὸ δεύτερον·", "seq": 2411}
{"id": "David_Passim_2412", "series": "CAG", "text": "κἄν τε σώματά ἐστι κἄν τε μή, οὐδὲν τῷ ἡμετέρῳ λόγῳ λυμαίνεται·", "seq": 2412}
{"id": "David_Passim_2413", "series": "CAG", "text": "ὑφίσταται γὰρ ἐν τῇ ἡμετέρᾳ διανοίᾳ, ὅπερ ἐπὶ τοῖς πολλοῖς ἐστιν.", "seq": 2413}
{"id": "David_Passim_2414", "series": "CAG", "text": "οὐ καλῶς δέ φασι μὴ εἶναι αὐτὰ ἀίδια·", "seq": 2414}
{"id": "David_Passim_2415", "series": "CAG", "text": "τὸ γὰρ ἀίδιον διττόν, τὸ μὲν ἀριθμῷ τὸ δὲ εἴδει·", "seq": 2415}
{"id": "David_Passim_2416", "series": "CAG", "text": "ἀριθμῷ μὲν ἀίδιόν ἐστιν ἡ ψυχὴ καὶ τὰ θεῖα (ταῦτα γὰρ ἀεὶ ἔστιν), εἴδει δὲ ἀίδιόν ἐστιν ὁ ἄνθρωπος·", "seq": 2416}
{"id": "David_Passim_2417", "series": "CAG", "text": "κἂν γὰρ φθαρῇ Σωκράτης, περιλείπεται Ἀλκιβιάδης.", "seq": 2417}
{"id": "David_Passim_2418", "series": "CAG", "text": "πρὸς τὸ τρίτον·", "seq": 2418}
{"id": "David_Passim_2419", "series": "CAG", "text": "καλῶς ἔλεγον μὴ εἶναι πρὸ τῶν πολλῶν·", "seq": 2419}
{"id": "David_Passim_2420", "series": "CAG", "text": "οὔτε γὰρ ἔστιν, εἰ μὴ τί γε κατὰ τὴν γνῶσιν, ὡς ἔλεγεν Ἀριστοτέλης.", "seq": 2420}
{"id": "David_Passim_2421", "series": "CAG", "text": "τὸ δὲ ἐν τοῖς πολλοῖς καὶ ἐν γνώσει ἐστίν·", "seq": 2421}
{"id": "David_Passim_2422", "series": "CAG", "text": "ἡ γὰρ γνῶσις ἐν ἡμῖν ἐστι καὶ ἐν τῷ δημιουργῷ, ὅπερ πρὸ πολλῶν ἐστι καὶ ἐπὶ τοῖς πολλοῖς.", "seq": 2422}
{"id": "David_Passim_2423", "series": "CAG", "text": "ἐν οἷς ἡ παροῦσα θεωρία.", "seq": 2423}
{"id": "David_Passim_2424", "series": "CAG", "text": "Πρᾶξις ή.", "seq": 2424}
{"id": "David_Passim_2425", "series": "CAG", "text": "1.", "seq": 2425}
{"id": "David_Passim_2426", "series": "CAG", "text": "9 Aὐτίκα.", "seq": 2426}
{"id": "David_Passim_2427", "series": "CAG", "text": "Οὐκ ὀλίγης προθεωρίας εἰρημένης χωρήσωμεν ἐπ᾿ αὐτὴν τὴν λέξιν.", "seq": 2427}
{"id": "David_Passim_2428", "series": "CAG", "text": "ἔχει δὲ τὰ τῆς συντάξεως οὕτως·", "seq": 2428}
{"id": "David_Passim_2429", "series": "CAG", "text": "σύντομόν σοι παράδοσιν ποιούμενος πειράσομαι διὰ βραχέων ὥσπερ ἐν εἰσαγωγῆς τρόπῳ τὰ παρὰ τῶν πρεσβυτέρων ἐπελθεῖν, τῶν μὲν βαθυτέρων ζητημάτων ἀπεχόμενος, τῶν δὲ ἁπλουστέρων συμμέτρως στοχαζόμενος.", "seq": 2429}
{"id": "David_Passim_2430", "series": "CAG", "text": "αὐτίκα περὶ τῶν γενῶν καὶ εἰδῶν εἴτε ὑφέστηκεν εἴτε ἐν ψιλαῖς μόναις ἐπινοίαις κεῖται εἴτε ὑφεστηκότα σώματά ἐστιν ἢ ἀσώματα καὶ πότερον πρὸ τῶν πολλῶν ἢ ἐν τοῖς πολλοῖς ἢ ἐπὶ τοῖς πολλοῖς ἐστι παραιτήσομαι λέγειν καὶ τὰ ἑξῆς.", "seq": 2430}
{"id": "David_Passim_2431", "series": "CAG", "text": "ζητοῦμεν δὲ διὰ τί <ἐπεὶ> προέκειτο Πορφυρίῳ περὶ τῶν πέντε φωνῶν διαλαβεῖν, [καὶ] μόνου τοῦ γένους καὶ τοῦ εἴδους μνείαν ἐποιήσατο, διαφορᾶς δὲ καὶ ἰδίου καὶ συμβεβηκότος οὐκέτι·", "seq": 2431}
{"id": "David_Passim_2432", "series": "CAG", "text": "ὡσαύτως γὰρ καὶ ἐπὶ τῶν παραλειφθέντων ζητητέα τὰ προκείμενα, εἴτε ὑφέστηκεν εἴτε ἐν μόναις ψιλαῖς ἐπινοίαις κεῖται, καὶ ὅσα ἂν ζητήσῃ τις περὶ γένους καὶ εἴδους, τοσαῦτα καὶ περὶ διαφορᾶς καὶ ἰδίου καὶ συμβεβηκότος.", "seq": 2432}
{"id": "David_Passim_2433", "series": "CAG", "text": "φαμὲν δὲ ὅτι δικαίως τῆς διαφορᾶς καὶ τοῦ ἰδίου καὶ τοῦ συμβεβηκότος οὐκ ἐμνήσθη, ἐπειδὴ ἤρκει αὐτῷ μνησθῆναι γένους καὶ εἴδους·", "seq": 2433}
{"id": "David_Passim_2434", "series": "CAG", "text": "διὰ γὰρ τῶν ἄλλων τριῶν διήκει τὸ γένος καὶ τὸ εἶδος.", "seq": 2434}
{"id": "David_Passim_2435", "series": "CAG", "text": "λέγων οὖν τὸ γένος καὶ τὸ εἶδος συμπεριελάμβανεν καὶ τὰς ἄλλας τρεῖς φωνάς·", "seq": 2435}
{"id": "David_Passim_2436", "series": "CAG", "text": "ἔχει γάρ, ὡς ἔφαμεν, ἡ διαφορὰ γένος καὶ εἶδος·", "seq": 2436}
{"id": "David_Passim_2437", "series": "CAG", "text": "γένος μὲν ὡς ἵνα εἴπῃς τὴν διαφορὰν τὴν ἐν ἐμοὶ καὶ ἐν τῷ ἵππῳ καὶ ἐν τῷ κυνὶ καὶ ἐν τοῖς ἄλλοις εἴδεσι (τὸ οὖν κατηγορούμενον εἰδῶν τοῦτο γένος καλεῖται, αὕτη δὲ εἰδῶν κατηγορεῖται), εἶδος δὲ ὡς ἵνα ἀτομώσῃς τὴν ἐπὶ τὰ πολλὰ εἴδη φερομένην διαφορὰν καὶ εἴπῃς λογικότης·", "seq": 2437}
{"id": "David_Passim_2438", "series": "CAG", "text": "αὕτη γὰρ ἀτόμων κατηγορεῖται, τὸ δὲ ἀτόμων κατηγορούμενον εἶδός ἐστιν.", "seq": 2438}
{"id": "David_Passim_2439", "series": "CAG", "text": "ἀλλὰ μὴν καὶ ἐν τῷ ἰδίῳ ἐστὶ γένος καὶ εἶδος·", "seq": 2439}
{"id": "David_Passim_2440", "series": "CAG", "text": "γένος μὲν ὡς ἵνα εἴπῃς τὸ ἴδιον τὸ ὂν ἐν πᾶσι τοῖς εἴδεσιν (ἓν γὰρ καὶ ἕκαστον εἶδος ἔχει τι ἴδιον), εἶδος δὲ ὡς ἵνα εἴπῃς τὸ γελαστικόν·", "seq": 2440}
{"id": "David_Passim_2441", "series": "CAG", "text": "οὕτω γὰρ ἀτομοῖς τὸ ἐπὶ τὰ πολλὰ εἴδη φερόμενον ἴδιον·", "seq": 2441}
{"id": "David_Passim_2442", "series": "CAG", "text": "ἀτόμων γὰρ κατηγορεῖται τὸ γελαστικόν, τὸ δ᾿ ἀτόμων κατηγορεῖσθαι εἴδους ἐστί.", "seq": 2442}
{"id": "David_Passim_2443", "series": "CAG", "text": "πάλιν καὶ ἐν τῷ συμβεβηκότι ἐστὶ γένος καὶ εἶδος·", "seq": 2443}
{"id": "David_Passim_2444", "series": "CAG", "text": "γένος μὲν ὡς ἵνα εἴπῃς τὸ συμβεβηκὸς τὸ ὂν ἐν θερμῷ ἐν ψυχρῷ ἐν λευκῷ ἐν μέλανι ἐν γνώσει ἐν ἀγνοίᾳ (τοῦτο γὰρ γένος ἐστὶ τῷ ἐπὶ πολλὰ φέρεσθαι <εἴδη>), εἶδος δὲ ὡς ἵνα εἴπῃς τὸ θερμόν·", "seq": 2444}
{"id": "David_Passim_2445", "series": "CAG", "text": "ἀτομοῖς γὰρ ἐκεῖνο τὸ συμβεβηκός, ὃ ἐπὶ πολλὰ ἄτομα φερόμενον σημαίνει ἕν τι συμβεβηκός, ὅπερ εἶδός ἐστι.", "seq": 2445}
{"id": "David_Passim_2446", "series": "CAG", "text": "1.", "seq": 2446}
{"id": "David_Passim_2447", "series": "CAG", "text": "10 Τὸ μὲν εἴτε ὑφέστηκεν.", "seq": 2447}
{"id": "David_Passim_2448", "series": "CAG", "text": "Καλῶς τὸ ὑφέστηκε προέταξε·", "seq": 2448}
{"id": "David_Passim_2449", "series": "CAG", "text": "δύο γὰρ ὄντων, ψευδοῦς τε καὶ ἀληθοῦς, τὸ ἀληθὲς προέταξεν·", "seq": 2449}
{"id": "David_Passim_2450", "series": "CAG", "text": "ὑφίσταται γάρ.", "seq": 2450}
{"id": "David_Passim_2451", "series": "CAG", "text": "1.", "seq": 2451}
{"id": "David_Passim_2452", "series": "CAG", "text": "10 Εἴτε ἐν μόναις ψιλαῖς ἐπινοίαις κεῖται.", "seq": 2452}
{"id": "David_Passim_2453", "series": "CAG", "text": "Ἄξιόν ἐστι ζητῆσαι τί διαφέρει ἐπίνοια τῆς ψιλῆς ἐπινοίας.", "seq": 2453}
{"id": "David_Passim_2454", "series": "CAG", "text": "ἐπίνοια μέν ἐστιν, ὅταν διαχωρίζειν τῷ λόγῳ τολμῶμεν τὸ συνημμένον ἐκ τῆς φύσεως δημιούργημα·", "seq": 2454}
{"id": "David_Passim_2455", "series": "CAG", "text": "οἷον ἡ φύσις ὁμοῦ τὸ σῶμα καὶ τὸ χρῶμα δημιουργεῖ, καὶ οὐκ ἔστι σῶμα μὴ ἔχον χρῶμα.", "seq": 2455}
{"id": "David_Passim_2456", "series": "CAG", "text": "τοῦτο οὖν τὸ ὁμοῦ συνημμένον, φημὶ δὲ τὸ λευκὸν καὶ τὸ σῶμα, διαχωρίζομεν λέγοντες τὸ μὲν λευκὸν χρῶμα διακριτικὸν ὄψεως, τὸ δὲ σῶμα τριχῇ διαστατόν.", "seq": 2456}
{"id": "David_Passim_2457", "series": "CAG", "text": "αὕτη οὖν ἐστιν ἡ ἐπίνοια.", "seq": 2457}
{"id": "David_Passim_2458", "series": "CAG", "text": "ψιλὴν δὲ ἐπίνοιάν φαμεν, ὅταν τὰ μηδαμῇ μηδαμῶς ἐν τῇ ἡμετέρᾳ διανοίᾳ οἰκοδομῶμεν, τὸν τραγέλαφον καὶ τὰ ὅμοια.", "seq": 2458}
{"id": "David_Passim_2459", "series": "CAG", "text": "1.", "seq": 2459}
{"id": "David_Passim_2460", "series": "CAG", "text": "11 Εἴτε ὑφεστηκότα σώματά ἐστιν ἢ ἀσώματα.", "seq": 2460}
{"id": "David_Passim_2461", "series": "CAG", "text": "Τοῦ ψευδοῦς μὴ διαιρουμένου δικαίως αὐτὸ παρέλιπε, τοῦ δὲ ἀληθοῦς ἐμνημόνευσε τοῦ διαίρεσιν ἐπιδεχομένου·", "seq": 2461}
{"id": "David_Passim_2462", "series": "CAG", "text": "φησὶ γάρ·", "seq": 2462}
{"id": "David_Passim_2463", "series": "CAG", "text": "εἴτε ὑφεστηκότα ἢ σώματά ἐστιν ἢ ἀσώματα παραιτήσομαι λέγειν.", "seq": 2463}
{"id": "David_Passim_2464", "series": "CAG", "text": "πάλιν ζητοῦσιν εἰ καλῶς προέταξε τὰ σώματα τῶν ἀσωμάτων·", "seq": 2464}
{"id": "David_Passim_2465", "series": "CAG", "text": "φασὶ γὰρ ὅτι κακῶς αὐτὰ προέταξεν·", "seq": 2465}
{"id": "David_Passim_2466", "series": "CAG", "text": "εἰ γὰρ τῆς αὐτῆς δόξης ἐστὶν ὁ Πορφύριος, ἧς ἐστι Πλάτων καὶ Ἀριστοτέλης, οἵτινες ταύτας τὰς φωνὰς ἀσωμάτους δοξάζουσι, διὰ τί τὸ σῶμα τοῦ ἀσωμάτου προέταξε;", "seq": 2466}
{"id": "David_Passim_2467", "series": "CAG", "text": "φαμὲν δὲ ὅτι εἰσαγωγικώτερον ἐξηγούμενος τὰ σώματα ὡς εὔδηλα καὶ φανερὰ ὄντα πλέον τῶν ἀσωμάτων προέταξε.", "seq": 2467}
{"id": "David_Passim_2468", "series": "CAG", "text": "1.", "seq": 2468}
{"id": "David_Passim_2469", "series": "CAG", "text": "11 Καὶ πότερον χωριστὰ ἢ ἐν τοῖς αἰσθητοῖς καὶ περὶ ταῦτα ὑφεστῶτα.", "seq": 2469}
{"id": "David_Passim_2470", "series": "CAG", "text": "Σκόπει πῶς ἐφύλαξε τὴν τάξιν·", "seq": 2470}
{"id": "David_Passim_2471", "series": "CAG", "text": "χωριστὰ γὰρ λέγων ἐσήμανε τὰ πρὸ τῶν πολλῶν (ταῦτα γὰρ χωριστὰ λέγεται, ἐπειδὴ ἐν τῇ ὕλῃ οὔκ εἰσιν), ἐν τοῖς αἰσθητοῖς δὲ πάλιν λέγων ἐδήλωσε τὰ ἐν τοῖς πολλοῖς (τὰ γὰρ ἐν τῇ ὕλῃ αἰσθητά ἐστι), πάλιν λέγων καὶ περὶ ταῦτα ὑφεστῶτα ἐσήμανε τὰ ἐπὶ τοῖς πολλοῖς·", "seq": 2471}
{"id": "David_Passim_2472", "series": "CAG", "text": "τὰ γὰρ περὶ ταῦτα ὑφεστῶτά φαμεν τὴν ἡμετέραν διάνοιαν, ἥπερ ἐπὶ τοῖς πολλοῖς λέγεται.", "seq": 2472}
{"id": "David_Passim_2473", "series": "CAG", "text": "ὡς εἴπομεν δέ, καλῶς τὴν τάξιν παρέδωκε.", "seq": 2473}
{"id": "David_Passim_2474", "series": "CAG", "text": "1.", "seq": 2474}
{"id": "David_Passim_2475", "series": "CAG", "text": "14 Τὸ δὲ ὅπως περὶ αὐτῶν καὶ τῶν προκειμένων.", "seq": 2475}
{"id": "David_Passim_2476", "series": "CAG", "text": "Ὧδε οὐκέτι διὰ τοῦ γένους καὶ τοῦ εἴδους συμπεριλαμβάνει τὰς λοιπὰς φωνάς·", "seq": 2476}
{"id": "David_Passim_2477", "series": "CAG", "text": "φησὶ γὰρ καὶ τῶν προκειμένων, ὅ ἐστι διαφορὰ καὶ ἴδιον καὶ συμβεβηκός.", "seq": 2477}
{"id": "David_Passim_2478", "series": "CAG", "text": "1.", "seq": 2478}
{"id": "David_Passim_2479", "series": "CAG", "text": "15 Λογικώτερον οἱ παλαιοί.", "seq": 2479}
{"id": "David_Passim_2480", "series": "CAG", "text": "Διττῆς οὔσης τῆς τούτων παρὰ τοῖς παλαιοῖς ζητήσεως, τῶν τε θεολογικῶς περὶ αὐτῶν ζητούντων τῶν τε διαλεκτικῶς, φησὶν ὅτι οὐ θεολογικώτερον περὶ αὐτῶν ζητῶ (δυσχερὴς γὰρ ἡ τοιαύτη ζήτησις), ἀλλὰ διαλεκτικώτερον·", "seq": 2480}
{"id": "David_Passim_2481", "series": "CAG", "text": "τοῦτο γὰρ ἀποίκιλόν ἐστι.", "seq": 2481}
{"id": "David_Passim_2482", "series": "CAG", "text": "τί δέ ἐστι τὸ θεολογικώτερον καὶ τί τὸ διαλεκτικώτερον;", "seq": 2482}
{"id": "David_Passim_2483", "series": "CAG", "text": "θεολογικώτερόν ἐστιν, ὅταν ζητῶμεν εἰ ἀίδιόν ἐστιν ἢ ἐν γενέσει καὶ φθορᾷ, εἰ ἀμέσως τούτων ὁ θεὸς τὴν δημιουργίαν ποιεῖται ἢ διὰ μέσου τῆς φύσεως.", "seq": 2483}
{"id": "David_Passim_2484", "series": "CAG", "text": "διαλεκτικώτερον δέ ἐστιν, ὅταν ζητῶμεν εἰ ὁμώνυμοί εἰσι φωναί, καὶ εἰ πολλὰ σημαινόμενα ἔχουσιν, εἰ <αἱ> αὐταί εἰσι ταῖς κατὰ συνήθειαν.", "seq": 2484}
{"id": "David_Passim_2485", "series": "CAG", "text": "τοῦτο οὖν φησιν ὁ Πορφύριος·", "seq": 2485}
{"id": "David_Passim_2486", "series": "CAG", "text": "θεολογικῶς περὶ αὐτῶν οὐ διαλαμβάνω (τοῦτο γὰρ οἰκεῖον Πλάτωνος), ἀλλὰ διαλεκτικῶς.", "seq": 2486}
{"id": "David_Passim_2487", "series": "CAG", "text": "τὸ δὲ διαλεκτικῶς λογικώτερον ἐκάλεσεν, ἐπειδὴ τῆς λογικῆς ἐστιν ἡ διαλεκτική.", "seq": 2487}
{"id": "David_Passim_2488", "series": "CAG", "text": "1.", "seq": 2488}
{"id": "David_Passim_2489", "series": "CAG", "text": "15 Μάλιστα οἱ ἐκ τοῦ περιπάτου.", "seq": 2489}
{"id": "David_Passim_2490", "series": "CAG", "text": "Διὰ τί ἄρα τῶν Περιπατητικῶν ἐμνήσθη;", "seq": 2490}
{"id": "David_Passim_2491", "series": "CAG", "text": "φασί τινες ὅτι οἱ Περιπατητικοὶ εἰς τὴν διαλεκτικὴν ὀξυτέρως ἐκινοῦντο·", "seq": 2491}
{"id": "David_Passim_2492", "series": "CAG", "text": "θέλων οὖν ταὐτὸν ποιῆσαι, ἐμνήσατο αὐτῶν.", "seq": 2492}
{"id": "David_Passim_2493", "series": "CAG", "text": "ἄλλοι δέ φασιν, ἐπειδὴ ἀπὸ ὑπολήψεως Πλατωνικὸς ἐλέγετο, ἠβούλετο ἑαυτὸν δεῖξαι Ἀριστοτέλει παρακολουθοῦντα, ὅπερ ἐν τοῖς συγγράμμασιν ἐβουλήθη δεῖξαι.", "seq": 2493}
{"id": "David_Passim_2494", "series": "CAG", "text": "ἄξιον δὲ ζητήσεως ὑπάρχει διὰ τί Περιπατητικοὶ καλοῦνται οἱ Ἀριστοτελικοί·", "seq": 2494}
{"id": "David_Passim_2495", "series": "CAG", "text": "φασὶν ὅτι διὰ τοῦτο Περιπατητικὸς ἐκαλεῖτο ὁ Ἀριστοτέλης, ἐπειδὴ περιπατῶν τὰς συνουσίας ἐποιεῖτο τῇ πρὸς τὸν διδάσκαλον αἰδοῖ.", "seq": 2495}
{"id": "David_Passim_2496", "series": "CAG", "text": "οὐκ ἐτόλμα γὰρ Πλάτωνος περιιόντος ἐν καθέδρᾳ ποιεῖσθαι τὰς συνουσίας.", "seq": 2496}
{"id": "David_Passim_2497", "series": "CAG", "text": "ἄλλοι δέ φασιν ὅτι ψευδές ἐστι·", "seq": 2497}
{"id": "David_Passim_2498", "series": "CAG", "text": "τοὐναντίον γὰρ ἠναντιοῦτο αὐτῷ.", "seq": 2498}
{"id": "David_Passim_2499", "series": "CAG", "text": "τολμῶσι δὲ οἱ τοιοῦτοι ψέγειν·", "seq": 2499}
{"id": "David_Passim_2500", "series": "CAG", "text": "οὐδὲ γὰρ ἠναντιοῦτο αὐτῷ, ἀλλ᾿ ἔσεβεν αὐτὸν ἀεί, ὡς δηλοῖ τὸ εἰς τὸν τάφον Πλάτωνος Ἀριστοτέλους ἐπίγραμμα", "seq": 2500}
{"id": "David_Passim_2501", "series": "CAG", "text": "βωμὸν Ἀριστοτέλης ἱδρύσατο τόνδε Πλάτωνος, ἀνδρὸς ὃν οὐδ᾿ αἰνεῖν τοῖσι κακοῖσι θέμις.", "seq": 2501}
{"id": "David_Passim_2502", "series": "CAG", "text": "ἐν οἷς σὺν θεῷ ἡ θεωρία.", "seq": 2502}
{"id": "David_Passim_2503", "series": "CAG", "text": "Πρᾶξις θ΄.", "seq": 2503}
{"id": "David_Passim_2504", "series": "CAG", "text": "Περὶ γένους.", "seq": 2504}
{"id": "David_Passim_2505", "series": "CAG", "text": "Μετὰ τὰ διττὰ προοίμια τοῦ τε φιλοσόφου καὶ ἡμῶν σὺν εὐμενείᾳ τοῦ κρείττονος ἐπ᾿ αὐτοὺς τοὺς ἀγῶνας τῆς λέξεως χωρήσωμεν ἔχοντες πάντων προηγουμένην τὴν τοῦ γένους διδασκαλίαν.", "seq": 2505}
{"id": "David_Passim_2506", "series": "CAG", "text": "ζητητέον δὲ διὰ τί τὸ γένος τῶν πέντε φωνῶν προετάγη.", "seq": 2506}
{"id": "David_Passim_2507", "series": "CAG", "text": "τινὲς γοῦν ὑπὲρ τούτου ἀπολογούμενοί φασιν ὅτι ἐπειδὴ τὸ γένος τίμιόν ἐστι καὶ ἅμα ἑαυτῷ συνεισφέρει τὰς ἄλλας φωνάς·", "seq": 2507}
{"id": "David_Passim_2508", "series": "CAG", "text": "λέγων γὰρ γένος συνεισφέρεις τὸ εἶδος (τὸ γὰρ γένος εἴδους ἐστὶ γένος), ὅπου δὲ γένος καὶ εἶδος, ἐκεῖ πάντως ἐστὶ καὶ διαφορά (τὸ γὰρ εἶδος ἀπὸ γένους τέμνεται διὰ μέσου διαφορᾶς δίκην πρίονος ἐπεχούσης), ὅπου δὲ εἶδος, ἐκεῖ καὶ ἴδιον (τὸ γὰρ ἴδιον ἐν τοῖς εἴδεσι θεωρεῖται, ὡς τὸ γελαστικὸν ἐν τῷ ἀνθρώπῳ, τὸ χρεμετιστικὸν ἐν τῷ ἵππῳ), ἀλλὰ μὴν καὶ συμβεβηκός·", "seq": 2508}
{"id": "David_Passim_2509", "series": "CAG", "text": "τὸ γὰρ συμβεβηκὸς ἐν τοῖς ἀτόμοις θεωρεῖται καὶ τὰ ἄτομα διακρίνει·", "seq": 2509}
{"id": "David_Passim_2510", "series": "CAG", "text": "οὐσίᾳ γὰρ οὐ διακρίνεται τὰ ἄτομα, ἀλλὰ συμβεβηκόσιν·", "seq": 2510}
{"id": "David_Passim_2511", "series": "CAG", "text": "οὐ γὰρ διαφέρει ὁ Σωκράτης Πλάτωνος, καθὸ ἄνθρωποί εἰσιν, ἀλλὰ καθὸ ὁ μὲν φαλακρὸς ὁ δὲ εὔθριξ, ὁ μὲν προκοίλιος ὁ δὲ ἰσχνός·", "seq": 2511}
{"id": "David_Passim_2512", "series": "CAG", "text": "τὰ οὖν ἄτομα ὑπὸ τὸ εἶδος ἀνάγεται, ὧν ἐστι τὰ συμβεβηκότα.", "seq": 2512}
{"id": "David_Passim_2513", "series": "CAG", "text": "ὁ τοιοῦτος δὲ λόγος συνηγορεῖ καὶ τὸ εἶδος τῶν ἄλλων φωνῶν προτάττεσθαι·", "seq": 2513}
{"id": "David_Passim_2514", "series": "CAG", "text": "δύναμαι γὰρ λέγειν ὅτι καὶ τὸ εἶδος συνεισφέρει τὰς ἄλλας τέσσαρας φωνάς·", "seq": 2514}
{"id": "David_Passim_2515", "series": "CAG", "text": "ὅπου γὰρ εἶδος, ἐκεῖ πάντως καὶ γένος (τὸ γὰρ εἶδος γένους ἐστὶν εἶδος), ὅπου δὲ γένος καὶ εἶδος, ἐκεῖ καὶ διαφορά.", "seq": 2515}
{"id": "David_Passim_2516", "series": "CAG", "text": "ἐν δὲ τοῖς εἴδεσίν ἐστι καὶ τὸ ἴδιον, ὡς ἐδείξαμεν.", "seq": 2516}
{"id": "David_Passim_2517", "series": "CAG", "text": "ἀλλὰ μὴν καὶ ἐν τοῖς ἀτόμοις ἐστὶ τὰ συμβεβηκότα, ὧν κατηγορεῖται τὸ εἶδος.", "seq": 2517}
{"id": "David_Passim_2518", "series": "CAG", "text": "τί δὲ λέγω ταῦτα ἐπὶ τοῦ εἴδους;", "seq": 2518}
{"id": "David_Passim_2519", "series": "CAG", "text": "τῷ προκειμένῳ λόγῳ προταχθήσεται ἡ ὑστέρα φωνὴ ἡ κινδυνεύουσα μὴ εἶναι διὰ τὴν εὐτέλειαν, λέγω δὲ τὸ συμβεβηκός·", "seq": 2519}
{"id": "David_Passim_2520", "series": "CAG", "text": "αὕτη γὰρ καὶ τὰς ἄλλας τέσσαρας συνεισφέρει·", "seq": 2520}
{"id": "David_Passim_2521", "series": "CAG", "text": "λέγομεν γὰρ τὰ συμβεβηκότα τῶν ἀτόμων τὴν διάκρισιν ποιεῖσθαι, τὰ δὲ ἄτομα συνεισφέρει τὸ εἶδος (τῶν γὰρ ἀτόμων κατηγορεῖται τὸ εἶδος), ὅπου δὲ γένος καὶ εἶδος, ἐκεῖ καὶ διαφορὰ ἀναμφιβόλως, τὸ δὲ ἴδιον ἐν τοῖς εἴδεσιν ὑπάρχει.", "seq": 2521}
{"id": "David_Passim_2522", "series": "CAG", "text": "ὥστε οὖν ὑπόψυχρός ἐστιν ὁ τοιοῦτος λόγος·", "seq": 2522}
{"id": "David_Passim_2523", "series": "CAG", "text": "οὐ γὰρ κατὰ τοῦτον τὸν λόγον προετάγη τὸ γένος, ἀλλὰ καθ᾿ ἕτερον.", "seq": 2523}
{"id": "David_Passim_2524", "series": "CAG", "text": "ποῖον δὲ τοῦτον λέξομεν;", "seq": 2524}
{"id": "David_Passim_2525", "series": "CAG", "text": "τὸ γένος δικαίως τῶν ἄλλων προετάγη κατ᾿ ἄμφω φέρον τὰ πρωτεῖα·", "seq": 2525}
{"id": "David_Passim_2526", "series": "CAG", "text": "τίμιον γὰρ καὶ τῶν οὐσιωδῶν ὑπάρχει καὶ τῶν ἐπουσιωδῶν.", "seq": 2526}
{"id": "David_Passim_2527", "series": "CAG", "text": "καὶ τῶν μὲν ἐπουσιωδῶν τίμιον ὑπάρχει ὡς οὐσιῶδες, λέγω δὲ ἰδίου καὶ συμβεβηκότος, τῶν δὲ οὐσιωδῶν ὡς καθολικώτερον·", "seq": 2527}
{"id": "David_Passim_2528", "series": "CAG", "text": "καθολικώτερον γὰρ τὸ γένος τῆς τε διαφορᾶς καὶ τοῦ εἴδους.", "seq": 2528}
{"id": "David_Passim_2529", "series": "CAG", "text": "Ἐπεὶ οὖν ἐγνώκαμεν οὐ κατὰ ἀδικίαν προτετάχθαι τὸ γένος, φέρε ἐπ᾿ αὐτὴν τὴν ἐξήγησιν βαδίζωμεν.", "seq": 2529}
{"id": "David_Passim_2530", "series": "CAG", "text": "ἀλλ᾿ ἐμπόδιον ταύτης τῆς ὁδοῦ πέφυκεν Ἀριστοτέλης φάσκων ἐν τοῖς Ἀποδεικτικοῖς δεῖν τὸν περὶ ὁμωνύμων φωνῶν διαλαμβάνοντα πρὸ τῆς τούτων ἐξηγήσεως τὰ τρία ταῦτα ποιῆσαι·", "seq": 2530}
{"id": "David_Passim_2531", "series": "CAG", "text": "πρῶτον διαστείλασθαι τὴν ὁμωνυμίαν καὶ εἰπεῖν ποσαχῶς λαμβάνεται ἡ προκειμένη φωνή, δεύτερον εἰπεῖν περὶ ποίου σημαινομένου ἐστὶν ὁ λόγος, τρίτον τὴν περὶ τούτου ἐμφανίσαι διδασκαλίαν·", "seq": 2531}
{"id": "David_Passim_2532", "series": "CAG", "text": "τῷ γὰρ μὴ ταῦτα ποιοῦντί φησιν οὐκ ὀλίγα ἄτοπα παρακολουθεῖν·", "seq": 2532}
{"id": "David_Passim_2533", "series": "CAG", "text": "δόξει γὰρ καὶ ἀνόητα διαφθέγγεσθαι καὶ ψεύδεσθαι καὶ τὸ κοινωνικὸν διαφθείρειν, καθ᾿ ὃ χαρακτηρίζεται τὸ ἡμέτερον εἶδος.", "seq": 2533}
{"id": "David_Passim_2534", "series": "CAG", "text": "δόξει δὲ ἀνοηταίνειν, εἰ εἴπῃ ὅτι εἴωθεν ἡμῖν ὁ κύων νοσήματα προσφέρειν, νομίσῃ δέ τις αὐτὸν τὸν χερσαῖον κύνα λέγειν, ὅπερ οὐ διενοήθη·", "seq": 2534}
{"id": "David_Passim_2535", "series": "CAG", "text": "τὸν ἀστρῷον γὰρ ἠβούλετο εἰπεῖν.", "seq": 2535}
{"id": "David_Passim_2536", "series": "CAG", "text": "δόξει δὲ ψεύδεσθαι λέγων τὸν Αἴαντα νενικηκέναι τὸν Ἕκτορα·", "seq": 2536}
{"id": "David_Passim_2537", "series": "CAG", "text": "οἰήσεται γάρ τις αὐτὸν τὸν Ὀιλέως λέγειν καὶ ψεύστην αὐτὸν προσαγορεύσει.", "seq": 2537}
{"id": "David_Passim_2538", "series": "CAG", "text": "διαφθερεῖ δὲ τὸ κοινωνικόν, λέγω δὲ τὸν λόγον καθ᾿ ὃν μόνοι κοινωνοῦμεν (οὔτε γὰρ αἱ κάτω οὐσίαι οὔτε αἱ ὑπέρτεραι κατὰ τοῦτον κοινωνοῦσιν, αἱ μὲν διὰ τὸ μὴ δύνασθαι, λέγω δὲ τὰ ἄλογα, αἱ δὲ διὰ τὸ μὴ δέεσθαι, λέγω δὲ τὰ θεῖα)·", "seq": 2538}
{"id": "David_Passim_2539", "series": "CAG", "text": "ὅταν γὰρ περὶ ὁμωνύμων λέγῃ τις ἑτέρου μὴ νοοῦντος περὶ ποίου σημαινομένου λέγει, διαφθαρήσεται τὸ κοινωνικόν·", "seq": 2539}
{"id": "David_Passim_2540", "series": "CAG", "text": "πῶς γὰρ κοινωνία τοῦ ἔνδον γενήσεται ἀσαφείας ἐπικρατούσης τῶν λεγομένων;", "seq": 2540}
{"id": "David_Passim_2541", "series": "CAG", "text": "ὥσπερ γὰρ οὐκ ἔστι συμβαλεῖν Χαλδαίους Αἰγυπτίοις μετὰ σαφηνείας τῶν λεγομένων, οὕτως οὐδὲ τοὺς περὶ ὁμωνύμων φθεγγομένους, καὶ εἰ δόξομεν ἀληθεύειν.", "seq": 2541}
{"id": "David_Passim_2542", "series": "CAG", "text": "ὀφείλομεν τοίνυν διαστείλασθαι τὰ ὁμώνυμα πρὸς ἀναίρεσιν τῆς ἀμφιβολίας·", "seq": 2542}
{"id": "David_Passim_2543", "series": "CAG", "text": "δόξεις γὰρ ἀληθεύειν λέγων στρατεύσασθαι ἐπὶ Ἴλιον τὸν Αἴαντα (ἑκάτερος γὰρ ἐστράτευσεν), ἀμφιβολίαν δὲ ἐπιθήσεις τοῖς λεγομένοις·", "seq": 2543}
{"id": "David_Passim_2544", "series": "CAG", "text": "ἄδηλον γὰρ εἰ τὸν Ὀιλέως βούλει εἰπεῖν ἢ τὸν Τελαμῶνος.", "seq": 2544}
{"id": "David_Passim_2545", "series": "CAG", "text": "Τούτῳ οὖν τῷ λόγῳ παρακολουθῶν Πορφύριος τὴν ὁμωνυμίαν βούλεται διαστείλασθαι (ὁμώνυμος γὰρ φωνὴ λέγεται τὸ γένος)·", "seq": 2545}
{"id": "David_Passim_2546", "series": "CAG", "text": "λέγει γὰρ περὶ ποίου σημαινομένου λέγει, καὶ εἶθ᾿ οὕτως τὴν τούτου διδασκαλίαν ἐπάγει.", "seq": 2546}
{"id": "David_Passim_2547", "series": "CAG", "text": "καί φησιν ὅτι πρῶτον γένος ἐστὶ τὸ ἀφ᾿ ἑνὸς παρονομασθὲν καὶ προελθόν, οἷον ἀπὸ ἑνὸς τοῦ Ἡρακλέους οἱ Ἡρακλεῖδαι παρωνομάσθησαν καὶ προῆλθον ἐκ τοῦ Ἡρακλέους.", "seq": 2547}
{"id": "David_Passim_2548", "series": "CAG", "text": "καλῶς δὲ πρόσκειται τὸ προελθόν·", "seq": 2548}
{"id": "David_Passim_2549", "series": "CAG", "text": "ἔστι γάρ τινα ἀφ᾿ ἑνὸς παρονομασθέντα καὶ μὴ καλούμενα γένη, καθὸ οὐ προῆλθον ἐξ αὐτοῦ, οἷον ἐκ τοῦ Πυθαγόρα παρωνομάσθησάν τινες Πυθαγόρειοι, γένος δὲ τὸ τοιοῦτον οὐκ ἔστι, καθὸ οὐ προῆλθεν ἐξ αὐτοῦ.", "seq": 2549}
{"id": "David_Passim_2550", "series": "CAG", "text": "ἔχει δὲ τὸ τοιοῦτον γένος τρεῖς σχέσεις·", "seq": 2550}
{"id": "David_Passim_2551", "series": "CAG", "text": "τὴν μὲν μίαν τὴν ἀπὸ τοῦ Ἡρακλέους πρὸς τὸ ἐξ αὐτοῦ πλῆθος, τὴν δὲ ἑτέραν τὴν ἀπὸ τοῦ πλήθους πρὸς τὸν Ἡρακλέα, καὶ τὴν ἄλλην ἣν ἔχει τὸ πλῆθος πρὸς ἑαυτούς.", "seq": 2551}
{"id": "David_Passim_2552", "series": "CAG", "text": "δεύτερον δὲ γένος ἐστὶν ἡ ἑκάστου τῆς γενέσεως ἀρχὴ οἷον ἡ πατρίς.", "seq": 2552}
{"id": "David_Passim_2553", "series": "CAG", "text": "ἀλλὰ τὸ τοιοῦτον γένος διττόν, τὸ μὲν ἔμψυχον τὸ δὲ ἄψυχον.", "seq": 2553}
{"id": "David_Passim_2554", "series": "CAG", "text": "καὶ ἑκάτερον πάλιν διττόν·", "seq": 2554}
{"id": "David_Passim_2555", "series": "CAG", "text": "τὸ μὲν γὰρ προσεχές ἐστι τὸ δὲ πόρρω.", "seq": 2555}
{"id": "David_Passim_2556", "series": "CAG", "text": "ἐπὶ ἑνὸς δὲ παραδείγματος σαφηνίσωμεν τὰ προειρημένα.", "seq": 2556}
{"id": "David_Passim_2557", "series": "CAG", "text": "ὁ Ἀχιλλεὺς ἄψυχον καὶ προσεχὲς ἔχει τὸ γένος ἀπὸ πατρίδος, ὅταν εἴπῃς αὐτὸν Φθιώτην, ἄψυχον δὲ πόρρω, ὅταν εἴπῃς αὐτὸν Θετταλόν, ἔμψυχον δὲ προσεχές, ὅταν εἴπῃς αὐτὸν ἀπὸ τοῦ Πηλέως, ἔμψυχον δὲ πόρρω, ὅταν εἴπῃς αὐτὸν ἀπὸ τοῦ Αἰακοῦ.", "seq": 2557}
{"id": "David_Passim_2558", "series": "CAG", "text": "καὶ διὰ τί τὸν πατέρα γένος λέγομεν;", "seq": 2558}
{"id": "David_Passim_2559", "series": "CAG", "text": "δικαίως, εἴ γε αὐτὸν γονέα καλοῦμεν ἀφ᾿ οὗ ἡ γονὴ καὶ τὸ γένος.", "seq": 2559}
{"id": "David_Passim_2560", "series": "CAG", "text": "εἰκὸς δέ τινας εἰπεῖν διὰ τί καὶ ἀπὸ τῆς μητρὸς οὐκ ἔχει τις.", "seq": 2560}
{"id": "David_Passim_2561", "series": "CAG", "text": "καί φαμεν ὅτι ἀπὸ τοῦ τιμιωτέρου μᾶλλον ἔοικε τὸ γένος προέρχεσθαι, τιμιώτερος δὲ τῆς μητρὸς ὁ πατήρ.", "seq": 2561}
{"id": "David_Passim_2562", "series": "CAG", "text": "ἴσως δὲ πάλιν εἴποι τις διὰ τί καὶ τὴν πατρίδα γένος λέγομεν.", "seq": 2562}
{"id": "David_Passim_2563", "series": "CAG", "text": "πρὸς ὃν λέξομεν ὅτι εὐλόγως, εἴ γε δηλοῖ τὸ ὄνομα ἀπὸ τοῦ πατρὸς παραχθέν·", "seq": 2563}
{"id": "David_Passim_2564", "series": "CAG", "text": "εἰ γάρ φαμεν τὸν πατέρα γένος, παρωνομάσθη δὲ ἀπ᾿ αὐτοῦ ἡ πατρίς, διὰ τί καὶ ἡ πατρὶς μὴ λεχθείη γένος;", "seq": 2564}
{"id": "David_Passim_2565", "series": "CAG", "text": "μὴ νομίσῃς δὲ ὅτι ἔλαττον γένος ἐστὶ ἡ πατρὶς τοῦ πατρός, ἐπειδὴ ἀπὸ τοῦ πατρὸς ὠνομάσθη·", "seq": 2565}
{"id": "David_Passim_2566", "series": "CAG", "text": "εἰ γὰρ καὶ ἀπ᾿ αὐτοῦ παρήχθη, ἀλλ᾿ οὖν γε κρεῖττόν ἐστι γένος τοῦ πατρός·", "seq": 2566}
{"id": "David_Passim_2567", "series": "CAG", "text": "αὕτη γάρ ἐστιν ἡ χρηστὰ ἤθη καὶ εὐσεβεῖς νόμους ἡμᾶς διδάσκουσα.", "seq": 2567}
{"id": "David_Passim_2568", "series": "CAG", "text": "ἀμέλει οἱ σωματέμποροι οὐκ ἀπὸ τῶν τυχουσῶν χωρῶν ποιοῦνται τὴν πραγματείαν·", "seq": 2568}
{"id": "David_Passim_2569", "series": "CAG", "text": "πρῶτον γὰρ ἐξετάζουσι τὰς χώρας τῶν σωμάτων οἷαί εἰσιν, οἰόμενοι αὐτὰς ἀσφαλὲς εἶναι κριτήριον ἠθῶν τε καὶ νόμων.", "seq": 2569}
{"id": "David_Passim_2570", "series": "CAG", "text": "δηλοῖ δὲ καὶ αὐτὸς ὁ ποιητὴς προτιμᾶσθαι τῶν γονέων τὰς χώρας, πανταχοῦ προτάττων τῶν γονέων τὰς πατρίδας καὶ πάντων πραγμάτων γλυκυτέρας εἶναι διδάσκων·", "seq": 2570}
{"id": "David_Passim_2571", "series": "CAG", "text": "τίς πόθεν εἶς ἀνδρῶν;", "seq": 2571}
{"id": "David_Passim_2572", "series": "CAG", "text": "πόθι τοι πόλις ἠδὲ τοκῆες;", "seq": 2572}
{"id": "David_Passim_2573", "series": "CAG", "text": "ὧς οὐδὲν γλύκιον ἧς πατρίδος οὐδὲ τοκήων.", "seq": 2573}
{"id": "David_Passim_2574", "series": "CAG", "text": "αὐτὰρ Ὀδυσσεύς, ἱέμενος καὶ καπνὸν ἀποθρώσκοντα νοῆσαι ἧς γαίης, θανέειν ἱμείρεται.", "seq": 2574}
{"id": "David_Passim_2575", "series": "CAG", "text": "τρίτον δὲ γένος λέγεται τὸ κατὰ φιλοσοφίαν ἐπὶ πολλὰ ἐξαπλούμενον ὥσπερ τὸ ζῷον·", "seq": 2575}
{"id": "David_Passim_2576", "series": "CAG", "text": "τοῦτο γὰρ ἐξαπλοῦται ἐπὶ πολλά·", "seq": 2576}
{"id": "David_Passim_2577", "series": "CAG", "text": "διήκει γὰρ ἐπὶ ἄνθρωπον καὶ κύνα καὶ ἄλλα.", "seq": 2577}
{"id": "David_Passim_2578", "series": "CAG", "text": "ἔοικε δὲ τοῦτο τοῖς δύο τοῖς προηγουμένοις.", "seq": 2578}
{"id": "David_Passim_2579", "series": "CAG", "text": "καὶ τῷ μὲν λέγοντι ‘τὸ ἀφ᾿ ἑνὸς παρονομασθὲν καὶ προελθόν’ ἔοικε, καθὸ πολλὰ περιέχει ἐν ἑαυτῷ·", "seq": 2579}
{"id": "David_Passim_2580", "series": "CAG", "text": "ὥσπερ γὰρ ὁ Ἡρακλῆς ἅπαν τὸ ὑπ᾿ αὐτὸν γένος περιέχει, οὕτω καὶ τὸ ζῷον πάντα τὰ ὑπ᾿ αὐτὸ περιέχει.", "seq": 2580}
{"id": "David_Passim_2581", "series": "CAG", "text": "τῷ δὲ λέγοντι ‘ἡ ἑκάστου τῆς γενέσεως ἀρχή’ ἔοικεν, ὅτι ὥσπερ ὁ πατὴρ ἀρχή ἐστι τοῦ γένους ὁμοίως δὲ καὶ ἡ πατρίς, οὕτω καὶ τὸ ζῷον ἀρχή ἐστι τῶν ὑπ᾿ αὐτό.", "seq": 2581}
{"id": "David_Passim_2582", "series": "CAG", "text": "Ἓν δὲ λοιπὸν ζητήσαντες ἐπ᾿ αὐτῷ καταπαύσομεν τὴν παροῦσαν θεωρίαν·", "seq": 2582}
{"id": "David_Passim_2583", "series": "CAG", "text": "καταβοῶσί τινες Πορφυρίου λέγοντες ὅτι οὐκ ἐπεξῆλθε πᾶσι τοῖς γένεσι·", "seq": 2583}
{"id": "David_Passim_2584", "series": "CAG", "text": "παρῆκε γὰρ τὰ πέντε γένη τοῦ Πλάτωνος·", "seq": 2584}
{"id": "David_Passim_2585", "series": "CAG", "text": "φησὶ γὰρ ὁ Πλάτων πέντε γένη εἶναι πάντων τῶν ὄντων, οὐσίαν ταυτότητα ἑτερότητα κίνησιν στάσιν.", "seq": 2585}
{"id": "David_Passim_2586", "series": "CAG", "text": "καὶ οὐσίαν μὲν ἔλεγε τὴν ὕπαρξιν ἑνὸς ἑκάστου·", "seq": 2586}
{"id": "David_Passim_2587", "series": "CAG", "text": "ἔλεγε γάρ·", "seq": 2587}
{"id": "David_Passim_2588", "series": "CAG", "text": "εἰ ὄντα ἔστι, πάντως ἔχει καὶ ὕπαρξιν.", "seq": 2588}
{"id": "David_Passim_2589", "series": "CAG", "text": "ἐπειδὴ οὖν ἐν πολλοῖς ἐστιν ἡ ὕπαρξις, ἔλεγεν αὐτὴν γένος.", "seq": 2589}
{"id": "David_Passim_2590", "series": "CAG", "text": "ταυτότητα δὲ καὶ ἑτερότητα ἔλεγε τὴν κοινωνίαν καὶ τὴν διαφορὰν ἑνὸς ἑκάστου·", "seq": 2590}
{"id": "David_Passim_2591", "series": "CAG", "text": "ἔλεγε γὰρ πάντα τὰ ὄντα κατά τι πρὸς ἄλληλα κοινωνεῖν καὶ κατά τι διαφέρειν ἀδύνατον γὰρ πάντῃ τὰ πάντα κοινωνεῖν ἢ πάντῃ διαφέρειν.", "seq": 2591}
{"id": "David_Passim_2592", "series": "CAG", "text": "τὴν μὲν οὖν ταυτότητα κοινωνίαν ἔλεγε τὴν δὲ ἑτερότητα διαφοράν.", "seq": 2592}
{"id": "David_Passim_2593", "series": "CAG", "text": "ἐπειδὴ οὖν ἐν πολλοῖς ἐστι κοινωνία καὶ διαφορά, γένη αὐτὰ ὠνόμαζε.", "seq": 2593}
{"id": "David_Passim_2594", "series": "CAG", "text": "κίνησιν δὲ τὴν ἐνέργειαν ἔλεγε·", "seq": 2594}
{"id": "David_Passim_2595", "series": "CAG", "text": "πάντα γὰρ τὰ ὄντα ἀπὸ τῆς φύσεως ἐδημιουργήθη.", "seq": 2595}
{"id": "David_Passim_2596", "series": "CAG", "text": "εἰ οὖν μηδὲν μάτην ἡ φύσις ἐδημιούργησε, δῆλον ὅτι πάντα τὰ ὄντα ἔχει ἐνέργειάν τινα.", "seq": 2596}
{"id": "David_Passim_2597", "series": "CAG", "text": "ταύτην οὖν τὴν ἐν πᾶσιν ὑπάρχουσαν ἐνέργειαν ἐκάλει κίνησιν.", "seq": 2597}
{"id": "David_Passim_2598", "series": "CAG", "text": "στάσιν δὲ ἔλεγε τὴν ἠρεμίαν·", "seq": 2598}
{"id": "David_Passim_2599", "series": "CAG", "text": "ἔλεγε γὰρ ὅτι ὅπου ἐστὶν ἐνέργεια, πάντως ἐστὶν ἐκεῖ καὶ ἠρεμία·", "seq": 2599}
{"id": "David_Passim_2600", "series": "CAG", "text": "ἀδύνατον γάρ ἐστιν ἀεὶ καὶ ὡσαύτως ἐνεργεῖν τινα, ἀλλὰ μὴν καὶ τὰ θεῖα, ἅπερ φαμὲν ἀεὶ ἐνεργεῖν, ἐν τῷ ἀεὶ ἐνεργεῖν ἔχει καί τινα ἠρεμίαν·", "seq": 2600}
{"id": "David_Passim_2601", "series": "CAG", "text": "τὸ γὰρ ἀεὶ ἐν τῷ αὐτῷ ἐνεργεῖν στάσιν καὶ μονήν τινα δηλοῖ.", "seq": 2601}
{"id": "David_Passim_2602", "series": "CAG", "text": "καὶ ὁ πόλος ὁ ἀεὶ κινούμενος ἐν τῇ ἀεικινησίᾳ μονήν τινα ἔχει.", "seq": 2602}
{"id": "David_Passim_2603", "series": "CAG", "text": "ταῦτα οὖν, φασί, παρῆκεν ὁ Πορφύριος.", "seq": 2603}
{"id": "David_Passim_2604", "series": "CAG", "text": "οὐ μόνον δὲ ταῦτα, ἀλλὰ καὶ ἕτερά τινα·", "seq": 2604}
{"id": "David_Passim_2605", "series": "CAG", "text": "λέγουσι γὰρ ὅτι ἐν τοῖς Φυσικοῖς φησιν ὁ Ἀριστοτέλης γένος εἶναι τὴν ὕλην, τούτου δὲ οὐκ ἐμνήσθη.", "seq": 2605}
{"id": "David_Passim_2606", "series": "CAG", "text": "ἀλλὰ μὴν καὶ τῶν παρὰ τοῖς γραμματικοῖς γενῶν οὐκ ἐμνήσθη, τοῦτ᾿ ἔστιν ἀρσενικοῦ θηλυκοῦ οὐδετέρου.", "seq": 2606}
{"id": "David_Passim_2607", "series": "CAG", "text": "καὶ λέγομεν ὅτι οὐ καλῶς μέμφονται Πορφυρίῳ ἐάσαντι τὰ τοιαῦτα·", "seq": 2607}
{"id": "David_Passim_2608", "series": "CAG", "text": "οὔτε γὰρ προέκειτο αὐτῷ θεολογῆσαι, ἵνα μνησθῇ τῶν πέντε γενῶν Πλάτωνος (καὶ γὰρ Πλάτων θεολογῆσαι βουλόμενος τούτων ἐμνήσθη), ἀλλὰ μὴν οὔτε φυσιολογῆσαι αὐτῷ προέκειτο, ἵνα μνησθῇ τοῦ γένους τῆς ὕλης.", "seq": 2608}
{"id": "David_Passim_2609", "series": "CAG", "text": "διαλεκτικώτερον οὖν βουλόμενος διαλαβεῖν μᾶλλον τοῖς λεχθεῖσιν ἠρκέσθη διαχωρίζων τὰ κατὰ συνήθειαν τῶν κατὰ φιλοσοφίαν.", "seq": 2609}
{"id": "David_Passim_2610", "series": "CAG", "text": "τί δὲ εἶχε τῶν παρὰ τοῖς γραμματικοῖς μνησθῆναι, οἷς αἱ φωναὶ φίλαι καθεστήκασι μόναι, οὐδαμῶς δὲ τὰ σημαινόμενα;", "seq": 2610}
{"id": "David_Passim_2611", "series": "CAG", "text": "παρ᾿ οἷς ἔστιν εὑρεῖν οὐδέτερα καὶ ἀρρενικὰ καὶ θηλυκὰ ἔμψυχά τε καὶ ἄψυχα, ἀλλὰ μὴν καὶ ἀρρενικὰ καὶ θηλυκὰ μόνον, μόνον ἀρρενικὰ ὥσπερ τὸ ἀετὸς καὶ μόνον θηλυκὰ ὥσπερ τὸ χελιδών, ἅτινα ἐπίκοινα καλοῦσι.", "seq": 2611}
{"id": "David_Passim_2612", "series": "CAG", "text": "δικαίως ἄρα καὶ τῶν τοιούτων ὁ φιλόσοφος οὐκ ἐμνήσατο.", "seq": 2612}
{"id": "David_Passim_2613", "series": "CAG", "text": "ἐφ᾿ οἷς ἡ παροῦσα θεωρία πληρούσθω.", "seq": 2613}
{"id": "David_Passim_2614", "series": "CAG", "text": "Πρᾶξις ι΄.", "seq": 2614}
{"id": "David_Passim_2615", "series": "CAG", "text": "1.", "seq": 2615}
{"id": "David_Passim_2616", "series": "CAG", "text": "18 Ἔοικε δὲ μήτε τὸ γένος μήτε τὸ εἶδος ἁπλῶς λέγεσθαι.", "seq": 2616}
{"id": "David_Passim_2617", "series": "CAG", "text": "Ἐπειδήπερ εἰσί τινες φωναὶ μίαν ἔχουσαι σημασίαν, εἰσὶ δὲ ἄλλαι πολλὰ σημαίνουσαι, φησὶν ὅτι τὸ γένος οὐ μίαν ἔχει σημασίαν, ἀλλὰ πολλάς·", "seq": 2617}
{"id": "David_Passim_2618", "series": "CAG", "text": "τοῦτο γὰρ δηλοῖ τὸ ἁπλῶς.", "seq": 2618}
{"id": "David_Passim_2619", "series": "CAG", "text": "τὸ δὲ ἁπλῶς τετραχῶς λαμβάνεται·", "seq": 2619}
{"id": "David_Passim_2620", "series": "CAG", "text": "λαμβάνεται γὰρ κυρίως καὶ ὡς καθόλου καὶ ὡς ἔτυχε καὶ ἀντὶ τοῦ μοναχὸν καὶ ἀποίκιλον·", "seq": 2620}
{"id": "David_Passim_2621", "series": "CAG", "text": "τοῦτο γὰρ αὐτό φησι καὶ ὁ τραγικὸς", "seq": 2621}
{"id": "David_Passim_2622", "series": "CAG", "text": "ἁπλοῦς ὁ μῦθος τῆς ἀληθείας ἔφυ.", "seq": 2622}
{"id": "David_Passim_2623", "series": "CAG", "text": "τὸ δὲ ἔοικε τριχῶς·", "seq": 2623}
{"id": "David_Passim_2624", "series": "CAG", "text": "πῇ μὲν ἐπὶ τοῦ πρέποντος, πῇ δὲ ἐπὶ τοῦ ὁμοιωθῆναι, ποτὲ δὲ ἀντὶ τοῦ φαίνεται.", "seq": 2624}
{"id": "David_Passim_2625", "series": "CAG", "text": "ἐνταῦθα ἀντὶ τοῦ φαίνεται κεῖται·", "seq": 2625}
{"id": "David_Passim_2626", "series": "CAG", "text": "φαίνεται δὲ μήτε τὸ γένος μήτε τὸ εἶδος μοναχῶς καὶ ἀποικίλως λέγεσθαι, ἀλλὰ πολλαχῶς καὶ πολυειδῶς.", "seq": 2626}
{"id": "David_Passim_2627", "series": "CAG", "text": "ἀποροῦσι δέ τινες διὰ τί περὶ γένους διαλαμβάνων εἴδους ἐμνήσατο.", "seq": 2627}
{"id": "David_Passim_2628", "series": "CAG", "text": "καί φαμεν ὅτι οὐκ ἔστι τοῦτο ἄτοπον·", "seq": 2628}
{"id": "David_Passim_2629", "series": "CAG", "text": "ταῦτα γὰρ τῶν πρός τί ἐστιν, ὁσαχῶς δὲ θάτερον τῶν πρός τι λαμβάνεται, τοσαυταχῶς καὶ τὸ ἕτερον.", "seq": 2629}
{"id": "David_Passim_2630", "series": "CAG", "text": "ἐπεὶ οὖν πολλαχῶς λέγεται τὸ γένος, ἐζήτησεν ὁ Πορφύριος ταὐτὸν καὶ ἐπὶ τοῦ εἴδους δεῖξαι·", "seq": 2630}
{"id": "David_Passim_2631", "series": "CAG", "text": "τῶν γὰρ πρός τί ἐστι καὶ ἀναγκαίως αὐτοῦ ἐμνήσατο.", "seq": 2631}
{"id": "David_Passim_2632", "series": "CAG", "text": "1.", "seq": 2632}
{"id": "David_Passim_2633", "series": "CAG", "text": "18 Γένος γὰρ λέγεται καὶ ἡ τινῶν ἐχόντων πως πρὸς ἕν τι καὶ πρὸς ἀλλήλους ἄθροισις.", "seq": 2633}
{"id": "David_Passim_2634", "series": "CAG", "text": "Καλῶς εἶπε τὸ πώς, ἵνα δείξῃ ὅτι οὐ μόνον τὸ ὀνομασθὲν ἀπό τινος γένος καλεῖται, ἀλλὰ καὶ τὸ ἐξ αὐτοῦ προελθόν.", "seq": 2634}
{"id": "David_Passim_2635", "series": "CAG", "text": "τοῦτο δὲ δηλοῖ τὸ πώς·", "seq": 2635}
{"id": "David_Passim_2636", "series": "CAG", "text": "φησὶ γὰρ γένος λέγεται ἡ ἄθροισις τῶν ἐχόντων πως πρὸς ἀλλήλους, τοῦτ᾿ ἔστι τῶν ἐχόντων οἰκειότητα γένους.", "seq": 2636}
{"id": "David_Passim_2637", "series": "CAG", "text": "καὶ εἴπομεν ὅτι τὸ ὀνομάζεσθαι μόνον οὐ δηλοῖ τὸ γένος, εἴ γε τὸ Πυθαγόρειον οὐ λέγεται γένος, μόνον παρονομασθέν, ἀλλὰ καὶ τὸ προέρχεσθαι ἀπό τινος, ὅπερ σημαίνει τὸ πώς.", "seq": 2637}
{"id": "David_Passim_2638", "series": "CAG", "text": "διὰ δὲ τοῦ εἰπεῖν πρὸς ἕν τι ἐχόντων δηλοῖ τὴν ἀπὸ τοῦ πλήθους πρὸς τὸν ἕνα σχέσιν.", "seq": 2638}
{"id": "David_Passim_2639", "series": "CAG", "text": "ἀλλὰ μὴν καὶ τῷ εἰπεῖν πρὸς ἀλλήλους δηλοῖ τὴν πρὸς ἀλλήλους σχέσιν·", "seq": 2639}
{"id": "David_Passim_2640", "series": "CAG", "text": "ἐπιφέρει γὰρ ἐν τοῖς ἑξῆς τὴν ἄλλην.", "seq": 2640}
{"id": "David_Passim_2641", "series": "CAG", "text": "1.", "seq": 2641}
{"id": "David_Passim_2642", "series": "CAG", "text": "20 Ἐκ τῆς ἀφ᾿ ἑνὸς σχέσεως, λέγω δὴ τοῦ Ἡρακλέους.", "seq": 2642}
{"id": "David_Passim_2643", "series": "CAG", "text": "Ὧδε τὴν ἀπὸ τοῦ ἑνὸς πρὸς τὸ πλῆθος σχέσιν δηλοῖ.", "seq": 2643}
{"id": "David_Passim_2644", "series": "CAG", "text": "1.", "seq": 2644}
{"id": "David_Passim_2645", "series": "CAG", "text": "21 Καὶ τοῦ πλήθους τῶν ἐχόντων πως πρὸς ἀλλήλους τὴν ἀπ᾿ ἐκείνου οἰκειότητα κατὰ ἀποτομὴν τῶν ἄλλων γενῶν κεκλημένου.", "seq": 2645}
{"id": "David_Passim_2646", "series": "CAG", "text": "Κατὰ ἀποτομήν φησι κατὰ προσηγορίαν·", "seq": 2646}
{"id": "David_Passim_2647", "series": "CAG", "text": "ἡ γὰρ προσηγορία δίκην ὁρισμοῦ ἔχουσα διαχωρίζει καὶ οἷον ἀποτέμνει τὰ σημαινόμενα ἀπ᾿ ἀλλήλων.", "seq": 2647}
{"id": "David_Passim_2648", "series": "CAG", "text": "λέγει οὖν τοῦ πλήθους τοῦ Ἡρακλέους κατὰ προσηγορίαν, τοῦτ᾿ ἔστι κατὰ ἀποτομήν, τῶν ἄλλων γενῶν κεκλημένου·", "seq": 2648}
{"id": "David_Passim_2649", "series": "CAG", "text": "ὅταν γὰρ εἴπω Ἡρακλεῖδαι, διαχωρίζω αὐτὸ ἀπὸ τῶν ἄλλων γενῶν, λέγω δὴ τῶν εἰρησομένων.", "seq": 2649}
{"id": "David_Passim_2650", "series": "CAG", "text": "ἀναλαμβάνει δὲ τὴν πρὸς ἀλλήλους σχέσιν λέγων τῶν ἐχόντων πρὸς ἀλλήλους τὴν ἀπ᾿ ἐκείνου οἰκειότητα.", "seq": 2650}
{"id": "David_Passim_2651", "series": "CAG", "text": "1.", "seq": 2651}
{"id": "David_Passim_2652", "series": "CAG", "text": "23 Λέγεται δὲ καὶ ἄλλως πάλιν γένος ἡ ἑκάστου τῆς γενέσεως ἀρχὴ ἤτοι ἀπὸ τοῦ τεκόντος ἢ ἀπὸ τοῦ τόπου, ἐν ᾧ τις γέγονε.", "seq": 2652}
{"id": "David_Passim_2653", "series": "CAG", "text": "Καλῶς αὐτὸ ἔφρασε καὶ σαφῶς.", "seq": 2653}
{"id": "David_Passim_2654", "series": "CAG", "text": "τὰ δὲ παραδείγματα οὐκ ἐπὶ ἑνὸς παρέθετο, ὡς ἡμεῖς εἴπομεν ἐν τῇ θεωρίᾳ, ἀλλ᾿ ἐπὶ μὲν ἄλλου τὸ προσεχές, ἐπὶ δὲ ἄλλου τὸ πόρρω·", "seq": 2654}
{"id": "David_Passim_2655", "series": "CAG", "text": "Ὀρέστην ἀπὸ Ταντάλου φαμὲν ἔχειν τὸ γένος (τοῦτο πόρρω ἐστίν), Ὕλλον δὲ ἀφ᾿ Ἡρακλέους (τοῦτο προσεχές ἐστιν), Πίνδαρον δὲ Θηβαῖον (καὶ τοῦτο προσεχές), Πλάτωνα δὲ Ἀθηναῖον (τοῦτο δὲ πόρρω ἐστί).", "seq": 2655}
{"id": "David_Passim_2656", "series": "CAG", "text": "καὶ εἰ ἐξ αὐτῶν τῶν Ἀθηνῶν ὑπῆρχεν ὁ Πλάτων, πῶς πόρρω ἐστί;", "seq": 2656}
{"id": "David_Passim_2657", "series": "CAG", "text": "φασὶν οὖν ὅτι πάλαι εἰς κώμας ἐμεμέριστο ἡ Ἀττική·", "seq": 2657}
{"id": "David_Passim_2658", "series": "CAG", "text": "πόρρω οὖν γένος τῷ Πλάτωνί ἐστιν ἡ Ἀττική, προσεχὲς δὲ ἡ μία τῶν κωμῶν.", "seq": 2658}
{"id": "David_Passim_2659", "series": "CAG", "text": "οἱ δὲ τοὺς τόπους ἐπὶ τῶν παραδειγμάτων εἰρημένους ἀγνοήσαντες καὶ ἀπορίαν ψυχρὰν ἐκτίθενται καὶ λύσιν·", "seq": 2659}
{"id": "David_Passim_2660", "series": "CAG", "text": "ἐπὶ γὰρ Πινδάρου τοὐναντίον δεῖ λέγειν ὅτι ὁ Πίνδαρος μὲν Θηβαῖος λεγόμενος πόρρω ἔχει τὸ γένος ἀπὸ τῆς πατρίδος·", "seq": 2660}
{"id": "David_Passim_2661", "series": "CAG", "text": "οὐ γὰρ ἦν ἀπὸ Θηβῶν, ἀλλ᾿ ἀπὸ κώμης τῆς τῶν Κυνὸς κεφαλῶν.", "seq": 2661}
{"id": "David_Passim_2662", "series": "CAG", "text": "ὥστε οὖν προσεχὲς μὲν αὐτῷ γένος ὑπάρχει ἡ κώμη, πόρρω δὲ αἱ Θῆβαι.", "seq": 2662}
{"id": "David_Passim_2663", "series": "CAG", "text": "Πλάτων δὲ Ἀθηναῖος λεγόμενος προσεχὲς ἔχει τὸ γένος.", "seq": 2663}
{"id": "David_Passim_2664", "series": "CAG", "text": "2.", "seq": 2664}
{"id": "David_Passim_2665", "series": "CAG", "text": "4 Καὶ γὰρ ἡ πατρὶς ἀρχή τίς ἐστι τῆς ἑκάστου γενέσεως, ὥσπερ καὶ ὁ πατήρ.", "seq": 2665}
{"id": "David_Passim_2666", "series": "CAG", "text": "Ἵνα μηδεὶς εἴπῃ ‘καὶ πῶς ἡ πατρὶς λέγεται γένος;’", "seq": 2666}
{"id": "David_Passim_2667", "series": "CAG", "text": "φησὶν ὅτι οὐκ ἄτοπον·", "seq": 2667}
{"id": "David_Passim_2668", "series": "CAG", "text": "ὥσπερ γὰρ ὁ πατὴρ γένος λέγεται, οὕτω καὶ ἡ πατρίς.", "seq": 2668}
{"id": "David_Passim_2669", "series": "CAG", "text": "ἐδείξαμεν δὲ ὅτι καὶ κρεῖττον γένος ὑπάρχει τὸ τῆς πατρίδος ἤπερ τὸ τοῦ πατρός.", "seq": 2669}
{"id": "David_Passim_2670", "series": "CAG", "text": "ἐν οἷς ἡ παροῦσα πρᾶξις.", "seq": 2670}
{"id": "David_Passim_2671", "series": "CAG", "text": "Πρᾶξις ια΄.", "seq": 2671}
{"id": "David_Passim_2672", "series": "CAG", "text": "Γινώσκοντες τὴν τάξιν ἀκρίβειαν δύνασθαι τῇ διδασκαλίᾳ χαρίζεσθαι, φέρε ὀλίγον τὸν λόγον περὶ αὐτὴν ποιησώμεθα.", "seq": 2672}
{"id": "David_Passim_2673", "series": "CAG", "text": "ζητητέον δὲ οἷα γένη προταγήσεται, ἆρα τὸ κατὰ φιλοσοφίαν ἢ τὰ κατὰ συνήθειαν·", "seq": 2673}
{"id": "David_Passim_2674", "series": "CAG", "text": "ἡ γὰρ συνήθεια τὸν ἁπλῶς ἄνθρωπον λέγει, ἡ δὲ φιλοσοφία τὸν τοιόνδε.", "seq": 2674}
{"id": "David_Passim_2675", "series": "CAG", "text": "εἰ δὲ ὁ ἁπλῶς ἄνθρωπος τοῦ τοιοῦδε προηγεῖται, τὰ κατὰ συνήθειαν τῶν κατὰ φιλοσοφίαν προηγήσεται.", "seq": 2675}
{"id": "David_Passim_2676", "series": "CAG", "text": "ἀλλὰ πάλιν καὶ ἐνταῦθα ἄλλη ζήτησις ὑπάρχει·", "seq": 2676}
{"id": "David_Passim_2677", "series": "CAG", "text": "τῶν γὰρ κατὰ συνήθειαν ζητεῖται ποῖον ἄρα τοῦ ἑτέρου προταγήσεται.", "seq": 2677}
{"id": "David_Passim_2678", "series": "CAG", "text": "καί φασιν ὅτι τὰ δύο φαίνεται ὁ Πορφύριος προτάττων.", "seq": 2678}
{"id": "David_Passim_2679", "series": "CAG", "text": "τοῦτο δὲ ὑπόψυχρον·", "seq": 2679}
{"id": "David_Passim_2680", "series": "CAG", "text": "πῶς γὰρ δύναται τὰ δύο πρῶτα εἶναι;", "seq": 2680}
{"id": "David_Passim_2681", "series": "CAG", "text": "εἰ δὲ καὶ τὰ δύο πρῶτά ἐστιν, ἄρα καὶ ὕστερά ἐστι.", "seq": 2681}
{"id": "David_Passim_2682", "series": "CAG", "text": "πρῶτα δὲ καὶ ὕστερα εἶναι ἑαυτῶν ἄτοπον.", "seq": 2682}
{"id": "David_Passim_2683", "series": "CAG", "text": "μήποτε δὲ τῷ ὄντι καὶ τὰ δύο πρῶτα καὶ ὕστερά φησιν ὁ Πορφύριος, κατ᾿ ἄλλο δὲ καὶ ἄλλο·", "seq": 2683}
{"id": "David_Passim_2684", "series": "CAG", "text": "οὔτε γὰρ κατὰ τὸ αὐτὸ πρῶτά ἐστι καὶ ὕστερα, ἀλλὰ πρῶτα μὲν τῇ φύσει ὕστερα δὲ τῇ συνηθείᾳ, λέγω δὲ ἡμῖν, καὶ ὕστερα μὲν τῇ φύσει ἡμῖν δὲ πρῶτα.", "seq": 2684}
{"id": "David_Passim_2685", "series": "CAG", "text": "πῶς δὲ τοῦτο ὑπάρχει, λέξομεν ἐν παραδείγματος τρόπῳ.", "seq": 2685}
{"id": "David_Passim_2686", "series": "CAG", "text": "τὰ τῇ φύσει πρῶτά ἐστι ἡμῖν ὕστερα, οἷον τὰ ἁπλᾶ τῇ φύσει πρῶτά ἐστι, τὸ πῦρ τὸ ὕδωρ, ἔστι δὲ ἡμῖν ὕστερα·", "seq": 2686}
{"id": "David_Passim_2687", "series": "CAG", "text": "πρῶτον γὰρ ἀποβλέπομεν εἰς τὸν ἄνθρωπον, καὶ ὕστερον ἐξ αὐτοῦ γινώσκομεν τὰ ἁπλᾶ στοιχεῖα.", "seq": 2687}
{"id": "David_Passim_2688", "series": "CAG", "text": "ἐκ τοῦ ἐναντίου δὲ τὰ τῇ φύσει ὕστερα ἡμῖν πρῶτά ἐστιν, οἷον ὁ ἄνθρωπος τῇ φύσει ὕστερος ἡμῖν δὲ πρῶτος·", "seq": 2688}
{"id": "David_Passim_2689", "series": "CAG", "text": "πρῶτον γὰρ ἐποίησεν ὁ θεὸς τὸ πῦρ τὸ ὕδωρ καὶ τὰ λοιπὰ στοιχεῖα, καὶ ὕστερον ἐποίησεν ἐξ αὐτῶν σύνθετον τὸν ἄνθρωπον.", "seq": 2689}
{"id": "David_Passim_2690", "series": "CAG", "text": "ὁ ἄνθρωπος δὲ ἡμῖν πρῶτός ἐστι·", "seq": 2690}
{"id": "David_Passim_2691", "series": "CAG", "text": "πρῶτον γὰρ γινώσκομεν τὸν ἄνθρωπον καὶ ὕστερον τὰ ἁπλᾶ στοιχεῖα.", "seq": 2691}
{"id": "David_Passim_2692", "series": "CAG", "text": "τοιοῦτον δέ ἐστι καὶ ἐπὶ τῶν προκειμένων γενῶν·", "seq": 2692}
{"id": "David_Passim_2693", "series": "CAG", "text": "τὸ μὲν γὰρ πρῶτόν ἐστι τῇ φύσει, ἡμῖν δὲ ὕστερον.", "seq": 2693}
{"id": "David_Passim_2694", "series": "CAG", "text": "ποῖον δὲ τοῦτο;", "seq": 2694}
{"id": "David_Passim_2695", "series": "CAG", "text": "τὸ λέγον ἡ ἑκάστου τῆς γενέσεως ἀρχὴ ἀπὸ τοῦ τεκόντος ἢ τῆς πατρίδος·", "seq": 2695}
{"id": "David_Passim_2696", "series": "CAG", "text": "πρῶτον γὰρ τοῦτο ἔγνωσται τῇ φύσει ὕστερον δ᾿ ἡμῖν·", "seq": 2696}
{"id": "David_Passim_2697", "series": "CAG", "text": "εἰ μὴ γὰρ φοιτήσωμεν εἰς διδασκάλους, οὐ γινώσκομεν ὅτι ὁ πατὴρ γένος ἐστὶ καὶ ἡ πατρίς.", "seq": 2697}
{"id": "David_Passim_2698", "series": "CAG", "text": "πρόδηλον οὖν ὅτι προϋπῆρχε τῇ φύσει πρὶν ἢ φοιτήσωμεν εἰς διδασκάλους.", "seq": 2698}
{"id": "David_Passim_2699", "series": "CAG", "text": "φύσιν δὲ λέγω οὐ τὴν δημιουργοῦσαν, ἐπεὶ κατ᾿ ἐκείνην πάντα αὐτῇ πρῶτα ὑπάρχει.", "seq": 2699}
{"id": "David_Passim_2700", "series": "CAG", "text": "τὸ δὲ ἕτερον ὕστερόν ἐστι τῇ φύσει, ἡμῖν δὲ πρῶτον.", "seq": 2700}
{"id": "David_Passim_2701", "series": "CAG", "text": "ποῖον δὲ τοῦτο;", "seq": 2701}
{"id": "David_Passim_2702", "series": "CAG", "text": "τὸ λέγον τὸ ἀφ᾿ ἑνὸς παρονομασθὲν καὶ προελθὸν οἷον Ἡρακλεῖδαι.", "seq": 2702}
{"id": "David_Passim_2703", "series": "CAG", "text": "καὶ πρῶτον ἡμῖν ἐστιν, ὅτι πρῶτον κατανοοῦμεν τοὺς Ἡρακλείδας·", "seq": 2703}
{"id": "David_Passim_2704", "series": "CAG", "text": "οὔτε γὰρ ἀπὸ τοῦ Ἡρακλέους κατανοοῦμεν αὐτούς, ἐπεὶ τοῦτο ὕστερον ἡμῖν εὑρίσκεται, ἀλλ᾿ ἐξ αὐτῶν μανθάνομεν ὅτι ἀπὸ τοῦ Ἡρακλέους κατάγονται.", "seq": 2704}
{"id": "David_Passim_2705", "series": "CAG", "text": "ὕστερον δὲ τῇ φύσει ἐστίν, ὅτι πρῶτον δεῖ τὸν Ἡρακλέα εἶναι, ὕστερον δὲ τοὺς Ἡρακλείδας·", "seq": 2705}
{"id": "David_Passim_2706", "series": "CAG", "text": "κατ᾿ ἄλλο οὖν καὶ ἄλλο φαμὲν αὐτὰ πρῶτα καὶ ὕστερα.", "seq": 2706}
{"id": "David_Passim_2707", "series": "CAG", "text": "Ἐπειδὴ δὲ καὶ σχέσιν τινὰ ἔχει τὸ γένος πρὸς τὸ εἶδος (ταῦτα γὰρ τῶν πρός τί ἐστι), φέρε μάθωμεν ποία ἂν εἴη αὕτη τεσσάρων οὐσῶν τῶν σχέσεων·", "seq": 2707}
{"id": "David_Passim_2708", "series": "CAG", "text": "ἡ μὲν γάρ ἐστι φυσικὴ ὡς ἡ τοῦ πατρὸς πρὸς τὸν υἱόν, ἡ δὲ προαιρετικὴ ὡς ἡ φίλου πρὸς φίλον, ἡ δὲ τεχνικὴ ὡς ἡ διδασκάλου πρὸς μαθητήν, ἡ δὲ τυχηρὰ ὡς ἡ δεσπότου πρὸς δοῦλον.", "seq": 2708}
{"id": "David_Passim_2709", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ ἀμφιβάλλεται καὶ τὸ δεξιὸν ποίαν ἔχει σχέσιν πρὸς τὸ ἀριστερόν, φέρε περὶ αὐτοῦ πρῶτον εἴπωμεν καὶ μετὰ τοῦτο περὶ τοῦ γένους.", "seq": 2709}
{"id": "David_Passim_2710", "series": "CAG", "text": "τὸ δεξιὸν τοίνυν ἐὰν ὡσαύτως ἀεὶ ἔχῃ, φυσικὴν ἔχει σχέσιν, εἴτε ἐν ἀψύχοις ᾖ εἴτε ἐν ἐμψύχοις, οἷον τὸ ἧπαρ εἰς τὸ δεξιὸν καὶ ὁ σπλὴν εἰς τὸ ἀριστερόν·", "seq": 2710}
{"id": "David_Passim_2711", "series": "CAG", "text": "φυσικὴ δὲ ἡ τοιαύτη σχέσις.", "seq": 2711}
{"id": "David_Passim_2712", "series": "CAG", "text": "ἐὰν δὲ μὴ ὡσαύτως ἔχῃ, προαιρετικὴν ἔχει τὴν σχέσιν·", "seq": 2712}
{"id": "David_Passim_2713", "series": "CAG", "text": "δύναμαι γὰρ τὸ μὴ κωλυόμενον ὑπὸ τῆς φύσεως ἀριστερὸν ποιῆσαι δεξιόν·", "seq": 2713}
{"id": "David_Passim_2714", "series": "CAG", "text": "ἀμέλει τοῦτο αὐτὸ γινώσκων ὁ συγγραφεὺς Θουκυδίδης φησίν ‘εἰσιόντων δὲ ἡμῶν ἐπὶ τὸ Ἰόνιον πέλαγος εἴχομεν ἐν τῇ δεξιᾷ τὴν Ἐπίδαμνον’.", "seq": 2714}
{"id": "David_Passim_2715", "series": "CAG", "text": "προαιρετικὴ δὲ ἡ τοιαύτη σχέσις, καὶ διὰ τοῦτο εἶπε τὸ ‘εἰσιόντων’, ὡς δῆλον ‘ἐξιόντων ἐπὶ τὸ ἀριστερὸν εἴχομεν τὴν Ἐπίδαμνον’.", "seq": 2715}
{"id": "David_Passim_2716", "series": "CAG", "text": "ἔχει δὲ τὸ γένος πρὸς τὸ εἶδος τὴν σχέσιν φυσικήν·", "seq": 2716}
{"id": "David_Passim_2717", "series": "CAG", "text": "ὡς γὰρ ἔχει ὁ πατὴρ πρὸς τὸν υἱὸν φυσικὴν σχέσιν, οὕτω καὶ τὸ ζῷον πρὸς τὸν ἄνθρωπον.", "seq": 2717}
{"id": "David_Passim_2718", "series": "CAG", "text": "Πρᾶξις ιβ΄.", "seq": 2718}
{"id": "David_Passim_2719", "series": "CAG", "text": "Μετὰ τὸ διαστείλασθαι τὴν ὁμωνυμίαν καὶ δηλῶσαι περὶ ποίου σημαινομένου διαλαβεῖν βουλόμεθα, εὐλόγως ἐπὶ τὴν διδασκαλίαν βαδίζοντες ἐῶντες τὸ εἰ ἔστιν ἀπὸ τοῦ τί ἐστι τὴν ἀρχὴν ποιησόμεθα·", "seq": 2719}
{"id": "David_Passim_2720", "series": "CAG", "text": "τοῦτο γὰρ καὶ ἐπηγγειλάμεθα μὴ ζητεῖν εἰ ἐν ψιλαῖς ἐπινοίαις ἐστὶν ἢ ὑφέστηκε.", "seq": 2720}
{"id": "David_Passim_2721", "series": "CAG", "text": "ἰστέον δὲ ὅτι τὸ εἰ ἔστι δικαίως τοῦ τί ἐστι προηγεῖται·", "seq": 2721}
{"id": "David_Passim_2722", "series": "CAG", "text": "δύο γὰρ ἔχει τὸ εἰ ἔστιν ἢ τὸ εἶναι ἢ τὸ μὴ εἶναι·", "seq": 2722}
{"id": "David_Passim_2723", "series": "CAG", "text": "δεῖ οὖν ἡμᾶς πρῶτον τὸ εἰ ἔστι ζητεῖν, ἵνα εἰ μὲν ἔστι, ζητήσωμεν τὸ τί ἐστιν, εἰ δὲ μὴ ἔστι, τί ἐστι μὴ πολυπραγμονήσωμεν.", "seq": 2723}
{"id": "David_Passim_2724", "series": "CAG", "text": "ἐπειδὴ δὲ τὸ τί ἐστιν ἢ δι᾿ ὑπογραφῆς ἢ δι᾿ ὁρισμοῦ δηλοῦται, φέρε πρῶτον λέξωμεν ποία διαφορά ἐστι τῆς ὑπογραφῆς καὶ τοῦ ὁρισμοῦ καὶ ὕστερον λέγωμεν εἰ ὁρισμός ἐστιν ὧδε τοῦ γένους ἢ ὑπογραφή.", "seq": 2724}
{"id": "David_Passim_2725", "series": "CAG", "text": "Διαφέρει τοίνυν ὁρισμὸς τῆς ὑπογραφῆς, ὅτι ὁ μὲν ὁρισμὸς ἐξ οὐσιωδῶν φωνῶν συνίσταται πάντως, ἡ δὲ ὑπογραφὴ ἢ ἐξ ὅλων ἐπουσιωδῶν ἢ τινῶν.", "seq": 2725}
{"id": "David_Passim_2726", "series": "CAG", "text": "ἔτι διαφέρει ὁρισμὸς τῆς ὑπογραφῆς, ὅτι ὁ ὁρισμὸς ἐπὶ ὄντων πάντως λαμβάνεται, ἡ δὲ ὑπογραφὴ καὶ ἐπὶ ὄντων καὶ μὴ ὄντων, ἐπὶ ὄντων μὲν ὡς ἵνα εἴπῃς ‘ὁ ἄνθρωπος ζῷον γελαστικὸν πλατυώνυχον’, ἐπὶ μὴ ὄντων δὲ ὡς ἵνα ὑπογράψῃς τὸ κενόν·", "seq": 2726}
{"id": "David_Passim_2727", "series": "CAG", "text": "οὕτω γὰρ ὑπογράφει Ἀριστοτέλης ‘κενόν ἐστι τόπος σώματος ἐστερημένος’.", "seq": 2727}
{"id": "David_Passim_2728", "series": "CAG", "text": "ἐπεὶ οὖν ἔγνωμεν τὴν διαφορὰν τοῦ ὁρισμοῦ καὶ τῆς ὑπογραφῆς, φέρε ζητήσωμεν εἰ ὁρίζει μᾶλλον ὁ Πορφύριος τὸ γένος ἢ ὑπογράφει·", "seq": 2728}
{"id": "David_Passim_2729", "series": "CAG", "text": "λέγουσι γάρ τινες ὅτι ὑπογράφει.", "seq": 2729}
{"id": "David_Passim_2730", "series": "CAG", "text": "καὶ ἀποροῦμεν πρὸς αὐτοὺς λέγοντες·", "seq": 2730}
{"id": "David_Passim_2731", "series": "CAG", "text": "διὰ τί μὴ μᾶλλον ὁρίζει ἀλλ᾿ ὑπογράφει;", "seq": 2731}
{"id": "David_Passim_2732", "series": "CAG", "text": "φασὶ δὲ ὅτι δικαίως ὑπογράφει·", "seq": 2732}
{"id": "David_Passim_2733", "series": "CAG", "text": "εἰ γὰρ εἴπομεν φεύγειν τὴν ζήτησιν τοῦ εἰ ἔστιν ἢ μὴ ἔστιν, ἐδείχθη δὲ ὁ ὁρισμὸς ἐπὶ ὄντων πάντως λαμβάνεσθαι, εὐλόγως οὐχ ὡρίσατο ὁ Πορφύριος, ἵνα μὴ διὰ τοῦ ὁρισμοῦ δείξῃ τὸ γένος τῶν ὄντων, ἀλλ᾿ ὑπέγραψε δυναμένης τῆς ὑπογραφῆς καὶ ἐπὶ ὄντων καὶ μὴ ὄντων λαμβάνεσθαι, ὡς ἐδείχθη.", "seq": 2733}
{"id": "David_Passim_2734", "series": "CAG", "text": "ἔτι λέγουσιν ὅτι οὐκ ἠδύνατο ὁρίσασθαι τὸ γένος, ἐπειδὴ τὸ ὁριζόμενον θέλει ἔχειν τι ὑπερβεβηκός, τοῦ δὲ καθολικοῦ γένους ὑπερβεβηκός τι οὐκ ἔστιν.", "seq": 2734}
{"id": "David_Passim_2735", "series": "CAG", "text": "ὅτι δὲ ὁ λόγος ἀληθεύει, σαφὲς καὶ ἐκ τῆς διαφορᾶς, ἥτις ὁμοίως καθολικὴ οὖσα καὶ μὴ ἔχουσα ὑπερβεβηκὸς ἄλλο τι φεύγει τὸν ὁρισμόν.", "seq": 2735}
{"id": "David_Passim_2736", "series": "CAG", "text": "φαμὲν δὲ πρὸς τοῦτο ὅτι οὐκ ἔστιν ἀληθές·", "seq": 2736}
{"id": "David_Passim_2737", "series": "CAG", "text": "λέγομεν γάρ·", "seq": 2737}
{"id": "David_Passim_2738", "series": "CAG", "text": "εἰ διὰ τὸ μὴ ἔχειν ὑπερβεβηκός τι τὸ γένος οὐχ ὡρίσθη οὔτε μὴν ἡ διαφορά, διὰ τί τὸ εἶδος καὶ αἱ λοιπαὶ φωναὶ ἔχουσαι ὑπερβεβηκότα οὐχ ὁρίζονται ἀλλ᾿ ὑπογράφονται;", "seq": 2738}
{"id": "David_Passim_2739", "series": "CAG", "text": "πρὸς τοῦτο δὲ καθολικωτέραν ὑπὲρ τῶν πέντε φωνῶν λέγουσιν ἀπολογίαν, ὡς οὐκ ἠδύνατο ὁρίζεσθαι·", "seq": 2739}
{"id": "David_Passim_2740", "series": "CAG", "text": "φασὶ γάρ·", "seq": 2740}
{"id": "David_Passim_2741", "series": "CAG", "text": "αὗται αἱ φωναὶ ὁμώνυμοί εἰσιν, ὁμώνυμοι δὲ οὖσαι πολλὰς φύσεις δηλοῦσιν, ὁ ὁρισμὸς δὲ μίαν φύσιν θέλει δηλοῦν, πῶς οὖν ὁ ὁρισμὸς ἠδύνατο ἐπὶ τούτων λαμβάνεσθαι θέλων μίαν φύσιν δηλῶσαι αὐτῶν πολλὰς φύσεις σημαινουσῶν;", "seq": 2741}
{"id": "David_Passim_2742", "series": "CAG", "text": "ἀλλ᾿ εἰ καὶ εἴπῃς δυνατὸν τὰς ὁμωνύμους φωνὰς ὁρίζεσθαι, ἐὰν διαστολῆς τύχωσι, φαμὲν ὅτι ὁ Πορφύριος ταύτας τὰς φωνὰς ὅλας ὡς ὅλας βούλεται ὁρίσασθαι.", "seq": 2742}
{"id": "David_Passim_2743", "series": "CAG", "text": "λέγομεν δὲ πρὸς τούτους ὅτι μάταια φθέγγεσθε·", "seq": 2743}
{"id": "David_Passim_2744", "series": "CAG", "text": "τούτῳ γὰρ τῷ λόγῳ οὐδὲ ὑπογράφειν ὤφειλεν ὁ Πορφύριος τὰς τοιαύτας φωνάς·", "seq": 2744}
{"id": "David_Passim_2745", "series": "CAG", "text": "εἰκὼν γὰρ τοῦ ὁρισμοῦ ἡ ὑπογραφή·", "seq": 2745}
{"id": "David_Passim_2746", "series": "CAG", "text": "εἰ δὲ ὁ ὁρισμὸς μίαν φύσιν δηλοῖ, ἄρα καὶ ἡ ὑπογραφή·", "seq": 2746}
{"id": "David_Passim_2747", "series": "CAG", "text": "εἰ δὲ καὶ οὐχ ὁρίζονται αἱ προκείμεναι φωναὶ διὰ τὸ πολλὰς φύσεις δηλοῦν (ὁμώνυμοι γάρ), οὐκοῦν οὐδὲ ὑπογράφεσθαι ὤφειλον τῆς ὑπογραφῆς μίαν φύσιν δηλούσης.", "seq": 2747}
{"id": "David_Passim_2748", "series": "CAG", "text": "ἔτι τινὲς ἀποροῦσιν·", "seq": 2748}
{"id": "David_Passim_2749", "series": "CAG", "text": "εἰ αἱ προκείμεναι φωναὶ κατὰ τὰ πράγματα ὁμώνυμοι οὖσαι οὐ δύνανται ὁρίζεσθαι (πολλὰ γὰρ σημαίνουσι πράγματα), διὰ τί κατὰ τὴν σχέσιν οὐχ ὁρίζεται τὸ γένος;", "seq": 2749}
{"id": "David_Passim_2750", "series": "CAG", "text": "μία γάρ ἐστιν ἡ σχέσις τοῦ τε κατὰ φιλοσοφίαν γένους καὶ τῶν κατὰ συνήθειαν, τὰ δὲ πράγματα διάφορα καὶ πολλά, ἅτινα ὡς εἰκὸς διαφόρους φύσεις ἔχοντα φεύγει τὸν ὁρισμόν·", "seq": 2750}
{"id": "David_Passim_2751", "series": "CAG", "text": "αὕτη γὰρ ἡ σχέσις μία οὖσα ὀφείλει ὁρίζεσθαι·", "seq": 2751}
{"id": "David_Passim_2752", "series": "CAG", "text": "πράγματα δὲ διάφορα σημαίνει τὸ γένος, καθὸ καὶ τὰ κατὰ συνήθειαν καὶ τὰ κατὰ φιλοσοφίαν δηλοῖ, σχέσιν δέ, ἣν ἔχει πρὸς τὰ εἴδη, καὶ πρὸς τὸ πλῆθος καὶ πρὸς τὰ γεννώμενα <ἔχει>·", "seq": 2752}
{"id": "David_Passim_2753", "series": "CAG", "text": "αὕτη γὰρ ἐν τοῖς πράγμασι θεωρεῖται.", "seq": 2753}
{"id": "David_Passim_2754", "series": "CAG", "text": "λέγουσι δὲ πρὸς ταῦτα ὅτι οὐκ ἠδύνατο τὸ γένος κατὰ τὴν σχέσιν ὁρίζεσθαι·", "seq": 2754}
{"id": "David_Passim_2755", "series": "CAG", "text": "ἔμελλε γὰρ ὁ λόγος διάλληλος εἶναι, ὃς διαβέβληται παρὰ τοῖς φιλοσόφοις·", "seq": 2755}
{"id": "David_Passim_2756", "series": "CAG", "text": "τὸ γὰρ ἀγνοούμενον διὰ τοῦ ἀγνοουμένου δηλοῦν ἐπιτηδεύει.", "seq": 2756}
{"id": "David_Passim_2757", "series": "CAG", "text": "καὶ πῶς ἔμελλεν ὁ λόγος διάλληλος εἶναι ἐπὶ τούτου τοῦ ὁρισμοῦ;", "seq": 2757}
{"id": "David_Passim_2758", "series": "CAG", "text": "ὅτι ἡμῶν ὁριζόντων τὸ γένος ἐκ τοῦ εἴδους βουλόμεθα αὐτὸ γνῶναι, καὶ πάλιν μαθεῖν βουλόμενοι τί ἐστιν εἶδος ἐμέλλομεν διὰ τοῦ γένους αὐτὸ ὁρίζεσθαι, τὰ δύο δὲ ἀγνοεῖται τί ἐστι γένος τὸ κατηγορούμενον εἴδους καὶ τί ἐστιν εἶδος ὃ ὑποτάσσεται τῷ γένει.", "seq": 2758}
{"id": "David_Passim_2759", "series": "CAG", "text": "πάνυ δὲ κακὴ ἡ ἀπολογία.", "seq": 2759}
{"id": "David_Passim_2760", "series": "CAG", "text": "ἀλλὰ μὴν καὶ τὰ κακῶς ἔχοντα οὐ διελέγξαι ἠδυνήθησαν·", "seq": 2760}
{"id": "David_Passim_2761", "series": "CAG", "text": "ὤφειλον γὰρ πρῶτον ἐλέγξαι ἐκείνους ὅτι οὐκ ἔστι μία ἡ σχέσις ἡ τοῦ κατὰ φιλοσοφίαν γένους καὶ τῶν κατὰ συνήθειαν·", "seq": 2761}
{"id": "David_Passim_2762", "series": "CAG", "text": "κἂν γὰρ ἡ αὐτὴ σχέσις ἐστίν, ἀλλ᾿ οὖν καθὸ σχέσις διάφορος ὑπάρχει·", "seq": 2762}
{"id": "David_Passim_2763", "series": "CAG", "text": "ἡ μὲν γὰρ τοῦ κατὰ φιλοσοφίαν ἄλλη ἐστίν, ἡ δὲ τῶν κατὰ συνήθειαν ἄλλη.", "seq": 2763}
{"id": "David_Passim_2764", "series": "CAG", "text": "οὐκοῦν καὶ τὰ γένη διάφορα.", "seq": 2764}
{"id": "David_Passim_2765", "series": "CAG", "text": "μὴ γνόντες οὖν ἐλέγξαι τοὺς τὴν τοιαύτην ἀπορίαν προενεγκαμένους ἡμαρτημένως ἀπελογήσαντο λέγοντες ὅτι διάλληλος ηὑρίσκετο ὁ λόγος, ὅπερ ἄτοπον, ἀγνοοῦντες ὅτι πάντως ἐπὶ τῶν πρός τι ὁ διάλληλος λόγος ζητεῖται, ἐπὶ δὲ τῶν μὴ σωζόντων πρὸς ἄλληλα οἰκειότητα ὁ διάλληλος λόγος ἀναρμόδιος, ἐπὶ δὲ τῶν πρός τι οὐκέτι·", "seq": 2765}
{"id": "David_Passim_2766", "series": "CAG", "text": "ταῦτα γὰρ πρὸς ἄλληλα ἔχει οἰκειότητα καὶ δι᾿ ἀλλήλων σημαίνεται.", "seq": 2766}
{"id": "David_Passim_2767", "series": "CAG", "text": "ὁ δὲ λόγος οὗτος οὐδ᾿ ὅλως κωλύει τὴν σχέσιν ὁρίζεσθαι.", "seq": 2767}
{"id": "David_Passim_2768", "series": "CAG", "text": "ἡμεῖς δὲ τί φαμεν;", "seq": 2768}
{"id": "David_Passim_2769", "series": "CAG", "text": "φαμὲν ὅτι ὡρίσατο τὴν σχέσιν ὁ Πορφύριος, ὡς δηλωθήσεται.", "seq": 2769}
{"id": "David_Passim_2770", "series": "CAG", "text": "καὶ ὡς μὲν πρὸς τὴν σχέσιν ὁρισμὸν αὐτὸν εἶναι λέγομεν, ὡς δὲ πρὸς τὰ πράγματα, ἐν οἷς θεωρεῖται, ὑπογραφήν·", "seq": 2770}
{"id": "David_Passim_2771", "series": "CAG", "text": "ὥσπερ γὰρ ὁριζόμεθα τὸ λευκόν, τὸ δὲ λευκὸν πάντως ἐν σώματι θεωρεῖται, καὶ ὡς μὲν πρὸς τὸ λευκὸν ὁρισμὸν τοῦτο καλοῦμεν, ὡς δὲ πρὸς τὸ σῶμα ὑπογραφήν, οὕτω καὶ τὴν σχέσιν ὁρίζοντες ὅσον μὲν πρὸς αὐτὴν ὁρισμὸν εἶναι λέγομεν, ὅσον δὲ πρὸς τὰ πράγματα ὑπογραφήν.", "seq": 2771}
{"id": "David_Passim_2772", "series": "CAG", "text": "ἔνθεν καὶ πρὸς τὰ πράγματα προσέχοντες, οὐχὶ δὲ πρὸς τὴν σχέσιν, ὑπογραφὴν λέγουσιν, οὐκέτι δὲ ὁρισμόν.", "seq": 2772}
{"id": "David_Passim_2773", "series": "CAG", "text": "πόθεν δὲ ἡ πλάνη;", "seq": 2773}
{"id": "David_Passim_2774", "series": "CAG", "text": "ἐκ τοῦ εἶναι τὴν σχέσιν ἐν τοῖς πράγμασιν.", "seq": 2774}
{"id": "David_Passim_2775", "series": "CAG", "text": "Πρᾶξις ιγ΄.", "seq": 2775}
{"id": "David_Passim_2776", "series": "CAG", "text": "Ἐπειδήπερ ἐπηγγειλάμεθα ὁρίσασθαι τὸ γένος, φέρε χωρήσωμεν ἐπὶ τὸν ὁρισμόν.", "seq": 2776}
{"id": "David_Passim_2777", "series": "CAG", "text": "ὁρίζεται τοίνυν τὸ γένος οὕτως·", "seq": 2777}
{"id": "David_Passim_2778", "series": "CAG", "text": "γένος ἐστὶ τὸ κατὰ πλειόνων καὶ διαφερόντων τῷ εἴδει ἐν τῷ τί ἐστι κατηγορούμενον.", "seq": 2778}
{"id": "David_Passim_2779", "series": "CAG", "text": "ἐπειδήπερ ἀνωτέρω ἐζητήσαμεν ὅτι ἀρετὴ ὁρισμοῦ ἐστι τὸ μόνῳ καὶ τῷ αὐτῷ ἁρμόζειν ἤτοι καὶ ἀντιστρέφειν, φέρε ἴδωμεν ἐπὶ τοῦ παρόντος ὁρισμοῦ, εἴ ποτε ἡ ἀρετὴ αὕτη φυλάττεται.", "seq": 2779}
{"id": "David_Passim_2780", "series": "CAG", "text": "φυλάττεται οὖν αὕτη ἡ ἀρετὴ ἀναμφιβόλως·", "seq": 2780}
{"id": "David_Passim_2781", "series": "CAG", "text": "μόνῳ γὰρ τῷ γένει καὶ παντὶ ἁρμόζει·", "seq": 2781}
{"id": "David_Passim_2782", "series": "CAG", "text": "αἱ φωναὶ γὰρ ἑπτά εἰσιν, ἡ μὲν ἄσημος ἡ δὲ σημαντική·", "seq": 2782}
{"id": "David_Passim_2783", "series": "CAG", "text": "αὕτη δὲ διττή, ἡ μὲν γὰρ μερικὴ ἡ δὲ καθόλου·", "seq": 2783}
{"id": "David_Passim_2784", "series": "CAG", "text": "τῶν δὲ καθόλου πέντε εἰσίν, ὡς ἐγνώκαμεν, τοῦτ᾿ ἔστιν αἱ παροῦσαι φωναί.", "seq": 2784}
{"id": "David_Passim_2785", "series": "CAG", "text": "εἰσὶν οὖν ἓξ φωναὶ σημαντικαί, πέντε καθόλου καὶ μία μερική, καὶ ἄλλη ἄσημος συμπληροῦσα τὸν ἑπτὰ ἀριθμόν.", "seq": 2785}
{"id": "David_Passim_2786", "series": "CAG", "text": "ἐκ τούτων τῶν ἑπτὰ μόνῳ τῷ γένει ὁ ὁρισμὸς προσήκει καὶ ἀποδιακρίνει τὸ γένος·", "seq": 2786}
{"id": "David_Passim_2787", "series": "CAG", "text": "ἐν μὲν γὰρ τῷ λέγειν κατηγορούμενον διακρίνει τὴν ἄσημον φωνήν (αὕτη γὰρ μηδὲν σημαίνουσά τινος οὐ κατηγορεῖται), ἐν δὲ τῷ λέγειν κατὰ πλειόνων διακρίνει τὰς μερικὰς ἐκ τῶν καθόλου (αἱ γὰρ μερικαὶ ἐκβληθήσονται κατὰ πλειόνων μὴ φερόμεναι·", "seq": 2787}
{"id": "David_Passim_2788", "series": "CAG", "text": "τὸ γὰρ Σωκράτης ἐπὶ ἄλλου τινὸς οὐ φέρεται·", "seq": 2788}
{"id": "David_Passim_2789", "series": "CAG", "text": "ὑπελείφθησαν δὲ αἱ καθόλου), καὶ ἐν μὲν τῷ λέγειν ἐν τῷ τί ἐστι τρεῖς αὐτῶν ἐκβάλλει, τὴν διαφορὰν τὸ ἴδιον καὶ τὸ συμβεβηκός (αὗται γὰρ οὐκ ἐν τῷ τί ἐστι κατηγοροῦνται, ἀλλ᾿ ἐν τῷ ὁποῖόν τί ἐστι·", "seq": 2789}
{"id": "David_Passim_2790", "series": "CAG", "text": "τὸ ζῷον ποῖόν ἐστι;", "seq": 2790}
{"id": "David_Passim_2791", "series": "CAG", "text": "λογικόν, ὅπερ ἐστὶ διαφορά, γελαστικόν, ὅπερ ἐστὶν ἴδιον, μέλαν ἢ λευκόν, ὅπερ ἐστὶ συμβεβηκός), ἐν δὲ τῷ εἰπεῖν διαφερόντων τῷ εἴδει ἐκβάλλει τὸ εἶδος·", "seq": 2791}
{"id": "David_Passim_2792", "series": "CAG", "text": "εἰ γὰρ κατὰ πλειόνων κατηγορεῖται ἐν τῷ τί ἐστιν, ἀλλ᾿ οὖν οὐ διαφερόντων τῷ εἴδει ἀλλὰ τῷ ἀριθμῷ·", "seq": 2792}
{"id": "David_Passim_2793", "series": "CAG", "text": "κατηγορεῖται γὰρ τὸ εἶδος κατὰ πολλῶν διαφερόντων τῷ ἀριθμῷ, Σωκράτους καὶ Πλάτωνος καὶ ἄλλων πολλῶν, εἴδει δὲ διαφερόντων οὐκέτι, ἐπεὶ ἔσται τὸ εἶδος ἑαυτοῦ διαφέρον·", "seq": 2793}
{"id": "David_Passim_2794", "series": "CAG", "text": "τὸ οὖν γένος κατηγορεῖται κατὰ πολλῶν διαφερόντων τῷ ἀριθμῷ καὶ τῷ εἴδει.", "seq": 2794}
{"id": "David_Passim_2795", "series": "CAG", "text": "ἐδείχθη οὖν ὅτι μόνον τὸ γένος ὑπελείφθη καὶ αὐτῷ μόνῳ ἁρμόζει ὁ παρὼν ὁρισμός.", "seq": 2795}
{"id": "David_Passim_2796", "series": "CAG", "text": "Μέμφονται δέ τινες τὴν τάξιν τῆς διακρίσεως.", "seq": 2796}
{"id": "David_Passim_2797", "series": "CAG", "text": "καὶ καλῶς·", "seq": 2797}
{"id": "David_Passim_2798", "series": "CAG", "text": "φασὶ γὰρ ὅτι πρῶτον δεῖ τὰ πόρρω διαχωρίζειν καὶ ὕστερον τὰ ἐγγύς·", "seq": 2798}
{"id": "David_Passim_2799", "series": "CAG", "text": "ὁρῶμεν γὰρ ὅτι καὶ τὸ πῦρ διακρῖνον τὰ μέταλλα πρῶτον διακρίνει τὰ πόρρω καὶ ὕστερον τὰ ἐγγύς, οἷον χρυσοῦ ὄντος ἅμα καὶ ἀργύρου καὶ ξύλου πρῶτον διακρίνει τὸ ξύλον, ὅπερ ἐστὶ πόρρω τοῦ ἀργύρου καὶ τοῦ χρυσοῦ, ὕστερον δὲ διακρίνει τὰ ἐγγύς, λέγω δὲ τὸν χρυσὸν ἐκ τοῦ ἀργύρου·", "seq": 2799}
{"id": "David_Passim_2800", "series": "CAG", "text": "ταῦτα γὰρ συγγενῆ ἐστι.", "seq": 2800}
{"id": "David_Passim_2801", "series": "CAG", "text": "τὸ τοιοῦτον δὲ ἔχει καὶ ὁ ὁρισμὸς τοῦ ἀνθρώπου·", "seq": 2801}
{"id": "David_Passim_2802", "series": "CAG", "text": "πρῶτον μὲν γὰρ τὰ πόρρω, ὕστερον δὲ τὰ ἐγγὺς διαχωρίζει.", "seq": 2802}
{"id": "David_Passim_2803", "series": "CAG", "text": "καὶ πῶς τὰ πόρρω;", "seq": 2803}
{"id": "David_Passim_2804", "series": "CAG", "text": "πόρρω ἐστὶ τοῦ ἀνθρώπου τὸ ἄψυχον, ἐπειδὴ ἔμψυχόν ἐστι·", "seq": 2804}
{"id": "David_Passim_2805", "series": "CAG", "text": "λέγων οὖν ‘ζῷον’ δηλοῖ ὅτι ἔμψυχόν ἐστι·", "seq": 2805}
{"id": "David_Passim_2806", "series": "CAG", "text": "τὸ γὰρ ζῷον ἔμψυχόν ἐστι.", "seq": 2806}
{"id": "David_Passim_2807", "series": "CAG", "text": "τὰ ἐγγὺς δὲ ὕστερον διακρίνομεν·", "seq": 2807}
{"id": "David_Passim_2808", "series": "CAG", "text": "ἐπειδὴ γὰρ καὶ ἔμψυχόν ἐστιν ὁ ἵππος καὶ ὅλα τὰ ἄλογα (ταῦτα γὰρ τὰ ἔμψυχα ἐγγύς εἰσι τοῦ ἀνθρώπου, ἐπειδὴ τῶν ἐμψύχων καὶ ὁ ἄνθρωπος), φαμὲν ‘λογικόν’ καὶ οὕτω τὰ ἐγγὺς αὐτοῦ διαχωρίζομεν.", "seq": 2808}
{"id": "David_Passim_2809", "series": "CAG", "text": "τὸ τοιοῦτον δὲ ἐπὶ τοῦ προκειμένου ὁρισμοῦ οὐκ ἔστι·", "seq": 2809}
{"id": "David_Passim_2810", "series": "CAG", "text": "πρῶτον γὰρ τὰ ἐγγὺς διέκρινεν, ὕστερον δὲ τὰ πόρρω·", "seq": 2810}
{"id": "David_Passim_2811", "series": "CAG", "text": "λέγων γὰρ τὸ κατὰ πλειόνων διακρίνει τὰ καθόλου ἐκ τῶν μερικῶν, ἅπερ ἐγγύτερα αὐτῶν εἰσι, λέγων δὲ κατηγορούμενον διέκρινε τὸ ἄσημον.", "seq": 2811}
{"id": "David_Passim_2812", "series": "CAG", "text": "ἔδει δὲ μᾶλλον πρῶτον τὴν ἄσημον διακρίνειν, ἥτις πόρρω ἐστίν, ὕστερον δὲ τὴν σημαντικήν, ἥτις προσεχής ἐστι.", "seq": 2812}
{"id": "David_Passim_2813", "series": "CAG", "text": "δεῖ οὖν, φασίν, ἀντιστρέφοντας λέγειν γένος ἐστὶ τὸ κατηγορούμενον κατὰ πλειόνων καὶ διαφερόντων τῷ εἴδει ἐν τῷ τί ἐστιν, ἵνα τὸ κατηγορούμενον ἐκβάλῃ τὸ ἄσημον, τὸ κατὰ πλειόνων διαχωρίσῃ τὴν μερικὴν ἐκ τῆς καθόλου, τὸ διαφερόντων τῷ εἴδει ἐκβάλῃ τὸ εἶδος, τὸ ἐν τῷ τί ἐστιν [ἵνα] διαχωρίσῃ τὰς ὑπολοίπους τρεῖς φωνάς, διαφορὰν ἴδιον καὶ συμβεβηκός.", "seq": 2813}
{"id": "David_Passim_2814", "series": "CAG", "text": "Ζητοῦσι δέ τινες εἰ ἄρα συμπεριέλαβεν ὁ ὁρισμὸς οὗτος καὶ τὸ παρὰ Πλάτωνι καθόλου γένος, λέγω δὲ τὰς ἰδέας.", "seq": 2814}
{"id": "David_Passim_2815", "series": "CAG", "text": "ἀπὸ δύο δὲ τρόπων γινώσκομεν ὅτι οὐ συμπεριέλαβεν αὐτό, λέγω δὲ τὸ πρὸ τῶν πολλῶν.", "seq": 2815}
{"id": "David_Passim_2816", "series": "CAG", "text": "πρῶτον μὲν ὅτι ἐκεῖνο ἐν τῷ ὁποῖόν τί ἐστι κατηγορεῖται, τοῦτο δὲ ἐν τῷ τί ἐστι.", "seq": 2816}
{"id": "David_Passim_2817", "series": "CAG", "text": "καὶ πῶς ἐν τῷ ὁποῖόν τί ἐστι τὸ παρὰ Πλάτωνι λέξωμεν.", "seq": 2817}
{"id": "David_Passim_2818", "series": "CAG", "text": "αἱ ὁμοιότητες ἐν τῷ ὁποῖόν τί ἐστι κατηγοροῦνται.", "seq": 2818}
{"id": "David_Passim_2819", "series": "CAG", "text": "προκείσθωσαν κεφαλαὶ δύο, φάττης καὶ περιστερᾶς, ἐπειδήπερ ἐοίκασιν ἀλλήλαις.", "seq": 2819}
{"id": "David_Passim_2820", "series": "CAG", "text": "διὰ οὖν τὴν πολλὴν ὁμοιότητα ἐρωτῶμεν ποία ἐστὶν ἡ κεφαλὴ τῆς φάττης·", "seq": 2820}
{"id": "David_Passim_2821", "series": "CAG", "text": "ἰδοὺ αἱ ὁμοιότητες ἐν τῷ ὁποῖόν τί ἐστι κατηγοροῦνται.", "seq": 2821}
{"id": "David_Passim_2822", "series": "CAG", "text": "εἴρηται δὲ ὅτι λέγουσιν ἡμᾶς οἱ κατὰ Πλάτωνα καθ᾿ ὁμοιότητα ἐκείνων τῶν ἰδεῶν γενέσθαι.", "seq": 2822}
{"id": "David_Passim_2823", "series": "CAG", "text": "εἰ οὖν τὸ μὲν ἐν τῷ τί ἐστι κατηγορεῖται, τὸ δὲ ἐν τῷ ὁποῖόν τί ἐστιν, ὁ ὁρισμὸς οὗτος οὐ συμπεριλαμβάνει καὶ τὸ Πλατωνικὸν γένος.", "seq": 2823}
{"id": "David_Passim_2824", "series": "CAG", "text": "δεύτερον τὸ γένος τοῦτο συνωνύμως κατηγορούμενον μεταδίδωσι τοῖς εἴδεσι καὶ ὀνόματος καὶ πράγματος, οἷον τὸ ζῷον μεταδίδωσι τῷ ἀνθρώπῳ τοῦ ὀνόματος, ὅτι καὶ ζῷον δύναμαι προσαγορεύειν τὸν ἄνθρωπον, ἀλλὰ μὴν καὶ πράγματος, ὅτι καὶ τοῦ ζῆν ἡμῖν μεταδίδωσι·", "seq": 2824}
{"id": "David_Passim_2825", "series": "CAG", "text": "τοῦτο δὲ συνωνύμως κατηγορεῖσθαι λέγεται.", "seq": 2825}
{"id": "David_Passim_2826", "series": "CAG", "text": "ἐπὶ δὲ τοῦ ἄλλου γένους οὐκ ἔστι τοῦτο εὑρεῖν·", "seq": 2826}
{"id": "David_Passim_2827", "series": "CAG", "text": "εἰ γὰρ καὶ ὀνόματος μεταδίδωσιν, ἀλλ᾿ οὖν οὐκέτι καὶ πράγματος·", "seq": 2827}
{"id": "David_Passim_2828", "series": "CAG", "text": "τὸ μὲν γὰρ ἀίδιον καὶ ἀσώματον, ἡμεῖς δὲ ἐν γενέσει ἐσμὲν καὶ φθορᾷ καὶ σῶμα ἔχομεν.", "seq": 2828}
{"id": "David_Passim_2829", "series": "CAG", "text": "ἐν οἷς ἡ πρᾶξις.", "seq": 2829}
{"id": "David_Passim_2830", "series": "CAG", "text": "Πρᾶξις ιδ΄.", "seq": 2830}
{"id": "David_Passim_2831", "series": "CAG", "text": "Εἰ καὶ ἀκριβὴς ὁ λόγος τοῦ γένους καθέστηκεν, ἀλλ᾿ οὖν ὅμως κινδυνεύει τὰ κατὰ τὴν ὕπαρξιν ὑπὸ τῶν τῇ ἀληθείᾳ ἀντιλέγειν εἰωθότων·", "seq": 2831}
{"id": "David_Passim_2832", "series": "CAG", "text": "ἀπορίαις γὰρ κατ᾿ αὐτοῦ οὐ ταῖς τυχούσαις καθοπλίζονται.", "seq": 2832}
{"id": "David_Passim_2833", "series": "CAG", "text": "ἀλλὰ πρῶτον καὶ τὸ δοκοῦν αὐτοῖς ἀντικεῖσθαι εἰς κακίαν αὐτοῦ μεταβάλλουσι·", "seq": 2833}
{"id": "David_Passim_2834", "series": "CAG", "text": "φασὶ γάρ·", "seq": 2834}
{"id": "David_Passim_2835", "series": "CAG", "text": "κακῶς λέγετε συνωνύμως κατηγορεῖσθαι τὸ γένος τοῦ εἴδους·", "seq": 2835}
{"id": "David_Passim_2836", "series": "CAG", "text": "τῷ γὰρ συνωνύμως κατηγορεῖσθαι ὀνόματος καὶ πράγματος μεταδίδωσι τῷ εἴδει·", "seq": 2836}
{"id": "David_Passim_2837", "series": "CAG", "text": "εἰ δὲ μεταδίδωσιν ὀνόματος καὶ πράγματος τὸ γένος τῷ εἴδει, ταὐτόν ἐστιν εἶδος καὶ γένος·", "seq": 2837}
{"id": "David_Passim_2838", "series": "CAG", "text": "οἷον τὸ ζῷον εἰ μεταδίδωσι τῷ ἀνθρώπῳ ὀνόματος καὶ πράγματος (ὀνόματος μὲν καθὸ καὶ ὁ ἄνθρωπος λέγεται ζῷον, πράγματος δὲ καθὸ καὶ ὁ ἄνθρωπος ὁμοίως οὐσία ἐστὶν ἔμψυχος αἰσθητικὴ ὥσπερ καὶ τὸ ζῷον), οὐκοῦν ταὐτόν ἐστιν ὁ ἄνθρωπος τῷ ζῴῳ·", "seq": 2838}
{"id": "David_Passim_2839", "series": "CAG", "text": "συμπεριλαμβάνει ἄρα ὁ ὁρισμὸς οὗτος καὶ τὸ εἶδος.", "seq": 2839}
{"id": "David_Passim_2840", "series": "CAG", "text": "κατασκευάζουσι δὲ τοῦτο καὶ διὰ συλλογισμῶν, ὅτι ὁ ἄνθρωπος γένος ἐστί·", "seq": 2840}
{"id": "David_Passim_2841", "series": "CAG", "text": "φασὶ γάρ·", "seq": 2841}
{"id": "David_Passim_2842", "series": "CAG", "text": "εἰ ὁ ἄνθρωπος ζῷόν ἐστι, τὸ δὲ ζῷον γένος, ὁμολογουμένως καὶ ὁ ἄνθρωπος γένος ἐστί.", "seq": 2842}
{"id": "David_Passim_2843", "series": "CAG", "text": "φαμὲν δὲ πρὸς αὐτοὺς ὅτι πλανᾶσθε·", "seq": 2843}
{"id": "David_Passim_2844", "series": "CAG", "text": "μὴ γινώσκοντες γὰρ ὅτι κατὰ τὸ πρᾶγμα μεταδίδωσι τὸ γένος τῷ εἴδει ὀνόματος καὶ πράγματος, οὐχὶ δὲ κατὰ τὴν σχέσιν, λέγετε ταὐτὸν εἶναι γένος καὶ εἶδος·", "seq": 2844}
{"id": "David_Passim_2845", "series": "CAG", "text": "διαφέρει γὰρ τὸ γένος τοῦ εἴδους, κἂν μεταδίδωσιν αὐτῷ ὀνόματος καὶ πράγματος, καθὸ κατὰ τὴν σχέσιν οὐ μεταδίδωσί τί ποτε τῷ εἴδει·", "seq": 2845}
{"id": "David_Passim_2846", "series": "CAG", "text": "εἰ γὰρ μετεδίδου, καλῶς ἂν ἐλέγετε.", "seq": 2846}
{"id": "David_Passim_2847", "series": "CAG", "text": "εἰ ἐδείχθη οὖν ὅτι οὐ ταὐτόν ἐστι γένος καὶ εἶδος, σαφὲς ὅτι καὶ τὸ γένος συνίσταται καὶ ὁ ὁρισμὸς αὐτοῦ ἄλλο τι οὐ συμπεριλαμβάνει.", "seq": 2847}
{"id": "David_Passim_2848", "series": "CAG", "text": "Δεύτερον δὲ πάλιν ἐγκαλοῦσι λέγοντες ὑπὸ ἁμαρτίαν ἀνάγεσθαι τὸ γένος, καθὸ πολλαχῶς οὐ λαμβάνεται ὥσπερ καὶ τὸ εἶδος·", "seq": 2848}
{"id": "David_Passim_2849", "series": "CAG", "text": "ἔστι γὰρ Ἀριστοτελικὸς κανὼν φάσκων ὅτι ὁσαχῶς λαμβάνεται θάτερον τῶν ἀντικειμένων, τοσαυταχῶς καὶ τὸ ἕτερον·", "seq": 2849}
{"id": "David_Passim_2850", "series": "CAG", "text": "εἰ οὖν τὸ γένος καὶ τὸ εἶδος τῶν πρός τί εἰσι, πολλαχῶς δὲ λαμβάνεται τὸ εἶδος (λέγω γὰρ καὶ ἄνθρωπον καὶ ἵππον καὶ κύνα καὶ ἄλλα τινά, ἅπερ μόνῳ τῷ ζῴῳ ἀντίκειται), ὤφειλε καὶ τὸ ζῷον πολλαχῶς λαμβάνεσθαι ὥσπερ καὶ τὸ εἶδος.", "seq": 2850}
{"id": "David_Passim_2851", "series": "CAG", "text": "νῦν δὲ εἰ τοῦτο οὐ γίνεται (πολλὰ γὰρ τὰ εἴδη, ἓν δὲ τὸ γένος), ὁμολογουμένως ἁμαρτίᾳ μεγάλῃ τὸ τοιοῦτον περιπίπτει·", "seq": 2851}
{"id": "David_Passim_2852", "series": "CAG", "text": "οὔτε γὰρ δύνασαι εἰπεῖν ὅτι ἑνὸς εἴδους κατηγορεῖται φυσικῶς, κατὰ συμβεβηκὸς δὲ πολλῶν, ἐπεὶ τούτῳ τῷ λόγῳ οὔτε γένος ἐστί·", "seq": 2852}
{"id": "David_Passim_2853", "series": "CAG", "text": "γένος γὰρ τὸ κατὰ πολλῶν εἰδῶν κατηγορούμενον·", "seq": 2853}
{"id": "David_Passim_2854", "series": "CAG", "text": "τὸ ἑνὸς γὰρ κατηγορούμενον οὐκέτι λέγεται γένος.", "seq": 2854}
{"id": "David_Passim_2855", "series": "CAG", "text": "φαμὲν δὲ πρὸς αὐτοὺς ὅτι οὐ κατ᾿ ἀριθμόν φησιν ὁ Ἀριστοτέλης ἀντικεῖσθαι τὰ τοιαῦτα καὶ ὁμοίως λαμβάνεσθαι, ἀλλὰ κατὰ τὴν φύσιν.", "seq": 2855}
{"id": "David_Passim_2856", "series": "CAG", "text": "ἀμέλει καὶ ἕνα πατέρα φαμὲν πέντε υἱῶν εἶναι πατέρα, τοσαυταχῶς δὲ τοὺς υἱοὺς λαμβάνεσθαι ὁσαχῶς καὶ ὁ πατήρ·", "seq": 2856}
{"id": "David_Passim_2857", "series": "CAG", "text": "καὶ γὰρ εἰ καὶ πλείονι ἀριθμῷ τὸν πατέρα παρέχονται, ἀλλ᾿ οὖν ὅμως πάντες μιᾷ φύσει ἀντίκεινται τῷ πατρὶ ὥσπερ καὶ ὁ εἷς υἱός.", "seq": 2857}
{"id": "David_Passim_2858", "series": "CAG", "text": "ἀλλὰ μὴν καὶ δεξιὸν ἕνα φαμὲν καὶ πέντε ἀριστεροὺς ὁμοίως λαμβάνεσθαι, καθὸ μιᾷ φύσει ἀλλήλοις ἀντίκεινται.", "seq": 2858}
{"id": "David_Passim_2859", "series": "CAG", "text": "τότε δὲ ὤφειλον ἐπιλαμβάνεσθαι, ὅταν τοὺς πολλοὺς ἀριστεροὺς οὐ κατὰ τὴν αὐτὴν φύσιν ἀντικεῖσθαι τῷ δεξιῷ εὕρωσιν.", "seq": 2859}
{"id": "David_Passim_2860", "series": "CAG", "text": "εἰ οὖν πάντες οἱ ἀριστεροὶ ὡς ἀριστεροὶ τῷ δεξιῷ ἀντίκεινται, ἀνεπίληπτος ὁ λόγος καθίσταται.", "seq": 2860}
{"id": "David_Passim_2861", "series": "CAG", "text": "οὐκ ἔστιν ἄρα ἄτοπον τὸ εἶδος πολλαχῶς λαμβανόμενον ὡς ἓν εἶδος τῷ γένει ἀντικεῖσθαι.", "seq": 2861}
{"id": "David_Passim_2862", "series": "CAG", "text": "Τρίτον λέγουσιν ὅτι ὁ ὁρισμὸς οὗτος τὸ καθόλου γένος οὐ συμπεριλαμβάνει·", "seq": 2862}
{"id": "David_Passim_2863", "series": "CAG", "text": "εὑρίσκομεν γὰρ ὅτι τούτου τοῦ καθόλου γένους οὐκ ἔστιν ἄλλο ἐπαναβεβηκός, οἱονεὶ τὸ κατηγορούμενον ἐπαναβεβηκὸς τούτου τοῦ γένους·", "seq": 2863}
{"id": "David_Passim_2864", "series": "CAG", "text": "ἐκ γὰρ τούτου τοῦ κατηγορουμένου ἐστὶν ἢ τὸ μερικὸν ἢ τὸ καθόλου·", "seq": 2864}
{"id": "David_Passim_2865", "series": "CAG", "text": "τῇ γὰρ προτεραίᾳ διείλομεν τὸ κατηγορούμενον εἴς τε τὴν μερικὴν καὶ εἰς τὴν καθόλου φωνήν·", "seq": 2865}
{"id": "David_Passim_2866", "series": "CAG", "text": "τούτου δὲ τοῦ καθόλου γένος ὁ προκείμενος ὁρισμὸς ἐδόθη, οὐχὶ δὲ καὶ τοῦ ἐπαναβεβηκότος.", "seq": 2866}
{"id": "David_Passim_2867", "series": "CAG", "text": "φαμὲν δὲ πρὸς αὐτοὺς ὅτι εἰ καὶ πιθανή ἐστιν ἡ ἀπορία, ἀλλ᾿ οὖν εὐχερὴς ἡ ἐπίλυσις·", "seq": 2867}
{"id": "David_Passim_2868", "series": "CAG", "text": "ὃν γὰρ λόγον ἐπὶ τοῦ ὁρισμοῦ τοῦ καθόλου ἐλέγομεν, τὸν αὐτὸν καὶ ἐπὶ τούτου τοῦ ὁρισμοῦ λέξομεν·", "seq": 2868}
{"id": "David_Passim_2869", "series": "CAG", "text": "ὡς γὰρ ἐκεῖνος ὁ ὁρισμὸς πάντα ὁρισμὸν ὁρίζων καὶ ἑαυτὸν ὁρίζει, οὕτω καὶ ὁ ὁρισμὸς οὗτος τὸ καθόλου γένος ὁρίζων καὶ τὸ ὑπερβεβηκὸς ὁρίζει·", "seq": 2869}
{"id": "David_Passim_2870", "series": "CAG", "text": "λέγων γὰρ τὸ κατὰ πλειόνων καὶ διαφερόντων τῷ εἴδει ἐν τῷ τί ἐστι κατηγορούμενον συμπεριλαμβάνει ἅμα καὶ τὸ ὑπερβεβηκὸς γένος·", "seq": 2870}
{"id": "David_Passim_2871", "series": "CAG", "text": "καὶ αὐτὸ γὰρ κατὰ πλειόνων καὶ διαφερόντων τῷ εἴδει κατηγορεῖται.", "seq": 2871}
{"id": "David_Passim_2872", "series": "CAG", "text": "οὐκ ἔστιν οὖν ἄτοπον εὑρεθῆναι καὶ ἄλλο ὑπερβεβηκὸς συμπεριλαμβανόμενον ὑπὸ τοῦ ὁρισμοῦ τῶν καθόλου γενῶν.", "seq": 2872}
{"id": "David_Passim_2873", "series": "CAG", "text": "Τέταρτον ἐπαποροῦσι λέγοντες ὅτι οὐ καλῶς ἔχει ὁ ὁρισμός·", "seq": 2873}
{"id": "David_Passim_2874", "series": "CAG", "text": "ἔστι γὰρ καθόλου γένος κατηγορούμενον πολλῶν οὐ τῷ εἴδει μόνον διαφερόντων, ἀλλὰ καὶ τῷ γένει.", "seq": 2874}
{"id": "David_Passim_2875", "series": "CAG", "text": "ὤφειλεν οὖν ὁ ὁρισμὸς ἔχειν οὕτως·", "seq": 2875}
{"id": "David_Passim_2876", "series": "CAG", "text": "τὸ κατὰ πλειόνων καὶ διαφερόντων τῷ γένει καὶ τῷ εἴδει ἐν τῷ τί ἐστι κατηγορούμενον.", "seq": 2876}
{"id": "David_Passim_2877", "series": "CAG", "text": "ἀπὸ παραδειγμάτων δὲ λέγουσι πῶς ἔστι τινὰ γένη κατηγορούμενά τινων τῷ γένει διαφερόντων.", "seq": 2877}
{"id": "David_Passim_2878", "series": "CAG", "text": "ἡ οὐσία κατηγορεῖται ἐμψύχου καὶ ἀψύχου·", "seq": 2878}
{"id": "David_Passim_2879", "series": "CAG", "text": "ἔστιν οὖν ἡ οὐσία γένος κατηγορούμενον κατὰ πλειόνων οὐ τῷ εἴδει μόνον διαφερόντων ἀλλὰ καὶ τῷ γένει.", "seq": 2879}
{"id": "David_Passim_2880", "series": "CAG", "text": "οἷον τὸ ἔμψυχον ἢ ζῷον ἢ ζῳόφυτον ἢ φυτόν.", "seq": 2880}
{"id": "David_Passim_2881", "series": "CAG", "text": "ταῦτα δὲ οὐ μόνον τῷ εἴδει διαφέρει ἀλλὰ καὶ τῷ γένει·", "seq": 2881}
{"id": "David_Passim_2882", "series": "CAG", "text": "τούτων γὰρ τὸ ἔμψυχον κατηγορεῖται ὡς γένος ἄλλων.", "seq": 2882}
{"id": "David_Passim_2883", "series": "CAG", "text": "τινὲς δὲ πρὸς ταῦτα ἀπολογούμενοι οὕτω φασίν, ὅτι πρὸς τὰ ἄνω εἴδη φαμὲν τὰ τοιαῦτα (οἷον τὸ ἔμψυχον καὶ τὸ ἄψυχον πρὸς τὴν οὐσίαν εἴδη εἰσί), πρὸς δὲ τὰ κάτω γένη, οἷον τὸ ἔμψυχον πρὸς τὸ ζῷον ζῳόφυτον καὶ φυτὸν γένος ὑπάρχει.", "seq": 2883}
{"id": "David_Passim_2884", "series": "CAG", "text": "καὶ ἔστι μὲν ἡ τοιαύτη ἀπολογία πιθανῶς εἰρημένη, οὐκ ἀκριβὴς δέ·", "seq": 2884}
{"id": "David_Passim_2885", "series": "CAG", "text": "τὸ γὰρ ἀληθὲς οὕτως ἔχει·", "seq": 2885}
{"id": "David_Passim_2886", "series": "CAG", "text": "φαμὲν γὰρ ὅτι τὸ καθόλου γένος κατηγορεῖται καὶ πλειόνων διαφερόντων τῷ γένει καὶ πλειόνων διαφερόντων τῷ εἴδει, καὶ ὅπου μὲν διαφερόντων τῷ γένει, ἐκεῖ πάντως καὶ τῷ εἴδει, ὅπου δὲ τῷ εἴδει διαφερόντων κατηγορεῖται, οὐ πάντως ἐκεῖ καὶ τῷ γένει.", "seq": 2886}
{"id": "David_Passim_2887", "series": "CAG", "text": "τοῦ μὲν πρώτου ἐστὶ τοῦτο παράδειγμα·", "seq": 2887}
{"id": "David_Passim_2888", "series": "CAG", "text": "ἡ οὐσία κατηγορεῖται τοῦ ἐμψύχου καὶ τοῦ ἀψύχου·", "seq": 2888}
{"id": "David_Passim_2889", "series": "CAG", "text": "ταῦτα γὰρ διαφέρει τῷ γένει, ἀλλὰ μὴν καὶ τῷ εἴδει.", "seq": 2889}
{"id": "David_Passim_2890", "series": "CAG", "text": "τοῦ δευτέρου δὲ τοῦτο·", "seq": 2890}
{"id": "David_Passim_2891", "series": "CAG", "text": "τὸ ζῷον κατηγορεῖται τοῦ ἵππου καὶ τοῦ ἀνθρώπου καὶ ἄλλων τινῶν·", "seq": 2891}
{"id": "David_Passim_2892", "series": "CAG", "text": "ταῦτα δὲ διαφέρει τῷ εἴδει, οὐκέτι δὲ καὶ τῷ γένει·", "seq": 2892}
{"id": "David_Passim_2893", "series": "CAG", "text": "ὁ γὰρ ἄνθρωπος μόνον εἶδός ἐστιν.", "seq": 2893}
{"id": "David_Passim_2894", "series": "CAG", "text": "ἐπεὶ οὖν ἀεὶ τὸ γένος κατηγορεῖται πλειόνων διαφερόντων τῷ εἴδει, οὐκ ἀεὶ δὲ διαφερόντων τῷ γένει, ἀναγκαίως ὁ Πορφύριος πρὸς τὸ ἀεὶ ἀποβλέπων τὸ διαφερόντων τῷ εἴδει εἶπεν, οὐχὶ δὲ τῷ γένει.", "seq": 2894}
{"id": "David_Passim_2895", "series": "CAG", "text": "οἱ γὰρ ὁρισμοὶ ἐξ οὐσιωδῶν φωνῶν συγκείμενοι τὸ ἀεὶ θέλουσιν ἔχειν·", "seq": 2895}
{"id": "David_Passim_2896", "series": "CAG", "text": "εἰ δὲ αἱ οὐσιώδεις φωναὶ οὐ θέλουσι ποτὲ μὲν εἶναι ποτὲ δὲ μὴ εἶναι, ἀλλ᾿ ἀεὶ εἶναι, ἀναγκαίως τὸ διαφερόντων τῷ γένει μὴ ἀεὶ ὂν παρῆκεν ὁ Πορφύριος.", "seq": 2896}
{"id": "David_Passim_2897", "series": "CAG", "text": "Πέμπτον ἔτι φασὶν τὸν ὁρισμὸν κακῶς ἔχειν·", "seq": 2897}
{"id": "David_Passim_2898", "series": "CAG", "text": "λέγουσι γὰρ ὅτι οὐ μόνον τῷ γένει ἁρμόζει ὁ ὁρισμὸς οὗτος, ἀλλὰ καὶ τῷ εἴδει·", "seq": 2898}
{"id": "David_Passim_2899", "series": "CAG", "text": "τὸ γὰρ ἁπλῶς εἶδος κατὰ πλειόνων καὶ διαφερόντων τῷ εἴδει κατηγορεῖται·", "seq": 2899}
{"id": "David_Passim_2900", "series": "CAG", "text": "ἔστι γὰρ ἐν ἐμοὶ εἶδος καὶ ἐν τῷ ἵππῳ εἶδος, ἀλλὰ μὴν καὶ ἐν ὅλοις τοῖς εἴδεσι.", "seq": 2900}
{"id": "David_Passim_2901", "series": "CAG", "text": "φαμὲν δὲ πρὸς τοῦτο ὅτι τὸ ἁπλῶς εἶδος γένος ἐστί·", "seq": 2901}
{"id": "David_Passim_2902", "series": "CAG", "text": "τὸ γὰρ ἐν ἐμοὶ καὶ ἐν τῷ ἵππῳ καὶ ἐν τῷ κυνὶ εἶδος γένος ἐστίν.", "seq": 2902}
{"id": "David_Passim_2903", "series": "CAG", "text": "ἀλλὰ μὴν καὶ ἡ ἁπλῶς διαφορὰ γένος ἡ οὖσα ἐν ἵππῳ καὶ κυνὶ καὶ ἄλλοις.", "seq": 2903}
{"id": "David_Passim_2904", "series": "CAG", "text": "οὐκ ἄτοπον δὲ τοῖς τοιούτοις ἁρμόζειν καὶ τὸν ὁρισμὸν γένους τάξιν ἐπέχουσι.", "seq": 2904}
{"id": "David_Passim_2905", "series": "CAG", "text": "τῇ μέντοι τοιᾷδε διαφορᾷ καὶ τῷ τοιῷδε εἴδει οὐχ ἁρμόσει.", "seq": 2905}
{"id": "David_Passim_2906", "series": "CAG", "text": "Πρᾶξις ιε΄.", "seq": 2906}
{"id": "David_Passim_2907", "series": "CAG", "text": "2.", "seq": 2907}
{"id": "David_Passim_2908", "series": "CAG", "text": "15 Ὃ καὶ ὑπογράφοντες ἀποδεδώκασιν.", "seq": 2908}
{"id": "David_Passim_2909", "series": "CAG", "text": "Εἴπομεν ἐν τῇ θεωρίᾳ πῶς ἐκ τῆς ἀσήμου φωνῆς τὴν σημαντικὴν δεῖ πρῶτον διαστέλλειν, καὶ εἶθ᾿ οὕτως τὴν σημαντικήν·", "seq": 2909}
{"id": "David_Passim_2910", "series": "CAG", "text": "αὐτὸς δὲ ὁ Πορφύριος τῆς σημαντικῆς διαστολὴν ποιεῖται ἐάσας τὴν διάκρισιν τῆς ἀσημάντου καὶ σημαντικῆς.", "seq": 2910}
{"id": "David_Passim_2911", "series": "CAG", "text": "ἔστιν οὖν ἡ σημαντικὴ ἢ καθόλου ἢ μερική.", "seq": 2911}
{"id": "David_Passim_2912", "series": "CAG", "text": "ἐλλιπὴς δὲ ἡ τοιαύτη διαίρεσις·", "seq": 2912}
{"id": "David_Passim_2913", "series": "CAG", "text": "οὔτε γὰρ συμπεριελάβομεν τὴν καθ᾿ ἕκαστα·", "seq": 2913}
{"id": "David_Passim_2914", "series": "CAG", "text": "ἄλλη γάρ ἐστιν ἡ μερικὴ καὶ ἄλλη ἡ καθ᾿ ἕκαστα·", "seq": 2914}
{"id": "David_Passim_2915", "series": "CAG", "text": "ἡ μὲν γὰρ μερικὴ ἀόριστός ἐστιν οἷον τὶς ἄνθρωπος, ἡ δὲ καθ᾿ ἕκαστα ὁριστὴ οἷον Σωκράτης.", "seq": 2915}
{"id": "David_Passim_2916", "series": "CAG", "text": "δεῖ οὖν λέγειν ὅτι ἡ σημαντικὴ ἢ καθόλου ἐστὶν ἢ καθ᾿ ἑνός·", "seq": 2916}
{"id": "David_Passim_2917", "series": "CAG", "text": "λέγων γὰρ καθ᾿ ἑνὸς δηλοῖς καὶ τὴν μερικὴν καὶ τὴν καθ᾿ ἕκαστα·", "seq": 2917}
{"id": "David_Passim_2918", "series": "CAG", "text": "ἓν γάρ τι δηλοῦσιν·", "seq": 2918}
{"id": "David_Passim_2919", "series": "CAG", "text": "ἀμέλει καὶ ἀνθορίζονται τί ἐστι μερικόν;", "seq": 2919}
{"id": "David_Passim_2920", "series": "CAG", "text": "καθ᾿ ἕκαστα πλανώμενον.", "seq": 2920}
{"id": "David_Passim_2921", "series": "CAG", "text": "τί ἐστι καθ᾿ ἕκαστα;", "seq": 2921}
{"id": "David_Passim_2922", "series": "CAG", "text": "μερικὸν ὡρισμένον.", "seq": 2922}
{"id": "David_Passim_2923", "series": "CAG", "text": "ἀλλὰ καὶ πάλιν οὕτω λέγοντες ἐλλιπῆ τὸν λόγον ἐῶμεν·", "seq": 2923}
{"id": "David_Passim_2924", "series": "CAG", "text": "τὰς γὰρ ὁμωνύμους φωνὰς παρήκαμεν·", "seq": 2924}
{"id": "David_Passim_2925", "series": "CAG", "text": "οὔτε γὰρ ἐν τοῖς καθ᾿ ἑνός εἰσι, καθὸ πολλὰς φύσεις δηλοῦσιν, οὔτε ἐν τοῖς καθόλου, καθὸ τὸ καθόλου καὶ ὀνόματος καὶ πράγματος μεταδίδωσιν, αἱ δὲ ὁμώνυμοι φωναὶ μόνον ὀνόματος.", "seq": 2925}
{"id": "David_Passim_2926", "series": "CAG", "text": "δεῖ οὖν λέγειν κατὰ πλειόνων, ἵνα ᾖ οὕτως ἡ διαίρεσις·", "seq": 2926}
{"id": "David_Passim_2927", "series": "CAG", "text": "ἡ σημαντικὴ φωνὴ ἤτοι κατὰ πλειόνων ἐστὶν ἢ καθ᾿ ἑνός.", "seq": 2927}
{"id": "David_Passim_2928", "series": "CAG", "text": "λέγων δὲ τὸ κατὰ πλειόνων εἰσφέρεις καὶ τὰς ὁμωνύμους καὶ τὰς συνωνύμους.", "seq": 2928}
{"id": "David_Passim_2929", "series": "CAG", "text": "καὶ περὶ μὲν τῶν ὁμωνύμων οὐκ ἔστιν ἡμῖν ἐνταῦθα φροντίς, περὶ δὲ τῶν συνωνύμων·", "seq": 2929}
{"id": "David_Passim_2930", "series": "CAG", "text": "αὗται γὰρ αἱ πέντε φωναὶ συνώνυμοί εἰσι.", "seq": 2930}
{"id": "David_Passim_2931", "series": "CAG", "text": "καὶ ὅταν μὲν ἐν τῷ τί ἐστι κατηγορῶνται, δηλοῦσιν ἢ τὸ γένος ἢ τὸ εἶδος, ὅταν δὲ ἐν τῷ ὁποῖόν τί ἐστιν, εἰ μὲν οὐσιωδῶς κατηγοροῦνται, δηλοῦσι τὴν διαφοράν, εἰ δὲ ἐπουσιωδῶς, εἰ μὲν μίαν φύσιν δηλοῦσι, τότε τὸ ἴδιον, εἰ δὲ κοινόν τι σημαίνουσι, τότε τὸ συμβεβηκός.", "seq": 2931}
{"id": "David_Passim_2932", "series": "CAG", "text": "2.", "seq": 2932}
{"id": "David_Passim_2933", "series": "CAG", "text": "15 Ὅ καὶ ὑπογράφοντες.", "seq": 2933}
{"id": "David_Passim_2934", "series": "CAG", "text": "Διὰ τί οὐκ εἶπεν ‘ὑπογράφων’, ἀλλ᾿ ὑπογράφοντες;", "seq": 2934}
{"id": "David_Passim_2935", "series": "CAG", "text": "διὰ τοῦτό φασιν, ἵνα δείξῃ τὸν ὁρισμὸν μὴ εἶναι ἴδιον, ἀλλὰ τῶν Περιπατητικῶν, οἷς εἶπε παρακολουθεῖν.", "seq": 2935}
{"id": "David_Passim_2936", "series": "CAG", "text": "2.", "seq": 2936}
{"id": "David_Passim_2937", "series": "CAG", "text": "17 Τῶν κατηγορουμένων τὰ μὲν καθ᾿ ἑνὸς λέγεται μόνου ὡς τὰ ἄτομα.", "seq": 2937}
{"id": "David_Passim_2938", "series": "CAG", "text": "Διάκρισιν ποιεῖται τῆς σημαντικῆς, ἵνα δείξῃ πῶς διακρίνει τὸ γένος ἐκ τῶν σημαινουσῶν φωνῶν.", "seq": 2938}
{"id": "David_Passim_2939", "series": "CAG", "text": "ἥμαρτε δέ, ὡς εἴπομεν, μὴ διακρίνων τὴν ἄσημον πρῶτον ἐκ τῆς σημαντικῆς, καὶ εἶθ᾿ οὕτως τὴν σημαντικὴν ἐκ τῆς κατὰ πλειόνων καὶ καθ᾿ ἑνός.", "seq": 2939}
{"id": "David_Passim_2940", "series": "CAG", "text": "εἴπομεν δὲ ὅτι καλῶς εἶπε καθ᾿ ἑνὸς καὶ καὶ οὐχὶ μερικήν·", "seq": 2940}
{"id": "David_Passim_2941", "series": "CAG", "text": "ἔμελλε γὰρ ἐᾶν τὴν καθ᾿ ἕκαστα λέγων τὴν μερικήν.", "seq": 2941}
{"id": "David_Passim_2942", "series": "CAG", "text": "2.", "seq": 2942}
{"id": "David_Passim_2943", "series": "CAG", "text": "18 Οἷον Σωκράτης καὶ τὸ οὗτος καὶ τὸ τοῦτο.", "seq": 2943}
{"id": "David_Passim_2944", "series": "CAG", "text": "Διὰ τῶν προκειμένων παραδειγμάτων δηλοῖ καὶ τὴν καθ᾿ ἕκαστα καὶ τὴν μερικήν·", "seq": 2944}
{"id": "David_Passim_2945", "series": "CAG", "text": "ἐν μὲν γὰρ τῷ λέγειν Σωκράτης δηλοῖ τὴν καθ᾿ ἕκαστα (ὥρισται γάρ), ἐν δὲ τῷ λέγειν οὗτος καὶ τοῦτο δηλοῖ τὴν μερικήν·", "seq": 2945}
{"id": "David_Passim_2946", "series": "CAG", "text": "ἀόριστον γὰρ τὸ τοῦτο ἐκεῖνο, καθὸ δύναται ἐν πολλοῖς εἶναι, ὁ μέντοι Σωκράτης οὐ δύναται εἶναι ἐν Ἀλκιβιάδῃ.", "seq": 2946}
{"id": "David_Passim_2947", "series": "CAG", "text": "2.", "seq": 2947}
{"id": "David_Passim_2948", "series": "CAG", "text": "18 Τὰ δὲ κατὰ πλειόνων.", "seq": 2948}
{"id": "David_Passim_2949", "series": "CAG", "text": "Καλῶς εἶπε κατὰ πλειόνων καὶ οὐχὶ καθόλου·", "seq": 2949}
{"id": "David_Passim_2950", "series": "CAG", "text": "ἤμελλε γὰρ ἐᾶν τὰς ὁμωνύμους φωνὰς λέγων καθόλου.", "seq": 2950}
{"id": "David_Passim_2951", "series": "CAG", "text": "2.", "seq": 2951}
{"id": "David_Passim_2952", "series": "CAG", "text": "19 Καὶ τὰ συμβεβηκότα κοινῶς ἀλλὰ μὴ ἰδίως τινί.", "seq": 2952}
{"id": "David_Passim_2953", "series": "CAG", "text": "Καλῶς εἶπε κοινῶς τὸ συμβεβηκὸς λαμβάνεσθαι καὶ μὴ ἰδίως·", "seq": 2953}
{"id": "David_Passim_2954", "series": "CAG", "text": "ὅταν γὰρ ἰδίως ληφθῇ, τότε οὐ κατὰ πλειόνων λέγεται τὸ συμβεβηκός, ἀλλὰ καθ᾿ ἑνός, οἷον ἡ οὐλὴ τοῦ Ὀδυσσέως ἴδιον συμβεβηκός ἐστιν, οὐκέτι δὲ φέρεται τοῦτο καὶ ἐπὶ ἄλλου.", "seq": 2954}
{"id": "David_Passim_2955", "series": "CAG", "text": "τὸ μέντοι λευκὸν καὶ μέλαν κοινὰ συμβεβηκότα εἰσὶ καὶ κατὰ πλειόνων φέρεται.", "seq": 2955}
{"id": "David_Passim_2956", "series": "CAG", "text": "2.", "seq": 2956}
{"id": "David_Passim_2957", "series": "CAG", "text": "21 Συμβεβηκὸς δὲ οἷον τὸ λευκόν, τὸ μέλαν, τὸ καθέζεσθαι.", "seq": 2957}
{"id": "David_Passim_2958", "series": "CAG", "text": "Ζητεῖται διὰ τί ἐπὶ μὲν τῶν ἄλλων φωνῶν ἓν παράδειγμα παρατίθεται πρὸς μίαν καὶ ἑκάστην, ἐπὶ δὲ τοῦ συμβεβηκότος τρία παρέθετο.", "seq": 2958}
{"id": "David_Passim_2959", "series": "CAG", "text": "φαμὲν δὲ ὅτι διττοῦ ὄντος τοῦ συμβεβηκότος (τὸ μὲν γὰρ χωριστόν ἐστιν ὡς τὸ ἐν ἡμῖν λευκόν, τὸ δὲ ἀχώριστον ὡς τὸ ἐν Αἰθίοπι μέλαν), διττὰ καὶ τὰ παραδείγματα παρατίθεται ἀπὸ ὀνομάτων καὶ ῥημάτων.", "seq": 2959}
{"id": "David_Passim_2960", "series": "CAG", "text": "καὶ διὰ μὲν τῶν ὀνομάτων δηλοῖ τὸ ἀχώριστον (τὰ γὰρ ὀνόματα χρόνῳ οὐ μεταπίπτει), διὰ δὲ τῶν ῥημάτων δηλοῖ τὸ χωριστόν·", "seq": 2960}
{"id": "David_Passim_2961", "series": "CAG", "text": "ὥσπερ γὰρ τὰ ῥήματα χρόνῳ μεταπίπτει, οὕτω καὶ τὸ χωριστὸν συμβεβηκὸς χρόνῳ μεταπίπτει.", "seq": 2961}
{"id": "David_Passim_2962", "series": "CAG", "text": "2.", "seq": 2962}
{"id": "David_Passim_2963", "series": "CAG", "text": "22 Τῶν μὲν οὖν καθ᾿ ἑνὸς κατηγορουμένων διαφέρει τὰ γένη τῷ κατὰ πλειόνων ἀποδοθέντα κατηγορεῖσθαι.", "seq": 2963}
{"id": "David_Passim_2964", "series": "CAG", "text": "Εἰπὼν ὅτι τῶν καθ᾿ ἑνὸς διαφέρει τὰ γένη τῷ κατηγορεῖσθαι κατὰ πλειόνων, λέγει πάλιν πῶς διαφέρει τῶν κατὰ πλειόνων.", "seq": 2964}
{"id": "David_Passim_2965", "series": "CAG", "text": "2.", "seq": 2965}
{"id": "David_Passim_2966", "series": "CAG", "text": "27 Οἳ οὐ τῷ εἴδει διαφέρουσιν ἀλλὰ τῷ ἀριθμῷ.", "seq": 2966}
{"id": "David_Passim_2967", "series": "CAG", "text": "Τὰ γὰρ ἄτομα εἴδει οὐ διαφέρει, ἀλλὰ ἀριθμῷ.", "seq": 2967}
{"id": "David_Passim_2968", "series": "CAG", "text": "3.", "seq": 2968}
{"id": "David_Passim_2969", "series": "CAG", "text": "1 Ἀλλ᾿ οὐχὶ τῷ ἀριθμῷ μόνον.", "seq": 2969}
{"id": "David_Passim_2970", "series": "CAG", "text": "Ὁ γὰρ βοῦς καὶ ὁ ἄνθρωπος οὐ τῷ ἀριθμῷ διαφέρουσιν, ἀλλὰ τῷ εἴδει.", "seq": 2970}
{"id": "David_Passim_2971", "series": "CAG", "text": "3.", "seq": 2971}
{"id": "David_Passim_2972", "series": "CAG", "text": "1 Τοῦ δὲ ἰδίου διαφέρει τὸ γένος, ὅτι τὸ μὲν ἴδιον ἑνὸς εἴδους, οὗ ἐστιν ἴδιον, κατηγορεῖται καὶ τῶν ὑπὸ τὸ εἶδος ἀτόμων, ὡς τὸ γελαστικόν.", "seq": 2972}
{"id": "David_Passim_2973", "series": "CAG", "text": "Οὐχ ὥσπερ ἐν τῇ θεωρίᾳ ἐλέγομεν διαφέρειν τὸ γένος τοῦ ἰδίου, καθὸ ἐν τῷ τί ἐστι κατηγορεῖται τὸ γένος, ἐν δὲ τῷ ὁποῖόν τί ἐστι τὸ ἴδιον, οὕτω καὶ ἐνταῦθά φησι·", "seq": 2973}
{"id": "David_Passim_2974", "series": "CAG", "text": "λέγει γὰρ ὅτι ἐν τῷ λέγειν διαφερόντων τῷ εἴδει ἐκβάλλομεν τὸ εἶδος καὶ τὸ ἴδιον, τὸ μὲν εἶδος, καθὸ οὐ διαφερόντων τῷ εἴδει κατηγορεῖται, ἀλλὰ τῷ ἀριθμῷ, τὸ δὲ ἴδιον, καθὸ ἑνὸς εἴδους κατηγορεῖται, οὗ ἐστιν ἴδιον, καὶ τῶν ἀτόμων τοῦ εἴδους·", "seq": 2974}
{"id": "David_Passim_2975", "series": "CAG", "text": "τὸ γὰρ γελαστικὸν ἀνθρώπου μόνου καὶ Σωκράτους, τὸ δὲ γένος πολλῶν εἰδῶν κατηγορεῖται.", "seq": 2975}
{"id": "David_Passim_2976", "series": "CAG", "text": "3.", "seq": 2976}
{"id": "David_Passim_2977", "series": "CAG", "text": "5 Τῆς δ᾿ αὖ διαφορᾶς καὶ τῶν κοινῶς συμβεβηκότων διαφέρει τὸ γένος καὶ μέχρι ἀλλ᾿ οὐκ ἐν τῷ τί ἐστι κατηγοροῦνται.", "seq": 2977}
{"id": "David_Passim_2978", "series": "CAG", "text": "Φησὶν ὅτι εἰ καὶ κατὰ πλειόνων καὶ διαφερόντων τῷ εἴδει κατηγοροῦνται αἱ διαφοραὶ καὶ τὰ συμβεβηκότα, ἀλλ᾿ οὖν ὅμως τὸ μὲν γένος ἐν τῷ τί ἐστι κατηγορεῖται, ταῦτα δὲ ἐν τῷ ὁποῖόν τί ἐστι.", "seq": 2978}
{"id": "David_Passim_2979", "series": "CAG", "text": "πόθεν δὲ δῆλον, εἰ τὸ μὲν γένος ἐν τῷ τί ἐστι κατηγορεῖται, αἱ δὲ διαφοραὶ καὶ τὰ συμβεβηκότα ἐν τῷ ὁποῖόν τί ἐστιν;", "seq": 2979}
{"id": "David_Passim_2980", "series": "CAG", "text": "ἐκ τῆς ἐρωτήσεως·", "seq": 2980}
{"id": "David_Passim_2981", "series": "CAG", "text": "ἡ μὲν γὰρ ἐρώτησις τὴν ἀπόκρισιν ποιεῖ, ἡ δὲ ἀπόκρισις τὴν κατηγορίαν δηλοῖ·", "seq": 2981}
{"id": "David_Passim_2982", "series": "CAG", "text": "ἐρωτῶν γὰρ ‘ποῖος ἐστὶν ὁ ἄνθρωπος;’", "seq": 2982}
{"id": "David_Passim_2983", "series": "CAG", "text": "ἀκούεις ‘ἢ λευκὸς ἢ λογικός’, καὶ τὸ μὲν λευκὸν τὸ συμβεβηκὸς δηλοῖ, τὸ δὲ λογικὸν τὴν διαφοράν.", "seq": 2983}
{"id": "David_Passim_2984", "series": "CAG", "text": "ὥστε οὖν ἡ ἀπόκρισις δηλοῖ τὴν κατηγορίαν.", "seq": 2984}
{"id": "David_Passim_2985", "series": "CAG", "text": "ὅταν δὲ ἐρωτήσῃς ‘τί ἐστιν ὁ ἄνθρωπος;’", "seq": 2985}
{"id": "David_Passim_2986", "series": "CAG", "text": "ἀκούεις ‘ζῷον’·", "seq": 2986}
{"id": "David_Passim_2987", "series": "CAG", "text": "τὸ οὖν γένος ἐν τῷ τί ἐστι κατηγορεῖται.", "seq": 2987}
{"id": "David_Passim_2988", "series": "CAG", "text": "3.", "seq": 2988}
{"id": "David_Passim_2989", "series": "CAG", "text": "13 Ἦν δὲ ἀνθρώπου γένος τὸ ζῷον.", "seq": 2989}
{"id": "David_Passim_2990", "series": "CAG", "text": "Ἀναλαμβάνει πάλιν τὸν λόγον καί φησιν ἐν μὲν τῷ λέγειν τὸ γένος κατὰ πλειόνων κατηγορεῖσθαι, διαστέλλεται ἐκ τῶν καθ᾿ ἑνὸς (τὰ γὰρ καθ᾿ ἑνὸς τῶν ἀτόμων μόνων κατηγορεῖται), τῷ δὲ διαφερόντων τῷ εἴδει ἀπὸ τῶν εἰδῶν καὶ ἰδίων.", "seq": 2990}
{"id": "David_Passim_2991", "series": "CAG", "text": "3.", "seq": 2991}
{"id": "David_Passim_2992", "series": "CAG", "text": "17 Τὸ δὲ ἐν τῷ τί ἐστι κατηγορεῖσθαι χωρίζει ἀπὸ τῆς διαφορᾶς καὶ τῶν κοινῶς συμβεβηκότων.", "seq": 2992}
{"id": "David_Passim_2993", "series": "CAG", "text": "Ταῦτα γὰρ ἐν τῷ ὁποῖόν τί ἐστι κατηγορεῖται.", "seq": 2993}
{"id": "David_Passim_2994", "series": "CAG", "text": "ἐμάθομεν δὲ διὰ τί κοινῶς λέγεται τὰ συμβεβηκότα.", "seq": 2994}
{"id": "David_Passim_2995", "series": "CAG", "text": "3.", "seq": 2995}
{"id": "David_Passim_2996", "series": "CAG", "text": "19 Ἥ πῶς ἔχον.", "seq": 2996}
{"id": "David_Passim_2997", "series": "CAG", "text": "Ταὐτόν ἐστι τὸ ὁποῖόν τί ἐστι καὶ πῶς ἔχον.", "seq": 2997}
{"id": "David_Passim_2998", "series": "CAG", "text": "3.", "seq": 2998}
{"id": "David_Passim_2999", "series": "CAG", "text": "20 Ἡ τοῦ γένους ῥηθεῖσα ὑπογραφή.", "seq": 2999}
{"id": "David_Passim_3000", "series": "CAG", "text": "Κατὰ τὴν ἡμετέραν ἐπαγγελίαν εἴπωμεν πῶς ὁρισμός ἐστιν ὁ προκείμενος καὶ οὐχ ὑπογραφή.", "seq": 3000}
{"id": "David_Passim_3001", "series": "CAG", "text": "ὁρισμὸς τοίνυν ἐστὶ καὶ οὐχ ὑπογραφή, καθὸ ἐπὶ μὲν τῆς ὑπογραφῆς δυνατὸν αἱρουμένης μιᾶς φωνῆς τὴν ὑπογραφὴν σώζεσθαι, οἷον εἰ λέγεις ‘ὁ ἄνθρωπος ζῷόν ἐστι γελαστικὸν ὀρθοπεριπατητικόν’, σώζεται ἡ ὑπογραφὴ ‘ζῷον γελαστικόν’, ἐπὶ δὲ τοῦ ὁρισμοῦ αἱρουμένης μιᾶς φωνῆς οὐκέτι σώζεται ὁ ὁρισμός.", "seq": 3001}
{"id": "David_Passim_3002", "series": "CAG", "text": "[καὶ πῶς ὑπογραφὴν λέγει ὁ φιλόσοφος τὸ προκείμενον καὶ οὐχ ὁρισμόν;", "seq": 3002}
{"id": "David_Passim_3003", "series": "CAG", "text": "ὅτι πρὸς τὰ πράγματα ἀποβλέπει].", "seq": 3003}
{"id": "David_Passim_3004", "series": "CAG", "text": "ἔστω οὖν ὁ προκείμενος ὁρισμὸς καὶ οὐχ ὑπογραφή, καθὸ οὐ δυνάμεθα ἐκτὸς μιᾶς φωνῆς εἰπεῖν αὐτόν.", "seq": 3004}
{"id": "David_Passim_3005", "series": "CAG", "text": "καὶ γένος μὲν ἔχει τὴν ἁπλῶς φωνήν, συστατικὴν δὲ διαφορὰν τὴν ἀπὸ τῆς φωνῆς διαίρεσιν.", "seq": 3005}
{"id": "David_Passim_3006", "series": "CAG", "text": "διαιρεῖται δὲ εἰς ἄσημον καὶ σημαντικήν.", "seq": 3006}
{"id": "David_Passim_3007", "series": "CAG", "text": "Πρᾶξις ιϛʹ.", "seq": 3007}
{"id": "David_Passim_3008", "series": "CAG", "text": "Περὶ εἴδους.", "seq": 3008}
{"id": "David_Passim_3009", "series": "CAG", "text": "Τῇ τάξει τοῦ φιλοσόφου χρησάμενοι φυσικῇ οὔσῃ καὶ καταλλήλῳ τοῖς πράγμασιν, εὐλόγως μετὰ τὴν τοῦ γένους διδασκαλίαν ἐπὶ τὴν τοῦ εἴδους χωρήσομεν.", "seq": 3009}
{"id": "David_Passim_3010", "series": "CAG", "text": "ἀλλ᾿ ἐνταῦθά τινες ἡμῖν ἀποροῦσι λέγοντες ὅτι τὴν διαφορὰν προτάξαι ὀφείλομεν ὥσπερ ἐν τοῖς ἄνω, ἢ τὸ εἶδος ὤφειλεν ἐν τοῖς ἄνω προτάσσεσθαι τῆς διαφορᾶς·", "seq": 3010}
{"id": "David_Passim_3011", "series": "CAG", "text": "τὸ γὰρ προτάττειν τοῦ εἴδους ἐν τοῖς ἄνω τὴν διαφορὰν καὶ ὧδε τῆς διαφορᾶς τὸ εἶδος ἀκατάλληλον ποιεῖ τὸν λόγον.", "seq": 3011}
{"id": "David_Passim_3012", "series": "CAG", "text": "φαμὲν δὲ ὅτι δικαίως ἐκεῖ μὲν τὴν διαφορὰν προέταξεν ὧδε δὲ τὸ εἶδος·", "seq": 3012}
{"id": "David_Passim_3013", "series": "CAG", "text": "ἐπεὶ γὰρ ἐκεῖσε πρώτη τάξις ὑπάρχει, εὐλόγως τῇ διαφορᾷ ἡ πρώτη τάξις ἐδόθη ἐκ τῆς φύσεως·", "seq": 3013}
{"id": "David_Passim_3014", "series": "CAG", "text": "φυσικῶς γὰρ προτάττεται τοῦ εἴδους·", "seq": 3014}
{"id": "David_Passim_3015", "series": "CAG", "text": "καθολικωτέρα γάρ ἐστι τοῦ εἴδους ὡς ἁπλουστέρα.", "seq": 3015}
{"id": "David_Passim_3016", "series": "CAG", "text": "ἀλλὰ μὴν καὶ αἰτία αὐτοῦ ἐστιν·", "seq": 3016}
{"id": "David_Passim_3017", "series": "CAG", "text": "αὕτη γὰρ τέμνει τὸ γένος εἰς εἴδη.", "seq": 3017}
{"id": "David_Passim_3018", "series": "CAG", "text": "ὧδε δὲ τῆς διαφορᾶς εὐλόγως τὸ εἶδος προτάττεται, καθὸ τῶν πρός τί ἐστι τὸ εἶδος καὶ τὸ γένος·", "seq": 3018}
{"id": "David_Passim_3019", "series": "CAG", "text": "ὁριζομένου δὲ τοῦ γένους πάντως μνήμη τοῦ εἴδους γίνεται·", "seq": 3019}
{"id": "David_Passim_3020", "series": "CAG", "text": "ἀνθέλκει γὰρ τὸ γένος τὸ εἶδος.", "seq": 3020}
{"id": "David_Passim_3021", "series": "CAG", "text": "ἐπεὶ οὖν πρὸ ὀλίγου τὸ γένος ὡρισάμεθα, ἀνάγκη ἐστὶ καὶ τὸ εἶδος ὁρίσασθαι.", "seq": 3021}
{"id": "David_Passim_3022", "series": "CAG", "text": "σχεδὸν δὲ ἐπὶ τοῦ γένους καὶ ἐπὶ τοῦ εἴδους ἡ αὐτὴ διδασκαλία γίνεται·", "seq": 3022}
{"id": "David_Passim_3023", "series": "CAG", "text": "τῶν γὰρ πρός τί εἰσιν.", "seq": 3023}
{"id": "David_Passim_3024", "series": "CAG", "text": "ἀλλὰ μὴν καὶ οὐκ ἠδυνάμεθα τὸ γένος ὁρίσασθαι καὶ εὐθέως τὴν διαφοράν, καὶ ἐᾶσαι τὸν περὶ τοῦ εἴδους λόγον ἐκκρεμῆ·", "seq": 3024}
{"id": "David_Passim_3025", "series": "CAG", "text": "μνείαν γὰρ τοῦ εἴδους ἐν τῷ ὁρισμῷ τοῦ γένους πεποιήμεθα.", "seq": 3025}
{"id": "David_Passim_3026", "series": "CAG", "text": "Ἐπεὶ οὖν τὴν τάξιν ἐγνώκαμεν, φέρε καὶ ἐπὶ τὴν λείπουσαν διδασκαλίαν χωρήσωμεν·", "seq": 3026}
{"id": "David_Passim_3027", "series": "CAG", "text": "δεῖ γὰρ πρῶτον Ἀριστοτελικῷ νόμῳ κεχρημένους διαστείλασθαι τὴν ὁμωνυμίαν καὶ εἰπεῖν περὶ ποίου σημαινομένου ἐστὶν ὁ λόγος καὶ ὕστερον τὴν περὶ τούτου διδασκαλίαν προαγαγεῖν·", "seq": 3027}
{"id": "David_Passim_3028", "series": "CAG", "text": "ὁμώνυμος γὰρ φωνὴ τὸ εἶδος καὶ πάντως τοῦτο ἀπαιτεῖ.", "seq": 3028}
{"id": "David_Passim_3029", "series": "CAG", "text": "ἔστιν οὖν διττὸν τὸ εἶδος·", "seq": 3029}
{"id": "David_Passim_3030", "series": "CAG", "text": "λέγεται γὰρ εἶδος καὶ ἡ μορφή, ὥσπερ καὶ ἐν Φοινίσσαις ὁ Εὐριπίδης φησὶ", "seq": 3030}
{"id": "David_Passim_3031", "series": "CAG", "text": "πρῶτον μὲν εἶδος ἄξιον τυραννίδος.", "seq": 3031}
{"id": "David_Passim_3032", "series": "CAG", "text": "ἀλλὰ μὴν καὶ ἡ συνήθεια τοῦτο αὐτὸ δηλοῖ τὸν εὔμορφον εὐειδῆ καλοῦσα καὶ τὸν ἄμορφον δυσειδῆ.", "seq": 3032}
{"id": "David_Passim_3033", "series": "CAG", "text": "λέγεται δὲ καὶ εἶδος τὸ ὑποτασσόμενον τῷ γένει, ὥσπερ ὁ ἄνθρωπος εἶδος τοῦ ζῴου λέγεται.", "seq": 3033}
{"id": "David_Passim_3034", "series": "CAG", "text": "ἐγνωκότες οὖν ποσαχῶς λέγεται τὸ εἶδος, φέρε εἴπωμεν καὶ περὶ ποίου σημαινομένου ἐστὶν ὁ λόγος.", "seq": 3034}
{"id": "David_Passim_3035", "series": "CAG", "text": "περὶ τοῦ κατὰ φιλοσοφίαν τοίνυν εἴδους ὁ λόγος ἡμῖν ὑπάρχει.", "seq": 3035}
{"id": "David_Passim_3036", "series": "CAG", "text": "ἀλλὰ πρὸ τῆς τούτου διδασκαλίας ἀναγκαῖον εἰπεῖν τί φιλόψογοί τινες ἐγκαλοῦσι τῷ φιλοσόφῳ, καὶ ὕστερον ἐπ᾿ αὐτὴν βαδίσωμεν.", "seq": 3036}
{"id": "David_Passim_3037", "series": "CAG", "text": "ἐγκαλοῦσι δέ τινες λέγοντες ὅτι οὐκ εἶπεν ἐπὶ τοῦ εἴδους πολλαχῶς εἶναι τὸ σημαινόμενον ὥσπερ καὶ ἐπὶ τοῦ γένους.", "seq": 3037}
{"id": "David_Passim_3038", "series": "CAG", "text": "φαμὲν δὲ πρὸς τούτους ὅτι περὶ τοῦ γένους διαλαμβάνων εἶπε μὴ ἁπλῶς καὶ τὸ εἶδος λέγεσθαι, τοῦτ᾿ ἔστι μοναχῶς, λέγων ἔοικε δὲ τὸ γένος καὶ τὸ εἶδος μὴ ἁπλῶς λέγεσθαι.", "seq": 3038}
{"id": "David_Passim_3039", "series": "CAG", "text": "ἕτεροι δὲ ἐγκαλοῦσι, καθὸ οὐ λέγει περὶ ποίου σημαινομένου τοῦ εἴδους ἐστὶν αὐτῷ ὁ λόγος.", "seq": 3039}
{"id": "David_Passim_3040", "series": "CAG", "text": "οἱ δὲ πάνυ κακῶς ἐπιλαμβάνονται·", "seq": 3040}
{"id": "David_Passim_3041", "series": "CAG", "text": "εἰ γὰρ ὅλως περὶ εἴδους διαλαμβάνει, πάντως περὶ τοῦ κατὰ φιλοσοφίαν διαλήψεται, ἐπειδὴ καὶ περὶ τοῦ κατὰ φιλοσοφίαν γένους διέλαβεν.", "seq": 3041}
{"id": "David_Passim_3042", "series": "CAG", "text": "ἐπεὶ οὖν ἠλέγξαμεν τοὺς μάτην ἐγκαλοῦντας τῷ φιλοσόφῳ, φέρε τὴν περὶ τοῦ εἴδους διδασκαλίαν, ὡς ἐπηγγειλάμεθα, σαφηνίσωμεν.", "seq": 3042}
{"id": "David_Passim_3043", "series": "CAG", "text": "Τριχῶς τοίνυν ὁρίζεται τὸ εἶδος·", "seq": 3043}
{"id": "David_Passim_3044", "series": "CAG", "text": "λέγεται γὰρ εἶδος καὶ τὸ ὑποτασσόμενον τῷ γένει, λέγεται δὲ εἶδος καὶ οὗ κατηγορεῖται τὸ γένος, ἀλλὰ μὴν καὶ τὸ κατὰ πλειόνων καὶ διαφερόντων τῷ ἀριθμῷ ἐν τῷ τί ἐστι κατηγορούμενον.", "seq": 3044}
{"id": "David_Passim_3045", "series": "CAG", "text": "ἰστέον δὲ ὅτι οἱ πρῶτοι δύο ὁρισμοὶ κοινωνίαν ἔχουσι πρὸς ἀλλήλους καὶ διαφοράν·", "seq": 3045}
{"id": "David_Passim_3046", "series": "CAG", "text": "καὶ κοινωνίαν μέν, καθὸ οἱ δύο τὸ εἶδος ὁρίζονται, διαφορὰν δέ, καθὸ ὁ μὲν πρῶτος ἔχει τὴν σχέσιν ἀπὸ τοῦ εἴδους ἐπὶ τὸ γένος χωροῦσαν ὁ λέγων τὸ ὑποτασσόμενον τῷ γένει, ὁ δὲ ἕτερος ἀπὸ τοῦ γένους ἐπὶ τὸ εἶδος ὁ λέγων οὗ κατηγορεῖται τὸ γένος.", "seq": 3046}
{"id": "David_Passim_3047", "series": "CAG", "text": "ἀλλὰ μὴν καὶ ὁ τρίτος κοινωνίαν ἔχει πρὸς τούτους καὶ διαφοράν·", "seq": 3047}
{"id": "David_Passim_3048", "series": "CAG", "text": "κοινωνίαν μέν, καθὸ καὶ αὐτὸς τὸ εἶδος ὁρίζεται, διαφορὰν δέ, καθὸ αὐτὸς μὲν τοῦ εἰδικωτάτου εἴδους κατηγορεῖται, αὐτοὶ δὲ τοῦ ἀλλεπαλλήλου.", "seq": 3048}
{"id": "David_Passim_3049", "series": "CAG", "text": "καὶ εἰδικώτατον μέν, ὅτι φησὶν εἶδός ἐστι τὸ κατὰ πλειόνων καὶ διαφερόντων τῷ ἀριθμῷ ἐν τῷ τί ἐστι κατηγορούμενον (τὸ τοιοῦτον δὲ σημαίνει τὸν ἄνθρωπον·", "seq": 3049}
{"id": "David_Passim_3050", "series": "CAG", "text": "ὁ γὰρ ἄνθρωπος πολλῶν κατηγορεῖται διαφερόντων τῷ ἀριθμῷ), ἀλλεπαλλήλου δὲ οὗτοι κατηγοροῦνται, καθὸ οὐχ ὁρίζουσι τὸ εἶδος τὸ κατὰ πλειόνων καὶ διαφερόντων τῷ ἀριθμῷ ἐν τῷ τί ἐστι κατηγορούμενον, ἀλλὰ τὸ εἶδος τὸ ὑποτασσόμενον τῷ γένει καὶ οὗ κατηγορεῖται τὸ γένος.", "seq": 3050}
{"id": "David_Passim_3051", "series": "CAG", "text": "δυνατὸν δὲ τοῦτο καὶ ἐπὶ τοῦ ἀνθρώπου λαμβάνεσθαι καὶ ἐπὶ τοῦ ζῴου·", "seq": 3051}
{"id": "David_Passim_3052", "series": "CAG", "text": "καὶ γὰρ τὸ ζῷον εἶδός ἐστιν ὑποτασσόμενον τῷ γένει καὶ οὗ κατηγορεῖται τὸ γένος.", "seq": 3052}
{"id": "David_Passim_3053", "series": "CAG", "text": "τινὲς δὲ διαβάλλουσι τὸν λόγον ὡς διάλληλον ὄντα·", "seq": 3053}
{"id": "David_Passim_3054", "series": "CAG", "text": "ἐν μὲν γὰρ τῷ ὁρισμῷ τοῦ γένους εἴδους ἐμνησάμεθα, ἐν δὲ τῷ ὁρισμῷ τοῦ εἴδους γένους ὡσαύτως ἐμνησάμεθα.", "seq": 3054}
{"id": "David_Passim_3055", "series": "CAG", "text": "ἀγνοοῦσι δὲ οἱ τοιοῦτοι ὅτι μᾶλλον ἐπὶ τῶν πρός τι δεκτέος ἐστὶν ὁ διάλληλος λόγος ἤπερ ἀποβλητέος.", "seq": 3055}
{"id": "David_Passim_3056", "series": "CAG", "text": "τοὐναντίον δὲ εἰ μὴ δι᾿ ἀλλήλων ὡρίζοντο, ὑπὸ ἔγκλησιν ἔπιπτον.", "seq": 3056}
{"id": "David_Passim_3057", "series": "CAG", "text": "καὶ εὖγε τῆς ἐπιλύσεως, ὅτι οὐ μόνον ἐνέδραμεν εἰς τὰς ἡμετέρας ψυχάς, ἀλλὰ καὶ ἐπὶ ἑτέραν ἡμᾶς ποδηγεῖ ἀπορίαν·", "seq": 3057}
{"id": "David_Passim_3058", "series": "CAG", "text": "εἰκὸς γάρ τινα ἀπορῆσαι διὰ τί ἐπὶ τοῦ ὑστέρου ὁρισμοῦ οὐκ ἔστι διάλληλος ὁ λόγος·", "seq": 3058}
{"id": "David_Passim_3059", "series": "CAG", "text": "οὔτε γάρ ἐστιν ἐν αὐτῷ μνεία τοῦ γένους·", "seq": 3059}
{"id": "David_Passim_3060", "series": "CAG", "text": "ἄτοπον ἄρα ὑπάρχει τὸ τοιοῦτον.", "seq": 3060}
{"id": "David_Passim_3061", "series": "CAG", "text": "ἀλλ᾿ ἔστιν εἰπεῖν ὅτι ἔστι μὲν ἐν αὐτῷ διάλληλος ὁ λόγος, ἀλλ᾿ οὐχ ὥσπερ οἱ πρῶτοι ἔχουσι τὸν διάλληλον λόγον, οὕτω καὶ οὗτος·", "seq": 3061}
{"id": "David_Passim_3062", "series": "CAG", "text": "ἐπὶ μὲν γὰρ ἐκείνων διάλληλος ὁ λόγος ὑπάρχει, καθὸ τοῦ γένους ἐμνήσατο, ἐπὶ δὲ τούτου, καθὸ καὶ τὰ ἄτομα εἰσφέρει καὶ ὑπὸ ἀτόμων εἰσφέρεται.", "seq": 3062}
{"id": "David_Passim_3063", "series": "CAG", "text": "ἰστέον δὲ ὅτι ἐπὶ τῶν τριῶν ὁρισμῶν τρεῖς σχέσεις νοοῦνται·", "seq": 3063}
{"id": "David_Passim_3064", "series": "CAG", "text": "οἱ μὲν γὰρ δύο πρῶτοι τὴν ἀπὸ τοῦ γένους ἐπὶ τὸ εἶδος καὶ τὴν ἀπὸ τοῦ εἴδους ἐπὶ τὸ γένος ἔχουσιν (ὁ γὰρ λέγων οὗ κατηγορεῖται τὸ γένος δηλοῖ τὴν ἀπὸ τοῦ γένους ἐπὶ τὸ εἶδος, ὁ δὲ λέγων τὸ ὑποτασσόμενον τῷ γένει δηλοῖ τὴν ἀπὸ τοῦ εἴδους ἐπὶ τὸ γένος), ὁ δὲ τρίτος τὴν πρὸς τὰ ἄτομα ἔχει.", "seq": 3064}
{"id": "David_Passim_3065", "series": "CAG", "text": "οὐδεὶς δὲ τούτων τέλειος ὑπάρχει·", "seq": 3065}
{"id": "David_Passim_3066", "series": "CAG", "text": "οὔτε γὰρ οἱ πρῶτοι ἔχουσιν τὴν πρὸς τὰ ἄτομα σχέσιν οὔτε ὁ ὕστερος τὴν πρὸς τὸ γένος.", "seq": 3066}
{"id": "David_Passim_3067", "series": "CAG", "text": "διὰ τοῦτο χρὴ μᾶλλον οὕτως ὁρίζειν·", "seq": 3067}
{"id": "David_Passim_3068", "series": "CAG", "text": "εἶδός ἐστι τὸ ὑποτασσόμενον τῷ γένει κατὰ πλειόνων καὶ διαφερόντων τῷ ἀριθμῷ ἐν τῷ τί ἐστι κατηγορούμενον.", "seq": 3068}
{"id": "David_Passim_3069", "series": "CAG", "text": "3.", "seq": 3069}
{"id": "David_Passim_3070", "series": "CAG", "text": "21 Τὸ δὲ εἶδος λέγεται μὲν καὶ ἐπὶ τῆς ἑκάστου μορφῆς.", "seq": 3070}
{"id": "David_Passim_3071", "series": "CAG", "text": "Ζητοῦσι διὰ τί, πρὶν εἴπῃ διαφορὰν τοῦ εἴδους, τὸν συμπλεκτικὸν σύνδεσμον προήνεγκε.", "seq": 3071}
{"id": "David_Passim_3072", "series": "CAG", "text": "καί φασιν ἵνα δείξῃ ὅτι καὶ ἄνω ἄλλως λέγεται.", "seq": 3072}
{"id": "David_Passim_3073", "series": "CAG", "text": "ἀξία δὲ ἡ ἀπολογία τῆς ἀπορίας, ἀλλὰ γὰρ ὑπόψυχρος·", "seq": 3073}
{"id": "David_Passim_3074", "series": "CAG", "text": "τῷ γὰρ ὀρθῶς σκοποῦντι καλῶς ἔχει ἡ σύνταξις δηλονότι.", "seq": 3074}
{"id": "David_Passim_3075", "series": "CAG", "text": "4.", "seq": 3075}
{"id": "David_Passim_3076", "series": "CAG", "text": "3 Τὸ λευχὸν τοῦ χρώματος εἶδος.", "seq": 3076}
{"id": "David_Passim_3077", "series": "CAG", "text": "Γένος γάρ ἐστι τὸ χρῶμα·", "seq": 3077}
{"id": "David_Passim_3078", "series": "CAG", "text": "φέρεται γὰρ καὶ ἐπὶ τοῦ λευκοῦ καὶ ἐπὶ τοῦ μέλανος καὶ ἐπὶ τοῦ ξανθοῦ.", "seq": 3078}
{"id": "David_Passim_3079", "series": "CAG", "text": "εἴδη δὲ αὐτοῦ τὰ τοιαῦτα.", "seq": 3079}
{"id": "David_Passim_3080", "series": "CAG", "text": "4.", "seq": 3080}
{"id": "David_Passim_3081", "series": "CAG", "text": "4 Τὸ δὲ τρίγωνον τοῦ σχήματος εἶδος.", "seq": 3081}
{"id": "David_Passim_3082", "series": "CAG", "text": "Τὸ τρίγωνον εἶδος λέγεται, τὸ δὲ σχῆμα γένος.", "seq": 3082}
{"id": "David_Passim_3083", "series": "CAG", "text": "λέγουσι δέ τινες ὅτι κακῶς λέγει τὸ τρίγωνον εἶδος·", "seq": 3083}
{"id": "David_Passim_3084", "series": "CAG", "text": "οὐδέποτε γὰρ ἓν τῶν εἰδῶν τοῦ ἑτέρου προτερεύει, ὥσπερ ὁ ἄνθρωπος οὐ προτερεύει τοῦ ἵππου, οὐδὲ ὁ ἵππος τοῦ κυνός·", "seq": 3084}
{"id": "David_Passim_3085", "series": "CAG", "text": "τὸ δὲ τρίγωνον καὶ τετράγωνον εἴ φησιν ὁ Πορφύριος εἴδη, ἁμαρτάνει·", "seq": 3085}
{"id": "David_Passim_3086", "series": "CAG", "text": "προτερεύει γὰρ τὸ τρίγωνον τοῦ τετραγώνου·", "seq": 3086}
{"id": "David_Passim_3087", "series": "CAG", "text": "πάντως γὰρ ὁ τρία τοῦ τέσσαρα προηγεῖται.", "seq": 3087}
{"id": "David_Passim_3088", "series": "CAG", "text": "λέγουσι δέ τινες ὅτι πολλάκις ἐπειδὴ τὸ τρίγωνον εὐθύγραμμον λέγεται, τὸ δὲ τετράγωνον ἰσόγραμμον, κατὰ ταύτας δὲ τὰς φωνὰς ἕτερον ἑτέρου οὐ προτερεύει, πρὸς τὸ εὐθύγραμμον ἀποβλέπων εἶδος αὐτὸ ἐκάλεσεν.", "seq": 3088}
{"id": "David_Passim_3089", "series": "CAG", "text": "4.", "seq": 3089}
{"id": "David_Passim_3090", "series": "CAG", "text": "4 Εἰ δὲ καὶ τὸ γένος ἀποδιδόντες τοῦ εἴδους μεμνήμεθα εἰπόντες τὸ κατὰ πλειόνων καὶ διαφερόντων τῷ εἴδει ἐν τῷ τί ἐστι κατηγορούμενον, καὶ τὸ εἶδός φαμεν τὸ ὑπὸ τὸ ἀποδοθὲν γένος μέχρι τοῦ χρῆσθαι ἀμφοτέροις.", "seq": 3090}
{"id": "David_Passim_3091", "series": "CAG", "text": "Φησὶν ὅτι εἰ καὶ ὁρίζοντες τὸ γένος εἴδους ἐμνημονεύσαμεν εἰρηκότες ‘γένος ἐστὶ τὸ κατὰ πλειόνων καὶ διαφερόντων τῷ εἴδει’, καὶ πάλιν τὸ εἶδος ὁρίζοντες εἴπομεν ‘τὸ ὑποτασσόμενον τῷ ἀποδοθέντι γένει’, οὐ δόξει ὁ λόγος διάλληλος ὑπάρχων ὑπὸ ἁμαρτίαν ἄγειν ἡμᾶς·", "seq": 3091}
{"id": "David_Passim_3092", "series": "CAG", "text": "ταῦτα γὰρ τῶν πρός τι ὄντα οὐκ ἀποβάλλεται τὸν διάλληλον λόγον, τοὐναντίον δὲ ἀσπάζεται.", "seq": 3092}
{"id": "David_Passim_3093", "series": "CAG", "text": "4.", "seq": 3093}
{"id": "David_Passim_3094", "series": "CAG", "text": "8 Ἑκάτερον ἑκατέρου.", "seq": 3094}
{"id": "David_Passim_3095", "series": "CAG", "text": "Τοῦτ᾿ ἔστι διττοῦ.", "seq": 3095}
{"id": "David_Passim_3096", "series": "CAG", "text": "4.", "seq": 3096}
{"id": "David_Passim_3097", "series": "CAG", "text": "9 Ἀποδιδόασιν", "seq": 3097}
{"id": "David_Passim_3098", "series": "CAG", "text": "Ἀντὶ τοῦ ὁρίζουσιν.", "seq": 3098}
{"id": "David_Passim_3099", "series": "CAG", "text": "4.", "seq": 3099}
{"id": "David_Passim_3100", "series": "CAG", "text": "13 Αἱ δὲ ἄλλαι εἶεν ἂν καὶ τῶν μὴ εἰδικωτάτων.", "seq": 3100}
{"id": "David_Passim_3101", "series": "CAG", "text": "Φησὶν ὅτι οἱ ἄλλοι ὁρισμοὶ οὐ μόνον τῶν εἰδικωτάτων εἰσὶν εἰδῶν, ἀλλὰ καὶ τῶν ὑπαλλήλων.", "seq": 3101}
{"id": "David_Passim_3102", "series": "CAG", "text": "εἰρήσεται δὲ ἡμῖν πλατύτερον τί ἐστιν ὑπάλληλον εἶδος.", "seq": 3102}
{"id": "David_Passim_3103", "series": "CAG", "text": "Πρᾶξις ιζ΄.", "seq": 3103}
{"id": "David_Passim_3104", "series": "CAG", "text": "Αἰνιγματωδῶς εἰρηκότες περὶ τοῦ γένους καὶ τοῦ εἴδους ἐν τοῖς προλαβοῦσι, φέρε δὴ σαφηνείας χάριν παραδείγμασι χρησώμεθα οἱονεὶ δακτύλῳ δεικνύντες τὰ πράγματα, καὶ μάλιστα Ἀριστοτελικοῖς δοκίμοις οὖσι.", "seq": 3104}
{"id": "David_Passim_3105", "series": "CAG", "text": "πρὸ δὲ τῆς Ἀριστοτελικῆς διαιρέσεως φέρε τινὰ φωτίζοντα τὴν διαίρεσιν εἴπωμεν.", "seq": 3105}
{"id": "David_Passim_3106", "series": "CAG", "text": "τὸ γένος διχῶς λέγεται·", "seq": 3106}
{"id": "David_Passim_3107", "series": "CAG", "text": "λέγεται γὰρ γένος γενικώτατον, λέγεται καὶ ὑπάλληλον.", "seq": 3107}
{"id": "David_Passim_3108", "series": "CAG", "text": "ἀλλὰ μὴν καὶ τὸ εἶδος διχῶς λέγεται·", "seq": 3108}
{"id": "David_Passim_3109", "series": "CAG", "text": "τῶν γὰρ πρός τί ἐστι τὸ γένος καὶ τὸ εἶδος.", "seq": 3109}
{"id": "David_Passim_3110", "series": "CAG", "text": "ἐπεὶ οὖν ὡς λαμβάνεται τὸ γένος, οὕτω καὶ τὸ εἶδος, δικαίως αὐτῷ τὸ διττὸν ἀπεκλήρωσαν·", "seq": 3110}
{"id": "David_Passim_3111", "series": "CAG", "text": "λέγεται γὰρ καὶ εἶδος εἰδικώτατον, λέγεται καὶ εἶδος ὑπάλληλον.", "seq": 3111}
{"id": "David_Passim_3112", "series": "CAG", "text": "καὶ ἐπειδὴ τὸ μὲν γενικώτατον γένος ἐπαναβεβηκὸς αὐτῷ ἄλλο τι οὐκ ἔχει, διὰ τοῦτο καὶ ὑπερθετικῇ φωνῇ ἐχρησάμεθα (οὕτω γὰρ καὶ τὸ ἄγαν λευκὸν καὶ μὴ μετέχον μέλανος λευκότατόν φαμεν), τὸ δὲ ὑπάλληλον γένος ἔχει ὑπερβεβηκὸς γένος, ὅπερ καὶ εἶδος λέγεται, οἷον τὸ ζῷον τὴν οὐσίαν.", "seq": 3112}
{"id": "David_Passim_3113", "series": "CAG", "text": "πάλιν εἰδικώτατον εἶδος λέγεται, οὗ μή ἐστιν ὑποβεβηκὸς εἶδος (διὰ τοῦτο ἐπ᾿ αὐτοῦ ὑπερθετικῇ ἐχρησάμεθα), ὑπάλληλον δὲ εἶδός ἐστιν, ὃ μὴ μόνον εἶδος λέγεται, ἀλλὰ καὶ γένος.", "seq": 3113}
{"id": "David_Passim_3114", "series": "CAG", "text": "τὸ μὲν οὖν ἀκρότατον γένος γενικώτατον λέγεται, τὸ δὲ ἀκρότατον εἶδος εἰδικώτατον, τὸ δὲ μέσον γένος ὑπάλληλον γένος, τὸ δὲ μέσον εἶδος ὑπάλληλον εἶδος.", "seq": 3114}
{"id": "David_Passim_3115", "series": "CAG", "text": "ἔστιν οὖν κατανοῆσαι τρία ὄντα τὰ πράγματα καὶ τέσσαρας τὰς σχέσεις·", "seq": 3115}
{"id": "David_Passim_3116", "series": "CAG", "text": "δύο μὲν τὰ ἄκρα, ἓν δὲ τὸ ἐν μέσῳ, καὶ μία μὲν σχέσις ἐστὶν ἡ ἀπὸ τοῦ γενικωτάτου γένους πρὸς τὰ κάτω, μία δὲ ἡ ἀπὸ τοῦ εἰδικωτάτου εἴδους πρὸς τὰ ἄνω, δύο δὲ τῶν ὑπαλλήλων·", "seq": 3116}
{"id": "David_Passim_3117", "series": "CAG", "text": "ἔχουσι γὰρ μίαν πρὸς τὰ ἄνω καὶ μίαν πρὸς τὰ κάτω.", "seq": 3117}
{"id": "David_Passim_3118", "series": "CAG", "text": "ἐπεὶ οὖν ἐγνώκαμεν τρία εἶναι τὰ πράγματα, τέσσαρας δὲ τὰς σχέσεις, φέρε εἴπωμεν διὰ τί ὑπάλληλα τὰ τοιαῦτα λέγεται.", "seq": 3118}
{"id": "David_Passim_3119", "series": "CAG", "text": "τινὲς μὲν λέγουσιν ὅτι διὰ τοῦτο ὑπάλληλα λέγεται, ἐπειδὴ ἀλλήλοις ὑποτάσσεται.", "seq": 3119}
{"id": "David_Passim_3120", "series": "CAG", "text": "κακῶς δέ·", "seq": 3120}
{"id": "David_Passim_3121", "series": "CAG", "text": "τούτῳ γὰρ τῷ λόγῳ καὶ τὸ εἰδικώτατον εἶδος ὑπάλληλον λεχθήσεται ἄλλοις ὑποτασσόμενον·", "seq": 3121}
{"id": "David_Passim_3122", "series": "CAG", "text": "ὑπάλληλα γὰρ λέγεται, καθὸ δύνανται καὶ γένη εἶναι καὶ εἴδη, καὶ εἴδη μὲν πρὸς τὰ πρὸ ἑαυτῶν, γένη δὲ πρὸς τὰ μεθ᾿ ἑαυτά.", "seq": 3122}
{"id": "David_Passim_3123", "series": "CAG", "text": "καὶ ὑπάλληλον μὲν εἶδος λέγομεν τὸ δυνάμενον καὶ γένος εἶναι, ὑπάλληλον δὲ γένος τὸ δυνάμενον καὶ εἶδος εἶναι.", "seq": 3123}
{"id": "David_Passim_3124", "series": "CAG", "text": "τὸ ὑπάλληλον οὖν ἁρμόζει τοῖς δύο.", "seq": 3124}
{"id": "David_Passim_3125", "series": "CAG", "text": "ἰστέον δὲ ὅτι οὐ χρὴ λέγειν ὑπάλληλον γένος καὶ ὑπάλληλον εἶδος ἐπὶ τοῦ αὐτοῦ, ἵνα μὴ ἀδολεσχήσωμεν·", "seq": 3125}
{"id": "David_Passim_3126", "series": "CAG", "text": "ἀρκεῖ γὰρ τὸ ἕν·", "seq": 3126}
{"id": "David_Passim_3127", "series": "CAG", "text": "λέγων γὰρ ὑπάλληλον εἶδος δηλοῖς τὸ γένος καὶ ὑπάλληλον γένος δηλοῖς τὸ εἶδος·", "seq": 3127}
{"id": "David_Passim_3128", "series": "CAG", "text": "περὶ οὗ δὲ ὁ λόγος γίνεται, τὸ ὑπάλληλον προσλαμβάνει.", "seq": 3128}
{"id": "David_Passim_3129", "series": "CAG", "text": "Μαθόντες δὲ τί γενικώτατον γένος καὶ τί εἰδικώτατον εἶδος καὶ τί ὑπάλληλον, φέρε τὴν Ἀριστοτελικὴν διαίρεσιν παραθῶμεν, ὡς ἐπηγγειλάμεθα.", "seq": 3129}
{"id": "David_Passim_3130", "series": "CAG", "text": "ἵνα ἀκριβέστερα ἐξ αὐτῆς τὰ λεγόμενα ποιήσωμεν.", "seq": 3130}
{"id": "David_Passim_3131", "series": "CAG", "text": "οἱ Ἀριστοτελικοὶ τὸ γενικώτατον γένος οὕτω διαιροῦσιν·", "seq": 3131}
{"id": "David_Passim_3132", "series": "CAG", "text": "ἡ οὐσία ἢ σῶμα ἢ ἀσώματον, τὸ σῶμα ἢ ἔμψυχον ἢ ἄψυχον, τὸ ἔμψυχον ἢ ζῷον ἢ ζῳόφυτον ἢ φυτόν, τὸ ζῷον ἢ λογικὸν ἢ ἄλογον, τὸ λογικὸν ἢ θνητὸν ἢ ἀθάνατον, καὶ εἰ μὲν θνητόν, δηλοῖ τὸν ἄνθρωπον, εἰ δὲ ἀθάνατον, δηλοῖ τὸ θεῖον.", "seq": 3132}
{"id": "David_Passim_3133", "series": "CAG", "text": "καὶ τὴν μὲν οὐσίαν φασὶ γενικώτατον γένος, καθὸ ἐπαναβεβηκός τι αὐτῆς οὐκ ἔστιν ἕτερον γένος, εἰδικώτατον δὲ εἶδός φασι τὸν ἄνθρωπον, καθὸ ὑποβεβηκὸς αὐτοῦ εἶδος οὐκ ἔστι (τοῦτο γάρ ἐστι τὸ ἔσχατον), τὸ ζῷον δὲ καὶ τὸ ἔμψυχον ὑπάλληλα γένη καλοῦσιν, ἔτι δὲ καὶ ὑπάλληλα εἴδη, καθὸ μέσα ὄντα δύνανται καὶ γένη εἶναι καὶ εἴδη.", "seq": 3133}
{"id": "David_Passim_3134", "series": "CAG", "text": "ἐπειδὴ δὲ ἐπιλαμβάνονται τῆς τοιαύτης διαιρέσεως οἱ Πλατωνικοὶ καὶ οὐκ ὀλίγος ἐστὶν ὁ περὶ αὐτῆς λόγος, φέρε ὀλίγα περὶ τοῦ ζῴου καὶ ζῳοφύτου καὶ φυτοῦ ζητήσαντες καταπαύσωμεν τὴν θεωρίαν, ἐν ἑτέρᾳ τὰ ἐκ τῶν Πλατωνικῶν ἀντιτιθέμενα διδάσκειν εὐτρεπιζόμενοι.", "seq": 3134}
{"id": "David_Passim_3135", "series": "CAG", "text": "διαιρεῖται τοίνυν τὸ ἔμψυχον εἰς ζῷον ζῳόφυτον φυτόν.", "seq": 3135}
{"id": "David_Passim_3136", "series": "CAG", "text": "καὶ φυτόν ἐστι τὸ ἔχον τρεῖς δυνάμεις, τὴν γεννητικὴν τὴν αὐξητικὴν τὴν θρεπτικήν.", "seq": 3136}
{"id": "David_Passim_3137", "series": "CAG", "text": "καὶ εὖγε τῆς δημιουργίας τῆς φύσεως·", "seq": 3137}
{"id": "David_Passim_3138", "series": "CAG", "text": "χαρισαμένη γὰρ ἡμῖν τὴν γεννητικὴν ἐχαρίσατο καὶ τὴν αὐξητικήν, ἵνα δι᾿ αὐτῆς τέλειοι γενόμενοι ἐπιτήδειοι πρὸς τὸ γεννᾶν ἐσόμεθα·", "seq": 3138}
{"id": "David_Passim_3139", "series": "CAG", "text": "εἰ γὰρ ἐμένομεν παῖδες, οὐ δυνατῶς εἴχομεν φύειν ἕτερον.", "seq": 3139}
{"id": "David_Passim_3140", "series": "CAG", "text": "ἐπειδὴ δὲ καὶ ἡ αὐξητικὴ δέεται θρεπτικῆς, ἀναγκαίως τὴν θρεπτικὴν ἡμῖν ἐδωρήσατο.", "seq": 3140}
{"id": "David_Passim_3141", "series": "CAG", "text": "ταύταις οὖν ταῖς τρισὶ δυνάμεσιν εἰ προσέλθῃ τις αἴσθησις, ποιεῖ τὸ ζῳόφυτον.", "seq": 3141}
{"id": "David_Passim_3142", "series": "CAG", "text": "ὅτι δὲ ἔχει αἴσθησιν τὸ ζῳόφυτον, σαφὲς ἐκ τοῦ ἐν τοῖς ὕδασιν ἡδόμενον ἐξαπλοῦσθαι καὶ κάρφους ἀνιῶντος συστέλλεσθαι.", "seq": 3142}
{"id": "David_Passim_3143", "series": "CAG", "text": "εἰ ἐπὶ τούτοις δὲ γίνηται κίνησις, γίνεται τὸ ζῷον.", "seq": 3143}
{"id": "David_Passim_3144", "series": "CAG", "text": "ἰστέον δὲ ὅτι ὅπου κίνησις, ἐκεῖ καὶ αἴσθησις, οὐχ ὅπου δὲ αἴσθησις, ἐκεῖ καὶ κίνησις, ὡς χείρων δὲ τῆς κινήσεως οὖσα ἡ αἴσθησις ὑποτάττεται τῇ κινήσει.", "seq": 3144}
{"id": "David_Passim_3145", "series": "CAG", "text": "ἴσως δὲ ἀπορήσει τις λέγων ‘πόθεν δῆλον ὅτι ἡ κίνησις ἔχει αἴσθησιν;’", "seq": 3145}
{"id": "David_Passim_3146", "series": "CAG", "text": "πόθεν δῆλον;", "seq": 3146}
{"id": "David_Passim_3147", "series": "CAG", "text": "ἐκ τοῦ μὴ ποιεῖν τι τὴν φύσιν μάτην·", "seq": 3147}
{"id": "David_Passim_3148", "series": "CAG", "text": "εἰ οὖν ἐκτὸς τῆς αἰσθήσεως ἐδημιούργει ἡ φύσις, ἐμέλλομεν ἀποκρημνοῦν καὶ ἐπ᾿ ἀπωλείᾳ βαδίζειν αἴσθησιν ἐν τῇ κινήσει μὴ ἔχοντες, ὅπερ ἡ φύσις οὐ βούλεται·", "seq": 3148}
{"id": "David_Passim_3149", "series": "CAG", "text": "τοσοῦτον γὰρ ἡ φύσις τῶν οἰκείων κήδεται δημιουργημάτων, ὅτι καὶ τῷ σκώληκι τῆς ὁράσεως ἀποτυχόντι τὸ μαλθακὸν ἐχαρίσατο, ἵνα μὴ ἀποκρημνιζόμενος ἐπ᾿ ἀπωλείᾳ γένηται.", "seq": 3149}
{"id": "David_Passim_3150", "series": "CAG", "text": "ἔχομεν ἐντεῦθεν πορισμοῦ μοῖραν ὅτι οὐχ ὑγιῶς ἔχει ὁ ὁρισμὸς τοῦ ζῴου·", "seq": 3150}
{"id": "David_Passim_3151", "series": "CAG", "text": "συμπεριλαμβάνει γὰρ καὶ τὸ ζῳόφυτον·", "seq": 3151}
{"id": "David_Passim_3152", "series": "CAG", "text": "φαμὲν γὰρ τὸ ζῷον οὐσίαν ἔμψυχον αἰσθητικήν·", "seq": 3152}
{"id": "David_Passim_3153", "series": "CAG", "text": "τοιαῦτα δὲ καὶ τὰ ζῳόφυτα.", "seq": 3153}
{"id": "David_Passim_3154", "series": "CAG", "text": "δεῖ οὖν προσθεῖναι τὸ αὐτοκίνητον, τοῦτ᾿ ἔστιν οὐσία ἔμψυχος αἰσθητικὴ αὐτοκίνητος.", "seq": 3154}
{"id": "David_Passim_3155", "series": "CAG", "text": "κίνησιν δὲ λέγω τὴν ἀπὸ τόπου εἰς τόπον.", "seq": 3155}
{"id": "David_Passim_3156", "series": "CAG", "text": "Πρᾶξις ιηʹ.", "seq": 3156}
{"id": "David_Passim_3157", "series": "CAG", "text": "Ὥσπερ ἀληθείας προϊστάμενοι οἱ τὰ Πλάτωνος πρεσβεύοντες δόγματα τῆς Ἀριστοτελικῆς διαιρέσεως ἐπιλαμβάνεσθαι σπουδάζουσι·", "seq": 3157}
{"id": "David_Passim_3158", "series": "CAG", "text": "φασὶ γὰρ ὅτι ἐναντία ἑαυτῷ καὶ τοῖς ἄλλοις φθέγγεται ὁ Ἀριστοτέλης φάσκων τὴν οὐσίαν διαιρεῖσθαι εἰς ἐναντιότητας, εἴ γε ἐν Κατηγορίαις φησὶ μὴ ἔχειν αὐτὴν ἐναντιότητα.", "seq": 3158}
{"id": "David_Passim_3159", "series": "CAG", "text": "Πλωτῖνος δὲ καὶ τὴν αἰτίαν ἔλεγε·", "seq": 3159}
{"id": "David_Passim_3160", "series": "CAG", "text": "φησὶ γὰρ δικαίως·", "seq": 3160}
{"id": "David_Passim_3161", "series": "CAG", "text": "οὐκ ἔχει ἡ οὐσία ἐναντιότητα, καθὸ οὐκ ἔστιν ἐν ὑποκειμένῳ·", "seq": 3161}
{"id": "David_Passim_3162", "series": "CAG", "text": "αὐτὴ γὰρ ὑποκείμενον ὑπάρχει·", "seq": 3162}
{"id": "David_Passim_3163", "series": "CAG", "text": "τὰ γοῦν ἐναντία πάντως ἐν ὑποκειμένῳ ὄντα τὴν μάχην ποιεῖται·", "seq": 3163}
{"id": "David_Passim_3164", "series": "CAG", "text": "οὕτω γὰρ τὸ ψυχρὸν καὶ τὸ θερμὸν ἕνεκεν τοῦ ὑποκειμένου μάχονται·", "seq": 3164}
{"id": "David_Passim_3165", "series": "CAG", "text": "βούλεται γὰρ ἓν ἕκαστον τοῦ ἄλλου τὸ ὑποκείμενον λαβεῖν·", "seq": 3165}
{"id": "David_Passim_3166", "series": "CAG", "text": "τὸ ψυχρὸν γὰρ σπεύδει μεταβάλλειν τὸ θερμὸν εἰς ψυχρόν.", "seq": 3166}
{"id": "David_Passim_3167", "series": "CAG", "text": "ὅτι δὲ εἰς ἐναντία διαιρεῖ ὁ Ἀριστοτέλης τὴν οὐσίαν, σαφὲς ἐκ τῶν λεγομένων·", "seq": 3167}
{"id": "David_Passim_3168", "series": "CAG", "text": "φησὶ γὰρ ‘ἡ οὐσία διαιρεῖται εἰς σῶμα καὶ ἀσώματον’.", "seq": 3168}
{"id": "David_Passim_3169", "series": "CAG", "text": "τὸ σῶμα καὶ τὸ ἀσώματον ἐναντία εἰσίν.", "seq": 3169}
{"id": "David_Passim_3170", "series": "CAG", "text": "ἀλλὰ μὴν οὐδὲ αὕτη ἐστὶν ἁμαρτία μόνη, ἀλλὰ καὶ ἑτέρα·", "seq": 3170}
{"id": "David_Passim_3171", "series": "CAG", "text": "φησὶ γὰρ ὅτι καὶ τὸ σῶμα διαιρεῖται εἰς ἔμψυχον καὶ ἄψυχον·", "seq": 3171}
{"id": "David_Passim_3172", "series": "CAG", "text": "ἐναντίον δὲ τὸ ἔμψυχον τῷ ἀψύχῳ.", "seq": 3172}
{"id": "David_Passim_3173", "series": "CAG", "text": "ἄλλως δὲ ἡμάρτηται·", "seq": 3173}
{"id": "David_Passim_3174", "series": "CAG", "text": "δεῖ γὰρ μᾶλλον ἐκ τοῦ ἐμψύχου διελεῖν τὸ σῶμα·", "seq": 3174}
{"id": "David_Passim_3175", "series": "CAG", "text": "εἰ γὰρ καὶ ψυχὴν καὶ σῶμα ἔχει τὸ ἔμψυχον, ὁμολογουμένως τοῦ ἐμψύχου <μέρος> τὸ σῶμα.", "seq": 3175}
{"id": "David_Passim_3176", "series": "CAG", "text": "τοὐναντίον δὲ ἐκ τοῦ σώματος τὴν διαίρεσιν ἐποιήσατο λέγων αὐτὸ διαιρεθῆναι εἰς ἄψυχον καὶ ἔμψυχον.", "seq": 3176}
{"id": "David_Passim_3177", "series": "CAG", "text": "τρίτη ἁμαρτία ἀναφύεται Ἀριστοτέλει, ὅτι φησὶ τὸ θεῖον σῶμα εἶναι·", "seq": 3177}
{"id": "David_Passim_3178", "series": "CAG", "text": "τοῦτο γὰρ συνάγεται αὐτῷ ἐκ τῆς τοιαύτης διαιρέσεως·", "seq": 3178}
{"id": "David_Passim_3179", "series": "CAG", "text": "εἰ γὰρ ἐκ τοῦ ἐμψύχου σώματος γίνεται τὸ ζῷον καὶ ἐκ τοῦ ζῴου τὸ ἀθάνατον λογικόν, ἔσται ἄρα καὶ τὸ λογικὸν ἀθάνατον σῶμα.", "seq": 3179}
{"id": "David_Passim_3180", "series": "CAG", "text": "Τοιαύταις μέμψεσι τὴν Ἀριστοτέλους οἱ Πλατωνικοὶ καταποντίσαντες διαίρεσιν ἐπὶ ἑτέραν, ἣν ἔχειν καλῶς νομίζουσι, τὸ βάδισμα ἐπιταχύνουσιν.", "seq": 3180}
{"id": "David_Passim_3181", "series": "CAG", "text": "ἄμεινον δὲ πρῶτον ὑπὲρ τῆς δοκούσης κακῶς ἔχειν Ἀριστοτελικῆς διαιρέσεως ἀπολογήσασθαι καὶ εἶθ᾿ ὕστερον τὴν τῶν Πλατωνικῶν ἐκθέσθαι·", "seq": 3181}
{"id": "David_Passim_3182", "series": "CAG", "text": "ἔστι γὰρ εἰπεῖν ὡς οὔτε ὅλως ἥμαρτον περὶ τῆς τοιαύτης διαιρέσεως οἱ Ἀριστοτέλει πειθαρχοῦντες·", "seq": 3182}
{"id": "David_Passim_3183", "series": "CAG", "text": "δεῖξαι γὰρ ἔχομεν ἐκ περιουσίας ὡς οὐδὲ ἐναντία εἰσὶ ταῦτα, τέως οὐδὲ ἀντικείμενα.", "seq": 3183}
{"id": "David_Passim_3184", "series": "CAG", "text": "διαιρεῖται τοίνυν τὸ ἀντικείμενον εἰς τέσσαρα·", "seq": 3184}
{"id": "David_Passim_3185", "series": "CAG", "text": "ἤτοι γὰρ τὰ ἀντικείμενα ἐναντία ἐστὶν ὥσπερ τὸ θερμὸν καὶ τὸ ψυχρόν (ταῦτα δὲ εἰς ἄλληλα θέλει μεταβάλλειν), ἤτοι ὡς ἕξις καὶ στέρησις (μεταβάλλεται γὰρ τούτων τὸ ἓν εἰς τὸ ἕτερον, ὥσπερ ἡ ἕξις εἰς στέρησιν, οὐκέτι δὲ ἡ στέρησις εἰς ἕξιν·", "seq": 3185}
{"id": "David_Passim_3186", "series": "CAG", "text": "ἀπὸ γὰρ ἕξεως στέρησις γίνεται, ἀπὸ δὲ στερήσεως οὐκ ἔτι ἕξις), ἢ ὡς τὰ πρός τι (ταῦτα γὰρ σώζει ἄλληλα, ὡς πατὴρ καὶ υἱός), ἢ ὡς ἀντίφασις ‘ὁ δεῖνα περιπατεῖ ἢ οὐ περιπατεῖ’·", "seq": 3186}
{"id": "David_Passim_3187", "series": "CAG", "text": "τὸ τοιοῦτον δὲ οὐ δύναται κατ᾿ ἄμφω ἀληθεύειν καὶ κατ᾿ ἄμφω ψεύδεσθαι·", "seq": 3187}
{"id": "David_Passim_3188", "series": "CAG", "text": "ἐκ γὰρ τῆς καταφάσεως ἢ ἀποφάσεως γίνεται ἡ ἀντίφασις.", "seq": 3188}
{"id": "David_Passim_3189", "series": "CAG", "text": "ὅπου γὰρ ἡ ἀπόφασις ἀληθεύει, ἐκεῖ ψεύδεται ἡ κατάφασις, οἷον οὐ περιπατεῖ·", "seq": 3189}
{"id": "David_Passim_3190", "series": "CAG", "text": "τὸ περιπατεῖ ὧδε ψεύδεται.", "seq": 3190}
{"id": "David_Passim_3191", "series": "CAG", "text": "ὅπου δὲ ἡ κατάφασις ἀληθεύει, ἐκεῖ ψεύδεται ἡ ἀπόφασις·", "seq": 3191}
{"id": "David_Passim_3192", "series": "CAG", "text": "περιπατεῖ Σωκράτης·", "seq": 3192}
{"id": "David_Passim_3193", "series": "CAG", "text": "οὐ περιπατεῖ τοῦτο ψεύδεται·", "seq": 3193}
{"id": "David_Passim_3194", "series": "CAG", "text": "ἅπαξ γὰρ ἐρρέθη ‘περιπατεῖ’.", "seq": 3194}
{"id": "David_Passim_3195", "series": "CAG", "text": "ὥστε οὖν ἀδύνατον τὰ δύο ἀληθεύειν ἢ ψεύδεσθαι.", "seq": 3195}
{"id": "David_Passim_3196", "series": "CAG", "text": "ὅτι δὲ οὐκ ἀντίκειται τὸ σῶμα τῷ ἀσωμάτῳ καθ᾿ ἕνα τῶν λεγομένων τρόπων, σαφὲς ἐντεῦθεν·", "seq": 3196}
{"id": "David_Passim_3197", "series": "CAG", "text": "τὸ σῶμα καὶ τὸ ἀσώματον οὐκ ἔστιν ἐναντία, καθὸ οὐ πέφυκεν εἰς ἄλληλα μεταβάλλειν·", "seq": 3197}
{"id": "David_Passim_3198", "series": "CAG", "text": "οὔτε γὰρ τὸ σῶμα ἀσώματον οὔτε τὸ ἀσώματον σῶμα, ὥσπερ τὸ ψυχρὸν εἰς θερμὸν μεταβάλλεται καὶ τὸ θερμὸν εἰς ψυχρόν.", "seq": 3198}
{"id": "David_Passim_3199", "series": "CAG", "text": "οὔτε μὴν ἀντίκεινται ὥσπερ ἕξις καὶ στέρησις, καθὸ οὐδέτερον αὐτῶν μεταβάλλει εἰς τὸ ἕτερον, ἀλλὰ μὴν ἡ ἕξις μόνον εἰς στέρησιν μεταβάλλεται, οὐκ ἔτι δὲ ἡ στέρησις εἰς ἕξιν.", "seq": 3199}
{"id": "David_Passim_3200", "series": "CAG", "text": "συγχωρείσθω δὲ τὸ ὁποῖόν τι θέλεις εἰς τὸ ἕτερον μεταβάλλειν, ἀλλὰ μὴν τοῦτο ἀδύνατον·", "seq": 3200}
{"id": "David_Passim_3201", "series": "CAG", "text": "ὁμολογουμένως οὐκ ἀντίκεινται κατὰ τοῦτον τὸν τρόπον.", "seq": 3201}
{"id": "David_Passim_3202", "series": "CAG", "text": "οὔτε μὴν ὡς τὰ πρός τι ἀντίκεινται, ἐπειδὴ τὰ πρός τι σώζει ἄλληλα, ταῦτα δὲ φθείρει·", "seq": 3202}
{"id": "David_Passim_3203", "series": "CAG", "text": "ὅπου γὰρ σῶμα, οὐκ ἔστι τὸ ἀσώματον, καὶ ὅπου τὸ ἀσώματον, οὐκ ἔστι σῶμα.", "seq": 3203}
{"id": "David_Passim_3204", "series": "CAG", "text": "ἀλλὰ μὴν οὐδὲ κατὰ τὸν τῆς ἀντιφάσεως ἀντίκεινται·", "seq": 3204}
{"id": "David_Passim_3205", "series": "CAG", "text": "ἐπὶ μὲν γὰρ τῆς ἀντιφάσεως τὰ δύο οὐ δύνανται ἀληθεύειν ἢ ψεύδεσθαι, ἐπὶ δὲ τούτων καὶ τὰ δύο ἀληθεύει καὶ ψεύδεται·", "seq": 3205}
{"id": "David_Passim_3206", "series": "CAG", "text": "ἀληθεύει μὲν ὡς ἵνα εἴπῃ ‘ὁ ἄνθρωπος σῶμα καὶ οὐκ ἀσώματον’ (ἄμφω γὰρ ἀληθεύει), ψεύδεται δὲ ὡς ἵνα εἴπῃ ‘τὸ λευκὸν σῶμα καὶ μὴ ἀσώματον’·", "seq": 3206}
{"id": "David_Passim_3207", "series": "CAG", "text": "κατ᾿ ἄμφω γὰρ ψεύδεται·", "seq": 3207}
{"id": "David_Passim_3208", "series": "CAG", "text": "ἐψεύσατο δὲ καθ᾿ ἓν σῶμα λέγων τὸ λευκὸν καὶ καθ᾿ ἕτερον ὅτι μὴ ἀσώματον.", "seq": 3208}
{"id": "David_Passim_3209", "series": "CAG", "text": "ὁ αὐτὸς λόγος καὶ ἐπὶ τοῦ ἐμψύχου καὶ τοῦ ἀψύχου·", "seq": 3209}
{"id": "David_Passim_3210", "series": "CAG", "text": "οὔτε γὰρ ἀντίκεινται ὡς τὰ πρός τι οὔτε ὡς ἕξις καὶ στέρησις οὔτε ὡς ἀντίφασις, καθὸ οὔτε σώζει ἄλληλα οὔτε τὸ ἓν εἰς τὸ ἕτερον μεταβάλλεται οὔτε ἐπὶ τοῦ ἑνὸς ἀληθεύει καὶ ἐπὶ τοῦ ἑτέρου ψεύδεται.", "seq": 3210}
{"id": "David_Passim_3211", "series": "CAG", "text": "τοῦτο μόνον δοκεῖ ἐναντιοῦσθαι·", "seq": 3211}
{"id": "David_Passim_3212", "series": "CAG", "text": "πολλάκις γὰρ εἴποι τις ὡς ἀντίκεινται ὡς τὰ ἐναντία·", "seq": 3212}
{"id": "David_Passim_3213", "series": "CAG", "text": "μεταβάλλει γὰρ εἰς ἄλληλα·", "seq": 3213}
{"id": "David_Passim_3214", "series": "CAG", "text": "ἰδοὺ γὰρ ἡ τροφὴ ἄψυχόν τι οὖσα εἰς ἔμψυχον μεταβάλλεται (γίνεται γὰρ αἷμα), καὶ τὸ ἔμψυχον πάλιν εἰς τὸ ἄψυχον, ὡς τὰ ἐν γενέσει καὶ φθορᾷ.", "seq": 3214}
{"id": "David_Passim_3215", "series": "CAG", "text": "καί φαμεν ὅτι οὐ δύναται εἶναι ἐναντία, καθὸ οὐδέποτε τὰ ἐναντία σώζει ἄλληλα, τοὐναντίον δὲ ἀναιρεῖ·", "seq": 3215}
{"id": "David_Passim_3216", "series": "CAG", "text": "ὁρῶμεν δὲ ὅτι καὶ τὸ ἄψυχον σώζει τὸ ἔμψυχον, ὥσπερ ἡ τροφὴ καὶ τὰ ἐδέσματα.", "seq": 3216}
{"id": "David_Passim_3217", "series": "CAG", "text": "τὸ δὲ λέγειν ὡς ἥμαρτον ἀπὸ τοῦ σώματος λέγοντες τὸ ἔμψυχον (τοῦ γὰρ ἐμψύχου μέρος ἐστὶ τὸ σῶμα), πάνυ φαῦλον ὑπάρχει·", "seq": 3217}
{"id": "David_Passim_3218", "series": "CAG", "text": "οὔτε γὰρ πᾶν σῶμα μέρος ἐστὶ τοῦ ἐμψύχου, ἀλλὰ τὸ τοιόνδε·", "seq": 3218}
{"id": "David_Passim_3219", "series": "CAG", "text": "τὸ οὖν ἁπλῶς σῶμα διαιρεῖται εἰς ἔμψυχον καὶ ἄψυχον.", "seq": 3219}
{"id": "David_Passim_3220", "series": "CAG", "text": "τρίτον ἔλεγον καλεῖν Ἀριστοτέλην τὸ λογικὸν ἀθάνατον σῶμα εἰς τὴν τοιαύτην διαίρεσιν.", "seq": 3220}
{"id": "David_Passim_3221", "series": "CAG", "text": "φαμὲν δὲ ὅτι οὐ τὸ θεῖον τὸ ποιοῦν ἡμῶν πρόνοιαν λέγει ἐκ τοῦ ζῴου διαιρεῖσθαι, ἀλλὰ τὰ οὐράνια σώματα·", "seq": 3221}
{"id": "David_Passim_3222", "series": "CAG", "text": "βούλεται γὰρ τὰ τοιαῦτα θεῖα λογικὰ καλεῖν.", "seq": 3222}
{"id": "David_Passim_3223", "series": "CAG", "text": "καὶ εἰ φήσουσι ‘πῶς τὸν ἥλιον θεῖον καλεῖ;’", "seq": 3223}
{"id": "David_Passim_3224", "series": "CAG", "text": "λέξομεν ‘τί γὰρ ἄτοπον Ἀριστοτέλην λέγειν τὰ οὐράνια σώματα θεῖα, ὅπου γε καὶ ὁ Πλάτων ἐν πολλοῖς τοὺς ἄνδρας καλεῖν θείους ἠξίωσεν;’", "seq": 3224}
{"id": "David_Passim_3225", "series": "CAG", "text": "εἴρηται δὲ τὰ τοιαῦτα θεῖα διὰ τὸ θέειν, τοῦτ᾿ ἔστι τρέχειν·", "seq": 3225}
{"id": "David_Passim_3226", "series": "CAG", "text": "ἕνεκα γὰρ τούτου καὶ τὸ θεῖον τὸ προνοούμενον ἡμῶν θεῖον ἐκλήθη, καθὸ πάντῃ περιθέει.", "seq": 3226}
{"id": "David_Passim_3227", "series": "CAG", "text": "Ἀπολογησάμενοι οὖν ὑπὲρ τῆς τῶν Ἀριστοτελικῶν διαιρέσεως φέρε καὶ κατὰ τὴν ἡμετέραν ἐπαγγελίαν τὴν τῶν Πλατωνικῶν ἐκθησόμεθα.", "seq": 3227}
{"id": "David_Passim_3228", "series": "CAG", "text": "διαιροῦσι τοίνυν τὴν οὐσίαν οὕτως·", "seq": 3228}
{"id": "David_Passim_3229", "series": "CAG", "text": "ἡ οὐσία διαιρεῖται εἰς σῶμα καὶ ἀσώματον καὶ εἰς μικτόν.", "seq": 3229}
{"id": "David_Passim_3230", "series": "CAG", "text": "τὸ σῶμα ἢ ἀκίνητόν ἐστιν ἢ κεκινημένον.", "seq": 3230}
{"id": "David_Passim_3231", "series": "CAG", "text": "καὶ εἰ μὲν ἀκίνητον ἐστι, ποιεῖ τὸν τόπον (δικαίως δὲ ὁ τόπος ἀκίνητός ἐστι·", "seq": 3231}
{"id": "David_Passim_3232", "series": "CAG", "text": "τὸ γὰρ κινούμενον ἐν τόπῳ ἐστίν·", "seq": 3232}
{"id": "David_Passim_3233", "series": "CAG", "text": "εἰ δὲ καὶ ὁ τόπος ἐκινεῖτο, ἐν τόπῳ ἐζήτει κινεῖσθαι·", "seq": 3233}
{"id": "David_Passim_3234", "series": "CAG", "text": "εἶναι δὲ τόπον ἐν τόπῳ ἄτοπον), εἰ δὲ κινούμενον, ἢ κύκλῳ κινεῖται ἢ κατ᾿ εὐθύ.", "seq": 3234}
{"id": "David_Passim_3235", "series": "CAG", "text": "καὶ εἰ μὲν κατ᾿ εὐθὺ κινεῖται, εἰ μὲν ἄνω, γίνεται τὸ πῦρ καὶ ὁ ἀήρ, εἰ δὲ κάτω, τὸ ὕδωρ καὶ ἡ γῆ.", "seq": 3235}
{"id": "David_Passim_3236", "series": "CAG", "text": "εἰ δὲ κύκλῳ, εἰ μὲν ἀπ᾿ ἀνατολῶν εἰς δυσμάς, γίνεται ἡ ἀπλανὴς σφαῖρα, εἰ δὲ ἀπὸ δυσμῶν ἐπὶ ἀνατολάς, γίνεται ἡ ὑποκάτω καὶ αἱ ἄλλαι.", "seq": 3236}
{"id": "David_Passim_3237", "series": "CAG", "text": "τὸ ἀσώματον διαιρεῖται εἰς ἔνυλον καὶ εἰς ἄυλον.", "seq": 3237}
{"id": "David_Passim_3238", "series": "CAG", "text": "καὶ εἰ μὲν εἰς ἔνυλον, ποιεῖ τὴν φυτικὴν καὶ ἄλογον ψυχήν, εἰ δὲ εἰς ἄυλον φύσει καὶ ἐνεργείᾳ ἄφθαρτον, γίνεται τὸ θεῖον (τοῦτο γὰρ ἀσώματόν ἐστι καὶ ἀεὶ ἄφθαρτον κατὰ τὴν φύσιν καὶ κατὰ τὴν ἐνέργειαν), εἰ δὲ κατὰ μὲν τὴν φύσιν ἄφθαρτον κατὰ δὲ τὴν ἐνέργειαν φθαρτόν, δηλοῖ τὴν λογικὴν ψυχήν.", "seq": 3238}
{"id": "David_Passim_3239", "series": "CAG", "text": "τὸ μικτὸν ἀπὸ σώματος καὶ ἀσωμάτου ἐστί, διὸ καὶ μικτὸν καλεῖται.", "seq": 3239}
{"id": "David_Passim_3240", "series": "CAG", "text": "ποιεῖ δὲ τοῦτο τὸ ἔμψυχον·", "seq": 3240}
{"id": "David_Passim_3241", "series": "CAG", "text": "ἔμψυχον γάρ ἐστι μικτόν.", "seq": 3241}
{"id": "David_Passim_3242", "series": "CAG", "text": "τὸ ἔμψυχον διαιρεῖται εἰς τὸ ζῷον καὶ εἰς τὸ ζῳόφυτον καὶ εἰς τὸ φυτόν.", "seq": 3242}
{"id": "David_Passim_3243", "series": "CAG", "text": "καὶ εἰ μὲν ᾖ τὸ φυτὸν χαμαιπετές, λέγεται πόα, εἰ δὲ ὑψιπετές, δένδρον, εἰ δὲ μέσον, θάμνος.", "seq": 3243}
{"id": "David_Passim_3244", "series": "CAG", "text": "οὐκ ἔστι δὲ ἀνεπίληπτος ἡ τοιαύτη διαίρεσις·", "seq": 3244}
{"id": "David_Passim_3245", "series": "CAG", "text": "κακῶς γὰρ λέγουσιν τὸν τόπον εἶναι σῶμα·", "seq": 3245}
{"id": "David_Passim_3246", "series": "CAG", "text": "ἔσται γὰρ σῶμα διὰ σώματος χωροῦν, εἰ τὰ κινούμενα ἐν τόπῳ κινεῖται.", "seq": 3246}
{"id": "David_Passim_3247", "series": "CAG", "text": "ἀλλὰ μὴν τοῦτο ἄτοπον.", "seq": 3247}
{"id": "David_Passim_3248", "series": "CAG", "text": "οὐκ ἔστιν οὖν ὁ τόπος σῶμα.", "seq": 3248}
{"id": "David_Passim_3249", "series": "CAG", "text": "ἄλλως τε ἐκ τῶν αὐτῶν δείκνυται ὅτι οὐκ ἔστι σῶμα·", "seq": 3249}
{"id": "David_Passim_3250", "series": "CAG", "text": "εἰ γὰρ τὸ σῶμα ἐν τόπῳ θέλει εἶναι, σῶμα δὲ ὁ τόπος, ἔσται ὁ τόπος ἐν τόπῳ, ἔτι δὲ καὶ ὁ ἄλλος τόπος ἐν τόπῳ καὶ <τοῦτο> ἐπ᾿ ἄπειρον, ὅπερ ἄτοπον.", "seq": 3250}
{"id": "David_Passim_3251", "series": "CAG", "text": "4.", "seq": 3251}
{"id": "David_Passim_3252", "series": "CAG", "text": "15 Καθ᾿ ἑκάστην κατηγορίαν ἐστί τινα γενικώτατα.", "seq": 3252}
{"id": "David_Passim_3253", "series": "CAG", "text": "Φησὶν ὅτι εὑρίσκομέν τινα γενικώτατα κατηγορούμενα καί τινα εἰδικώτατα·", "seq": 3253}
{"id": "David_Passim_3254", "series": "CAG", "text": "γενικώτατον μὲν ὡς εἴπομεν τὴν οὐσίαν, εἰδικώτατον δὲ ὡς εἴπομεν τὸν ἄνθρωπον.", "seq": 3254}
{"id": "David_Passim_3255", "series": "CAG", "text": "λέγουσι δὲ ὅτι οὐκ ὤφειλεν εἰπεῖν γενικώτατα·", "seq": 3255}
{"id": "David_Passim_3256", "series": "CAG", "text": "οὔτε γὰρ κατηγορεῖται ἕν τι πολλῶν γενικωτάτων·", "seq": 3256}
{"id": "David_Passim_3257", "series": "CAG", "text": "δεῖ οὖν ἑνικῶς λέγειν γενικώτατον ἢ τὸ πληθυντικὸν ἀνθ᾿ ἑνικοῦ νοεῖσθαι.", "seq": 3257}
{"id": "David_Passim_3258", "series": "CAG", "text": "4.", "seq": 3258}
{"id": "David_Passim_3259", "series": "CAG", "text": "17 Ὑπὲρ ὃ οὐκ ἂν εἴη ἄλλο ὑπερβεβηκὸς γένος.", "seq": 3259}
{"id": "David_Passim_3260", "series": "CAG", "text": "Καλῶς εἶπε γένος·", "seq": 3260}
{"id": "David_Passim_3261", "series": "CAG", "text": "ἔστι γὰρ τὸ ὂν ἐπαναβεβηκὸς τῆς οὐσίας, ἥτις γενικώτατον λέγεται, ἀλλ᾿ οὐκ ἔστι γένος, ὥς φησιν Ἀριστοτέλης.", "seq": 3261}
{"id": "David_Passim_3262", "series": "CAG", "text": "Ἀριστοτέλει οὖν πειθαρχῶν ὁ Πορφύριος οὐ λέγει τὸ ὂν γένος, εἰ καὶ τὰ μάλιστα βούλεται ὁ Πλάτων αὐτὸ εἶναι γένος.", "seq": 3262}
{"id": "David_Passim_3263", "series": "CAG", "text": "4.", "seq": 3263}
{"id": "David_Passim_3264", "series": "CAG", "text": "18 Μεθ᾿ ὃ οὐκ ἂν εἴη ἄλλο ὑποβεβηκὸς εἶδος.", "seq": 3264}
{"id": "David_Passim_3265", "series": "CAG", "text": "Καὶ ὧδε καλῶς εἶπε τὸ εἶδος·", "seq": 3265}
{"id": "David_Passim_3266", "series": "CAG", "text": "ἔστι γὰρ καὶ ἄλλα τῷ εἴδει ὑποβεβηκότα ὡς ὁ Σωκράτης καὶ Πλάτων, ἀλλ᾿ οὐκ εἴδη.", "seq": 3266}
{"id": "David_Passim_3267", "series": "CAG", "text": "4.", "seq": 3267}
{"id": "David_Passim_3268", "series": "CAG", "text": "22 Ὑπὸ δὲ ταύτην ἐστὶ σῶμα.", "seq": 3268}
{"id": "David_Passim_3269", "series": "CAG", "text": "Τελείως οὐκ ἐπεξέρχεται τῇ διαιρέσει·", "seq": 3269}
{"id": "David_Passim_3270", "series": "CAG", "text": "διαιρεῖται γὰρ ἡ οὐσία οὐ μόνον εἰς σῶμα, ἀλλὰ καὶ εἰς ἀσώματον.", "seq": 3270}
{"id": "David_Passim_3271", "series": "CAG", "text": "μήποτε δὲ τὰ συμβαλλόμενα τῷ παραδείγματι παραδίδωσι.", "seq": 3271}
{"id": "David_Passim_3272", "series": "CAG", "text": "4.", "seq": 3272}
{"id": "David_Passim_3273", "series": "CAG", "text": "32 Καὶ πᾶν τὸ πρὸ τῶν ἀτόμων προσεχὲς εἶδος ἂν εἴη μόνον, οὐκέτι δὲ καὶ γένος.", "seq": 3273}
{"id": "David_Passim_3274", "series": "CAG", "text": "Καλῶς εἶπε τὸ προσεχές·", "seq": 3274}
{"id": "David_Passim_3275", "series": "CAG", "text": "ἰδοὺ γὰρ τὸ ζῷον κατηγορεῖται τοῦ Σωκράτους καὶ Πλάτωνος, οὐκ ἔστι δὲ ὅμως μόνον εἶδος, καθὸ προσεχῶς τῶν ἀτόμων οὐ κατηγορεῖται.", "seq": 3275}
{"id": "David_Passim_3276", "series": "CAG", "text": "τὰ οὖν προσεχῶς κατηγορούμενα τῶν ἀτόμων ταῦτα εἴδη μόνον λέγεται ὡς ὁ ἄνθρωπος.", "seq": 3276}
{"id": "David_Passim_3277", "series": "CAG", "text": "Πρᾶξις ιθ΄.", "seq": 3277}
{"id": "David_Passim_3278", "series": "CAG", "text": "Πάρεστιν ὁ Πορφύριος περὶ τῶν αὐτῶν τὴν διδασκαλίαν ποιούμενος, πρῶτον περὶ τῶν ἄκρων διδάξων εἶθ᾿ ὕστερον περὶ τῶν μέσων, φημὶ δὲ περὶ τῶν ὑπαλλήλων.", "seq": 3278}
{"id": "David_Passim_3279", "series": "CAG", "text": "φησὶν οὖν ὅτι τὸ γενικώτατον μίαν σχέσιν ἔχει τὴν πρὸς τὰ ὑπ᾿ αὐτό, τὸ δὲ εἰδικώτατον μίαν τὴν πρὸς τὰ πρὸ αὐτοῦ, τὰ δὲ ὑπάλληλα μίαν μὲν τὴν πρὸς τὰ πρὸ αὐτῶν, ἄλλην δὲ τὴν πρὸς τὰ μετ᾿ αὐτά.", "seq": 3279}
{"id": "David_Passim_3280", "series": "CAG", "text": "σαφῆ δὲ ὑπάρχει τοῦ τοιούτου τὰ παραδείγματα.", "seq": 3280}
{"id": "David_Passim_3281", "series": "CAG", "text": "τινὲς δὲ λέγουσιν ὅτι κακῶς λέγει φάσκων τὸ εἰδικώτατον μίαν σχέσιν ἔχειν τὴν πρὸς τὰ πρὸ αὐτοῦ·", "seq": 3281}
{"id": "David_Passim_3282", "series": "CAG", "text": "δύο γὰρ ἔχει, τὴν μὲν μίαν τὴν πρὸς τὰ πρὸ αὐτοῦ οἷον ὁ ἄνθρωπος πρὸς τὸ ζῷον, ἄλλην δὲ τὴν πρὸς τὰ ἄτομα.", "seq": 3282}
{"id": "David_Passim_3283", "series": "CAG", "text": "κακῶς δὲ ἐπιλαμβάνονται τοῦ φιλοσόφου·", "seq": 3283}
{"id": "David_Passim_3284", "series": "CAG", "text": "μίαν γὰρ λέγει τὴν τοιαύτην σχέσιν, καθὸ ἑκατέρα αὐτῶν εἴδους ἐστὶ σχέσις·", "seq": 3284}
{"id": "David_Passim_3285", "series": "CAG", "text": "ἡ μὲν γὰρ ἀνθρώπου πρὸς τὸ ζῷον εἴδους ἐστὶ πρὸς τὸ γένος, ἡ δὲ ἀνθρώπου πρὸς Σωκράτην καὶ Ἀλκιβιάδην εἴδους ἐστὶ πρὸς τὰ ἄτομα.", "seq": 3285}
{"id": "David_Passim_3286", "series": "CAG", "text": "δικαίως οὖν ταύτην μίαν καλεῖ διὰ τὸ τὴν αὐτὴν εἶναι.", "seq": 3286}
{"id": "David_Passim_3287", "series": "CAG", "text": "τὰ μέντοι ὑπάλληλα διττὴν ἔχει τὴν σχέσιν, καθὸ οὐ τὴν αὐτὴν πρὸς τὸ ἄνω καὶ τὸ κάτω ἔχει·", "seq": 3287}
{"id": "David_Passim_3288", "series": "CAG", "text": "πρὸς μὲν γὰρ τὸ ἄνω ὡς εἶδός ἐστι πρὸς γένος, πρὸς δὲ τὸ κάτω ὡς γένος πρὸς εἶδος.", "seq": 3288}
{"id": "David_Passim_3289", "series": "CAG", "text": "παραδείγματι δὲ σαφεῖ τὸ λεγόμενον παραβάλλει·", "seq": 3289}
{"id": "David_Passim_3290", "series": "CAG", "text": "φησὶ γάρ·", "seq": 3290}
{"id": "David_Passim_3291", "series": "CAG", "text": "νόησόν μοι τὸν Δία ἀρχὴν εἶναι τοῦ γένους τῶν Τανταλιδῶν καὶ ἀπ᾿ αὐτοῦ κατάγεσθαι Τάνταλον, ἀπὸ Ταντάλου Πέλοπα, ἀπὸ Πέλοπος Ἀτρέα, ἀπὸ Ἀτρέως Ἀγαμέμνονα, ἀφ᾿ οὗ Ὀρέστης.", "seq": 3291}
{"id": "David_Passim_3292", "series": "CAG", "text": "καὶ τὸν μὲν Δία ὡς μὴ γεννηθέντα ἔκ τινος πατέρα μόνον λέγομεν (πατὴρ γάρ ἐστι τῶν Τανταλιδῶν), τὸν δὲ Ὀρέστην μόνον υἱόν (υἱὸς γὰρ καθὸ ἐγεννήθη, οὐκ ἐγέννησε), τὸν δὲ Τάνταλον καὶ Πέλοπα καὶ Ἀτρέα καὶ Ἀγαμέμνονά φαμεν πατέρας, καθὸ πάντες ἐγέννησαν, καὶ υἱούς, καθὸ πάντες ἐγεννήθησαν.", "seq": 3292}
{"id": "David_Passim_3293", "series": "CAG", "text": "οὕτως οὖν καὶ ἐπὶ τῶν προκειμένων ἔστιν εἰπεῖν·", "seq": 3293}
{"id": "David_Passim_3294", "series": "CAG", "text": "τὴν μὲν γὰρ οὐσίαν μόνον γενικώτατον λέξομεν, καθὸ γένος πρὸ αὐτῆς οὐκ ἔχει, τὸν δὲ ἄνθρωπον μόνον εἰδικώτατον, καθὸ εἶδος μόνον ἐστὶ καὶ οὐ γένος, τὸ δὲ ἔμψυχον καὶ τὸ ζῷον καὶ τὸ λογικὸν ὑπάλληλα, καθὸ δύνανται καὶ γένη εἶναι καὶ εἴδη.", "seq": 3294}
{"id": "David_Passim_3295", "series": "CAG", "text": "Ἰστέον δὲ ὡς οὐ πάντῃ ἔοικε τὸ κατὰ φιλοσοφίαν γενικώτατον γένος τούτῳ τῷ παραδείγματι (καὶ δικαίως, ἵνα μὴ τὸ αὐτὸ ἔσται ἀλλὰ διαφέρῃ), καθὸ δυνατόν ἐστιν ἐπὶ μὲν τοῦ Διὸς λέγειν ὑπὸ ἕν τι ἀνάγεσθαι πάντα τὰ κατὰ συνήθειαν γένη, λέγω δὲ ὑπὸ τὸν Δία (πατὴρ γὰρ ἀνδρῶν τε θεῶν τε), ἐπὶ δὲ τοῦ γενικωτάτου γένους οὐ τοῦτο δυνατόν ἐστιν·", "seq": 3295}
{"id": "David_Passim_3296", "series": "CAG", "text": "οὐ γὰρ εὐποροῦμεν γένους, ὅπερ πάντων τῶν γενικωτάτων κατηγορεῖται.", "seq": 3296}
{"id": "David_Passim_3297", "series": "CAG", "text": "πολλάκις δ᾿ ἂν εἴποι τις ὡς τὸ ὂν ὡς γένος κατηγορεῖται τῶν γενικωτάτων γενῶν, λέγω δὲ τῶν δέκα κατηγοριῶν.", "seq": 3297}
{"id": "David_Passim_3298", "series": "CAG", "text": "πρὸς τοῦτο δὲ λέξομεν ὅτι οὔτε ὡς γένος εἰς ταύτας διαιρεῖται οὔτε ὡς ἄλλο τι·", "seq": 3298}
{"id": "David_Passim_3299", "series": "CAG", "text": "ἔχομεν γὰρ ἐκ περιουσίας δεῖξαι ὅτι οὔτε ὡς ἄλλο τι·", "seq": 3299}
{"id": "David_Passim_3300", "series": "CAG", "text": "τὰ διαιρούμενα εἴς τινα κατὰ ἓξ τρόπους διαιρεῖται·", "seq": 3300}
{"id": "David_Passim_3301", "series": "CAG", "text": "ἤτοι ὡς γένος εἰς εἴδη ὥσπερ τὸ ζῷον εἰς ἄνθρωπον καὶ ἵππον καὶ κύνα, ἢ ὡς εἶδος εἰς ἄτομα ὥσπερ ὁ ἄνθρωπος εἰς Ἀλκιβιάδην Σωκράτην καὶ Πλάτωνα, ἢ ὡς ὅλον εἰς μέρη ὥσπερ ὁ Σωκράτης εἰς κεφαλὴν καὶ χεῖρας καὶ πόδας, ἢ ὡς ὁμώνυμος φωνὴ εἰς διάφορα σημαινόμενα ὥσπερ ὁ κύων εἰς τὸν γηγενῆ καὶ θαλάττιον καὶ ἀστρῷον, ἢ ὡς οὐσία εἰς συμβεβηκότα οἷον ὁ ἄνθρωπος εἰς ἄνδρα καὶ γυναῖκα (ταῦτα γὰρ οὐδὲν διαφέρει κατὰ τὴν οὐσίαν ἀλλὰ κατὰ τὰ συμβεβηκότα, φημὶ δὲ κατὰ τὰ ἐξέχοντα μόρια·", "seq": 3301}
{"id": "David_Passim_3302", "series": "CAG", "text": "οὕτω γὰρ καὶ ὁ Γαληνός φησιν ὅτι οὐδὲν διαφέρει τὸ γύναιον τοῦ ἀνδρὸς εἰ μὴ κατὰ τὰ μόρια), ἢ ὡς συμβεβηκὸς εἰς οὐσίαν ὡς τὸ λευκὸν εἰς κύκνον καὶ χιόνα καὶ ψιμύθιον.", "seq": 3302}
{"id": "David_Passim_3303", "series": "CAG", "text": "κατὰ δὲ ἕνα τῶν τοιούτων τρόπων οὐ δύναται διαιρεῖσθαι τὸ ὂν εἰς τὰ γενικώτατα γένη.", "seq": 3303}
{"id": "David_Passim_3304", "series": "CAG", "text": "καὶ πρῶτόν γε περὶ τῶν πέντε φαμέν, εἶθ᾿ ὕστερον περὶ τοῦ γένους.", "seq": 3304}
{"id": "David_Passim_3305", "series": "CAG", "text": "τὸ ὂν εἰς τὰ γενικώτατα γένη οὐ δύναται ὡς εἶδος διαιρεῖσθαι, ὅτι τὰ εἴδη εἰς ἄτομα διαιρεῖται, τὰ δὲ ἄτομα μίαν φύσιν δηλοῖ, τὰ γενικώτατα δὲ πολλὰς φύσεις δηλοῖ.", "seq": 3305}
{"id": "David_Passim_3306", "series": "CAG", "text": "εἰ οὖν πολλὰς φύσεις δηλοῦσιν, ὁμολογουμένως τὸ ὂν οὐ διαιρεῖται ὡς εἰς ἄτομα εἰς τὰ γενικώτατα γένη.", "seq": 3306}
{"id": "David_Passim_3307", "series": "CAG", "text": "τί οὖν;", "seq": 3307}
{"id": "David_Passim_3308", "series": "CAG", "text": "ὡς ὅλον εἰς μέρη διαιρεῖται;", "seq": 3308}
{"id": "David_Passim_3309", "series": "CAG", "text": "οὐδαμῶς·", "seq": 3309}
{"id": "David_Passim_3310", "series": "CAG", "text": "τὸ γὰρ ὅλον εἰς ὁμοιομερῆ διαιρεῖται ὥσπερ τὸ ξύλον εἰς πολλὰ ξύλα ἢ εἰς ἀνομοιομερῆ ὥσπερ ὁ Σωκράτης εἰς κεφαλὴν καὶ χεῖρας καὶ πόδας·", "seq": 3310}
{"id": "David_Passim_3311", "series": "CAG", "text": "καὶ εἰ μὲν εἴπῃς εἰς ὁμοιομερῆ, ψεύσῃ·", "seq": 3311}
{"id": "David_Passim_3312", "series": "CAG", "text": "τὸ γὰρ ὁμοιομερὲς τοῦ αὐτοῦ ὀνόματος μετέχει καὶ πράγματος, τοῦ αὐτοῦ δὲ ὀνόματος οὐ μετέχει ἡ οὐσία καὶ τὰ συμβεβηκότα οὐδὲ τοῦ αὐτοῦ πράγματος·", "seq": 3312}
{"id": "David_Passim_3313", "series": "CAG", "text": "πρόδηλον γάρ.", "seq": 3313}
{"id": "David_Passim_3314", "series": "CAG", "text": "εἰ δὲ εἴπῃς εἰς ἀνομοιομερῆ, πάλιν ψεύσῃ·", "seq": 3314}
{"id": "David_Passim_3315", "series": "CAG", "text": "τὰ γὰρ ἀνομοιομερῆ οὐ προσαγορεύονται τῷ ὀνόματι τοῦ ὅλου·", "seq": 3315}
{"id": "David_Passim_3316", "series": "CAG", "text": "τὴν γὰρ κεφαλὴν Σωκράτους οὔ φαμεν Σωκράτην, φαμὲν δὲ τὴν οὐσίαν ὄν.", "seq": 3316}
{"id": "David_Passim_3317", "series": "CAG", "text": "ἀλλὰ μὴν οὔτε ὡς ὁμώνυμος φωνὴ διαιρεῖται, ἐπειδὴ ἡ ὁμώνυμος φωνὴ μόνον ὀνομασίας μεταδίδωσιν, οὐ μὴν καὶ πράγματος, τὸ δὲ ὂν οὐ μόνον ὀνόματος μεταδίδωσι τοῖς γενικωτάτοις ἀλλὰ καὶ πράγματος.", "seq": 3317}
{"id": "David_Passim_3318", "series": "CAG", "text": "ἀλλὰ μὴν οὐδέποτε ὁμώνυμος φωνὴ μεταδίδωσι τοῖς ὑπ᾿ αὐτὴν σημαινομένοις κατὰ τὸ μᾶλλον καὶ ἧττον·", "seq": 3318}
{"id": "David_Passim_3319", "series": "CAG", "text": "ὁρῶμεν δὲ ὅτι ἡ οὐσία μᾶλλον ὄν ἐστι, τὰ δὲ συμβεβηκότα ἧττον ὄντα.", "seq": 3319}
{"id": "David_Passim_3320", "series": "CAG", "text": "τί οὖν ὡς οὐσία εἰς συμβεβηκότα διαιρεῖται;", "seq": 3320}
{"id": "David_Passim_3321", "series": "CAG", "text": "οὐκοῦν ὤφειλον τὰ δέκα γένη συμβεβηκότα καλεῖσθαι.", "seq": 3321}
{"id": "David_Passim_3322", "series": "CAG", "text": "εἰ οὖν ὂν καλοῦνται, οὐδὲ ὡς οὐσία εἰς συμβεβηκότα.", "seq": 3322}
{"id": "David_Passim_3323", "series": "CAG", "text": "ἀλλὰ μὴν οὔτε ὡς συμβεβηκὸς εἰς οὐσίαν, ἐπεὶ πάντα οὐσία ὤφειλον λέγεσθαι.", "seq": 3323}
{"id": "David_Passim_3324", "series": "CAG", "text": "εἰ δὲ οὐ λέγεται, ὁμολογουμένως οὐδὲ ὡς συμβεβηκὸς εἰς οὐσίαν.", "seq": 3324}
{"id": "David_Passim_3325", "series": "CAG", "text": "λείπεται δεῖξαι ὅτι οὐδὲ ὡς γένος εἰς εἴδη.", "seq": 3325}
{"id": "David_Passim_3326", "series": "CAG", "text": "ἀρκτέον δὲ οὕτως·", "seq": 3326}
{"id": "David_Passim_3327", "series": "CAG", "text": "ἐν τοῖς ὑπὸ τὸ αὐτὸ γένος τελοῦσιν εἴδεσιν οὐκ ἔστι τὸ φύσει πρῶτον καὶ ὕστερον.", "seq": 3327}
{"id": "David_Passim_3328", "series": "CAG", "text": "εἰ οὖν ἡ οὐσία προτερεύει φύσει τῶν συμβεβηκότων, πρόδηλον ὡς οὐκ ἔσται τὰ τοιαῦτα εἴδη·", "seq": 3328}
{"id": "David_Passim_3329", "series": "CAG", "text": "εἰδῶν δὲ μὴ ὄντων οὐδὲ γένος ὑπάρχει.", "seq": 3329}
{"id": "David_Passim_3330", "series": "CAG", "text": "ὅτι δὲ ἡ οὐσία φύσει προτερεύει τῶν συμβεβηκότων, σαφὲς ἐκ τοῦ ἔχειν τὰ τοῖς φύσει πρώτοις παρακολουθοῦντα.", "seq": 3330}
{"id": "David_Passim_3331", "series": "CAG", "text": "τὸ τῇ φύσει πρῶτον συνεισφέρεται καὶ οὐ συνεισφέρει, συναναιρεῖ καὶ οὐ συναναιρεῖται·", "seq": 3331}
{"id": "David_Passim_3332", "series": "CAG", "text": "οἷον τὸ ζῷον φύσει ἐστὶ πρῶτον τοῦ ἀνθρώπου·", "seq": 3332}
{"id": "David_Passim_3333", "series": "CAG", "text": "συνεισφέρεται γὰρ καὶ οὐ συνεισφέρει·", "seq": 3333}
{"id": "David_Passim_3334", "series": "CAG", "text": "λέγων γὰρ ‘ἄνθρωπός ἐστι’ συνεισφέρεις τὸ ζῷον (εἰ γὰρ ἄνθρωπος, καὶ ζῷον), λέγων δὲ ‘ζῷόν ἐστιν’ οὐ συνεισφέρεις τὸν ἄνθρωπον·", "seq": 3334}
{"id": "David_Passim_3335", "series": "CAG", "text": "οὔτε γὰρ πᾶν ζῷον ἄνθρωπός ἐστι.", "seq": 3335}
{"id": "David_Passim_3336", "series": "CAG", "text": "πάλιν συναναιρεῖ καὶ οὐ συναναιρεῖται·", "seq": 3336}
{"id": "David_Passim_3337", "series": "CAG", "text": "λέγων γὰρ ‘οὐκ ἔστι ζῷον’ ἀναιρεῖς καὶ τὸν ἄνθρωπον, λέγων δὲ ‘οὐκ ἔστιν ἄνθρωπος’ οὐ συναναιρεῖς τὸ ζῷον.", "seq": 3337}
{"id": "David_Passim_3338", "series": "CAG", "text": "τὸ αὐτὸ δὲ καὶ ἐπὶ τῆς οὐσίας καὶ τῶν συμβεβηκότων ὑπάρχει·", "seq": 3338}
{"id": "David_Passim_3339", "series": "CAG", "text": "συνεισφέρεται γὰρ ἡ οὐσία καὶ οὐ συνεισφέρει·", "seq": 3339}
{"id": "David_Passim_3340", "series": "CAG", "text": "εἰ γὰρ εἴπῃς ‘λευκόν ἐστι’, συνεισφέρεις καὶ τὴν οὐσίαν (οὐ γάρ ἐστι λευκὸν ἔν τινι χωρὶς οὐσίας), λέγων δὲ ‘ἄνθρωπός ἐστιν’ οὐ συνεισφέρεις τὸ συμβεβηκός·", "seq": 3340}
{"id": "David_Passim_3341", "series": "CAG", "text": "οὔτε γὰρ πᾶς ἄνθρωπος λευκὸς ὑπάρχει.", "seq": 3341}
{"id": "David_Passim_3342", "series": "CAG", "text": "συναναιρεῖ δὲ καὶ οὐ συναναιρεῖται, ὅτι λέγων ‘οὐκ ἔστιν ἄνθρωπος’ συναναιρεῖς καὶ τὸ λευκόν, λέγων δὲ ‘οὐκ ἔστι λευκόν’ οὐκ ἀναιρεῖς καὶ τὸν ἄνθρωπον·", "seq": 3342}
{"id": "David_Passim_3343", "series": "CAG", "text": "οὔτε γὰρ ἐὰν μὴ ᾖ τις λευκός, ἄνθρωπος πάντως οὐκ ἔστιν.", "seq": 3343}
{"id": "David_Passim_3344", "series": "CAG", "text": "ἔτι οὐδέποτε ἐν τοῖς ὁμογενέσιν εἴδεσιν τὰ μὲν ἄσχετά ἐστι τὰ δὲ ἐν σχέσει, ἀλλ᾿ ἢ πάντα ἄσχετά ἐστιν ἢ πάντα ἐν σχέσει·", "seq": 3344}
{"id": "David_Passim_3345", "series": "CAG", "text": "ὁρῶμεν δὲ ἐπὶ τῶν προειρημένων γενικωτάτων γενῶν ὅτι τὰ μὲν ἄσχετά ἐστιν, ὥσπερ ἡ οὐσία καὶ τὰ συμβεβηκότα, τὰ δὲ ἐν σχέσει, ὡς ὁ πατὴρ καὶ ὁ υἱός, τὸ διπλοῦν καὶ τὸ ἁπλοῦν·", "seq": 3345}
{"id": "David_Passim_3346", "series": "CAG", "text": "οὐκ ἔστιν ἄρα ταῦτα εἴδη.", "seq": 3346}
{"id": "David_Passim_3347", "series": "CAG", "text": "ἔτι οὐδέποτε ἐν τοῖς ὁμογενέσιν εἴδεσι τὸ ἓν ὑποκείμενον τοῦ ἑτέρου γίνεται·", "seq": 3347}
{"id": "David_Passim_3348", "series": "CAG", "text": "ὁρῶμεν δὲ ὅτι ἡ οὐσία ὑποκείμενόν ἐστι τῶν συμβεβηκότων·", "seq": 3348}
{"id": "David_Passim_3349", "series": "CAG", "text": "οὐκ ἄρα εἴδη εἰσὶ τὰ τοιαῦτα.", "seq": 3349}
{"id": "David_Passim_3350", "series": "CAG", "text": "τέταρτον οὐδέποτε τὰ εἴδη παρωνύμως ἀπὸ τοῦ γένους παρονομάζεται, οἷον τὸ λογικὸν οὐ λέγομεν ζωότητα·", "seq": 3350}
{"id": "David_Passim_3351", "series": "CAG", "text": "εἰ δὲ παρωνύμως ταῦτα λέγεται (εἶναι γὰρ αὐτά φαμεν), ὁμολογουμένως οὐκ ἔστιν εἴδη.", "seq": 3351}
{"id": "David_Passim_3352", "series": "CAG", "text": "πέμπτον ἐν τοῖς ὁμογενέσιν εἴδεσιν οὐδέποτε τὸ μᾶλλον καὶ ἧττόν ἐστιν·", "seq": 3352}
{"id": "David_Passim_3353", "series": "CAG", "text": "εἰ δὲ ἐν τούτοις θεωρεῖται τὸ μᾶλλον καὶ ἧττον, ὥσπερ ἐν τῇ οὐσία τὸ μᾶλλον (μᾶλλον γὰρ ὄν ἐστιν), ἐν δὲ τοῖς συμβεβηκόσι τὸ ἧττον (ἧττον γάρ εἰσι τῆς οὐσίας), ὁμολογουμένως οὐκ ἔστι τὰ τοιαῦτα εἴδη.", "seq": 3353}
{"id": "David_Passim_3354", "series": "CAG", "text": "ἕκτον καὶ ἀναντίρρητον εἰ λέγεται ταῦτα εἴδη, πάντως καὶ διαφοραὶ λέγεται·", "seq": 3354}
{"id": "David_Passim_3355", "series": "CAG", "text": "εἴδη γὰρ μεταξὺ τῶν διαφορῶν γίνεται.", "seq": 3355}
{"id": "David_Passim_3356", "series": "CAG", "text": "τί οὖν;", "seq": 3356}
{"id": "David_Passim_3357", "series": "CAG", "text": "κατηγορεῖται τούτων τὸ ὂν ἢ οὐ κατηγορεῖται;", "seq": 3357}
{"id": "David_Passim_3358", "series": "CAG", "text": "εἰ μὲν εἴπῃς ὅτι κατηγορεῖται, ἀτόποις περιπεσῇ (οὐδέποτε γάρ φαμεν τῶν ἰδίων διαφορῶν γένος κατηγορεῖσθαι, διὸ οὔ φαμεν ζωότητα τὴν λογικότητα), εἰ δὲ μὴ εἴπῃς κατηγορεῖσθαι τὸ ὂν τῶν διαφορῶν, οὐκ εἰσὶν αἱ διαφοραί, διαφορῶν δὲ μὴ οὐσῶν οὐκ ἔσται εἴδη, εἰδῶν δὲ μὴ ὄντων οὐδὲ γένος ἔστι.", "seq": 3358}
{"id": "David_Passim_3359", "series": "CAG", "text": "καὶ τοσαῦτα μὲν ὑπὲρ τοῦ μὴ εἶναι τὸ ὂν γένος.", "seq": 3359}
{"id": "David_Passim_3360", "series": "CAG", "text": "ἐν ἑτέρᾳ δὲ θεωρίᾳ τὰ συνηγοροῦντα Πλάτωνι παραθησόμεθα.", "seq": 3360}
{"id": "David_Passim_3361", "series": "CAG", "text": "χωρητέον οὖν ἐντεῦθεν ἐπὶ τὴν λέξιν.", "seq": 3361}
{"id": "David_Passim_3362", "series": "CAG", "text": "5.", "seq": 3362}
{"id": "David_Passim_3363", "series": "CAG", "text": "14 Τὴν δὲ ὡς πρὸς τὰ μετ᾿ αὐτὸ οὐκ ἀλλοίαν ἔχει.", "seq": 3363}
{"id": "David_Passim_3364", "series": "CAG", "text": "Ἐν τούτῳ λύει τὸ ἄπορον·", "seq": 3364}
{"id": "David_Passim_3365", "series": "CAG", "text": "φησὶ γάρ·", "seq": 3365}
{"id": "David_Passim_3366", "series": "CAG", "text": "κἂν ἔχῃ τὸ εἰδικώτατον σχέσιν ὡς πρὸς τὰ πρὸ αὐτοῦ καὶ πρὸς τὰ μετ᾿ αὐτό, ἀλλ᾿ οὖν διαφορὰ οὐκ ἔστι καὶ διὰ τοῦτο δύο σχέσεις τὴν τοιαύτην σχέσιν οὐ λέγουσι·", "seq": 3366}
{"id": "David_Passim_3367", "series": "CAG", "text": "λέγεται γὰρ εἶδος καὶ πρὸς τὰ ἄτομα ὡς περιέχον αὐτά, λέγεται καὶ εἶδος τῶν πρὸ αὐτοῦ ὡς περιεχόμενον ὑπ᾿ αὐτῶν.", "seq": 3367}
{"id": "David_Passim_3368", "series": "CAG", "text": "5.", "seq": 3368}
{"id": "David_Passim_3369", "series": "CAG", "text": "23 Τὰ δὲ πρὸ τῶν εἰδικωτάτων ἄχρι τοῦ γενικωτάτου ἀνιόντα γένη λέγεται καὶ εἴδη καὶ ὑπάλληλα γένη.", "seq": 3369}
{"id": "David_Passim_3370", "series": "CAG", "text": "Φησὶν ὅτι τὸ ζῷον καὶ τὸ ἔμψυχον καὶ τὸ σῶμα καὶ ὅλα τὰ μέσα γένη καὶ εἴδη λέγεται, διὰ ταῦτα καὶ ὑπάλληλα γένη λέγεται.", "seq": 3370}
{"id": "David_Passim_3371", "series": "CAG", "text": "6.", "seq": 3371}
{"id": "David_Passim_3372", "series": "CAG", "text": "4 <Ὡς ἐπὶ τὸ πλεῖστον>.", "seq": 3372}
{"id": "David_Passim_3373", "series": "CAG", "text": "Ὡς ἐπὶ τὸ πλεῖστόν φασι λέγειν αὐτόν, ἐπειδὴ οὐ πάντων τῶν γενῶν ὁ Ζεὺς ἀρχὴ ὑπάρχει, εἴ γε δηλοῖ τοῦτο ὁ ποιητὴς λέγων", "seq": 3373}
{"id": "David_Passim_3374", "series": "CAG", "text": "τριχθὰ δὲ πάντα δέδασται.", "seq": 3374}
{"id": "David_Passim_3375", "series": "CAG", "text": "6.", "seq": 3375}
{"id": "David_Passim_3376", "series": "CAG", "text": "6 Ὥς φησιν Ἀριστοτέλης.", "seq": 3376}
{"id": "David_Passim_3377", "series": "CAG", "text": "Βούλεται παραστήσασθαι ἐξ Ἀριστοτελικῶν παραδειγμάτων ὡς οὐκ ἔστι τὸ ὂν γένος ἀλλ᾿ ὁμώνυμος φωνή·", "seq": 3377}
{"id": "David_Passim_3378", "series": "CAG", "text": "ὀνόματος γὰρ μόνον μεταδίδωσι ταῖς δέκα κατηγορίαις, οὐκέτι δὲ καὶ πράγματος.", "seq": 3378}
{"id": "David_Passim_3379", "series": "CAG", "text": "καλοῦμεν δὲ πάντα τὰ γενικώτατα γένη ὄντα.", "seq": 3379}
{"id": "David_Passim_3380", "series": "CAG", "text": "6.", "seq": 3380}
{"id": "David_Passim_3381", "series": "CAG", "text": "9 Συνωνύμως ἂν πάντα ὄντα ἐλέγετο.", "seq": 3381}
{"id": "David_Passim_3382", "series": "CAG", "text": "Λέγει γὰρ ὅτι εἰ γένος ἦν τὸ ὄν, καὶ πράγματος μετεδίδου καὶ ὀνόματος τοῖς δέκα γενικωτάτοις γένεσιν.", "seq": 3382}
{"id": "David_Passim_3383", "series": "CAG", "text": "6.", "seq": 3383}
{"id": "David_Passim_3384", "series": "CAG", "text": "10 Ἡ κοινωνία κατὰ τοὔνομα μόνον, οὐκέτι μὴν καὶ κατὰ τὸν λόγον τὸν κατὰ τοὔνομα.", "seq": 3384}
{"id": "David_Passim_3385", "series": "CAG", "text": "Φησὶν ὅτι ὀνόματος μεταδίδωσιν, οὐκέτι δὲ καὶ τοῦ κατὰ τοὔνομα πράγματος.", "seq": 3385}
{"id": "David_Passim_3386", "series": "CAG", "text": "Πρᾶξις κ΄.", "seq": 3386}
{"id": "David_Passim_3387", "series": "CAG", "text": "Ἐπειδήπερ οὐκ ἐχρῆν τὰ Πλάτωνος παριδεῖν δόγματα ἀνδρὸς εἰς φῶς τὴν φιλοσοφίαν ἐνέγκαντος, φέρε συνηγορίαν τινὰ αὐτῷ τοῦ εἶναι γένος τὸ ὂν ἐκθησόμεθα·", "seq": 3387}
{"id": "David_Passim_3388", "series": "CAG", "text": "φησὶ γὰρ ὅτι γένος ἐστὶ τὸ ὄν·", "seq": 3388}
{"id": "David_Passim_3389", "series": "CAG", "text": "τὸ γὰρ μεταδιδοῦν ὀνόματος καὶ πράγματος καθολικοῖς τισι τοῦτο γένος λέγεται·", "seq": 3389}
{"id": "David_Passim_3390", "series": "CAG", "text": "εἰ οὖν τὸ ὂν μεταδίδωσι τοῖς δέκα γενικωτάτοις γένεσιν ὀνόματος καὶ πράγματος, σαφὲς ὅτι γένος ἐστί.", "seq": 3390}
{"id": "David_Passim_3391", "series": "CAG", "text": "πρόσκειται δὲ καθολικοῖς διὰ τὸ εἰδικώτατον εἶδος·", "seq": 3391}
{"id": "David_Passim_3392", "series": "CAG", "text": "τοῦτο γὰρ μεταδίδωσι τοῖς ἀτόμοις ὀνόματος καὶ πράγματος, γένος δὲ οὐκ ἔστι, καθὸ τὰ ἄτομα καθολικὰ οὔκ εἰσι.", "seq": 3392}
{"id": "David_Passim_3393", "series": "CAG", "text": "διαφωνεῖ δὲ πρὸς τὰ τοιαῦτα ὁ Ἀριστοτέλης, ὡς καὶ πρὸ μικροῦ ἐξέθετο ὁ Πορφύριος γένος οὐ λέγων τὸ ὄν, ἀλλ᾿ ὁμώνυμον φωνήν.", "seq": 3393}
{"id": "David_Passim_3394", "series": "CAG", "text": "ὅτι δὲ οὔτε γένος ἐστὶν οὔθ᾿ ὁμώνυμος φωνή, ἐντελεστέρως ἐν ταῖς Κατηγορίαις ἡμῖν δέδεικται καὶ πρὸ ὀλίγου.", "seq": 3394}
{"id": "David_Passim_3395", "series": "CAG", "text": "πρὸς ὑπόμνησιν δὲ ἔτι τῶν κωλυόντων αὐτὸ εἶναι γένος καὶ ὁμώνυμον φωνὴν βραχέα λέξωμεν.", "seq": 3395}
{"id": "David_Passim_3396", "series": "CAG", "text": "γένος οὖν οὐ δύναται τὸ ὂν εἶναι, καθὸ ἐν τοῖς ὑπὸ τὸ αὐτὸ γένος τελοῦσιν εἴδεσιν οὐκ ἔστιν εὑρεῖν τὸ φύσει πρῶτον καὶ ὕστερον·", "seq": 3396}
{"id": "David_Passim_3397", "series": "CAG", "text": "εἰ οὖν ἡ οὐσία φύσει πρῶτόν ἐστι τῶν συμβεβηκότων, ὁμολογουμένως οὐ λεχθείη εἶδος τοῦ ὄντος.", "seq": 3397}
{"id": "David_Passim_3398", "series": "CAG", "text": "ἀλλὰ μὴν οὔτε ὁμώνυμος φωνὴ δύναται εἶναι, καθὸ ἡ ὁμώνυμος οὐ φωνὴ μεταδίδωσι πράγματος (οὔτε γὰρ ἐὰν εἴπω ‘κύων’, δηλῶ τὸν χερσαῖον ἢ τὸν θαλάττιον)·", "seq": 3398}
{"id": "David_Passim_3399", "series": "CAG", "text": "εἰ οὖν μεταδίδωσι τὸ ὂν πράγματος (ἡ οὐσία γὰρ καὶ ὂν λέγεται καὶ ἔστιν, ὁμοίως καὶ τὰ συμβεβηκότα), ὁμολογουμένως οὐδὲ ὁμώνυμος φωνή ἐστι.", "seq": 3399}
{"id": "David_Passim_3400", "series": "CAG", "text": "τί οὖν φαμεν;", "seq": 3400}
{"id": "David_Passim_3401", "series": "CAG", "text": "ἆρα διαφωνοῦσιν οἱ φιλόσοφοι πρὸς ἀλλήλους καὶ τοῦ ἀληθοῦς οὐχ ἥψαντο;", "seq": 3401}
{"id": "David_Passim_3402", "series": "CAG", "text": "φαμὲν οὔ·", "seq": 3402}
{"id": "David_Passim_3403", "series": "CAG", "text": "ἄμφω γὰρ διὰ τῶν ἄκρων τὸ μέσον συμπεριέλαβον·", "seq": 3403}
{"id": "David_Passim_3404", "series": "CAG", "text": "τὸ γὰρ ὂν ὡς τὰ ἀφ᾿ ἑνὸς καὶ πρὸς ἓν διαιρεῖται εἰς τὰ δέκα γενικώτατα γένη.", "seq": 3404}
{"id": "David_Passim_3405", "series": "CAG", "text": "ἐπεὶ οὖν ἔχει τινὰ ὑποψίαν τοῦ ὁμωνύμως κατηγορεῖσθαι τῶν δέκα γενῶν, φησὶν ὁ Ἀριστοτέλης ὁμωνύμως κατηγορεῖσθαι, ἐπεὶ δὲ ἔχει καί τινα ὑποψίαν τοῦ συνωνύμως κατηγορεῖσθαι, φησὶν αὐτὸ ὁ Πλάτων ὡς γένος κατηγορεῖσθαι·", "seq": 3405}
{"id": "David_Passim_3406", "series": "CAG", "text": "σώζει γὰρ καί τινα τῆς ὁμωνύμου φωνῆς, ἐπειδὴ μεταδίδωσι τοῦ ὀνόματος (τελείως δὲ ὁμώνυμος οὐ δύναται εἶναι, ἐπειδὴ οὐ μεταδίδωσι πράγματος), σώζει δέ τινα τῆς συνωνύμου φωνῆς, ἐπειδὴ μεταδίδωσιν ὀνόματος καὶ πράγματος·", "seq": 3406}
{"id": "David_Passim_3407", "series": "CAG", "text": "τελείως δὲ οὐ δύναται συνώνυμος εἶναι, ἐπειδὴ ἐξ ἴσου οὐ μεταδίδωσι τοῦ πράγματος·", "seq": 3407}
{"id": "David_Passim_3408", "series": "CAG", "text": "τὸ δὲ μεταδιδοῦν ὀνόματος καὶ πράγματος ἐπίσης πᾶσι μεταδίδωσιν, ὥσπερ τὸ ζῷον τῷ ἀνθρώπῳ καὶ ἵππῳ ἐπίσης μεταδίδωσιν ὀνόματος καὶ πράγματος.", "seq": 3408}
{"id": "David_Passim_3409", "series": "CAG", "text": "διὰ ταύτας οὖν τὰς ὑπονοίας εἰρήκασιν αὐτὸ οἱ φιλόσοφοι ὁμωνύμως καὶ συνωνύμως κατηγορεῖσθαι τὸ μέσον διὰ τῶν ἄκρων συμπεριλαμβάνοντες, λέγω δὲ τὸ ἀφ᾿ ἑνὸς καὶ πρὸς ἕν.", "seq": 3409}
{"id": "David_Passim_3410", "series": "CAG", "text": "καὶ πῶς ὡς ἀφ᾿ ἑνὸς καὶ πρὸς ἓν διαιρεῖται, εἴρηται ἐντελῶς ἐν ταῖς Κατηγορίαις περὶ τῆς τοιαύτης διαιρέσεως καὶ νῦν διὰ βραχέων αὐτὴν σαφηνίσωμεν.", "seq": 3410}
{"id": "David_Passim_3411", "series": "CAG", "text": "Ἀφ᾿ ἑνὸς λέγομεν διαιρεῖσθαι, ὅταν τὰ διαιρούμενα ἀφ᾿ ἑνὸς ποιητικοῦ ἔχῃ τὸ εἶναι, διαφέρῃ δὲ κατὰ τὴν ἐνέργειαν, οἷον τὸ ἰατρικὸν σμιλίον καὶ ἰατρικὸν βιβλίον ἀφ᾿ ἑνός φαμεν εἶναι (τὴν γὰρ ἰατρικὴν ποιητικὴν αὐτῶν λέγομεν), οὐ ταὐτὸν δὲ τὸ σμιλίον καὶ τὸ βιβλίον ἐστίν·", "seq": 3411}
{"id": "David_Passim_3412", "series": "CAG", "text": "ἡ γὰρ ἐνέργεια τούτων διάφορος·", "seq": 3412}
{"id": "David_Passim_3413", "series": "CAG", "text": "τὰ μέντοι δύο τὴν ἰατρικὴν ποιητικὴν ἔχει.", "seq": 3413}
{"id": "David_Passim_3414", "series": "CAG", "text": "καὶ πρὸς ἓν δέ φαμεν, ὅταν πρὸς ἕν τι τέλος ἀφορᾷ τὸ λεγόμενον, οἷον τὸ ὑγιεινὸν σμιλίον, τὸ ὑγιεινὸν βιβλίον·", "seq": 3414}
{"id": "David_Passim_3415", "series": "CAG", "text": "τὸ γὰρ σμιλίον τοῦτο οὔ φαμεν ἀπὸ τῆς ὑγείας γεγονέναι, ἀλλὰ τὸ ποιοῦν τὴν ὑγείαν, ὁμοίως καὶ τὸ βιβλίον οὐκ ἀπὸ τῆς ὑγείας φαμὲν ὑγιεινόν, ἀλλὰ τὸ ἔχον τὸ τέλος πρὸς ὑγίειαν ἀφορῶν.", "seq": 3415}
{"id": "David_Passim_3416", "series": "CAG", "text": "οὕτως οὖν καὶ τὸ ὂν διαιρεῖται εἰς τὰ δέκα γένη ὡς τὰ ἀφ᾿ ἑνὸς καὶ πρὸς ἕν·", "seq": 3416}
{"id": "David_Passim_3417", "series": "CAG", "text": "ἀφ᾿ ἑνὸς μὲν ὅτι ὥσπερ τὸ ἰατρικὸν σμιλίον καὶ τὸ ἰατρικὸν βιβλίον μίαν ποιητικὴν ἔχει τὴν ἰατρικήν, οὕτω καὶ τὰ δέκα γένη ποιητικὸν ἔχει τὸ ὄν·", "seq": 3417}
{"id": "David_Passim_3418", "series": "CAG", "text": "πρὸς ἓν δὲ ὅτι ὥσπερ τὸ ὑγιεινὸν σμιλίον ἐφίεται ποιεῖν τὴν ὑγίειαν (τέλος γὰρ ἔχει ταύτην), οὕτω καὶ τὰ δέκα γένη τέλος ἔχουσι τὸ ὄν·", "seq": 3418}
{"id": "David_Passim_3419", "series": "CAG", "text": "ἐφίεται γὰρ τοῦ εἶναι.", "seq": 3419}
{"id": "David_Passim_3420", "series": "CAG", "text": "Διαιτήσαντες οὖν τοὺς φιλοσόφους φέρε εἴπωμεν ποσαχῶς λαμβάνεται τὸ ὄν.", "seq": 3420}
{"id": "David_Passim_3421", "series": "CAG", "text": "λαμβάνεται τοίνυν τριχῶς, καὶ σαφές γε ἐκ τῆς τοιαύτης διαιρέσεως·", "seq": 3421}
{"id": "David_Passim_3422", "series": "CAG", "text": "τὸ ὂν ἢ πεπερασμένον ἐστὶ τῇ φύσει καὶ τῇ γνώσει ἢ τῇ φύσει μὲν πεπερασμένον ἀπέραντον δὲ τῇ γνώσει ἢ τῇ γνώσει πεπερασμένον καὶ τῇ φύσει ἀπέραντον.", "seq": 3422}
{"id": "David_Passim_3423", "series": "CAG", "text": "ἓν δὲ τούτων σκέλος οὐ συνίσταται, λέγω δὲ τὸ ὕστερον·", "seq": 3423}
{"id": "David_Passim_3424", "series": "CAG", "text": "οὔτε γὰρ ἔστι τι πεπερασμένον τῇ γνώσει, ὅπερ οὐ πεπέρασται τῇ φύσει·", "seq": 3424}
{"id": "David_Passim_3425", "series": "CAG", "text": "ποῦ γὰρ διήκει ἡ γνῶσις, ὅπου οὐ διήκει ἡ φύσις;", "seq": 3425}
{"id": "David_Passim_3426", "series": "CAG", "text": "τοὐναντίον δὲ εἰς πολλὰ διήκει ἡ φύσις, ὅπου οὐ διήκει ἡ γνῶσις, ὡς ἔχομεν δεῖξαι.", "seq": 3426}
{"id": "David_Passim_3427", "series": "CAG", "text": "καὶ πεπερασμένα φαμὲν τῇ φύσει καὶ τῇ γνώσει τὰ δέκα καθολικώτατα γένη·", "seq": 3427}
{"id": "David_Passim_3428", "series": "CAG", "text": "ταῦτα γὰρ καὶ πεπέρανται τῇ φύσει, καθὸ αὐτὴ ταῦτα ἐδημιούργησε, πεπέρανται δὲ καὶ τῇ γνώσει, καθὸ γινώσκομεν αὐτὰ δέκα εἶναι.", "seq": 3428}
{"id": "David_Passim_3429", "series": "CAG", "text": "μὴ πεπερασμένα δὲ τῇ φύσει καὶ τῇ γνώσει φαμὲν τὰ ἄτομα·", "seq": 3429}
{"id": "David_Passim_3430", "series": "CAG", "text": "ταῦτα γὰρ οὔτε τῇ φύσει πεπέρανται οὔτε τῇ γνώσει·", "seq": 3430}
{"id": "David_Passim_3431", "series": "CAG", "text": "τῇ φύσει μὲν καθὸ ἀεὶ γίνεται (τὸ γοῦν ἀεὶ γινόμενον οὐ πεπέρασται τῇ φύσει), οὔτε τῇ γνώσει·", "seq": 3431}
{"id": "David_Passim_3432", "series": "CAG", "text": "εἰ γὰρ τῇ φύσει οὐ πεπέρανται, πολλῷ μᾶλλον οὐδὲ τῇ γνώσει.", "seq": 3432}
{"id": "David_Passim_3433", "series": "CAG", "text": "ἄπειρα δὲ τὰ ἄτομά φαμεν οὐ καθὸ ἀδιεξίτητά ἐστι (πάντως γὰρ πεπερασμένα ἐστὶ τὰ ἐν τόπῳ πεπερασμένῳ ὄντα, ταῦτα δὲ ἐν πεπερασμένῳ τόπῳ εἰσίν), ἀλλὰ καθὸ ἀεὶ γίνονται καὶ πέρας τοῦ γίνεσθαι οὐκ ἔχει.", "seq": 3433}
{"id": "David_Passim_3434", "series": "CAG", "text": "πεπερασμένα δὲ τῇ φύσει ἀπέραντα δὲ τῇ γνώσει εἰσὶ τὰ ὄντα, καθάπερ εἰσὶ τὰ εἴδη·", "seq": 3434}
{"id": "David_Passim_3435", "series": "CAG", "text": "τὰ γὰρ εἴδη πάντως πεπέρασται τῇ φύσει, οὐ πάντως δὲ καὶ τῇ γνώσει·", "seq": 3435}
{"id": "David_Passim_3436", "series": "CAG", "text": "ἔστι γὰρ πολλὰ εἴδη ἐν σπηλαίοις κεκρυμμένα, ἅπερ οὐ γινώσκομεν.", "seq": 3436}
{"id": "David_Passim_3437", "series": "CAG", "text": "ἔχομεν οὖν ἐκ τῆς τοιαύτης διαιρέσεως ὅτι τριχῶς λαμβάνεται τὰ ὄντα·", "seq": 3437}
{"id": "David_Passim_3438", "series": "CAG", "text": "ἢ γάρ ἐστι γενικώτατα ἢ ἄτομα ἢ εἴδη.", "seq": 3438}
{"id": "David_Passim_3439", "series": "CAG", "text": "Πρᾶξις κα΄.", "seq": 3439}
{"id": "David_Passim_3440", "series": "CAG", "text": "Εἰ καὶ παρακολουθεῖν τῷ Σταγειρίτῃ προαιρεῖται ὁ φιλόσοφος, ἀλλ᾿ ὅμως οὐ πάντῃ ἀμνημονεῖ τῆς τοῦ οἰκείου διδασκάλου παραγγελίας, φημὶ δὲ τοῦ Πλάτωνος·", "seq": 3440}
{"id": "David_Passim_3441", "series": "CAG", "text": "τρεῖς γὰρ αὐτοῦ τρόπους πάσῃ διαιρέσει συμβαλλομένους παρατίθησι, ὧν ὁ πρῶτος τοιοῦτος ὑπάρχει·", "seq": 3441}
{"id": "David_Passim_3442", "series": "CAG", "text": "ὁ Πλάτων φησὶν ὅτι δεῖ τὴν διαίρεσιν ἀπὸ τῶν γενικωτάτων γίνεσθαι μέχρι μόνων τῶν εἰδικωτάτων, περαιτέρω δὲ προκόπτειν αὐτὴν ἀηδές ἐστι.", "seq": 3442}
{"id": "David_Passim_3443", "series": "CAG", "text": "ζητοῦμεν δὲ διὰ τί καὶ τὸ εἰδικώτατον οὐ διαιροῦμεν εἰς ἄτομα.", "seq": 3443}
{"id": "David_Passim_3444", "series": "CAG", "text": "τινὲς οὖν ψυχρῶς ἐπιλυόμενοί φασιν ὅτι διὰ τοῦτο μέχρι τῶν εἰδικωτάτων μόνον παραγγέλλει ὁ Πλάτων τὴν διαίρεσιν ποιεῖσθαι, ἐπειδὴ περαιτέρω ἐὰν ποιήσωμεν, ἀτόμων εὑρίσκεται ἡ διαίρεσις, τὰ δὲ ἄτομα ἄπειρά εἰσι, τὰ δὲ ἄπειρα ἄγνωστα, διαίρεσις δὲ ἀγνώστων οὐ γίνεται.", "seq": 3444}
{"id": "David_Passim_3445", "series": "CAG", "text": "ἔχομεν δὲ ἐντεῦθεν προσπορίσματος μοῖραν, ὅτι οὐδὲ τὸ εἶδος ὀφείλει διαιρεῖσθαι εἰς ἄτομα.", "seq": 3445}
{"id": "David_Passim_3446", "series": "CAG", "text": "ὡς ἔφαμεν δέ, ψυχρὰν αἰτίαν οὗτοι εἰρήκασι·", "seq": 3446}
{"id": "David_Passim_3447", "series": "CAG", "text": "τούτῳ γὰρ τῷ λόγῳ οὐ μόνον ἡ ὡς τὸ εἶδος εἰς ἄτομα διαίρεσις ἐκβληθήσεται, ἀλλὰ καὶ ἡ ὡς ὁμώνυμος φωνὴ εἰς πολλὰ σημαινόμενα·", "seq": 3447}
{"id": "David_Passim_3448", "series": "CAG", "text": "ἡ γὰρ Ἀλέξανδρος φωνὴ ὁμώνυμος οὖσα οὐκ ὀφείλει διαιρεῖσθαι, ἐπειδὴ πολλοί εἰσιν Ἀλέξανδροι ἄγνωστοι.", "seq": 3448}
{"id": "David_Passim_3449", "series": "CAG", "text": "ἀλλὰ μὴν καὶ ἡ ὡς συμβεβηκότα εἰς οὐσίαν·", "seq": 3449}
{"id": "David_Passim_3450", "series": "CAG", "text": "τὸ γὰρ λευκὸν οὐ μόνον διαιρεῖται εἰς κύκνον καὶ γάλα καὶ ψιμύθιον, ἀλλὰ καὶ εἰς πολλὰ εἴδη ἡμῖν ἄγνωστα.", "seq": 3450}
{"id": "David_Passim_3451", "series": "CAG", "text": "τί δὲ τῶν τοιούτων λέγω ἀναιρετικὴν εἶναι τὴν τοιαύτην ἐπίλυσιν, ἐξὸν καὶ αὐτὸ τὸ γένος, ὅπερ ἐστὶ μεγίστη διαίρεσις, κωλύειν εἰς αὐτὰ τὰ εἴδη διαιρεῖσθαι·", "seq": 3451}
{"id": "David_Passim_3452", "series": "CAG", "text": "καὶ τὸ γένος γὰρ τούτῳ τῷ λόγῳ οὐ διαιρεῖται εἰς εἴδη, ἐπειδὴ ἔστι πολλὰ εἴδη καὶ ἐν σπηλαίοις καὶ ἐν τῷ βάθει τῆς θαλάσσης κεκρυμμένα, ἅπερ οὐ γινώσκομεν.", "seq": 3452}
{"id": "David_Passim_3453", "series": "CAG", "text": "αὕτη οὖν ἐστιν ἡ αἰτία, ἥτις καὶ τὰ ἄτοπα τῆς πρώτης ἐπιλύσεως διαλύσεται.", "seq": 3453}
{"id": "David_Passim_3454", "series": "CAG", "text": "διὰ τοῦτο ὁ Πλάτων παρακελεύεται περαιτέρω τῶν εἰδικωτάτων μὴ ποιεῖσθαι τὴν διαίρεσιν, ἵνα μὴ εὑρεθῶμεν τῶν ἀτόμων ποιοῦντες διαίρεσιν τῶν μὴ ἐχόντων μονήν τινα·", "seq": 3454}
{"id": "David_Passim_3455", "series": "CAG", "text": "εἰ γὰρ εἴπωμεν τὸν ἄνθρωπον διαιρεθῆναι εἰς Σωκράτην καὶ Ἀλκιβιάδην, οὐ μένει Σωκράτης καὶ Ἀλκιβιάδης, ἵνα πιστώσωνται τὴν διαίρεσιν, ἀλλ᾿ εὑρισκόμεθα ποιοῦντες διαίρεσίν τινων σήμερον μὲν ὄντων αὔριον δὲ φθειρομένων καὶ γνῶσιν τῆς διαιρέσεως μὴ ἐχόντων.", "seq": 3455}
{"id": "David_Passim_3456", "series": "CAG", "text": "αὕτη ἡ ἐπίλυσις οὐ κωλύσει τὸ γένος εἰς εἴδη διαιρεῖσθαι (μονὴν γὰρ ἔχει τὸ εἶδος), οὐδὲ τὰ συμβεβηκότα εἰς οὐσίαν, ἐπειδὴ διαιρεῖται εἰς κύκνον οὐ τὸν τοιόνδε, ἀλλὰ τὸν ἁπλῶς κύκνον, ὁ δὲ ἁπλῶς κύκνος εἶδός ἐστι καὶ τὸ ἁπλῶς γάλα.", "seq": 3456}
{"id": "David_Passim_3457", "series": "CAG", "text": "εἰ δὲ εἴπῃς ‘τούτῳ τῷ λόγῳ καὶ ἡ ὡς εἶδος εἰς ἄτομα ὀφείλει διαιρεῖσθαι οὐκ εἰς τὸ τοιόνδε ἄτομον, ἀλλ᾿ εἰς τὸ ἁπλῶς ἄτομον’, ἁμαρτίᾳ περιπεσῇ·", "seq": 3457}
{"id": "David_Passim_3458", "series": "CAG", "text": "τὸ γὰρ ἁπλῶς ἄτομον εἶδός ἐστι·", "seq": 3458}
{"id": "David_Passim_3459", "series": "CAG", "text": "διαιρεθῆναι δὲ εἶδος εἰς εἶδος πάνυ ἀσύστατον.", "seq": 3459}
{"id": "David_Passim_3460", "series": "CAG", "text": "ἡ δὲ ὡς ὁμώνυμος φωνὴ ἐκβληθήσεται, εἰ ἀτόμων εὑρεθήσεται ἡ φωνὴ οἷον Ἀλέξανδρος·", "seq": 3460}
{"id": "David_Passim_3461", "series": "CAG", "text": "ὁ γὰρ Ἀλέξανδρος φθείρεται·", "seq": 3461}
{"id": "David_Passim_3462", "series": "CAG", "text": "φθειρόμενα δὲ τὰ τοιαῦτα γνῶσιν οὐκ ἔχει.", "seq": 3462}
{"id": "David_Passim_3463", "series": "CAG", "text": "εἰ δ᾿ αὖ εἰδῶν κατηγορεῖται, οὐκ ἐκβληθήσεται·", "seq": 3463}
{"id": "David_Passim_3464", "series": "CAG", "text": "τὰ γὰρ εἴδη οὐ φθείρεται·", "seq": 3464}
{"id": "David_Passim_3465", "series": "CAG", "text": "οἷον ἡ κύων φωνὴ εἰδῶν κατηγορεῖται, ἀπὸ δὲ τοῦ τοιούτου λόγου οὐ κωλύεται.", "seq": 3465}
{"id": "David_Passim_3466", "series": "CAG", "text": "ὅλαι μὲν οὖν αἱ εἰς ἄτομα διαιρούμεναι ἐκβληθήσονται.", "seq": 3466}
{"id": "David_Passim_3467", "series": "CAG", "text": "Δεύτερος τρόπος ἐστὶν ὁ λέγων ὅτι δεῖ τὸν διαιροῦντα κατὰ τάξιν διαιρεῖν, μηκέτι δὲ ὑπερβαθμίῳ ποδί, οἷον δεῖ τὴν οὐσίαν εἰς σῶμα καὶ ἀσώματον διελεῖν, οὐ δεῖ δὲ εἰς ζῷον ζῳόφυτον φυτόν, ἵνα μὴ τὰ ἐν μέσῳ ἐάσωμεν.", "seq": 3467}
{"id": "David_Passim_3468", "series": "CAG", "text": "ὅτι δὲ φίλιος ὑπάρχει Πλάτωνι ἡ κατὰ τάξιν διαίρεσις, σαφὲς ἐκ τοῦ λέγειν ‘τὴν δὲ διαιρετικὴν μέθοδον οὐδὲν καυχήσεται φυγόν·’", "seq": 3468}
{"id": "David_Passim_3469", "series": "CAG", "text": "τρίτος δὲ τρόπος ἐστὶν ὁ παρακελευόμενος εἰς οὐσιώδεις φωνὰς διαιρεῖν τὰ διαιρούμενα, μηκέτι δὲ εἰς ἐπουσιώδεις·", "seq": 3469}
{"id": "David_Passim_3470", "series": "CAG", "text": "αἱ γὰρ ἐπουσιώδεις ἄπειροί εἰσι καὶ οὐχ ὑφίστανται τὴν φύσιν, ὥσπερ αἱ οὐσιώδεις·", "seq": 3470}
{"id": "David_Passim_3471", "series": "CAG", "text": "ἀπείρων δὲ φωνῶν καὶ μὴ δηλουσῶν τὴν φύσιν τοῦ ὑποκειμένου οὐκ ἀναγκαῖον ποιεῖσθαι τὴν διαίρεσιν.", "seq": 3471}
{"id": "David_Passim_3472", "series": "CAG", "text": "διὰ τοῦτο ἐν Φιλήβῳ λέγει ὅτι ὁ ποιῶν διαίρεσιν οὐσιωδῶν φωνῶν ἔοικε τεχνίτῃ μαγείρῳ κατ᾿ ἄρθρα τὰς τομὰς ποιοῦντι, ὁ δέ γε τῶν ἐπουσιωδῶν ποιῶν διαίρεσιν ἀτέχνῳ μαγείρῳ ἔοικε κατ᾿ ἄρθρα τὰς τομὰς μὴ ποιοῦντι ἀλλὰ δι᾿ ἀτεχνίαν διὰ πολλῶν τὴν τομὴν ἀπεργαζομένῳ.", "seq": 3472}
{"id": "David_Passim_3473", "series": "CAG", "text": "ἰστέον δὲ ὡς ἐφ᾿ ἑκάστης διαιρέσεως ἔστιν ἄνοδος καὶ κάθοδος, καὶ ἡ μὲν κάθοδος ἀπὸ τῶν γενικωτάτων ἐπὶ τὰ εἰδικώτατα χωροῦσα πλατεῖαν ποιεῖται τὴν διαίρεσιν ἡ δὲ ἄνοδος ἀπὸ τῶν εἰδικωτάτων ἐπὶ τὰ γενικώτατα χωροῦσα στενοῖ τὴν διαίρεσιν.", "seq": 3473}
{"id": "David_Passim_3474", "series": "CAG", "text": "τὸ τοιοῦτον δὲ ἔοικε δεκάδι·", "seq": 3474}
{"id": "David_Passim_3475", "series": "CAG", "text": "εἰ γὰρ ἀπὸ μονάδος ἐπὶ τὴν δεκάδα ἁπλώσῃς τὸν ἀριθμόν, πλατύνεις τὸ μέτρον, εἰ δὲ ἀπὸ τῆς δεκάδος ἐπὶ τὴν μονάδα, στενοῖς τὸν ἀριθμόν.", "seq": 3475}
{"id": "David_Passim_3476", "series": "CAG", "text": "ἀπὸ οὖν τῆς οὐσίας ἐπὶ τὸ εἰδικώτατον χωρῶν, λέγω δὲ ἐπὶ τὸν ἄνθρωπον, ἐξαπλοῖς τὴν διαίρεσιν, ἀπὸ δὲ τοῦ ἀνθρώπου ἐπὶ τὴν οὐσίαν στενοῖς αὐτήν.", "seq": 3476}
{"id": "David_Passim_3477", "series": "CAG", "text": "6.", "seq": 3477}
{"id": "David_Passim_3478", "series": "CAG", "text": "11 Δέκα μὲν οὖν τὰ γενικώτατα.", "seq": 3478}
{"id": "David_Passim_3479", "series": "CAG", "text": "Ἐπ᾿ αὐτὰ τὰ πράγματα χωρεῖ ὁ Πορφύριος.", "seq": 3479}
{"id": "David_Passim_3480", "series": "CAG", "text": "δηλοῖ δὲ τὰ πεπερασμένα τῇ φύσει καὶ τῇ γνώσει, λέγω δὲ τὰ γενικώτατα·", "seq": 3480}
{"id": "David_Passim_3481", "series": "CAG", "text": "εἰρηκὼς γὰρ τὸ δέκα δηλοῖ ὅτι καὶ γινώσκομεν αὐτά, δηλοῖ δὲ ὅτι καὶ ἡ φύσις ἐδημιούργησεν αὐτά.", "seq": 3481}
{"id": "David_Passim_3482", "series": "CAG", "text": "6.", "seq": 3482}
{"id": "David_Passim_3483", "series": "CAG", "text": "12 Τὰ δὲ εἰδικώτατα ἐν ἀριθμῷ μέν τινι, οὐ μὴν ἀπείρῳ.", "seq": 3483}
{"id": "David_Passim_3484", "series": "CAG", "text": "Πάλιν ὧδε δηλοῖ τὰ τῇ φύσει πεπερασμένα, ἀπέραντα δὲ τῇ γνώσει·", "seq": 3484}
{"id": "David_Passim_3485", "series": "CAG", "text": "ἐν γὰρ τῷ λέγειν ἀριθμῷ μέν τινι δηλοῖ ὅτι πεπέρασται τῇ φύσει, ἐν δὲ τῷ λέγειν οὐ μὴν ἀπείρῳ δηλοῖ ὅτι ἀπέραντά ἐστι τῇ γνώσει·", "seq": 3485}
{"id": "David_Passim_3486", "series": "CAG", "text": "ὡς γὰρ ἡμῶν μὴ γινωσκόντων εἰ ἄπειρόν ἐστιν ἢ μή, φησὶν οὐ μὴν ἀπείρῳ.", "seq": 3486}
{"id": "David_Passim_3487", "series": "CAG", "text": "6.", "seq": 3487}
{"id": "David_Passim_3488", "series": "CAG", "text": "12 Τὰ δὲ ἄτομα, ἅπερ ἦν μετὰ τὰ εἰδικώτατα, ἄπειρα.", "seq": 3488}
{"id": "David_Passim_3489", "series": "CAG", "text": "Τινὲς λέγουσιν ὅτι ἄπειρον λέγει τὸ ἀόριστον, δηλοῖ δὲ ὅτι οὔτε τῇ τῇ φύσει οὔτε γνώσει πεπέρασται, οὐχ ὡς δὲ ἐν τῇ θεωρίᾳ ἐλέγομεν, ἄπειρα αὐτὰ διὰ τὸ ἀεὶ γεννᾶσθαι (οὕτως φασὶ καὶ οἱ ἐξηγηταί), ἀλλὰ τὰ ἐν τῷ μέσῳ ἄπειρα εἶναι ἔλεγον, ἄπειρα δὲ λέγει τὰ ἀόριστα·", "seq": 3489}
{"id": "David_Passim_3490", "series": "CAG", "text": "διττὸν γὰρ τὸ ἄπειρον, τὸ μὲν ἀδιεξίτητον τὸ δὲ ἀόριστον.", "seq": 3490}
{"id": "David_Passim_3491", "series": "CAG", "text": "ἔλεγον οὖν ὅτι οὐ διὰ τὰ ἐσόμενά ἐστιν ἄπειρα, ἀλλὰ διὰ τὸ ἐν τῷ ἐνεστῶτι εἶναι καὶ ἀοριστίαν ἔχειν.", "seq": 3491}
{"id": "David_Passim_3492", "series": "CAG", "text": "πῶς δὲ ἀόριστόν ἐστι, σαφὲς ἐντεῦθεν·", "seq": 3492}
{"id": "David_Passim_3493", "series": "CAG", "text": "ἡ φύσις πάντα τὰ ἄκρα ὡρισμένα ἔχει·", "seq": 3493}
{"id": "David_Passim_3494", "series": "CAG", "text": "μέτρον γὰρ ἔχει καὶ τῶν ἐλαττόνων καὶ τῶν μειζόνων.", "seq": 3494}
{"id": "David_Passim_3495", "series": "CAG", "text": "ὃ δὲ λέγομεν, τοιοῦτόν ἐστιν·", "seq": 3495}
{"id": "David_Passim_3496", "series": "CAG", "text": "ὥρισεν ἡ φύσις τὸ τέλειον μέγεθος τοῦ ἀνθρώπου εἶναι τετράπηχυ, περαιτέρω δὲ μηκέτι προϊέναι, καὶ ὥρισε πάλιν τοὐλάχιστον μέγεθος τοῦ ἀνθρώπου μονόπηχυ, ἔλαττον δὲ μηκέτι μειοῦσθαι.", "seq": 3496}
{"id": "David_Passim_3497", "series": "CAG", "text": "τὸ μέσον δὲ ἀόριστον εἴασεν·", "seq": 3497}
{"id": "David_Passim_3498", "series": "CAG", "text": "ἔστω γὰρ εἶναι ἄνθρωπον δίπηχυν ἢ τρίπηχυν.", "seq": 3498}
{"id": "David_Passim_3499", "series": "CAG", "text": "ἐπὶ οὖν τῶν ἀτόμων ταὐτόν ἐστιν·", "seq": 3499}
{"id": "David_Passim_3500", "series": "CAG", "text": "ὡρισμένα γὰρ τὰ ἄκρα αὐτῶν ἔχει, ὡς ἵνα εἴπῃς ὅτι τὸ τέλειον αὐτῶν μέγεθος ὥρισεν εἶναι χίλια, τὸ ἐλάχιστον ἑκατόν, πλέον δὲ τῶν χιλίων μὴ προκόπτειν τὰ ἄτομα μήτε μειοῦσθαι τῶν ἑκατόν, τὰ μέσα δὲ ἀόριστα εἴασεν·", "seq": 3500}
{"id": "David_Passim_3501", "series": "CAG", "text": "εἶναι γὰρ αὐτὰ πεντακόσια ἢ διακόσια συνεχώρησε.", "seq": 3501}
{"id": "David_Passim_3502", "series": "CAG", "text": "κατὰ τοῦτον οὖν τὸν λόγον φησὶν ὁ Πορφύριος τὰ ἄτομα εἶναι ἄπειρα·", "seq": 3502}
{"id": "David_Passim_3503", "series": "CAG", "text": "λέγει γὰρ ὅτι πεπερασμένα ἐστίν·", "seq": 3503}
{"id": "David_Passim_3504", "series": "CAG", "text": "ὧν γὰρ τὰ ἄκρα πεπέρασται, τούτων καὶ τὸ μέσον.", "seq": 3504}
{"id": "David_Passim_3505", "series": "CAG", "text": "ἄπειρα οὖν ἐστιν, ὅτι ἀόριστά ἐστιν·", "seq": 3505}
{"id": "David_Passim_3506", "series": "CAG", "text": "οὔτε γὰρ ἀδιεξίτητά ἐστι·", "seq": 3506}
{"id": "David_Passim_3507", "series": "CAG", "text": "πάντα γὰρ πεπέρασται ἐν πεπερασμένῳ ὄντα τόπῳ.", "seq": 3507}
{"id": "David_Passim_3508", "series": "CAG", "text": "Τούτοις τινὲς ἐναντιούμενοί φασιν ὅτι οὐ πάντως ὧν τὰ ἄκρα πεπέρασται, τούτων καὶ τὸ μέσον·", "seq": 3508}
{"id": "David_Passim_3509", "series": "CAG", "text": "ἰδοὺ γὰρ τὸ μέλαν καὶ τὸ λευκὸν πεπέρασται, τὰ δὲ ἐν μέσῳ χρώματα ἀπέραντά ἐστιν·", "seq": 3509}
{"id": "David_Passim_3510", "series": "CAG", "text": "οὐ γὰρ λέξεις μοι ὅτι δεκατρία βούλεται αὐτὰ λέγειν ὁ Γαληνός·", "seq": 3510}
{"id": "David_Passim_3511", "series": "CAG", "text": "κἂν γὰρ δεκατρία εἴδη λέγῃ, ἀλλ᾿ οὖν πολλαί εἰσιν αἱ διαφοραί.", "seq": 3511}
{"id": "David_Passim_3512", "series": "CAG", "text": "πρὸς τοῦτο δὲ ἀπολογούμενοί φασιν ὅτι τρία εἰσὶ ταῦτα πάντα, τὸ λευκὸν τὸ μέλαν καὶ τὸ μέσον τούτων, τὸ φαιόν, τὰ δὲ ἄλλα πάντα ἐκ τούτων εἰσί, κατὰ δὲ τὸ μᾶλλον καὶ τὸ ἧττον διαφέρει, τὸ κυανοῦν τὸ ἁλουργὲς τὸ πρασινίζον καὶ ὅλα τὰ τοιαῦτα.", "seq": 3512}
{"id": "David_Passim_3513", "series": "CAG", "text": "τὸ οὖν μᾶλλον καὶ τὸ ἧττον εἴδους ἐναλλαγὴν οὐ ποιεῖ.", "seq": 3513}
{"id": "David_Passim_3514", "series": "CAG", "text": "κακῶς δὲ οὗτοι ἐπελύσαντο·", "seq": 3514}
{"id": "David_Passim_3515", "series": "CAG", "text": "συνάγεται γὰρ ἐκ τούτου τοῦ λόγου τὸ εἶναι ταῦτα πάντα χρώματα·", "seq": 3515}
{"id": "David_Passim_3516", "series": "CAG", "text": "ὑπόθου γὰρ ὅτι τοῦ φαιοῦ τὸ ἁλουργὲς οὐδὲν διαφέρει, εἰ μὴ κατὰ τὸ μᾶλλον καὶ ἧττον, ταὐτὸν ἄρα φαιὸν καὶ ἁλουργὲς καὶ κυανοῦν.", "seq": 3516}
{"id": "David_Passim_3517", "series": "CAG", "text": "οὐ μόνον δὲ κατὰ τοῦτο ἀλλὰ καὶ καθ᾿ ἕτερον λόγον·", "seq": 3517}
{"id": "David_Passim_3518", "series": "CAG", "text": "οὐκ ἔστι γὰρ ἀληθὲς ὡς τὸ μᾶλλον καὶ ἧττον οὐ ποιεῖ εἴδους ἐναλλαγήν·", "seq": 3518}
{"id": "David_Passim_3519", "series": "CAG", "text": "ἰδοὺ γὰρ ἡ γλυκύτης ἡ ἐν ἰσχάδι καὶ μέλιτι κατὰ τὸ μᾶλλον καὶ ἧττόν ἐστι, ποιεῖ δὲ εἴδους ἐναλλαγήν·", "seq": 3519}
{"id": "David_Passim_3520", "series": "CAG", "text": "οὐ γὰρ ταὐτόν ἐστιν ἰσχὰς καὶ μέλι.", "seq": 3520}
{"id": "David_Passim_3521", "series": "CAG", "text": "ἀλλὰ μὴν καὶ κατὰ τὸ μᾶλλον καὶ ἧττόν ἐστιν ἡ θερμότης τοῦ πυρὸς καὶ τοῦ ἀέρος, ποιεῖ δ᾿ εἴδους ἐναλλαγήν·", "seq": 3521}
{"id": "David_Passim_3522", "series": "CAG", "text": "οὐ γὰρ ταὐτόν ἐστιν ἀὴρ καὶ πῦρ.", "seq": 3522}
{"id": "David_Passim_3523", "series": "CAG", "text": "πῶς οὖν ἔδει ἀπολογεῖσθαι;", "seq": 3523}
{"id": "David_Passim_3524", "series": "CAG", "text": "ἔδει μᾶλλον εἰπεῖν ὅτι ταῦτα τὰ ἐν τῷ μέσῳ χρώματα οὐκ ἔστιν ἄπειρα·", "seq": 3524}
{"id": "David_Passim_3525", "series": "CAG", "text": "πεπέρασται γὰρ τῇ φύσει·", "seq": 3525}
{"id": "David_Passim_3526", "series": "CAG", "text": "κἂν γὰρ πολλά ἐστιν, ἀλλ᾿ οὖν πεπέρασται·", "seq": 3526}
{"id": "David_Passim_3527", "series": "CAG", "text": "καὶ ταῦτα γὰρ ἡ φύσις ἐδημιούργησε.", "seq": 3527}
{"id": "David_Passim_3528", "series": "CAG", "text": "τῇ οὖν γνώσει ἄπειρά ἐστιν, οὐ μὴν τῇ φύσει.", "seq": 3528}
{"id": "David_Passim_3529", "series": "CAG", "text": "ἔστω δὲ καὶ ταῦτα εἶναι ἄπειρα τῇ γνώσει, εἰ δὲ θέλεις καὶ τῇ φύσει, κατὰ τὸ ἀόριστον.", "seq": 3529}
{"id": "David_Passim_3530", "series": "CAG", "text": "6.", "seq": 3530}
{"id": "David_Passim_3531", "series": "CAG", "text": "13 Διὸ ἄχρι τῶν εἰδικωτάτων ἀπὸ τῶν γενικωτάτων κατιόντας παρεκελεύετο ὁ Πλάτων παύεσθαι.", "seq": 3531}
{"id": "David_Passim_3532", "series": "CAG", "text": "Ἰδοὺ ὁ πρῶτος τρόπος Πλάτωνος·", "seq": 3532}
{"id": "David_Passim_3533", "series": "CAG", "text": "φησὶ γὰρ ἀπὸ τῶν γενικωτάτων μέχρι τῶν εἰδικωτάτων ποιεῖσθαι τὴν διαίρεσιν, περαιτέρω δὲ μηκέτι.", "seq": 3533}
{"id": "David_Passim_3534", "series": "CAG", "text": "6.", "seq": 3534}
{"id": "David_Passim_3535", "series": "CAG", "text": "15 Κατιέναι δὲ διὰ τῶν διὰ μέσου.", "seq": 3535}
{"id": "David_Passim_3536", "series": "CAG", "text": "Πάλιν τὸν δεύτερον τρόπον ἐμφαίνει λέγων ὅτι διὰ τῶν μέσων καὶ κατὰ τάξιν χρὴ κατιέναι, οὐ μὴν ὑπερβαθμίῳ ποδὶ χρῆσθαι.", "seq": 3536}
{"id": "David_Passim_3537", "series": "CAG", "text": "6.", "seq": 3537}
{"id": "David_Passim_3538", "series": "CAG", "text": "15 Διαιροῦντας ταῖς εἰδοποιοῖς διαφοραῖς.", "seq": 3538}
{"id": "David_Passim_3539", "series": "CAG", "text": "Τοῦτον τρίτον τρόπον φησί·", "seq": 3539}
{"id": "David_Passim_3540", "series": "CAG", "text": "λέγει γὰρ ὅτι χρὴ οὐσιώδεσι διαφοραῖς χρῆσθαι ταῖς ποιούσαις τὸ εἶδος, οὐκέτι δὲ ταῖς ἐπουσιώδεσι ταῖς μὴ ποιούσαις τὸ εἶδος·", "seq": 3540}
{"id": "David_Passim_3541", "series": "CAG", "text": "τὸ λογικὸν γὰρ ποιεῖ τὸ εἶδος, οὐ μὴν τὸ γελαστικόν.", "seq": 3541}
{"id": "David_Passim_3542", "series": "CAG", "text": "6.", "seq": 3542}
{"id": "David_Passim_3543", "series": "CAG", "text": "16 Τὰ δὲ ἄπειρά φησιν ἐᾶν.", "seq": 3543}
{"id": "David_Passim_3544", "series": "CAG", "text": "Λέγει δὲ ἐᾶν τὰ ἄπειρα, τοῦτ᾿ ἔστι τὰ ἄτομα.", "seq": 3544}
{"id": "David_Passim_3545", "series": "CAG", "text": "6.", "seq": 3545}
{"id": "David_Passim_3546", "series": "CAG", "text": "16 Μὴ γὰρ ἂν γενέσθαι τούτων ἐπιστήμην.", "seq": 3546}
{"id": "David_Passim_3547", "series": "CAG", "text": "Τοῦτ᾿ ἔστιν οὔκ εἰσι γνωστά·", "seq": 3547}
{"id": "David_Passim_3548", "series": "CAG", "text": "ἀόριστα γάρ εἰσι.", "seq": 3548}
{"id": "David_Passim_3549", "series": "CAG", "text": "6.", "seq": 3549}
{"id": "David_Passim_3550", "series": "CAG", "text": "16 Κατιόντων μὲν οὖν εἰς τὰ εἰδικώτατα ἀνάγκη διαιροῦντας διὰ πλήθους ἰέναι.", "seq": 3550}
{"id": "David_Passim_3551", "series": "CAG", "text": "Αὕτη ἐστὶν ἡ κάθοδος·", "seq": 3551}
{"id": "David_Passim_3552", "series": "CAG", "text": "ἐπὶ ἑκάστης δὲ διαιρέσεώς ἐστιν ὁ λόγος.", "seq": 3552}
{"id": "David_Passim_3553", "series": "CAG", "text": "6.", "seq": 3553}
{"id": "David_Passim_3554", "series": "CAG", "text": "18 Ἀνιόντων δὲ εἰς τὰ γενικώτατα ἀνάγκη συναιρεῖν τὸ πλῆθος.", "seq": 3554}
{"id": "David_Passim_3555", "series": "CAG", "text": "Αὕτη ἐστὶν ἡ ἄνοδος.", "seq": 3555}
{"id": "David_Passim_3556", "series": "CAG", "text": "6.", "seq": 3556}
{"id": "David_Passim_3557", "series": "CAG", "text": "18 Συναγωγὸν γὰρ τῶν πολλῶν εἰς μίαν φύσιν τὸ εἶδος.", "seq": 3557}
{"id": "David_Passim_3558", "series": "CAG", "text": "Φησὶν ὅτι τὸ εἶδος περιέχει πολλούς·", "seq": 3558}
{"id": "David_Passim_3559", "series": "CAG", "text": "ἐν γὰρ τῷ ἀνθρώπῳ συνάγεται Σωκράτης καὶ Πλάτων καὶ πάντα τὰ ἄτομα.", "seq": 3559}
{"id": "David_Passim_3560", "series": "CAG", "text": "ἔτι δὲ πλέον συναγωγὸν τὸ γένος·", "seq": 3560}
{"id": "David_Passim_3561", "series": "CAG", "text": "ὅλα γὰρ τὰ εἴδη εἰς ἕν τι συνάγεται, εἰς τὸ ζῷον.", "seq": 3561}
{"id": "David_Passim_3562", "series": "CAG", "text": "6.", "seq": 3562}
{"id": "David_Passim_3563", "series": "CAG", "text": "20 Τὰ δὲ κατὰ μέρος καὶ καθ᾿ ἕκαστον τοὐναντίον εἰς πλῆθος ἀεὶ διαιρεῖ τὸ ἕν.", "seq": 3563}
{"id": "David_Passim_3564", "series": "CAG", "text": "Τὰ δὲ μερικά, φησί, καὶ καθ᾿ ἕκαστον ἀεὶ διαιρεῖ τὸ ἓν εἰς πλῆθος, οἷον ὁ Σωκράτης καὶ ὁ Ἀλκιβιάδης διαιρεῖ τὸ εἶδος εἰς πολλά·", "seq": 3564}
{"id": "David_Passim_3565", "series": "CAG", "text": "κατὰ γὰρ τὸ εἶδος οἱ πολλοὶ ἄνθρωποι εἷς ἐστι, κατὰ δὲ τὰ ἄτομα ὁ εἷς πλείονές εἰσι.", "seq": 3565}
{"id": "David_Passim_3566", "series": "CAG", "text": "κοινῶς δὲ τὸ κοινὸν μὲν συλληπτικόν ἐστι, τὸ μερικὸν δὲ διαιρετικόν.", "seq": 3566}
{"id": "David_Passim_3567", "series": "CAG", "text": "Πρᾶξις κβ΄.", "seq": 3567}
{"id": "David_Passim_3568", "series": "CAG", "text": "Τὸν ἴδιον σκοπὸν πανταχόσε φυλάττων ὁ φιλόσοφος λογικώτερον πάντα ζητεῖν προαιρεῖται·", "seq": 3568}
{"id": "David_Passim_3569", "series": "CAG", "text": "περὶ γὰρ τῆς ῥίζης τῆς λογικῆς καὶ θεμελίου νυνὶ τὴν διδασκαλίαν ποιεῖται, φημὶ δὲ περὶ κατηγορουμένου καὶ ὑποκειμένου.", "seq": 3569}
{"id": "David_Passim_3570", "series": "CAG", "text": "ὅτι δὲ ῥίζα καὶ θεμέλιός ἐστι τῆς λογικῆς τὸ κατηγορούμενον καὶ ὑποκείμενον, σαφὲς ἐκ τοῦ λεγομένου·", "seq": 3570}
{"id": "David_Passim_3571", "series": "CAG", "text": "ἡ λογικὴ πραγματεία πέρας ἔχει τὴν ἀποδεικτικήν, ἡ ἀποδεικτικὴ δὲ ἐκ συλλογισμῶν σύγκειται, οἱ συλλογισμοὶ δὲ ἐκ προτάσεων, αἱ προτάσεις ἐκ κατηγορουμένου καὶ ἐξ ὑποκειμένου.", "seq": 3571}
{"id": "David_Passim_3572", "series": "CAG", "text": "ἀποδεικτικὴ δέ ἐστιν ὁ βέβαιος λόγος ὁ ἀναντίρρητος.", "seq": 3572}
{"id": "David_Passim_3573", "series": "CAG", "text": "πολλὰ δέ ἐστι τὰ περὶ τούτου λεγόμενα, ἅπερ ἐκεῖ γενόμενοι παραθησόμεθα.", "seq": 3573}
{"id": "David_Passim_3574", "series": "CAG", "text": "ὑπὲρ δὲ τοῦ μὴ πλέον ἄγειν τὸν λόγον ἐνταῦθά που αὐτὸν καταπαύσωμεν.", "seq": 3574}
{"id": "David_Passim_3575", "series": "CAG", "text": "συλλογισμὸς δέ ἐστιν ὁ συντιθέμενος λόγος ‘ὁ ἄνθρωπος ζῷον·", "seq": 3575}
{"id": "David_Passim_3576", "series": "CAG", "text": "τὸ ζῷον οὐσία·", "seq": 3576}
{"id": "David_Passim_3577", "series": "CAG", "text": "ὁ ἄνθρωπος ἄρα οὐσία’.", "seq": 3577}
{"id": "David_Passim_3578", "series": "CAG", "text": "μέρη δὲ τοῦ συλλογισμοῦ εἰσιν αἱ προτάσεις·", "seq": 3578}
{"id": "David_Passim_3579", "series": "CAG", "text": "πρώτη γὰρ πρότασις ‘ὁ ἄνθρωπος ζῷον’, δευτέρα πρότασις ‘τὸ ζῷον οὐσία’.", "seq": 3579}
{"id": "David_Passim_3580", "series": "CAG", "text": "ἔχουσι δὲ αἱ προτάσεις ὑποκείμενον καὶ κατηγορούμενον·", "seq": 3580}
{"id": "David_Passim_3581", "series": "CAG", "text": "ὑποκείμενον μὲν ἔχει ἡ πρώτη πρότασις τὸν ἄνθρωπον κατηγορούμενον δὲ τὸ ζῷον, ἡ δευτέρα δὲ ὑποκείμενον μὲν ἔχει τὸ ζῷον κατηγορούμενον δὲ τὴν οὐσίαν.", "seq": 3581}
{"id": "David_Passim_3582", "series": "CAG", "text": "τὸ οὖν κατηγορούμενον ἢ ἐπὶ πλέον τοῦ ὑποκειμένου ἐστὶν ἢ ἐπ᾿ ἴσης, οὐδέποτε δὲ ἐπ᾿ ἔλαττον·", "seq": 3582}
{"id": "David_Passim_3583", "series": "CAG", "text": "τὸ ὑποκείμενον δὲ ἢ ἐπ᾿ ἴσης ἢ ἐπ᾿ ἔλαττον, οὐδέποτε δὲ ἐπὶ πλέον ἐστὶ τοῦ κατηγορουμένου.", "seq": 3583}
{"id": "David_Passim_3584", "series": "CAG", "text": "καὶ ἐπὶ πλέον μέν ἐστι τὸ κατηγορούμενον τοῦ ὑποκειμένου, ὥσπερ τὸ ζῷον τοῦ ἀνθρώπου (τὸ γὰρ ζῷον ἐπὶ πλέον φθάνει τοῦ ἀνθρώπου·", "seq": 3584}
{"id": "David_Passim_3585", "series": "CAG", "text": "εἴ τι μὲν γὰρ ἄνθρωπος, τοῦτο καὶ ζῷον, οὐκ εἴ τι δὲ ζῷον, τοῦτο καὶ ἄνθρωπος), ἐπ᾿ ἴσης δὲ κατηγορεῖσθαι τοῦ ὑποκειμένου φαμὲν ὡς τοῦ ἀνθρώπου τὸ γελαστικόν·", "seq": 3585}
{"id": "David_Passim_3586", "series": "CAG", "text": "ἰσορρεπὲς γὰρ ἑκάτερον.", "seq": 3586}
{"id": "David_Passim_3587", "series": "CAG", "text": "ἐπὶ τούτων δὲ ἑκάτερον καὶ ὑποκείμενον καὶ κατηγορούμενον ἔξεστι λαμβάνειν, ἀλλ᾿ οὐκ ἐν αὐτῇ τῇ προτάσει.", "seq": 3587}
{"id": "David_Passim_3588", "series": "CAG", "text": "ἐκ τῶν λεχθέντων δὲ σαφὲς ὑπάρχει πῶς καὶ τὸ ὑποκείμενον ἐπ᾿ ἴσης εὑρίσκεται καὶ ἐπ᾿ ἔλαττον·", "seq": 3588}
{"id": "David_Passim_3589", "series": "CAG", "text": "ἐπ᾿ ἴσης γὰρ εὑρίσκεται, ὅτε τὸ γελαστικὸν κατηγορεῖται τοῦ ἀνθρώπου, ἐπ᾿ ἔλαττον δέ, ὅταν τοῦ ἀνθρώπου τὸ ζῷον.", "seq": 3589}
{"id": "David_Passim_3590", "series": "CAG", "text": "παράδειγμα δὲ ἔστω τῶν λεγομένων ἡ προειρημένη διαίρεσις·", "seq": 3590}
{"id": "David_Passim_3591", "series": "CAG", "text": "ἡ μὲν γὰρ οὐσία μόνον κατηγορούμενόν ἐστι, τὰ δὲ ἄτομα μόνον ὑποκείμενα, τὰ δὲ μέσα καὶ κατηγορούμενα καὶ ὑποκείμενα, ἀλλὰ τὸ μὲν εἰδικώτατον μᾶλλον ὑπόκειται ἤπερ κατηγορεῖται (τῶν γὰρ ἀτόμων μόνων κατηγορεῖται, ὑπόκειται δὲ καὶ ὑπέστρωται πᾶσι τοῖς ἄνω), τὰ δὲ ὑπάλληλα μᾶλλον κατηγορούμενά ἐστιν ἤπερ ὑποκείμενα·", "seq": 3591}
{"id": "David_Passim_3592", "series": "CAG", "text": "πολλῶν γὰρ κατηγορεῖται, οὐ πολλοῖς δὲ ὑπόκειται.", "seq": 3592}
{"id": "David_Passim_3593", "series": "CAG", "text": "ἴσως δὲ ἀπορήσει τις λέγων·", "seq": 3593}
{"id": "David_Passim_3594", "series": "CAG", "text": "πῶς λέγετε τὴν οὐσίαν μόνον κατηγορεῖσθαι, ἐξ οὗ ὁρῶμεν τὸ λευκὸν οὐσίας κατηγορούμενον;", "seq": 3594}
{"id": "David_Passim_3595", "series": "CAG", "text": "φαμὲν γὰρ τὸ λευκὸν κατηγορεῖσθαι τοῦ κύκνου·", "seq": 3595}
{"id": "David_Passim_3596", "series": "CAG", "text": "ὥστε οὖν κακῶς λέγετε αὐτὴν μόνον κατηγορεῖσθαι·", "seq": 3596}
{"id": "David_Passim_3597", "series": "CAG", "text": "ἰδοὺ γὰρ καὶ ὑπόκειται τοῖς συμβεβηκόσι.", "seq": 3597}
{"id": "David_Passim_3598", "series": "CAG", "text": "πρὸς τοῦτο δὲ λέγομεν ὅτι οὐ λέγομεν πάντων τῶν ὄντων αὐτὴν κατηγορεῖσθαι, ἀλλὰ μόνων τῶν ὑπ᾿ αὐτήν·", "seq": 3598}
{"id": "David_Passim_3599", "series": "CAG", "text": "τινὶ γὰρ τῶν ὑπ᾿ αὐτὴν ὑποκεῖσθαι ἀδύνατον.", "seq": 3599}
{"id": "David_Passim_3600", "series": "CAG", "text": "παραδείγματι δὲ τὴν τοιαύτην διαίρεσιν ὑποβάλωμεν·", "seq": 3600}
{"id": "David_Passim_3601", "series": "CAG", "text": "ἔστιν ἡ οὐσία οἱονεὶ τὸ ὅλον, τὰ δὲ ἄτομα οἱονεὶ τὰ μέρη, τὰ δὲ μέσα καὶ ὅλα καὶ μέρη, ἀλλὰ τὸ μὲν εἰδικώτατον μᾶλλον μέρος ἐστὶν ἤπερ ὅλον, τὰ δὲ ὑπάλληλα μᾶλλον ὅλα ἤπερ μέρη·", "seq": 3601}
{"id": "David_Passim_3602", "series": "CAG", "text": "μᾶλλον γὰρ κατηγορεῖται ἤπερ ὑπόκειται.", "seq": 3602}
{"id": "David_Passim_3603", "series": "CAG", "text": "ὥσπερ οὖν τὸ ὅλον ἔχει πάντα ὑφ᾿ ἑαυτὸ τὰ μέρη, οὕτω καὶ ἡ οὐσία πάντα ἔχει τὰ ἐξ αὐτῆς διαιρούμενα ὑφ᾿ ἑαυτήν.", "seq": 3603}
{"id": "David_Passim_3604", "series": "CAG", "text": "ἰστέον δὲ ὡς οὐ ταὐτόν ἐστιν ὅλον καὶ οὐσία·", "seq": 3604}
{"id": "David_Passim_3605", "series": "CAG", "text": "ἡ μὲν γὰρ ἐν πᾶσι τοῖς ὑπ᾿ αὐτὴν ὅλη ὡς ὅλη θεωρεῖται, τὸ δὲ ὅλον ἐν τοῖς ὑπ᾿ αὐτὸ μέρεσιν οὐχ ὅλον ὡς ὅλον θεωρεῖται·", "seq": 3605}
{"id": "David_Passim_3606", "series": "CAG", "text": "οὔτε γὰρ ἐν τῇ χειρὶ θεωρεῖται ὅλος ὁ Σωκράτης.", "seq": 3606}
{"id": "David_Passim_3607", "series": "CAG", "text": "οὐδὲ τὰ μέρη καὶ τὰ ἄτομα ταὐτόν ἐστι·", "seq": 3607}
{"id": "David_Passim_3608", "series": "CAG", "text": "τῶν μὲν γὰρ ἀτόμων ἔχει ἓν καὶ ἕκαστον τὴν οὐσίαν ὅλην ὡς ὅλην, τῶν δὲ μερῶν ἓν καὶ ἕκαστον οὐκ ἔχει τὸ ὅλον ὡς ὅλον.", "seq": 3608}
{"id": "David_Passim_3609", "series": "CAG", "text": "Εἰρηκὼς ὁ Πορφύριος περὶ τοῦ εἰδικωτάτου εἴδους καὶ ὑπαλλήλου καὶ κατηγορουμένου καὶ ὑποκειμένου ἄτοπον ἡγεῖται παριδεῖν καὶ τὰ ἄτομα ἀμνημόνευτα τῆς ἑαυτοῦ διδασκαλίας, εἴ γε καὶ τῶν πρός τί εἰσι πρὸς τὰ ἐπαναβεβηκότα καὶ μία περὶ αὐτῶν ἀπαιτεῖται εἶναι διδασκαλία·", "seq": 3609}
{"id": "David_Passim_3610", "series": "CAG", "text": "ὅπου γὰρ εἶδος, ἐκεῖ καὶ ἄτομα ὑπάρχει.", "seq": 3610}
{"id": "David_Passim_3611", "series": "CAG", "text": "ὁρίζεται τοίνυν τὰ ἄτομα οὕτως·", "seq": 3611}
{"id": "David_Passim_3612", "series": "CAG", "text": "ἄτομόν ἐστι τὸ ἐξ ἰδιοτήτων συγκείμενον, ὧν τὸ ἄθροισμα οὐκ ἂν ὀφθείη ἐπὶ ἑτέρου ποτέ.", "seq": 3612}
{"id": "David_Passim_3613", "series": "CAG", "text": "καὶ σκόπει πῶς τὸ οἰκεῖον τοῦ φιλοσόφου ἐφύλαξε, τὸ τοιόνδε ἄτομον μὴ ὁριζόμενος (τοῦτο γὰρ μερικόν ἐστιν), ἀλλὰ τὸ ἁπλῶς ἄτομον.", "seq": 3613}
{"id": "David_Passim_3614", "series": "CAG", "text": "φησὶ δὲ ἄτομόν ἐστι τὸ ἐκ συμβεβηκότων συγκείμενον, ὧν τὸ ἄθροισμα οὐκ ἂν ὀφθείη ἐπὶ ἑτέρου ποτέ, οἷον ὁ Σωκράτης ἐκ τῆς φαλάκρας καὶ τοῦ προκοιλίου καὶ τοῦ εὐφυοῦς καὶ σώφρονος σύγκειται.", "seq": 3614}
{"id": "David_Passim_3615", "series": "CAG", "text": "ταῦτα δὲ ὁμοῦ ἐπὶ ἑτέρου οὐκ ἂν φανείη ποτέ·", "seq": 3615}
{"id": "David_Passim_3616", "series": "CAG", "text": "κἂν γὰρ ἔχῃ τὸ φαλακρόν, ἀλλ᾿ οὐ πάντα τὰ ἄλλα·", "seq": 3616}
{"id": "David_Passim_3617", "series": "CAG", "text": "ἀδύνατον γὰρ δύο ὁμοίους εἶναι κατὰ πάντα.", "seq": 3617}
{"id": "David_Passim_3618", "series": "CAG", "text": "καλῶς οὖν εἶπεν ὧν τὸ ἄθροισμα ἐπὶ ἑτέρου οὐκ ἂν ὀφθείη ποτέ.", "seq": 3618}
{"id": "David_Passim_3619", "series": "CAG", "text": "τινὲς δέ φασιν ὅτι ἐκ τῶν συμβεβηκότων πλέον ὁ τόπος συμπληροῖ τὸ ἄτομον·", "seq": 3619}
{"id": "David_Passim_3620", "series": "CAG", "text": "τὰ μὲν γὰρ ἄλλα πάντα κοινά ἐστιν, ἡ φαλακρότης τὸ εὐφυὲς καὶ τὸ σῶφρον, ὁ δέ γε τόπος μόνον ἴδιόν ἐστι τοῦ ἀτόμου·", "seq": 3620}
{"id": "David_Passim_3621", "series": "CAG", "text": "οὔτε γὰρ δύναται δύο ἐν τῷ αὐτῷ τόπῳ καθέζεσθαι, ἐπεὶ ἔσται σῶμα διὰ σώματος χωροῦν·", "seq": 3621}
{"id": "David_Passim_3622", "series": "CAG", "text": "ὥστε οὖν ὁ τόπος συμπληροῖ τὸν Σωκράτην.", "seq": 3622}
{"id": "David_Passim_3623", "series": "CAG", "text": "κακῶς δὲ οὗτοι λέγουσι·", "seq": 3623}
{"id": "David_Passim_3624", "series": "CAG", "text": "ποῖον γὰρ τόπον λέγουσι, τὸν καθόλου ἢ τὸν μερικόν;", "seq": 3624}
{"id": "David_Passim_3625", "series": "CAG", "text": "καὶ εἰ μὲν τὸν καθόλου, ψευδὲς φαίνεται τὸ λεγόμενον (οὔτε γὰρ ὁ Σωκράτης διαφέρει Ἀλκιβιάδου, καθὸ ἐν τόπῳ ἐστί·", "seq": 3625}
{"id": "David_Passim_3626", "series": "CAG", "text": "κοινὸς γάρ ἐστιν ὁ καθόλου τόπος), εἰ δὲ τὸν μερικόν, ὁμοίως ψευδές ἐστι τὸ λεγόμενον·", "seq": 3626}
{"id": "David_Passim_3627", "series": "CAG", "text": "οὔτε γὰρ ὁ ἐν τῷ Λυκείῳ τόπος μόνου ἐστὶ τοῦ Σωκράτους·", "seq": 3627}
{"id": "David_Passim_3628", "series": "CAG", "text": "δυνατὸν γὰρ καὶ Πλάτωνα ἐν ἐκείνῳ τῷ τόπῳ καθέζεσθαι·", "seq": 3628}
{"id": "David_Passim_3629", "series": "CAG", "text": "ὡς γὰρ ὁ ἐν τῷ θεάτρῳ τόπος τοῦ προλαβόντος ἀεὶ γίνεται, οὕτω καὶ ὁ ἐν τῷ Λυκείῳ·", "seq": 3629}
{"id": "David_Passim_3630", "series": "CAG", "text": "ὥστε οὖν οὐδὲ οὗτος ἴδιός ἐστι Σωκράτους.", "seq": 3630}
{"id": "David_Passim_3631", "series": "CAG", "text": "οὐ συμπληροῖ ἄρα πλείω τῶν ἄλλων συμβεβηκότων ὁ τόπος τὸν Σωκράτην.", "seq": 3631}
{"id": "David_Passim_3632", "series": "CAG", "text": "Ἐπιλαμβάνονται δὲ Πορφυρίου οἱ Περιπατητικοὶ λέγοντες ὅτι κατὰ δύο τρόπους ἥμαρτε λέγων ὅτι τὸ ἄτομον ἐκ συμβεβηκότων συμπληροῦται·", "seq": 3632}
{"id": "David_Passim_3633", "series": "CAG", "text": "πρῶτον ὁ Ἀριστοτέλης ἐν ταῖς Κατηγορίαις καλλίστην καὶ τιμιωτάτην οὐσίαν πλείω ὅλων φησὶν εἶναι τὴν ἄτομον·", "seq": 3633}
{"id": "David_Passim_3634", "series": "CAG", "text": "εἴ φησιν οὖν ὁ Πορφύριος τὰ ἄτομα συμπληροῦσθαι διὰ τῶν συμβεβηκότων, ἁμαρτίᾳ μεγάλῃ περιπίπτει·", "seq": 3634}
{"id": "David_Passim_3635", "series": "CAG", "text": "τὰ γὰρ οὐσιώδη ἀπὸ οὐσιωδῶν συμπληροῦται, οὐ μὴν ἀπὸ ἐπουσιωδῶν·", "seq": 3635}
{"id": "David_Passim_3636", "series": "CAG", "text": "τοὐναντίον γὰρ τὰ αὐθυπόστατα συμπληροῖ τὰ ἑτεροϋπόστατα.", "seq": 3636}
{"id": "David_Passim_3637", "series": "CAG", "text": "κατὰ δὲ Πορφύριον συνάγεται τὰ ἑτεροϋπόστατα συμπληροῦν τὰ αὐθυπόστατα, φημὶ δὴ τὰ συμβεβηκότα τὴν οὐσίαν.", "seq": 3637}
{"id": "David_Passim_3638", "series": "CAG", "text": "δεύτερον δὲ τὰ συμβεβηκότα ὡς μέρη συμπληροῖ τὸν Σωκράτην ὥστε εἶναι τὸν Σωκράτην ὅλον τὰ συμβεβηκότα δὲ μέρη·", "seq": 3638}
{"id": "David_Passim_3639", "series": "CAG", "text": "μερῶν δὲ ἀναιρουμένων οὐ συνίσταται τὸ ὅλον·", "seq": 3639}
{"id": "David_Passim_3640", "series": "CAG", "text": "εὑρίσκομεν δὲ ὅτι τὰ συμβεβηκότα γίνεται καὶ ἀπογίνεται χωρὶς τῆς τοῦ ὑποκειμένου φθορᾶς·", "seq": 3640}
{"id": "David_Passim_3641", "series": "CAG", "text": "οὐ γὰρ ἀφαιρουμένων τῶν συμβεβηκότων ἀφαιρεῖται καὶ τὸ ὅλον, φημὶ δὴ τὸν Σωκράτην.", "seq": 3641}
{"id": "David_Passim_3642", "series": "CAG", "text": "πρὸς τοῦτο δὲ ἀπολογοῦνται οἱ Πλατωνικοὶ λέγοντες ὅτι οὐ λέγει συμπληροῦσθαι ἀπὸ τῶν συμβεβηκότων ἀλλὰ γινώσκεσθαι.", "seq": 3642}
{"id": "David_Passim_3643", "series": "CAG", "text": "πρὸς τοῦτο δέ φασιν οἱ Περιπατητικοὶ ὅτι οὐ λέγει γινώσκεσθαι, ἀλλὰ συμπληροῦσθαι, ὡς καὶ δηλοῖ τὸ κείμενον.", "seq": 3643}
{"id": "David_Passim_3644", "series": "CAG", "text": "πρὸς τοῦτο δὲ οἱ Πλατωνικοί φασιν ὅτι κἂν λέγῃ συμπληροῦσθαι, οὐ κακῶς εἶπεν·", "seq": 3644}
{"id": "David_Passim_3645", "series": "CAG", "text": "ἰδιότητας γὰρ οὔ φησι τὰ συμβεβηκότα, ἀλλὰ τὴν ἰδιοτροπίαν τῆς κράσεως·", "seq": 3645}
{"id": "David_Passim_3646", "series": "CAG", "text": "ἡ δὲ ἰδιοτροπία τῆς κράσεως οὐσία ἐστὶν ἑκάστου, οἷον τὸ θερμὸν ἢ τὸ ψυχρόν.", "seq": 3646}
{"id": "David_Passim_3647", "series": "CAG", "text": "πρὸς τούτους δὲ καλῶς ἀντιλέγοντες οἱ Περιπατητικοί φασιν ὅτι καὶ ταῦτα συμβεβηκότα ἐστίν·", "seq": 3647}
{"id": "David_Passim_3648", "series": "CAG", "text": "οὔτε γὰρ ἐὰν ᾖ ὁ Σωκράτης τοῦ Πλάτωνος θερμότερος, κατὰ τοῦτο διοίσει αὐτοῦ·", "seq": 3648}
{"id": "David_Passim_3649", "series": "CAG", "text": "ἀμέλει γίνεται καὶ ἀπογίνεται.", "seq": 3649}
{"id": "David_Passim_3650", "series": "CAG", "text": "τί οὖν ὑμεῖς ὦ Περιπατητικοὶ ἀπολογεῖσθε;", "seq": 3650}
{"id": "David_Passim_3651", "series": "CAG", "text": "φασὶν ὅτι οὐκ ἔστιν ἄτοπον συμπληροῦν τὰ συμβεβηκότα τὴν οὐσίαν, πρὸς ἄλλο δὲ εἶναι συμβεβηκότα καὶ πρὸς ἄλλο οὐσίαν·", "seq": 3651}
{"id": "David_Passim_3652", "series": "CAG", "text": "ὡς γὰρ τὸ θερμὸν τὸ ἐν τῷ πυρὶ λέγεται καὶ οὐσία καὶ συμβεβηκός (πρὸς μὲν γὰρ τὸ σῶμα τοῦ πυρὸς λέγεται συμβεβηκός, πρὸς δὲ τὸ πῦρ οὐσία·", "seq": 3652}
{"id": "David_Passim_3653", "series": "CAG", "text": "οὐσία γὰρ τοῦ πυρὸς ἡ θερμότης), καὶ ὥς φαμεν τὸ ἐν τῷ ὕδατι ψυχρὸν καὶ συμβεβηκὸς εἶναι καὶ οὐσίαν, συμβεβηκὸς μὲν πρὸς τὸ σῶμα τοῦ ὕδατος, οὐσίαν δὲ πρὸς τὸ ὕδωρ, οὕτω καὶ τὸ φαλακρὸν τοῦ Σωκράτους συμβεβηκός φαμεν καὶ οὐσίαν, συμβεβηκὸς μὲν πρὸς τὸν Σωκράτην, καθὸ ἄνθρωπός ἐστιν, οὐσίαν δὲ αὐτοῦ, καθὸ συμπληροῖ τὸν Σωκράτην·", "seq": 3653}
{"id": "David_Passim_3654", "series": "CAG", "text": "οὐσία γὰρ αὐτοῦ καὶ ἡ φαλακρότης, συμβεβηκὸς δέ, καθὸ καὶ ἄλλοις γίνεται.", "seq": 3654}
{"id": "David_Passim_3655", "series": "CAG", "text": "καὶ οὐ θαυμαστόν, εἰ ταῦτα οὐσία λέγεται·", "seq": 3655}
{"id": "David_Passim_3656", "series": "CAG", "text": "πᾶν γὰρ συμβεβηκὸς θέλει μετέχειν οὐσίας, ἵνα μὴ πάντῃ ἀμοιρήσῃ τῆς κρείττονος οὐσίας.", "seq": 3656}
{"id": "David_Passim_3657", "series": "CAG", "text": "7.", "seq": 3657}
{"id": "David_Passim_3658", "series": "CAG", "text": "18 Ἄτομον δὲ λέγεται ὁ Σωκράτης.", "seq": 3658}
{"id": "David_Passim_3659", "series": "CAG", "text": "Τὸ ἄτομον λέγεται πολλαχῶς·", "seq": 3659}
{"id": "David_Passim_3660", "series": "CAG", "text": "ἔστι γὰρ ἀδιαίρετον ἄτομον ὥσπερ τὸ νῦν καὶ τὸ σημεῖον·", "seq": 3660}
{"id": "David_Passim_3661", "series": "CAG", "text": "τὸ γὰρ νῦν σημαίνει τὸν ἀκαριαῖον ἐνεστῶτα.", "seq": 3661}
{"id": "David_Passim_3662", "series": "CAG", "text": "ἄτομον δέ ἐστιν ὁ ἀκαριαῖος ἐνεστώς, καὶ τὸ σημεῖον παρὰ τοῖς γεωμέτραις ἄτομόν ἐστιν.", "seq": 3662}
{"id": "David_Passim_3663", "series": "CAG", "text": "ἄτομον δὲ καὶ τὸ δυσδιαίρετον ὥσπερ ὁ ἀδάμας καὶ τὰ ὅμοια.", "seq": 3663}
{"id": "David_Passim_3664", "series": "CAG", "text": "ἔστι δὲ ἄτομον καὶ ὁ Σωκράτης καὶ ὁ Ἀλκιβιάδης, οὐχ ὅτι οὐ πέφυκε τέμνεσθαι (τέμνεται γὰρ εἰς σῶμα καὶ ψυχήν), ἀλλ᾿ ὅτι μετὰ τὴν τομὴν οὐ σώζει τὸ οἰκεῖον εἶδος.", "seq": 3664}
{"id": "David_Passim_3665", "series": "CAG", "text": "6.", "seq": 3665}
{"id": "David_Passim_3666", "series": "CAG", "text": "24 Ἀποδεδομένου δὲ τοῦ γένους καὶ τοῦ εἴδους τί ἑκάτερον.", "seq": 3666}
{"id": "David_Passim_3667", "series": "CAG", "text": "Φησὶν ὅτι ἀποδεδώκαμεν τί ἐστι γένος καὶ τί ἐστιν εἶδος.", "seq": 3667}
{"id": "David_Passim_3668", "series": "CAG", "text": "ἀποδεδώκαμεν, ὡς λέγει, ἀλλ᾿ ἑκατέρου ὁ ὁρισμὸς κακῶς ἔχει·", "seq": 3668}
{"id": "David_Passim_3669", "series": "CAG", "text": "ἐλέγομεν γὰρ τοῦ γενικωτάτου γένους ἀποδοθῆναι τὸν προειρημένον ὁρισμόν, οὐ μόνον δὲ τῷ γενικωτάτῳ ἁρμόζειν, ἀλλὰ καὶ τοῖς ὑπαλλήλοις γένεσιν·", "seq": 3669}
{"id": "David_Passim_3670", "series": "CAG", "text": "ὡς γὰρ ἁρμόζει τῷ γενικωτάτῳ ὁ ὅρος ὁ λέγων τὸ κατὰ πλειόνων καὶ διαφερόντων τῷ εἴδει ἐν τῷ τί ἐστι κατηγορούμενον, οὕτω καὶ τῷ ὑπαλλήλῳ·", "seq": 3670}
{"id": "David_Passim_3671", "series": "CAG", "text": "ὁ αὐτὸς γὰρ ἐὰν λεχθῇ καὶ ἐπὶ τοῦ ὑπαλλήλου, ἁρμόσει αὐτῷ.", "seq": 3671}
{"id": "David_Passim_3672", "series": "CAG", "text": "καὶ ὁ τοῦ εἰδικωτάτου δὲ εἴδους ὁρισμὸς οὐ μόνον τῷ εἰδικωτάτῳ ἁρμόζει, ἀλλὰ καὶ τῷ ἀτόμῳ·", "seq": 3672}
{"id": "David_Passim_3673", "series": "CAG", "text": "τὸ γὰρ ἁπλῶς ἄτομον ἐπιδέχεται καὶ τὸν τοιοῦτον ὁρισμόν·", "seq": 3673}
{"id": "David_Passim_3674", "series": "CAG", "text": "τὸ γὰρ ἁπλῶς ἄτομόν ἐστι τὸ κατὰ πλειόνων καὶ διαφερόντων τῷ ἀριθμῷ ἐν τῷ τί ἐστι κατηγορούμενον.", "seq": 3674}
{"id": "David_Passim_3675", "series": "CAG", "text": "τί οὖν φαμεν πρὸς ταῦτα;", "seq": 3675}
{"id": "David_Passim_3676", "series": "CAG", "text": "λέγομεν πρὸς τὸ πρῶτον ὅτι κἂν ἁρμόζῃ ὁ ὁρισμὸς τοῦ γενικωτάτου γένους τῷ ὑπαλλήλῳ, οὐκ ἄγεται ὑφ᾿ ἁμαρτίαν·", "seq": 3676}
{"id": "David_Passim_3677", "series": "CAG", "text": "οὔτε γὰρ μόνου τοῦ γενικωτάτου ἀπεδόθη, ἀλλ᾿ ἑκάστου γένους.", "seq": 3677}
{"id": "David_Passim_3678", "series": "CAG", "text": "πρὸς δὲ τὸ δεύτερόν φαμεν ὅτι ὁ ὁρισμὸς τοῦ εἰδικωτάτου εἴδους οὐχ ἁρμόζει τῷ τοιῷδε ἀτόμῳ, ἀλλὰ τῷ ἁπλῶς ἀτόμῳ·", "seq": 3678}
{"id": "David_Passim_3679", "series": "CAG", "text": "τὸ δ᾿ ἁπλῶς ἄτομον εἴδους τάξιν ἐπέχει ἤτοι εἶδός ἐστιν.", "seq": 3679}
{"id": "David_Passim_3680", "series": "CAG", "text": "ἔχομεν ἐντεῦθεν ὡς ἔδει τὰ εἰδικώτατα εἴδη εἰς τὸ ἁπλῶς ἄτομον διαιρεῖσθαι, κἂν μὴ βούληται Πλάτων·", "seq": 3680}
{"id": "David_Passim_3681", "series": "CAG", "text": "ὅτι γὰρ τὸ ἁπλῶς ἄτομον οὐκ ἔστιν εἶδος, ἐντελῶς ἐν ταῖς Κατηγορίαις εἰσόμεθα·", "seq": 3681}
{"id": "David_Passim_3682", "series": "CAG", "text": "τάξιν γὰρ εἴδους ἐπέχει.", "seq": 3682}
{"id": "David_Passim_3683", "series": "CAG", "text": "7.", "seq": 3683}
{"id": "David_Passim_3684", "series": "CAG", "text": "2 Τὸ μὲν γένος ἀεὶ τοῦ εἴδους κατηγορεῖται.", "seq": 3684}
{"id": "David_Passim_3685", "series": "CAG", "text": "Σκόπει πῶς λέγει πάντα τὰ ἐπὶ πλέον κατηγορεῖσθαι τῶν ἐπ᾿ ἔλαττον·", "seq": 3685}
{"id": "David_Passim_3686", "series": "CAG", "text": "οὐ γὰρ εἴ τι ζῷον, εἴποις, ἄνθρωπος.", "seq": 3686}
{"id": "David_Passim_3687", "series": "CAG", "text": "7.", "seq": 3687}
{"id": "David_Passim_3688", "series": "CAG", "text": "7 Ὥσπερ τὸν ἄνθρωπον εἶναι ζῷον.", "seq": 3688}
{"id": "David_Passim_3689", "series": "CAG", "text": "Φησὶν ὅτι δικαίως τὸ ζῷον τοῦ ἀνθρώπου κατηγορεῖται·", "seq": 3689}
{"id": "David_Passim_3690", "series": "CAG", "text": "εἴ τι μὲν γὰρ ἄνθρωπος, τοῦτο καὶ ζῷον, οὐκ εἴ τι δὲ ζῷον, τοῦτο καὶ ἄνθρωπος·", "seq": 3690}
{"id": "David_Passim_3691", "series": "CAG", "text": "ὥστε οὖν ἐπὶ πλέον φθάνει τὸ ζῷον τοῦ ἀνθρώπου.", "seq": 3691}
{"id": "David_Passim_3692", "series": "CAG", "text": "7.", "seq": 3692}
{"id": "David_Passim_3693", "series": "CAG", "text": "14 Τὸ δὲ γενικώτατον καὶ κατὰ τοῦ γένους ἢ τῶν γενῶν.", "seq": 3693}
{"id": "David_Passim_3694", "series": "CAG", "text": "Κακῶς λέγει τὸ γενικώτατον ἑνὸς κατηγορεῖσθαι·", "seq": 3694}
{"id": "David_Passim_3695", "series": "CAG", "text": "οὐδέποτε γὰρ τὸ γενικώτατον ἑνὸς γένους κατηγορεῖται, ἀλλὰ πολλῶν.", "seq": 3695}
{"id": "David_Passim_3696", "series": "CAG", "text": "7.", "seq": 3696}
{"id": "David_Passim_3697", "series": "CAG", "text": "14 Εἰ πλείω εἴη τὰ μέσα καὶ ὑπάλληλα.", "seq": 3697}
{"id": "David_Passim_3698", "series": "CAG", "text": "Καὶ τοῦτο πάλιν κακῶς εἶπε·", "seq": 3698}
{"id": "David_Passim_3699", "series": "CAG", "text": "φησὶ γάρ·", "seq": 3699}
{"id": "David_Passim_3700", "series": "CAG", "text": "ἀεὶ πολλῶν γενῶν κατηγορεῖται τὸ γενικώτατον, εἰ πολλὰ εἴη τὰ μέσα καὶ ὑπάλληλα.", "seq": 3700}
{"id": "David_Passim_3701", "series": "CAG", "text": "πάντως δὲ ὅπου ἐστὶ γενικώτατον, πολλά εἰσι τὰ ὑπάλληλα.", "seq": 3701}
{"id": "David_Passim_3702", "series": "CAG", "text": "τὰ δὲ ὑπάλληλα καὶ μέσα τὰ αὐτὰ εἶπε.", "seq": 3702}
{"id": "David_Passim_3703", "series": "CAG", "text": "7.", "seq": 3703}
{"id": "David_Passim_3704", "series": "CAG", "text": "15 Καὶ κατὰ τοῦ εἴδους καὶ κατὰ τοῦ ἀτόμου.", "seq": 3704}
{"id": "David_Passim_3705", "series": "CAG", "text": "Πρὸς τὰ ἄνω κατηγορεῖται τὸ γενικώτατον καὶ τοῦ εἰδικωτάτου εἴδους καὶ τῶν ἀτόμων.", "seq": 3705}
{"id": "David_Passim_3706", "series": "CAG", "text": "7.", "seq": 3706}
{"id": "David_Passim_3707", "series": "CAG", "text": "20 Καὶ τουτὶ τὸ λευκόν.", "seq": 3707}
{"id": "David_Passim_3708", "series": "CAG", "text": "Καλῶς εἶπε τὸ τοιόνδε λευκόν·", "seq": 3708}
{"id": "David_Passim_3709", "series": "CAG", "text": "δεικτικῶς γὰρ αὐτὸ εἶπε·", "seq": 3709}
{"id": "David_Passim_3710", "series": "CAG", "text": "τὸ γὰρ ἁπλῶς λευκὸν οὐκ ἔστιν ἄτομον.", "seq": 3710}
{"id": "David_Passim_3711", "series": "CAG", "text": "7.", "seq": 3711}
{"id": "David_Passim_3712", "series": "CAG", "text": "21 Εἰ μόνος αὐτῷ εἴη Σωκράτης υἱός.", "seq": 3712}
{"id": "David_Passim_3713", "series": "CAG", "text": "Καλῶς εἶπεν εἰ μόνος αὐτῷ ἐστι Σωκράτης υἱός·", "seq": 3713}
{"id": "David_Passim_3714", "series": "CAG", "text": "εἰ γὰρ ἔστι καὶ ἄλλος, τότε τὸν Σωκράτην οὐ δηλοῖ, ἀλλ᾿ ἀόριστον υἱὸν λέγει, τὰ δέ γε ἄτομα ἀόριστα.", "seq": 3714}
{"id": "David_Passim_3715", "series": "CAG", "text": "7.", "seq": 3715}
{"id": "David_Passim_3716", "series": "CAG", "text": "25 Ἐπὶ πλειόνων μᾶλλον δὲ ἐπὶ πάντων τῶν κατὰ μέρος ἀνθρώπων, καθὸ ἄνθρωποί εἰσι.", "seq": 3716}
{"id": "David_Passim_3717", "series": "CAG", "text": "Φησὶν ὅτι αἱ ἰδιότητες αἱ οὖσαι ἐν τῷ ἀνθρώπῳ δύνανται καὶ ἐν τῷ μερικῷ εἶναι, οἷον τὸ λογικὸν τὸ θνητὸν καὶ εὐφυές εἰσιν ἐν τῷ ἀνθρώπῳ, δύνανται δὲ καὶ ἐν Σωκράτει καὶ Ἀλκιβιάδῃ εἶναι, καθὸ καὶ αὐτοὶ ἄνθρωποί εἰσιν·", "seq": 3717}
{"id": "David_Passim_3718", "series": "CAG", "text": "αἱ γοῦν ἰδιότητες τοῦ Σωκράτους οὐ δύνανται καὶ ἐν ἄλλῳ εἶναι, καθὸ οὐ πάντες Σωκράτης.", "seq": 3718}
{"id": "David_Passim_3719", "series": "CAG", "text": "εἰπὼν δὲ ἐπὶ πλειόνων καὶ γνοὺς ὅτι οὐ μόνον ἐπὶ πλειόνων διήκουσιν αἱ ἰδιότητες τοῦ κοινοῦ, λέγω δὲ τοῦ ἁπλῶς ἀνθρώπου, ἀλλὰ καὶ ἐπὶ ὅλων, ἐπήγαγε μᾶλλον δὲ ἐπὶ πάντων τῶν κατὰ μέρος.", "seq": 3719}
{"id": "David_Passim_3720", "series": "CAG", "text": "ἐγὼ δὲ οἶμαι εἶναι τούτου ἑτέραν ἐξήγησιν·", "seq": 3720}
{"id": "David_Passim_3721", "series": "CAG", "text": "τὸ γὰρ ἐνδοιάζειν φιλόσοφον ἄτοπον φαίνεται·", "seq": 3721}
{"id": "David_Passim_3722", "series": "CAG", "text": "ἐπεὶ γὰρ καὶ τὸ λογικὸν καὶ τὸ θνητὸν τοῦ ἀνθρώπου εἰσὶν ἰδιότητες, κατὰ μὲν τὸ λογικὸν λέγομεν τὴν ἰδιότητα αὐτοῦ ἐπὶ πλειόνων φέρεσθαι (τὸ τοιοῦτον γὰρ καὶ ἐπὶ ἀγγέλων δύναται εἶναι), κατὰ δὲ τὸ λογικὸν θνητὸν τὴν ἰδιότητα αὐτοῦ φαμεν φέρεσθαι ἐπὶ πάντων τῶν κατὰ μέρος ἀνθρώπων.", "seq": 3722}
{"id": "David_Passim_3723", "series": "CAG", "text": "ὥστε οὖν τὸ ἐπὶ πάντων μόνον οὐκ ἠδύνατο εἰπεῖν·", "seq": 3723}
{"id": "David_Passim_3724", "series": "CAG", "text": "ἐποίει γὰρ καὶ τὸν ἄγγελον θνητόν.", "seq": 3724}
{"id": "David_Passim_3725", "series": "CAG", "text": "πρὸς μὲν οὖν τὸν ἄγγελον προσέχων εἶπε τὸ πλειόνων, πρὸς δὲ τὸν κατὰ μέρος ἄνθρωπον εἶπε πάντων.", "seq": 3725}
{"id": "David_Passim_3726", "series": "CAG", "text": "8.", "seq": 3726}
{"id": "David_Passim_3727", "series": "CAG", "text": "1 Ὅλον γάρ τι τὸ γένος.", "seq": 3727}
{"id": "David_Passim_3728", "series": "CAG", "text": "Ἰδοὺ οὖν λέγει·", "seq": 3728}
{"id": "David_Passim_3729", "series": "CAG", "text": "τὸ μόνον κατηγορούμενον τῷ ὅλῳ ἔοικε.", "seq": 3729}
{"id": "David_Passim_3730", "series": "CAG", "text": "8.", "seq": 3730}
{"id": "David_Passim_3731", "series": "CAG", "text": "2 Τὸ εἶδος δὲ καὶ ὅλον καὶ μέρος.", "seq": 3731}
{"id": "David_Passim_3732", "series": "CAG", "text": "Τὸ ὑπάλληλον δὲ μᾶλλον ὅλον ἐστὶν ἤπερ μέρος, τὸ δὲ εἰδικώτατον μᾶλλον μέρος ἤπερ ὅλον.", "seq": 3732}
{"id": "David_Passim_3733", "series": "CAG", "text": "8.", "seq": 3733}
{"id": "David_Passim_3734", "series": "CAG", "text": "2 Ἀλλὰ μέρος μὲν ἄλλου, ὅλον δὲ οὐκ ἄλλου ἀλλ᾿ ἐν ἄλλοις·", "seq": 3734}
{"id": "David_Passim_3735", "series": "CAG", "text": "ἐν γὰρ τοῖς μέρεσι τὸ ὅλον.", "seq": 3735}
{"id": "David_Passim_3736", "series": "CAG", "text": "Διδάσκει ἡμᾶς ὁ Πορφύριος ὅτι οὐκ ἐπ᾿ ἴσης ἀεὶ λαμβάνεται τὰ πρός τι·", "seq": 3736}
{"id": "David_Passim_3737", "series": "CAG", "text": "ἔστι μὲν γὰρ ὅτε ἐπ᾿ ἴσης, καὶ ἔστιν ὅτε οὔ.", "seq": 3737}
{"id": "David_Passim_3738", "series": "CAG", "text": "ἐπ᾿ ἴσης μὲν ὡς ἵνα εἴπω ‘τὸ δεξιὸν τοῦ ἀριστεροῦ ἐστι δεξιόν, τὸ ἀριστερὸν τοῦ δεξιοῦ ἐστιν ἀριστερόν’.", "seq": 3738}
{"id": "David_Passim_3739", "series": "CAG", "text": "οὐκ ἐπ᾿ ἴσης δὲ ὥσπερ ἐν τῷ ὅλῳ καὶ τοῖς μέρεσι·", "seq": 3739}
{"id": "David_Passim_3740", "series": "CAG", "text": "φαμὲν γὰρ ‘τὸ μέρος ὅλου ἐστὶ μέρος’, οὐ φαμὲν δὲ ὁμοίως ἑνικῶς ‘τὸ ὅλον μέρους ἐστὶν ὅλον’, ἀλλὰ ‘τὸ ὅλον μερῶν ἐστιν ὅλον’.", "seq": 3740}
{"id": "David_Passim_3741", "series": "CAG", "text": "οὕτω δὲ καὶ ἐπὶ τοῦ πατρὸς τοῦ ἔχοντος πολλοὺς υἱούς φαμεν τὸ ἓν σκέλος ἑνικῶς, τὸ δὲ ἕτερον πληθυντικῶς·", "seq": 3741}
{"id": "David_Passim_3742", "series": "CAG", "text": "οἱ υἱοὶ πατρός εἰσιν υἱοί, ὁ πατὴρ δὲ υἱῶν ἐστι πατήρ, οὐχ ἑνὸς δὲ υἱοῦ ὁμοίως τῷ πρώτῳ σκέλει.", "seq": 3742}
{"id": "David_Passim_3743", "series": "CAG", "text": "Πρᾶξις κγ΄.", "seq": 3743}
{"id": "David_Passim_3744", "series": "CAG", "text": "Περὶ διαφορᾶς.", "seq": 3744}
{"id": "David_Passim_3745", "series": "CAG", "text": "Μετὰ τὴν ἑκατέρων τῶν ἄκρων διδασκαλίαν χωρητέον καὶ ἐπὶ τὴν διαφορὰν τρίτην εἰληφυῖαν τάξιν·", "seq": 3745}
{"id": "David_Passim_3746", "series": "CAG", "text": "παρακεχώρηκε δὲ τῷ εἴδει τῆς τάξεως, εἰ καὶ φύσει προτερεύει, διὰ τὸ γειτνιάζειν τῷ γένει.", "seq": 3746}
{"id": "David_Passim_3747", "series": "CAG", "text": "οὐ μόνον δὲ τούτου ἕνεκα τῷ εἴδει παρακεχώρηκε τῆς τάξεως, ἀλλ᾿ ἵνα μὴ διασπασμὸς τῶν διδασκαλιῶν γένηται·", "seq": 3747}
{"id": "David_Passim_3748", "series": "CAG", "text": "τὸ γὰρ γένος καὶ τὸ εἶδος ἐν τῷ τί ἐστι κατηγοροῦνται, ἡ δὲ διαφορὰ καὶ τὸ ἴδιον καὶ τὸ συμβεβηκὸς ἐν τῷ ὁποῖόν τί ἐστιν εἰ διέλαβεν οὖν μετὰ τὸ γένος περὶ διαφορᾶς, ἤμελλε διασπᾶν τὴν διδασκαλίαν τῶν πρός τι, ἀλλὰ μὴν καὶ τῶν ὁποῖόν τί ἐστιν·", "seq": 3748}
{"id": "David_Passim_3749", "series": "CAG", "text": "ἡ γὰρ διαφορὰ ἤμελλε μεσάζεσθαι ἐκ γένους καὶ εἴδους διασπῶσα τὰ πρός τι, καὶ τὸ εἶδος δὲ μεσαζόμενον ἐκ διαφορᾶς καὶ ἰδίου ἔμελλε διασπᾶν τὰ ἐν τῷ ὁποῖον τί ἐστι κατηγορούμενα.", "seq": 3749}
{"id": "David_Passim_3750", "series": "CAG", "text": "Μαθόντες οὖν ἐκ τῶν ἀρτίως καὶ πρώην λεγομένων τὴν δέουσαν τάξιν εἰληφέναι τὴν διαφορὰν σπουδῇ ἐπ᾿ αὐτὴν χωρήσωμεν.", "seq": 3750}
{"id": "David_Passim_3751", "series": "CAG", "text": "πρῶτον δὲ τοῖς διηγορευμένοις κανόσι χρησάμενοι διαστείλωμεν τὴν ὁμωνυμίαν·", "seq": 3751}
{"id": "David_Passim_3752", "series": "CAG", "text": "ὁμώνυμος γὰρ φωνὴ καὶ ἡ διαφορά.", "seq": 3752}
{"id": "David_Passim_3753", "series": "CAG", "text": "λέγεται τοίνυν διαφορὰ τριχῶς·", "seq": 3753}
{"id": "David_Passim_3754", "series": "CAG", "text": "ἔστι γὰρ ἡ κοινῶς διαφορὰ καὶ ἡ ἰδίως καὶ ἡ ἰδιαίτατα.", "seq": 3754}
{"id": "David_Passim_3755", "series": "CAG", "text": "καὶ κοινῶς μέν ἐστιν ἡ σημαίνουσα χωριστὸν συμβεβηκός, ἰδίως δὲ ἡ σημαίνουσα ἀχώριστον, ἰδιαίτατα δὲ ἡ οὐσίαν παριστῶσα.", "seq": 3755}
{"id": "David_Passim_3756", "series": "CAG", "text": "καὶ τοῦ μὲν πρώτου <ὑπόδειγμα> τὸ λευκὸν τὸ ἐν ἐμοὶ χωριστόν ἐστι·", "seq": 3756}
{"id": "David_Passim_3757", "series": "CAG", "text": "δυνατὸν γάρ ἐστι γενέσθαι τὸ λευκὸν μέλαν.", "seq": 3757}
{"id": "David_Passim_3758", "series": "CAG", "text": "τοῦ δὲ δευτέρου ἡ γλαυκότης ἡ ἐν ἐμοὶ ἀχώριστός ἐστιν.", "seq": 3758}
{"id": "David_Passim_3759", "series": "CAG", "text": "ὁ γὰρ γλαυκόφθαλμος οὐκέτι καὶ μελανόφθαλμος.", "seq": 3759}
{"id": "David_Passim_3760", "series": "CAG", "text": "τοῦ δὲ τρίτου·", "seq": 3760}
{"id": "David_Passim_3761", "series": "CAG", "text": "τὸ λογικὸν διακρίνει ἡμᾶς ἐκ τῶν ἀλόγων·", "seq": 3761}
{"id": "David_Passim_3762", "series": "CAG", "text": "αὕτη γὰρ ἡ διαφορὰ οὐσίαν δηλοῖ.", "seq": 3762}
{"id": "David_Passim_3763", "series": "CAG", "text": "διὰ τί δὲ τρεῖς εἰσιν αἱ διαφοραὶ καὶ οὔτε πλείους εἰσὶν οὔτε ἐλάττους λέξομεν, μετέπειτα δὲ καὶ διὰ τί τοιούτων προσηγοριῶν ἐπέτυχον ἐροῦμεν.", "seq": 3763}
{"id": "David_Passim_3764", "series": "CAG", "text": "τὰ πράγματα διττά ἐστιν, ἢ συμβεβηκότα ἢ οὐσία, τὰ συμβεβηκότα ἢ χωριστὰ ἢ ἀχώριστα.", "seq": 3764}
{"id": "David_Passim_3765", "series": "CAG", "text": "καὶ εἰ μὲν χωριστὸν εἴη τὸ συμβεβηκός, τότε γίνεται ἡ κοινῶς διαφορὰ οἷον τὸ λευκὸν καὶ τὸ ἐκ τοῦ ἡλίου μέλαν (ταῦτα γὰρ δύναται χωρίζεσθαι), εἰ δὲ ἀχώριστον εἴη τὸ συμβεβηκός, γίνεται ἡ ἰδίως οἷον ἡ γλαυκότης ἡ σιμότης ἡ γρυπότης τὸ φαλακρὸν τὸ ἐν Αἰθίοπι μέλαν (ταῦτα γὰρ οὐ χωρίζεται), εἰ δὲ οὐσία ἐστί, τότε γίνεται ἡ ἰδιαίτατα οἷον τὸ λογικὸν τὸ θνητόν·", "seq": 3765}
{"id": "David_Passim_3766", "series": "CAG", "text": "ταῦτα γὰρ οὐσία ἡμῶν εἰσιν.", "seq": 3766}
{"id": "David_Passim_3767", "series": "CAG", "text": "εἰ οὖν διττά ἐστι τὰ πράγματα εἰς τρία δὲ διαιρεῖται, εὐλόγως καὶ αἱ διαφοραὶ τριτταί εἰσι καὶ οὔτε πλείους οὔτε ἐλάττους.", "seq": 3767}
{"id": "David_Passim_3768", "series": "CAG", "text": "ἔστι δὲ καὶ ἄλλως εἰπεῖν·", "seq": 3768}
{"id": "David_Passim_3769", "series": "CAG", "text": "τὰ πράγματα διττά ἐστιν, ἢ χωριστὰ ἢ ἀχώριστα, καὶ χωριστὰ μὲν οἷον τὸ λευκὸν καὶ τὸ ἐκ τοῦ ἡλίου μέλαν, τὰ ἀχώριστα δέ εἰσιν ἤτοι συμβεβηκότα ἢ οὐσία.", "seq": 3769}
{"id": "David_Passim_3770", "series": "CAG", "text": "καὶ τὰ χωριστὰ μὲν ποιεῖ τὴν κοινῶς διαφοράν, τὰ ἀχώριστα δὲ εἰ μὲν συμβεβηκότα εἶεν, ποιεῖ τὴν ἰδίως, εἰ δὲ οὐσία, ποιεῖ τὴν ἰδιαίτατα.", "seq": 3770}
{"id": "David_Passim_3771", "series": "CAG", "text": "καὶ μὴ νομίσῃς τὴν αὐτὴν εἶναι τῇ πρώτῃ ταύτην τὴν διαίρεσιν·", "seq": 3771}
{"id": "David_Passim_3772", "series": "CAG", "text": "ἐν μὲν γὰρ τῇ πρώτῃ πάντα τὰ πράγματα διελάβομεν εἰς οὐσίαν καὶ συμβεβηκότα καὶ τὰ συμβεβηκότα εἰς χωριστὰ καὶ ἀχώριστα, ἐν δὲ τῇ δευτέρᾳ εἰς χωριστὰ καὶ ἀχώριστα, τὰ ἀχώριστα δὲ εἰς συμβεβηκότα καὶ οὐσίαν.", "seq": 3772}
{"id": "David_Passim_3773", "series": "CAG", "text": "φθάνει οὖν ἐν τῇ πρώτῃ τὰ συμβεβηκότα ὁμοῦ εἶναι, τά τε χωριστὰ καὶ τὰ ἀχώριστα, ἐν δὲ τῇ δευτέρᾳ οὐχ οὕτως·", "seq": 3773}
{"id": "David_Passim_3774", "series": "CAG", "text": "τὸ γὰρ ἀχώριστον συμβεβηκὸς μετὰ τῆς οὐσίας εὑρίσκεται·", "seq": 3774}
{"id": "David_Passim_3775", "series": "CAG", "text": "οὕτω γάρ φαμεν τὸ ἀχώριστον διαιρεῖσθαι, εἰς οὐσίαν καὶ συμβεβηκότα.", "seq": 3775}
{"id": "David_Passim_3776", "series": "CAG", "text": "τάττεται δὲ μετὰ τῶν δύο, ὅτι καὶ τῶν δύο μετέχει·", "seq": 3776}
{"id": "David_Passim_3777", "series": "CAG", "text": "τῶν μὲν γὰρ συμβεβηκότων ἔχει τὸ ἐπουσιῶδες τῆς δὲ οὐσίας τὸ ἀχώριστον.", "seq": 3777}
{"id": "David_Passim_3778", "series": "CAG", "text": "τρίτην δὲ διαίρεσιν διαθησόμεθα, ἥν φησι καὶ ὁ Πορφύριος, ὀνόμασι μὲν τῶν προειρημένων διαφέρουσαν πράγμασι δὲ τὴν αὐτὴν οὖσαν.", "seq": 3778}
{"id": "David_Passim_3779", "series": "CAG", "text": "καὶ ἔστι μὲν ἡ οὐσία ἄλλο, τὸ συμβεβηκὸς δὲ ἀλλοῖον.", "seq": 3779}
{"id": "David_Passim_3780", "series": "CAG", "text": "διὰ τί δὲ ἡ οὐσία ἄλλο καὶ τὸ συμβεβηκὸς ἀλλοῖον, τὸ κείμενον ἡμᾶς διδάξει.", "seq": 3780}
{"id": "David_Passim_3781", "series": "CAG", "text": "θάτερον δὲ τούτων τῶν σκελῶν ποιεῖ δύο συζυγίας·", "seq": 3781}
{"id": "David_Passim_3782", "series": "CAG", "text": "ἄλλο χωριστὸν καὶ ἄλλο ἀχώριστον καὶ ἀλλοῖον χωριστὸν καὶ ἀλλοῖον ἀχώριστον.", "seq": 3782}
{"id": "David_Passim_3783", "series": "CAG", "text": "εἰσὶ δὲ καὶ ἄλλαι δύο·", "seq": 3783}
{"id": "David_Passim_3784", "series": "CAG", "text": "ἄλλο καὶ ἀλλοῖον, χωριστὸν καὶ ἀχώριστον.", "seq": 3784}
{"id": "David_Passim_3785", "series": "CAG", "text": "πᾶσαι δὲ ἕξ εἰσι, καὶ τούτων αἱ μὲν τρεῖς συνίστανται καὶ τρεῖς εἰσιν ἀσύστατοι.", "seq": 3785}
{"id": "David_Passim_3786", "series": "CAG", "text": "συνίστανται μὲν αἱ ὑπάλληλοι καὶ μία τῶν διαγωνίων, αἱ δὲ λοιπαὶ οὐκέτι, φημὶ δὲ αἱ ἐναντίως ἔχουσαι καὶ μία τῶν διαγωνίων·", "seq": 3786}
{"id": "David_Passim_3787", "series": "CAG", "text": "οὐ συνίσταται γὰρ ἡ λέγουσα τὸ ἄλλο καὶ τὸ ἀλλοῖον (πῶς γὰρ τὸ διαφέρον οὐσιωδῶς καὶ ἐπουσιωδῶς διαφέρει;)", "seq": 3787}
{"id": "David_Passim_3788", "series": "CAG", "text": ", οὔτε ἡ λέγουσα τὸ χωριστὸν καὶ ἀχώριστον (πῶς γὰρ τὸ χωριστὸν καὶ ἀχώριστον;)", "seq": 3788}
{"id": "David_Passim_3789", "series": "CAG", "text": ", οὔτε μὴν ἡ μία τῶν διαγωνίων, φημὶ δὲ ἡ λέγουσα ἄλλο χωριστόν·", "seq": 3789}
{"id": "David_Passim_3790", "series": "CAG", "text": "τὸ οὐσιῶδες γὰρ ἀχώριστόν ἐστι.", "seq": 3790}
{"id": "David_Passim_3791", "series": "CAG", "text": "συνίσταται δὲ ἡ λέγουσα ἄλλο ἀχώριστον καὶ ἡ λέγουσα ἀλλοῖον χωριστὸν καὶ ἀχώριστον.", "seq": 3791}
{"id": "David_Passim_3792", "series": "CAG", "text": "καὶ τὸ μὲν ἀλλοῖον χωριστὸν ποιεῖ τὴν κοινῶς διαφοράν, τὸ δὲ ἀλλοῖον ἀχώριστον τὴν ἰδίως, τὸ δὲ ἄλλο ἀχώριστον τὴν ἰδιαίτατα.", "seq": 3792}
{"id": "David_Passim_3793", "series": "CAG", "text": "Μαθόντες οὖν διὰ τί τρεῖς εἰσιν αἱ διαφοραί, φέρε κατὰ τὴν ἡμετέραν ἐπαγγελίαν εἴπωμεν διὰ τί καὶ τῶν τοιούτων ἔτυχον προσηγοριῶν.", "seq": 3793}
{"id": "David_Passim_3794", "series": "CAG", "text": "ἡ δηλοῦσα χωριστὸν συμβεβηκὸς κοινῶς διαφορὰ καλεῖται, ὅτι κοινῶς ἔχει τἀναντία, κἂν μὴ ἐν τῷ αὐτῷ χρόνῳ·", "seq": 3794}
{"id": "David_Passim_3795", "series": "CAG", "text": "τὸ γὰρ λευκὸν δύναται ἐν διαφόρῳ χρόνῳ καὶ μέλαν εἶναι, ὁ κινούμενος δύναται ἠρεμεῖν.", "seq": 3795}
{"id": "David_Passim_3796", "series": "CAG", "text": "ἰδίως δὲ διαφορὰ λέγεται ἡ ἀχώριστον συμβεβηκὸς δηλοῦσα, ἐπειδὴ τἀναντία οὐ δηλοῖ ὑπὸ τοῦ αὐτοῦ μετέχεσθαί ποτε·", "seq": 3796}
{"id": "David_Passim_3797", "series": "CAG", "text": "οὔτε γὰρ ὁ φαλακρὸς δύναται κομήτης εἶναι, κἂν ἀμειφθείη ὁ χρόνος, οὔτε τὸ μέλαν τοῦ Αἰθίοπος <ἐν> διαφόρῳ χρόνῳ εἰς λευκὸν ἀμείβεται, οὔτε ὁ γλαυκόφθαλμος μελανόφθαλμος γίνεται.", "seq": 3797}
{"id": "David_Passim_3798", "series": "CAG", "text": "ταῦτα οὖν ἐπειδὴ οὐ χωρίζεται, ἰδίως ἔχει τὴν διαφορὰν καὶ ἴδιά ἐστιν.", "seq": 3798}
{"id": "David_Passim_3799", "series": "CAG", "text": "ἰδιαίτατα δὲ λέγεται ἡ οὐσίαν δηλοῦσα, ἐπειδὴ ἰδίως ὑπάρχει τινὶ καὶ ἀχωρίστως.", "seq": 3799}
{"id": "David_Passim_3800", "series": "CAG", "text": "καὶ καλῶς μὲν τὴν δηλοῦσαν ἀχώριστον συμβεβηκὸς ἰδίως καλοῦμεν, καλῶς δὲ καὶ τὴν δηλοῦσαν οὐσίαν ἰδιαίτατα ὑπερθετικῇ φωνῇ χρησάμενοι·", "seq": 3800}
{"id": "David_Passim_3801", "series": "CAG", "text": "πλέον γὰρ τῆς ἀχώριστον συμβεβηκὸς δηλούσης ἡ σημαίνουσα οὐσίαν ἀχώριστόν ἐστιν·", "seq": 3801}
{"id": "David_Passim_3802", "series": "CAG", "text": "ἐπὶ γὰρ τῶν οὐσιωδῶν διαφορῶν οὐ δύνασαι χωρισμὸν νοῆσαι οὔτε ἐννοίᾳ οὔτε ἐνεργείᾳ, ἐπὶ δὲ τῶν σημαινουσῶν ἀχώριστον συμβεβηκὸς δύνασαι χωρισμὸν νοῆσαι ἐννοίᾳ·", "seq": 3802}
{"id": "David_Passim_3803", "series": "CAG", "text": "τὸν γὰρ γλαυκόφθαλμον εἰ νοήσεις μελανόφθαλμον, οὐδὲν λυμαίνῃ τῷ ὑποκειμένῳ, ἄλογον δ᾿ εἰ νοήσεις, λυμαίνῃ τῷ ὑποκειμένῳ·", "seq": 3803}
{"id": "David_Passim_3804", "series": "CAG", "text": "ἐκτὸς γὰρ τοῦ λογικοῦ οὐκ ἔστιν ἄνθρωπος.", "seq": 3804}
{"id": "David_Passim_3805", "series": "CAG", "text": "8,8 Διαφορὰ δὲ κοινῶς τε καὶ ἰδίως καὶ ἰδιαίτατα λεγέσθω.", "seq": 3805}
{"id": "David_Passim_3806", "series": "CAG", "text": "Ἐκ τοῦ προστάσσειν δηλοῖ ὁ Πορφύριος ὅτι αὐτοῦ εἰσιν αἱ ὀνοματοποιΐαι τῶν τοιούτων διαφορῶν·", "seq": 3806}
{"id": "David_Passim_3807", "series": "CAG", "text": "διὰ τοῦτο γὰρ οὐκ εἶπε ‘λέγεται’.", "seq": 3807}
{"id": "David_Passim_3808", "series": "CAG", "text": "Τινὲς δὲ λέγουσιν ὅτι καλῶς προετάγη τὸ γένος καὶ τὸ εἶδος τῆς διαφορᾶς·", "seq": 3808}
{"id": "David_Passim_3809", "series": "CAG", "text": "τί δὲ λέγομεν τὸ εἶδος, ἐξ οὗ καὶ τὰ ἄτομα πρὸ τῆς διαφορᾶς ἀπαιτεῖ προτάττεσθαι;", "seq": 3809}
{"id": "David_Passim_3810", "series": "CAG", "text": "ταῦτα γὰρ τῶν πρός τί ἐστι·", "seq": 3810}
{"id": "David_Passim_3811", "series": "CAG", "text": "τὰ δὲ πρός τι ἅμα θέλει εἶναι·", "seq": 3811}
{"id": "David_Passim_3812", "series": "CAG", "text": "οὔτε γάρ ἐστι θάτερον τοῦ ἑτέρου προτερεῦον.", "seq": 3812}
{"id": "David_Passim_3813", "series": "CAG", "text": "εἰ οὖν προτερεύει τὸ γένος τῆς διαφορᾶς, ἅμα δὲ τὰ πρός τι θέλει εἶναι, ἅμα ἔστω τὸ γένος καὶ τὸ εἶδος.", "seq": 3813}
{"id": "David_Passim_3814", "series": "CAG", "text": "τὸ εἶδος δὲ καὶ τὰ ἄτομα εἰ ἔστι τῶν πρός τι, καὶ τὰ ἄτομα τῆς διαφορᾶς προηγείσθω.", "seq": 3814}
{"id": "David_Passim_3815", "series": "CAG", "text": "ἔστι δὲ εἰπεῖν πρὸς τούτους ὅτι κατὰ μὲν τὴν σχέσιν τὰ πρός τι ἀλλήλων οὐ προτερεύει (ὅπου γὰρ πατήρ, ἐκεῖ καὶ υἱός), κατὰ δὲ τὰ πράγματα προτερεύει·", "seq": 3815}
{"id": "David_Passim_3816", "series": "CAG", "text": "πρὶν γὰρ εἶναι ὁ Σωφρονίσκος Σωκράτους πατήρ, ἄνθρωπος ἦν.", "seq": 3816}
{"id": "David_Passim_3817", "series": "CAG", "text": "ἔστω οὖν τὰ τοιαῦτα κατὰ τὴν σχέσιν μὴ προτερεύειν, κατὰ δὲ τὰ πράγματα προτερεύει.", "seq": 3817}
{"id": "David_Passim_3818", "series": "CAG", "text": "ἀλλὰ μὴν καὶ κατὰ τὴν σχέσιν ἡ διαφορὰ προτερεύει.", "seq": 3818}
{"id": "David_Passim_3819", "series": "CAG", "text": "διὰ μέσου γὰρ διαφορᾶς γίνεται τὸ εἶδος ἐκ τοῦ γένους.", "seq": 3819}
{"id": "David_Passim_3820", "series": "CAG", "text": "8.", "seq": 3820}
{"id": "David_Passim_3821", "series": "CAG", "text": "9 Ὁπωσοῦν ἢ πρὸς ἑαυτὸ ἢ πρὸς ἄλλο.", "seq": 3821}
{"id": "David_Passim_3822", "series": "CAG", "text": "Καλῶς λέγει.", "seq": 3822}
{"id": "David_Passim_3823", "series": "CAG", "text": "τινὲς δὲ ἀποροῦσι λέγοντες ὅτι κακῶς εἴρηκεν ἢ πρὸς ἑαυτό·", "seq": 3823}
{"id": "David_Passim_3824", "series": "CAG", "text": "ἡ γὰρ διαφορὰ τοὐλάχιστον ἐν δυσὶ θεωρεῖται, ἐν ἑνὶ δ᾿ οὐδέποτε·", "seq": 3824}
{"id": "David_Passim_3825", "series": "CAG", "text": "πῶς γάρ τις ἑαυτοῦ διαφέρει;", "seq": 3825}
{"id": "David_Passim_3826", "series": "CAG", "text": "λέγομεν δὲ ὅτι καλῶς ἔχει ὁ λόγος·", "seq": 3826}
{"id": "David_Passim_3827", "series": "CAG", "text": "διαφέρει γάρ τις ἑαυτοῦ ἐν διαφόρῳ χρόνῳ·", "seq": 3827}
{"id": "David_Passim_3828", "series": "CAG", "text": "ὁ γὰρ ἠρεμῶν διαφέρει τοῦ μὴ ἠρεμοῦντος.", "seq": 3828}
{"id": "David_Passim_3829", "series": "CAG", "text": "δύναται δὲ καὶ ἑαυτοῦ μετὰ χρόνον·", "seq": 3829}
{"id": "David_Passim_3830", "series": "CAG", "text": "ἐνεργῶν γὰρ οὐχ ὁ αὐτός ἐστι.", "seq": 3830}
{"id": "David_Passim_3831", "series": "CAG", "text": "8.", "seq": 3831}
{"id": "David_Passim_3832", "series": "CAG", "text": "11 Παιδός τε ὄντος καὶ ἀνδρωθέντος καὶ ἐνεργοῦντός τι ἢ παυσαμένου.", "seq": 3832}
{"id": "David_Passim_3833", "series": "CAG", "text": "Τοῦ χωριστοῦ συμβεβηκότος τὰ μέν ἐστιν εὐχώριστα τὰ δὲ δυσχώριστα.", "seq": 3833}
{"id": "David_Passim_3834", "series": "CAG", "text": "καὶ εὐχώριστα μὲν τὸ δρᾶν ἢ καὶ παύεσθαι, δυσχώριστα δὲ τὰ τῶν ἡλικιῶν·", "seq": 3834}
{"id": "David_Passim_3835", "series": "CAG", "text": "δυσχερῶς γὰρ ὁ παῖς βούπαις γίνεται.", "seq": 3835}
{"id": "David_Passim_3836", "series": "CAG", "text": "τοῦτο δὲ δηλοῖ διὰ τῶν προκειμένων παραδειγμάτων.", "seq": 3836}
{"id": "David_Passim_3837", "series": "CAG", "text": "8.", "seq": 3837}
{"id": "David_Passim_3838", "series": "CAG", "text": "12 Καὶ ἀεί γε ἐν ταῖς τοῦ πῶς ἔχειν ἑτερότησιν.", "seq": 3838}
{"id": "David_Passim_3839", "series": "CAG", "text": "Ὧδε δηλοῖ τὸ χωριστόν·", "seq": 3839}
{"id": "David_Passim_3840", "series": "CAG", "text": "τὸ γὰρ πῶς ἔχει ῥῆμα ἀεὶ ἐπιζητεῖ ‘πῶς ἔχει;’", "seq": 3840}
{"id": "David_Passim_3841", "series": "CAG", "text": "καὶ ἀποκρίνεταί τις ‘ὑγιαίνει, νοσεῖ’.", "seq": 3841}
{"id": "David_Passim_3842", "series": "CAG", "text": "ὥσπερ δὲ τὸ ῥῆμα ἀπὸ χρόνου εἰς χρόνον μεταπίπτει, οὕτω καὶ τὰ χωριστὰ συμβεβηκότα.", "seq": 3842}
{"id": "David_Passim_3843", "series": "CAG", "text": "8.", "seq": 3843}
{"id": "David_Passim_3844", "series": "CAG", "text": "14 Ἀχώριστον δὲ συμβεβηκός.", "seq": 3844}
{"id": "David_Passim_3845", "series": "CAG", "text": "Ὁμοίως καὶ τὸ ἀχώριστον συμβεβηκὸς διττόν ἐστι·", "seq": 3845}
{"id": "David_Passim_3846", "series": "CAG", "text": "τὸ μὲν γάρ ἐστιν ἐκ γενετῆς, ὡς ἡ γλαυκότης ἡ γρυπότης τὸ μέλαν τοῦ Αἰθίοπος, τὸ δὲ ἐκ τοῦ προκόπτοντος χρόνου, ὡς ἡ φαλακρότης καὶ ἡ ἐκ τοῦ τραύματος οὐλή.", "seq": 3846}
{"id": "David_Passim_3847", "series": "CAG", "text": "δηλοῖ δὲ τὸ διττὸν τοῦτο διὰ τῶν παραδειγμάτων.", "seq": 3847}
{"id": "David_Passim_3848", "series": "CAG", "text": "καλῶς δὲ εἶπεν ἡ ἐκ τοῦ τραύματος οὐλή, προσέχων τῷ ἐκ τοῦ χρόνου γενομένῳ συμβεβηκότι·", "seq": 3848}
{"id": "David_Passim_3849", "series": "CAG", "text": "δυνατὸν γὰρ οὐλὴν ἐκ γενετῆς λέγειν εἶναι, ὅτε μὴ ἔστιν ἀπὸ τραύματος, ὡς ἵνα τις ἔγκυον ἐκ πάθους εἴπῃ τεκεῖν οὐλὴν ἔχον παιδίον.", "seq": 3849}
{"id": "David_Passim_3850", "series": "CAG", "text": "8.", "seq": 3850}
{"id": "David_Passim_3851", "series": "CAG", "text": "15 Ἰδιαίτατα δὲ διαφέρειν ἕτερον ἑτέρου λέγεται, ὅταν εἰδοποιῷ διαφορᾷ παραλλάξῃ.", "seq": 3851}
{"id": "David_Passim_3852", "series": "CAG", "text": "Καλῶς εἶπεν εἰδοποιῷ διαφορᾷ παραλλάξῃ·", "seq": 3852}
{"id": "David_Passim_3853", "series": "CAG", "text": "ἡ γὰρ εἰδοποιὸς διαφορὰ οὐσιώδης ἐστί, δι᾿ ἧς τὸ ἡμέτερον εἶδος χαρακτηρίζεται.", "seq": 3853}
{"id": "David_Passim_3854", "series": "CAG", "text": "ἰστέον δὲ ὡς διτταί εἰσιν αἱ εἰδοποιοὶ διαφοραί, τοῦτ᾿ ἔστιν αἱ οὐσιώδεις·", "seq": 3854}
{"id": "David_Passim_3855", "series": "CAG", "text": "αἱ μὲν γάρ εἰσιν διαιρετικαὶ αἱ δὲ συστατικαί.", "seq": 3855}
{"id": "David_Passim_3856", "series": "CAG", "text": "αἱ αὐταὶ δέ εἰσιν, ἀλλ᾿ οὐ κατὰ τοῦ αὐτοῦ παραλαμβανόμεναι·", "seq": 3856}
{"id": "David_Passim_3857", "series": "CAG", "text": "τὸ γὰρ λογικὸν καὶ ἄλογον τοῦ ζῴου εἰσὶ διαιρετικαί, οὐ μὴν συστατικαί, ἀλλὰ τοῦ ἀνθρώπου καὶ τοῦ ἵππου·", "seq": 3857}
{"id": "David_Passim_3858", "series": "CAG", "text": "τὸ γὰρ λογικὸν οὐσιωδῶς συνιστᾷ τὸν ἄνθρωπον.", "seq": 3858}
{"id": "David_Passim_3859", "series": "CAG", "text": "8.", "seq": 3859}
{"id": "David_Passim_3860", "series": "CAG", "text": "18 Ἀλλ᾿ αἱ μὲν κοινῶς καὶ ἰδίως ἀλλοῖον ποιοῦσιν.", "seq": 3860}
{"id": "David_Passim_3861", "series": "CAG", "text": "Τοῦτ᾿ ἔστι τὰ συμβεβηκότα·", "seq": 3861}
{"id": "David_Passim_3862", "series": "CAG", "text": "εἶδος γὰρ οὐκ ἀλλάσσει τὸ λευκὸν οὐδὲ ἡ σιμότης.", "seq": 3862}
{"id": "David_Passim_3863", "series": "CAG", "text": "8.", "seq": 3863}
{"id": "David_Passim_3864", "series": "CAG", "text": "19 Αἱ δὲ ἰδιαίτατα ἄλλο.", "seq": 3864}
{"id": "David_Passim_3865", "series": "CAG", "text": "Τοῦτ᾿ ἔστιν αἱ οὐσιώδεις·", "seq": 3865}
{"id": "David_Passim_3866", "series": "CAG", "text": "αὗται γὰρ τὸ εἶδος ἀμείβουσιν·", "seq": 3866}
{"id": "David_Passim_3867", "series": "CAG", "text": "εἰ γὰρ τὸ ἄλογον, ὑπόθου, λογικὸν εἴπω, ἀμείβω τὸ εἶδος τοῦ ἀλόγου καὶ ἄλλο εὑρίσκεται.", "seq": 3867}
{"id": "David_Passim_3868", "series": "CAG", "text": "9.", "seq": 3868}
{"id": "David_Passim_3869", "series": "CAG", "text": "1 Ἡ δὲ τοῦ κινεῖσθαι ἀλλοῖον μόνον παρὰ τὸ ἠρεμοῦν ἐποίησε.", "seq": 3869}
{"id": "David_Passim_3870", "series": "CAG", "text": "Καλῶς εἶπεν ἐπὶ τοῦ ἀλλοῖον τὸ μόνον·", "seq": 3870}
{"id": "David_Passim_3871", "series": "CAG", "text": "ἐπὶ γὰρ τῶν συμβεβηκότων μόνον ἀλλοῖον γίνεται·", "seq": 3871}
{"id": "David_Passim_3872", "series": "CAG", "text": "τὸ αὐτὸ γὰρ εἶδος μένει.", "seq": 3872}
{"id": "David_Passim_3873", "series": "CAG", "text": "ἐπὶ δὲ τοῦ ἄλλο οὐκ εἶπε τὸ μόνον·", "seq": 3873}
{"id": "David_Passim_3874", "series": "CAG", "text": "ὅπου γὰρ ἄλλο, ἐκεῖ καὶ ἀλλοῖον·", "seq": 3874}
{"id": "David_Passim_3875", "series": "CAG", "text": "τὸ γὰρ ἄλογον τοῦ λογικοῦ οὐ μόνον ὡς ἄλλο διαφέρει, ἀλλὰ καὶ ὡς ἀλλοῖον.", "seq": 3875}
{"id": "David_Passim_3876", "series": "CAG", "text": "9.", "seq": 3876}
{"id": "David_Passim_3877", "series": "CAG", "text": "2 Κατὰ μὲν οὖν τὰς ἄλλο ποιούσας αἵ τε διαιρέσεις γίνονται τῶν γενῶν εἰς τὰ εἴδη, οἵ τε ὅροι ἀποδίδονται ἐκ γένους ὄντες καὶ τῶν τοιούτων διαφορῶν.", "seq": 3877}
{"id": "David_Passim_3878", "series": "CAG", "text": "Ὧδε δηλοῖ πῶς διτταί εἰσιν αἱ ἰδιαίτατα·", "seq": 3878}
{"id": "David_Passim_3879", "series": "CAG", "text": "ἐν γὰρ τῷ λέγειν αἱ διαιρέσεις γίνονται τῶν γενῶν εἰς τὰ εἴδη δηλοῖ τὰς διαιρετικάς, ἐν δὲ τῷ λέγειν οἵ τε ὅροι ἀποδίδονται δηλοῖ τὰς συστατικάς.", "seq": 3879}
{"id": "David_Passim_3880", "series": "CAG", "text": "9.", "seq": 3880}
{"id": "David_Passim_3881", "series": "CAG", "text": "5 Καὶ αἱ τοῦ πῶς ἔχοντος μεταβολαί.", "seq": 3881}
{"id": "David_Passim_3882", "series": "CAG", "text": "Ὧδε τινές φασι καὶ πρὸς τὰς δύο λέγειν αὐτόν, φημὶ δὲ τὰς σημαινούσας τὰ συμβεβηκότα·", "seq": 3882}
{"id": "David_Passim_3883", "series": "CAG", "text": "ἐν μὲν γὰρ τῷ λέγειν ἑτερότητες λέγει τὸ ἀχώριστον, ἐν δὲ τῷ λέγειν τοῦ πῶς ἔχοντος σημαίνει τὸ χωριστόν.", "seq": 3883}
{"id": "David_Passim_3884", "series": "CAG", "text": "ψευδὲς δὲ τὸ τοιοῦτον·", "seq": 3884}
{"id": "David_Passim_3885", "series": "CAG", "text": "πρὸς ἑκατέραν γὰρ οἱ δύο λόγοι ἁρμόζουσι.", "seq": 3885}
{"id": "David_Passim_3886", "series": "CAG", "text": "Πρᾶξις κδ΄.", "seq": 3886}
{"id": "David_Passim_3887", "series": "CAG", "text": "Πάρεστιν ὁ Πορφύριος τῆς δευτέρας διαιρέσεως παραδώσων τὴν διδασκαλίαν, φημὶ δὲ τῆς λεγούσης τὰ ὄντα ἢ χωριστὰ ἢ ἀχώριστα εἶναι.", "seq": 3887}
{"id": "David_Passim_3888", "series": "CAG", "text": "ἐπειδὴ δὲ οὐ κατὰ τὸ δέον ταύτῃ ἐπεξῆλθε, φέρε τὸ ἐλλιπὲς ἀναπληρώσωμεν ἤτοι τὸ κακῶς ἔχον ἐλέγξωμεν, πρῶτον μανθάνοντες τί διαφέρει οὐσία οὐσιώδους καὶ συμβεβηκὸς ἐπουσιώδους·", "seq": 3888}
{"id": "David_Passim_3889", "series": "CAG", "text": "τούτων γὰρ τῆς διαφορᾶς γινωσκομένης εὐχερῶς ἐλεγχθήσεται ὁ Πορφύριος ἁμαρτίᾳ τινὶ περιπεσών.", "seq": 3889}
{"id": "David_Passim_3890", "series": "CAG", "text": "διαφέρει τοίνυν οὐσία οὐσιώδους, ὅτι τὸ μὲν οὐσιῶδες καὶ ἐπὶ συμβεβηκότος λαμβάνεται, ἡ δὲ οὐσία οὐκέτι·", "seq": 3890}
{"id": "David_Passim_3891", "series": "CAG", "text": "εἰ δὲ ἦν ταὐτὸν οὐσιῶδες καὶ οὐσία, ὤφειλεν ἡ οὐσία εἶναι ὅπου καὶ τὸ οὐσιῶδες.", "seq": 3891}
{"id": "David_Passim_3892", "series": "CAG", "text": "πῶς δὲ ἐπὶ συμβεβηκότος τὸ οὐσιῶδες λαμβάνεται, λέξωμεν.", "seq": 3892}
{"id": "David_Passim_3893", "series": "CAG", "text": "τὸ χρῶμα συμβεβηκός ἐστι, γένος δέ ἐστι τοῦ λευκοῦ·", "seq": 3893}
{"id": "David_Passim_3894", "series": "CAG", "text": "κατηγορεῖται γὰρ τὸ χρῶμα τοῦ λευκοῦ οὐσιωδῶς·", "seq": 3894}
{"id": "David_Passim_3895", "series": "CAG", "text": "εἰ γὰρ οὐκ ἔστιν ἐπινοῆσαι λευκὸν οὔτε ἐνεργείᾳ οὔτε ἐπινοίᾳ χωρὶς χρώματος, σαφὲς ὅτι οὐσιωδῶς κατηγορεῖται τὸ χρῶμα τοῦ λευκοῦ·", "seq": 3895}
{"id": "David_Passim_3896", "series": "CAG", "text": "οὕτω γὰρ κατηγοροῦνται καὶ τὰ μὴ δυνάμενα τῇ ἐπινοίᾳ ἢ τῇ ἐνεργείᾳ χωρισθῆναι.", "seq": 3896}
{"id": "David_Passim_3897", "series": "CAG", "text": "εἰ οὖν θεωρεῖται τὸ οὐσιῶδες, ὅπου οὐ θεωρεῖται ἡ οὐσία, ὁμολογουμένως οὐ ταὐτὸν οὐσιῶδες ὑπάρχει καὶ οὐσία.", "seq": 3897}
{"id": "David_Passim_3898", "series": "CAG", "text": "τοιούτῳ τρόπῳ διαφέρει καὶ τὸ ἐπουσιῶδες τοῦ συμβεβηκότος·", "seq": 3898}
{"id": "David_Passim_3899", "series": "CAG", "text": "τὸ γὰρ ἐπουσιῶδες οὐσίας κατηγορεῖται, τὸ συμβεβηκὸς δὲ οὐσίας οὐδέποτε κατηγορεῖται, εἰ μὴ ὅταν λέγωμεν ὅτι Σωκράτης λευκὸς ὑπάρχει καὶ νοῶμεν οὕτως ὅτι τὸ λευκὸν ὑπάρχει ἐν τῷ Σωκράτει, τότε κατηγορεῖται·", "seq": 3899}
{"id": "David_Passim_3900", "series": "CAG", "text": "ὅταν δὲ λέγωμεν ὅτι Σωκράτης λευκός ἐστι, τοῦτ᾿ ἔστιν ὅτι τὸν ὁρισμὸν τοῦ λευκοῦ δέχεται ὥσπερ τοῦ ζῴου, τότε οὐ κατηγορεῖται τὰ συμβεβηκότα τῶν οὐσιῶν καὶ κατὰ τοῦτον τὸν τρόπον εἶπε μὴ κατηγορεῖσθαι τὰ συμβεβηκότα τῶν οὐσιῶν.", "seq": 3900}
{"id": "David_Passim_3901", "series": "CAG", "text": "πῶς δὲ κατηγορεῖται τὸ ἐπουσιῶδες οὐσίας;", "seq": 3901}
{"id": "David_Passim_3902", "series": "CAG", "text": "ὡς ἵνα εἴπῃς τοῦ δούλου καὶ δεσπότου ὁ ἄνθρωπος κατηγορεῖται·", "seq": 3902}
{"id": "David_Passim_3903", "series": "CAG", "text": "ὡς γὰρ ἐν τῷ ἀνθρώπῳ τὸ ζῷον, οὕτω καὶ ἐν τῷ δεσπότῃ ὁ ἄνθρωπος·", "seq": 3903}
{"id": "David_Passim_3904", "series": "CAG", "text": "ὅπου γὰρ δεσπότης, ἐκεῖ καὶ ἄνθρωπος.", "seq": 3904}
{"id": "David_Passim_3905", "series": "CAG", "text": "οὐ τὴν αὐτὴν δέ φημι κατηγορίαν·", "seq": 3905}
{"id": "David_Passim_3906", "series": "CAG", "text": "ἡ μὲν γὰρ τοῦ ζῴου πρὸς τὸν ἄνθρωπον οὐσιώδης ἐστιν, ἡ δὲ τοῦ ἀνθρώπου πρὸς τὸν δεσπότην ἐπουσιώδης.", "seq": 3906}
{"id": "David_Passim_3907", "series": "CAG", "text": "εἰ οὖν θεωρεῖται τὸ ἐπουσιῶδες, ὅπου οὐ θεωρεῖται τὸ συμβεβηκός, ὡμολόγηται μὴ ταὐτὸν εἶναι ἐπουσιῶδες καὶ συμβεβηκός.", "seq": 3907}
{"id": "David_Passim_3908", "series": "CAG", "text": "Μαθόντες δὲ τούτων τὴν διαφορὰν φέρε χωρήσωμεν ἐπὶ τοὺς λόγους τοῦ φιλοσόφου·", "seq": 3908}
{"id": "David_Passim_3909", "series": "CAG", "text": "φησὶ γὰρ ὅτι διαφέρει ἡ ἰδιαίτατα τῆς κοινῶς καὶ ἰδίως, ὅτι αἱ μὲν ἔχουσι τὸ μᾶλλον καὶ ἧττον, λευκὸν καὶ λευκότερον, σιμὸν καὶ σιμώτερον, ἡ δὲ οὔ.", "seq": 3909}
{"id": "David_Passim_3910", "series": "CAG", "text": "κακῶς δὲ λέγει·", "seq": 3910}
{"id": "David_Passim_3911", "series": "CAG", "text": "δείκνυται γὰρ ὅτι αἱ μὲν οὐκ ἔχουσι τὸ μᾶλλον καὶ ἧττον, ἡ δὲ ἔχει·", "seq": 3911}
{"id": "David_Passim_3912", "series": "CAG", "text": "ἰδοὺ γὰρ ἡ μὲν κοινῶς οὐκ ἔχει τὸ μᾶλλον καὶ ἧττον, ὅταν εἴπωμεν τὸ τρίγωνον καὶ τὸ τετράγωνον ἐν κηρῷ εἶναι·", "seq": 3912}
{"id": "David_Passim_3913", "series": "CAG", "text": "καὶ γὰρ ὑπὸ τοῦ αὐτοῦ μετέχεται τό τε τρίγωνον καὶ τὸ τετράγωνον.", "seq": 3913}
{"id": "David_Passim_3914", "series": "CAG", "text": "ἐν τούτοις δὲ οὐ θεωρεῖται τὸ μᾶλλον καὶ ἧττον·", "seq": 3914}
{"id": "David_Passim_3915", "series": "CAG", "text": "οὔτε γάρ ἐστι τρίγωνον τριγώνου μᾶλλον καὶ ἧττον οὐδὲ ἔστι τετράγωνον τετραγώνου μᾶλλον καὶ ἧττον.", "seq": 3915}
{"id": "David_Passim_3916", "series": "CAG", "text": "ὥστε οὖν οὐ πάντοτε ἐν τῇ κοινῶς θεωρεῖται τὸ μᾶλλον καὶ ἧττον.", "seq": 3916}
{"id": "David_Passim_3917", "series": "CAG", "text": "ἀλλὰ μὴν οὐδὲ ἡ ἰδίως πάντοτε ἐπιδέχεται τὸ μᾶλλον καὶ ἧττον·", "seq": 3917}
{"id": "David_Passim_3918", "series": "CAG", "text": "ἰδοὺ γὰρ ὁ Ἀθηναῖος ἀχώριστόν ἐστι συμβεβηκός·", "seq": 3918}
{"id": "David_Passim_3919", "series": "CAG", "text": "Ἀθηναῖος δὲ Ἀθηναίου οὐκ ἔχει τὸ μᾶλλον καὶ ἧττον.", "seq": 3919}
{"id": "David_Passim_3920", "series": "CAG", "text": "ἡ ἰδιαίτατα δὲ ἔχει.", "seq": 3920}
{"id": "David_Passim_3921", "series": "CAG", "text": "πῶς δέ, λέξωμεν.", "seq": 3921}
{"id": "David_Passim_3922", "series": "CAG", "text": "ἡ ἰδιαίτατα σημαίνει οὐσίαν καὶ οὐσιῶδες, οὐσίαν μὲν ὡς ἵνα εἴπῃς τὸ λογικόν, οὐσιῶδες δὲ τὸ λευκόν·", "seq": 3922}
{"id": "David_Passim_3923", "series": "CAG", "text": "ἐμάθομεν δὲ πῶς διαφέρει οὐσία οὐσιώδους.", "seq": 3923}
{"id": "David_Passim_3924", "series": "CAG", "text": "εἰ οὖν ἡ ἰδιαίτατα λαμβάνεται ἐπὶ οὐσίας καὶ οὐσιώδους, τὸ δ᾿ οὐσιῶδες λαμβάνεται καὶ ἐπὶ τὸ συμβεβηκότος, δῆλον ὅτι θεωρεῖται καὶ ἐν τῇ ἰδιαίτατα τὸ μᾶλλον καὶ τὸ ἧττον·", "seq": 3924}
{"id": "David_Passim_3925", "series": "CAG", "text": "φαμὲν γὰρ τὸ λευκὸν καὶ ἄγαν λευκὸν καὶ ἧττον λευκόν·", "seq": 3925}
{"id": "David_Passim_3926", "series": "CAG", "text": "ἔφαμεν δὲ τοῦ λευκοῦ κατηγορεῖσθαι τὸ χρῶμα οὐσιωδῶς, λαμβάνεται δὲ ἐπὶ οὐσίας καὶ οὐσιώδους ἡ ἰδιαίτατα.", "seq": 3926}
{"id": "David_Passim_3927", "series": "CAG", "text": "δι᾿ ἣν δὲ αἰτίαν φησὶ δικαίως τὴν μὲν ἰδιαίτατα μὴ ἔχειν τὸ μᾶλλον καὶ ἧττον, τὴν δὲ κοινῶς καὶ ἰδίως ἔχειν, φέρε τὸν λόγον παραθήσομεν·", "seq": 3927}
{"id": "David_Passim_3928", "series": "CAG", "text": "φησὶν ὅτι ἡ ἰδιαίτατα δικαίως οὐκ ἔχει τὸ μᾶλλον καὶ ἧττον, ἐπειδὴ ἓν εἶδος δηλοῖ, ὅπερ χαρακτηριστικὸν ἡμῶν ὑπάρχει, οἷον τὸ λογικόν·", "seq": 3928}
{"id": "David_Passim_3929", "series": "CAG", "text": "ἓν δὲ καὶ τὸ αὐτὸ πῶς δύναται ἔχειν τὸ μᾶλλον καὶ ἧττον;", "seq": 3929}
{"id": "David_Passim_3930", "series": "CAG", "text": "εἰ γὰρ ἔχοι, ἀμείβεται.", "seq": 3930}
{"id": "David_Passim_3931", "series": "CAG", "text": "λογικὸν δὲ λέγει τὸ οὐσιωδῶς ἑκάστῳ ὑπάρχον ὡσαύτως.", "seq": 3931}
{"id": "David_Passim_3932", "series": "CAG", "text": "εἰ δὲ καὶ εἴποι τις ὅτι λέγομεν λογικώτερον, φαμὲν ὅτι ἐπιστήμης ἐστὶ καὶ μαθήσεως τὸ δεχόμενον τὸ μᾶλλον καὶ ἧττον.", "seq": 3932}
{"id": "David_Passim_3933", "series": "CAG", "text": "ἄλλως δὲ ἔστιν ἐλέγξαι αὐτόν·", "seq": 3933}
{"id": "David_Passim_3934", "series": "CAG", "text": "φαμὲν γὰρ ὅτι κατὰ τοῦτον τὸν λόγον οὐδεμία αὐτῶν ἔχει τὸ μᾶλλον καὶ ἧττον·", "seq": 3934}
{"id": "David_Passim_3935", "series": "CAG", "text": "εἰ γὰρ διὰ τὸ εἶναι ἓν εἶδος τὸ λογικὸν οὐκ ἐπιδέχεται τὸ μᾶλλον καὶ ἧττον, οὐδὲ ἡ κοινῶς ὀφείλει δέχεσθαι οὔτε ἡ ἰδίως·", "seq": 3935}
{"id": "David_Passim_3936", "series": "CAG", "text": "τὸ γὰρ λευκὸν τὸ ἐν τῷ λευκῷ σώματι εἶδός ἐστι τοῦ λευκοῦ σώματος, καὶ οὐκ ἔστιν ἐπινοῆσαι τὸ λευκὸν σῶμα ἐκτὸς τῆς λευκότητος.", "seq": 3936}
{"id": "David_Passim_3937", "series": "CAG", "text": "ἓν δὲ τὸ εἶδός ἐστι τὸ λευκὸν τοῦ λευκοῦ σώματος, καὶ πρὸς μὲν τὸ λευκὸν σῶμα εἶδός ἐστι τὸ λευκόν, πρὸς δὲ τὸ ἁπλῶς οὐκέτι.", "seq": 3937}
{"id": "David_Passim_3938", "series": "CAG", "text": "οὐκ ὀφείλει οὖν τὸ λευκὸν τοῦ λευκοῦ σώματος ἓν εἶδος ὑπάρχον δέχεσθαι τὸ μᾶλλον καὶ ἧττον.", "seq": 3938}
{"id": "David_Passim_3939", "series": "CAG", "text": "οὔτε μὴν τὸ μέλαν τοῦ Αἰθίοπος·", "seq": 3939}
{"id": "David_Passim_3940", "series": "CAG", "text": "πρὸς μὲν γὰρ τὸν ἄνθρωπον εἶδος οὐκ ἔστι, πρὸς δὲ τὸν Αἰθίοπα εἶδός ἐστιν·", "seq": 3940}
{"id": "David_Passim_3941", "series": "CAG", "text": "οὐκ ἔστι γὰρ ἐπινοῆσαι Αἰθίοπα μέλανος χωρίς.", "seq": 3941}
{"id": "David_Passim_3942", "series": "CAG", "text": "εἰ οὖν καὶ τὸ μέλαν τοῦ Αἰθίοπος εἶδος αὐτοῦ ὑπάρχει, οὐκ ὀφείλει ἐπιδέχεσθαι τὸ μᾶλλον καὶ ἧττον·", "seq": 3942}
{"id": "David_Passim_3943", "series": "CAG", "text": "ὃν γὰρ τρόπον τοῦ ἀνθρώπου εἶδός φησιν εἶναι τὸ λογικόν, τοῦτον τὸν τρόπον καὶ τοῦ Αἰθίοπος εἶδός ἐστι τὸ μέλαν καὶ τοῦ γάλακτος τὸ λευκόν.", "seq": 3943}
{"id": "David_Passim_3944", "series": "CAG", "text": "καὶ εἰ τὸ αὐτὸ λέγεις εἶναι τὸ λογικὸν καὶ μὴ ἀμείβεσθαι τῇ τοῦ μείζονος καὶ ἥττονος προσελεύσει, κἀγὼ τὸ τοιοῦτον λέξω ἐπὶ τοῦ μέλανος τοῦ μέλανος σώματος καὶ ἐπὶ τοῦ λευκοῦ τοῦ λευκοῦ σώματος·", "seq": 3944}
{"id": "David_Passim_3945", "series": "CAG", "text": "δεῖ γὰρ τὸ λευκὸν οὗ ἐστι λευκὸν ὡσαύτως ἔχειν.", "seq": 3945}
{"id": "David_Passim_3946", "series": "CAG", "text": "ὥστε οὖν ὑπόψυχρός ἐστιν ὁ τοιοῦτος λόγος.", "seq": 3946}
{"id": "David_Passim_3947", "series": "CAG", "text": "τί οὖν ἡμεῖς λέγομεν;", "seq": 3947}
{"id": "David_Passim_3948", "series": "CAG", "text": "φαμὲν ὅτι οὕτως δεῖ λέγειν·", "seq": 3948}
{"id": "David_Passim_3949", "series": "CAG", "text": "εἰ μὲν ἀπλατὲς σημαίνει ἡ διαφορά, τότε οὐκ ἐπιδέχεται τὸ μᾶλλον καὶ ἧττον·", "seq": 3949}
{"id": "David_Passim_3950", "series": "CAG", "text": "οἷον τὸ τρίγωνον καὶ τὸ τετράγωνον ἀπλατῆ εἰσι, διὰ τοῦτο οὐκ ἐπιδέχονται τὸ μᾶλλον καὶ ἧττον.", "seq": 3950}
{"id": "David_Passim_3951", "series": "CAG", "text": "ὁ Ἀθηναῖος πάλιν ἀπλατής ἐστιν (οὔτε γάρ ἐστι μείζων Ἀθηναῖος ἢ ἥττων), διὰ τοῦτο τὸ μᾶλλον καὶ ἧττον οὐκ ἐπιδέχεται.", "seq": 3951}
{"id": "David_Passim_3952", "series": "CAG", "text": "τὸ λογικὸν πάλιν ὡσαύτως ἔχον οὐκ ἐπιδέχεται τὸ μᾶλλον καὶ ἧττον.", "seq": 3952}
{"id": "David_Passim_3953", "series": "CAG", "text": "εἰ δὲ πλάτος σημαίνει, τότε ἐπιδέχεται τὸ μᾶλλον καὶ ἧττον·", "seq": 3953}
{"id": "David_Passim_3954", "series": "CAG", "text": "οἷον τὸ λευκὸν δύναται καὶ ἄγαν εἶναι καὶ ἔλαττον, διὰ τοῦτο ἐπιδέχεται τὸ μᾶλλον καὶ ἧττον, ἡ σιμότης ἐν πλάτει οὖσα (δύναται γὰρ ἄγαν εἶναι καὶ ἔλαττον), δέχεται τὸ μᾶλλον καὶ ἧττον.", "seq": 3954}
{"id": "David_Passim_3955", "series": "CAG", "text": "ὁμοίως δὲ εἰ καὶ τοῦ λευκοῦ οὐσιωδῶς κατηγορεῖται τὸ χρῶμα, ἐπιδέχεται τὸ μᾶλλον καὶ τὸ ἧττον ἐν πλάτει ὑπάρχον.", "seq": 3955}
{"id": "David_Passim_3956", "series": "CAG", "text": "Δεύτερόν φησιν ὅτι διαφέρει ἡ ἰδιαίτατα τῆς κοινῶς καὶ ἰδίως, ὅτι αἱ μὲν εἰς ὑπογραφὰς λαμβάνονται, ἡ δὲ εἰς ὁρισμούς.", "seq": 3956}
{"id": "David_Passim_3957", "series": "CAG", "text": "τοῦτο ἀληθές.", "seq": 3957}
{"id": "David_Passim_3958", "series": "CAG", "text": "σκόπει δὲ πῶς δηλοῖ ὧδε τὴν ἰδιαίτατα·", "seq": 3958}
{"id": "David_Passim_3959", "series": "CAG", "text": "δηλοῖ οὖν καὶ οὐσίαν καὶ οὐσιῶδες καὶ τοῦτο τὸ οὐσιῶδες ἐπὶ συμβεβηκότων λαμβάνεσθαι·", "seq": 3959}
{"id": "David_Passim_3960", "series": "CAG", "text": "ἐν γὰρ τῷ λέγειν εἰς ὁρισμοὺς λαμβάνεσθαι δηλοῖ ὅτι καὶ ἐπὶ συμβεβηκότων λαμβάνεται τὸ οὐσιῶδες·", "seq": 3960}
{"id": "David_Passim_3961", "series": "CAG", "text": "ὁρίζομεν γὰρ καὶ τὰ συμβεβηκότα, οἱ δὲ ὁρισμοὶ ἐξ οὐσιωδῶν φωνῶν σύγκεινται.", "seq": 3961}
{"id": "David_Passim_3962", "series": "CAG", "text": "πρόδηλον οὖν ὅτι καὶ αἱ φωναὶ ἐπὶ τῶν ὁρισμῶν τῶν συμβεβηκότων οὐσιώδεις εἰσί·", "seq": 3962}
{"id": "David_Passim_3963", "series": "CAG", "text": "λευκόν ἐστι χρῶμα διακριτικὸν ὄψεως.", "seq": 3963}
{"id": "David_Passim_3964", "series": "CAG", "text": "τρίτον φησὶν ὅτι διαφέρει ἡ ἰδιαίτατα τῆς κοινῶς καὶ ἰδίως, ὅτι αἱ μὲν ἀλλοῖον ποιοῦσιν, ἡ δὲ ἄλλο.", "seq": 3964}
{"id": "David_Passim_3965", "series": "CAG", "text": "τοῦτο δὲ ἤδη ἐγνώκαμεν καὶ ἐν τῇ προτεραίᾳ.", "seq": 3965}
{"id": "David_Passim_3966", "series": "CAG", "text": "ἀληθὲς δὲ καὶ τοῦτο λέγει.", "seq": 3966}
{"id": "David_Passim_3967", "series": "CAG", "text": "Πρᾶξις κε΄.", "seq": 3967}
{"id": "David_Passim_3968", "series": "CAG", "text": "Εἰρηκότες κατὰ τί διαφέρουσιν ἀλλήλων αἱ διαφοραί, λέξωμεν καὶ τί διαφέρει πρὸς ἑαυτὴν ἡ ἰδιαίτατα δηλοῦσα τὰς συστατικὰς καὶ τὰς διαιρετικάς.", "seq": 3968}
{"id": "David_Passim_3969", "series": "CAG", "text": "φασί τινες τὰς αὐτὰς εἶναι.", "seq": 3969}
{"id": "David_Passim_3970", "series": "CAG", "text": "ὅτι δὲ οὐχ αἱ αὐταί εἰσι, σαφὲς ἐκ τῶν λεχθησομένων.", "seq": 3970}
{"id": "David_Passim_3971", "series": "CAG", "text": "τῶν γενικωτάτων γενῶν οὔκ εἰσι συστατικαὶ διαφοραί, μόναι δὲ διαιρετικαί, πάλιν τῶν εἰδικωτάτων εἰδῶν οὔκ εἰσι διαιρετικαὶ διαφοραί, συστατικαὶ δὲ μόναι·", "seq": 3971}
{"id": "David_Passim_3972", "series": "CAG", "text": "εἰ ἦσαν τοίνυν αἱ αὐταί, ὤφειλε τὸ πρῶτον σκέλος θεωρεῖσθαι, ὅπου καὶ τὸ ἕτερον·", "seq": 3972}
{"id": "David_Passim_3973", "series": "CAG", "text": "εἰ δὲ οὐ θεωρεῖται, σαφὲς ὅτι οὔκ εἰσιν αἱ αὐταί.", "seq": 3973}
{"id": "David_Passim_3974", "series": "CAG", "text": "ἔχομεν ἐντεῦθεν δύο προσπορίσματα·", "seq": 3974}
{"id": "David_Passim_3975", "series": "CAG", "text": "ὅτι οὔτε τὰ γενικώτατα γένη ὁρίζεται μὴ ἔχοντα συστατικὰς διαφορὰς τῶν ὁρισμῶν ἐκ γένους ὄντων καὶ συστατικῶν διαφορῶν καὶ ὅτι κατὰ τοῦτον τὸν λόγον οὐ διαιρεῖται τὰ εἰδικώτατα εἴδη μὴ ἔχοντα διαιρετικὰς φωνάς·", "seq": 3975}
{"id": "David_Passim_3976", "series": "CAG", "text": "οὕτως γὰρ καὶ ὁ Πλάτων ἐβούλετο.", "seq": 3976}
{"id": "David_Passim_3977", "series": "CAG", "text": "δεύτερον ὅτι αἱ διαιρετικαὶ φωναὶ μόνων γενῶν εἰσιν, οὐκέτι δὲ καὶ εἰδῶν, αἱ δὲ συστατικαὶ μόνων εἰδῶν, οὐκέτι δὲ καὶ γενῶν·", "seq": 3977}
{"id": "David_Passim_3978", "series": "CAG", "text": "εἰ γὰρ εἴπῃς ὅτι καὶ γένους εἰσὶν αἱ συστατικαί, ὤφειλον εἶναι καὶ παντὸς γένους·", "seq": 3978}
{"id": "David_Passim_3979", "series": "CAG", "text": "τὸ γὰρ τῷ αὐτῷ ὁμοειδεῖ οὐσιωδῶς ὑπάρχον καὶ πᾶσι τοῖς ὁμοίοις οὐσιωδῶς ὑπάρχει·", "seq": 3979}
{"id": "David_Passim_3980", "series": "CAG", "text": "εἰ οὖν γένους εἰσὶν αἱ συστατικαί, ὤφειλον εἶναι καὶ παντὸς γένους·", "seq": 3980}
{"id": "David_Passim_3981", "series": "CAG", "text": "εἰ δὲ οὔκ εἰσι (τῶν γὰρ γενικωτάτων οὔκ εἰσι συστατικαί), ὁμολογουμένως οὐχ αἱ αὐταί εἰσι διαιρετικαὶ καὶ συστατικαί.", "seq": 3981}
{"id": "David_Passim_3982", "series": "CAG", "text": "καὶ ἐκ τοῦ ἐναντίου ἔστιν ἀντιστρέψαι τὸν λόγον καὶ εἰπεῖν ταὐτὸν ἐπὶ τῶν διαιρετικῶν·", "seq": 3982}
{"id": "David_Passim_3983", "series": "CAG", "text": "εἴ εἰσιν αἱ διαιρετικαὶ εἴδους, ὤφειλον εἶναι καὶ παντὸς εἴδους·", "seq": 3983}
{"id": "David_Passim_3984", "series": "CAG", "text": "εἰ δὲ οὔκ εἰσι (τὰ γὰρ εἰδικώτατα διαιρετικὰς οὐκ ἔχουσιν), ὁμολογομένως οὔκ εἰσιν αἱ αὐταὶ ἐπὶ τοῦ αὐτοῦ κωλυόμεναι λαμβάνεσθαι.", "seq": 3984}
{"id": "David_Passim_3985", "series": "CAG", "text": "τρίτον καὶ σαφὲς ὅτι οὐχ αἱ αὐταί εἰσιν, ὅτι ἐπὶ μὲν τοῦ ζῴου συστατικαί εἰσιν ἡ οὐσία ἔμψυχος αἰσθητική, διαιρετικαὶ δέ εἰσι τὸ λογικὸν καὶ ἄλογον.", "seq": 3985}
{"id": "David_Passim_3986", "series": "CAG", "text": "τέταρτον εἰ καὶ αἱ αὐταί εἰσι (πάντως γὰρ αἱ συστατικαὶ ἀπὸ τῶν διαιρετικῶν γίνονται), ἀλλ᾿ οὖν ὅμως οὐκ ἐπὶ τοῦ αὐτοῦ λαμβάνονται·", "seq": 3986}
{"id": "David_Passim_3987", "series": "CAG", "text": "τοῦ γὰρ ζῴου διαιρετικάς φαμεν τὸ λογικὸν καὶ τὸ θνητόν, τοῦ δ᾿ ἀνθρώπου συστατικάς.", "seq": 3987}
{"id": "David_Passim_3988", "series": "CAG", "text": "πέμπτον αἱ συστατικαὶ καθολικώτεραί εἰσι, αἱ δὲ διαιρετικαὶ μερικώτεραι.", "seq": 3988}
{"id": "David_Passim_3989", "series": "CAG", "text": "ὅτι δὲ αἱ συστατικαὶ καθολικώτεραί εἰσι, σαφὲς ἐκ τοῦ ἀποτέμνειν ἡμᾶς αὐτὰς διὰ τὸ ἐπὶ πλέον διήκειν, οὗ εἰσι συστατικαί·", "seq": 3989}
{"id": "David_Passim_3990", "series": "CAG", "text": "ἰδοὺ γάρ φαμεν τὸ ζῷον οὐσίαν ἔμψυχον αἰσθητικήν·", "seq": 3990}
{"id": "David_Passim_3991", "series": "CAG", "text": "διότι ἐπὶ πλέον τοῦ ζῴου διήκει τὸ ἔμψυχον, ἀποτέμνομεν [δὲ] αὐτὸ διὰ τοῦ αἰσθητικοῦ, καὶ διότι πάλιν τὸ αἰσθητικὸν διήκει ἐπὶ πλέον, φαμὲν αὐτοκίνητον.", "seq": 3991}
{"id": "David_Passim_3992", "series": "CAG", "text": "ὅτι δὲ μερικώτεραί εἰσιν αἱ διαιρετικαί, σαφὲς ἐκ τοῦ διαιρεῖν τὸ ἓν εἰς πολλά, οἷον τὸ ζῷον εἰς λογικὸν καὶ ἄλογον.", "seq": 3992}
{"id": "David_Passim_3993", "series": "CAG", "text": "ἕκτον αἱ διαιρετικαὶ φθορᾶς ποιητικαί εἰσι, αἱ δὲ συστατικαὶ συστάσεως·", "seq": 3993}
{"id": "David_Passim_3994", "series": "CAG", "text": "αἱ μὲν γὰρ τὸ ζῷον διαιροῦσαι τὸ ἓν διαφθείρουσι, λέγω δὲ τὸ ζῷον, αἱ δὲ τὸν ἄνθρωπον συνιστῶσιν.", "seq": 3994}
{"id": "David_Passim_3995", "series": "CAG", "text": "ἕβδομον αἱ μὲν διαιρετικαὶ ἐν τοῖς ἀντικειμένοις θεωροῦνται, τὸ λογικὸν καὶ ἄλογον, αἱ δὲ συστατικαὶ οὐκέτι·", "seq": 3995}
{"id": "David_Passim_3996", "series": "CAG", "text": "οὐδεὶς γάρ φησι τὸν ἄνθρωπον ζῷον λογικὸν καὶ ἄλογον.", "seq": 3996}
{"id": "David_Passim_3997", "series": "CAG", "text": "διὰ τοῦτο ἐπιμέμφονταί τινες τῷ ὅρῳ τῆς ἰατρικῆς φάσκοντες αὐτὴν ἐξ ἀντικειμένων συγκεκροτῆσθαι·", "seq": 3997}
{"id": "David_Passim_3998", "series": "CAG", "text": "ἰατρική ἐστι γνῶσις ὑγιεινῶν καὶ νοσερῶν καὶ οὐδετέρων.", "seq": 3998}
{"id": "David_Passim_3999", "series": "CAG", "text": "ἀλλὰ μὴν καὶ τῷ ὅρῳ τῆς φύσεως τὴν αὐτὴν ἔγκλησιν διὰ τὸ λεχθὲν ἐπάγουσι·", "seq": 3999}
{"id": "David_Passim_4000", "series": "CAG", "text": "φύσις ἐστὶν ἀρχὴ κινήσεως καὶ ἠρεμίας.", "seq": 4000}
{"id": "David_Passim_4001", "series": "CAG", "text": "καὶ περὶ μὲν τοῦ ὅρου τῆς ἰατρικῆς ἄλλοις φροντὶς γενέσθω, περὶ δὲ τοῦ ὅρου τῆς φύσεως δεῖ λέγειν ὅτι οὔκ εἰσιν αἱ διαιρέσεις ἀντικείμεναι·", "seq": 4001}
{"id": "David_Passim_4002", "series": "CAG", "text": "οὔτε γάρ φησιν ὡς ἡ φύσις ἠρεμία ἐστὶ καὶ κίνησις, ἀλλ᾿ ἀρχὴ ἠρεμίας καὶ κινήσεως.", "seq": 4002}
{"id": "David_Passim_4003", "series": "CAG", "text": "Ἰστέον δ᾿ ὡς ὁ Πορφύριος αὐτὰς ἑνὶ ὀνόματι προσαγορεύει·", "seq": 4003}
{"id": "David_Passim_4004", "series": "CAG", "text": "συστατικὰς γὰρ καλεῖ αὐτὰς ἐκ τοῦ τιμιωτέρου τὴν προσηγορίαν αὐταῖς ἐφαρμόσας·", "seq": 4004}
{"id": "David_Passim_4005", "series": "CAG", "text": "ὅτι γὰρ αἱ συστατικαὶ τιμιώτεραί εἰσι τῶν διαιρετικῶν, σαφὲς ἐντεῦθεν·", "seq": 4005}
{"id": "David_Passim_4006", "series": "CAG", "text": "πρῶτον αἱ μὲν συστατικαὶ καθολικώτεραί εἰσιν, αἱ δὲ διαιρετικαὶ μερικώτεραι·", "seq": 4006}
{"id": "David_Passim_4007", "series": "CAG", "text": "τιμιώτερον δὲ τὸ καθολικὸν τοῦ μερικοῦ.", "seq": 4007}
{"id": "David_Passim_4008", "series": "CAG", "text": "δεύτερον αἱ μὲν φθορὰν ποιοῦσιν, αἱ δὲ σύστασιν.", "seq": 4008}
{"id": "David_Passim_4009", "series": "CAG", "text": "ὅσον δὲ τὸ αἰτιατόν τινος αἰτιατοῦ ἐστι κρεῖττον, τοσοῦτον καὶ τὸ αἴτιον τοῦ αἰτίου.", "seq": 4009}
{"id": "David_Passim_4010", "series": "CAG", "text": "εἰ οὖν ἡ σύστασις τῆς φθορᾶς κρείττων καθέστηκεν, αἴτιαι δὲ τῆς συστάσεως αἱ συστατικαὶ <τῆς δὲ φθορᾶς αἱ διαιρετικαί, αἱ συστατικαὶ> ὁμολογουμένως κρείττονες τῶν διαιρετικῶν καθεστήκασι.", "seq": 4010}
{"id": "David_Passim_4011", "series": "CAG", "text": "τρίτον αἱ μὲν διαιρετικαὶ δυνάμει εἰσίν, αἱ δὲ συστατικαὶ ἐνεργείᾳ.", "seq": 4011}
{"id": "David_Passim_4012", "series": "CAG", "text": "εἰσὶ δὲ δυνάμει αἱ διαιρετικαί, ὡς ἵνα εἴπῃς ὅτι τὸ ζῷον δύναται καὶ λογικὸν εἶναι καὶ ἄλογον, ἐνεργείᾳ δὲ αἱ συστατικαί, ὡς ἵνα εἴπῃς ὁ ἄνθρωπος ζῷον λογικὸν θνητόν·", "seq": 4012}
{"id": "David_Passim_4013", "series": "CAG", "text": "πάντως γὰρ ὁ ἄνθρωπος ζῷόν ἐστι λογικόν.", "seq": 4013}
{"id": "David_Passim_4014", "series": "CAG", "text": "εἰ οὖν κρεῖττόν ἐστι τὸ ἐνεργείᾳ τοῦ δυνάμει, ὁμολογεῖται κρείττονας εἶναι τὰς συστατικὰς τῶν διαιρετικῶν.", "seq": 4014}
{"id": "David_Passim_4015", "series": "CAG", "text": "Πρᾶξις κς΄.", "seq": 4015}
{"id": "David_Passim_4016", "series": "CAG", "text": "9.", "seq": 4016}
{"id": "David_Passim_4017", "series": "CAG", "text": "7 Ἄνωθεν οὖν πάλιν ἀρχομένῳ.", "seq": 4017}
{"id": "David_Passim_4018", "series": "CAG", "text": "Ἐν τῷ λέγειν ἄνωθεν ἀρχομένῳ δηλοῖ ἑτέραν διαίρεσιν·", "seq": 4018}
{"id": "David_Passim_4019", "series": "CAG", "text": "ἄρτι γὰρ εἰς χωριστὰ καὶ ἀχώριστα ποιεῖται τὴν διαίρεσιν, ὡς ἤδη εἰρήκαμεν ἐν τῇ θεωρίᾳ.", "seq": 4019}
{"id": "David_Passim_4020", "series": "CAG", "text": "9.", "seq": 4020}
{"id": "David_Passim_4021", "series": "CAG", "text": "8 Τὸ μὲν γὰρ κινεῖσθαι.", "seq": 4021}
{"id": "David_Passim_4022", "series": "CAG", "text": "Τινὲς ἐπιλαμβάνονται τοῦ φιλοσόφου λέγοντες ὅτι οὐ πᾶσα κίνησις χωριστή ἐστιν·", "seq": 4022}
{"id": "David_Passim_4023", "series": "CAG", "text": "ἰδοὺ γὰρ ἡ οὐρανία ἀχώριστος ὑπάρχει·", "seq": 4023}
{"id": "David_Passim_4024", "series": "CAG", "text": "ἀεὶ γὰρ ὁ πόλος κινεῖται.", "seq": 4024}
{"id": "David_Passim_4025", "series": "CAG", "text": "ἔστι δὲ πρὸς τούτους εἰπεῖν ὅτι οὐκ εἰρηκὼς τὸ κινεῖσθαι δηλοῖ πᾶσαν κίνησιν·", "seq": 4025}
{"id": "David_Passim_4026", "series": "CAG", "text": "εἴρηται γὰρ Ἀριστοτέλει ὅτι τὸ ἀπροσδιορίστως λεγόμενον ἰσοδυναμεῖ τινι μερικῷ, οἷον ἐὰν εἴπω ὅτι ἄνθρωπος λούεται, οὐ πάντα ἄνθρωπον λέγω λούεσθαι ἀλλ᾿ ἕνα, ἀπροσδιορίστως δέ.", "seq": 4026}
{"id": "David_Passim_4027", "series": "CAG", "text": "οὕτω δὲ καὶ ἐνταῦθα τὸ κινεῖσθαι λέγων ὁ Πορφύριος οὐ πᾶσαν φύσιν κινεῖσθαι ἐδήλωσεν, ἀλλά τινα ἀπροσδιόριστον.", "seq": 4027}
{"id": "David_Passim_4028", "series": "CAG", "text": "ἔστι δέ τις κίνησις χωριστή, ἡ τῇ ἠρεμίᾳ παυομένη.", "seq": 4028}
{"id": "David_Passim_4029", "series": "CAG", "text": "διὰ τί δὲ ἐπὶ τῶν οὐρανίων μόνων ἔλεγον τὴν διαστολήν, οὐσῶν καὶ ἄλλων ἐν ἡμῖν ἀχωρίστων κινήσεων;", "seq": 4029}
{"id": "David_Passim_4030", "series": "CAG", "text": "ἰδοὺ γὰρ ἡ ἐμψυχία ἀχώριστος ὑπάρχει κίνησις.", "seq": 4030}
{"id": "David_Passim_4031", "series": "CAG", "text": "καὶ εἰ τοῦτο ἀσαφὲς ὑπάρχει, ἐκ τοῦ θρυλλουμένου παραστήσομαι, φημὶ δὲ ἐκ τῶν ζωτικῶν κινήσεων, ὧν χωρὶς εἶναι οὐ δυνάμεθα.", "seq": 4031}
{"id": "David_Passim_4032", "series": "CAG", "text": "ὥστε οὖν οὐ τὴν δέουσαν διαστολὴν ἔγνωσαν οἱ ἐπιλαμβανόμενοι τοῦ φιλοσόφου, οὐδὲ τὸν Ἀριστοτελικὸν λόγον, φημὶ δὴ τὸν λέγοντα ‘τὸ ἀπροσδιόριστον ἰσοδυναμεῖ τινι μερικῷ’.", "seq": 4032}
{"id": "David_Passim_4033", "series": "CAG", "text": "9.", "seq": 4033}
{"id": "David_Passim_4034", "series": "CAG", "text": "10 Τῶν δὲ ἀχωρίστων αἱ μὲν ὑπάρχουσι καθ᾿ ἑαυτάς, αἱ δὲ κατὰ συμβεβηκός.", "seq": 4034}
{"id": "David_Passim_4035", "series": "CAG", "text": "Τὸ ἀχώριστον διαιρεῖ εἰς συμβεβηκὸς καὶ οὐσίαν, καὶ ἐν μὲν τῷ λέγειν καθ᾿ ἑαυτάς δηλοῖ τὰς οὐσιώδεις (οὕτω γὰρ καὶ ὁ Ἀριστοτέλης·", "seq": 4035}
{"id": "David_Passim_4036", "series": "CAG", "text": "τοῦτο γὰρ δηλοῖ τὸ αὐθυπόστατον), ἐν δὲ τῷ λέγειν κατὰ συμβεβηκός ῥᾷστα τὰ συμβεβηκότα δηλοῖ, ἅτινα καθ᾿ ἑαυτὰ μὲν οὔκ εἰσιν, ἐν ἑτέρῳ δέ.", "seq": 4036}
{"id": "David_Passim_4037", "series": "CAG", "text": "9.", "seq": 4037}
{"id": "David_Passim_4038", "series": "CAG", "text": "12 Καὶ τὸ ἐπιστήμης εἶναι δεκτικόν.", "seq": 4038}
{"id": "David_Passim_4039", "series": "CAG", "text": "Καλῶς εἶπε δεκτικόν·", "seq": 4039}
{"id": "David_Passim_4040", "series": "CAG", "text": "κἂν γὰρ ᾖ τις ἐπιστήμων κἄν τε μή, ἄνθρωπος ἀκούσει ἔχων τὸ δεκτικόν.", "seq": 4040}
{"id": "David_Passim_4041", "series": "CAG", "text": "9.", "seq": 4041}
{"id": "David_Passim_4042", "series": "CAG", "text": "15 Αἱ δὲ κατὰ συμβεβηκὸς οὔτε ἐν τῷ τῆς οὐσίας λόγῳ λέγονται οὔτε ποιοῦσιν ἄλλο.", "seq": 4042}
{"id": "David_Passim_4043", "series": "CAG", "text": "Σκόπει πῶς ἐξήνεγκεν ἀσφαλῶς τὸν λόγον·", "seq": 4043}
{"id": "David_Passim_4044", "series": "CAG", "text": "ἐπὶ μὲν γὰρ τῶν οὐσιωδῶν τῶν λαμβανομένων εἰς ὁρισμοὺς καὶ ὑπογραφὰς οὐκ ἐζήτησεν εἰπεῖν ὅτι μόνῳ τῷ λόγῳ τῆς οὐσίας λαμβάνονται, ἵνα δείξῃ ὅτι καὶ ὑπογραφαῖς ἐπιτήδειοί εἰσι καὶ ὁρισμοῖς, ἐπὶ δὲ τῶν συμβεβηκυιῶν τῶν μὴ λαμβανομένων λόγῳ οὐσίας ἀλλὰ μόνης ὑπογραφῆς, ἵνα δείξῃ ὅτι μόναις ὑπογραφαῖς ἐπιτήδειοί εἰσιν, εἶπεν οὔτε ποιοῦσιν ἄλλο ἀλλὰ ἀλλοῖον, οὔτε οὐσίας λόγῳ λαμβάνονται.", "seq": 4044}
{"id": "David_Passim_4045", "series": "CAG", "text": "9.", "seq": 4045}
{"id": "David_Passim_4046", "series": "CAG", "text": "16 Καὶ αἱ μὲν καθ᾿ ἑαυτὰς οὐκ ἐπιδέχονται τὸ μᾶλλον καὶ τὸ ἧττον.", "seq": 4046}
{"id": "David_Passim_4047", "series": "CAG", "text": "Ὑπὲρ τούτου οὐκ ὀλίγα ἐν τῇ θεωρίᾳ κατεβαλόμεθα.", "seq": 4047}
{"id": "David_Passim_4048", "series": "CAG", "text": "9.", "seq": 4048}
{"id": "David_Passim_4049", "series": "CAG", "text": "17 Αἱ δὲ κατὰ συμβεβηκός, κἂν ἀχώριστοι ὦσιν.", "seq": 4049}
{"id": "David_Passim_4050", "series": "CAG", "text": "Ἐκ τοῦ μᾶλλον ἐπεχείρησεν·", "seq": 4050}
{"id": "David_Passim_4051", "series": "CAG", "text": "εἰ γὰρ αἱ ἀχώριστοι τὸ μᾶλλον καὶ ἧττον ἐπιδέχονται, πολλῷ μᾶλλον καὶ αἱ χωρισταί.", "seq": 4051}
{"id": "David_Passim_4052", "series": "CAG", "text": "9.", "seq": 4052}
{"id": "David_Passim_4053", "series": "CAG", "text": "18 Ἐπίτασιν καὶ ἄνεσιν.", "seq": 4053}
{"id": "David_Passim_4054", "series": "CAG", "text": "Καλῶς ἐχρήσατο τοῖς ὀνόμασιν·", "seq": 4054}
{"id": "David_Passim_4055", "series": "CAG", "text": "ἐν μὲν γὰρ τῷ ἐπίτασιν δηλοῖ τὸ μᾶλλον, ἐν δὲ τῷ ἄνεσιν τὸ ἧττον.", "seq": 4055}
{"id": "David_Passim_4056", "series": "CAG", "text": "9.", "seq": 4056}
{"id": "David_Passim_4057", "series": "CAG", "text": "18 Οὔτε γὰρ τὸ γένος μᾶλλον καὶ ἧττον κατηγορεῖται, οὗ ἂν ᾖ γένος, οὔθ᾿ αἱ τοῦ γένους διαφοραί.", "seq": 4057}
{"id": "David_Passim_4058", "series": "CAG", "text": "Φησὶν ὅτι τὸ ζῷον οὐκ ἔστι μᾶλλον ἵππου ἤπερ ἀνθρώπου οὔτε τὸ λογικόν, ὃ λέγεται οὐσιῶδες, μᾶλλόν ἐστι Σωκράτους ἤπερ Πλάτωνος.", "seq": 4058}
{"id": "David_Passim_4059", "series": "CAG", "text": "διὰ τοῦτο τὸ μᾶλλον καὶ ἧττον οὐκ ἐπιδέχονται.", "seq": 4059}
{"id": "David_Passim_4060", "series": "CAG", "text": "9.", "seq": 4060}
{"id": "David_Passim_4061", "series": "CAG", "text": "20 Αἱ τὸν ἑκάστου λόγον συμπληροῦσαι.", "seq": 4061}
{"id": "David_Passim_4062", "series": "CAG", "text": "Τοῦτ᾿ ἔστι τὴν φύσιν καὶ τὸν ὁρισμόν.", "seq": 4062}
{"id": "David_Passim_4063", "series": "CAG", "text": "9.", "seq": 4063}
{"id": "David_Passim_4064", "series": "CAG", "text": "21 Τὸ δὲ εἶναι ἑκάστῳ ἓν καὶ τὸ αὐτὸ οὔτε ἐπίτασιν οὔτε ἄνεσιν ἐπιδεχόμενόν ἐστι.", "seq": 4064}
{"id": "David_Passim_4065", "series": "CAG", "text": "Εἴπομεν ὅτι τούτῳ τῷ λόγῳ καὶ τὸ λευκόν, οὗ ἐστι λευκόν, καὶ μόνον εἶδος ὑπάρχον, οὐκ ὀφείλει τὸ μᾶλλον καὶ ἧττον ἐπιδέχεσθαι.", "seq": 4065}
{"id": "David_Passim_4066", "series": "CAG", "text": "τί δέ ἐστι τὸ αἴτιον;", "seq": 4066}
{"id": "David_Passim_4067", "series": "CAG", "text": "τὸ ἀπλατὲς καὶ τὸ ἐν πλάτει θεωρούμενον.", "seq": 4067}
{"id": "David_Passim_4068", "series": "CAG", "text": "9.", "seq": 4068}
{"id": "David_Passim_4069", "series": "CAG", "text": "22 Ἢ κεχρῶσθαί πως.", "seq": 4069}
{"id": "David_Passim_4070", "series": "CAG", "text": "Τοῦτ᾿ ἔστι χρῶμα ἐμφαίνειν ἢ τὸ ξανθὸν ἢ τὸ λευκὸν ἤ τι τοιοῦτον.", "seq": 4070}
{"id": "David_Passim_4071", "series": "CAG", "text": "10.", "seq": 4071}
{"id": "David_Passim_4072", "series": "CAG", "text": "2 Αἱ δὲ καθ᾿ ἃς τὰ διαιρεθέντα εἰδοποιεῖται.", "seq": 4072}
{"id": "David_Passim_4073", "series": "CAG", "text": "Τοῦτ᾿ ἔστιν αἱ συστατικαί.", "seq": 4073}
{"id": "David_Passim_4074", "series": "CAG", "text": "10.", "seq": 4074}
{"id": "David_Passim_4075", "series": "CAG", "text": "5 Αἱ μὲν τοῦ ἐμψύχου καὶ αἰσθητικοῦ διαφοραὶ ὑποστατικαί εἰσι τῆς τοῦ ζῴου οὐσίας.", "seq": 4075}
{"id": "David_Passim_4076", "series": "CAG", "text": "Ὧδε δεικνύει ὅτι οὐχ αἱ αὐταί εἰσι διαφοραὶ αἵ τε συστατικαὶ καὶ αἱ διαιρετικαὶ ἐπὶ τοῦ αὐτοῦ λαμβανόμεναι.", "seq": 4076}
{"id": "David_Passim_4077", "series": "CAG", "text": "10.", "seq": 4077}
{"id": "David_Passim_4078", "series": "CAG", "text": "12 Ἀλλ᾿ αἱ μὲν τοῦ λογικοῦ καὶ θνητοῦ διαφοραὶ συστατικαὶ γίνονται τοῦ ἀνθρώπου.", "seq": 4078}
{"id": "David_Passim_4079", "series": "CAG", "text": "Ἓξ οὖν εἰσι συζυγίαι ἐπὶ ταύτης τῆς διαιρέσεως·", "seq": 4079}
{"id": "David_Passim_4080", "series": "CAG", "text": "λογικὸν ἄλογον, θνητὸν ἀθάνατον, λογικὸν θνητόν, λογικὸν ἀθάνατον, ἄλογον θνητόν, ἄλογον ἀθάνατον, ὧν κατὰ μέν τινας δύο εἰσὶν ἀσύστατοι τέσσαρες δὲ συνιστάμεναι, κατὰ δὲ ἄλλους τρεῖς ἀσύστατοι καὶ τρεῖς συνιστάμεναι.", "seq": 4080}
{"id": "David_Passim_4081", "series": "CAG", "text": "καὶ εἰ μὲν τρεῖς εἰσιν αἱ συνιστάμεναι, εὑρίσκονται δύο ὑπάλληλοι καὶ μία διαγώνιος·", "seq": 4081}
{"id": "David_Passim_4082", "series": "CAG", "text": "εἰ δὲ τέσσαρές εἰσιν αἱ συνιστάμεναι, εὑρίσκονται δύο ὑπάλληλοι καὶ δύο διαγώνιοι.", "seq": 4082}
{"id": "David_Passim_4083", "series": "CAG", "text": "καὶ ὁ μὲν Πλάτων βούλεται εἶναι τέσσαρας, λογικὸν ἀθάνατον καὶ λογικὸν θνητὸν καὶ ἄλογον θνητὸν καὶ ἄλογον ἀθάνατον, τὰς δὲ ἐναντίας φησὶν ἀσυστάτους, λογικὸν ἄλογον καὶ θνητὸν ἀθάνατον, καὶ προέφερε τὸν ποιητὴν λέγοντα ὅτι ἔστιν ἄλογον ἀθάνατον ἐν τῷ λέγειν", "seq": 4083}
{"id": "David_Passim_4084", "series": "CAG", "text": "ἡ δ᾿ ἀθάνατον κακόν ἐστιν.", "seq": 4084}
{"id": "David_Passim_4085", "series": "CAG", "text": "ὁ Ἀριστοτέλης δὲ τρεῖς εἶναι βούλεται·", "seq": 4085}
{"id": "David_Passim_4086", "series": "CAG", "text": "οὐ δέχεται γὰρ τὸ ἄλογον ἀθάνατον.", "seq": 4086}
{"id": "David_Passim_4087", "series": "CAG", "text": "ᾧ καὶ ἀκολουθεῖ ὁ Πορφύριος·", "seq": 4087}
{"id": "David_Passim_4088", "series": "CAG", "text": "τρεῖς γὰρ εἶναι λέγει·", "seq": 4088}
{"id": "David_Passim_4089", "series": "CAG", "text": "οὕτω γὰρ καὶ κατ᾿ ἀρχὴν ἐπηγγείλατο τοῖς Περιπατητικοῖς ἀκολουθεῖν.", "seq": 4089}
{"id": "David_Passim_4090", "series": "CAG", "text": "10.", "seq": 4090}
{"id": "David_Passim_4091", "series": "CAG", "text": "14 Οὕτω δὲ καὶ τῆς ἀνωτάτω οὐσίας.", "seq": 4091}
{"id": "David_Passim_4092", "series": "CAG", "text": "Πάλιν οὕτως ἔχει καὶ ἡ οὐσία·", "seq": 4092}
{"id": "David_Passim_4093", "series": "CAG", "text": "ἔστι γὰρ διελεῖν αὐτὴν εἴς τε τὸ ἔμψυχον καὶ ἄψυχον καὶ αἰσθητικὸν καὶ ἀναίσθητον.", "seq": 4093}
{"id": "David_Passim_4094", "series": "CAG", "text": "ἐπὶ τούτων δὲ ἕξ εἰσι συζυγίαι·", "seq": 4094}
{"id": "David_Passim_4095", "series": "CAG", "text": "ἔμψυχον ἄψυχον, αἰσθητικὸν ἀναίσθητον, ἔμψυχον αἰσθητικόν, ἔμψυχον ἀναίσθητον, ἄψυχον αἰσθητικόν, ἄψυχον ἀναίσθητον.", "seq": 4095}
{"id": "David_Passim_4096", "series": "CAG", "text": "καὶ ἐπὶ τούτων δὲ ὁμοίως τρεῖς εἰσι συνιστάμεναι καὶ τρεῖς ἀσύστατοι.", "seq": 4096}
{"id": "David_Passim_4097", "series": "CAG", "text": "καὶ συνιστάμεναι μὲν αἱ δύο ὑπάλληλοι, ἔμψυχον αἰσθητικόν, ἄψυχον ἀναίσθητον, καὶ μία διαγώνιος ἔμψυχον ἀναίσθητον.", "seq": 4097}
{"id": "David_Passim_4098", "series": "CAG", "text": "οὐ συνίστανται δὲ αἱ δύο ἀντικείμεναι, ἔμψυχον ἄψυχον καὶ αἰσθητικὸν ἀναίσθητον, οὔτε ἡ μία τῶν διαγωνίων ἄψυχον αἰσθητικόν.", "seq": 4098}
{"id": "David_Passim_4099", "series": "CAG", "text": "10.", "seq": 4099}
{"id": "David_Passim_4100", "series": "CAG", "text": "19 Εἰδοποιοὶ πᾶσαι κέκληνται.", "seq": 4100}
{"id": "David_Passim_4101", "series": "CAG", "text": "Ἀντὶ τοῦ συστατικαί.", "seq": 4101}
{"id": "David_Passim_4102", "series": "CAG", "text": "διὰ τί δέ;", "seq": 4102}
{"id": "David_Passim_4103", "series": "CAG", "text": "εἰρήκαμεν ὅτι τιμιώτεραί εἰσι τῶν διαιρετικῶν.", "seq": 4103}
{"id": "David_Passim_4104", "series": "CAG", "text": "τούτων δὲ χρεία ἐστὶν εἰς τὸ διαιρεῖν γένη καὶ ὁρίζειν εἴδη, τῶν δὲ κατὰ συμβεβηκὸς διαφορῶν οὐκ ἔστι χρεία.", "seq": 4104}
{"id": "David_Passim_4105", "series": "CAG", "text": "Πρᾶξις κζʹ.", "seq": 4105}
{"id": "David_Passim_4106", "series": "CAG", "text": "Εἰ φῶς τῶν πραγμάτων οἱ ὁρισμοὶ καθεστήκασι, φέρε καὶ τὴν διαφορὰν ὁρισώμεθα εἰρηκότες τί ἐστιν ἡ κοινῶς καὶ ἰδίως καὶ ἰδιαίτατα, καὶ πῶς ἡ ἰδιαίτατα οὐσίαν καὶ οὐσιῶδες δηλοῖ συστατικῶς καὶ διαιρετικῶς λαμβανομένη.", "seq": 4106}
{"id": "David_Passim_4107", "series": "CAG", "text": "λέγεται τοίνυν διαφορὰ ᾗ περιττεύει τὸ εἶδος τοῦ γένους·", "seq": 4107}
{"id": "David_Passim_4108", "series": "CAG", "text": "ἐν μὲν γὰρ τῷ εἴδει περιττεύουσιν αἱ διαφοραί, ἐν δὲ τῷ γένει οὐκέτι·", "seq": 4108}
{"id": "David_Passim_4109", "series": "CAG", "text": "τὸ γὰρ γένος ὡς γένος ἀδιαίρετον ὑπάρχον οὐκ ἔχει διαφοράν.", "seq": 4109}
{"id": "David_Passim_4110", "series": "CAG", "text": "εἰ δὲ εἴποις ‘ναὶ ἔχει·", "seq": 4110}
{"id": "David_Passim_4111", "series": "CAG", "text": "ἰδοὺ γάρ φαμεν·", "seq": 4111}
{"id": "David_Passim_4112", "series": "CAG", "text": "οὐσία ἔμψυχος αἰσθητική ἐστι τὸ ζῷον’, λέξω ὡς οὐκ ἔχει ταύτας τὰς διαφορὰς ὡς γένος, ἀλλ᾿ ὡς εἶδος.", "seq": 4112}
{"id": "David_Passim_4113", "series": "CAG", "text": "καὶ τοῦτο πρόδηλόν ἐστιν ἐκ τοῦ συστατικὰς εἶναι τὰς διαφοράς·", "seq": 4113}
{"id": "David_Passim_4114", "series": "CAG", "text": "συστατικαὶ δὲ διαφοραὶ γενῶν οὔκ εἰσιν ἀλλ᾿ εἰδῶν, ὡς καὶ ἤδη λέλεκται.", "seq": 4114}
{"id": "David_Passim_4115", "series": "CAG", "text": "εἰ δὲ καὶ φιλονεικεῖς λέγων ὅτι πάντως ἔχει, λέξομεν ὅτι εἰ καὶ ἔχει διαφορὰς τὸ γένος, ἀλλ᾿ οὖν οὐ τὰς ἴσας τῷ εἴδει·", "seq": 4115}
{"id": "David_Passim_4116", "series": "CAG", "text": "ἔχει γὰρ τὸ εἶδος καὶ τὰς τοῦ γένους καὶ τὰς ἑαυτοῦ·", "seq": 4116}
{"id": "David_Passim_4117", "series": "CAG", "text": "τὸ γὰρ οὐσία ἔμψυχος αἰσθητικὴ λέγεται καὶ ἐπὶ τοῦ ἀνθρώπου, ὁμοίως δὲ καὶ τὸ λογικὸν θνητόν.", "seq": 4117}
{"id": "David_Passim_4118", "series": "CAG", "text": "ἀλλὰ μὴν καὶ ἐνεργείᾳ εἰσὶν ἐν τῷ εἴδει, δυνάμει δὲ ἐν τῷ γένει, ὅταν καὶ συγχωρηθῇ τὸ λογικὸν εἶναι τοῦ γένους διαφορὰν ὡς γένους.", "seq": 4118}
{"id": "David_Passim_4119", "series": "CAG", "text": "τοῦτο δέ φημι, ἐπειδὴ ἀδιαίρετον ὑπάρχον τὸ γένος τὸ λογικὸν οὐκ ἔχει ἀπ᾿ αὐτοῦ διαιρούμενον.", "seq": 4119}
{"id": "David_Passim_4120", "series": "CAG", "text": "μὴ νόμιζε δὲ ὅτι τὸ εἶδος πλείονας ἔχον διαφορὰς τοῦ γένους καθολικώτερόν ἐστιν·", "seq": 4120}
{"id": "David_Passim_4121", "series": "CAG", "text": "ὅπου γὰρ πλείονές εἰσι διαφοραί, ἐκεῖ βραχὺ καὶ ἔλαττον ὑπάρχει τὸ ὁριζόμενον·", "seq": 4121}
{"id": "David_Passim_4122", "series": "CAG", "text": "ἰδοὺ γὰρ τοῦ ἐπὶ τὰ ἄτομα ἐξαπλουμένου ἀνθρώπου *** οὐ τοσαῦταί εἰσιν ὅσαι καὶ ἐπὶ τοῦ ἀτόμου·", "seq": 4122}
{"id": "David_Passim_4123", "series": "CAG", "text": "λέγων γὰρ τὸν ἄνθρωπον ζῷον λογικὸν θνητὸν τὸν καθόλου ὁρίζεις, εἰ δὲ θελήσεις τὸν μερικὸν ἤτοι τὸν ἄτομον εἰπεῖν, προστιθεῖς καὶ ἄλλας διαφορὰς πρὸς τὸ ἀτομῶσαι τὸν καθόλου ἄνθρωπον·", "seq": 4123}
{"id": "David_Passim_4124", "series": "CAG", "text": "λέγομεν γὰρ ‘Σωκράτης ἐστὶ ζῷον λογικὸν θνητὸν πλατυώνυχον προκοίλιον’.", "seq": 4124}
{"id": "David_Passim_4125", "series": "CAG", "text": "καὶ οὕτω διὰ τῶν πλειόνων διαφορῶν ἀτομοῦται ὁ καθόλου ἄνθρωπος.", "seq": 4125}
{"id": "David_Passim_4126", "series": "CAG", "text": "Ζητοῦσι δέ τινες διὰ τί τὴν μὲν διαφορὰν ὁ Πορφύριος διὰ τοῦ γένους καὶ εἴδους ὡρίσατο, τὸ εἶδος δὲ καὶ τὸ γένος δι᾿ ἀλλήλων παρέδωκε, καίτοι δυναμένου τοῦ εἴδους διὰ τῆς διαφορᾶς καὶ τοῦ γένους ὁρίζεσθαι, ὡς ἵνα εἴπῃς ‘εἶδός ἐστι τὸ πλείονας ἔχον διαφορὰς τοῦ γένους’, ὁμοίως δὲ καὶ τοῦ γένους δυναμένου παραδίδοσθαι διὰ τοῦ εἴδους καὶ τῆς διαφορᾶς, ὡς ἵνα εἴπῃς ‘γένος ἐστὶ τὸ ἐν τῷ εἴδει θεωρούμενον, οὐκέτι δὲ καὶ ἐν τῇ διαφορᾷ’·", "seq": 4126}
{"id": "David_Passim_4127", "series": "CAG", "text": "τὸν μὲν γὰρ ἄνθρωπον ζῷόν φαμεν, τὴν δὲ λογικότητα οὔ φαμεν ζωότητα.", "seq": 4127}
{"id": "David_Passim_4128", "series": "CAG", "text": "ἔστι δ᾿ οὕτως πρὸς ταῦτα ἀπολογήσασθαι·", "seq": 4128}
{"id": "David_Passim_4129", "series": "CAG", "text": "τέσσαρά ἐστι τὰ κατασκευάζοντα, τρία μὲν ἀσύστατα, ἓν δὲ συνιστάμενον·", "seq": 4129}
{"id": "David_Passim_4130", "series": "CAG", "text": "ὁμολογούμενον ἐξ ὁμολογουμένου, ἀμφίβολον ἐξ ἀμφιβόλου, ὁμολογούμενον ἐξ ἀμφιβόλου, ἀμφίβολον ἐξ ὁμολογουμένου.", "seq": 4130}
{"id": "David_Passim_4131", "series": "CAG", "text": "καὶ τὰ μὲν τρία ἀσύστατα, ἓν δὲ ὡς ἔφαμεν τὸ συνιστάμενον.", "seq": 4131}
{"id": "David_Passim_4132", "series": "CAG", "text": "ποῖα δὲ οὐ συνίσταται, λέξωμεν·", "seq": 4132}
{"id": "David_Passim_4133", "series": "CAG", "text": "τὸ ὁμολογούμενον ἐξ ὁμολογουμένου (οὐδεὶς γὰρ κατασκευὴν τοῦ ὁμολογουμένου ποιεῖται), οὐδὲ τὸ ἀμφίβολον ἐξ ἀμφιβόλου (ὁ τοιοῦτος γὰρ λόγος διάλληλος ὑπάρχει), οὔτε μὴν τὸ ὁμολογούμενον ἐξ ἀμφιβόλου·", "seq": 4133}
{"id": "David_Passim_4134", "series": "CAG", "text": "εἰ γὰρ τὸ ὁμολογούμενον ἐξ ὁμολογουμένου οὐ κατασκευάζεται, πολλῷ μᾶλλον οὐδὲ ἐξ ἀμφιβόλου.", "seq": 4134}
{"id": "David_Passim_4135", "series": "CAG", "text": "συνίσταται δὲ τὸ λέγον τὸ ἀμφίβολον ἐξ ὁμολογουμένου κατασκευάζεσθαι.", "seq": 4135}
{"id": "David_Passim_4136", "series": "CAG", "text": "τούτου οὕτως ἔχοντος ὁ Πορφύριος λογικῇ μεθόδῳ χρησάμενος οὐχ ὁρίζει τὰ ἀμφιβαλλόμενα ἐξ ἀμφιβαλλομένων·", "seq": 4136}
{"id": "David_Passim_4137", "series": "CAG", "text": "τὸ γένος γὰρ ὁρίζων οὐκ ἠδύνατο διὰ τῆς διαφορᾶς καὶ τοῦ εἴδους αὐτὸ παραδοῦναι ἅτε τῆς διαφορᾶς καὶ τοῦ εἴδους ὑπ᾿ ἀμφιβολίαν ὄντων, οὔτε μὴν τὸ εἶδος διὰ τῆς διαφορᾶς καὶ τοῦ γένους·", "seq": 4137}
{"id": "David_Passim_4138", "series": "CAG", "text": "ἔτι γὰρ ἠγνοεῖτο ἡ διαφορά.", "seq": 4138}
{"id": "David_Passim_4139", "series": "CAG", "text": "τὴν μέντοι διαφορὰν διὰ τοῦ εἴδους καὶ τοῦ γένους παραδέδωκε τὸ ἀμφίβολον διὰ τῶν ὁμολογουμένων κατασκευάζων.", "seq": 4139}
{"id": "David_Passim_4140", "series": "CAG", "text": "Ἐπειδὴ δέ τινες κατασκευάζουσι μὴ εἶναι τὰς διαφοράς, φέρε τὴν κατασκευὴν πρῶτον εἰσόμεθα, εἶθ᾿ ὕστερον τῶν ὄντων αὐτὰς ἀποδείξωμεν.", "seq": 4140}
{"id": "David_Passim_4141", "series": "CAG", "text": "κατασκευάζουσι δὲ τὸ τοιοῦτον δύο λήμμασιν, ὧν τὸ πρῶτον ἐπέχει τοιοῦτον λόγον·", "seq": 4141}
{"id": "David_Passim_4142", "series": "CAG", "text": "οὐδέποτε τἀναντία ἀμιγῆ καὶ ἄκρατα ὄντα ἐν τῷ αὐτῷ κατ᾿ ἀριθμὸν καὶ κατὰ τὸ αὐτὸ μέρος καὶ κατὰ τὸν αὐτὸν χρόνον θεωρεῖται, οἷον τὸ λευκὸν καὶ τὸ μέλαν ἐν τῷ αὐτῷ οὐδέποτε θεωρεῖται.", "seq": 4142}
{"id": "David_Passim_4143", "series": "CAG", "text": "ἐπειδὴ δὲ δύναται ἐν τῷ αὐτῷ κατ᾿ εἶδος εἶναι (ἐν μὲν Σωκράτει τὸ μέλαν, ἐν δὲ τῷ Πλάτωνι τὸ λευκόν), προσέθηκαν ‘κατ᾿ ἀριθμόν’, ἵνα ἕνα δηλώσωσιν.", "seq": 4143}
{"id": "David_Passim_4144", "series": "CAG", "text": "ἐπειδὴ δὲ καὶ ἐν ἑνὶ δύναται εἶναι τὸ θερμὸν καὶ τὸ ψυχρόν, ἐν μὲν τοῖς ποσὶ τὸ θερμόν, ἐν δὲ τῇ κεφαλῇ τὸ ψυχρόν, προσέθηκαν ‘κατὰ τὸ αὐτὸ μέρος’.", "seq": 4144}
{"id": "David_Passim_4145", "series": "CAG", "text": "ἔτι δὲ προσέθηκαν καὶ ‘κατὰ τὸν αὐτὸν χρόνον’ διὰ τὸν διάφορον χρόνον·", "seq": 4145}
{"id": "David_Passim_4146", "series": "CAG", "text": "ὁ γὰρ διάφορος χρόνος καὶ τἀναντία δύναται ἐν τῷ αὐτῷ καὶ κατὰ τὸ αὐτὸ μέρος δεῖξαι θεωρούμενα·", "seq": 4146}
{"id": "David_Passim_4147", "series": "CAG", "text": "τὴν γὰρ θερμὴν κεφαλὴν καὶ ψυχρὰν μετέπειτα ποιεῖ.", "seq": 4147}
{"id": "David_Passim_4148", "series": "CAG", "text": "τὸ δεύτερον δὲ τοιοῦτον ὑπάρχει·", "seq": 4148}
{"id": "David_Passim_4149", "series": "CAG", "text": "οὐδέποτε εὑρίσκεταί τι ἐκ τῶν μηδαμῇ μηδαμῶς·", "seq": 4149}
{"id": "David_Passim_4150", "series": "CAG", "text": "πάντα γὰρ τὰ ὄντα ἐξ ὄντων ἔχουσι τὸ εἶναι.", "seq": 4150}
{"id": "David_Passim_4151", "series": "CAG", "text": "ἰστέον δὲ ὡς ἄλλο μέν φησιν ὁ Πλάτων τὸ μηδαμῇ μηδαμῶς, ἄλλο δὲ ὁ Ἀριστοτέλης·", "seq": 4151}
{"id": "David_Passim_4152", "series": "CAG", "text": "ὁ μὲν γὰρ Πλάτων ἔλεγε τὸ μηδαμῇ τὸ μηδαμῶς μήτε ἐπινοίᾳ μήτε ἐνεργείᾳ ὑπάρχον (ἀμέλει τὸν τραγέλαφον οὔ φησι μηδαμῇ μηδαμῶς, ἐπειδὴ ἔχει τὸ εἶναι ἐν ἐπινοίᾳ), Ἀριστοτέλης δὲ μηδαμῇ μηδαμῶς ἔλεγε τὸ τῇ μὲν ἐπινοίᾳ ὑφιστάμενον, ἐνεργείᾳ δὲ οὐκέτι, οἷον τὸν τραγέλαφον καὶ τὰ τοιαῦτα.", "seq": 4152}
{"id": "David_Passim_4153", "series": "CAG", "text": "τούτου δὲ οὕτως ἔχοντός φασι τὰς διαφορὰς μὴ εἶναι·", "seq": 4153}
{"id": "David_Passim_4154", "series": "CAG", "text": "ποῦ γάρ εἰσιν;", "seq": 4154}
{"id": "David_Passim_4155", "series": "CAG", "text": "ἐὰν γὰρ εἴπῃς ‘ἐν γένεσίν εἰσιν’, ψεύσῃ·", "seq": 4155}
{"id": "David_Passim_4156", "series": "CAG", "text": "τοῦτο γὰρ κατασκευάζει τὸ πρῶτον λῆμμα, τὸ μὴ θεωρεῖσθαι τἀναντία ἐν τῷ αὐτῷ κατ᾿ ἀριθμὸν καὶ κατὰ τὸ αὐτὸ μέρος καὶ κατὰ τὸν αὐτὸν χρόνον.", "seq": 4156}
{"id": "David_Passim_4157", "series": "CAG", "text": "εἰ οὖν τὸ ζῷον ἕν τί ἐστι κατ᾿ ἀριθμόν, ἀμερὲς δὲ κατὰ τὸ γένος, τὰ γένη δὲ καθόλου εἰσί, τὰ καθόλου δὲ ἀσώματά εἰσι, τὰ δὲ ἀσώματα ἀμερῆ, πῶς δύναται κατὰ τὸν αὐτὸν χρόνον δέχεσθαι τἀναντία, φημὶ δὲ τὸ λογικὸν καὶ τὸ ἄλογον καὶ τὸ θνητὸν καὶ τὸ ἀθάνατον;", "seq": 4157}
{"id": "David_Passim_4158", "series": "CAG", "text": "ἀλλὰ μὴν εἴ εἰσι διαφοραὶ ἐν γένει πάντως, καὶ ἐν τῷ αὐτῷ χρόνῳ εἰσίν·", "seq": 4158}
{"id": "David_Passim_4159", "series": "CAG", "text": "οὔτε γὰρ ἔστιν ἐπινοῆσαι σήμερον μὲν τὰ ζῷα λογικά, αὔριον δὲ ἄλογα.", "seq": 4159}
{"id": "David_Passim_4160", "series": "CAG", "text": "εἰ οὖν οὔκ εἰσιν αἱ διαφοραὶ ἐν τοῖς γένεσιν, ἐκ τοῦ μηδαμῇ μηδαμῶς ἐγένοντο.", "seq": 4160}
{"id": "David_Passim_4161", "series": "CAG", "text": "τὸ δεύτερον δὲ λῆμμα κωλύει εἶναί τι ἐκ τοῦ μηδαμῇ μηδαμῶς·", "seq": 4161}
{"id": "David_Passim_4162", "series": "CAG", "text": "κἂν γὰρ εἴπῃς ὕδωρ ἐκ πυρὸς γενέσθαι, ἀλλ᾿ οὖν προϋπῆρχε τὸ πῦρ, κἂν εἴπῃς ἐξ ὕδατος ἀέρα γενέσθαι, προϋπῆρχε τὸ ὕδωρ.", "seq": 4162}
{"id": "David_Passim_4163", "series": "CAG", "text": "ἔστι δὲ ὑπὲρ τούτου οὕτως ἀπολογήσασθαι·", "seq": 4163}
{"id": "David_Passim_4164", "series": "CAG", "text": "ἔστι τινὰ μέσα, ἅπερ οὔτε μηδαμῇ μηδαμῶς εἰσιν οὔτε τὸ εἶναι ἔχουσιν, ἀλλὰ μέσον χωρεῖ τῶν δύο ἄκρων μεταλαμβάνοντα καὶ στερούμενα.", "seq": 4164}
{"id": "David_Passim_4165", "series": "CAG", "text": "τὸ τοιοῦτον δὲ δυνάμει λέγεται, οἷον τὸ παιδίον δυνάμει γραμματικόν ἐστι καὶ οὐκ ἔστι μὲν τῶν ὄντων, καθὸ οὐκ ἔστιν ὡς λέγεται, ἀλλ᾿ οὐδὲ τῶν μηδαμῇ μηδαμῶς ἐστι, καθὸ δυνάμει ἔχει τὸ εἶναι.", "seq": 4165}
{"id": "David_Passim_4166", "series": "CAG", "text": "τὸ τοιοῦτον δὲ τὰ ἀντικείμενα ἡμῖν δύο ἄπορα ἐπιλύσεται·", "seq": 4166}
{"id": "David_Passim_4167", "series": "CAG", "text": "ἔστι γὰρ εἰπεῖν ὅτι αἱ διαφοραὶ ἐν τοῖς γένεσίν εἰσι δυνάμει, καὶ οὐκ ἐνεργείᾳ, οἷον ἐν τῇ ποιότητι δύναται θεωρεῖσθαι δυνάμει τὸ θερμὸν καὶ τὸ ψυχρόν·", "seq": 4167}
{"id": "David_Passim_4168", "series": "CAG", "text": "τὸ γὰρ ἄρτι θερμὸν δυνάμει ψυχρόν ἐστιν, ὡς ἐπὶ τοῦ ἐλαίου·", "seq": 4168}
{"id": "David_Passim_4169", "series": "CAG", "text": "τοῦτο γὰρ δυνάμει ἔχει τὸ θερμὸν καὶ τὸ ψυχρόν, καὶ ὅσον μὲν αὐτὸ καθ᾿ ἑαυτὸ μένει, ἄμφω ἔχει, θάτερον δὲ μεταβάλλει εἰς τὸ ἕτερον πρὸς τὴν ποιότητα τῶν μιγνυμένων·", "seq": 4169}
{"id": "David_Passim_4170", "series": "CAG", "text": "ῥόδων γὰρ ἐπιβαλλομένων τῷ ἐλαίῳ ἐπαύξεται τὸ ψυχρὸν τοῦ θερμοῦ τὴν ποιότητα καθ᾿ αὑτὸ μεταβάλλοντος, χαμαιμήλου δὲ ἐπιβαλλομένου ἐπαύξεται μὲν τὸ θερμόν, μεταβάλλει δὲ τὸ ψυχρὸν εἰς ἑαυτό.", "seq": 4170}
{"id": "David_Passim_4171", "series": "CAG", "text": "τούτου οὕτως ἔχοντος δείκνυται τὰ γένη δυνάμει ἔχειν τὰ ἐναντία·", "seq": 4171}
{"id": "David_Passim_4172", "series": "CAG", "text": "τὸ γὰρ χρῶμα ἔχει τὸ λευκὸν καὶ τὸ μέλαν δυνάμει, ἡ ποιότης τὸ θερμὸν καὶ τὸ ψυχρόν, τὸ ζῷον τὸ λογικὸν καὶ τὸ ἄλογον.", "seq": 4172}
{"id": "David_Passim_4173", "series": "CAG", "text": "ἔχομεν ἐντεῦθεν ὡς δύνανται αἱ διαφοραὶ ἐναντίως ἔχουσαι δυνάμει θεωρεῖσθαι ἐν τοῖς γένεσι.", "seq": 4173}
{"id": "David_Passim_4174", "series": "CAG", "text": "τὸ ὕστερον δὲ ἄπορον ἐκ τοῦ πρώτου ἐπιλύεται·", "seq": 4174}
{"id": "David_Passim_4175", "series": "CAG", "text": "εἰ γὰρ αἱ διαφοραὶ ἐν τοῖς γένεσι θεωροῦνται, δῆλον ὡς οὔκ εἰσιν ἐκ τῶν μηδαμῇ μηδαμῶς.", "seq": 4175}
{"id": "David_Passim_4176", "series": "CAG", "text": "τῆς γοῦν τοιαύτης δόξης οἱ ἐκ τοῦ Περιπάτου ἑαυτοὺς ἀποφαίνονται.", "seq": 4176}
{"id": "David_Passim_4177", "series": "CAG", "text": "Πρᾶξις κη΄.", "seq": 4177}
{"id": "David_Passim_4178", "series": "CAG", "text": "Τῶν Περιπατητικῶν οἱ Πλατωνικοὶ κατευτελίζοντες τὴν δόξαν ἀποδεῖξαι ἐνεργείᾳ ὑπάρχειν ἐν τοῖς γένεσι τὰς διαφορὰς πειρῶνται, τὸ δυνάμει παραιτούμενοι.", "seq": 4178}
{"id": "David_Passim_4179", "series": "CAG", "text": "φασὶ γὰρ τὰ τοιαῦτα·", "seq": 4179}
{"id": "David_Passim_4180", "series": "CAG", "text": "εἰ δυνάμει λέγετε, ὦ Περιπατητικοί, τὰς διαφορὰς εἶναι ἐν τοῖς γένεσιν, ἐνεργείᾳ δὲ ἐν τοῖς εἴδεσιν, ἔσται τὰ εἴδη κρείττονα τῶν γενῶν ἅτε δὴ τοῦ ἐνεργείᾳ κρείττονος τοῦ δυνάμει ὑπάρχοντος.", "seq": 4180}
{"id": "David_Passim_4181", "series": "CAG", "text": "δεύτερον οὐδὲ ἐναντία εἰσὶ τὰ τοιαῦτα·", "seq": 4181}
{"id": "David_Passim_4182", "series": "CAG", "text": "τὸ γὰρ ἄλογον καὶ λογικὸν ἐναντιότητα οὐκ ἔχει·", "seq": 4182}
{"id": "David_Passim_4183", "series": "CAG", "text": "οὐσίαι γάρ εἰσιν, αἱ δὲ οὐσίαι ἐναντιότητα οὐκ ἔχουσιν ἐν ὑποκειμένῳ μὴ οὖσαι, ὑποκείμενον δὲ ὑπάρχουσαι.", "seq": 4183}
{"id": "David_Passim_4184", "series": "CAG", "text": "εἰ ἦσαν δὲ τὰ τοιαῦτα ἐναντία, οὐδὲ ὤφειλον ἐνεργείᾳ ἐν τῷ αὐτῷ θεωρεῖσθαι (νυνὶ δὲ τὸ ἄλογον καὶ τὸ λογικὸν ἐν τῷ ζῴῳ ὑπάρχει), ὤφειλον δὲ καὶ φθείρειν ἄλληλα (οὐ φθείρει δέ·", "seq": 4184}
{"id": "David_Passim_4185", "series": "CAG", "text": "δείκνυται γὰρ καὶ αὐτῷ τῷ Ἀριστοτέλει τὸ ἄλογον καὶ τὸ λογικὸν εἶναι ἐν τῷ ζῴῳ), ὤφειλον δὲ καὶ μεταβάλλειν εἰς ἄλληλα·", "seq": 4185}
{"id": "David_Passim_4186", "series": "CAG", "text": "εἰ δὲ λογικὸν εἰς ἄλογον οὐ μεταβάλλει, σαφὲς ὡς οὔκ εἰσιν ἐναντία.", "seq": 4186}
{"id": "David_Passim_4187", "series": "CAG", "text": "τρίτον εἰ ἦσαν ἐναντία, ὤφειλον καὶ ἐν τῷ αὐτῷ θεωρεῖσθαι·", "seq": 4187}
{"id": "David_Passim_4188", "series": "CAG", "text": "καὶ γὰρ ἔστιν εὑρεῖν ἐναντία θεωρούμενα ἐν τῷ αὐτῷ, ὥσπερ ἐν τῇ ἀνειδέῳ ὕλῃ·", "seq": 4188}
{"id": "David_Passim_4189", "series": "CAG", "text": "τὸ γὰρ ψυχρὸν καὶ θερμὸν καὶ λευκὸν καὶ μέλαν ὅλα τε τὰ εἴδη ἐν τῇ ἀνειδέῳ ὕλῃ θεωρεῖται.", "seq": 4189}
{"id": "David_Passim_4190", "series": "CAG", "text": "τέταρτον ὅτι καὶ τὰ ἐναντία ἐν τῷ αὐτῷ θεωρεῖται, ἐξ αὐτῶν τῶν αἰσθήσεων τὸν λόγον πιστούμεθα·", "seq": 4190}
{"id": "David_Passim_4191", "series": "CAG", "text": "ἰδοὺ γὰρ ἡ ὅρασις ἅμα τῶν ἐναντίων ἀντιλαμβάνεται, λευκοῦ τε καὶ μέλανος.", "seq": 4191}
{"id": "David_Passim_4192", "series": "CAG", "text": "καὶ σαφὲς ἐκ τοῦ διαχωρίζειν αὐτὴν τὰ στοιχεῖα ἐκ τοῦ χάρτου.", "seq": 4192}
{"id": "David_Passim_4193", "series": "CAG", "text": "εἰ δὲ εἴποις ὅτι κατ᾿ ἄλλο μὲν τοῦ μέλανος κατ᾿ ἄλλο δὲ τοῦ λευκοῦ ἀντιλαμβάνεται, ἐπὶ σοῦ ἁρμόσει τὸ πάλαι εἰρημένον, ὡς εἰ σὺ τούτου μὲν αἴσθοιο, ἐγὼ δὲ τούτου.", "seq": 4193}
{"id": "David_Passim_4194", "series": "CAG", "text": "τοῦτο δὲ εἴρηται, ὡς ἵνα ἑνὸς δύο ἀκούοντες ἑκάτερος διάφορα αἴσθοιτο.", "seq": 4194}
{"id": "David_Passim_4195", "series": "CAG", "text": "Ἔστι δὲ ὑπὲρ τῶν Περιπατητικῶν οὕτως ἀπολογήσασθαι.", "seq": 4195}
{"id": "David_Passim_4196", "series": "CAG", "text": "πρὸς τὸ πρῶτον δεῖ οὕτως λέγειν·", "seq": 4196}
{"id": "David_Passim_4197", "series": "CAG", "text": "μὴ ἐκ τῶν δοκούντων τοῖς Ἀριστοτελικοῖς ἀνατρέπειν νομίσητε, ὦ Πλατωνικοί·", "seq": 4197}
{"id": "David_Passim_4198", "series": "CAG", "text": "αὐτοῖς γὰρ δοκεῖ κρείττονα τὰ εἴδη τῶν γενῶν ὑπάρχειν.", "seq": 4198}
{"id": "David_Passim_4199", "series": "CAG", "text": "ἀνθρώπου δὲ λέγοντος ὅτι λογικὸς ὑπάρχει ὁ ἄνθρωπος, οὐκ ὤφειλες μέμφεσθαι αὐτοῦ καὶ λέγειν ἄτοπα αὐτὸν φθέγγεσθαι, εἰ φαίη λογικὸν εἶναι τὸν ἄνθρωπον, ἀλλὰ δι᾿ ἑτέρου δεῖ κατασκευάζειν ὡς οὐ λογικὸς ὁ ἄνθρωπος.", "seq": 4199}
{"id": "David_Passim_4200", "series": "CAG", "text": "εἰ δοκεῖ οὖν τοῖς Ἀριστοτελικοῖς τὰ εἴδη τῶν γενῶν κρείττονα ὑπάρχειν ἀλλὰ καὶ τὰ ἄτομα τῶν γενῶν καὶ τῶν εἰδῶν (οὕτω γὰρ ὁ Ἀριστοτέλης ἐν ταῖς Κατηγορίαις ἔφη τὸν Σωκράτην εἶναι κυρίαν καὶ πρώτην οὐσίαν), οὐκ ὤφειλον οἱ Πλατωνικοὶ ἐκ τῶν δοκούντων αὐτοῖς, φημὶ δὴ τοῖς Ἀριστοτελικοῖς, ἄτοπα συνάγειν καὶ λέγειν ὅτι τὰ εἴδη κρείττονα ἔσται τῶν γενῶν ἐνεργείᾳ ἔχοντα τὰς διαφοράς·", "seq": 4200}
{"id": "David_Passim_4201", "series": "CAG", "text": "τοῦτο γὰρ αὐτὸ βούλονται οἱ Ἀριστοτελικοί.", "seq": 4201}
{"id": "David_Passim_4202", "series": "CAG", "text": "πρὸς τὸ δεύτερον·", "seq": 4202}
{"id": "David_Passim_4203", "series": "CAG", "text": "κἂν μή εἰσιν αἱ οὐσιώδεις διαφοραὶ ἐναντίαι λογικὸν καὶ ἄλογον, ἀλλ᾿ οὖν αἱ συμβεβηκυῖαι ἐναντίαι εἰσί·", "seq": 4203}
{"id": "David_Passim_4204", "series": "CAG", "text": "τὸ γὰρ θερμὸν καὶ ψυχρὸν ἐναντία εἰσί, θεωρεῖσθαι δὲ ἐν τῷ γένει ἐνεργείᾳ τὸ θερμὸν ἅμα καὶ τὸ ψυχρὸν ἀδύνατον, φημὶ δὴ ἐν τῇ ποιότητι.", "seq": 4204}
{"id": "David_Passim_4205", "series": "CAG", "text": "εἰ οὖν ὁμολογεῖται τὰ τοιαῦτα δυνάμει ἐν τοῖς γένεσι θεωρεῖσθαι, τὸ λευκὸν καὶ τὸ μέλαν, τὸ θερμὸν καὶ τὸ ψυχρόν, ἀμφιβάλλεται δὲ τὸ λογικὸν καὶ ἄλογον εἰ δυνάμει ἐστὶν ἐν τοῖς γένεσιν ἢ ἐνεργείᾳ, σαφὲς ὡς τὸ ἀμφιβαλλόμενον τῷ ὁμολογουμένῳ παρακολουθεῖ.", "seq": 4205}
{"id": "David_Passim_4206", "series": "CAG", "text": "πρὸς τὸ τρίτον·", "seq": 4206}
{"id": "David_Passim_4207", "series": "CAG", "text": "τὰ ἐναντία, ὥς φατε, ἐν τῇ ἀνειδέῳ ὕλῃ θεωρεῖται, ἀλλ᾿ οὐκ ἐνεργείᾳ, δυνάμει δέ·", "seq": 4207}
{"id": "David_Passim_4208", "series": "CAG", "text": "τί γὰρ λέγετε;", "seq": 4208}
{"id": "David_Passim_4209", "series": "CAG", "text": "τὴν ἐν τῷ Σωκράτει ὕλην ἢ τὴν ἐν πᾶσιν;", "seq": 4209}
{"id": "David_Passim_4210", "series": "CAG", "text": "εἰ μὲν τὴν ἐν τῷ Σωκράτει, οὐκ ἔστιν αὕτη ἵππου καὶ κυνὸς ὕλη ἐνεργείᾳ·", "seq": 4210}
{"id": "David_Passim_4211", "series": "CAG", "text": "δυνάμει γὰρ κυνὸς καὶ ἵππου ἐστίν, ἐνεργείᾳ δὲ Σωκράτους.", "seq": 4211}
{"id": "David_Passim_4212", "series": "CAG", "text": "εἰ δὲ τὴν ἐν πᾶσι λέγετε, ἀδύνατον αὐτὴν ἐνεργείᾳ ἔχειν ἅμα Σωκράτην καὶ κύνα, δυνάμει δέ.", "seq": 4212}
{"id": "David_Passim_4213", "series": "CAG", "text": "πρὸς τὸ τέταρτον·", "seq": 4213}
{"id": "David_Passim_4214", "series": "CAG", "text": "οὐ δεῖ τῷ ἀπόρῳ τὸ ἄπορον ἐπιλύεσθαι·", "seq": 4214}
{"id": "David_Passim_4215", "series": "CAG", "text": "εἰ γὰρ ἀπορήσω διὰ τί λογικὸς ὁ ἄνθρωπος, οὐ δεῖ σε λέγειν ὅτι καὶ τὰ θεῖα λογικά εἰσιν.", "seq": 4215}
{"id": "David_Passim_4216", "series": "CAG", "text": "ἀπορεῖτε δὲ ὑμεῖς αὐτοὶ πῶς ἐπὶ τῆς ὁράσεως τἀναντία ἐνεργείᾳ ὑπάρχει·", "seq": 4216}
{"id": "David_Passim_4217", "series": "CAG", "text": "(ἐπὶ γὰρ τῶν ἀσωμάτων λέγετε τἀναντία ἐνεργείᾳ θεωρεῖσθαι, ἐπὶ δὲ τῶν σωμάτων οὐκέτι), ἠπορήθη δὲ ὑμῖν καὶ πῶς τῶν ἐναντίων ἡ ὅρασις ἅμα ἀντιλαμβάνεται σῶμα ὑπάρχουσα, τοῦτο δὲ τὸ ἀπορούμενον οὐκ ἔδει παρενέγκαι εἰς λύσιν.", "seq": 4217}
{"id": "David_Passim_4218", "series": "CAG", "text": "διὰ τί δὲ τῶν ἐναντίων ἅμα ἡ ὅρασις ἀντιλαμβάνεται, ἐν τελείαις πραγματείαις εἰσόμεθα.", "seq": 4218}
{"id": "David_Passim_4219", "series": "CAG", "text": "10.", "seq": 4219}
{"id": "David_Passim_4220", "series": "CAG", "text": "22 Ἃς δὴ καὶ ὁριζόμενοί φασι·", "seq": 4220}
{"id": "David_Passim_4221", "series": "CAG", "text": "διαφορά ἐστιν ᾗ περιττεύει τὸ εἶδος τοῦ γένους.", "seq": 4221}
{"id": "David_Passim_4222", "series": "CAG", "text": "Ὁρισμὸς οὐκ ἔστι Πορφυρίου·", "seq": 4222}
{"id": "David_Passim_4223", "series": "CAG", "text": "διὰ τοῦτο λέγει ἃς καὶ ὁριζόμενοι καὶ οὐ λέγει ‘ὁρίζομαι’, ἵνα δείξῃ ὅτι τῶν Περιπατητικῶν ἐστι.", "seq": 4223}
{"id": "David_Passim_4224", "series": "CAG", "text": "δεικνύει δὲ καὶ ὁ ὁρισμὸς ὅτι τῶν Περιπατητικῶν ἐστιν, ἐπειδὴ ἐνεργείᾳ οὐ βούλεται τὰς διαφορὰς εἶναι ἐν τῷ γένει, ἀλλὰ δυνάμει.", "seq": 4224}
{"id": "David_Passim_4225", "series": "CAG", "text": "ἰστέον δὲ ὡς δείκνυται ἔνθεν δεῖν τοῦ γένους ὁρισμὸν λέγειν καὶ ὑπογραφήν·", "seq": 4225}
{"id": "David_Passim_4226", "series": "CAG", "text": "ἠβούλοντο γάρ τινες μὴ εἶναι ὁρισμὸν ἀλλ᾿ ὑπογραφὴν ἐκ τοῦ λέγειν τὸν Πορφύριον ὃ καὶ ὑπογράφοντες.", "seq": 4226}
{"id": "David_Passim_4227", "series": "CAG", "text": "οὐκ ἔστι δὲ μόνον ὑπογραφὴ ἀλλὰ καὶ ὁρισμός·", "seq": 4227}
{"id": "David_Passim_4228", "series": "CAG", "text": "ἀμέλει οὐδὲ αὐτοῦ λέγοντος ὁρίζεσθαι τὴν διαφορὰν ὁρισμὸν μόνον αὐτῆς λέγομεν, ἀλλὰ καὶ ὑπογραφήν.", "seq": 4228}
{"id": "David_Passim_4229", "series": "CAG", "text": "οὐ δεῖ οὖν λέγειν μόνον ὑπογραφὴν τοῦ γένους εἶναι, ἐπειδή φησιν ὃ καὶ ὑπογράφοντες·", "seq": 4229}
{"id": "David_Passim_4230", "series": "CAG", "text": "προσέχων γὰρ ποτὲ μὲν τοῖς πράγμασί φησιν ὃ καὶ ὑπογράφοντες, ποτὲ δὲ τῇ σχέσει λέγει ὁριζόμενοι·", "seq": 4230}
{"id": "David_Passim_4231", "series": "CAG", "text": "εἰ γὰρ καὶ ἐπὶ τῆς διαφορᾶς ὁρισμὸν ἀποδίδωσι, σαφὲς ὅτι καὶ ἐπὶ τοῦ γένους καὶ τοῦ εἴδους καὶ καθόλου ἐπὶ τῶν πέντε φωνῶν ὁρισμὸν καὶ ὑπογραφὴν ἔξεστί σοι λέγειν, ἀλλὰ τὸν μὲν ὁρισμὸν πρὸς τὴν σχέσιν τὴν δὲ ὑπογραφὴν πρὸς τὰ πράγματα.", "seq": 4231}
{"id": "David_Passim_4232", "series": "CAG", "text": "11.", "seq": 4232}
{"id": "David_Passim_4233", "series": "CAG", "text": "1 Ὁ γὰρ ἄνθρωπος τοῦ ζῴου πλέον ἔχει τὸ λογικόν.", "seq": 4233}
{"id": "David_Passim_4234", "series": "CAG", "text": "Φησὶν ὅτι ἐκ τούτων τὸ εἶδος περιττεύει τῇ διαφορᾷ τοῦ γένους, ὅτι τὸ λογικὸν ἐνεργείᾳ ἐστὶν ἐν τῷ ἀνθρώπῳ, δυνάμει δὲ ἐν τῷ ζῴῳ·", "seq": 4234}
{"id": "David_Passim_4235", "series": "CAG", "text": "πλέον οὖν ἔχει ὁ ἄνθρωπος τὸ λογικὸν τοῦ ζῴου.", "seq": 4235}
{"id": "David_Passim_4236", "series": "CAG", "text": "προσέχοντες δὲ τῇ ἐνεργείᾳ φασὶ τὴν διαφορὰν ἐν τῷ εἴδει πλέον εἶναι ἤπερ ἐν τῷ γένει, ἐπεὶ εἰ μὴ τοῦτο ἦν, οὐκ ἂν τῷ εἴδει ἔλεγον περιττεύειν τὴν διαφορὰν ἤπερ τῷ γένει·", "seq": 4236}
{"id": "David_Passim_4237", "series": "CAG", "text": "τοὐναντίον γὰρ ἐν τῷ γένει πλείονές εἰσιν, ἀλλὰ δυνάμει, λογικὸν καὶ ἄλογον, θνητὸν καὶ ἀθάνατον.", "seq": 4237}
{"id": "David_Passim_4238", "series": "CAG", "text": "11.", "seq": 4238}
{"id": "David_Passim_4239", "series": "CAG", "text": "2 Τὸ γὰρ ζῷον οὔτε οὐδὲν τούτων ἐστίν.", "seq": 4239}
{"id": "David_Passim_4240", "series": "CAG", "text": "Ἀντὶ τοῦ ‘τὸ γένος οὐκέτι οὐκ ἔχει τὰς διαφοράς, ἀλλ᾿ ἔχει’·", "seq": 4240}
{"id": "David_Passim_4241", "series": "CAG", "text": "αἱ δύο γὰρ ἀποφάσεις κατάφασιν ποιοῦσιν.", "seq": 4241}
{"id": "David_Passim_4242", "series": "CAG", "text": "αἰνίττεται δὲ πρὸς τὰ δύο ἐπιχειρήματα ἐκεῖνα·", "seq": 4242}
{"id": "David_Passim_4243", "series": "CAG", "text": "φησὶ γὰρ ὅτι ἔχει αὐτὰ τὸ ζῷον, ἐπεὶ ἐκ τῶν μηδαμῇ μηδαμῶς εὑρίσκονται, ἐνεργείᾳ δὲ οὐκέτι, ἀλλὰ δυνάμει.", "seq": 4243}
{"id": "David_Passim_4244", "series": "CAG", "text": "11.", "seq": 4244}
{"id": "David_Passim_4245", "series": "CAG", "text": "3 Οὔτε πάσας τὰς ἀντικειμένας.", "seq": 4245}
{"id": "David_Passim_4246", "series": "CAG", "text": "Λέγουσιν ὅτι κακῶς εἶπεν οὔτε πάσας τὰς ἀντικειμένας·", "seq": 4246}
{"id": "David_Passim_4247", "series": "CAG", "text": "ὡς αὐτοῦ γὰρ ἔχοντός τινας λέγει οὔτε πάσας.", "seq": 4247}
{"id": "David_Passim_4248", "series": "CAG", "text": "κακῶς δὲ ἂν ἔλεγεν, εἰ μὴ ἐν πολλοῖς ἔδειξεν ὁ Ἀριστοτέλης ἰσοδυναμεῖν τὰ τοιαῦτα τοῖς μερικοῖς·", "seq": 4248}
{"id": "David_Passim_4249", "series": "CAG", "text": "ταὐτὸν γάρ ἐστι λέγειν ‘οἱ ἄνθρωποι οὐ λούονται’ καὶ ‘οὐδεὶς ἀνθρώπων λούεται’.", "seq": 4249}
{"id": "David_Passim_4250", "series": "CAG", "text": "εἰπὼν οὖν καὶ ὧδε ὁ Πορφύριος τὸ οὔτε πάσας εἶπεν οὐδεμίαν.", "seq": 4250}
{"id": "David_Passim_4251", "series": "CAG", "text": "11.", "seq": 4251}
{"id": "David_Passim_4252", "series": "CAG", "text": "4 Ἀλλ᾿ ὡς ἀξιοῦσι.", "seq": 4252}
{"id": "David_Passim_4253", "series": "CAG", "text": "Βούλεται δεῖξαι ὅτι οὐκ ἔστι τῆς δόξης τῶν Περιπατητικῶν, ἀλλὰ τῶν Πλατωνικῶν, καὶ διὰ τοῦτο εἶπεν ὡς ἀξιοῦσιν.", "seq": 4253}
{"id": "David_Passim_4254", "series": "CAG", "text": "11.", "seq": 4254}
{"id": "David_Passim_4255", "series": "CAG", "text": "6 Οὔτε τὰ ἀντικείμενα εἴδη περὶ τὸ αὐτὸ ἔσται.", "seq": 4255}
{"id": "David_Passim_4256", "series": "CAG", "text": "Βούλονταί τινες εἰς συμφωνίαν ἀγαγεῖν Ἀριστοτέλην καὶ Πλάτωνα τοιούτοις κεχρημένοι ἐπιχειρήμασιν·", "seq": 4256}
{"id": "David_Passim_4257", "series": "CAG", "text": "ἔστι τι πρῶτον δυνάμει καὶ δεύτερον δυνάμει, ὅπερ διὰ μέσου λέγομεν, ἔστι δὲ καὶ πρῶτον ἐνεργείᾳ καὶ δεύτερον.", "seq": 4257}
{"id": "David_Passim_4258", "series": "CAG", "text": "πρῶτον μὲν δυνάμει φαμὲν ὡς ἵνα εἴπῃς ‘ὁ παῖς δυνάμει γραμματικός ἐστι’, τοῦτ᾿ ἔστι κατ᾿ ἐπιτηδειότητα·", "seq": 4258}
{"id": "David_Passim_4259", "series": "CAG", "text": "εἰ μὴ γὰρ ἐπιλίπῃ ὁ χρόνος, γραμματικὸς ὁ παῖς γίνεται, καὶ ἑκάστην ἐπιστήμην δέχεται τοῦ χρόνου μὴ ἐπιλιμπάνοντος.", "seq": 4259}
{"id": "David_Passim_4260", "series": "CAG", "text": "δεύτερον δὲ δυνάμει φασὶ τὸν ἤδη ἐν ἕξει ἔχοντα τὸ γραμματικεύεσθαι, μηκέτι δὲ ἐνεργοῦντα, τοῦτ᾿ ἔστι κατὰ τὸ παύεσθαι τῆς ἐνεργείας.", "seq": 4260}
{"id": "David_Passim_4261", "series": "CAG", "text": "πρῶτον δὲ ἐνεργείᾳ φασὶ τὸν δυνάμενον γραμματικεύεσθαι καθεύδοντα δὲ ἢ ἐξηγεῖσθαι μὴ βουλόμενον, τοῦτ᾿ ἔστι καθ᾿ ἕξιν.", "seq": 4261}
{"id": "David_Passim_4262", "series": "CAG", "text": "δεύτερον δὲ ἐνεργείᾳ φασὶ τὸν γραμματικὸν τὸν ἐξηγούμενον καὶ ἐνεργοῦντα, τοῦτ᾿ ἔστι κατὰ προχείρησιν.", "seq": 4262}
{"id": "David_Passim_4263", "series": "CAG", "text": "σκόπει δὲ ὅτι ταὐτόν ἐστι τὸ δεύτερον δυνάμει καὶ πρῶτον ἐνεργείᾳ·", "seq": 4263}
{"id": "David_Passim_4264", "series": "CAG", "text": "τὸ γὰρ δεύτερον δυνάμει τὸν γραμματικόν φησι τὸν ἕξιν ἔχοντα γραμματικεύεσθαι, μὴ ἐνεργοῦντα δέ.", "seq": 4264}
{"id": "David_Passim_4265", "series": "CAG", "text": "ταὐτὸν δὲ καὶ τὸ πρῶτον ἐνεργείᾳ ἐστίν.", "seq": 4265}
{"id": "David_Passim_4266", "series": "CAG", "text": "εἰ οὖν τὰ αὐτά ἐστι, συμφωνεῖ Ἀριστοτέλης καὶ Πλάτων·", "seq": 4266}
{"id": "David_Passim_4267", "series": "CAG", "text": "ὁ μὲν γὰρ λέγει τὸ ὕστερον δυνάμει ὁ δὲ τὸ πρῶτον ἐνεργείᾳ, εἰς ταὐτὸν δὲ ἄμφω συνάγονται.", "seq": 4267}
{"id": "David_Passim_4268", "series": "CAG", "text": "τινὲς δὲ καλῶς ἐναντιούμενοί φασιν ὅτι ταὐτόν ἐστι τὸ ἐν ἕξει ἔχειν τὸ γραμματικεύεσθαι καὶ τὸ ἐνεργεῖν τὸν γραμματικόν, εἴ γε καὶ ἐν πολλοῖς τὸ αὐτὸ δεικνύει ὁ Ἀριστοτέλης λέγων ὅτι ὁ ἐν ἕξει ἔχων καὶ ἀμέσως ἐνεργεῖ·", "seq": 4268}
{"id": "David_Passim_4269", "series": "CAG", "text": "οὔτε γὰρ ἄλλον λαμβάνω τὸν ἐν ἕξει γραμματικὸν καὶ ἄλλον τὸν ἐνεργοῦντα·", "seq": 4269}
{"id": "David_Passim_4270", "series": "CAG", "text": "ὁ αὐτὸς γάρ ἐστιν.", "seq": 4270}
{"id": "David_Passim_4271", "series": "CAG", "text": "εἰ οὖν ταῦτα οὕτως ἔχει, ἄλλο μέν ἐστι τὸ ἐνεργείᾳ καὶ ἄλλο τὸ δυνάμει.", "seq": 4271}
{"id": "David_Passim_4272", "series": "CAG", "text": "δυνάμει δὲ ὁ Ἀριστοτέλης φησὶ τὸ μὴ ἐν ἕξει ὑπάρχον, ἐπεὶ εὐθέως ἐνεργήσει, ἓν δὲ ὁ Πλάτων τὸ ἐν ἕξει καὶ ἐνεργείᾳ.", "seq": 4272}
{"id": "David_Passim_4273", "series": "CAG", "text": "ἰστέον δὲ ὅτι τὸ δυνάμει ἐν ἕξει γινόμενον οὐ τὸ αὐτὸ μένει·", "seq": 4273}
{"id": "David_Passim_4274", "series": "CAG", "text": "τὸ γὰρ παιδίον δυνάμει ὂν γραμματικόν, ὅταν ἐν ἕξει λάβῃ τὸ γραμματικεύεσθαι, οὐ τὸ αὐτὸ μένει.", "seq": 4274}
{"id": "David_Passim_4275", "series": "CAG", "text": "Πρᾶξις κθ΄.", "seq": 4275}
{"id": "David_Passim_4276", "series": "CAG", "text": "Πάρεστιν ὁ Πορφύριος ἑτέρως ἡμῖν ὁριζόμενος τὴν διαφοράν·", "seq": 4276}
{"id": "David_Passim_4277", "series": "CAG", "text": "φησὶ γὰρ διαφορά ἐστι τὸ κατὰ πλειόνων καὶ διαφερόντων τῷ εἴδει ἐν τῷ ὁποῖόν τί ἐστι κατηγορούμενον.", "seq": 4277}
{"id": "David_Passim_4278", "series": "CAG", "text": "ἐπειδὴ δὲ περὶ τοῦ ὁποῖόν τί ἐστι μόνον διδάσκει τὰ ἄλλα ὡς ἐγνωσμένα καταλείψας, φέρε συνήθως τὰ ἐν τοῖς καταλειφθεῖσιν ἀπορούμενα ἐπιλυσώμεθα·", "seq": 4278}
{"id": "David_Passim_4279", "series": "CAG", "text": "τινὲς γάρ φασιν ὅτι κακῶς εἶπε τὸ κατὰ πλειόνων·", "seq": 4279}
{"id": "David_Passim_4280", "series": "CAG", "text": "εἰ γὰρ τὸ κατὰ πλειόνων φερόμενον κοινωνίαν δηλοῖ, οὐχὶ διαφοράν, ὁμολογουμένως κακῶς ἔχει ὁ ὁρισμός.", "seq": 4280}
{"id": "David_Passim_4281", "series": "CAG", "text": "ἔστι δὲ πρὸς τοῦτο οὕτως ἀπολογήσασθαι·", "seq": 4281}
{"id": "David_Passim_4282", "series": "CAG", "text": "τῶν διαφορῶν αἱ μὲν μερικαί εἰσιν αἱ δὲ καθολικαί, καὶ μερικαὶ μὲν ὡς ἵνα εἴπῃς τὸ ἐν τῷ σώματι φαλακρόν, καθολικαὶ δὲ ὡς ἵνα εἴπῃς τὸ ἐν τῷ ἀνθρώπῳ λογικὸν καὶ ἐν ἀγγέλῳ.", "seq": 4282}
{"id": "David_Passim_4283", "series": "CAG", "text": "καὶ περὶ μὲν τῶν μερικῶν οὐδεὶς λόγος τοῖς φιλοσόφοις, περὶ δὲ τῶν καθολικῶν.", "seq": 4283}
{"id": "David_Passim_4284", "series": "CAG", "text": "ὁρίζεται τοίνυν ὁ Πορφύριος οὐ τὴν μερικὴν διαφοράν, ἀλλὰ τὴν καθόλου.", "seq": 4284}
{"id": "David_Passim_4285", "series": "CAG", "text": "ἐπειδὴ οὖν καθολική ἐστι, κατὰ πλειόνων κατηγορεῖται·", "seq": 4285}
{"id": "David_Passim_4286", "series": "CAG", "text": "ἀμέλει οὐδ᾿ ὡς διαφορὰ λαμβάνεται κατὰ πλειόνων, ἀλλ᾿ ὡς καθόλου, ἐπεὶ εἰ ὡς διαφορὰ κατὰ πλειόνων ἐλαμβάνετο, ὀφείλει καὶ ἑκάστη διαφορὰ κατὰ πλειόνων λαμβάνεσθαι.", "seq": 4286}
{"id": "David_Passim_4287", "series": "CAG", "text": "εἰ δὲ οὐ λαμβάνεται (ἡ γὰρ μερικὴ μόνον Σωκράτους ἐστί), σαφὲς ὅτι οὐ τῆς διαφορᾶς ἐστι τὸ κατὰ πλειόνων κατηγορεῖσθαι, ἀλλὰ τὸ καθόλου ἐστὶ τὸ αἴτιον.", "seq": 4287}
{"id": "David_Passim_4288", "series": "CAG", "text": "ἔτι πάλιν τοῦ ὁρισμοῦ ἐπιλαμβάνονται καί φασιν ὅτι κακῶς εἶπε τὸ κατὰ πλειόνων καὶ διαφερόντων τῷ εἴδει·", "seq": 4288}
{"id": "David_Passim_4289", "series": "CAG", "text": "κατηγορεῖται γὰρ οὐ μόνον διαφερόντων τῷ εἴδει, ἀλλὰ καὶ τῷ ἀριθμῶ·", "seq": 4289}
{"id": "David_Passim_4290", "series": "CAG", "text": "τὸ γὰρ νοῦ καὶ ἐπιστήμης δεκτικὸν οὐκ ἔστι πλειόνων διαφερόντων τῷ εἴδει ἀλλὰ τῷ ἀριθμῷ·", "seq": 4290}
{"id": "David_Passim_4291", "series": "CAG", "text": "ἀνθρώπων γάρ ἐστι μόνων·", "seq": 4291}
{"id": "David_Passim_4292", "series": "CAG", "text": "οἱ ἄνθρωποι δὲ οὐ τῷ εἴδει διαφέρουσιν, ἀλλὰ τῷ ἀριθμῷ·", "seq": 4292}
{"id": "David_Passim_4293", "series": "CAG", "text": "οὔτε γὰρ τῆς ὑπερτέρας οὐσίας ἐστὶ τὸ νοῦ καὶ ἐπιστήμης δεκτικὸν διὰ τὸ μὴ δέεσθαι οὔτε τῆς χείρονος διὰ τὸ μὴ δύνασθαι.", "seq": 4293}
{"id": "David_Passim_4294", "series": "CAG", "text": "καλῶς δὲ οὗτοι λέγουσιν, ἀλλ᾿ εὑρίσκεται ἐν πολλοῖς τῶν βιβλίων καὶ ὁ καί σύνδεσμος·", "seq": 4294}
{"id": "David_Passim_4295", "series": "CAG", "text": "τὸ κατὰ πλειόνων καὶ διαφερόντων καὶ τῷ εἴδει, ὥστε οὖν συνυπακούεται τῷ ἀριθμῷ.", "seq": 4295}
{"id": "David_Passim_4296", "series": "CAG", "text": "Ἔλθωμεν δὲ ἐπὶ τὴν ἐξήγησιν τοῦ φιλοσόφου.", "seq": 4296}
{"id": "David_Passim_4297", "series": "CAG", "text": "διὰ δύο ἐπιχειρημάτων δεικνύει ὅτι ἐν τῷ ὁποῖόν τί ἐστι κατηγορεῖται ἡ διαφορά, ὧν τὸ πρῶτόν ἐστι τοιοῦτον·", "seq": 4297}
{"id": "David_Passim_4298", "series": "CAG", "text": "ἡμῶν ἐρωτώντων ‘ποῖόν τί ἐστιν;’", "seq": 4298}
{"id": "David_Passim_4299", "series": "CAG", "text": "οὐκ ἀποκρίνεταί τις λέγων ζῷον, ἀλλὰ τοιόνδε ζῷον, λογικὸν ἢ ἄλογον, ὥστε οὖν ἐκ τῆς ἐρωτήσεως ἡ ἀπόκρισις καὶ ἐκ τῆς ἀποκρίσεως ἡ κατηγορία δηλοῦται.", "seq": 4299}
{"id": "David_Passim_4300", "series": "CAG", "text": "τὸ δεύτερον δὲ τοιοῦτον·", "seq": 4300}
{"id": "David_Passim_4301", "series": "CAG", "text": "τὰ πράγματα ἐξ ὕλης καὶ μορφῆς συνίσταται ἢ ἐκ τῶν ἀναλογούντων τῇ ὕλῃ καὶ τῇ μορφῇ·", "seq": 4301}
{"id": "David_Passim_4302", "series": "CAG", "text": "ἀναλογεῖ δὲ τῇ μὲν ὕλῃ τὸ γένος, τῇ δὲ μορφῇ ἡ διαφορά·", "seq": 4302}
{"id": "David_Passim_4303", "series": "CAG", "text": "ὃν γὰρ τρόπον ἐξηπλωμένη ἐστὶν ἡ ὕλη, τοῦτον τὸν τρόπον καὶ τὸ γένος, καὶ ὃν τρόπον προσερχόμεναι αἱ μορφαὶ ἀτομοῦσι τὴν ὕλην καὶ εἰς ἄπειρον ἐξαπλοῦσι, τοῦτον τὸν τρόπον καὶ αἱ διαφοραὶ ἀτομοῦσι τὸ γένος ἐξαπλούμενον.", "seq": 4303}
{"id": "David_Passim_4304", "series": "CAG", "text": "εἰ δὲ ἀναλογεῖ τῇ μορφῇ ἡ διαφορά, ἡ μορφὴ δὲ ποῖόν τί ἐστιν, ὥς φησιν ὁ Ἀριστοτέλης ἐν ταῖς Κατηγορίαις, σαφὲς ὅτι καὶ ἡ διαφορὰ ποῖόν τί ἐστιν.", "seq": 4304}
{"id": "David_Passim_4305", "series": "CAG", "text": "11.", "seq": 4305}
{"id": "David_Passim_4306", "series": "CAG", "text": "7 Ὁρίζονται δὲ αὐτὴν καὶ οὕτως.", "seq": 4306}
{"id": "David_Passim_4307", "series": "CAG", "text": "Ἐδείξαμεν πλειστάκις ὅτι ποτὲ μὲν ὑπογράφεσθαι λέγει τὰς τοιαύτας φωνάς, ποτὲ δὲ ὁρίζεσθαι, καὶ διὰ τί ἐγνώκαμεν.", "seq": 4307}
{"id": "David_Passim_4308", "series": "CAG", "text": "11.", "seq": 4308}
{"id": "David_Passim_4309", "series": "CAG", "text": "13 Ἢ ἀνάλογόν γε ὕλῃ καὶ εἴδει τὴν σύστασιν ἐχόντων.", "seq": 4309}
{"id": "David_Passim_4310", "series": "CAG", "text": "Εἴδει λέγει τῇ μορφῇ.", "seq": 4310}
{"id": "David_Passim_4311", "series": "CAG", "text": "ἀναλογεῖ δὲ τούτοις δύο, τῇ μὲν ὕλῃ τὸ γένος, τῷ δὲ εἴδει ἡ διαφορά.", "seq": 4311}
{"id": "David_Passim_4312", "series": "CAG", "text": "11.", "seq": 4312}
{"id": "David_Passim_4313", "series": "CAG", "text": "14 Εἴδους δὲ τοῦ σχήματος.", "seq": 4313}
{"id": "David_Passim_4314", "series": "CAG", "text": "Καλῶς εἶπε·", "seq": 4314}
{"id": "David_Passim_4315", "series": "CAG", "text": "τὸ γὰρ σχῆμα ἐκ τῆς μορφῆς γίνεται·", "seq": 4315}
{"id": "David_Passim_4316", "series": "CAG", "text": "ἀμέλει ἐκτὸς τῆς μορφῆς χαλκὸς μόνον εὑρίσκεται.", "seq": 4316}
{"id": "David_Passim_4317", "series": "CAG", "text": "11.", "seq": 4317}
{"id": "David_Passim_4318", "series": "CAG", "text": "14 Οὕτω καὶ ὁ ἄνθρωπος ὁ κοινός τε καὶ εἰδικός.", "seq": 4318}
{"id": "David_Passim_4319", "series": "CAG", "text": "Αἰνίττεται ὧδε τὰς διττὰς διαφοράς, φημὶ δὲ τὰς μερικὰς καὶ καθολικάς·", "seq": 4319}
{"id": "David_Passim_4320", "series": "CAG", "text": "ὁ γὰρ κοινὸς ἄνθρωπος δηλοῖ τὴν καθολικήν (ὁ γὰρ καθόλου τὸ λογικὸν ἔχει καὶ τὸ ζῷον, ἅπερ εἰς πολλοὺς συντείνει), ὁ δὲ εἰδικὸς ἔχει καὶ τὴν μερικήν, οἷον Σωκράτης τὸ προκοίλιον.", "seq": 4320}
{"id": "David_Passim_4321", "series": "CAG", "text": "11.", "seq": 4321}
{"id": "David_Passim_4322", "series": "CAG", "text": "16 Τὸ δὲ ὅλον τοῦτο, ζῷον λογικὸν θνητόν, ὁ ἄνθρωπος, ὡς ἐκεῖ ὁ ἀνδριάς.", "seq": 4322}
{"id": "David_Passim_4323", "series": "CAG", "text": "Φησὶν ὅτι τὸ συνίστασθαι ἐκ γένους καὶ διαφορῶν δηλοῖ τὸν ἄνθρωπον, ὡς ἡ ὕλη καὶ ἡ μορφὴ τὸν ἀνδριάντα.", "seq": 4323}
{"id": "David_Passim_4324", "series": "CAG", "text": "Πρᾶξις λ΄.", "seq": 4324}
{"id": "David_Passim_4325", "series": "CAG", "text": "Πάρεστιν ὁ Πορφύριος ὁμοίως ἀποδώσων τὴν διαφορὰν καί φησιν ὅτι διαφορά ἐστι τὸ χωρίζειν πεφυκὸς τὰ ὑπὸ τὸ αὐτὸ γένος, προστίθησι δὲ τὸ οὐσιωδῶς.", "seq": 4325}
{"id": "David_Passim_4326", "series": "CAG", "text": "καλῶς ἔχει ὁ ὁρισμός·", "seq": 4326}
{"id": "David_Passim_4327", "series": "CAG", "text": "δηλοῖ γὰρ ὅτι ἡ διαφορὰ τὰ ὑπὸ τὸ αὐτὸ γένος χωρίζει, τὸ θνητὸν τοῦ ἀθανάτου, τὸ λογικὸν τοῦ ἀλόγου.", "seq": 4327}
{"id": "David_Passim_4328", "series": "CAG", "text": "ἄλλως δὲ ἀποδίδωσιν αὐτὴν διαφορά ἐστιν ᾧ διαφέρει ἕκαστα.", "seq": 4328}
{"id": "David_Passim_4329", "series": "CAG", "text": "ζητοῦσι δέ τινες διὰ τί μόνην τὴν διαφορὰν τετραχῶς ἀποδέδωκεν.", "seq": 4329}
{"id": "David_Passim_4330", "series": "CAG", "text": "ἔστι δὲ ἐπιλύσασθαι οὕτω τὸ ζητούμενον·", "seq": 4330}
{"id": "David_Passim_4331", "series": "CAG", "text": "οὐδεὶς τῶν ὁρισμῶν ἀδολεσχίας εὐθύνας δίδωσι·", "seq": 4331}
{"id": "David_Passim_4332", "series": "CAG", "text": "πάντες γὰρ ἀναγκαίως παρεδόθησαν·", "seq": 4332}
{"id": "David_Passim_4333", "series": "CAG", "text": "ὁ μὲν γὰρ πρῶτος περιέχει τὰς διαιρετικὰς καὶ συστατικάς, εἴ γε λέγει περισσεύειν τὸ εἶδος τοῦ γένους, καὶ ἐν μὲν τῷ δηλοῦν εἶναι ἐν τῷ γένει διαφορὰς τὰς διαιρετικὰς σημαίνει (αἱ γὰρ ἐν τῷ γένει διαφοραὶ διαιρετικαί εἰσιν), ἐν δὲ τῷ δηλοῦν εἶναι ἐν τῷ εἴδει διαφορὰς τὰς συστατικὰς σημαίνει·", "seq": 4333}
{"id": "David_Passim_4334", "series": "CAG", "text": "αἱ γὰρ συστατικαὶ εἰδῶν εἰσι.", "seq": 4334}
{"id": "David_Passim_4335", "series": "CAG", "text": "διεμερίσαντο δὲ τὸν πρῶτον ὅ τε δεύτερος καὶ ὁ τρίτος.", "seq": 4335}
{"id": "David_Passim_4336", "series": "CAG", "text": "καὶ ὁ μὲν δεύτερος τὰς συστατικὰς δηλοῖ·", "seq": 4336}
{"id": "David_Passim_4337", "series": "CAG", "text": "ἐν γὰρ τῷ λέγειν τὸ κατὰ πλειόνων καὶ διαφερόντων τῷ εἴδει δηλοῖ τὰς συστατικάς·", "seq": 4337}
{"id": "David_Passim_4338", "series": "CAG", "text": "αἱ γὰρ ἐν τοῖς εἴδεσι κατηγορούμεναι διαφοραὶ συστατικαί εἰσιν.", "seq": 4338}
{"id": "David_Passim_4339", "series": "CAG", "text": "ὁ δὲ τρίτος τὰς διαιρετικάς·", "seq": 4339}
{"id": "David_Passim_4340", "series": "CAG", "text": "φησὶ γὰρ διαφορά ἐστι τὸ χωρίζειν πεφυκὸς τὰ ὑπὸ τὸ αὐτὸ γένος οὐσιωδῶς.", "seq": 4340}
{"id": "David_Passim_4341", "series": "CAG", "text": "σαφὲς δὲ ὑπάρχει ὡς τὸ διαχωρίζον διαιρεῖ.", "seq": 4341}
{"id": "David_Passim_4342", "series": "CAG", "text": "ὁ τέταρτος δὲ τὴν ἁπλῶς διαφορὰν δηλοῖ.", "seq": 4342}
{"id": "David_Passim_4343", "series": "CAG", "text": "καὶ μὴ νόμιζε ὅτι κἂν ὕστερον παρεδόθη καὶ ἐκ τοῦ ὀνόματος εἴληφε τὴν σύστασιν, ἐλάχιστός ἐστι τῶν προειρημένων·", "seq": 4343}
{"id": "David_Passim_4344", "series": "CAG", "text": "κρείττων γάρ ἐστι τῶν ἄλλων τριῶν, ὡς καὶ αὐτῷ φαίνεται τῷ Πορφυρίῳ·", "seq": 4344}
{"id": "David_Passim_4345", "series": "CAG", "text": "οὔτε γὰρ δέχεται τὸν πρῶτον ὁρισμόν, εἴ γε τοῦτο δηλοῖ λέγων ὡς λέγουσι, καὶ τὸν δεύτερον κακῶς ἔχειν ἐδείξαμεν, κἂν τὸν καί ἀπολάβῃ σύνδεσμον·", "seq": 4345}
{"id": "David_Passim_4346", "series": "CAG", "text": "ποτὲ γὰρ σημαίνει τῷ ἀριθμῷ διαφερόντων κατηγορεῖσθαι τὴν διαφορὰν καὶ ποτὲ τῷ εἴδει.", "seq": 4346}
{"id": "David_Passim_4347", "series": "CAG", "text": "τὸ δὲ ἔχειν ὁρισμὸν ποτὲ μὲν τοῦτο ποτὲ δὲ ἐκεῖνο κακίαν σημαίνει.", "seq": 4347}
{"id": "David_Passim_4348", "series": "CAG", "text": "ὁ τρίτος δὲ ἐλλιπὴς ὑπάρχει·", "seq": 4348}
{"id": "David_Passim_4349", "series": "CAG", "text": "εἴπομεν γὰρ ὅτι προσθεῖναι τούτῳ τὸ οὐσιωδῶς χρή.", "seq": 4349}
{"id": "David_Passim_4350", "series": "CAG", "text": "ὁ τέταρτος δὲ τί ποτε τῶν τοιούτων;", "seq": 4350}
{"id": "David_Passim_4351", "series": "CAG", "text": "οὐκ ἔχει, ἀλλὰ πᾶσαν διαφορὰν δηλοῖ.", "seq": 4351}
{"id": "David_Passim_4352", "series": "CAG", "text": "Εἰρηκότες οὖν τὰ οἰκεῖα τῶν τεσσάρων ὁρισμῶν, φέρε ἐπὶ ἑτέραν ζήτησιν χωρήσωμεν·", "seq": 4352}
{"id": "David_Passim_4353", "series": "CAG", "text": "ζητεῖται γὰρ διὰ τί προσέθηκε τῷ τρίτῳ ὁρισμῷ τὸ οὐσιωδῶς.", "seq": 4353}
{"id": "David_Passim_4354", "series": "CAG", "text": "αὐτὸς δὲ ὁ Πορφύριός φησιν ὅτι τὸ οὐσιωδῶς δεῖ προστεθῆναι, ἵνα τὰς οὐσιώδεις δηλώσωμεν, ἐπεὶ καὶ αἱ συμβεβηκυῖαι διαχωρίζουσι τὰ ὑπὸ τὸ αὐτὸ γένος·", "seq": 4354}
{"id": "David_Passim_4355", "series": "CAG", "text": "τὸ γὰρ πλεῖν διαχωρίζει τὸν ἄνθρωπον ἀπὸ τῶν ἄλλων ζῴων καὶ τὸ γελαστικὸν καὶ τὸ πλατυώνυχον.", "seq": 4355}
{"id": "David_Passim_4356", "series": "CAG", "text": "ταῦτα δὲ ἐπὶ τοῦ ἀνθρώπου λέγονται.", "seq": 4356}
{"id": "David_Passim_4357", "series": "CAG", "text": "ἐντεῦθεν δὲ δύο ἀπορίαι ἡμῖν ἀναφύονται ἤτοι ζητήσεις, ὧν ἡ πρώτη ἐστὶ τοιαύτη·", "seq": 4357}
{"id": "David_Passim_4358", "series": "CAG", "text": "ζητοῦσι πῶς μόνῳ τῷ ἀνθρώπῳ ὑπάρχει τὸ πλεῖν·", "seq": 4358}
{"id": "David_Passim_4359", "series": "CAG", "text": "ὁρῶμεν γάρ φασι καὶ ἄλλα ζῷα νήχεσθαι ἐπιστάμενα.", "seq": 4359}
{"id": "David_Passim_4360", "series": "CAG", "text": "πρὸς τοῦτο δὲ ἡμεῖς λέγομεν οὕτως·", "seq": 4360}
{"id": "David_Passim_4361", "series": "CAG", "text": "οὐ λέγει ὁ Πορφύριος τὸ πλεῖν τὸ νήχεσθαι, ἀλλὰ τὸ τεκταίνεσθαι·", "seq": 4361}
{"id": "David_Passim_4362", "series": "CAG", "text": "τὸ τεκταίνεσθαι δὲ μόνῳ τῷ ἀνθρώπῳ ὑπάρχει.", "seq": 4362}
{"id": "David_Passim_4363", "series": "CAG", "text": "ἐντεῦθεν δὲ δριμυτέρα ἀπορία ἡμᾶς διαδέχεται·", "seq": 4363}
{"id": "David_Passim_4364", "series": "CAG", "text": "φασὶ γὰρ ὅτι εἰ τὸ τεκταίνεσθαι λέγετε φάσκειν αὐτὸν τὸ πλεῖν, ἔσται ἐντεῦθεν ἕτερον ἄπορον, διὰ τί τὸ τεκταίνεσθαι συμβεβηκὸς λέγει καὶ οὐκ οὐσιῶδες·", "seq": 4364}
{"id": "David_Passim_4365", "series": "CAG", "text": "ὅτι γὰρ τὸ τεκταίνεσθαι οὐσία τοῦ ἀνθρώπου ὑπάρχει, σαφὲς ἐκ τοῦ ὁρισμοῦ τοῦ ἀνθρώπου ‘ζῷον λογικὸν θνητὸν νοῦ καὶ ἐπιστήμης δεκτικόν’.", "seq": 4365}
{"id": "David_Passim_4366", "series": "CAG", "text": "τὸ δὲ δύνασθαι τεκταίνεσθαι μέρος ἐστὶ τοῦ δεκτικοῦ <τῆς ἐπιστήμης> (πάντες γὰρ οἱ ἄνθρωποι δεκτικοί εἰσι τοῦ τεκταίνεσθαι)·", "seq": 4366}
{"id": "David_Passim_4367", "series": "CAG", "text": "εἰ δὲ μέρος τοῦ δεκτικοῦ τῆς ἐπιστήμης ἐστὶ τὸ τεκταίνεσθαι, σαφὲς ὅτι οὐσία ἐστί·", "seq": 4367}
{"id": "David_Passim_4368", "series": "CAG", "text": "τὰ γὰρ μέρη τῶν οὐσιῶν οὐσίαι εἰσίν, ὥς φησιν ὁ Ἀριστοτέλης ἐν ταῖς Κατηγορίαις.", "seq": 4368}
{"id": "David_Passim_4369", "series": "CAG", "text": "πῶς οὖν τὸ πλεῖν συμβεβηκὸς λέγει ὁ Πορφύριος;", "seq": 4369}
{"id": "David_Passim_4370", "series": "CAG", "text": "ἔστι δὲ ἀπολογήσασθαι ὑπὲρ τούτου οὕτως·", "seq": 4370}
{"id": "David_Passim_4371", "series": "CAG", "text": "ἔστι τι πρῶτον καὶ δεύτερον, πρῶτον μὲν ὁ ἄνθρωπος, δεύτερον δὲ ὁ τοιοῦτος ἄνθρωπος, γραμματικὸς ἢ κολοβὸς ἢ μακρός.", "seq": 4371}
{"id": "David_Passim_4372", "series": "CAG", "text": "ἔστι δέ τι καὶ καθ᾿ ἑαυτὸ καὶ συμβεβηκός·", "seq": 4372}
{"id": "David_Passim_4373", "series": "CAG", "text": "καθ᾿ ἑαυτὸ μὲν τὸ ζῷον, συμβεβηκὸς δὲ τὸ λευκὸν τὸ γελαστικόν.", "seq": 4373}
{"id": "David_Passim_4374", "series": "CAG", "text": "εἰ οὖν ταῦτα οὕτως ἔχει, ὁ ἄνθρωπος δὲ πρῶτός ἐστι τὸ γραμματικεύεσθαι δὲ δεύτερον, ὁ Πορφύριος προσέχων τῷ δευτέρῳ τὰ τοιαῦτα λέγει ἐπουσιώδη, ὥσπερ τὰ δευτερεύοντα τοῦ ζῴου ἐπουσιώδη εἰσίν.", "seq": 4374}
{"id": "David_Passim_4375", "series": "CAG", "text": "ἰστέον δὲ ὡς οὐχ ὁ ὁρισμὸς οὗτος δηλοῖ τὰς ἀνομοιογενεῖς ἀλλὰ τὰς ὁμοιογενεῖς·", "seq": 4375}
{"id": "David_Passim_4376", "series": "CAG", "text": "ἐν γὰρ τῷ λέγειν ὑπὸ τὸ αὐτὸ γένος τοῦτο δηλοῖ.", "seq": 4376}
{"id": "David_Passim_4377", "series": "CAG", "text": "ὥστε οὖν τὰς ὑπὸ τὴν οὐσίαν καὶ ποιότητα οὐ δηλοῖ·", "seq": 4377}
{"id": "David_Passim_4378", "series": "CAG", "text": "ἀνομοιογενεῖς γάρ εἰσιν αἱ τοιαῦται διαφοραί.", "seq": 4378}
{"id": "David_Passim_4379", "series": "CAG", "text": "Δύο δέ τινα ἀπορήσαντες ἐπ᾿ αὐτὰ καταπαύσωμεν τὸν λόγον.", "seq": 4379}
{"id": "David_Passim_4380", "series": "CAG", "text": "πρῶτον εἰ τὰ συνωνυμοῦντα μεταδίδωσιν ὀνόματος καὶ πράγματος, πάντως δὲ λέγουσι συνωνύμως κατηγορεῖσθαι τὰς διαφορὰς τῶν εἰδῶν, τί δήποτε οὐ μεταδιδόασιν αἱ διαφοραὶ τοῖς εἴδεσιν ὀνόματος καὶ πράγματος, ἀλλὰ μόνου πράγματος;", "seq": 4380}
{"id": "David_Passim_4381", "series": "CAG", "text": "οὔτε γὰρ τὴν λογικότητα λογικόν φαμεν οὔτε τὴν θνητότητα θνητόν.", "seq": 4381}
{"id": "David_Passim_4382", "series": "CAG", "text": "τὸ δὲ μεταδιδόναι πράγματος ὁμολογεῖται.", "seq": 4382}
{"id": "David_Passim_4383", "series": "CAG", "text": "ἔστι δὲ πρὸς ταῦτα οὕτως εἰπεῖν·", "seq": 4383}
{"id": "David_Passim_4384", "series": "CAG", "text": "τὰ συνωνυμοῦντα διττά ἐστι·", "seq": 4384}
{"id": "David_Passim_4385", "series": "CAG", "text": "τὰ μὲν γὰρ μεταδίδωσιν ὀνόματος καὶ πράγματος, ὥσπερ τὸ ζῷον τῷ ἀνθρώπῳ, τὰ δὲ μόνου τοῦ πράγματος, ὥσπερ αἱ διαφοραί.", "seq": 4385}
{"id": "David_Passim_4386", "series": "CAG", "text": "ἔχομεν δὲ ἐντεῦθεν προσπορίσματος μοῖραν, ὅτι ἄλλο μέν ἐστι διαφορὰ καὶ ἄλλο εἶδος·", "seq": 4386}
{"id": "David_Passim_4387", "series": "CAG", "text": "εἰ γὰρ τὸ χωρίζον ἄλλο τοῦ χωριζομένου καθέστηκε, διαχωρίζει δὲ ἡ διαφορὰ τὰ εἴδη, ὁμολογουμένως ἄλλο ἐστὶ διαφορὰ καὶ ἄλλο εἶδος.", "seq": 4387}
{"id": "David_Passim_4388", "series": "CAG", "text": "ἐπαποροῦσι δὲ διὰ τί τὸ εἶδος μᾶλλον συνῳκείωται τῷ γένει ἤπερ τῇ διαφορᾷ, καίτοι ὤφειλε πρὸς τὴν διαφορὰν ἔχειν πολλὴν οἰκειότητα γειτνιάζον αὐτῇ·", "seq": 4388}
{"id": "David_Passim_4389", "series": "CAG", "text": "ἐν μέσῳ γὰρ τοῦ γένους καὶ τοῦ εἴδους ἵδρυται.", "seq": 4389}
{"id": "David_Passim_4390", "series": "CAG", "text": "ἔστι δὲ εἰπεῖν ὅτι δικαίως πρὸς τὸ γένος ἔχει τὴν σχέσιν ἢ πρὸς τὴν διαφορὰν ἐκ τῶν τοιούτων ἐπιχειρημάτων·", "seq": 4390}
{"id": "David_Passim_4391", "series": "CAG", "text": "εἰ τὰ μεταδιδόντα ὀνόματος καὶ πράγματος πλείω ἔχει τὴν σχέσιν τῶν μόνου τοῦ πράγματος μεταδιδόντων, τὸ δὲ γένος τοῖς εἴδεσι μεταδίδωσιν ὀνόματος καὶ πράγματος, ἡ δὲ διαφορὰ μόνου πράγματος, δεόντως ἄρα τὰ εἴδη πρὸς τὰ γένη ἔχει τὴν σχέσιν ἤπερ πρὸς τὰς διαφοράς.", "seq": 4391}
{"id": "David_Passim_4392", "series": "CAG", "text": "11.", "seq": 4392}
{"id": "David_Passim_4393", "series": "CAG", "text": "18 Ὑπογράφουσι δὲ τὰς τοιαύτας διαφορὰς καὶ οὕτως·", "seq": 4393}
{"id": "David_Passim_4394", "series": "CAG", "text": "διαφορά ἐστι τὸ χωρίζειν πεφυκὸς τὰ ὑπὸ τὸ αὐτὸ γένος.", "seq": 4394}
{"id": "David_Passim_4395", "series": "CAG", "text": "Τὸ ἐλλεῖπον τούτῳ τῷ ὁρισμῷ, λέγω δὲ τὸ οὐσιωδῶς, μετὰ τὴν ἀπόδοσιν τοῦ ἑξῆς ὁρισμοῦ ἀποδίδοται.", "seq": 4395}
{"id": "David_Passim_4396", "series": "CAG", "text": "12.", "seq": 4396}
{"id": "David_Passim_4397", "series": "CAG", "text": "1 Οἱ προσεργαζόμενοι δὲ τὰ περὶ τῆς διαφορᾶς μὴ τὸ τυχόν φασι τῶν χωριζόντων τὰ ὑπὸ τὸ αὐτὸ γένος εἶναι διαφοράν.", "seq": 4397}
{"id": "David_Passim_4398", "series": "CAG", "text": "Ἡ σύνταξις τοιαύτη ἐστίν, ὁ δὲ νοῦς τοιοῦτος·", "seq": 4398}
{"id": "David_Passim_4399", "series": "CAG", "text": "φασὶ ‘μὴ τὴν τυχοῦσαν διαφορὰν ἐπὶ τῶν χωριζόντων τὰ ὑπὸ τὸ αὐτὸ γένος λέγετε·", "seq": 4399}
{"id": "David_Passim_4400", "series": "CAG", "text": "δεῖ γὰρ λέγειν τὸ οὐσιωδῶς’.", "seq": 4400}
{"id": "David_Passim_4401", "series": "CAG", "text": "τοῦτο δὲ δηλοῖ διὰ τῶν ἑξῆς.", "seq": 4401}
{"id": "David_Passim_4402", "series": "CAG", "text": "12.", "seq": 4402}
{"id": "David_Passim_4403", "series": "CAG", "text": "3 Ἀλλ᾿ ὅπερ εἰς τὸ εἶναι συμβάλλεται.", "seq": 4403}
{"id": "David_Passim_4404", "series": "CAG", "text": "Ἀντὶ τοῦ οὐσιωδῶς.", "seq": 4404}
{"id": "David_Passim_4405", "series": "CAG", "text": "12.", "seq": 4405}
{"id": "David_Passim_4406", "series": "CAG", "text": "3 Τοῦ τί ἦν εἶναι.", "seq": 4406}
{"id": "David_Passim_4407", "series": "CAG", "text": "Πρόσρημά ἐστιν Ἀριστοτελικὸν ἐπὶ τῶν οὐσιωδῶς λεγόμενον.", "seq": 4407}
{"id": "David_Passim_4408", "series": "CAG", "text": "12.", "seq": 4408}
{"id": "David_Passim_4409", "series": "CAG", "text": "4 Ὃ καὶ τοῦ πράγματός ἐστι μέρος καὶ εἰς ὁρισμοὺς συμβάλλεται.", "seq": 4409}
{"id": "David_Passim_4410", "series": "CAG", "text": "Καλῶς λέγει·", "seq": 4410}
{"id": "David_Passim_4411", "series": "CAG", "text": "τὸ γὰρ λογικὸν μέρος ἐστὶ τοῦ ἀνθρώπου, συμβάλλεται δὲ καὶ τῷ ὁρισμῷ τοῦ ἀνθρώπου.", "seq": 4411}
{"id": "David_Passim_4412", "series": "CAG", "text": "12.", "seq": 4412}
{"id": "David_Passim_4413", "series": "CAG", "text": "4 Οὐ γὰρ τὸ πεφυκέναι πλεῖν διαφορὰ ἀνθρώπου, εἰ καὶ ἴδιον ἀνθρώπου.", "seq": 4413}
{"id": "David_Passim_4414", "series": "CAG", "text": "Φησὶν ὅτι δεῖ προσθεῖναι τὸ οὐσιωδῶς·", "seq": 4414}
{"id": "David_Passim_4415", "series": "CAG", "text": "εἰ μὴ γὰρ προσθήσομεν τὸ οὐσιωδῶς, συμπεριλαμβάνομεν καὶ τὸ ἴδιον·", "seq": 4415}
{"id": "David_Passim_4416", "series": "CAG", "text": "τὸ γὰρ ἴδιον τοῦ ἀνθρώπου διαχωρίζει αὐτὸν ἀπὸ τῶν ἄλλων·", "seq": 4416}
{"id": "David_Passim_4417", "series": "CAG", "text": "εἰ γὰρ εἴπῃς τὸν ἄνθρωπον τὸ πεφυκὸς γραμματικεύεσθαι, διαχωρίζεις αὐτὸν ἀπὸ τῶν ἄλλων ζῴων, κἂν εἴπῃς τὸν ἵππον τὸ πεφυκὸς χρεμετίζειν, διαχωρίζεις αὐτὸν ἀπὸ τῶν ἄλλων ζῴων.", "seq": 4417}
{"id": "David_Passim_4418", "series": "CAG", "text": "τὰ τοιαῦτα δ᾿ οὐκ ἔστι συμπληρωτικὰ τῶν τοιούτων εἰδῶν.", "seq": 4418}
{"id": "David_Passim_4419", "series": "CAG", "text": "εἰρήκαμεν δὲ ἐν τῇ θεωρίᾳ περὶ τοῦ πλεῖν, ὡς ἐπουσιωδῶς αὐτὸ λαμβάνει.", "seq": 4419}
{"id": "David_Passim_4420", "series": "CAG", "text": "12.", "seq": 4420}
{"id": "David_Passim_4421", "series": "CAG", "text": "9 Καὶ ὅσαι ἐν τῷ τί ἦν εἶναι παραλαμβάνονται.", "seq": 4421}
{"id": "David_Passim_4422", "series": "CAG", "text": "Ἀντὶ τοῦ οὐσιωδῶς.", "seq": 4422}
{"id": "David_Passim_4423", "series": "CAG", "text": "Πρᾶξις λα΄.", "seq": 4423}
{"id": "David_Passim_4424", "series": "CAG", "text": "Περὶ ἰδίου.", "seq": 4424}
{"id": "David_Passim_4425", "series": "CAG", "text": "Αἱ ἀθρόαι μεταβολαὶ οὐ μόνον ἐν πράγμασιν ἀλλὰ καὶ ἐν ταῖς φωναῖς σφάλλειν γινώσκουσαι τὸν Πορφύριον ἐπὶ τὰ συμβεβηκότα χωρεῖν ἀπέτρεψαν·", "seq": 4425}
{"id": "David_Passim_4426", "series": "CAG", "text": "τὰ γὰρ συμβεβηκότα ἐπουσιώδη ὑπάρχοντα ἀθρόως ἀπὸ τῶν οὐσιωδῶν πρόσφατον τὴν διδασκαλίαν οὐκ ἠδύναντο δέξασθαι.", "seq": 4426}
{"id": "David_Passim_4427", "series": "CAG", "text": "εὐλόγως ἄρα ἐπὶ τὸ ἴδιον ἐχώρησεν, ἐπεὶ ὅσον γε ἐν τοῖς ἐπουσιώδεσιν οὐσιῶδες ὑπάρχει.", "seq": 4427}
{"id": "David_Passim_4428", "series": "CAG", "text": "καὶ αὕτη μὲν ἡ πρώτη αἰτία τοῦ μετὰ τὴν διαφορὰν ἐπὶ τὸ ἴδιον χωρεῖν τὸν Πορφύριον.", "seq": 4428}
{"id": "David_Passim_4429", "series": "CAG", "text": "δευτέρα δὲ ἡ τοιαύτη·", "seq": 4429}
{"id": "David_Passim_4430", "series": "CAG", "text": "τὸ ἴδιον ἐν μέσῳ τῆς διαφορᾶς καὶ τοῦ συμβεβηκότος ἵδρυται·", "seq": 4430}
{"id": "David_Passim_4431", "series": "CAG", "text": "ἔστι γὰρ ὅτε οὐσιωδῶς λαμβάνεται, ἔστι δὲ ὅτε καὶ ἐπουσιωδῶς·", "seq": 4431}
{"id": "David_Passim_4432", "series": "CAG", "text": "οὐσιωδῶς μέν, ὡς ἵνα εἴπῃς τὸ νοῦ καὶ ἐπιστήμης δεκτικὸν ἴδιον ὑπάρχειν τοῦ ἀνθρώπου (ἴδιον γὰρ τοῦ ἀνθρώπου ἐστί, καθὸ οὔτε τῆς ὑπερτέρας οὐσίας ἐστὶ διὰ τὸ μὴ δέεσθαι οὔτε τῆς χείρονος διὰ τὸ μὴ δύνασθαι), ἐπουσιωδῶς δὲ λαμβάνεται, ὡς ἵνα εἴπῃς τὸ γελαστικὸν εἶναι ἴδιον ἀνθρώπου·", "seq": 4432}
{"id": "David_Passim_4433", "series": "CAG", "text": "τοῦτο γὰρ ἐπισυμβεβηκός ἐστιν.", "seq": 4433}
{"id": "David_Passim_4434", "series": "CAG", "text": "εἰ οὖν ταῦτα οὕτως ἔχει, ὁμολογουμένως ὀφείλει τὸ ἴδιον τοῦ συμβεβηκότος προτάσσεσθαι.", "seq": 4434}
{"id": "David_Passim_4435", "series": "CAG", "text": "τρίτη δὲ αἰτία ἐστὶ τοιαύτη·", "seq": 4435}
{"id": "David_Passim_4436", "series": "CAG", "text": "τὸ ἴδιον ὀφείλει καὶ τῶν πέντε φωνῶν προτάσσεσθαι·", "seq": 4436}
{"id": "David_Passim_4437", "series": "CAG", "text": "εἰ γὰρ δι᾿ ὑπογραφῶν διδάσκεται τὸ γένος καὶ τὸ εἶδος, ἡ δὲ ὑπογραφὴ ἴδιόν ἐστιν ἀντιστρέφον, ὁμολογουμένως ὤφειλε περὶ τῶν ἰδίων τοῦ γένους πρότερον διαλαβεῖν, εἶθ᾿ ὕστερον περὶ τοῦ γένους.", "seq": 4437}
{"id": "David_Passim_4438", "series": "CAG", "text": "ἀλλὰ τοῖς μὲν οὐσιώδεσι παρεχώρησε διὰ τὸ τίμιον τοῖς δὲ ἐπουσιώδεσι τοῖς τὰ ἴσα φέρουσι τοῦ ἰδίου τόπου οὐ παρεχώρησε.", "seq": 4438}
{"id": "David_Passim_4439", "series": "CAG", "text": "Μαθόντες οὖν περὶ τῆς τάξεως τοῦ ἰδίου, φέρε καὶ ἐπὶ τὴν αὐτοῦ διδασκαλίαν χωρήσωμεν.", "seq": 4439}
{"id": "David_Passim_4440", "series": "CAG", "text": "ἀλλὰ τοῖς διηγορευμένοις κανόσι χρησάμενοι φέρε πρῶτον τὴν ὁμωνυμίαν διαστειλώμεθα καὶ περὶ ποίου σημαινομένου ὁ λόγος ἡμῖν ὑπάρχει λέξωμεν, εἶθ᾿ ὕστερον ἐπὶ τὴν διδασκαλίαν χωρήσωμεν.", "seq": 4440}
{"id": "David_Passim_4441", "series": "CAG", "text": "λέγεται τοίνυν τὸ ἴδιον τετραχῶς·", "seq": 4441}
{"id": "David_Passim_4442", "series": "CAG", "text": "ἢ γὰρ παντί ἐστι τῷ εἴδει καὶ οὐ μόνῳ ὡς τὸ δίπουν, ἢ μόνῳ καὶ οὐ παντὶ τῷ εἴδει ὡς τὸ φαλακρόν (τῷ γὰρ ἀνθρώπῳ μόνῳ ὑπάρχει τὸ φαλακρόν), ἢ παντὶ καὶ μόνῳ οὐκ ἀεὶ δὲ ὡς τὸ πολιοῦσθαι (μόνῳ γὰρ καὶ παντὶ ἀνθρώπῳ ὑπάρχει τὸ πολιοῦσθαι τοῦ χρόνου συνόντος·", "seq": 4442}
{"id": "David_Passim_4443", "series": "CAG", "text": "τοῦτο δέ φημι, ὅτι οὐ πάντες πολιοῦνται τοῦ χρόνου μὴ συνόντος εἰς τοῦτο ἐπιτηδείου·", "seq": 4443}
{"id": "David_Passim_4444", "series": "CAG", "text": "διὰ τοῦτο γὰρ καὶ τὸ ‘οὐκ ἀεὶ δέ’ προσεθήκαμεν), ἢ μόνῳ καὶ παντὶ καὶ ἀεὶ ὡς τὸ γελαστικόν·", "seq": 4444}
{"id": "David_Passim_4445", "series": "CAG", "text": "μόνῳ γὰρ καὶ παντὶ ἀνθρώπῳ ἴδιον ὑπάρχει καὶ ἀεὶ τὸ γελαστικόν.", "seq": 4445}
{"id": "David_Passim_4446", "series": "CAG", "text": "εἴπομεν δὲ παντὶ τῷ εἴδει ὑπάρχειν τὸ δίπουν πρὸς ἀντιδιαστολὴν τῶν ἀνομοιοειδῶν, ἵνα μὴ λάβῃς δίπουν τὸν ἄνθρωπον τὸ δὲ ὄρνεον οὔ.", "seq": 4446}
{"id": "David_Passim_4447", "series": "CAG", "text": "εἴπομεν δὲ ἐν τῷ δευτέρῳ τὸ μόνῳ διὰ τὰ ὁμοιογενῆ·", "seq": 4447}
{"id": "David_Passim_4448", "series": "CAG", "text": "μόνῳ γὰρ τῷ ἀνθρώπῳ τῶν ἄλλων ζῴων ὑπάρχει τὸ φαλακρόν.", "seq": 4448}
{"id": "David_Passim_4449", "series": "CAG", "text": "τὰ δὲ ἄλλα πρόδηλά ἐστι·", "seq": 4449}
{"id": "David_Passim_4450", "series": "CAG", "text": "μόνῳ γὰρ τῷ ἀνθρώπῳ καὶ παντὶ ὑπάρχει τὸ πολιοῦσθαι καὶ τὸ γελαστικόν, ἀλλὰ τὸ μὲν οὐκ ἀεὶ διὰ τὸ μὴ φθάνειν ἡμᾶς τὸν εἰς τοῦτο ἐπιτήδειον χρόνον, τὸ δὲ ἀεί, λέγω δὲ τὸ γελαστικόν.", "seq": 4450}
{"id": "David_Passim_4451", "series": "CAG", "text": "σκόπει δὲ πῶς ἀπὸ τοῦ ἀμυδροτέρου ἐπὶ τὸ ἐμφανέστερον ἴδιον χωρεῖ ἡ τάξις·", "seq": 4451}
{"id": "David_Passim_4452", "series": "CAG", "text": "τὸ παντὶ καὶ οὐ μόνῳ εἶναί τι ἴδιον σχεδὸν οὐκ ἔστιν ἴδιον·", "seq": 4452}
{"id": "David_Passim_4453", "series": "CAG", "text": "κοινωνίαν γάρ τινα ἐμφαίνει τὸ τοιοῦτον.", "seq": 4453}
{"id": "David_Passim_4454", "series": "CAG", "text": "διὰ τοῦτο ὡς ἀμυδρὸν αὐτὸ προέταξε.", "seq": 4454}
{"id": "David_Passim_4455", "series": "CAG", "text": "δεύτερον δὲ ἴδιον φαμὲν τὸ μόνῳ ὑπάρχον καὶ οὐ παντί.", "seq": 4455}
{"id": "David_Passim_4456", "series": "CAG", "text": "τοῦτο δικαίως ἐπιφανέστερόν ἐστι τοῦ πρώτου·", "seq": 4456}
{"id": "David_Passim_4457", "series": "CAG", "text": "ἔχει γάρ τι τοῦ ἰδίου τὸ μόνῳ·", "seq": 4457}
{"id": "David_Passim_4458", "series": "CAG", "text": "τοῦτο γὰρ οἰκεῖον ἰδίου τὸ μόνῳ τινὶ ὑπάρχειν.", "seq": 4458}
{"id": "David_Passim_4459", "series": "CAG", "text": "τὸ τρίτον τοῦ δευτέρου ἐπιφανέστερον ὑπάρχει, ὅτι ἔχει καὶ τὰ δύο τὸ παντὶ καὶ μόνῳ.", "seq": 4459}
{"id": "David_Passim_4460", "series": "CAG", "text": "τὸ τέταρτον δὲ τοῦ τρίτου ἐμφανέστερόν ἐστιν, ὅτι ἔχει τὸ ἀεί·", "seq": 4460}
{"id": "David_Passim_4461", "series": "CAG", "text": "τὸ γὰρ γελαστικὸν ἀεὶ ἡμῖν ὑπάρχει.", "seq": 4461}
{"id": "David_Passim_4462", "series": "CAG", "text": "περὶ ποίου δὲ τούτων ποιούμεθα τὸν λόγον;", "seq": 4462}
{"id": "David_Passim_4463", "series": "CAG", "text": "περὶ τοῦ ἐσχάτου·", "seq": 4463}
{"id": "David_Passim_4464", "series": "CAG", "text": "αὐτὸ γάρ ἐστι καθολικὸν καὶ ἀεὶ ὑπάρχον καὶ ἑνὸς εἴδους κατηγορούμενον·", "seq": 4464}
{"id": "David_Passim_4465", "series": "CAG", "text": "τὰ μὲν γὰρ ἄλλα κἄν ἐστι καθολικὰ καὶ ἀεί, ἀλλ᾿ οὐ μόνου τοῦ εἴδους ἐστίν, ὡς τὸ δίπουν, κἄν εἰσι μόνου καὶ ἀεί, ἀλλ᾿ οὐ παντός, ὡς τὸ φαλακρόν, κἄν ἐστι παντὸς καὶ μόνου, ἀλλ᾿ οὐκ ἀεί, ὡς τὸ πολιοῦσθαι·", "seq": 4465}
{"id": "David_Passim_4466", "series": "CAG", "text": "τοῦτο δὲ καὶ τοῦ παντός ἐστι καὶ μόνου καὶ ἀεί.", "seq": 4466}
{"id": "David_Passim_4467", "series": "CAG", "text": "ἄλλως τε δὲ οὔτε ἀντιστρέφουσι κατὰ ἄμφω τὰ σκέλη, τοῦτο δὲ ἀντιστρέφει·", "seq": 4467}
{"id": "David_Passim_4468", "series": "CAG", "text": "εἴ τι μὲν γὰρ ἄνθρωπος, τοῦτο καὶ δίπουν, οὐκ εἴ τι δὲ δίπουν, τοῦτο καὶ ἄνθρωπος.", "seq": 4468}
{"id": "David_Passim_4469", "series": "CAG", "text": "πάλιν εἴ τι φαλακρόν, τοῦτο καὶ ἄνθρωπος, οὐκ εἴ τι δ᾿ ἄνθρωπος, τοῦτο καὶ φαλακρόν.", "seq": 4469}
{"id": "David_Passim_4470", "series": "CAG", "text": "πάλιν εἴ τι πολιόν, τοῦτο καὶ ἄνθρωπος, οὐκ εἴ τι δὲ ἄνθρωπος, τοῦτο καὶ πολιόν.", "seq": 4470}
{"id": "David_Passim_4471", "series": "CAG", "text": "τοῦτο δὲ ἄμφω τὰ σκέλη ἔχει ἀντιστρέφοντα·", "seq": 4471}
{"id": "David_Passim_4472", "series": "CAG", "text": "εἴ τι μὲν γὰρ ἄνθρωπος, τοῦτο καὶ γελαστικόν, καὶ εἴ τι γελαστικόν, τοῦτο καὶ ἄνθρωπος.", "seq": 4472}
{"id": "David_Passim_4473", "series": "CAG", "text": "Χωρήσωμεν οὖν ἐπὶ τὴν τούτου διδασκαλίαν.", "seq": 4473}
{"id": "David_Passim_4474", "series": "CAG", "text": "τινὲς μὲν οὖν οὕτως αὐτὸ ὁρίζουσι ‘τὸ παντὶ καὶ μόνῳ καὶ ἀεὶ ὑπάρχον’.", "seq": 4474}
{"id": "David_Passim_4475", "series": "CAG", "text": "κακῶς δέ·", "seq": 4475}
{"id": "David_Passim_4476", "series": "CAG", "text": "δι᾿ οὗ γὰρ ἐξηγήσαντο αὐτό, δι᾿ αὐτοῦ βούλονται αὐτὸ ὁρίζειν.", "seq": 4476}
{"id": "David_Passim_4477", "series": "CAG", "text": "τινὲς δὲ οὕτως αὐτὸ ἀποδιδόασιν ‘ἴδιόν ἐστιν ἢ οὐσία ἢ συμβεβηκὸς ἀντιστρέφον’.", "seq": 4477}
{"id": "David_Passim_4478", "series": "CAG", "text": "δυσὶ δὲ ἁμαρτήμασι περιπίπτει ὁ τοιοῦτος ὁρισμός·", "seq": 4478}
{"id": "David_Passim_4479", "series": "CAG", "text": "πρότερον ὅτι οὐδέποτε οὐσίαν ἐλέγομεν τὸ ἴδιον ἀλλὰ συμβεβηκός.", "seq": 4479}
{"id": "David_Passim_4480", "series": "CAG", "text": "τοῦτο δὲ πᾶσιν ὁμολογεῖται.", "seq": 4480}
{"id": "David_Passim_4481", "series": "CAG", "text": "ὥστε οὖν ὅτε ἐλέγομεν οὐσίαν αὐτὸ δηλοῦν ἐν τῷ νοῦ καὶ ἐπιστήμης δεκτικόν, εὐανάτρεπτος ὑπῆρχεν ὁ λόγος.", "seq": 4481}
{"id": "David_Passim_4482", "series": "CAG", "text": "καταχρηστικῶς δὲ ἐλέγομεν αὐτὸ καὶ ἐπὶ οὐσίας.", "seq": 4482}
{"id": "David_Passim_4483", "series": "CAG", "text": "δεύτερον δὲ οὐδέποτε ὁρισμὸς ὑγιῶς ἔχων ποτὲ μὲν τοῦτο ποτὲ δὲ ἐκεῖνο δηλοῖ.", "seq": 4483}
{"id": "David_Passim_4484", "series": "CAG", "text": "ὁ ἀποδοθεὶς δὲ τοιοῦτός ἐστιν.", "seq": 4484}
{"id": "David_Passim_4485", "series": "CAG", "text": "ἔστιν οὖν αὐτὸ ἀποδοῦναι οὕτως·", "seq": 4485}
{"id": "David_Passim_4486", "series": "CAG", "text": "ἴδιόν ἐστι συμβεβηκὸς ἀντιστρέφον.", "seq": 4486}
{"id": "David_Passim_4487", "series": "CAG", "text": "καλῶς δὲ ὁ ὁρισμὸς ἔχει·", "seq": 4487}
{"id": "David_Passim_4488", "series": "CAG", "text": "οἱ γὰρ μήτε πλέον μήτε ἔλαττον ἔχοντες ὁρισμοὶ ἐξισάζουσι τῷ ὁριζομένῳ, τὰ δὲ ἐξισάζοντα ἀντιστρέφει·", "seq": 4488}
{"id": "David_Passim_4489", "series": "CAG", "text": "οὐκοῦν τὸ παντὶ καὶ μόνῳ καὶ ἀεὶ ὑπάρχον ἴδιον ἐξισάζει, ἐπειδὴ οὔτε πλέον ἔχει οὔτε ἔλαττον, ἔλαττον μέν, καθὸ παντί ἐστι, πλέον δέ, καθὸ μόνῳ ἐστίν·", "seq": 4489}
{"id": "David_Passim_4490", "series": "CAG", "text": "ἐξισάζον δὲ ἀντιστρέφει.", "seq": 4490}
{"id": "David_Passim_4491", "series": "CAG", "text": "καλῶς ἄρα ἔχει ὁ ἀποδοθεὶς ὁρισμός.", "seq": 4491}
{"id": "David_Passim_4492", "series": "CAG", "text": "12.", "seq": 4492}
{"id": "David_Passim_4493", "series": "CAG", "text": "13 Τὸ δὲ ἴδιον διαιροῦσι τετραχῶς.", "seq": 4493}
{"id": "David_Passim_4494", "series": "CAG", "text": "Οὐ φυλάττει τὴν τάξιν τοῦ ἰδίου ὁ Πορφύριος, ὡς ἐφυλάξαμεν ἐν τῇ θεωρίᾳ.", "seq": 4494}
{"id": "David_Passim_4495", "series": "CAG", "text": "12.", "seq": 4495}
{"id": "David_Passim_4496", "series": "CAG", "text": "13 Καὶ γὰρ ὃ μόνῳ τινὶ εἴδει συμβέβηκεν, εἰ καὶ μὴ παντί.", "seq": 4496}
{"id": "David_Passim_4497", "series": "CAG", "text": "Φησὶν ὅτι καὶ ἐκεῖνο ἴδιον λέγω εἶναι ἀνθρώπῳ, ὃ μόνῳ ὑπάρχει, καὶ οὐ παντί·", "seq": 4497}
{"id": "David_Passim_4498", "series": "CAG", "text": "ἰδοὺ γὰρ τὸ ἰατρεύειν μόνου ἀνθρώπου ἐστὶν ἴδιον, εἰ καὶ μὴ ἑκάστου ἀνθρώπου ὑπάρχει.", "seq": 4498}
{"id": "David_Passim_4499", "series": "CAG", "text": "καὶ ἐκ τοῦ ἐναντίου πάλιν ἴδιον λέγω, ὃ παντὶ ἀνθρώπῳ ὑπάρχει, εἰ καὶ μὴ μόνῳ·", "seq": 4499}
{"id": "David_Passim_4500", "series": "CAG", "text": "ὑπάρχει γὰρ ἑκάστῳ ἀνθρώπῳ τὸ δίπουν, οὐ μόνῳ δέ·", "seq": 4500}
{"id": "David_Passim_4501", "series": "CAG", "text": "ἔστι γὰρ καὶ ἄλλοις εἴδεσι.", "seq": 4501}
{"id": "David_Passim_4502", "series": "CAG", "text": "τὸ δὲ γελαστικὸν μόνῳ καὶ παντὶ καὶ ἀεί.", "seq": 4502}
{"id": "David_Passim_4503", "series": "CAG", "text": "12.", "seq": 4503}
{"id": "David_Passim_4504", "series": "CAG", "text": "18 Κἂν γὰρ μὴ γελᾷ ἀεί, ἀλλὰ γελαστικὸν λέγεται οὐ τῷ ἤδη γελᾶν ἀλλὰ τῷ πεφυκέναι·", "seq": 4504}
{"id": "David_Passim_4505", "series": "CAG", "text": "τοῦτο δὲ ἀεὶ αὐτῷ σύμφυτον.", "seq": 4505}
{"id": "David_Passim_4506", "series": "CAG", "text": "Τινὲς ἐντεῦθεν κινούμενοι λέγουσι τὸ γελαστικὸν εἶναι οὐσίαν ἡμῶν σύμφυτον, ὥσπερ τὸ λογικόν·", "seq": 4506}
{"id": "David_Passim_4507", "series": "CAG", "text": "κἂν γὰρ μὴ ἀεὶ γελῶμεν, φασίν, ἀλλ᾿ οὖν ὅμως δυνάμει ἔχομεν τὸ γελᾶν.", "seq": 4507}
{"id": "David_Passim_4508", "series": "CAG", "text": "τοιαύτης δὲ προφάσεως δοθείσης εἴπωμεν πῶς οὐκ ἔστιν οὐσιῶδες ἀλλ᾿ ἐπουσιῶδες καὶ πῶς γίνεται.", "seq": 4508}
{"id": "David_Passim_4509", "series": "CAG", "text": "<ὅτι> τὸ γελαστικὸν οὐκ ἔστιν οὐσιῶδες, πρῶτον μὲν ἐντεῦθεν ἀποδεικτέον·", "seq": 4509}
{"id": "David_Passim_4510", "series": "CAG", "text": "τὰ οὐσιώδη τελειωτικὰ ἡμῶν εἰσι καὶ ὅσον αὔξονται, τοσοῦτον τελειωτικὰ γίνεται·", "seq": 4510}
{"id": "David_Passim_4511", "series": "CAG", "text": "τὸ γὰρ πλέον λογικεύεσθαι οὐσιῶδες ἀνθρώπῳ ὑποφαίνεται.", "seq": 4511}
{"id": "David_Passim_4512", "series": "CAG", "text": "εἰ οὖν τὸ γελαστικὸν οὐσιῶδες, ὀφείλει τελειωτικὸν ἡμῶν εἶναι, εἰ δὲ οὐκ ἔστι, τοὐναντίον.", "seq": 4512}
{"id": "David_Passim_4513", "series": "CAG", "text": "** γὰρ ἀποτρέπεται ὡς ἔχει τὸ ‘μήτε προπετῆ γέλωτα στέργε’, σαφὲς ὡς οὐκ ἔστιν οὐσιῶδες.", "seq": 4513}
{"id": "David_Passim_4514", "series": "CAG", "text": "δεύτερον δὲ οὐδέποτε τἀναντία τοῦ αὐτοῦ συστατικὰ γίνεται, οἷον τὸ θνητὸν καὶ τὸ ἀθάνατον, τὸ λογικὸν καὶ τὸ ἄλογον.", "seq": 4514}
{"id": "David_Passim_4515", "series": "CAG", "text": "εἰ οὖν ἐστι τὸ γελαστικὸν οὐσιῶδες ἡμῶν καὶ συστατικόν, οὐκοῦν καὶ τὸ κλαυστικὸν ἐπειδὴ καὶ μόνου ἀνθρώπου ἐστίν, οὐσιῶδες καὶ αὐτὸ λεχθείη, ὥσπερ τὸ γελαστικόν·", "seq": 4515}
{"id": "David_Passim_4516", "series": "CAG", "text": "ὡς γὰρ ἔχει θάτερον τῶν ἀντικειμένων, οὕτω καὶ τὸ ἕτερον.", "seq": 4516}
{"id": "David_Passim_4517", "series": "CAG", "text": "εἶναι δὲ τὰ δύο ἐναντία συστατικὰ ἡμῶν, ἀδύνατον.", "seq": 4517}
{"id": "David_Passim_4518", "series": "CAG", "text": "ἀλλ᾿ ἐνίοτε ἐρεῖ τις ὡς οὔκ εἰσι τὰ τοιαῦτα ἐναντία·", "seq": 4518}
{"id": "David_Passim_4519", "series": "CAG", "text": "οὐσίαι γάρ εἰσιν·", "seq": 4519}
{"id": "David_Passim_4520", "series": "CAG", "text": "ὑμεῖς δὲ ὡς ὁμολογουμένων αὐτῶν ἐπουσιωδῶν τὸ τοιοῦτον κατασκευάζετε.", "seq": 4520}
{"id": "David_Passim_4521", "series": "CAG", "text": "πρὸς τούτους δέ φαμεν ὅτι εἰ καὶ μὴ ἦσαν ἐναντία, ἀδύνατον τὰ δύο εἶναι ἡμῶν συστατικά·", "seq": 4521}
{"id": "David_Passim_4522", "series": "CAG", "text": "ἰδοὺ γὰρ καὶ ἡ λογικὴ καὶ ἡ ἄλογος <ψυχὴ> ἀντιδιαιρούμεναί εἰσιν.", "seq": 4522}
{"id": "David_Passim_4523", "series": "CAG", "text": "ὅμως δὲ τὸ λογικὸν ἡμῶν συστατικὸν ὑπάρχει, καίτοι ἐχόντων ἡμῶν καὶ τὴν ἄλογον ψυχήν.", "seq": 4523}
{"id": "David_Passim_4524", "series": "CAG", "text": "ἔπειτα ἐναντία εἰσὶ τὸ γελαστικὸν καὶ τὸ κλαυστικόν·", "seq": 4524}
{"id": "David_Passim_4525", "series": "CAG", "text": "μεταβάλλει γὰρ εἰς ἄλληλα.", "seq": 4525}
{"id": "David_Passim_4526", "series": "CAG", "text": "εἰ οὖν ταῦτα οὕτως ἔχει, σαφὲς ὡς οὐκ ἔστι τὸ γελαστικὸν ἡμῶν συστατικόν, ἐπεὶ ἔσται καὶ τὸ ἐναντίον αὐτῷ, λέγω δὲ τὸ κλαυστικόν, ἡμῶν συστατικόν.", "seq": 4526}
{"id": "David_Passim_4527", "series": "CAG", "text": "τρίτον οὐδέποτε τὰ οὐσιώδη αὐξανόμενα ἀναιρεῖ ἐκεῖνα ὧν κατηγορεῖται, οἷον τὸ λογικὸν οὐδέποτε αὐξανόμενον ἀναιρεῖ τὸν ἄνθρωπον, τοὐναντίον δὲ συνιστᾷ·", "seq": 4527}
{"id": "David_Passim_4528", "series": "CAG", "text": "τὸ δὲ γελαστικὸν ἀναιρετικόν ἐστι τοῦ ἀνθρώπου αὐξανόμενον·", "seq": 4528}
{"id": "David_Passim_4529", "series": "CAG", "text": "καὶ γὰρ ἀπὸ γέλωτος κολάσεις παρὰ Πέρσαις ἐφευρέθησαν.", "seq": 4529}
{"id": "David_Passim_4530", "series": "CAG", "text": "τέταρτον οὐδὲ δυνάμει ἔχομεν τὸ γελαστικόν, εἴ γέ τινες διὰ τοῦ Τροφωνίου παριόντες εἰς τὸν ἀεὶ χρόνον τοῦ γελᾶν ἐστερήθησαν·", "seq": 4530}
{"id": "David_Passim_4531", "series": "CAG", "text": "εἰ δὲ εἶχον δύναμιν τοῦ γελᾶν, πάντως τοῦ χρόνου προκόπτοντος ἐγέλων ἄν.", "seq": 4531}
{"id": "David_Passim_4532", "series": "CAG", "text": "Λεκτέον δὲ κατὰ τὴν ἡμετέραν ἐπαγγελίαν διὰ τίνος γίνεται.", "seq": 4532}
{"id": "David_Passim_4533", "series": "CAG", "text": "φασί τινες ὅτι διὰ τῆς ἀλόγου ψυχῆς, οἷς καὶ συγκατατιθέμεθα·", "seq": 4533}
{"id": "David_Passim_4534", "series": "CAG", "text": "ὁ γὰρ τοιοῦτος τρόπος διὰ μυῶν καὶ νεύρων γίνεται·", "seq": 4534}
{"id": "David_Passim_4535", "series": "CAG", "text": "ταῦτα δὲ τῆς ἀλόγου ψυχῆς ὑπάρχει.", "seq": 4535}
{"id": "David_Passim_4536", "series": "CAG", "text": "ὅτι δ᾿ οὐ γίνεται διὰ τῆς λογικῆς, σαφὲς ἐκ τοῦ μὴ εἶναι αὐτὸ ἐν ὑποκειμένῳ.", "seq": 4536}
{"id": "David_Passim_4537", "series": "CAG", "text": "ἀποροῦσι δέ τινες λέγοντες ‘εἰ διὰ τῆς ἀλόγου ψυχῆς τὸ γελαστικὸν γίνεται, ἐπειδὴ οἱ μύες καὶ τὰ νεῦρα αὐτῆς εἰσιν, ἃ συνερχόμενα ποιεῖ τὸν τοιοῦτον τρόπον, ὀφείλει τὸ γελαστικὸν καὶ ἐπὶ τῶν ἀλόγων θεωρεῖσθαι·", "seq": 4537}
{"id": "David_Passim_4538", "series": "CAG", "text": "ἔχουσι γὰρ καὶ ταῦτα νεῦρα καὶ μύας’.", "seq": 4538}
{"id": "David_Passim_4539", "series": "CAG", "text": "φαμὲν δὲ πρὸς τοῦτο ὅτι πρῶτον μὲν ἔστι καὶ ἄλλα ζῷα γελαστικά, ὥσπερ ἱστορεῖ ὁ Ἀριστοτέλης ἐν τῇ Περὶ ζῴων περὶ τοῦ ἐρωδιοῦ.", "seq": 4539}
{"id": "David_Passim_4540", "series": "CAG", "text": "δεύτερον δὲ οὐκ ἐν πᾶσι τοῖς ζῴοις ὁμοίως ἐνεργεῖ ἡ ἄλογος ψυχή, ἐπεὶ ὀφείλει ἡ ὑλακὴ τοῦ κυνὸς ἐπὶ πάντων τῶν ζῴων διήκειν, ἐπειδὴ ἔχει ὁ ἄνθρωπος μύας καὶ νεῦρα ὥσπερ καὶ ὁ κύων, ὁμοίως δὲ καὶ ὁ μυκηθμὸς τοῦ βοὸς καὶ ὁ χρεμετισμὸς τοῦ ἵππου.", "seq": 4540}
{"id": "David_Passim_4541", "series": "CAG", "text": "ἰδιότητες οὖν ὑπάρχουσι τῆς ἀλόγου ψυχῆς ἐν ἑκάστῳ εἴδει.", "seq": 4541}
{"id": "David_Passim_4542", "series": "CAG", "text": "ὅτι δὲ τῆς φυτικῆς οὐκ ἔστι τὸ γελαστικόν, τοῦτο ὁμολογεῖται·", "seq": 4542}
{"id": "David_Passim_4543", "series": "CAG", "text": "τρεῖς γάρ εἰσιν αἱ δυνάμεις αὐτῆς, θρεπτικὴ αὐξητικὴ γεννητική.", "seq": 4543}
{"id": "David_Passim_4544", "series": "CAG", "text": "μία δὲ τούτων τὸ γελαστικὸν οὐκ ἐργάζεται·", "seq": 4544}
{"id": "David_Passim_4545", "series": "CAG", "text": "συγκαταθετέον οὖν τοῖς προειρημένοις.", "seq": 4545}
{"id": "David_Passim_4546", "series": "CAG", "text": "Πρᾶξις λβ΄.", "seq": 4546}
{"id": "David_Passim_4547", "series": "CAG", "text": "Περὶ συμβεβηκότος.", "seq": 4547}
{"id": "David_Passim_4548", "series": "CAG", "text": "Οἱ ὁρισμοὶ τοῦ συμβεβηκότος ἀποδιδόασι τὴν ὀφειλομένην αὐτῷ τάξιν·", "seq": 4548}
{"id": "David_Passim_4549", "series": "CAG", "text": "δηλοῦσι γὰρ ὅτι ἔσχατόν ἐστι καὶ ἀβληχρὸν καὶ ἀμενηνόν·", "seq": 4549}
{"id": "David_Passim_4550", "series": "CAG", "text": "τί γάρ ἐστι συμβεβηκός;", "seq": 4550}
{"id": "David_Passim_4551", "series": "CAG", "text": "ὃ γίνεται καὶ ἀπογίνεται χωρὶς τῆς τοῦ ὑποκειμένου φθορᾶς.", "seq": 4551}
{"id": "David_Passim_4552", "series": "CAG", "text": "ἀποροῦσι δέ τινες λέγοντες διὰ τί ἐπὶ τοῦ συμβεβηκότος παρέβη τοὺς διηγορευμένους κανόνας·", "seq": 4552}
{"id": "David_Passim_4553", "series": "CAG", "text": "ὁμωνύμου γὰρ ὄντος αὐτοῦ οὐκ εἶπε ποσαχῶς λαμβάνεται, οὔτε περὶ ποίου σημαινομένου ἐστὶν ὁ λόγος, ἀλλ᾿ εὐθέως τῆς διδασκαλίας αὐτοῦ τὸν τρόπον ἐπήγαγεν.", "seq": 4553}
{"id": "David_Passim_4554", "series": "CAG", "text": "ἔστι δὲ εἰπεῖν πρὸς τούτους ὅτι τὸ ποσαχῶς παρῆκε διδάξας τοῦτο ἐν τοῖς φθάσασι·", "seq": 4554}
{"id": "David_Passim_4555", "series": "CAG", "text": "διττὸν γὰρ αὐτὸ εἶναι εἶπε, χωριστὸν καὶ ἀχώριστον.", "seq": 4555}
{"id": "David_Passim_4556", "series": "CAG", "text": "περὶ ποίου δὲ σημαινομένου λέγει, οὐκ ἐξέθετο βουλόμενος περὶ πάντων τῶν συμβεβηκότων διαλαβεῖν·", "seq": 4556}
{"id": "David_Passim_4557", "series": "CAG", "text": "τότε δὲ λέγομεν περὶ ποίου σημαινομένου βουλόμεθα διαλαβεῖν, ὅταν οὐ διδάσκωμεν περὶ ὅλων τῶν φωνῶν.", "seq": 4557}
{"id": "David_Passim_4558", "series": "CAG", "text": "Τριχῶς οὖν αὐτὸ ἀποδίδωσι·", "seq": 4558}
{"id": "David_Passim_4559", "series": "CAG", "text": "φησὶ γὰρ ὅτι συμβεβηκός ἐστιν ὃ γίνεται καὶ ἀπογίνεται χωρὶς τῆς τοῦ ὑποκειμένου φθορᾶς, ἑτέρως δὲ ὃ ἐνδέχεται τῷ αὐτῷ ὑπάρχειν ἢ μὴ ὑπάρχειν, ἐξ ἀποφάσεως δὲ ὃ οὔτε γένος οὔτε εἶδος οὔτε διαφορὰ οὔτε ἴδιον δύναται εἶναι.", "seq": 4559}
{"id": "David_Passim_4560", "series": "CAG", "text": "ἐπειδὴ δέ τινες πειρῶνται κακίζειν τοὺς ἀποδεδομένους ὁρισμούς, φέρε τὰ ἐξ αὐτῶν λεγόμενα παραθησόμεθα, εἶθ᾿ ὕστερον τοῖς ἐξ αὐτῶν ῥηθεῖσι πρέπουσαν ἀπολογίαν ἀποδώσομεν.", "seq": 4560}
{"id": "David_Passim_4561", "series": "CAG", "text": "φασὶ δὲ τὸν πρῶτον ὁρισμὸν ἐλλείπειν καὶ περισσεύειν.", "seq": 4561}
{"id": "David_Passim_4562", "series": "CAG", "text": "ἐλλείπειν δὲ οὕτως·", "seq": 4562}
{"id": "David_Passim_4563", "series": "CAG", "text": "εἰ ὁ ὁρισμὸς οὗτος τὰ γινόμενα καὶ ἀπογινόμενα συμβεβηκότα δηλοῖ, μόνα τὰ χωριστὰ σημαίνει οἷον τὸ λευκόν·", "seq": 4563}
{"id": "David_Passim_4564", "series": "CAG", "text": "δύναται γὰρ ἐν ἐμοὶ γενέσθαι καὶ ἀπογενέσθαι χωρὶς τῆς τοῦ ὑποκειμένου φθορᾶς, τὸ ἀχώριστον δὲ οὐ γίνεται καὶ ἀπογίνεται χωρὶς τῆς τοῦ ὑποκειμένου φθορᾶς·", "seq": 4564}
{"id": "David_Passim_4565", "series": "CAG", "text": "οὔτε γὰρ ἀπογίνεται τὸ μέλαν τοῦ Αἰθίοπος περιόντος τοῦ Αἰθίοπος, ὁμοίως οὐδὲ τοῦ κόρακος.", "seq": 4565}
{"id": "David_Passim_4566", "series": "CAG", "text": "ἔστι δὲ πρὸς τοῦτο εἰπεῖν ὅτι τῶν συμβεβηκότων τὰ μὲν ἐπινοίᾳ καὶ ἐνεργείᾳ χωρίζεται, τὰ δὲ μόνῃ ἐπινοίᾳ·", "seq": 4566}
{"id": "David_Passim_4567", "series": "CAG", "text": "ἐνεργείᾳ μὲν καὶ ἐπινοίᾳ τὰ χωριστά (δύνασαι γὰρ καὶ ἐνεργεία ἀποχωρίσαι τὸ λευκὸν τὸ ἐν ἐμοί, δύνασαι καὶ ἐπινοίᾳ), ἐπινοίᾳ δὲ μόνῃ τὰ ἀχώριστα·", "seq": 4567}
{"id": "David_Passim_4568", "series": "CAG", "text": "τὸ γὰρ μέλαν τοῦ Αἰθίοπος δύνασαι ἐπινοίᾳ νοῆσαι ἀπογινόμενον χωρὶς τῆς τοῦ ὑποκειμένου φθορᾶς·", "seq": 4568}
{"id": "David_Passim_4569", "series": "CAG", "text": "εἰ γὰρ νοήσεις λευκὸν Αἰθίοπα ἐπινοίᾳ, οὐδὲν λυμαίνῃ τῷ ὑποκειμένῳ.", "seq": 4569}
{"id": "David_Passim_4570", "series": "CAG", "text": "προστίθεσο οὖν τῷ ὁρισμῷ τὸ ἐνεργείᾳ καὶ ἐπινοίᾳ, καὶ οὐδὲν εὑρίσκεται ἐλλεῖπον·", "seq": 4570}
{"id": "David_Passim_4571", "series": "CAG", "text": "συμβεβηκός ἐστιν ὃ γίνεται καὶ ἀπογίνεται χωρὶς τῆς τοῦ ὑποκειμένου φθορᾶς ἐνεργείᾳ ἢ ἐπινοίᾳ.", "seq": 4571}
{"id": "David_Passim_4572", "series": "CAG", "text": "περισσεύειν δέ φασιν αὐτὸν οὕτως·", "seq": 4572}
{"id": "David_Passim_4573", "series": "CAG", "text": "εἰ ἐκεῖνό φαμεν συμβεβηκὸς ὃ γίνεται καὶ ἀπογίνεται χωρὶς τῆς τοῦ ὑποκειμένου φθορᾶς, οὐκοῦν οὐ μόνον τὰ συμβεβηκότα συμπεριέλαβεν ὁ ὁρισμός, ἀλλὰ καί τινας οὐσίας·", "seq": 4573}
{"id": "David_Passim_4574", "series": "CAG", "text": "ἰδοὺ γὰρ ἡ θερμότης τοῦ πυρὸς γίνεται καὶ ἀπογίνεται χωρὶς τῆς τοῦ ὑποκειμένου φθορᾶς, οὐσία δὲ αὐτοῦ ἡ θερμότης.", "seq": 4574}
{"id": "David_Passim_4575", "series": "CAG", "text": "εἰ δέ τις εἴποι ‘ἐὰν ἀπογίνηται ἡ θερμότης τοῦ πυρός, οὐ φθείρεται τὸ ὑποκείμενον;’", "seq": 4575}
{"id": "David_Passim_4576", "series": "CAG", "text": "φαμὲν οὐχί·", "seq": 4576}
{"id": "David_Passim_4577", "series": "CAG", "text": "ἄποιον γὰρ τὸ σῶμα αὐτοῦ ἐστι, τὰ δὲ ἄποια σώματα οὐ φθείρεται.", "seq": 4577}
{"id": "David_Passim_4578", "series": "CAG", "text": "ὁμοίως καὶ τὸ ψυχρὸν τοῦ ὕδατος γίνεται καὶ ἀπογίνεται χωρὶς τῆς τοῦ ὑποκειμένον φθορᾶς, συμβεβηκὸς δὲ οὐκ ἔστιν, ἀλλ᾿ οὐσία τοῦ ὕδατος.", "seq": 4578}
{"id": "David_Passim_4579", "series": "CAG", "text": "λέγομεν δὲ πρὸς τούτους ὅτι οὔτε ὅλως ἀπορίας ἥψαντο·", "seq": 4579}
{"id": "David_Passim_4580", "series": "CAG", "text": "φανερὰ γάρ ἐστιν ἡ ἐπίλυσις·", "seq": 4580}
{"id": "David_Passim_4581", "series": "CAG", "text": "ἔστι γὰρ τὸ ψυχρὸν οὐσία καὶ συμβεβηκός, ἀλλ᾿ οὐ κατὰ τὸ αὐτό·", "seq": 4581}
{"id": "David_Passim_4582", "series": "CAG", "text": "πρὸς μὲν γὰρ τὸ ὕδωρ οὐσία ἐστίν (οὐκ ἔστι γὰρ ἐπινοῆσαι ὕδωρ χωρὶς ψυχροῦ), πρὸς δὲ τὸ σῶμα τοῦ ὕδατος συμβεβηκός ἐστιν.", "seq": 4582}
{"id": "David_Passim_4583", "series": "CAG", "text": "ὁμοίως δὲ καὶ ἡ θερμότης τοῦ πυρὸς πρὸς μὲν τὸ πῦρ οὐσία ἐστίν (ἄνευ γὰρ θερμότητος οὐκ ἔστι τὸ πῦρ), πρὸς δὲ τὸ σῶμα τοῦ πυρὸς συμβεβηκός ἐστιν.", "seq": 4583}
{"id": "David_Passim_4584", "series": "CAG", "text": "ἄλλως τε οὐ συμπεριέλαβε τὰ τοιαῦτα ὁ ὁρισμός·", "seq": 4584}
{"id": "David_Passim_4585", "series": "CAG", "text": "ἐν γὰρ τῷ λέγειν χωρὶς τῆς τοῦ ὑποκειμένου φθορᾶς δηλοῖ ὅτι φθείρεται τούτων τὸ ὑποκείμενον·", "seq": 4585}
{"id": "David_Passim_4586", "series": "CAG", "text": "ἐξ οὗ γὰρ ἔχει φθορὰν ὅλως τὸ ὑποκείμενον, πάντως φθείρεται, κἂν μή, ὅτε ἀπογίνεται τὸ συμβεβηκός.", "seq": 4586}
{"id": "David_Passim_4587", "series": "CAG", "text": "εἰ οὖν ταῦτα οὕτως ἔχει, τὸ δὲ ὑποκείμενον τοῦ πυρὸς καὶ τοῦ ὕδατος ἄφθαρτον ὑπάρχει (ἄποιον γὰρ αὐτῶν ἐστι τὸ σῶμα, καὶ τὰ ἄποια οὐ φθείρεται), σαφὲς ὅτι οὐ συμπεριέλαβεν ὁ ὁρισμὸς τὰ τοιαῦτα·", "seq": 4587}
{"id": "David_Passim_4588", "series": "CAG", "text": "λέγει γὰρ τὸ ὑποκείμενον φθειρόμενον, τούτων δὲ ἄφθαρτόν ἐστι τὸ ὑποκείμενον.", "seq": 4588}
{"id": "David_Passim_4589", "series": "CAG", "text": "Τῶν τοιούτων ὑπονοιῶν τὸν ὁρισμὸν ἐλευθερώσαντες φέρε καὶ ἐπὶ ἑτέραν ἀπορίαν χωρήσωμεν·", "seq": 4589}
{"id": "David_Passim_4590", "series": "CAG", "text": "λέγουσι γάρ τινες·", "seq": 4590}
{"id": "David_Passim_4591", "series": "CAG", "text": "εἰ οὐδέποτέ τι τῶν ὄντων τῆς ἑαυτοῦ ἀπωλείας ἐφίεται (κἂν γὰρ εἴπῃς τὰ ἄλογα ἑαυτὰ ἀπόλλυσιν ἀπὸ κρημνοῦ πηδῶντα ἢ εἰς ὕδωρ ῥιπτούμενα, οὐ τῆς ἀπωλείας ἐφιέμενα τὰ τοιαῦτα ποιοῦσιν, ἀλλ᾿ ἢ διὰ διωγμὸν ἑτέρων ἀλόγων ἡ διὰ θυμόν·", "seq": 4591}
{"id": "David_Passim_4592", "series": "CAG", "text": "κατὰ συμβεβηκὸς γὰρ ἑαυτὰ ἀπόλλυσι), πῶς τὰ συμβεβηκότα ἑαυτὰ ἐφίεται ἀπολλύειν;", "seq": 4592}
{"id": "David_Passim_4593", "series": "CAG", "text": "ὅτι δὲ ἑαυτὰ ἀπολλύει, σαφὲς ἐντεῦθεν·", "seq": 4593}
{"id": "David_Passim_4594", "series": "CAG", "text": "εἰ ἐν ὑποκειμένῳ ἐστὶ τὰ συμβεβηκότα, ἀπόλλυσι δὲ τὸ ὑποκείμενον, ὁμολογουμένως καὶ ἑαυτὰ ἀπολλύει.", "seq": 4594}
{"id": "David_Passim_4595", "series": "CAG", "text": "πῶς δὲ ἀπόλλυται τὸ ὑποκείμενον, λέξομεν·", "seq": 4595}
{"id": "David_Passim_4596", "series": "CAG", "text": "ὁ ἑκτικὸς πυρετὸς ἀπόλλυσι τὸ ὑποκείμενον·", "seq": 4596}
{"id": "David_Passim_4597", "series": "CAG", "text": "ἀμήχανον γὰρ αὐτὸν ἀπογενέσθαι χωρὶς τῆς φθορᾶς τοῦ ὑποκειμένου·", "seq": 4597}
{"id": "David_Passim_4598", "series": "CAG", "text": "εἰ οὖν τὸ ὑποκείμενον αὐτῷ ἀπολλύει, ἑαυτὸν ἀπολλύει.", "seq": 4598}
{"id": "David_Passim_4599", "series": "CAG", "text": "ἔστι δὲ εἰπεῖν πρὸς τούτους·", "seq": 4599}
{"id": "David_Passim_4600", "series": "CAG", "text": "ὅτι οὐδὲν τῶν συμβεβηκότων ἑαυτὸ ἥδεται φθεῖραι, ἀλλὰ μὴν οὐδὲ τὸ ὑποκείμενον φθεῖραι (κατὰ συμβεβηκὸς γὰρ αὐτὸ ἀπολλύει, οὐχ ἑκόντως), καὶ σαφὲς ἔνθεν, ὅτι ὁ ἑκτικὸς πυρετὸς ἀμετρία ἐστίν, ἡ δὲ ὑγιὴς κρᾶσις συμμετρία·", "seq": 4600}
{"id": "David_Passim_4601", "series": "CAG", "text": "ταῦτα δὲ ἐναντία εἰσίν.", "seq": 4601}
{"id": "David_Passim_4602", "series": "CAG", "text": "ἡ οὖν ἀμετρία σπεύδει τὴν συμμετρίαν φθεῖραι, φθείρουσα δὲ αὐτὴν κατὰ συμβεβηκὸς φθείρει καὶ τὸ ὑποκείμενον, φθείρουσα δὲ τὸ ὑποκείμενον καὶ ἑαυτὴν φθείρει.", "seq": 4602}
{"id": "David_Passim_4603", "series": "CAG", "text": "οὕτω καὶ ἡ φαλάκρα οὐ τὸ ἴδιον ὑποκείμενον φθείρει, λέγω δὴ τὴν κεφαλήν, ἀλλὰ τὴν ἀντικειμένην αὐτῇ δασύτητα τῶν τριχῶν.", "seq": 4603}
{"id": "David_Passim_4604", "series": "CAG", "text": "Ὁ δεύτερος ὁρισμὸς πάλιν ἀτελῶς ἔχει·", "seq": 4604}
{"id": "David_Passim_4605", "series": "CAG", "text": "φησὶ γὰρ συμβεβηκός ἐστιν ὃ ἐνδέχεται τῷ αὐτῷ ὑπάρχειν ἢ μὴ ὑπάρχειν, τοῦτο δὲ οὐ συλλαμβάνει τὰ ἀχώριστα συμβεβηκότα·", "seq": 4605}
{"id": "David_Passim_4606", "series": "CAG", "text": "οὔτε γὰρ ἐνδέχεται μὴ ὑπάρχειν αὐτά·", "seq": 4606}
{"id": "David_Passim_4607", "series": "CAG", "text": "τὸ μέλαν γὰρ τοῦ Αἰθίοπος οὐκ ἐνδέχεται μὴ ὑπάρχειν τῷ Αἰθίοπι.", "seq": 4607}
{"id": "David_Passim_4608", "series": "CAG", "text": "δεῖ οὖν προσθεῖναι ὅπερ καὶ τῷ πρώτῳ προσεθήκαμεν ‘ἢ ἐνεργείᾳ ἢ ἐπινοίᾳ’.", "seq": 4608}
{"id": "David_Passim_4609", "series": "CAG", "text": "ὁ τρίτος δὲ σχεδὸν οὔτε ὁρισμός ἐστιν·", "seq": 4609}
{"id": "David_Passim_4610", "series": "CAG", "text": "οὔτε γὰρ οἱ ὁρισμοὶ τὰ μὴ ὄντα τινὶ δηλοῦν βούλονται, ἀλλὰ τὰ ὄντα·", "seq": 4610}
{"id": "David_Passim_4611", "series": "CAG", "text": "ἀμέλει ὁριζόμενοι τὸν ἄνθρωπον οὔ φαμεν ὅτι ἄνθρωπός ἐστιν ὃ οὐ πέτεται οὔτε ὑλακτεῖ οὔτε χρεμετίζει, ἀλλὰ τὰ ὄντα αὐτῷ λέγομεν, ζῷον λογικὸν καὶ τὰ τοιαῦτα.", "seq": 4611}
{"id": "David_Passim_4612", "series": "CAG", "text": "ὁ οὖν ὁρισμὸς οὗτος ἃ ἔχει οὐ λέγει, ἀλλ᾿ ἃ οὐκ ἔχει·", "seq": 4612}
{"id": "David_Passim_4613", "series": "CAG", "text": "συμβεβηκός ἐστιν ὃ οὔτε γένος οὔτε εἶδος οὔτε διαφορὰ οὔτε ἴδιον δύναται εἶναι ** τὸ γὰρ θεῖον διὰ τοῦτο ὁρίσασθαι οὐ δυνάμεθα, ἐπειδὴ τί ἐστιν οὐκ οἴδαμεν.", "seq": 4613}
{"id": "David_Passim_4614", "series": "CAG", "text": "λέγουσι δέ τινες ‘διὰ τί μὴ πάσας τὰς φωνὰς οὕτως ὡρίσατο, ἀλλὰ μόνον τὸ συμβεβηκός;’", "seq": 4614}
{"id": "David_Passim_4615", "series": "CAG", "text": ".", "seq": 4615}
{"id": "David_Passim_4616", "series": "CAG", "text": "πρὸς οὓς ἐροῦμεν ὅτι εἰ ἥμαρτε προσάπαξ ὁ Πορφύριος, οὐκ ἔδει αὐτὸν καὶ πανταχοῦ ἁμαρτῆσαι.", "seq": 4616}
{"id": "David_Passim_4617", "series": "CAG", "text": "ἔπειτα καὶ εἰ οὐκ ἦν τὸ τοιοῦτον ὑφ᾿ ἁμαρτίαν ἀγόμενον, ἀλλ᾿ οὖν ὅμως ἐπὶ τῶν ἄλλων φωνῶν οὐκ ἠδύνατο οὕτως ὁρίσασθαι·", "seq": 4617}
{"id": "David_Passim_4618", "series": "CAG", "text": "εἴρηται γὰρ ἡμῖν ὅτι τὰ ἀμφίβολα ἐξ ἀμφιβόλων οὐ πιστούμεθα, ἀλλ᾿ ἐξ ὁμολογουμένων·", "seq": 4618}
{"id": "David_Passim_4619", "series": "CAG", "text": "πρὸ τοῦ οὖν παραδοῦναι ἡμᾶς τὸ εἶδος καὶ τὰς ὑπολοίπους φωνὰς πῶς ἠδυνάμεθα εἰπεῖν ἐπὶ τοῦ γένους ‘γένος ἐστὶν ὃ οὔτε εἶδος οὔτε διαφορὰ οὔτε ἴδιον οὔτε συμβεβηκὸς ὑπάρχει’;", "seq": 4619}
{"id": "David_Passim_4620", "series": "CAG", "text": "τὸ τοιοῦτον δὲ ποιοῦντες ἀμφίβολον ἐξ ἀμφιβόλου ἐμέλλομεν πιστοῦσθαι, ὅπερ ἄτοπον.", "seq": 4620}
{"id": "David_Passim_4621", "series": "CAG", "text": "ἐπὶ μόνου δὲ τοῦ ἐσχάτου, φημὶ δὲ τοῦ συμβεβηκότος, τὸ τοιοῦτον ποιῆσαι δυνάμεθα.", "seq": 4621}
{"id": "David_Passim_4622", "series": "CAG", "text": "13.", "seq": 4622}
{"id": "David_Passim_4623", "series": "CAG", "text": "1 Δύναται δὲ ἐπινοηθῆναι κόραξ λευκὸς καὶ Αἰθίοψ ἀποβαλὼν τὴν χροιὰν χωρὶς φθορᾶς τοῦ ὑποκειμένου.", "seq": 4623}
{"id": "David_Passim_4624", "series": "CAG", "text": "Τοῦτο ἐπιλύει τὸ ἀπορούμενον·", "seq": 4624}
{"id": "David_Passim_4625", "series": "CAG", "text": "πρὸς γὰρ τοὺς λέγοντας μὴ ἀπογίνεσθαι τὰ ἀχώριστα χωρὶς τῆς τοῦ ὑποκειμένου φθορᾶς φησιν ὅτι δυνατὸν ἐπινοίᾳ.", "seq": 4625}
{"id": "David_Passim_4626", "series": "CAG", "text": "Ἰστέον δὲ ὡς οὐδεὶς τῶν ὁρισμῶν ὑγιῶς ἔχει·", "seq": 4626}
{"id": "David_Passim_4627", "series": "CAG", "text": "σκόπει γὰρ τὸν πρῶτον τί λέγει·", "seq": 4627}
{"id": "David_Passim_4628", "series": "CAG", "text": "συμβεβηκός ἐστιν ὃ γίνεται καὶ ἀπογίνεται χωρὶς τῆς τοῦ ὑποκειμένου φθορᾶς ἢ ἐνεργείᾳ ἢ ἐπινοίᾳ.", "seq": 4628}
{"id": "David_Passim_4629", "series": "CAG", "text": "ὁ ἤ ὧδε σύνδεσμος ἢ συμπλεκτικὸς νοεῖται ἢ διαζευκτικός·", "seq": 4629}
{"id": "David_Passim_4630", "series": "CAG", "text": "καὶ εἰ μὲν συμπλεκτικός, ἵν᾿ ᾖ οὕτως ‘καὶ ἐνεργείᾳ καὶ ἐπινοίᾳ’, ψεύδεται ὁ ὁρισμὸς οὗτος ἐπὶ τῶν ἀχωρίστων συμβεβηκότων (οὔτε γὰρ τὰ ἀχώριστα γίνεται καὶ ἀπογίνεται ἐνεργείᾳ καὶ ἐπινοίᾳ χωρὶς τῆς τοῦ ὑποκειμένου φθορᾶς, τὰ μέντοι χωριστὰ τοιαῦτά ἐστιν), εἰ δὲ διαζευκτικός, οὐχ εὑρίσκεται τὸ τοιοῦτον ὁρισμὸς ἀλλὰ διαίρεσις·", "seq": 4630}
{"id": "David_Passim_4631", "series": "CAG", "text": "ὁρισμοῦ γὰρ ἔργον ὑπάρχει τὸ συνάγειν τὰ πολλὰ εἰς ἕν τι, διαιρέσεως δὲ τὸ ἐξ ἑνὸς πολλὰ ποιεῖν.", "seq": 4631}
{"id": "David_Passim_4632", "series": "CAG", "text": "τοιοῦτον δὲ καὶ τὸ προκείμενον·", "seq": 4632}
{"id": "David_Passim_4633", "series": "CAG", "text": "φησὶ γὰρ ἢ ἐνεργείᾳ ἢ ἐπινοίᾳ, ὅλαι δὲ αἱ φωναὶ τῶν ὁρισμῶν ἐπὶ ἑνὸς θέλουσι λέγεσθαι, καὶ οὐκ ἐπὶ διαφόρων.", "seq": 4633}
{"id": "David_Passim_4634", "series": "CAG", "text": "ὁ αὐτὸς λόγος καὶ ἐπὶ τοῦ δευτέρου·", "seq": 4634}
{"id": "David_Passim_4635", "series": "CAG", "text": "ἔχει γὰρ τὸ ἐνεργείᾳ ἢ ἐπινοίᾳ.", "seq": 4635}
{"id": "David_Passim_4636", "series": "CAG", "text": "περὶ δὲ τοῦ τρίτου ὡς κακῶς ἔχει ἐν τῇ θεωρίᾳ ἡμῖν δέδεικται.", "seq": 4636}
{"id": "David_Passim_4637", "series": "CAG", "text": "Περὶ κοινωνιῶν καὶ διαφορῶν τῶν πέντε φωνῶν.", "seq": 4637}
{"id": "David_Passim_4638", "series": "CAG", "text": "Κατὰ τὴν ἡμετέραν ἐπαγγελίαν μετὰ τὸ λόγῳ δημιουργῆσαι τὰς πέντε φωνὰς φέρε τὰς κοινωνίας αὐτῶν καὶ τὰς διαφορὰς παραθησόμεθα.", "seq": 4638}
{"id": "David_Passim_4639", "series": "CAG", "text": "καὶ ἔδει μὲν ὅσον γε πρὸς τὸ ἐντελῶς μαθεῖν ἡμᾶς τὰς πέντε φωνὰς τέλος λαβεῖν τὸ σύγγραμμα (ὁ γὰρ εἰδὼς τὰς πέντε φωνὰς καὶ τὰς τούτων ὑπογραφὰς αὐτόθεν οἶδε καὶ τὰς τούτων κοινωνίας καὶ διαφοράς), ἀλλ᾿ ἐπειδὴ πρὸς εἰσαγομένους ἐποιεῖτο τὸν λόγον, ἀναγκαῖον ἡγήσατο καὶ ταύτας παραδοῦναι.", "seq": 4639}
{"id": "David_Passim_4640", "series": "CAG", "text": "ἰστέον δ᾿ ὅτι τὰ πράγματα οὔτε πάντῃ κοινωνοῦσιν ἀλλήλοις οὔτε πάντῃ διαφέρουσιν, ἀλλὰ κατά τινα μὲν κοινωνοῦσι κατά τινα δὲ διαφέρουσι.", "seq": 4640}
{"id": "David_Passim_4641", "series": "CAG", "text": "καὶ κοινωνοῦσι μὲν καθὸ ἐκ μιᾶς ἀρχῆς ἤρτηνται, διαφέρουσι δὲ κατὰ τὴν ὕλην.", "seq": 4641}
{"id": "David_Passim_4642", "series": "CAG", "text": "δισσῶν δὲ οὐσῶν τῶν κοινωνιῶν καὶ τῶν διαφορῶν, καθολικῶν τε καὶ μερικῶν, τὴν πρώτην τάξιν εἰλήφασιν αἱ καθολικαί.", "seq": 4642}
{"id": "David_Passim_4643", "series": "CAG", "text": "ἀλλὰ τῆς διαφορᾶς ἀξία ἡ κοινωνία προτάττεσθαι·", "seq": 4643}
{"id": "David_Passim_4644", "series": "CAG", "text": "ἔοικε γὰρ τῇ ἀπορίᾳ·", "seq": 4644}
{"id": "David_Passim_4645", "series": "CAG", "text": "ἐν γὰρ τῷ δεικνύειν ὅτι πᾶσαι κοινωνοῦσι κατὰ ἕν τι συνάφειαν αὐτῶν καὶ ἕνωσιν ποιεῖται, τὸ δὲ ἕν τι εἰπεῖν τὰς πέντε φωνὰς ἀπορίας ἐστὶν ἔργον·", "seq": 4645}
{"id": "David_Passim_4646", "series": "CAG", "text": "ἀπορήσει γάρ τις διὰ τί αἱ πέντε φωναὶ ἕν τί εἰσιν.", "seq": 4646}
{"id": "David_Passim_4647", "series": "CAG", "text": "ἔοικε δὲ τῇ λύσει ἡ διαφορά·", "seq": 4647}
{"id": "David_Passim_4648", "series": "CAG", "text": "δείκνυσι γὰρ ὅτι ἕν τι οὔκ εἰσιν καὶ ἐν τῷ δεικνύειν ὅτι ἕν τι οὔκ εἰσι τὴν ἀπορίαν λύει.", "seq": 4648}
{"id": "David_Passim_4649", "series": "CAG", "text": "εἰ προηγεῖται οὖν ἡ ἀπορία τῆς λύσεως, προηγήσεται ἄρα ἡ κοινωνία τῆς διαφορᾶς.", "seq": 4649}
{"id": "David_Passim_4650", "series": "CAG", "text": "Φησὶν οὖν ὁ Πορφύριος ὅτι καθολικὴ κοινωνία αὐτῶν ὑπάρχει τὸ κατὰ πλειόνων πάσας τὰς φωνὰς κατηγορεῖσθαι·", "seq": 4650}
{"id": "David_Passim_4651", "series": "CAG", "text": "κοινωνοῦσι γὰρ κατὰ τοῦτο, καθὸ πᾶσαι κατὰ πλειόνων κατηγοροῦνται.", "seq": 4651}
{"id": "David_Passim_4652", "series": "CAG", "text": "διαφέρουσι δὲ καθὸ οὐ πᾶσαι τοῦ αὐτοῦ ὑποκειμένου κατηγοροῦνται·", "seq": 4652}
{"id": "David_Passim_4653", "series": "CAG", "text": "αἱ μὲν γὰρ τῶν εἰδῶν κατηγοροῦνται ὡς τὸ γένος καὶ ἡ διαφορὰ καὶ τὸ συμβεβηκός, αἱ δὲ τῶν κατὰ μέρος ὥσπερ τὸ ἴδιον καὶ τὸ εἶδος.", "seq": 4653}
{"id": "David_Passim_4654", "series": "CAG", "text": "καὶ αὐτὸς μὲν ὁ Πορφύριος μίαν κοινωνίαν καὶ μίαν διαφορὰν παρέθετο, ἡμεῖς δὲ ἑκάστῳ σκέλει προσθήκην ποιησόμεθα·", "seq": 4654}
{"id": "David_Passim_4655", "series": "CAG", "text": "φέρε γὰρ καὶ ἑτέρας καθολικὰς κοινωνίας καὶ διαφορὰς παραδώσομεν καὶ πρῶτόν γε τὰς κοινωνίας.", "seq": 4655}
{"id": "David_Passim_4656", "series": "CAG", "text": "καθολικῶς πάλιν κοινωνοῦσιν, ὅτι πᾶσαι ὁμώνυμοί εἰσι.", "seq": 4656}
{"id": "David_Passim_4657", "series": "CAG", "text": "τρίτην κοινωνίαν πάλιν αὐτῶν ὁρῶμεν, ὅτι πᾶσαι ἐν μιᾷ καὶ ἑκάστῃ κατηγορίᾳ θεωροῦνται·", "seq": 4657}
{"id": "David_Passim_4658", "series": "CAG", "text": "εἰ γὰρ γένη εἰσὶν αἱ κατηγορίαι, πάντως καὶ τὰς ἄλλας φωνὰς συνεισφέρουσιν·", "seq": 4658}
{"id": "David_Passim_4659", "series": "CAG", "text": "ὅπου γὰρ γένος, ἐκεῖ καὶ αἱ ὑπόλοιποι φωναί.", "seq": 4659}
{"id": "David_Passim_4660", "series": "CAG", "text": "τετάρτην ἔτι ὁρῶμεν κοινωνίαν τὸ εἶναι πάσας ὅρους καὶ πέρατα τῶν κατὰ φιλοσοφίαν φωνῶν·", "seq": 4660}
{"id": "David_Passim_4661", "series": "CAG", "text": "πᾶσαι γὰρ αἱ κατὰ φιλοσοφίαν φωναὶ εἰς αὐτὰς περατοῦνται καὶ ἐκτὸς αὐτῶν οὐκ ἔστιν ἑτέρα.", "seq": 4661}
{"id": "David_Passim_4662", "series": "CAG", "text": "πέμπτη αὐτῶν κοινωνία ὁρᾶται τὸ συνεισάγειν καὶ συναναιρεῖν ἀλλήλας·", "seq": 4662}
{"id": "David_Passim_4663", "series": "CAG", "text": "ὅπου γάρ ἐστι μία φωνὴ τούτων, ἐκεῖ εἰσι καὶ αἱ λοιπαί, ὅπου δὲ μία ἐκλείπει, ἐκεῖ καὶ πᾶσαι ἐκλείπουσιν.", "seq": 4663}
{"id": "David_Passim_4664", "series": "CAG", "text": "εἰρηκότες τὰς κοινωνίας χωρήσωμεν καὶ ἐπὶ τὰς διαφοράς.", "seq": 4664}
{"id": "David_Passim_4665", "series": "CAG", "text": "δευτέρα διαφορὰ ὑπάρχει αὐτῶν ὁ τρόπος τῆς κατηγορίας·", "seq": 4665}
{"id": "David_Passim_4666", "series": "CAG", "text": "αἱ μὲν γὰρ ἐν τῷ τί ἐστι κατηγοροῦνται ὥσπερ τὸ γένος καὶ τὸ εἶδος, αἱ δὲ ἐν τῷ ὁποῖόν τί ἐστιν ὥσπερ ἡ διαφορὰ καὶ τὸ ἴδιον καὶ τὸ συμβεβηκός.", "seq": 4666}
{"id": "David_Passim_4667", "series": "CAG", "text": "τρίτη διαφορὰ αὐτῶν ἐστιν οἱ διάφοροι ὁρισμοί·", "seq": 4667}
{"id": "David_Passim_4668", "series": "CAG", "text": "ὧν γὰρ διάφοροι οἱ ὁρισμοί, τούτων διάφοροι καὶ αἱ οὐσίαι.", "seq": 4668}
{"id": "David_Passim_4669", "series": "CAG", "text": "τετάρτη δὲ διαφορὰ πάλιν ἐστὶ τὸ ἐκ διαιρέσεως αὐτὰς εἶναι·", "seq": 4669}
{"id": "David_Passim_4670", "series": "CAG", "text": "τὰ γὰρ ἐκ διαιρέσεως ὑπάρχοντα διάφορά ἐστιν·", "seq": 4670}
{"id": "David_Passim_4671", "series": "CAG", "text": "εἰς τὸ αὐτὸ γὰρ οὐ διαιρεῖταί τι.", "seq": 4671}
{"id": "David_Passim_4672", "series": "CAG", "text": "πέμπτη διαφορά ἐστι τὸ μὴ σημαίνειν αὐτὰς ἀλλήλας κατὰ τὸ αὐτό·", "seq": 4672}
{"id": "David_Passim_4673", "series": "CAG", "text": "τὸ γὰρ γένος οὐ σημαίνει καὶ εἶδος κατὰ τὸ αὐτό.", "seq": 4673}
{"id": "David_Passim_4674", "series": "CAG", "text": "τὰ μὴ δυνάμενα οὖν εἰς ἄλληλα λαμβάνεσθαι διάφορά ἐστιν ὁμολογουμένως.", "seq": 4674}
{"id": "David_Passim_4675", "series": "CAG", "text": "13.", "seq": 4675}
{"id": "David_Passim_4676", "series": "CAG", "text": "10 Κοινὸν μὲν δὴ πάντων τὸ κατὰ πλειόνων κατηγορεῖσθαι.", "seq": 4676}
{"id": "David_Passim_4677", "series": "CAG", "text": "Ἐκ τῆς κοινωνίας καὶ τὴν διαφορὰν λεληθότως παραδίδωσιν ὁ Πορφύριος·", "seq": 4677}
{"id": "David_Passim_4678", "series": "CAG", "text": "φησὶ γὰρ ὅτι κατηγοροῦνται κατὰ πλειόνων, ἀλλ᾿ οὐχ ὁμοίως·", "seq": 4678}
{"id": "David_Passim_4679", "series": "CAG", "text": "τὸ μὲν γὰρ γένος καὶ ἡ διαφορὰ καὶ τὸ συμβεβηκὸς εἰδῶν καὶ ἀτόμων κατηγοροῦνται, τὸ δὲ ἴδιον καὶ εἶδος ἀτόμων.", "seq": 4679}
{"id": "David_Passim_4680", "series": "CAG", "text": "κακῶς οὖν τινες λέγουσιν ὅτι εἰς τρία τμήματα διαιρεῖται τὸ βιβλίον, ἐν μὲν τῷ πρώτῳ τὰς οὐσίας αὐτῶν διδάσκον, ἐν δὲ τῷ δευτέρῳ τὰς κοινωνίας, ἐν δὲ τῷ τρίτῳ τὰς διαφοράς·", "seq": 4680}
{"id": "David_Passim_4681", "series": "CAG", "text": "ψεύδονται γάρ·", "seq": 4681}
{"id": "David_Passim_4682", "series": "CAG", "text": "ἅμα γὰρ τὰς κοινωνίας καὶ τὰς διαφορὰς παραδίδωσι.", "seq": 4682}
{"id": "David_Passim_4683", "series": "CAG", "text": "13.", "seq": 4683}
{"id": "David_Passim_4684", "series": "CAG", "text": "15 Τὸ δὲ ἄλογον.", "seq": 4684}
{"id": "David_Passim_4685", "series": "CAG", "text": "Τοῦτ᾿ ἔστιν ἡ διαφορά.", "seq": 4685}
{"id": "David_Passim_4686", "series": "CAG", "text": "καταχρηστικῶς ἄλογον αὐτὴν ἐκάλεσεν, ἔδει γὰρ ἀλογότητα <εἰπεῖν>.", "seq": 4686}
{"id": "David_Passim_4687", "series": "CAG", "text": "13.", "seq": 4687}
{"id": "David_Passim_4688", "series": "CAG", "text": "20 Ἀλλὰ προηγουμένως μὲν τῶν ἀτόμων, κατὰ δεύτερον δὲ λόγον καὶ τῶν περιεχόντων τὰ ἄτομα.", "seq": 4688}
{"id": "David_Passim_4689", "series": "CAG", "text": "Φησὶν ὅτι ἐν τοῖς ἀτόμοις πρῶτον θεωρεῖται τὸ συμβεβηκός, εἶθ᾿ ὕστερον ἐν τοῖς εἴδεσι·", "seq": 4689}
{"id": "David_Passim_4690", "series": "CAG", "text": "πρῶτον γὰρ τὸ λευκὸν καὶ θερμὸν ὁρᾶται ἐν τῷ Σωκράτει, καὶ ἐκ τούτου τὸν ἄνθρωπον λέγομεν λευκὸν ἢ θερμόν.", "seq": 4690}
{"id": "David_Passim_4691", "series": "CAG", "text": "Ἴσως δὲ ἀπορήσει τις λέγων ὅτι τὸ μὴ σημαίνειν αὐτὰς ἀλλήλας κοινωνία ὑπάρχει·", "seq": 4691}
{"id": "David_Passim_4692", "series": "CAG", "text": "ἰδοὺ γὰρ λέγω κατὰ τοῦτο κοινωνοῦσι, καθὸ εἰς ἀλλήλας οὐ λαμβάνονται.", "seq": 4692}
{"id": "David_Passim_4693", "series": "CAG", "text": "οὐκ ἔστι δὲ τὸ τοιοῦτον ἄπορον·", "seq": 4693}
{"id": "David_Passim_4694", "series": "CAG", "text": "ἐφ᾿ ὅλων γὰρ τῶν ὁμολογουμένων διαφορῶν ταὐτὸν δύναταί τις λέγειν·", "seq": 4694}
{"id": "David_Passim_4695", "series": "CAG", "text": "ἰδοὺ γὰρ λέγω καθὸ διαφέρουσι πᾶσαι ἀλλήλων, κατὰ τοῦτο κοινωνοῦσιν.", "seq": 4695}
{"id": "David_Passim_4696", "series": "CAG", "text": "οὐκ ἔστι δὲ τὸ τοιοῦτον κοινωνία ἀλλὰ διαφορά τις.", "seq": 4696}
{"id": "David_Passim_4697", "series": "CAG", "text": "Εἰρηκὼς ὁ Πορφύριος περὶ τῶν καθολικῶν κοινωνιῶν καὶ διαφορῶν χωρεῖ καὶ ἐπὶ τὰς μερικάς.", "seq": 4697}
{"id": "David_Passim_4698", "series": "CAG", "text": "καὶ πρῶτόν γε τὴν κοινωνίαν καὶ τὴν διαφορὰν τοῦ γένους πρὸς τὴν διαφορὰν λέγει.", "seq": 4698}
{"id": "David_Passim_4699", "series": "CAG", "text": "σκόπει δέ, ὅτε μὲν περὶ τῶν καθολικῶν ποιεῖται τὸν λόγον, τὴν διαφορὰν μετὰ τὸ γένος τάττει, ὅτε δὲ περὶ οὐσίας θέλει διδάξαι, τότε τὸ εἶδος δεύτερον τοῦ γένους τάττει·", "seq": 4699}
{"id": "David_Passim_4700", "series": "CAG", "text": "τὰ γὰρ πρός τι ἅμα θέλει διδάσκεσθαι.", "seq": 4700}
{"id": "David_Passim_4701", "series": "CAG", "text": "φησὶν οὖν ὅτι κοινωνεῖ τὸ γένος καὶ ἡ διαφορά, καθὸ ἄμφω εἰδῶν κατηγοροῦνται.", "seq": 4701}
{"id": "David_Passim_4702", "series": "CAG", "text": "ἔτι δὲ κοινωνοῦσιν ὅτι τὰ κατηγορούμενα τοῦ γένους ὡς γένους ταῦτα κατηγοροῦνται καὶ τῶν ὑπ᾿ αὐτὸ εἰδῶν, καὶ τὰ κατηγορούμενα τῆς διαφορᾶς ὡς διαφορᾶς ταῦτα κατηγορεῖται καὶ τῶν ὑπ᾿ αὐτὴν εἰδῶν.", "seq": 4702}
{"id": "David_Passim_4703", "series": "CAG", "text": "καλῶς λέγει ὡς γένους·", "seq": 4703}
{"id": "David_Passim_4704", "series": "CAG", "text": "τοῦτο γὰρ λέγει ‘ἅτιν᾿ ἂν κατηγορῆται τοῦ γένους οὐσιωδῶς, ταῦτα καὶ τῶν ὑπ᾿ αὐτὸ εἰδῶν κατηγορεῖται’·", "seq": 4704}
{"id": "David_Passim_4705", "series": "CAG", "text": "οἷον ἡ οὐσία τοῦ ζῴου οὐσιωδῶς κατηγορεῖται·", "seq": 4705}
{"id": "David_Passim_4706", "series": "CAG", "text": "τοῦτο δὲ καὶ τοῦ ἀνθρώπου κατηγορεῖται.", "seq": 4706}
{"id": "David_Passim_4707", "series": "CAG", "text": "τὸ ἔμψυχον πάλιν καὶ τὸ αἰσθητικὸν τοῦ ζῴου κατηγορεῖται·", "seq": 4707}
{"id": "David_Passim_4708", "series": "CAG", "text": "τοῦτο δὲ καὶ τοῦ εἴδους καὶ τοῦ ἀτόμου κατηγορεῖται·", "seq": 4708}
{"id": "David_Passim_4709", "series": "CAG", "text": "εἰ μὴ γὰρ ταῦτα ἐπὶ τοῦ γένους λάβωμεν ἀλλὰ τὰ συμβεβηκότα αὐτῷ, τὸ εἶναι αὐτὸ δισύλλαβον, τὸ καλεῖσθαι αὐτὸ γένος, τὸ καθολικῶς αὐτὸ λαμβάνεσθαι, οὐ συστήσεται ὁ λόγος·", "seq": 4709}
{"id": "David_Passim_4710", "series": "CAG", "text": "ταῦτα γὰρ τῇ οὐσία ἐμψύχῳ αἰσθητικῇ ἐπισυμβέβηκε, τὸ καλεῖσθαι αὐτὴν γένος, τὸ δισύλλαβον εἶναι, οἷον τὸ ζῷον, τὸ καθολικῶς λαμβάνεσθαι·", "seq": 4710}
{"id": "David_Passim_4711", "series": "CAG", "text": "ταῦτα δὲ τοῦ ἀνθρώπου οὐ κατηγορηθήσεται, ἐπειδὴ οὐσιωδῶς τοῦ γένους, τοῦτ᾿ ἔστι τῆς οὐσίας ἐμψύχου αἰσθητικῆς, οὐ κατηγορεῖται.", "seq": 4711}
{"id": "David_Passim_4712", "series": "CAG", "text": "ὁ αὐτὸς λόγος καὶ ἐπὶ τῆς διαφορᾶς·", "seq": 4712}
{"id": "David_Passim_4713", "series": "CAG", "text": "τὸ γὰρ οὐσιωδῶς αὐτῆς κατηγορούμενον τοῦτο καὶ τῶν ὑπ᾿ αὐτὴν εἰδῶν κατηγορηθήσεται·", "seq": 4713}
{"id": "David_Passim_4714", "series": "CAG", "text": "** οὐσίαν γὰρ ἔχει τὸ λόγῳ χρῆσθαι, φημὶ δὲ τῷ ἐνδιαθέτῳ·", "seq": 4714}
{"id": "David_Passim_4715", "series": "CAG", "text": "τοῦτο δὲ καὶ τοῦ ἀνθρώπου καὶ τῶν ἀτόμων κατηγορεῖται.", "seq": 4715}
{"id": "David_Passim_4716", "series": "CAG", "text": "ἐὰν οὖν εἴπῃς τὸ συμβεβηκὸς αὐτῆς τὸ τετρασύλλαβον, τοῦτο οὐ κατηγορεῖται τοῦ ἀνθρώπου, ἐπειδὴ οὐσία αὐτῆς οὐκ ἔστι τοῦτο.", "seq": 4716}
{"id": "David_Passim_4717", "series": "CAG", "text": "κοινωνοῦσι πάλιν ὅτι ὥσπερ ἀναιρουμένου τοῦ γένους ἀναιρεῖται καὶ τὰ ὑπ᾿ αὐτὸ εἴδη, οὕτως ἀναιρουμένης τῆς διαφορᾶς ἀναιρεῖται καὶ τὰ ὑπ᾿ αὐτὴν εἴδη.", "seq": 4717}
{"id": "David_Passim_4718", "series": "CAG", "text": "Εἰρηκὼς τὰς κοινωνίας χωρεῖ καὶ ἐπὶ τὰς διαφοράς.", "seq": 4718}
{"id": "David_Passim_4719", "series": "CAG", "text": "φησὶ δὲ ὅτι διαφέρει τὸ γένος τῆς διαφορᾶς, ὅτι τὸ μὲν γένος φύσει πρῶτόν ἐστι τῆς διαφορᾶς.", "seq": 4719}
{"id": "David_Passim_4720", "series": "CAG", "text": "ὅτι δὲ φύσει πρῶτόν ἐστι, σαφὲς ἐκ τῶν παρακολουθούντων τοῖς φύσει πρώτοις·", "seq": 4720}
{"id": "David_Passim_4721", "series": "CAG", "text": "συναναιρεῖ καὶ οὐ συναναιρεῖται·", "seq": 4721}
{"id": "David_Passim_4722", "series": "CAG", "text": "ζῴου γὰρ ὄντος ἔστιν ἄλογον καὶ λογικόν, ζῴου δὲ μὴ ὄντος οὐκ εἰσὶ τὰ τοιαῦτα·", "seq": 4722}
{"id": "David_Passim_4723", "series": "CAG", "text": "λογικοῦ δὲ καὶ ἀλόγου μὴ ὄντων ἔσται γένος·", "seq": 4723}
{"id": "David_Passim_4724", "series": "CAG", "text": "δύναται γὰρ εἶναι τὸ ζῷον, οὐσία ἔμψυχος αἰσθητική, τῶν τοιούτων μὴ ὄντων.", "seq": 4724}
{"id": "David_Passim_4725", "series": "CAG", "text": "ἔτι συνεισφέρεται καὶ οὐ συνεισφέρει·", "seq": 4725}
{"id": "David_Passim_4726", "series": "CAG", "text": "εἴ τι μὲν γὰρ λογικόν, τοῦτο καὶ ζῷον, εἴ τι δὲ ζῷον, οὐ τοῦτο καὶ λογικόν.", "seq": 4726}
{"id": "David_Passim_4727", "series": "CAG", "text": "ἔτι διαφέρει ὅτι τὸ μὲν γένος πλειόνων εἰδῶν κατηγορεῖται, ἡ δὲ διαφορὰ οὐ πολλῶν ἴσον τοῦ γένους.", "seq": 4727}
{"id": "David_Passim_4728", "series": "CAG", "text": "ὥστε οὖν καθολικώτερόν ἐστι τὸ γένος τῆς διαφορᾶς.", "seq": 4728}
{"id": "David_Passim_4729", "series": "CAG", "text": "ἔτι διαφέρουσιν ὅτι τὸ μὲν γένος δυνάμει περιέχει τὴν διαφοράν, ἡ δὲ διαφορὰ οὐ δυνάμει περιέχει τὸ γένος.", "seq": 4729}
{"id": "David_Passim_4730", "series": "CAG", "text": "ἔτι διαφέρουσιν ὅτι τὸ μὲν γένος ἐν τῷ τί ἐστι κατηγορεῖται, ἡ δὲ διαφορὰ ἐν τῷ ὁποῖόν τί ἐστιν.", "seq": 4730}
{"id": "David_Passim_4731", "series": "CAG", "text": "ἔτι διαφέρει τὸ γένος τῆς διαφορᾶς, ὅτι ἐν ἑκάστῳ εἴδει πάντως ἓν γένος θεωρεῖται, ἐν ἑκάστῳ δὲ εἴδει οὐ πάντως μία διαφορὰ ἀλλὰ πλείους·", "seq": 4731}
{"id": "David_Passim_4732", "series": "CAG", "text": "ἰδοὺ γὰρ ἐν τῷ ἀνθρώπῳ ἓν μὲν τὸ ζῷον θεωρεῖται, πολλαὶ δὲ αἱ διαφοραί, λογικὸν θνητὸν νοῦ καὶ ἐπιστήμης δεκτικόν.", "seq": 4732}
{"id": "David_Passim_4733", "series": "CAG", "text": "Ἐπειδὴ δὲ εἰρήκαμεν τὰς τοῦ φιλοσόφου κοινωνίας καὶ διαφοράς, φέρε καὶ ἡμεῖς προσευπορεύσωμεν ἑτέρας κοινωνίας καὶ διαφοράς.", "seq": 4733}
{"id": "David_Passim_4734", "series": "CAG", "text": "κοινωνοῦσιν οὖν αἱ διαφοραὶ καὶ τὰ γένη, ὅτι ὥσπερ τὰ γένη συμβάλλεται τοῖς ὁρισμοῖς, οὕτω καὶ αἱ διαφοραί.", "seq": 4734}
{"id": "David_Passim_4735", "series": "CAG", "text": "ἔτι κοινωνοῦσιν ὅτι τὰ δύο ἁπλᾶ ἐστι.", "seq": 4735}
{"id": "David_Passim_4736", "series": "CAG", "text": "κοινωνοῦσι δὲ πάλιν ὅτι μέρη συνθέτων εἰσὶν ἁπλᾶ ὄντα·", "seq": 4736}
{"id": "David_Passim_4737", "series": "CAG", "text": "ὁ γὰρ ἄνθρωπος σύνθετος·", "seq": 4737}
{"id": "David_Passim_4738", "series": "CAG", "text": "μέρη δὲ τοῦ ἀνθρώπου τὸ ζῷον καὶ τὸ λογικόν.", "seq": 4738}
{"id": "David_Passim_4739", "series": "CAG", "text": "διαφέρουσι δὲ ὅτι δύναται τὸ γένος προκόψαι, ὅπου οὐ δύναται ἡ διαφορά·", "seq": 4739}
{"id": "David_Passim_4740", "series": "CAG", "text": "οἷον τὰ γενικώτατα ὑπερβεβηκὸς γένος οὐκ ἔχει, αἱ δὲ διαφοραὶ ὅπου δἂν προκόψωσι πάντως ἔχουσι πρὸ αὐτῶν γένος.", "seq": 4740}
{"id": "David_Passim_4741", "series": "CAG", "text": "ἔτι διαφέρουσιν ὅτι τὸ μὲν γένος μεταδίδωσιν ὀνόματος καὶ πράγματος, αἱ δὲ διαφοραὶ μόνου πράγματος.", "seq": 4741}
{"id": "David_Passim_4742", "series": "CAG", "text": "14.", "seq": 4742}
{"id": "David_Passim_4743", "series": "CAG", "text": "8 Οὐ μόνον τοῦ λογικοῦ ἀλλὰ καὶ τῶν ὑπὸ τὸ λογικὸν εἰδῶν κατηγορεῖται τὸ χρῆσθαι λόγῳ.", "seq": 4743}
{"id": "David_Passim_4744", "series": "CAG", "text": "Οὐ τῷ προφορικῷ φησιν, ἐπεὶ οὐκ ἔσται ὁ ἄγγελος λογικὸς μὴ προφέρων λόγον (προφορικοὶ δὲ οὔκ εἰσιν οἱ ἄγγελοι διὰ τὸ μὴ δεῖσθαι), τὸν ἐνδιάθετον οὗν λόγον λέγει.", "seq": 4744}
{"id": "David_Passim_4745", "series": "CAG", "text": "14.", "seq": 4745}
{"id": "David_Passim_4746", "series": "CAG", "text": "14 Ἴδιον δὲ τοῦ γένους τὸ ἐπὶ πλειόνων κατηγορεῖσθαι.", "seq": 4746}
{"id": "David_Passim_4747", "series": "CAG", "text": "Ἰστέον ὡς ἀδολεσχίας τρόπον ὑπέστη ὁ Πορφύριος·", "seq": 4747}
{"id": "David_Passim_4748", "series": "CAG", "text": "λέγει γὰρ ὅτι διαφέρουσι καθὸ τὸ μὲν γένος καθολικόν ἐστιν, ἡ δὲ διαφορὰ οὐ τὸ ἴσον καθολική ἐστιν.", "seq": 4748}
{"id": "David_Passim_4749", "series": "CAG", "text": "ἐπιφέρει δὲ πάλιν ἑτέραν διαφορὰν λέγων ὅτι διαφέρει τὸ γένος τῆς διαφορᾶς, καθὸ φύσει πρῶτον ὑπάρχει.", "seq": 4749}
{"id": "David_Passim_4750", "series": "CAG", "text": "ἀδολεσχεῖ δὲ οὕτω τάξας τὰς διαφοράς·", "seq": 4750}
{"id": "David_Passim_4751", "series": "CAG", "text": "ἤδη γὰρ συμπεριέλαβε τὸ φύσει πρῶτον ἐν τῷ λέγειν καθολικώτερον εἶναι τὸ γένος τῆς διαφορᾶς·", "seq": 4751}
{"id": "David_Passim_4752", "series": "CAG", "text": "τὰ γὰρ καθολικὰ πάντα φύσει πρῶτά εἰσιν.", "seq": 4752}
{"id": "David_Passim_4753", "series": "CAG", "text": "ἔδει δὲ μᾶλλον τὸ φύσει πρῶτον τάξαι πρὸ τοῦ καθόλου·", "seq": 4753}
{"id": "David_Passim_4754", "series": "CAG", "text": "εἴ τι μὲν γὰρ καθολικόν, τοῦτο καὶ φύσει πρῶτον ὑπάρχει, οὐκ εἴ τι δὲ φύσει πρῶτον, τοῦτο καὶ καθολικόν·", "seq": 4754}
{"id": "David_Passim_4755", "series": "CAG", "text": "ἰδοὺ γὰρ ἡ μονὰς τῶν δύο φύσει πρώτη ἐστίν, οὐ καθολικωτέρα δὲ τῶν δύο καὶ τῶν τριῶν.", "seq": 4755}
{"id": "David_Passim_4756", "series": "CAG", "text": "ὅτι δὲ φύσει πρώτη ἐστί, σαφὲς ἐκ τοῦ δέχεσθαι τοὺς κανόνας τῶν φύσει πρώτων·", "seq": 4756}
{"id": "David_Passim_4757", "series": "CAG", "text": "συναναιρεῖ γὰρ καὶ οὐ συναναιρεῖται (μονάδος γὰρ μὴ οὔσης οὐκ ἔσται δύο, δύο δὲ μὴ ὄντων ἡ μονὰς ἔσται), συνεισφέρεται καὶ οὐ συνεισφέρει·", "seq": 4757}
{"id": "David_Passim_4758", "series": "CAG", "text": "ὅπου γὰρ δύο, πάντως ἔστιν ἐκεῖ καὶ μονάς, οὐχ ὅπου δὲ μονάς, ἐκεῖ καὶ δυὰς ὑπάρχει.", "seq": 4758}
{"id": "David_Passim_4759", "series": "CAG", "text": "14.", "seq": 4759}
{"id": "David_Passim_4760", "series": "CAG", "text": "14 Ἴδιον δὲ τοῦ γένους τὸ ἐπὶ πλειόνων κατηγορεῖσθαι ἤπερ ἡ διαφορὰ καὶ τὸ εἶδος καὶ τὸ ἴδιον καὶ τὸ συμβεβηκός.", "seq": 4760}
{"id": "David_Passim_4761", "series": "CAG", "text": "Ἐκ περιουσίας θέλει εἰπεῖν πῶς διαφέρει τῶν ἄλλων φωνῶν·", "seq": 4761}
{"id": "David_Passim_4762", "series": "CAG", "text": "οὐ προέκειτο γὰρ αὐτῷ εἰπεῖν, εἰ μὴ τὴν διαφορὰν αὐτοῦ καὶ τῆς διαφορᾶς.", "seq": 4762}
{"id": "David_Passim_4763", "series": "CAG", "text": "14.", "seq": 4763}
{"id": "David_Passim_4764", "series": "CAG", "text": "15 Τὸ μὲν γὰρ ζῷον ἐπ᾿ ἀνθρώπου καὶ ἵππου καὶ ὀρνέου καὶ ὄφεως, τὸ δὲ τετράπουν ἐπὶ μόνων τῶν τέσσαρας πόδας ἐχόντων.", "seq": 4764}
{"id": "David_Passim_4765", "series": "CAG", "text": "Τὸ δὲ τετράπουν ἀντὶ τοῦ ἡ διαφορά.", "seq": 4765}
{"id": "David_Passim_4766", "series": "CAG", "text": "14.", "seq": 4766}
{"id": "David_Passim_4767", "series": "CAG", "text": "18 Καὶ τὸ συμβεβηκὸς ὁμοίως ἐπ᾿ ἐλαττόνων ἤπερ τὸ γένος.", "seq": 4767}
{"id": "David_Passim_4768", "series": "CAG", "text": "Τινὲς ἀποροῦσι λέγοντες ὅτι πλειόνων κατηγορεῖται τὸ συμβεβηκὸς τοῦ γένους, καὶ τοσοῦτον ὅτι γενῶν κατηγορεῖται·", "seq": 4768}
{"id": "David_Passim_4769", "series": "CAG", "text": "πῶς οὖν ἄλλως λέγει ὁ Πορφύριος;", "seq": 4769}
{"id": "David_Passim_4770", "series": "CAG", "text": "καλῶς δὲ ἀποροῦσι, δεῖ οὖν προσθεῖναι ὅτι τὸ γένος πλειόνων κατηγορεῖται τοῦ συμβεβηκότος τοῦ θεωρουμένου δὲ ἐν αὐτῷ·", "seq": 4770}
{"id": "David_Passim_4771", "series": "CAG", "text": "τὸ γὰρ ζῷον ὅλων τῶν ὑπ᾿ αὐτὸ εἰδῶν κατηγορεῖται, τὸ φαλακρὸν δὲ οὐ κατηγορεῖται ὅλων τῶν ὑπὸ τὸ ζῷον εἰδῶν.", "seq": 4771}
{"id": "David_Passim_4772", "series": "CAG", "text": "14.", "seq": 4772}
{"id": "David_Passim_4773", "series": "CAG", "text": "19 Δεῖ δὲ διαφορὰς λαμβάνειν, αἷς τέμνεται τὸ γένος.", "seq": 4773}
{"id": "David_Passim_4774", "series": "CAG", "text": "Φησὶν ὅτι πλειόνων κατηγορεῖται τὸ γένος τῆς διαφορᾶς, διαφορᾶς δὲ λέγω τῆς διαιρετικῆς·", "seq": 4774}
{"id": "David_Passim_4775", "series": "CAG", "text": "αἱ γὰρ συμπληρωτικαὶ διαφοραὶ τοῦ ζῴου πλειόνων κατηγοροῦνται τοῦ ζῴου, τὸ ἔμψυχον καὶ τὸ αἰσθητικόν.", "seq": 4775}
{"id": "David_Passim_4776", "series": "CAG", "text": "14.", "seq": 4776}
{"id": "David_Passim_4777", "series": "CAG", "text": "21 Καὶ τὰ μὲν γένη πρότερα τῶν ὑπ᾿ αὐτὰ διαφορῶν.", "seq": 4777}
{"id": "David_Passim_4778", "series": "CAG", "text": "Εἴπομεν ὅτι ὀφείλει προτάξαι τοῦτο πρῶτον.", "seq": 4778}
{"id": "David_Passim_4779", "series": "CAG", "text": "15.", "seq": 4779}
{"id": "David_Passim_4780", "series": "CAG", "text": "4 Ἔτι τὸ γένος μὲν ἓν καθ᾿ ἕκαστον εἶδος, οἷον ἀνθρώπου τὸ ζῷον.", "seq": 4780}
{"id": "David_Passim_4781", "series": "CAG", "text": "Τινὲς ἀποροῦσι λέγοντες ὅτι καὶ πολλὰ γένη καθ᾿ ἕκαστον εἶδος θεωρεῖται·", "seq": 4781}
{"id": "David_Passim_4782", "series": "CAG", "text": "ἰδοὺ γὰρ ἐπὶ τοῦ ἀνθρώπου θεωρεῖται τὸ οὐσία τὸ ἔμψυχον καὶ τὸ ζῷον, ταῦτα δὲ γένη εἰσί·", "seq": 4782}
{"id": "David_Passim_4783", "series": "CAG", "text": "πῶς οὖν φησιν ἓν γένος εἶναι ἐν ἑκάστῳ εἴδει;", "seq": 4783}
{"id": "David_Passim_4784", "series": "CAG", "text": "καλῶς δὲ οἱ ἐξηγηταὶ πρὸς τούτους ἀπαντῶντές φασιν ὅτι ἕν ἐστι τὸ γένος·", "seq": 4784}
{"id": "David_Passim_4785", "series": "CAG", "text": "μόνον γὰρ τὸ οὐσία ὑπάρχει γένος, τὰ δὲ λοιπὰ συστατικαὶ διαφοραί εἰσιν ἀτομοῦσαι τὴν οὐσίαν μέχρι τοῦ ζῴου.", "seq": 4785}
{"id": "David_Passim_4786", "series": "CAG", "text": "τὸ αὐτὸ οὖν ἐστιν οὐσία ἔμψυχος αἰσθητικὴ καὶ τὸ ζῷον·", "seq": 4786}
{"id": "David_Passim_4787", "series": "CAG", "text": "15.", "seq": 4787}
{"id": "David_Passim_4788", "series": "CAG", "text": "6 Τὸ μὲν γένος ἔοικεν ὕλῃ, μορφῇ δὲ ἡ διαφορά.", "seq": 4788}
{"id": "David_Passim_4789", "series": "CAG", "text": "Τοῦτο κατασκευαστικόν ἐστι τοῦ λέγοντος ἐν τῷ τί ἐστι κατηγορεῖσθαι τὸ γένος, τὴν δὲ διαφορὰν ἐν τῷ ὁποῖόν τί ἐστι·", "seq": 4789}
{"id": "David_Passim_4790", "series": "CAG", "text": "φησὶ γὰρ ὅτι τῇ μορφῇ ἔοικεν ἡ διαφορά, ἡ μορφὴ δὲ ποῖόν τί ἐστιν, ὡς εἴρηται Ἀριστοτέλει ἐν Κατηγορίαις·", "seq": 4790}
{"id": "David_Passim_4791", "series": "CAG", "text": "ἡ διαφορὰ δὲ ἐοικυῖα τῇ μορφῇ ἐν τῷ ὁποῖόν τί ἐστι κατηγορηθήσεται.", "seq": 4791}
{"id": "David_Passim_4792", "series": "CAG", "text": "εἴρηται δὲ καὶ περὶ τούτου ἐν τοῖς προλαβοῦσιν.", "seq": 4792}
{"id": "David_Passim_4793", "series": "CAG", "text": "Τὴν διδασκαλίαν τῆς διαφορᾶς τὸ εἶδος διεδέξατο, ἤδη καὶ περὶ τῆς τάξεως μετ᾿ αὐτῆς διαμφισβητῆσαν.", "seq": 4793}
{"id": "David_Passim_4794", "series": "CAG", "text": "παρατίθησιν οὖν ὁ Πορφύριος τοῦ γένους καὶ τοῦ εἴδους τρεῖς κοινωνίας καὶ τέσσαρας διαφοράς.", "seq": 4794}
{"id": "David_Passim_4795", "series": "CAG", "text": "ἐπειδὴ δὲ δεῖται προσδιορισμοῦ ἡ μία τῶν διαφορῶν, φέρε πρὸ τῆς τῶν κοινωνιῶν καὶ διαφορῶν διδασκαλίας ὀλίγα περὶ αὐτῆς καταβάλωμεν.", "seq": 4795}
{"id": "David_Passim_4796", "series": "CAG", "text": "φησὶν ὅτι διαφέρει τὸ γένος τοῦ εἴδους ὅτι φύσει προτερεύει τὸ γένος τοῦ εἴδους.", "seq": 4796}
{"id": "David_Passim_4797", "series": "CAG", "text": "τούτου οὕτως ἔχοντος ἐάν ἐστι τὸ γένος καὶ εἶδος, μὴ λάβῃς κατὰ τὸ αὐτὸ γένος καὶ εἶδος, ἐπεὶ ἔσται τὸ ἓν ἑαυτοῦ προτερεῦον, ἀλλὰ τὸ ἔμψυχον λάβε γένος καὶ τὸ ζῷον εἶδος·", "seq": 4797}
{"id": "David_Passim_4798", "series": "CAG", "text": "καὶ οὕτως εὑρίσκεται ὁ λόγος καλῶς ἔχων.", "seq": 4798}
{"id": "David_Passim_4799", "series": "CAG", "text": "δεύτερος προσδιορισμός·", "seq": 4799}
{"id": "David_Passim_4800", "series": "CAG", "text": "μὴ λάβῃς μοι τὸ γένος κατ᾿ ἄλλο μὲν εἶδος καὶ πάλιν τὸ εἶδος κατ᾿ ἄλλο γένος, ἀλλ᾿ ὡσαύτως μένοι ὁ λόγος, ἐπεὶ ἐὰν λάβῃς τὸ ἔμψυχον ὡς εἶδος τὸ δὲ ζῷον ὡς γένος, εὑρίσκεται τὸ εἶδος φύσει προτερεῦον τοῦ γένους.", "seq": 4800}
{"id": "David_Passim_4801", "series": "CAG", "text": "διὰ τοῦτο οὖν εἴπομεν, ἵν᾿ ὡσαύτως μείνῃ τὸ γένος καὶ τὸ εἶδος.", "seq": 4801}
{"id": "David_Passim_4802", "series": "CAG", "text": "τρίτος προσδιορισμός·", "seq": 4802}
{"id": "David_Passim_4803", "series": "CAG", "text": "προτερεύει τὸ γένος τοῦ εἴδους οὐ κατὰ τὰς γενικὰς καὶ εἰδικὰς διαφοράς (τοῦτο δέ φημι, οὐχ ὡς γένος τὸ γένος εἴδους προτερεύει·", "seq": 4803}
{"id": "David_Passim_4804", "series": "CAG", "text": "τὰ γὰρ πρός τι ἅμα θέλει εἶναι), ἀλλὰ κατὰ τὸ πρᾶγμα·", "seq": 4804}
{"id": "David_Passim_4805", "series": "CAG", "text": "ὥσπερ γὰρ ὁ πατὴρ τοῦ υἱοῦ οὐ προτερεύει ὡς πατήρ (εἰ γὰρ πατήρ, ἅμα καὶ υἱός), ἀλλ᾿ ὡς ἄνθρωπος προτερεύει ὁ Σωφρονίσκος τοῦ Σωκράτους, οὕτω καὶ τὸ γένος οὐ προτερεύει τοῦ εἴδους ὡς γένος ἀλλ᾿ ὡς πρᾶγμα·", "seq": 4805}
{"id": "David_Passim_4806", "series": "CAG", "text": "ἡ γὰρ οὐσία ἔμψυχος αἰσθητικὴ κατὰ τὸ πρᾶγμα τοῦ ἀνθρώπου προτερεύει·", "seq": 4806}
{"id": "David_Passim_4807", "series": "CAG", "text": "προϋπῆρχε γὰρ τοῦ ἀνθρώπου.", "seq": 4807}
{"id": "David_Passim_4808", "series": "CAG", "text": "Εἰρηκότες τοὺς προσδιορισμοὺς τῆς τοιαύτης διαφορᾶς φέρε ἐπὶ τὰς κοινωνίας χωρήσωμεν, εἶθ᾿ ὕστερον ἐπὶ τὰς διαφορὰς βαδίσωμεν.", "seq": 4808}
{"id": "David_Passim_4809", "series": "CAG", "text": "κοινωνεῖ τὸ γένος καὶ τὸ εἶδος, καθὸ κατὰ πλειόνων κατηγοροῦνται.", "seq": 4809}
{"id": "David_Passim_4810", "series": "CAG", "text": "ἔτι κοινωνοῦσι καθὸ προτερεύουσιν ὧν κατηγοροῦνται·", "seq": 4810}
{"id": "David_Passim_4811", "series": "CAG", "text": "τὸ γὰρ γένος καὶ τοῦ ἀνθρώπου προτερεύει καὶ τοῦ Σωκράτους, τὸ δὲ εἶδος προτερεύει ὅλων τῶν ὑπ᾿ αὐτὸ ἀτόμων.", "seq": 4811}
{"id": "David_Passim_4812", "series": "CAG", "text": "ἔτι κοινωνοῦσιν ὅτι οἱονεὶ ὅλον εἰσί.", "seq": 4812}
{"id": "David_Passim_4813", "series": "CAG", "text": "διὰ τί δὲ ‘οἱονεὶ ὅλον’ εἴπομεν, καὶ οὐχ ὅλον;", "seq": 4813}
{"id": "David_Passim_4814", "series": "CAG", "text": "ὅτι τὸ μὲν ὅλον οὐχ ὡς ὅλον εἰς τὰ ἑαυτοῦ μέρη θεωρεῖται, ἐπεὶ ἔσται τῶν μερῶν ἓν καὶ ἕκαστον ὅλον, τὸ δὲ γένος, φημὶ δὲ τὸ ζῷον, ὅλον ὡς ὅλον θεωρεῖται ἐν τῷ ἁπλῶς ἀνθρώπῳ καὶ Σωκράτει, αὐτός τε ὁ ἄνθρωπος ἐν τῷ Σωκράτει ὅλος ὡς ὅλος θεωρεῖται, ὅτι ἔχει τὸ ὅλον τὸ διαιρεθὲν εἰς πολλούς.", "seq": 4814}
{"id": "David_Passim_4815", "series": "CAG", "text": "διαφέρουσι δὲ ὅτι τὸ μὲν γένος φύσει προτερεύει, τὸ δὲ εἶδος οὐκέτι·", "seq": 4815}
{"id": "David_Passim_4816", "series": "CAG", "text": "πῶς δὲ φύσει προτερεύει εἰρήκαμεν.", "seq": 4816}
{"id": "David_Passim_4817", "series": "CAG", "text": "ἔτι δὲ διαφέρουσιν ὅτι τὸ μὲν γένος ὕλῃ ἔοικε, τὸ δὲ εἶδος μορφωθείσῃ ὕλῃ, ὡς ἵνα νοήσῃς μοι τὸν ἀνδριάντα ἐκ χαλκοῦ καὶ μορφῆς συνιστάμενον·", "seq": 4817}
{"id": "David_Passim_4818", "series": "CAG", "text": "τοιοῦτον γὰρ καὶ ὁ ἄνθρωπος·", "seq": 4818}
{"id": "David_Passim_4819", "series": "CAG", "text": "ὥστε οὖν ὁ μὲν ἄνθρωπος σύνθεσις εὑρίσκεται, τὸ δὲ γένος ἁπλοῦν.", "seq": 4819}
{"id": "David_Passim_4820", "series": "CAG", "text": "πιστοῦται δὲ αὕτη ἡ διαφορὰ τὴν πρὸ αὐτῆς·", "seq": 4820}
{"id": "David_Passim_4821", "series": "CAG", "text": "εἰ γὰρ ἔοικε τὸ γένος τῇ ὕλῃ, τὸ δὲ εἶδος τῇ μορφωθείσῃ ὕλῃ, ὁμολογουμένως τὸ γένος τοῦ εἴδους φύσει προτερεύει, ὥσπερ ἡ ἄμορφος ὕλη τῆς μορφωθείσης.", "seq": 4821}
{"id": "David_Passim_4822", "series": "CAG", "text": "ἀποδίδωσι δὲ καὶ ἑτέρας δύο διαφοράς, τὴν μὲν μίαν ἐξ ἀντανισώσεως καταφατικῆς, τὴν δὲ ἑτέραν ἐξ ἀντανισώσεως ἀποφατικῆς.", "seq": 4822}
{"id": "David_Passim_4823", "series": "CAG", "text": "ποία δέ ἐστιν ἡ ἐκ καταφατικῆς διαφορά;", "seq": 4823}
{"id": "David_Passim_4824", "series": "CAG", "text": "διαφέρει τὸ γένος τοῦ εἴδους ὅτι πλείονας ἔχει διαφοράς·", "seq": 4824}
{"id": "David_Passim_4825", "series": "CAG", "text": "ἔχει γὰρ τὰς ἀντιδιαιρετικὰς δυνάμει, τὸ λογικὸν καὶ τὸ ἄλογον.", "seq": 4825}
{"id": "David_Passim_4826", "series": "CAG", "text": "τὸ δὲ εἶδος οὐκέτι τὰς ἀντιδιαιρετικὰς ἔχει, ἔχει δὲ πλείονας, καθὸ ἐνεργείᾳ αὐτὰς ἔχει.", "seq": 4826}
{"id": "David_Passim_4827", "series": "CAG", "text": "διὰ τοῦτο καὶ ἀνωτέρω ἐλέγομεν τὴν διαφορὰν περιττεύειν τῷ εἴδει τοῦ γένους.", "seq": 4827}
{"id": "David_Passim_4828", "series": "CAG", "text": "καταφατικὴ δὲ εἴρηται διὰ τὸ καὶ τὸ γένος ἔχειν πλείονας καὶ τὸ εἶδος.", "seq": 4828}
{"id": "David_Passim_4829", "series": "CAG", "text": "ἀποφατικὴ δὲ διαφορά ἐστιν ἡ λέγουσα ὅτι οὔτε τὸ γενικώτατον γένος δύναται καὶ εἶδος εἶναι οὔτε τὸ εἰδικώτατον εἶδος δύναται καὶ γένος εἶναι.", "seq": 4829}
{"id": "David_Passim_4830", "series": "CAG", "text": "ἀποφατικὴ δὲ εἴρηται διὰ τὸ ἀπαγορεύειν ἑκάτερον.", "seq": 4830}
{"id": "David_Passim_4831", "series": "CAG", "text": "εἰρηκότες δὲ τὰς κοινωνίας καὶ τὰς διαφορὰς τοῦ φιλοσόφου φέρε κατὰ τὸ σύνηθες καὶ ἑτέρας προσευπορήσωμεν.", "seq": 4831}
{"id": "David_Passim_4832", "series": "CAG", "text": "κοινωνεῖ τὸ γένος καὶ τὸ εἶδος, καθὸ δύνανται καὶ γένη καὶ εἴδη εἶναι.", "seq": 4832}
{"id": "David_Passim_4833", "series": "CAG", "text": "ἔτι δὲ κοινωνοῦσι καθὸ συνωνύμως κατηγοροῦνται·", "seq": 4833}
{"id": "David_Passim_4834", "series": "CAG", "text": "τὸ γὰρ γένος καὶ τῷ εἴδει καὶ τῷ ἀτόμῳ μεταδίδωσιν ὀνόματος καὶ πράγματος καὶ τὸ εἶδος ὁμοίως τοῖς ἀτόμοις.", "seq": 4834}
{"id": "David_Passim_4835", "series": "CAG", "text": "ἔτι δὲ κοινωνοῦσι καθὸ ἐν τῷ τί ἐστι κατηγοροῦνται.", "seq": 4835}
{"id": "David_Passim_4836", "series": "CAG", "text": "διαφέρουσι δὲ ὅτι τὰ μὲν γένη ὥρισται καὶ τῇ φύσει καὶ τῇ γνώσει, τὰ δὲ εἴδη μόνῃ τῇ φύσει ὥρισται.", "seq": 4836}
{"id": "David_Passim_4837", "series": "CAG", "text": "χωρητέον δὲ ἐπὶ τὴν λέξιν.", "seq": 4837}
{"id": "David_Passim_4838", "series": "CAG", "text": "15.", "seq": 4838}
{"id": "David_Passim_4839", "series": "CAG", "text": "11 Εἰλήφθω δὲ τὸ εἶδος ὡς εἶδος ἀλλ᾿ οὐχ ὡς γένος.", "seq": 4839}
{"id": "David_Passim_4840", "series": "CAG", "text": "Ἰδοὺ πρῶτον προσδιορισμὸν παραδίδωσιν ὁ Πορφύριος·", "seq": 4840}
{"id": "David_Passim_4841", "series": "CAG", "text": "φησὶ γὰρ ὅτι ἐὰν δύνηται τὸ γένος εἶναι καὶ εἶδος, μὴ λάβῃς αὐτὸ καὶ εἶδος ἀλλὰ γένος.", "seq": 4841}
{"id": "David_Passim_4842", "series": "CAG", "text": "τοῦτο δὲ λέγει, ἵνα μὴ λάβῃς ἅμα γένος καὶ εἶδος, καὶ ἔσται τὸ αὐτὸ ἑαυτοῦ προτερεῦον.", "seq": 4842}
{"id": "David_Passim_4843", "series": "CAG", "text": "15.", "seq": 4843}
{"id": "David_Passim_4844", "series": "CAG", "text": "15 Διαφέρει δὲ ὅτι τὸ μὲν γένος περιέχει τὰ εἴδη, τὰ δὲ εἴδη περιέχεται καὶ οὐ περιέχει τὰ γένη·", "seq": 4844}
{"id": "David_Passim_4845", "series": "CAG", "text": "ἐπὶ πλεῖον γὰρ τὸ γένος τοῦ εἴδους·", "seq": 4845}
{"id": "David_Passim_4846", "series": "CAG", "text": "Ἐν τῷ λέγειν τὸ γένος περιέχει τὰ εἴδη καὶ καθολικώτερόν ἐστι (τοῦτο γὰρ σημαίνει τὸ ἐπὶ πλέον), δεικνύει ὅτι καὶ φύσει προτερεύει·", "seq": 4846}
{"id": "David_Passim_4847", "series": "CAG", "text": "τὰ γὰρ καθολικώτερα, ὡς εἴρηται, φύσει προτερεύει.", "seq": 4847}
{"id": "David_Passim_4848", "series": "CAG", "text": "15.", "seq": 4848}
{"id": "David_Passim_4849", "series": "CAG", "text": "20 Καὶ τὰ μὲν γένη συνωνύμως τῶν εἰδῶν κατηγορεῖται, τὰ δὲ εἴδη τῶν γενῶν οὐκέτι.", "seq": 4849}
{"id": "David_Passim_4850", "series": "CAG", "text": "Ταὐτόν ἐστι τῇ πρώτῃ διαφορᾷ.", "seq": 4850}
{"id": "David_Passim_4851", "series": "CAG", "text": "15.", "seq": 4851}
{"id": "David_Passim_4852", "series": "CAG", "text": "21 Ἔτι τὰ μὲν γένη πλεονάζει τῇ τῶν ὑπ᾿ αὐτὰ εἰδῶν περιοχῇ (τοῦτ᾿ ἔστι ταῖς ἀντιδιαιρουμέναις διαφοραῖς), τὰ δὲ εἴδη τῶν γενῶν πλεονάζει ταῖς οἰκείαις διαφοραῖς (καθὸ ἐνεργείᾳ ἔχει αὐτά).", "seq": 4852}
{"id": "David_Passim_4853", "series": "CAG", "text": "Πάρεσμεν τοῦ γένους καὶ τοῦ ἰδίου τὰς κοινωνίας καὶ τὰς διαφορὰς παραδώσοντες.", "seq": 4853}
{"id": "David_Passim_4854", "series": "CAG", "text": "κοινωνεῖ δὲ τὸ γένος καὶ τὸ ἴδιον, καθὸ τὰ δύο συνεισφέρεται, ὑφ᾿ ὧν κατηγοροῦνται·", "seq": 4854}
{"id": "David_Passim_4855", "series": "CAG", "text": "ὁ ἄνθρωπος γὰρ εἰσφέρει καὶ τὸ ζῷον, εἰσφέρει δὲ καὶ τὸ γελαστικόν·", "seq": 4855}
{"id": "David_Passim_4856", "series": "CAG", "text": "εἴ τι μὲν γὰρ ἄνθρωπος, τοῦτο καὶ ζῷον, καὶ εἴ τι ἄνθρωπος, τοῦτο καὶ γελαστικόν.", "seq": 4856}
{"id": "David_Passim_4857", "series": "CAG", "text": "ἔτι κοινωνοῦσιν ὅτι ἐπίσης μετέχονται ὧν κατηγοροῦνται·", "seq": 4857}
{"id": "David_Passim_4858", "series": "CAG", "text": "τὸ γὰρ ζῷόν ἐστιν ἐπίσης ἵππῳ καὶ ἀνθρώπῳ, καὶ τὸ γελαστικὸν ὁμοίως ἐπίσης ἐστὶ Πλάτωνι καὶ Ἀλκιβιάδῃ.", "seq": 4858}
{"id": "David_Passim_4859", "series": "CAG", "text": "ἔτι δὲ κοινωνοῦσι καθὸ συνωνύμως κατηγοροῦνται·", "seq": 4859}
{"id": "David_Passim_4860", "series": "CAG", "text": "ὡς γὰρ τὸ ζῷον συνωνύμως κατηγορεῖται τοῦ ἀνθρώπου (μεταδίδωσι γὰρ ὀνόματος καὶ πράγματος), οὕτω καὶ τὸ γελαστικὸν συνωνύμως κατηγορεῖται Πλάτωνος·", "seq": 4860}
{"id": "David_Passim_4861", "series": "CAG", "text": "ὀνόματος γὰρ αὐτῷ μεταδίδωσι, καθὸ δύνασαι καὶ γελαστικὸν λέγειν Πλάτωνα, ἀλλὰ μὴν καὶ πράγματος, καθὸ καὶ τοῦ γελᾶν μεταδίδωσι Πλάτωνι.", "seq": 4861}
{"id": "David_Passim_4862", "series": "CAG", "text": "διαφέρουσι δὲ ὅτι τὸ γένος προτερεύει τοῦ ἰδίου·", "seq": 4862}
{"id": "David_Passim_4863", "series": "CAG", "text": "πρῶτον γάρ ἐστι τὸ ζῷον τὸ διαιρούμενον εἰς λογικὸν καὶ ἄλογον, ὕστερον δὲ τὸ ἴδιον τὸ φαινόμενον ἐν ταῖς διαφοραῖς·", "seq": 4863}
{"id": "David_Passim_4864", "series": "CAG", "text": "μεθὸ γὰρ γίνεται τὸ λογικόν, γίνεται τὸ γελαστικόν.", "seq": 4864}
{"id": "David_Passim_4865", "series": "CAG", "text": "ἔτι διαφέρουσιν ὅτι τὸ μὲν γένος πολλῶν εἰδῶν κατηγορεῖται, τὸ δὲ ἴδιον ἑνὸς εἴδους.", "seq": 4865}
{"id": "David_Passim_4866", "series": "CAG", "text": "ἔτι διαφέρουσιν ὅτι τὸ μὲν γένος οὐκ ἀντιστρέφει πρὸς τὰ εἴδη, τὸ δὲ ἴδιον ἀντιστρέφει·", "seq": 4866}
{"id": "David_Passim_4867", "series": "CAG", "text": "εἴ τι γὰρ γελαστικόν, τοῦτο καὶ ἄνθρωπος, καὶ εἴ τι ἄνθρωπος, τοῦτο καὶ γελαστικόν, οὐκ εἴ τι δὲ ζῷον, τοῦτο καὶ ἄνθρωπος.", "seq": 4867}
{"id": "David_Passim_4868", "series": "CAG", "text": "χωρήσωμεν δὲ καὶ ἐπὶ τὴν λέξιν.", "seq": 4868}
{"id": "David_Passim_4869", "series": "CAG", "text": "16.", "seq": 4869}
{"id": "David_Passim_4870", "series": "CAG", "text": "3 Καὶ τὸ ἐπίσης τὸ γένος κατηγορεῖσθαι τῶν εἰδῶν καὶ τὸ ἴδιον τῶν αὐτοῦ μετεχόντων.", "seq": 4870}
{"id": "David_Passim_4871", "series": "CAG", "text": "Τινὲς ἀμφιβάλλουσι λέγοντες ἄδηλον εἰρηκέναι τὸν Πορφύριον περὶ ποίου ἰδίου ὁ λόγος ὑπάρχει·", "seq": 4871}
{"id": "David_Passim_4872", "series": "CAG", "text": "διττὸν γὰρ τὸ ἴδιον·", "seq": 4872}
{"id": "David_Passim_4873", "series": "CAG", "text": "τὸ μὲν γὰρ πολλῶν εἰδῶν κατηγορεῖται, τὸ δὲ ἑνὸς εἴδους.", "seq": 4873}
{"id": "David_Passim_4874", "series": "CAG", "text": "καὶ πολλῶν μὲν ὡς τὸ κινητικόν·", "seq": 4874}
{"id": "David_Passim_4875", "series": "CAG", "text": "τὸ γὰρ κινητικὸν ἴδιόν ἐστι τοῦ ζῴου·", "seq": 4875}
{"id": "David_Passim_4876", "series": "CAG", "text": "ἀμέλει καὶ ἀντιστρέφει·", "seq": 4876}
{"id": "David_Passim_4877", "series": "CAG", "text": "εἴ τι γὰρ ζῷον, τοῦτο καὶ κινητικόν, καὶ εἴ τι κινητικόν, τοῦτο καὶ ζῷον.", "seq": 4877}
{"id": "David_Passim_4878", "series": "CAG", "text": "κατηγορεῖται δὲ τὸ κινητικὸν πολλῶν εἰδῶν·", "seq": 4878}
{"id": "David_Passim_4879", "series": "CAG", "text": "ἔστι γὰρ καὶ ἐν ἀνθρώπῳ καὶ κυνὶ καὶ ἵππῳ καὶ ἄλλοις πολλοῖς εἴδεσιν.", "seq": 4879}
{"id": "David_Passim_4880", "series": "CAG", "text": "ἑνὸς δὲ εἴδους κατηγορεῖται τὸ ἴδιον ὡς τὸ γελαστικὸν τοῦ ἀνθρώπου.", "seq": 4880}
{"id": "David_Passim_4881", "series": "CAG", "text": "τούτου οὕτως ἔχοντος ἄδηλον ἡμῖν φαίνεται περὶ ποίου ἰδίου λέγει ὁ Πορφύριος·", "seq": 4881}
{"id": "David_Passim_4882", "series": "CAG", "text": "ἐν μὲν γὰρ τῇ κοινωνίᾳ αὐτῶν τὸ πολλῶν εἰδῶν κατηγορούμενον λέγει, ἐν δὲ τῇ διαφορᾷ τὸ πολλῶν εἰδῶν κατηγορούμενον οὐ λέγει, ἀλλ᾿ ἑνὸς εἴδους.", "seq": 4882}
{"id": "David_Passim_4883", "series": "CAG", "text": "περὶ ποίου δὲ ὁ λόγος αὐτῷ ὑπάρχει, οὐκ οἴδαμεν.", "seq": 4883}
{"id": "David_Passim_4884", "series": "CAG", "text": "ἐπιλύονται δὲ λέγοντες οὕτως, ὅτι ἕκαστον ἴδιον συμπεριέλαβε·", "seq": 4884}
{"id": "David_Passim_4885", "series": "CAG", "text": "φησὶ γὰρ ὅτι τὸ γένος πάντως πλειόνων εἰδῶν κατηγορεῖται, τὸ δὲ ἴδιον οὐ πάντως πλειόνων·", "seq": 4885}
{"id": "David_Passim_4886", "series": "CAG", "text": "καὶ ἑνὸς γὰρ κατηγορεῖται.", "seq": 4886}
{"id": "David_Passim_4887", "series": "CAG", "text": "τὸ τοιοῦτον δὲ ληρῶδες ὑπάρχει·", "seq": 4887}
{"id": "David_Passim_4888", "series": "CAG", "text": "ἐκ ταύτης γὰρ τῆς ζητήσεως πολλὰ ἄτοπα ἕψεται·", "seq": 4888}
{"id": "David_Passim_4889", "series": "CAG", "text": "τοῦ γὰρ Πορφυρίου ὁμολογουμένως ὧδε καὶ ἐν ἑτέροις εἰρηκότος μὴ εἶναι τὸ ἴδιον πολλῶν εἰδῶν, ἀλλ᾿ ἑνὸς καὶ μόνου καὶ ἀεί, περὶ οὗ καὶ τὸν λόγον ποιούμεθα, οἱ τοιαύτην ζήτησιν καταβαλλόμενοι ἄτοπα πολλὰ παραδεδώκασι·", "seq": 4889}
{"id": "David_Passim_4890", "series": "CAG", "text": "τὸ κινητικὸν γὰρ οὐσιώδη διαφορὰν δηλοῦν τοῦ ζῴου ἴδιον αὐτοῦ λέγουσιν.", "seq": 4890}
{"id": "David_Passim_4891", "series": "CAG", "text": "ἀτόπως δὲ λέγεται ἴδιον εἶναι πολλῶν εἰδῶν ὑπάρχον.", "seq": 4891}
{"id": "David_Passim_4892", "series": "CAG", "text": "τὸ ἴδιον πάντως ἑνὸς ὑπάρχει.", "seq": 4892}
{"id": "David_Passim_4893", "series": "CAG", "text": "συμβεβηκότι δὲ μᾶλλον τὸ τοιοῦτον ἁρμόζει.", "seq": 4893}
{"id": "David_Passim_4894", "series": "CAG", "text": "πλάνη δὲ γέγονε τῆς λέξεως ὑπόνοιαν παρεχούσης φάσκειν τὸν Πορφύριον πολλῶν εἰδῶν τὸ ἴδιον κατηγορεῖσθαι.", "seq": 4894}
{"id": "David_Passim_4895", "series": "CAG", "text": "τὸ δὲ ἀληθὲς οὐ τοῦτο ἐδήλου·", "seq": 4895}
{"id": "David_Passim_4896", "series": "CAG", "text": "τῷ γὰρ λέγειν τοῖς εἴδεσιν οὐ λέγει τὸ ἴδιον εἰδῶν κατηγορεῖσθαι, ἀλλὰ λέγει ὅτι τὸ γένος καὶ τὸ ἴδιον ὑπὸ τῶν εἰδῶν εἰσφέρεται, οὐ μέντοι τὸ ἴδιον λέγει πολλῶν εἰδῶν κατηγορεῖσθαι.", "seq": 4896}
{"id": "David_Passim_4897", "series": "CAG", "text": "16.", "seq": 4897}
{"id": "David_Passim_4898", "series": "CAG", "text": "6 Κοινὸν δὲ καὶ τὸ συνωνύμως κατηγορεῖσθαι.", "seq": 4898}
{"id": "David_Passim_4899", "series": "CAG", "text": "Τινὲς λέγουσιν ὅτι οὐκ ἔδει λέγειν Πορφύριον συνωνύμως τὸ ἴδιον κατηγορεῖσθαι·", "seq": 4899}
{"id": "David_Passim_4900", "series": "CAG", "text": "πῶς γὰρ συμβεβηκὸς μεταδίδωσιν ὀνόματος καὶ πράγματος;", "seq": 4900}
{"id": "David_Passim_4901", "series": "CAG", "text": "οἱ τοιαῦτα δὲ λέγοντες οὐδέποτε Ἀριστοτέλους ἀκροαταὶ γεγόνασιν, ὃς ἐν ταῖς Κατηγορίαις φανερῶς λέγει καὶ τὰ συμβεβηκότα συνωνύμως κατηγορεῖσθαι.", "seq": 4901}
{"id": "David_Passim_4902", "series": "CAG", "text": "16.", "seq": 4902}
{"id": "David_Passim_4903", "series": "CAG", "text": "9 Διαφέρει δὲ ὅτι τὸ μὲν γένος πρότερον, ὕστερον δὲ τὸ ἴδιον.", "seq": 4903}
{"id": "David_Passim_4904", "series": "CAG", "text": "Τινὲς λέγουσιν ὅτι οὐ πάντως προτερεύει τὸ γένος τοῦ ἰδίου·", "seq": 4904}
{"id": "David_Passim_4905", "series": "CAG", "text": "ἰδοὺ γὰρ τὸ ζῷον καὶ τὸ κινητικὸν ἅμα ἐστίν·", "seq": 4905}
{"id": "David_Passim_4906", "series": "CAG", "text": "οὔτε γὰρ προτερεύει τὸ ζῷον τοῦ κινητικοῦ.", "seq": 4906}
{"id": "David_Passim_4907", "series": "CAG", "text": "ἀπολογοῦνται δὲ λέγοντες ὅτι καθὸ ὑποκείμενόν ἐστι τὸ γένος, τὰ δὲ ἴδια ἐν ὑποκειμένῳ (ὑποκείμενον δὲ τὸ γένος, καθὸ ἔοικε τῇ ὕλῃ, ἐν ὑποκειμένῳ δὲ τὸ ἴδιον, **), διὰ τοῦτο τὸ γένος προτερεύει τοῦ ἰδίου.", "seq": 4907}
{"id": "David_Passim_4908", "series": "CAG", "text": "ἀνόητα δὲ φθέγγονται οἱ τοιαῦτα ζητοῦντες καὶ ἀπολογούμενοι·", "seq": 4908}
{"id": "David_Passim_4909", "series": "CAG", "text": "ἡ γὰρ ἀπορία προῆλθεν ἐκ τῆς κακῆς αὐτῶν ζητήσεως·", "seq": 4909}
{"id": "David_Passim_4910", "series": "CAG", "text": "ἔφαμεν γὰρ ὡς οὐκ ἔδει λαβεῖν τὸ κινητικὸν ἴδιον, καὶ οὕτως οὔτε δύναταί τις λέγειν τὰ ἴδια μὴ εἶναι ὕστερα τῶν γενῶν οὔτε ψυχρῶς ἐπιλύσεται φάσκων τὸ ἴδιον ἐν ὑποκειμένῳ ἐοικέναι.", "seq": 4910}
{"id": "David_Passim_4911", "series": "CAG", "text": "ὅμως δὲ εἰ καὶ καλῶς ἐπελύσαντο, ἀλλ᾿ οὖν οὐ καλῶς ἡ ἀπορία προῆλθεν.", "seq": 4911}
{"id": "David_Passim_4912", "series": "CAG", "text": "δεῖ οὖν δέχεσθαι μόνον τὸ ἴδιον ἑνὸς εἴδους κατηγορεῖσθαι, καὶ οὕτως ὕστερον τοῦ γένους εὑρίσκεται.", "seq": 4912}
{"id": "David_Passim_4913", "series": "CAG", "text": "16.", "seq": 4913}
{"id": "David_Passim_4914", "series": "CAG", "text": "9 Δεῖ γὰρ εἶναι ζῷον, εἶτα διαιρεῖσθαι διαφοραῖς καὶ ἰδίοις.", "seq": 4914}
{"id": "David_Passim_4915", "series": "CAG", "text": "Τὸ γὰρ ζῷον προϋπάρχει, ὕστερον δὲ διαιρεῖται τῷ λογικῷ καὶ τῷ γελαστικῷ.", "seq": 4915}
{"id": "David_Passim_4916", "series": "CAG", "text": "16.", "seq": 4916}
{"id": "David_Passim_4917", "series": "CAG", "text": "11 Καὶ τὸ μὲν ἴδιον ἀντικατηγορεῖται.", "seq": 4917}
{"id": "David_Passim_4918", "series": "CAG", "text": "Ἀντὶ τοῦ ἀντιστρέφει.", "seq": 4918}
{"id": "David_Passim_4919", "series": "CAG", "text": "τὸ δὲ γένος οὔτε πρὸς τὸ εἶδος οὔτε πρὸς τὸ ἴδιον ἀντιστρέφει.", "seq": 4919}
{"id": "David_Passim_4920", "series": "CAG", "text": "16.", "seq": 4920}
{"id": "David_Passim_4921", "series": "CAG", "text": "14 Ἔτι τὸ μὲν ἴδιον παντὶ τῷ εἴδει ὑπάρχει, οὗ ἐστιν ἴδιον, καὶ μόνῳ καὶ ἀεί, τὸ δὲ γένος παντὶ μὲν τῷ εἴδει, οὗ ἂν ᾖ γένος, καὶ ἀεί, οὐ μέντοι καὶ μόνῳ.", "seq": 4921}
{"id": "David_Passim_4922", "series": "CAG", "text": "Αὕτη οὐκ ἔστι διαφορὰ κατ᾿ ἰδίαν.", "seq": 4922}
{"id": "David_Passim_4923", "series": "CAG", "text": "κατασκευάζει δὲ τὸ δεύτερον·", "seq": 4923}
{"id": "David_Passim_4924", "series": "CAG", "text": "τὸ γὰρ δεύτερον λέγει ἀντιστρέφειν τὸ ἴδιον.", "seq": 4924}
{"id": "David_Passim_4925", "series": "CAG", "text": "διὰ τί;", "seq": 4925}
{"id": "David_Passim_4926", "series": "CAG", "text": "ἐπειδὴ καὶ μόνῳ καὶ παντὶ καὶ ἀεὶ τῷ εἴδει ὑπάρχει.", "seq": 4926}
{"id": "David_Passim_4927", "series": "CAG", "text": "τὸ δὲ γένος οὐκ ἀντιστρέφει, ἐπειδὴ οὐ μόνῳ ὑπάρχει.", "seq": 4927}
{"id": "David_Passim_4928", "series": "CAG", "text": "ἐν τούτῳ δείκνυται ὅτι καὶ καθολικώτερόν ἐστι τὸ γένος.", "seq": 4928}
{"id": "David_Passim_4929", "series": "CAG", "text": "16.", "seq": 4929}
{"id": "David_Passim_4930", "series": "CAG", "text": "16 Ἔτι τὰ μὲν ἴδια ἀναιρούμενα οὐ συναναιρεῖ τὰ γένη, τὰ δὲ γένη ἀναιρούμενα συναναιρεῖ τὰ εἴδη, ὧν ἐστιν ἴδια·", "seq": 4930}
{"id": "David_Passim_4931", "series": "CAG", "text": "Καλῶς λέγει·", "seq": 4931}
{"id": "David_Passim_4932", "series": "CAG", "text": "ἐὰν γὰρ εἴπω ‘οὐ ζῶον ἔστι’, δηλῶ ὅτι οὐδὲ γελαστικόν·", "seq": 4932}
{"id": "David_Passim_4933", "series": "CAG", "text": "ἐὰν δὲ εἴπω ‘οὐ γελαστικόν’, οὐ συναναιρῶ τὸ ζῷον·", "seq": 4933}
{"id": "David_Passim_4934", "series": "CAG", "text": "ἔστι γὰρ ζῷα μὴ γελαστικά.", "seq": 4934}
{"id": "David_Passim_4935", "series": "CAG", "text": "ταὐτὸν δέ ἐστι τῇ πρώτῃ διαφορᾷ·", "seq": 4935}
{"id": "David_Passim_4936", "series": "CAG", "text": "ἐξ οὗ γὰρ ἐδείχθη ὡς καθολικώτερόν ἐστι τὸ γένος τοῦ ἰδίου, συναναιρεῖ καὶ οὐ συναναιρεῖται.", "seq": 4936}
{"id": "David_Passim_4937", "series": "CAG", "text": "Ἵνα δὲ κατὰ τὸ ἔθος προσευπορήσωμεν κοινωνίας καὶ διαφοράς, φέρε μίαν κοινωνίαν καὶ μίαν διαφορὰν παραδώσομεν.", "seq": 4937}
{"id": "David_Passim_4938", "series": "CAG", "text": "κοινὸν ἔχουσι τὸ πάντα τὰ ὁμοειδῆ ἑκατέρου μετέχειν·", "seq": 4938}
{"id": "David_Passim_4939", "series": "CAG", "text": "ὁ γὰρ Σωκράτης καὶ Πλάτων ζῴου μετέχουσιν, ὁμοίως δὲ καὶ τοῦ γελαστικοῦ.", "seq": 4939}
{"id": "David_Passim_4940", "series": "CAG", "text": "μὴ νόμιζε δὲ τοῦτο ἐοικέναι τῷ λέγοντι ἐπίσης κατηγορεῖσθαι αὐτὰ τῶν ὑπ᾿ αὐτά·", "seq": 4940}
{"id": "David_Passim_4941", "series": "CAG", "text": "ἐκεῖνο γὰρ τὸ μᾶλλον καὶ ἧττον δηλοῖ, τοῦτο δὲ οὐχὶ τὸ μᾶλλον καὶ ἧττον, ἀλλὰ μόνον μετέχειν τὰ ὁμοειδῆ τούτων.", "seq": 4941}
{"id": "David_Passim_4942", "series": "CAG", "text": "διαφορὰν δὲ ἔχουσιν ὅτι τὸ μὲν γένος ὡς γένος ἐν τοῖς ἀτόμοις θεωρεῖται, τὸ δὲ ἴδιον οὐχ ὡς ἴδιον ἀλλ᾿ ὡς συμβεβηκός·", "seq": 4942}
{"id": "David_Passim_4943", "series": "CAG", "text": "ἀμέλει οὐκ ἀντιστρέφει ἐν τοῖς ἀτόμοις·", "seq": 4943}
{"id": "David_Passim_4944", "series": "CAG", "text": "εἴ τι μὲν γὰρ Σωκράτης ἐστί, τοῦτο καὶ γελαστικόν, οὐκ εἴ τι δὲ γελαστικὸν, τοῦτο καὶ Σωκράτης ἐστίν.", "seq": 4944}
{"id": "David_Passim_4945", "series": "CAG", "text": "εἰ δὲ ἦν ἴδιον, ὤφειλεν ἀντιστρέφειν, ὡς ἐδείχθη.", "seq": 4945}
{"id": "David_Passim_4946", "series": "CAG", "text": "Καταλλήλῳ τῇ τάξει χρησάμενοι πάρεσμεν τοῦ γένους καὶ τοῦ συμβεβηκότος τὰς κοινωνίας καὶ τὰς διαφορὰς παραδώσοντες, ἀλλ᾿ οὐκ ἰσαρίθμους τὰς κοινωνίας καὶ τὰς διαφοράς·", "seq": 4946}
{"id": "David_Passim_4947", "series": "CAG", "text": "μίαν γὰρ κοινωνίαν παραδίδωσι, τρεῖς δὲ διαφοράς.", "seq": 4947}
{"id": "David_Passim_4948", "series": "CAG", "text": "ἀποροῦσι δέ τινες λέγοντες ‘διὰ τί ἐπὶ μὲν τῶν ἄλλων φωνῶν πολλὰς κοινωνίας τοῦ γένους παρέθετο, ἐπὶ δὲ τοῦ συμβεβηκότος μίαν;’", "seq": 4948}
{"id": "David_Passim_4949", "series": "CAG", "text": "ἔστι δὲ εἰπεῖν πρὸς τούτους ὅτι πάνυ πόρρω διέστηκε τοῦ συμβεβηκότος τὸ γένος·", "seq": 4949}
{"id": "David_Passim_4950", "series": "CAG", "text": "τὸ μὲν γὰρ γένος ἄκρα οὐσία ἐστί, τὸ δὲ συμβεβηκὸς ἄκρον ἐπουσιῶδες.", "seq": 4950}
{"id": "David_Passim_4951", "series": "CAG", "text": "κατὰ πολλὰ δὲ ἔστι δεῖξαι ταῦτα διεστηκότα, εἰ μὴ ἐκ τῆς θεωρίας αὑτοὺς παρακρούειν ἐμέλλομεν.", "seq": 4951}
{"id": "David_Passim_4952", "series": "CAG", "text": "παραδίδωσιν οὖν ὁ Πορφύριος κοινὸν γένους καὶ συμβεβηκότος τὸ κατὰ πλειόνων κατηγορεῖσθαι.", "seq": 4952}
{"id": "David_Passim_4953", "series": "CAG", "text": "ἤδη δὲ καὶ ἐν τοῖς καθολικοῖς κοινωνία τοῦτο ἐδείχθη.", "seq": 4953}
{"id": "David_Passim_4954", "series": "CAG", "text": "ἐπειδὴ δὲ ἐπιστήμονος ἀνδρὸς ὑπάρχει τὸ κοινωνίαν τῶν πόρρω διεστηκότων παραδιδόναι καὶ τῶν πάνυ παραπλησίων διαφορὰν δεικνύναι, ὡς ἐπὶ φάττης καὶ περιστερᾶς, φέρε καὶ κοινὸν ἕτερον γένους καὶ συμβεβηκότος ἀποδείξωμεν ταῖς ἀπὸ τοῦ φιλοσόφου παραδοθείσαις διαφοραῖς ἀρκούμενοι.", "seq": 4954}
{"id": "David_Passim_4955", "series": "CAG", "text": "ἔτι κοινωνεῖ τὸ γένος καὶ τὸ συμβεβηκός, καθὸ ἑκάτερον αὐτῶν καὶ εἰδῶν καὶ ἀτόμων κατηγορεῖται.", "seq": 4955}
{"id": "David_Passim_4956", "series": "CAG", "text": "χωρητέον δὲ καὶ ἐπὶ τὰς διαφοράς.", "seq": 4956}
{"id": "David_Passim_4957", "series": "CAG", "text": "διαφέρει δὲ τὸ γένος τοῦ συμβεβηκότος, ὅτι τὸ μὲν γένος πρὸ τῶν εἰδῶν ἐστι, τὰ δὲ εἴδη πρὸ τοῦ συμβεβηκότος·", "seq": 4957}
{"id": "David_Passim_4958", "series": "CAG", "text": "τὸ γὰρ συμβεβηκὸς πάντως ἔχει τὸ εἶδος προτερεῦον, οὗ ἐστι συμβεβηκός.", "seq": 4958}
{"id": "David_Passim_4959", "series": "CAG", "text": "ἔτι διαφέρει τὸ γένος τοῦ συμβεβηκότος, ὅτι τὸ μὲν γένος ἐπίσης ἐκ τῶν ὑπ᾿ αὐτὸ εἰδῶν μετέχεται, τὸ δὲ συμβεβηκὸς κατὰ τὸ μᾶλλον καὶ ἧττον μετέχεται.", "seq": 4959}
{"id": "David_Passim_4960", "series": "CAG", "text": "ἔτι διαφέρουσιν ὅτι τὸ μὲν γένος πρῶτον εἰδῶν κατηγορεῖται καὶ οὕτως ἀτόμων, τὸ δὲ συμβεβηκὸς πρῶτον ἀτόμων καὶ οὕτως εἰδῶν.", "seq": 4960}
{"id": "David_Passim_4961", "series": "CAG", "text": "ταὐτὸν δέ ἐστι τῷ πρώτῳ·", "seq": 4961}
{"id": "David_Passim_4962", "series": "CAG", "text": "δείκνυται γὰρ καὶ ὧδε φύσει προτερεῦον τὸ γένος.", "seq": 4962}
{"id": "David_Passim_4963", "series": "CAG", "text": "ἔτι διαφέρουσιν ὅτι τὸ μὲν γένος ἐν τῷ τί ἐστι κατηγορεῖται, τὸ δὲ συμβεβηκὸς ἐν τῷ ὁποῖόν τί ἐστιν.", "seq": 4963}
{"id": "David_Passim_4964", "series": "CAG", "text": "Ἔχομεν ἐντεῦθεν τὰς τοῦ γένους κοινωνίας καὶ διαφορὰς πρὸς τὰς ἄλλας φωνάς·", "seq": 4964}
{"id": "David_Passim_4965", "series": "CAG", "text": "βουλόμενος δὲ διαφορὰς τῶν ἄλλων πρὸς ἀλλήλας δεῖξαι, φησὶν ὅτι μία καὶ ἑκάστη ἔχει πρὸς τὰς ἄλλας τέσσαρας διαφοράς·", "seq": 4965}
{"id": "David_Passim_4966", "series": "CAG", "text": "εἰσὶ δὲ πέντε φωναί·", "seq": 4966}
{"id": "David_Passim_4967", "series": "CAG", "text": "φθάνει οὖν εἶναι τὰς διαφορὰς εἴκοσι·", "seq": 4967}
{"id": "David_Passim_4968", "series": "CAG", "text": "τετράκις γὰρ πέντε εἴκοσι.", "seq": 4968}
{"id": "David_Passim_4969", "series": "CAG", "text": "τῷ οὖν νουνεχῶς σκοποῦντι καὶ βουλομένῳ φυγεῖν ἀδολεσχίαν δέκα εὑρίσκονται·", "seq": 4969}
{"id": "David_Passim_4970", "series": "CAG", "text": "φέρε γὰρ οὕτως εἴπωμεν·", "seq": 4970}
{"id": "David_Passim_4971", "series": "CAG", "text": "τὸ γένος διαφέρει τῶν τεσσάρων φωνῶν·", "seq": 4971}
{"id": "David_Passim_4972", "series": "CAG", "text": "εὑρίσκονται οὖν τέσσαρες διαφοραί.", "seq": 4972}
{"id": "David_Passim_4973", "series": "CAG", "text": "πάλιν λέγομεν, ἡ διαφορὰ διαφέρει τῶν τριῶν, εἴδους ἰδίου συμβεβηκότος.", "seq": 4973}
{"id": "David_Passim_4974", "series": "CAG", "text": "μηκέτι δὲ λέγε καὶ γένους·", "seq": 4974}
{"id": "David_Passim_4975", "series": "CAG", "text": "ἤδη γὰρ τοῦτο ἐδείχθη.", "seq": 4975}
{"id": "David_Passim_4976", "series": "CAG", "text": "ἔτι διαφέρει τὸ εἶδος τῶν δύο, ἰδίου καὶ συμβεβηκότος.", "seq": 4976}
{"id": "David_Passim_4977", "series": "CAG", "text": "καὶ μηκέτι λέγε διαφορᾶς καὶ γένους·", "seq": 4977}
{"id": "David_Passim_4978", "series": "CAG", "text": "ἤδη γὰρ τοῦτο ἐδείχθη.", "seq": 4978}
{"id": "David_Passim_4979", "series": "CAG", "text": "ἔτι διαφέρει τὸ ἴδιον ἑνὸς τοῦ συμβεβηκότος.", "seq": 4979}
{"id": "David_Passim_4980", "series": "CAG", "text": "ὥστε οὖν δέκα εἰσὶ μὴ ἀναδιπλασιαζόμεναι·", "seq": 4980}
{"id": "David_Passim_4981", "series": "CAG", "text": "τέσσαρες τρεῖς δύο μία.", "seq": 4981}
{"id": "David_Passim_4982", "series": "CAG", "text": "17.", "seq": 4982}
{"id": "David_Passim_4983", "series": "CAG", "text": "5 Ἀλλ᾿ οὖν πρότερόν ἐστι τὸ ᾧ συμβέβηκε τοῦ συμβεβηκότος.", "seq": 4983}
{"id": "David_Passim_4984", "series": "CAG", "text": "Φησὶν ὅτι κἂν ᾖ τὸ συμβεβηκὸς ἀχώριστον, πάντως ἐκεῖνο τὸ εἶδος αὐτοῦ προτερεύει, οὗ ἐστι συμβεβηκός·", "seq": 4984}
{"id": "David_Passim_4985", "series": "CAG", "text": "ὁ γὰρ Αἰθίοψ τοῦ μέλανος προτερεύει ὡς ἄνθρωπος.", "seq": 4985}
{"id": "David_Passim_4986", "series": "CAG", "text": "17.", "seq": 4986}
{"id": "David_Passim_4987", "series": "CAG", "text": "9 Τὰ δὲ γένη καὶ τὰ εἴδη φύσει πρότερα τῶν ἀτόμων οὐσιῶν.", "seq": 4987}
{"id": "David_Passim_4988", "series": "CAG", "text": "Φησὶν ὅτι ἐν τοῖς ἀτόμοις πρῶτα τὰ συμβεβηκότα θεωρεῖται, τὰ δὲ γένη ἐν τοῖς εἴδεσι.", "seq": 4988}
{"id": "David_Passim_4989", "series": "CAG", "text": "17.", "seq": 4989}
{"id": "David_Passim_4990", "series": "CAG", "text": "12 Ποῖος γὰρ ὁ Αἰθίοψ ἐρωτηθεὶς ἐρεῖς μέλας, καὶ πῶς ἔχει Σωκράτης ἐρεῖς κάθηται.", "seq": 4990}
{"id": "David_Passim_4991", "series": "CAG", "text": "Τὸ ἀχώριστον καὶ χωριστὸν συμβεβηκὸς δηλοῖ·", "seq": 4991}
{"id": "David_Passim_4992", "series": "CAG", "text": "ἐν μὲν γὰρ τῷ λέγειν μέλανα τὸν Αἰθίοπα δηλοῖ τὸ ἀχώριστον συμβεβηκός, ἐν δὲ τῷ λέγειν περιπατεῖ καὶ κάθηται δηλοῖ τὸ χωριστόν·", "seq": 4992}
{"id": "David_Passim_4993", "series": "CAG", "text": "ὡς γὰρ τὰ ῥήματα μεταπίπτει, οὕτω καὶ τὰ χωριστά, ὡς εἴρηται.", "seq": 4993}
{"id": "David_Passim_4994", "series": "CAG", "text": "17.", "seq": 4994}
{"id": "David_Passim_4995", "series": "CAG", "text": "18 Καὶ τῶν μὲν δύο μιᾷ ἀπολειπομένων.", "seq": 4995}
{"id": "David_Passim_4996", "series": "CAG", "text": "Ὅταν ἐκ τῆς διαφορᾶς ἄρξηται, τότε μία λείπει ἡ πρὸς τὸ γένος·", "seq": 4996}
{"id": "David_Passim_4997", "series": "CAG", "text": "προελήφθη δὲ τοῦτο, ὅτε ἐλέγετο ἡ τοῦ γένους πρὸς τέσσαρας.", "seq": 4997}
{"id": "David_Passim_4998", "series": "CAG", "text": "17.", "seq": 4998}
{"id": "David_Passim_4999", "series": "CAG", "text": "19 Τῶν δὲ πέντε τέτρασι.", "seq": 4999}
{"id": "David_Passim_5000", "series": "CAG", "text": "Μεθὸ γὰρ ἔλθῃς εἰς τὸ συμβεβηκός, ὅπερ ἐστὶ πέμπτον, διαφορὰν οὐχ εὑρίσκεται ἔχον διὰ τὸ ἤδη προειρῆσθαι αὐτάς.", "seq": 5000}
{"id": "David_Passim_5001", "series": "CAG", "text": "λείπεται οὖν τέτρασιν, ὅτε φθάσῃ τὸ συμβεβηκός.", "seq": 5001}
