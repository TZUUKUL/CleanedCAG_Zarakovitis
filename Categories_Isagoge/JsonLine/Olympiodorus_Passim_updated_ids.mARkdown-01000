{"id": "Olympiodorus_Passim_1195", "series": "CAG", "text": "τῷ γὰρ πεζῷ τὸ πτηνὸν ἀντιδιῄρηται.", "seq": 1195}
{"id": "Olympiodorus_Passim_1196", "series": "CAG", "text": "ἰστέον δὲ ὅτι τετραχῶς διαιρεῖται τὸ ζῷον·", "seq": 1196}
{"id": "Olympiodorus_Passim_1197", "series": "CAG", "text": "ἢ γὰρ ἀπὸ τῆς γνώσεως λαμβάνεται ἡ διαίρεσις, ὡς ὅταν εἴπωμεν τοῦ ζῴου τὸ μὲν λογικὸν τὸ δὲ ἄλογον, ἢ ἀπὸ τοῦ χρόνου τῆς ζωῆς, ὡς ὅταν εἴπωμεν τοῦ ζῴου τὸ μὲν θνητὸν τὸ δὲ ἀθάνατον, ἢ ἀπὸ τοῦ τρόπου τῆς διοργανώσεως, ὡς ὅταν εἴπωμεν τοῦ ζῴου τὸ μὲν δίπουν τὸ δὲ τετράπουν τὸ δὲ ἄπουν, ἢ ἀπὸ τοῦ τόπου τῆς ζωῆς, ὡς ὅταν εἴπωμεν τοῦ ζῴου τὸ μὲν πτηνὸν τὸ δὲ ἔνυδρον τὸ δὲ χερσαῖον.", "seq": 1197}
{"id": "Olympiodorus_Passim_1198", "series": "CAG", "text": "ἐνταῦθα τοίνυν ὁ φιλόσοφος τὴν διαίρεσιν ἐποιήσατο ἀπὸ τοῦ τόπου τῆς διαγωγῆς καὶ ἀπὸ τοῦ τρόπου τῆς διοργανώσεως, πῇ μὲν εἰπὼν <πεζὸν καὶ> πτητὸν καὶ ἔνυδρον, ὅπερ ἐστὶ τόπου, πῇ δὲ δίπουν, ὅπερ ἐστὶ διοργανώσεως.", "seq": 1198}
{"id": "Olympiodorus_Passim_1199", "series": "CAG", "text": "1b25 Τῶν κατὰ μηδεμίαν συμπλοκὴν λεγομένων.", "seq": 1199}
{"id": "Olympiodorus_Passim_1200", "series": "CAG", "text": "Διελὼν ὁ φιλόσοφος τὰ λεγόμενα εἰς δύο, εἰς καθόλου οὐσίαν καὶ μερικὸν συμβεβηκός, μέτεισι λοιπὸν ἐπὶ τὴν διαίρεσιν τῶν ἄνευ συμπλοκῆς, ἤγουν εἰς τὴν διαίρεσιν τῶν κατηγοριῶν, ἐφ᾿ οἷς καταπαύει τὸ πρῶτον τμῆμα καὶ ἄρχεται τὸ δεύτερον.", "seq": 1200}
{"id": "Olympiodorus_Passim_1201", "series": "CAG", "text": "τοῦτο δὲ ποιεῖ οὐ συνέχειαν τῷ λόγῳ μνηστευόμενος, ἀλλὰ καθάπερ οἱ ἄριστοι τῶν γραφέων πρὸ τῆς τελείας γραφῆς τὴν σκιαγραφίαν τιθέασι, οὕτω δὴ καὶ αὐτὸς πρὸ τῆς ἀκριβοῦς καὶ τελείας ἑκάστης τῶν κατηγοριῶν διδασκαλίας παχυμερῶς πως τὴν περὶ αὐτῶν διδασκαλίαν ποιεῖται.", "seq": 1201}
{"id": "Olympiodorus_Passim_1202", "series": "CAG", "text": "ζητήσωμεν τοίνυν ποίων φωνῶν καὶ ποίων πραγμάτων εἰσὶν αἱ κατηγορίαι.", "seq": 1202}
{"id": "Olympiodorus_Passim_1203", "series": "CAG", "text": "τῶν τοίνυν φωνῶν αἱ μέν εἰσι πάντῃ ἄσημοι.", "seq": 1203}
{"id": "Olympiodorus_Passim_1204", "series": "CAG", "text": "τοιαῦται δέ εἰσιν αἱ μήτε καθ᾿ αὑτὰς σημαίνουσαί τι μήτε μετὰ τῶν ἄλλων συμπλεκόμεναι, οἷον κνάξ, βλίτυρι.", "seq": 1204}
{"id": "Olympiodorus_Passim_1205", "series": "CAG", "text": "αἱ δὲ ποτὲ μὲν σημαντικαὶ ποτὲ δὲ ἄσημοι·", "seq": 1205}
{"id": "Olympiodorus_Passim_1206", "series": "CAG", "text": "καθ᾿ ἑαυτὰς μὲν γὰρ οὐδέν τι σημαίνουσι, μετὰ δὲ τῆς ἑτέρων συμπλοκῆς οὐ πεφύκασιν ἄσημοι, οἷον ἄρθρα, σύνδεσμοι καὶ προθέσεις.", "seq": 1206}
{"id": "Olympiodorus_Passim_1207", "series": "CAG", "text": "καὶ μήτοι θαυμάσῃς εἰ εἶπον τινὰς φωνὰς εἶναι μηδὲν καθ᾿ ἑαυτὰς σημαινούσας, ἀλλὰ μετὰ τῆς ἑτέρων συμπλοκῆς, ὅπου γε καὶ ἐπὶ ἑτέρων ἐστὶ τοῦτο ἰδεῖν·", "seq": 1207}
{"id": "Olympiodorus_Passim_1208", "series": "CAG", "text": "τόνοι γοῦν καὶ πνεύματα καὶ ὀβελοὶ καὶ κορωνίδες αὐτὰ μὲν καθ᾿ ἑαυτὰ οὐδεμίαν ἔχουσι δύναμιν, μετὰ ἄλλων δὲ γεγραμμένα πολλὴν ἐνδείκνυνται τὴν ἰσχύν.", "seq": 1208}
{"id": "Olympiodorus_Passim_1209", "series": "CAG", "text": "αἱ δὲ πάντῃ σημαντικαί, οἷον ἄνθρωπος, βοῦς, ἵππος.", "seq": 1209}
{"id": "Olympiodorus_Passim_1210", "series": "CAG", "text": "τῶν τοίνυν πάντῃ σημαινουσῶν εἰσὶν αἱ κατηγορίαι.", "seq": 1210}
{"id": "Olympiodorus_Passim_1211", "series": "CAG", "text": "ποίων δὲ ἄρα πραγμάτων εἰσί;", "seq": 1211}
{"id": "Olympiodorus_Passim_1212", "series": "CAG", "text": "τῶν γὰρ πραγμάτων τὰ μέν ἐστιν ἀτελῆ τὰ δὲ τέλεια, ἀτελῆ μὲν οἷον κίνησις, αὔξησις, γένεσις, φθορά, ἀλλοίωσις, ἡ κατὰ τόπον μεταβολή, τέλεια δὲ οἷον ἄνθρωπος, βοῦς.", "seq": 1212}
{"id": "Olympiodorus_Passim_1213", "series": "CAG", "text": "τούτων τοίνυν τῶν τελείων εἰσὶν αἱ κατηγορίαι.", "seq": 1213}
{"id": "Olympiodorus_Passim_1214", "series": "CAG", "text": "κατὰ δὲ ἑτέραν διαίρεσιν τῶν πραγμάτων τὰ μέν εἰσιν ἁπλᾶ, οἷον μονάς, εἶδος, σημεῖον, νῦν, τὰ δὲ σύνθετα.", "seq": 1214}
{"id": "Olympiodorus_Passim_1215", "series": "CAG", "text": "τῶν τοίνυν συνθέτων εἰσὶν αἱ κατηγορίαι.", "seq": 1215}
{"id": "Olympiodorus_Passim_1216", "series": "CAG", "text": "καὶ ἁπλῶς εἰπεῖν, οὔτε τὰ ἁπλᾶ πράγματα οὔτε τὰ ἀτελῆ ὑπὸ τὰς κατηγορίας ἀνάγεται, ἀλλὰ τέλεια καὶ σύνθετα.", "seq": 1216}
{"id": "Olympiodorus_Passim_1217", "series": "CAG", "text": "τί οὖν οὐκ ἀνάγονται ὑπὸ κατηγορίας τὰ ἁπλᾶ;", "seq": 1217}
