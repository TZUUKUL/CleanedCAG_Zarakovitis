{"id": "Olympiodorus_Passim_2163", "series": "CAG", "text": "ὁμοίως πάλιν καὶ τὴν μεγάλην κέγχρον, τοῦ ὄρους πάνυ μικροτάτην ὑπάρχουσαν, μεγάλην ταύτην λέγομεν πρὸς τὰ ὁμογενῆ ἀφορῶντες.", "seq": 2163}
{"id": "Olympiodorus_Passim_2164", "series": "CAG", "text": "ὁμοίως οὖν καὶ τὸ πολὺ λέγομεν ὀλίγον καὶ τὸ ὀλίγον πολύ·", "seq": 2164}
{"id": "Olympiodorus_Passim_2165", "series": "CAG", "text": "ἰδοὺ γὰρ τοὺς ἐν τῇ πόλει ὀλίγους ὄντας πολλοὺς λέγομεν, ἀφορῶντες πρὸς τοὺς ἐν τῇ οἰκίᾳ.", "seq": 2165}
{"id": "Olympiodorus_Passim_2166", "series": "CAG", "text": "ὅτι δὲ ταῦτα οὔκ εἰσιν ἐναντία, δείκνυμεν ἐκ τεσσάρων τινῶν ἐπιχειρημάτων, ὧν τὸ πρῶτόν ἐστι τοιοῦτον·", "seq": 2166}
{"id": "Olympiodorus_Passim_2167", "series": "CAG", "text": "σκοπήσωμεν τὸ ἴδιον τῶν ἐναντίων καὶ τὸ ἴδιον τῶν πρός τι, καὶ ὃ δἂν ἴδιον ἁρμόζει τούτοις τοῖς ὀνόμασι, λεκτέον·", "seq": 2167}
{"id": "Olympiodorus_Passim_2168", "series": "CAG", "text": "ἴδιόν ἐστι τῶν πρός τι τὸ συνυπάρχειν τε ἀλλήλοις καὶ συναπάγεσθαι, ἴδιον δὲ τῶν ἐναντίων τὸ μήτε συνυπάρχειν μήτε συνυφίστασθαι ἀλλήλοις.", "seq": 2168}
{"id": "Olympiodorus_Passim_2169", "series": "CAG", "text": "εἰ οὖν τὸ μέγα καὶ τὸ μικρὸν καὶ τὸ πολὺ καὶ τὸ ὀλίγον τὸ ἴδιον ἔχει τῶν πρός τι (ταῦτα γὰρ ἅμα λέγεται·", "seq": 2169}
{"id": "Olympiodorus_Passim_2170", "series": "CAG", "text": "τὸ γὰρ μέγα τινός ἐστιν μέγα, μικροῦ δηλονότι, καὶ τὸ πολὺ ὁμοίως τινός ἐστιν πολύ, ὀλίγου δηλονότι·", "seq": 2170}
{"id": "Olympiodorus_Passim_2171", "series": "CAG", "text": "καὶ ἅμα δὲ συνυφίστανται·", "seq": 2171}
{"id": "Olympiodorus_Passim_2172", "series": "CAG", "text": "δυνατὸν γάρ, ὡς ἐδείξαμεν, τὸ αὐτὸ εἶναι μέγα καὶ μικρόν), τὸ δὲ ἴδιον τῶν ἐναντίων οὐκ ἔχουσι (συνυφίστανται γὰρ καὶ συνυπάρχουσι, καίτοι τῶν ἐναντίων [τῶν] οὐχ οὕτω βουλομένων), οὐκ ἄρα ταῦτα ἐναντία ἐστίν, ἀλλὰ πρός τι.", "seq": 2172}
{"id": "Olympiodorus_Passim_2173", "series": "CAG", "text": "δεύτερον ἐπιχείρημα·", "seq": 2173}
{"id": "Olympiodorus_Passim_2174", "series": "CAG", "text": "εἰ τὸ μέγα καὶ τὸ μικρὸν καὶ τὸ πολὺ καὶ τὸ ὀλίγον ἐναντία εἰσίν, ἔτι δὲ τὸ μέγα ἐκ πολλῶν μικρῶν σύγκειται, εὑρεθήσεταί τι ἐξ ἐναντίων συγκείμενον, ὅπερ ἐστὶν ἀδύνατον.", "seq": 2174}
{"id": "Olympiodorus_Passim_2175", "series": "CAG", "text": "καὶ ἐπειδὴ τὰ μὲν ἐναντία φθαρτικά εἰσιν, τὰ δὲ μέρη συστατικὰ τοῦ ὅλου, ταῦτα δὲ ὑπεθέμεθα ἐξ ἐναντίων εἶναι, συμβήσεται τὸ φθαρτικὸν συστατικὸν γινόμενον ἐνταῦθα, ὅπερ ἄτοπον.", "seq": 2175}
{"id": "Olympiodorus_Passim_2176", "series": "CAG", "text": "ὁ αὐτὸς δὲ λόγος καὶ ἐπὶ τοῦ πολλοῦ καὶ ὀλίγου.", "seq": 2176}
{"id": "Olympiodorus_Passim_2177", "series": "CAG", "text": "τρίτον ἐπιχείρημα·", "seq": 2177}
{"id": "Olympiodorus_Passim_2178", "series": "CAG", "text": "εἰ τὸ μέγα καὶ τὸ μικρὸν καὶ τὸ πολὺ καὶ ὀλίγον ἐναντία ἐστίν, ἐπεὶ δυνατὸν τὸ αὐτὸ πρᾶγμα, ὡς ἐδείξαμεν, κατὰ τὸν αὐτὸν χρόνον καὶ μέγα εἶναι καὶ μικρὸν πρὸς ἄλλο καὶ ἄλλο, ὥσπερ κέγχρον λέγομεν πρὸς μὲν τὰ ὁμογενῆ μεγάλην πρὸς δὲ τὸ ὄρος μικράν, εὑρεθήσεται τὸ μικρόν, εἰ τύχοι, ἢ τὸ μέγα δυνάμενον ἐν τῷ αὐτῷ χρόνῳ ἓν ἕκαστον ἐν παντὶ πράγματι τῶν ἐναντίων δεκτικόν.", "seq": 2178}
{"id": "Olympiodorus_Passim_2179", "series": "CAG", "text": "τέταρτον ἐπιχείρημα·", "seq": 2179}
{"id": "Olympiodorus_Passim_2180", "series": "CAG", "text": "εἰ τὸ μέγα καὶ τὸ μικρὸν καὶ τὸ πολὺ καὶ ὀλίγον ἐναντία κατὰ τὸν αὐτὸν χρόνον, εὑρεθήσεταί τι ἑαυτῷ ἐναντίον, ὅπερ ἄτοπον.", "seq": 2180}
{"id": "Olympiodorus_Passim_2181", "series": "CAG", "text": "Ἡμῶν οὖν διὰ τεσσάρων ἐπιχειρημάτων δειξάντων ὅτι τὸ μέγα καὶ τὸ μικρὸν καὶ τὸ πολὺ καὶ τὸ ὀλίγον οὐκ ἔστιν ἐναντία, πῶς ὁ Πλωτῖνός φησι καὶ αὐτὸς δὲ Ἀριστοτέλης ἐν τοῖς Μετὰ φυσικὰ τὸ μικρὸν καὶ τὸ μέγα ἐναντία εἶναι;", "seq": 2181}
{"id": "Olympiodorus_Passim_2182", "series": "CAG", "text": "φαμὲν οὖν ὅτι ἀμφότεροι οἱ λόγοι καθεστήκασιν ἀληθεῖς·", "seq": 2182}
{"id": "Olympiodorus_Passim_2183", "series": "CAG", "text": "ἐν μὲν γὰρ δύο ὑποκειμένοις ὄντα τὸ μέγα καὶ τὸ μικρὸν οὔκ εἰσιν ἐναντία ἀλλὰ πρός τι·", "seq": 2183}
{"id": "Olympiodorus_Passim_2184", "series": "CAG", "text": "εἰ γὰρ ταῦτα ἐν δύο ὑποκειμένοις, τὰ δὲ ἐναντία περὶ ἓν ὑποκείμενον μάχονται, δῆλον ὅτι ταῦτα οὐκ ἔστι ἐναντία.", "seq": 2184}
{"id": "Olympiodorus_Passim_2185", "series": "CAG", "text": "ὅτε μὲν οὖν εἰσιν ἐν δύο ὑποκειμένοις, οὔκ εἰσιν ἐναντία ἀλλὰ πρός τι.", "seq": 2185}
{"id": "Olympiodorus_Passim_2186", "series": "CAG", "text": "ὅτε δὲ ἐν ἑνὶ ὑποκειμένῳ θεωροῦνται, τοῦτ᾿ ἔστιν αὔξησις ὄντα καὶ μείωσις, τότε ἐναντία ἐστίν·", "seq": 2186}
{"id": "Olympiodorus_Passim_2187", "series": "CAG", "text": "ἔστιν γὰρ ὅρος μὲν τῆς αὐξήσεως τὸ μέγα, ὅρος δὲ τῆς μειώσεως τὸ μικρόν.", "seq": 2187}
{"id": "Olympiodorus_Passim_2188", "series": "CAG", "text": "ταῦτα τοίνυν ἐναντία ἐστίν, ἐπειδὴ καὶ <ἡ> αὔξησις τῇ μειώσει ἐναντία·", "seq": 2188}
{"id": "Olympiodorus_Passim_2189", "series": "CAG", "text": "ἡ γὰρ αὔξησις καὶ ἡ μείωσις ὁδός ἐστιν ἐπὶ τὸ μικρόν τε καὶ μέγα·", "seq": 2189}
{"id": "Olympiodorus_Passim_2190", "series": "CAG", "text": "ὧν δὲ αἱ ὁδοὶ ἐναντίαι, τούτων καὶ τὰ πέρατα ἐναντία·", "seq": 2190}
{"id": "Olympiodorus_Passim_2191", "series": "CAG", "text": "τὸ ἄρα [τὸ] μικρὸν καὶ τὸ μέγα ἐναντία εἰσὶν ὡς πέρατα ὄντα αὐξήσεως καὶ μειώσεως.", "seq": 2191}
{"id": "Olympiodorus_Passim_2192", "series": "CAG", "text": "τί οὖν οὐ δυνατὸν ἀληθεύειν τὸν προκείμενον λόγον;", "seq": 2192}
{"id": "Olympiodorus_Passim_2193", "series": "CAG", "text": "φαμὲν ὅτι ναί, οὐχ ἧττον δὲ καὶ τὸν ἐν τῇ Μετὰ τὰ φυσικὰ εἰρημενόν·", "seq": 2193}
{"id": "Olympiodorus_Passim_2194", "series": "CAG", "text": "τὸ γὰρ μέγα καὶ τὸ μικρόν, ὡς εἴρηται, ἐν ἑνὶ ὑποκειμένῳ ὄντα οὔκ εἰσιν ἐναντία·", "seq": 2194}
{"id": "Olympiodorus_Passim_2195", "series": "CAG", "text": "τὸ γὰρ μέγεθος τοῦ μικροῦ τῷ μεγέθει τοῦ μεγάλου οὐκ ἀντίκειται.", "seq": 2195}
{"id": "Olympiodorus_Passim_2196", "series": "CAG", "text": "ἀλλ᾿ εἰ ἄρα ἡ ἐν τούτοις θεωρουμένη αὔξησις τῇ μειώσει ἐναντία ἐστίν·", "seq": 2196}
{"id": "Olympiodorus_Passim_2197", "series": "CAG", "text": "ἡ δὲ αὔξησις καὶ μείωσις οὐκ ἔστι ποσὸν ἀλλὰ ποιόν, ὡς δειχθήσεται ἐν τοῖς περὶ τοῦ ποιοῦ λόγοις·", "seq": 2197}
{"id": "Olympiodorus_Passim_2198", "series": "CAG", "text": "ἐν ποιοῖς ἄρα ἡ ἐναντίωσις καὶ οὐκ ἐν ποσοῖς.", "seq": 2198}
{"id": "Olympiodorus_Passim_2199", "series": "CAG", "text": "ἡ δὲ ἔλλειψις καὶ ἡ πλεονεξία ἐναντία·", "seq": 2199}
{"id": "Olympiodorus_Passim_2200", "series": "CAG", "text": "τούτων γὰρ τὰ μεγέθη μετέχει.", "seq": 2200}
{"id": "Olympiodorus_Passim_2201", "series": "CAG", "text": "ὥστε καὶ αὐτὰ κατὰ συμβεβηκὸς ἐναντία ὡς μετέχοντα τῶν ἐναντίων, ὥσπερ καὶ τὸ ἄρτιον καὶ τὸ περιττόν φαμεν εἶναι ἐναντία·", "seq": 2201}
{"id": "Olympiodorus_Passim_2202", "series": "CAG", "text": "ἀριθμὸς γὰρ ἀριθμῷ οὐκ ἔστιν ἐναντίος, ἀρτιότης δὲ περιττότητος ἐναντία ἐστί.", "seq": 2202}
{"id": "Olympiodorus_Passim_2203", "series": "CAG", "text": "καὶ ὅμως φαμὲν τὸ ἄρτιον τῷ περιττῷ ἐναντίον εἶναι ὡς δεκτικὸν τῶν ἐναντίων.", "seq": 2203}
{"id": "Olympiodorus_Passim_2204", "series": "CAG", "text": "Ἀλλὰ ἀποροῦσί τινες πάλιν λέγοντες ὅτι ἐν τόπῳ ἐστὶν ἡ τοῦ ποσοῦ ἐναντιότης·", "seq": 2204}
{"id": "Olympiodorus_Passim_2205", "series": "CAG", "text": "φασὶ γὰρ ὅτι ὁ τόπος ποσόν, ὁ τόπος ἔχει ἐναντίον, ἐν τρίτῳ σχήματι τὶ ποσὸν ἔχει ἐναντίον.", "seq": 2205}
{"id": "Olympiodorus_Passim_2206", "series": "CAG", "text": "βουλόμενοι δὲ δεῖξαι ὅτι ἐν τόπῳ ἐστὶν ἡ ἐναντιότης, κέχρηνται συλλογισμῷ τοιούτῳ·", "seq": 2206}
{"id": "Olympiodorus_Passim_2207", "series": "CAG", "text": "τὸ ἄνω καὶ κάτω ποσόν·", "seq": 2207}
{"id": "Olympiodorus_Passim_2208", "series": "CAG", "text": "καὶ τοῦτο δείξωμεν δι᾿ ἑτέρου συλλογισμοῦ ἔχοντος οὕτως·", "seq": 2208}
{"id": "Olympiodorus_Passim_2209", "series": "CAG", "text": "τὸ ἄνω καὶ κάτω τόπος, ὁ τόπος ποσόν, τὸ ἄρα ἄνω καὶ κάτω ποσόν.", "seq": 2209}
{"id": "Olympiodorus_Passim_2210", "series": "CAG", "text": "πόθεν δὲ πάλιν τὸ ἄνω καὶ κάτω ἐναντίον;", "seq": 2210}
{"id": "Olympiodorus_Passim_2211", "series": "CAG", "text": "πάλιν κἀνταῦθα ἕτερος συλλογισμὸς τὸ ζητούμενον ἡμῖν παριστῶν·", "seq": 2211}
{"id": "Olympiodorus_Passim_2212", "series": "CAG", "text": "τὸ ἄνω καὶ κάτω πλεῖστα διέστηκεν, τὸ πλεῖστον διεστηκὸς ἐναντίον, τὸ ἄρα ἄνω καὶ κάτω ἐναντία.", "seq": 2212}
{"id": "Olympiodorus_Passim_2213", "series": "CAG", "text": "καὶ οὕτως μὲν ὁ συλλογισμὸς προῆλθεν δεικνὺς ὅτι ἐν τόπῳ ἐστὶ τὰ ἐναντία.", "seq": 2213}
{"id": "Olympiodorus_Passim_2214", "series": "CAG", "text": "πρὸς τούτους φαμὲν ὅτι ἐπειδὴ τὸ ἄνω καὶ κάτω διττόν, τὸ μὲν φύσει τὸ δὲ θέσει·", "seq": 2214}
{"id": "Olympiodorus_Passim_2215", "series": "CAG", "text": "φύσει μὲν ἄνω καὶ κάτω λέγεται καὶ ἡ γῆ καὶ ὁ οὐρανός, θέσει δὲ ὡς οἶκος δυνάμενος πρὸς ἄλλο καὶ ἄλλο παραλαμβανόμενος εἶναι καὶ ἄνω καὶ κάτω.", "seq": 2215}
{"id": "Olympiodorus_Passim_2216", "series": "CAG", "text": "ποῖον οὖν βούλεσθε ἄνω καὶ κάτω;", "seq": 2216}
{"id": "Olympiodorus_Passim_2217", "series": "CAG", "text": "τὸ φύσει ἢ τὸ θέσει;", "seq": 2217}
{"id": "Olympiodorus_Passim_2218", "series": "CAG", "text": "εἰ μὲν οὖν τὸ θέσει βούλεσθε ἄνω καὶ κάτω, ταῦτα οὔκ εἰσιν ἐναντία, ἀλλὰ πρός τι·", "seq": 2218}
{"id": "Olympiodorus_Passim_2219", "series": "CAG", "text": "δυνατὸν γὰρ τὸ αὐτὸ ἐπὶ τοῦ θέσει ἄνω καὶ κάτω λέγεσθαι.", "seq": 2219}
{"id": "Olympiodorus_Passim_2220", "series": "CAG", "text": "ταῦτα τοίνυν πρός τί εἰσι, καὶ οὐκ ἐναντία.", "seq": 2220}
{"id": "Olympiodorus_Passim_2221", "series": "CAG", "text": "εἰ δὲ μή, εὑρεθήσονται πάντες οἱ λόγοι ἁρμόζοντες ἐπὶ τοῦ μικροῦ καὶ μεγάλου.", "seq": 2221}
{"id": "Olympiodorus_Passim_2222", "series": "CAG", "text": "εἰ δὲ φύσει βούλεσθε ἄνω καὶ κάτω, οἱ τοιοῦτοι τόποι οὔκ εἰσιν ἐναντίοι αὐτοὶ καθ᾿ ἑαυτούς, <ἀλλ᾿> ἐναντίων σωμάτων δεκτικοί·", "seq": 2222}
{"id": "Olympiodorus_Passim_2223", "series": "CAG", "text": "οὕτω τὸν ἄνω τόπον δεκτικὸν εἶναι τοῦ πυρὸς κουφοτάτου ὑπάρχοντος λέγομεν, τὸν δὲ κάτω δεκτικὸν εἶναι τῆς γῆς ὡς βαρυτάτης.", "seq": 2223}
{"id": "Olympiodorus_Passim_2224", "series": "CAG", "text": "δῆλον οὖν ὅτι οἱ αὐτοὶ τόποι οὔκ εἰσιν φυσικοὶ τῶν ἐναντίων καθ᾿ ἑαυτούς, ἀλλ᾿ εἰ ἄρα λέγοιντο ἐναντία, διότι ἐναντίων σωμάτων εἰσὶ δεκτικοί, λέγω δὴ πυρὸς καὶ γῆς, τούτου χάριν λέγονται.", "seq": 2224}
{"id": "Olympiodorus_Passim_2225", "series": "CAG", "text": "ἀλλ᾿ ἴσως ἐρεῖ τις ὅτι καὶ οὗτοι οἱ τόποι, τὸ ἄνω καὶ κάτω, ἐναντία εἰσὶν ὡς πλεῖστον διεστηκότα ἀπ᾿ ἀλλήλων.", "seq": 2225}
{"id": "Olympiodorus_Passim_2226", "series": "CAG", "text": "πρὸς τοῦτό φαμεν ὅτι οὐκ αὐτοὶ ἐναντίοι εἰσίν, ἀλλ᾿ ἡ διάστασις ἡ μεταξὺ τούτων·", "seq": 2226}
{"id": "Olympiodorus_Passim_2227", "series": "CAG", "text": "οὗτοι γὰρ ὡς τόποι οὔκ εἰσιν ἐναντίοι, ἀλλ᾿ ἡ μεταξὺ τούτων, ὡς εἴρηται, διάστασίς ἐστιν ἐναντία.", "seq": 2227}
{"id": "Olympiodorus_Passim_2228", "series": "CAG", "text": "ἡ δὲ διάστασις οὐκ ἔστι ποσόν, ἀλλὰ ποιόν.", "seq": 2228}
{"id": "Olympiodorus_Passim_2229", "series": "CAG", "text": "ἐν ποιοῖς ἄρα ἡ ἐναντιότης, ὥσπερ ἐλέγομεν καὶ ἐπὶ τοῦ μικροῦ καὶ τοῦ μεγάλου μὴ ταῦτα τὰ μεγέθη ἐναντία εἶναι, ἀλλὰ τὴν ποιότητα τὴν ἐν αὐτοῖς, τοῦτ᾿ ἔστι τὴν αὔξησιν καὶ τὴν μείωσιν.", "seq": 2229}
{"id": "Olympiodorus_Passim_2230", "series": "CAG", "text": "καὶ ἐπὶ τοῦ ἀριθμοῦ ὡσαύτως.", "seq": 2230}
{"id": "Olympiodorus_Passim_2231", "series": "CAG", "text": "ἐπειδὴ δὲ τὰ τῇ φύσει πλεῖστον διεστηκότα ἐναντία εἶναι ἐλέγομεν, οἷον οὐρανὸν καὶ γῆν, ἐνταῦθά τινες γενόμενοι βούλονται δεῖξαι ὡς οὐ πλεῖστον διέστηκεν ἀλλήλων ὁ οὐρανὸς καὶ ἡ γῆ.", "seq": 2231}
{"id": "Olympiodorus_Passim_2232", "series": "CAG", "text": "καὶ οὗτοι κέχρηνται λόγῳ τοιούτῳ καί φασιν ὅτι τὸ πλεῖστον διεστηκὸς ἐπίτασιν οὐ δέχεται·", "seq": 2232}
{"id": "Olympiodorus_Passim_2233", "series": "CAG", "text": "εἰ οὖν ἡ γῆ τοῦ οὐρανοῦ πλεῖστον διέστηκεν, πῶς λέγομεν ἔτι μᾶλλον ἀπέχειν τοῦ οὐρανοῦ τὸ ἡμισφαίριον τὸ ὑπὸ γῆν;", "seq": 2233}
{"id": "Olympiodorus_Passim_2234", "series": "CAG", "text": "πρὸς τούτους φαμὲν ὅτι οὐ δεῖ τεμαχίζειν τὸν οὐρανόν, ἀλλ᾿ ὅλον ὡς ὅλον θεωρεῖν αὐτόν·", "seq": 2234}
{"id": "Olympiodorus_Passim_2235", "series": "CAG", "text": "ὅλος γὰρ ὁ οὐρανὸς ἐπὶ πλεῖστον διέστηκε τῆς γῆς, καὶ οὐ τὸ μὲν αὐτοῦ μᾶλλον διέστηκε τὸ δὲ ἧττον.", "seq": 2235}
{"id": "Olympiodorus_Passim_2236", "series": "CAG", "text": "Εἰπὼν γοῦν ὁ φιλόσοφος πάντα τὰ ἐν τούτῳ ἰδίῳ ζητούμενα, μέτεισιν ἐπὶ τὸ τελευταῖον ἴδιον, τοῦτ᾿ ἔστι τὸ ἴσον τε καὶ τὸ ἄνισον, ἐφ᾿ ᾧ τὸν περὶ τοῦ ποσοῦ καταπαύει λόγον.", "seq": 2236}
{"id": "Olympiodorus_Passim_2237", "series": "CAG", "text": "τριῶν οὖν οὐσῶν ἀντιθέσεων, ταὐτοῦθατέρου, ἴσου—ἀνίσου, ὁμοίου—ἀνομοίου, τὸ μὲν ταὐτὸν καὶ θάτερον ἐπὶ οὐσίας φέρεται, τὸ δὲ ὅμοιον καὶ ἀνόμοιον ἐπὶ τοῦ ποιοῦ, τὸ δὲ ἴσον καὶ ἄνισον ἐπὶ τοῦ ποσοῦ.", "seq": 2237}
