{"id": "Olympiodorus_Passim_2536", "series": "CAG", "text": "δύναται γὰρ καὶ μὴ οὔσης ἐπιστήμης εἶναι τὰ ἐπιστητὰ ὡς πράγματα·", "seq": 2536}
{"id": "Olympiodorus_Passim_2537", "series": "CAG", "text": "τὰ γὰρ πράγματα πρὸ τῆς ἐπιστήμης.", "seq": 2537}
{"id": "Olympiodorus_Passim_2538", "series": "CAG", "text": "οὕτω καὶ τὰ τέσσαρα στοιχεῖα πρὸ τῆς Ἱπποκράτους ἰατρικῆς ὑπῆρχεν, καὶ τὰ ἄστρα πρὸ τῆς Θαλοῦ ἀστρονομίας.", "seq": 2538}
{"id": "Olympiodorus_Passim_2539", "series": "CAG", "text": "εἰ οὖν τὸ ζῷον ἀναιρούμενον τὴν ἐπιστήμην ἀναιρεῖ μόνην, τῆς δὲ ἐπιστήμης ἀναιρουμένης οὐ συναναιρεῖται καὶ τὸ ἐπιστητόν, δῆλον ὅτι οὐχ ἅμα εἰσὶν ἥ τε ἐπιστήμη καὶ τὸ ἐπιστητόν.", "seq": 2539}
{"id": "Olympiodorus_Passim_2540", "series": "CAG", "text": "ὡσαύτως δὲ καὶ ἐπὶ τῆς αἰσθήσεως·", "seq": 2540}
{"id": "Olympiodorus_Passim_2541", "series": "CAG", "text": "τὸ μὲν ζῷον ἀναιρούμενον τὴν αἴσθησιν ἀναιρεῖ, οὐ μέντοι γε καὶ τὸ αἰσθητόν.", "seq": 2541}
{"id": "Olympiodorus_Passim_2542", "series": "CAG", "text": "εἰ οὖν τὸ ζῷον μόνην τὴν αἴσθησιν ἀναιρεῖ, δῆλον ὅτι πρότερον τὸ αἰσθητὸν τῆς αἰσθήσεως, καὶ εὑρεθήσεται μὴ ἅμα τὰ πρός τι.", "seq": 2542}
{"id": "Olympiodorus_Passim_2543", "series": "CAG", "text": "ἄλλως τε δὲ τὸ ἀναιροῦν τὸ καθολικώτερον ἐκεῖνο πρότερόν ἐστι.", "seq": 2543}
{"id": "Olympiodorus_Passim_2544", "series": "CAG", "text": "τὸ μὲν οὖν αἰσθητὸν ἀναιρεῖ τὸ σῶμα καθολικώτερον ὄν, τὸ δὲ ζῷον τὴν αἴσθησιν ἀναιρεῖ, οὐ μέντοι γε καὶ τὸ σῶμα.", "seq": 2544}
{"id": "Olympiodorus_Passim_2545", "series": "CAG", "text": "εἰ οὖν τὸ σῶμα καθολικώτερόν ἐστιν τῆς αἰσθήσεως, ἀναιρεῖ δὲ τὸ σῶμα τὸ αἰσθητόν, τοῦτ᾿ ἔστι τὸ καθολικώτερον, πρότερον ἄρα τὸ αἰσθητὸν ὡς τὸ αἰσθητικὸν ἀναιροῦν.", "seq": 2545}
{"id": "Olympiodorus_Passim_2546", "series": "CAG", "text": "ἡ λύσις δὲ τῇ μὲν πρώτῃ ἐστὶν αὕτη·", "seq": 2546}
{"id": "Olympiodorus_Passim_2547", "series": "CAG", "text": "ὅτι τὰ αἰσθητὰ ἐνταῦθα τῆς αἰσθήσεώς εἰσιν πρότερα, ὡς πράγματά ἐστιν, οὐ μέντοι γε ὡς αἰσθητά.", "seq": 2547}
{"id": "Olympiodorus_Passim_2548", "series": "CAG", "text": "ὡσαύτως δὲ καὶ τὰ ἐπιστητὰ ὡς πράγματά ἐστιν πρότερα τῆς ἐπιστήμης, οὐχ ὡς ἐπιστητά.", "seq": 2548}
{"id": "Olympiodorus_Passim_2549", "series": "CAG", "text": "ἄλλως τε δὲ οὐ καλῶς γέγονεν ἡ ἐξέτασις·", "seq": 2549}
{"id": "Olympiodorus_Passim_2550", "series": "CAG", "text": "τὰ μὲν γὰρ ἐπιστητὰ δυνάμει ἐπιστητὰ περιελάβομεν, τὴν δὲ ἐπιστήμην ἐνεργείᾳ ἐπιστήμην.", "seq": 2550}
{"id": "Olympiodorus_Passim_2551", "series": "CAG", "text": "οὐ δεῖ δὲ οὕτω παραβαλεῖν, ἀλλὰ τὰ δυνάμει τοῖς δυνάμει καὶ τὰ ἐνεργείᾳ τοῖς ἐνεργείᾳ, ἵνα τότε ἅμα τὰ πρός τι εὑρεθῶσιν.", "seq": 2551}
{"id": "Olympiodorus_Passim_2552", "series": "CAG", "text": "Ἐπεὶ οὖν μετὰ τὰ ἴδια ἐπὶ τὴν ἀληθινὴν ὑπογραφὴν μέλλομεν πορεύεσθαι, φέρε τέσσαράς τινας ἀπορίας πρὸς ταύτην κινήσωμεν, ὧν ἡ πρώτη τοῦτον ἔχει τὸν τρόπον·", "seq": 2552}
{"id": "Olympiodorus_Passim_2553", "series": "CAG", "text": "εἰ τὸ πρός τι ὁριζόμενος τοῦ ἑτέρου ἐμνήσθη (ἔλεγεν γὰρ ὅτι πρός τί ἐστιν ὅσα αὐτὰ ἅπερ ἐστὶν ἑτέρων εἶναι λέγεται), τὸ δὲ ἕτερον πρός τι (ἑτέρου γάρ ἐστιν ἕτερον), τὰ πρός τι ἄρα διὰ τοῦ πρός τι ὡρίσατο.", "seq": 2553}
{"id": "Olympiodorus_Passim_2554", "series": "CAG", "text": "ταύτης τῆς ἀπορίας διττὴν προφέρουσι τὴν λύσιν.", "seq": 2554}
{"id": "Olympiodorus_Passim_2555", "series": "CAG", "text": "πρῶτον μὲν ὅτι ἐπὶ τῶν ἀσχέτων πραγμάτων διαβέβληται ἡ διάλληλος δεῖξις, ἐπὶ δὲ τῶν πρός τι οὐκέτι διαβέβληται, ἀλλὰ καὶ συμβάλλεται πρὸς τὴν τούτων διδασκαλίαν.", "seq": 2555}
{"id": "Olympiodorus_Passim_2556", "series": "CAG", "text": "δεύτερον δὲ ὅτι οὐκ ἀληθῆ τὴν ὑπογραφὴν ἀποδέδωκε τῶν πρός τι, διὸ καὶ τοιαύτῃ ἐχρήσατο φωνῇ.", "seq": 2556}
{"id": "Olympiodorus_Passim_2557", "series": "CAG", "text": "δευτέρα ἀπορία·", "seq": 2557}
{"id": "Olympiodorus_Passim_2558", "series": "CAG", "text": "εἰ μὴ μόνον τὸ ἕτερόν ἐστι τοῦ πρός τι, ἀλλὰ καὶ τὸ αὐτό, τίνος χάριν τὸ ἕτερον μόνον περιέλαβεν, τὸ δὲ ταὐτὸν παρῆκεν;", "seq": 2558}
{"id": "Olympiodorus_Passim_2559", "series": "CAG", "text": "τοῦτο γὰρ ποιήσας ἐλλειπῆ τὸν ὁρισμὸν ἀποδέδωκεν τῶν πρός τι.", "seq": 2559}
{"id": "Olympiodorus_Passim_2560", "series": "CAG", "text": "πρὸς τοῦτό φαμεν ὅτι εἰκότως τὸ ταὐτὸν παραλέλοιπεν·", "seq": 2560}
{"id": "Olympiodorus_Passim_2561", "series": "CAG", "text": "εἰ γὰρ μυριάκις αὐτὸ πρὸς αὐτὸ παραβάλλεται, ἀλλ᾿ οὖν ἕτερον δοκεῖ εἶναι τῷ διπλοῦσθαι τῇ πρὸς ἑαυτὸ παραβολῇ.", "seq": 2561}
{"id": "Olympiodorus_Passim_2562", "series": "CAG", "text": "τρίτη ἀπορία·", "seq": 2562}
{"id": "Olympiodorus_Passim_2563", "series": "CAG", "text": "εἰ τὰ πρός τι μία τῶν κατηγοριῶν, αἱ δὲ κατηγορίαι γένη, τὰ πρός τι γένη, οὐκ ἔστιν ἄρα τὰ γένη πρός τι, ἀλλὰ πᾶν πρός τι γένος.", "seq": 2563}
{"id": "Olympiodorus_Passim_2564", "series": "CAG", "text": "πρὸς οὕς φαμεν ὅτι οὐδαμῶς·", "seq": 2564}
{"id": "Olympiodorus_Passim_2565", "series": "CAG", "text": "οὐ πᾶν γὰρ πρός τι γένος ἐστίν·", "seq": 2565}
{"id": "Olympiodorus_Passim_2566", "series": "CAG", "text": "ἰδοὺ γὰρ τὸ δεξιὸν πρός τι ὂν οὐκ ἔστιν γένος, διότι καὶ μερικόν.", "seq": 2566}
{"id": "Olympiodorus_Passim_2567", "series": "CAG", "text": "τετάρτη ἀπορία·", "seq": 2567}
{"id": "Olympiodorus_Passim_2568", "series": "CAG", "text": "εἰ τὰ πρός τι ἰδίαν ὕλην οὐκ ἔχει, ἀλλ᾿ ὑποβέβληνται τούτοις πᾶσαι αἱ κατηγορίαι, τὰ δὲ ἐν πάσαις ταῖς κατηγορίαις θεωρούμενα ὁμώνυμα, τὰ ἄρα πρός τι ὁμώνυμα.", "seq": 2568}
{"id": "Olympiodorus_Passim_2569", "series": "CAG", "text": "πρὸς τούτους πάλιν ἐνταῦθά φαμεν ὅτι καθολικῶς λαμβάνεται·", "seq": 2569}
{"id": "Olympiodorus_Passim_2570", "series": "CAG", "text": "οὐ γὰρ τὰ ἐν πάσαις ταῖς κατηγορίαις θεωρούμενα ὁμώνυμα, ἀλλὰ τὰ ὑπὸ πάσας τὰς κατηγορίας ἀναγόμενα.", "seq": 2570}
{"id": "Olympiodorus_Passim_2571", "series": "CAG", "text": "τὰ δὲ πρός τι ἐν πάσαις θεωρεῖται, οὐ μέντοι ὑπὸ πάσας ἀνάγεται·", "seq": 2571}
{"id": "Olympiodorus_Passim_2572", "series": "CAG", "text": "οὐκ ἄρα τὰ πρός τι ὁμώνυμά ἐστι·", "seq": 2572}
{"id": "Olympiodorus_Passim_2573", "series": "CAG", "text": "ἄλλο γάρ ἐστι τὸ ἐν πάσαις ταῖς κατηγορίαις θεωρεῖσθαι, καὶ ἄλλο τὸ ὑπὸ πάσας τὰς κατηγορίας ἀνάγεσθαι.", "seq": 2573}
{"id": "Olympiodorus_Passim_2574", "series": "CAG", "text": "τοῦτο πέρας τῆς προκειμένης θεωρίας.", "seq": 2574}
{"id": "Olympiodorus_Passim_2575", "series": "CAG", "text": "<Θεωρία κς΄>", "seq": 2575}
{"id": "Olympiodorus_Passim_2576", "series": "CAG", "text": "7b31 Οἷον ὁ τοῦ κύκλου τετραγωνισμὸς εἴ γε ἔστιν ἐπιστητόν, ἐπιστήμη μὲν αὐτοῦ οὐκ ἔστιν οὔπω, τοῦτο δὲ ἐπιστητόν ἐστιν.", "seq": 2576}
{"id": "Olympiodorus_Passim_2577", "series": "CAG", "text": "Ἐν τοῖς ἀριθμοῖς φησιν ἡ ἀριθμητικὴ τετράγωνον ἀριθμὸν μὲν εἶναι τὸν ἐφ᾿ ἑαυτὸν πολυπλασιαζόμενον, κύκλον δὲ τὸν ἀπὸ τοῦ αὐτοῦ ἀριθμοῦ ἀρχόμενον καὶ εἰς τὸν αὐτὸν λήγοντα.", "seq": 2577}
{"id": "Olympiodorus_Passim_2578", "series": "CAG", "text": "συμβαίνει δὲ πολλάκις ἀριθμὸν καὶ ἐπίσης πολυπλασιάζεσθαι καὶ εἰς τὸν αὐτὸν λήγειν, ὡς εἶναι τὸν αὐτὸν ἀριθμὸν κύκλον τε ἅμα καὶ τετράγωνον, οἷον ἐπὶ παραδείγματος τοῦ λεγομένου·", "seq": 2578}
{"id": "Olympiodorus_Passim_2579", "series": "CAG", "text": "λέγομεν οὕτως·", "seq": 2579}
{"id": "Olympiodorus_Passim_2580", "series": "CAG", "text": "πεντάκις πέντε εἴκοσι πέντε·", "seq": 2580}
{"id": "Olympiodorus_Passim_2581", "series": "CAG", "text": "διότι μὲν ὁ πέντε ἐφ᾿ ἑαυτὸν πολυπλασιάζεται, τετράγωνός ἐστι, διότι δὲ ἀπὸ τοῦ αὐτοῦ ἄρχεται, τοῦτ᾿ ἔστι τὰ πέντε, καὶ εἰς τὸ αὐτὸ λήγει, τὰ πέντε, κύκλος ἐστίν.", "seq": 2581}
{"id": "Olympiodorus_Passim_2582", "series": "CAG", "text": "ὡς οὖν ἐνδέχεται τὸν αὐτὸν ἀριθμὸν εἶναι καὶ κύκλον καὶ τετράγωνον, οὕτως καὶ ἐπὶ τῶν μεγεθῶν ἐζήτησαν οἱ παλαιοὶ εἰ ἐνδέχεται κύκλον εἶναι ἴσα <καὶ> τετράγωνον.", "seq": 2582}
{"id": "Olympiodorus_Passim_2583", "series": "CAG", "text": "τὸ δὲ οὐκ ἔστιν.", "seq": 2583}
{"id": "Olympiodorus_Passim_2584", "series": "CAG", "text": "ἡ δὲ αἰτία, διότι ἡ μὲν μονὰς καταμετρεῖ τὸν ἀριθμόν, μέρος οὖσα τοῦ ἀριθμοῦ, τὸ δὲ σημεῖον οὐ καταμετρεῖ τὰ μεγέθη·", "seq": 2584}
{"id": "Olympiodorus_Passim_2585", "series": "CAG", "text": "διότι μὲν γὰρ ὁ ἀριθμὸς μονάσι καταμετρεῖται, δύναται ὁ αὐτὸς καὶ κύκλος εἶναι καὶ τετράγωνος, διότι δὲ τὰ μεγέθη οὐ καταμετροῦνται σημείοις, οὐ δύναται τὸ αὐτὸ μέγεθος καὶ κύκλος εἶναι καὶ τετράγωνον.", "seq": 2585}
{"id": "Olympiodorus_Passim_2586", "series": "CAG", "text": "ὁ τοίνυν Ἀριστοτέλης ἐπὶ τούτου ἀπορεῖ τὴν ἀπορίαν δεικνὺς πρότερον ὑπάρχειν τὸ ἐπιστητὸν τῆς ἐπιστήμης.", "seq": 2586}
{"id": "Olympiodorus_Passim_2587", "series": "CAG", "text": "8a13 Ἔχει δὲ ἀπορίαν πότερον οὐδεμία οὐσία τῶν πρός τι λέγεται, καθάπερ δοκεῖ, ἢ τοῦτο ἐνδέχεται κατά τινας τῶν δευτέρων οὐσιῶν·", "seq": 2587}
{"id": "Olympiodorus_Passim_2588", "series": "CAG", "text": "ἐπὶ μὲν γὰρ τῶν πρώτων οὐσιῶν ἀληθές ἐστιν·", "seq": 2588}
{"id": "Olympiodorus_Passim_2589", "series": "CAG", "text": "οὔτε γὰρ τὰ ὅλα οὔτε τὰ μέρη πρός τι λέγεται·", "seq": 2589}
{"id": "Olympiodorus_Passim_2590", "series": "CAG", "text": "ὁ γὰρ τὶς ἄνθρωπος οὐ λέγεται τινός τις ἄνθρωπος, οὐδὲ ὁ τὶς βοῦς οὐ λέγεται τινός τις βοῦς.", "seq": 2590}
{"id": "Olympiodorus_Passim_2591", "series": "CAG", "text": "καὶ ἁπλῶς εἰπεῖν τὰ ἑξῆς.", "seq": 2591}
{"id": "Olympiodorus_Passim_2592", "series": "CAG", "text": "Τριμερὴς ὑπῆρχεν ἡ διδασκαλία τῶν πρός τι, ὡς εἴρηται·", "seq": 2592}
{"id": "Olympiodorus_Passim_2593", "series": "CAG", "text": "ἡ ψευδὴς ὑπογραφὴ τῶν πρός τι, τὰ ἴδια, ἡ ἀληθὴς ὑπογραφή, ἥτις καὶ συμπληροῖ αὐτήν.", "seq": 2593}
{"id": "Olympiodorus_Passim_2594", "series": "CAG", "text": "ἀποδοὺς οὖν ὁ Ἀριστοτέλης τὰ πρότερα δύο κεφάλαια, τοῦτ᾿ ἔστι τὴν ψευδῆ ὑπογραφὴν καὶ τὰ ἴδια αὐτῶν, μεταβαίνει λοιπὸν ἐπὶ τὴν ἀληθῆ ὑπογραφήν.", "seq": 2594}
{"id": "Olympiodorus_Passim_2595", "series": "CAG", "text": "καὶ ἄξιόν ἐστιν ζητῆσαι τίνος χάριν τὰ ψευδῆ πρότερα παραδέδωκεν ὁ Ἀριστοτέλης.", "seq": 2595}
{"id": "Olympiodorus_Passim_2596", "series": "CAG", "text": "καί φαμεν ὅτι τοῦτο πεποίηκεν εἰκότως, ὡς συμβαλλόμενον καὶ τῷ λέγοντι καὶ τῷ ἀκούοντι καὶ τοῖς ὑποκειμένοις πράγμασι·", "seq": 2596}
{"id": "Olympiodorus_Passim_2597", "series": "CAG", "text": "τῷ μὲν λέγοντι, ἵνα μὴ δόξῃ, ἀλλ᾿ ἵνα μετὰ ἀποδείξεως πάντα προφέρηται, τῷ δὲ ἀκούοντι, ἵνα πρότερον ἐγγυμνασάμενος τοῖς ψευδέσι καὶ τὸν τοιοῦτον ἔλεγχον μαθὼν ἀνενδοιάστως καὶ ἀκριβῶς τὰ ἀληθῆ παραλάβῃ.", "seq": 2597}
{"id": "Olympiodorus_Passim_2598", "series": "CAG", "text": "τοῖς δὲ ὑποκειμένοις πράγμασι συμβάλλεται τὸ πρότερον τὰ ψευδῆ παραδιδόναι τὸν φιλόσοφον, ὅτι ἡ ἀποδοθεῖσα ὑπογραφὴ εἰ καὶ μὴ ἔστιν ἀληθής, ἀλλ᾿ οὖν ἴδιόν ἐστι τῶν πρός τι πᾶσι μὲν ὑπάρχον, οὐ μόνοις δέ.", "seq": 2598}
{"id": "Olympiodorus_Passim_2599", "series": "CAG", "text": "εἰ δὲ ἴδιόν ἐστιν, ἔδει μὴ σιωπηθῆναι τοῦτο, ἵνα τελεία γένηται ἡ τῶν πρός τι διδασκαλία.", "seq": 2599}
{"id": "Olympiodorus_Passim_2600", "series": "CAG", "text": "οὐ μὴν οὐδὲ τὴν ἀληθῆ ὑπογραφὴν ἀπονητὶ παραδίδωσιν ὁ φιλόσοφος, ἀλλὰ τίθησιν ἀπορίαν τινὰ καὶ δείκνυσιν ὅτι τῆς μὲν προτέρας σωζομένης ὑπογραφῆς ἀνεπίλυτος μένει ἡ ἀπορία, τεθείσης δὲ τῆς ἀληθοῦς δυνατὸν ταύτην ἐπίλυσιν δέξασθαι.", "seq": 2600}
{"id": "Olympiodorus_Passim_2601", "series": "CAG", "text": "ἵνα οὖν τὴν ἀπορίαν νοήσωμεν, τρία ταῦτα ζητήσωμεν·", "seq": 2601}
{"id": "Olympiodorus_Passim_2602", "series": "CAG", "text": "πρῶτον τίς ἡ ὕλη τῆς ἀπορίας, δεύτερον τί τὸ ποιητικὸν αὐτῆς αἴτιον, καὶ τρίτον πῶς αὐτὴ προέρχεται.", "seq": 2602}
{"id": "Olympiodorus_Passim_2603", "series": "CAG", "text": "ἔστι τοίνυν ἡ ὕλη τῆς ἀπορίας αὕτη·", "seq": 2603}
{"id": "Olympiodorus_Passim_2604", "series": "CAG", "text": "ἡ οὐσία ἢ καθόλου ἢ μερικὴ καὶ ὅλη καὶ κατὰ μέρος, ὡς γίνεσθαι τέτταρας συμπλοκὰς ἐκ τῶν εἰρημένων·", "seq": 2604}
{"id": "Olympiodorus_Passim_2605", "series": "CAG", "text": "ὅλον καθόλου, ὥσπερ ὁ καθόλου ἄνθρωπος ὅλον τε καὶ καθόλου, ὅλον δὲ μερικόν, ὥσπερ ὁ Σωκράτης μερικὸς μὲν ὢν ὡς ἄτομον, ὅλος δέ, καθὸ συμπεπληρωμένα τὰ πάντα ἔχει, τὰ μόρια τὰ συμπληροῦντα τὸ ἄτομον, μέρος δὲ καθόλου, οἷον ἡ ἁπλῶς κεφαλή, μέρος μὲν οὖσα ὡς κεφαλή, καθόλου δέ, ὅτι κατὰ πολλῶν κεφαλῶν λέγεται, μέρος μερικόν, οἷον ἡ τὶς κεφαλή·", "seq": 2605}
{"id": "Olympiodorus_Passim_2606", "series": "CAG", "text": "μέρος μὲν γάρ ἐστιν ὡς μόριον οὖσα, μερικὸν δέ, καθὸ τινὸς ἀνθρώπου ἐστὶν ἡ κεφαλή.", "seq": 2606}
{"id": "Olympiodorus_Passim_2607", "series": "CAG", "text": "ἐν τούτοις ἡ ὕλη τῆς ἀπορίας.", "seq": 2607}
{"id": "Olympiodorus_Passim_2608", "series": "CAG", "text": "τί δέ ἐστι τὸ ποιητικὸν αἴτιον αὐτῆς;", "seq": 2608}
{"id": "Olympiodorus_Passim_2609", "series": "CAG", "text": "φαμὲν οὖν ὅτι τὸ ποιητικὸν αἴτιόν ἐστιν ἡ οὐσία, ἥτις ἐστὶν μέρος καὶ καθόλου.", "seq": 2609}
{"id": "Olympiodorus_Passim_2610", "series": "CAG", "text": "προέρχεται δὲ ἡ ἀπορία τοῦτον τὸν τρόπον·", "seq": 2610}
{"id": "Olympiodorus_Passim_2611", "series": "CAG", "text": "ἆρα ἀληθές ἐστι τὸ λέγειν μηδεμίαν οὐσίαν εἶναι τῶν πρός τι ἢ ἔστι τις οὐσία τῶν πρός τι;", "seq": 2611}
{"id": "Olympiodorus_Passim_2612", "series": "CAG", "text": "πᾶσα τοίνυν οὐσία ἢ πρώτη ἐστὶν ἢ δευτέρα, καὶ καθ᾿ ἑκάτερον ἢ καθόλου ἢ μερική.", "seq": 2612}
{"id": "Olympiodorus_Passim_2613", "series": "CAG", "text": "[ὅλη μὲν ὡς Σωκράτης ὅλος, μερικὴ δὲ ὡς τὰ μόρια τοῦ Σωκράτους].", "seq": 2613}
{"id": "Olympiodorus_Passim_2614", "series": "CAG", "text": "ἡ μὲν οὖν πρώτη οὐσία οὔτε καθ᾿ ὅλην ἑαυτὴν οὔτε κατὰ τὰ μέρη λέγεται πρός τι.", "seq": 2614}
{"id": "Olympiodorus_Passim_2615", "series": "CAG", "text": "ἡ δὲ δευτέρα οὐσία καθ᾿ ὅλην μὲν ἑαυτὴν οὐ λέγεται πρός τι, κατὰ δὲ τὰ μέρη ἴσως λέγεται, οἷον ἡ κεφαλὴ τινὸς κεφαλὴ καὶ ἡ χεὶρ τινὸς χείρ.", "seq": 2615}
