{"id": "Olympiodorus_Passim_1262", "series": "CAG", "text": "1b25 Τῶν κατὰ μηδεμίαν συμπλοκὴν λεγομένων ἕκαστον ἤτοι οὐσίαν σημαίνει ἢ ποσὸν ἢ ποιὸν ἢ πρός τι ἢ ποτὲ ἢ ποῦ ἢ κεῖσθαι ἢ ἔχειν ἢ ποιεῖν ἢ πάσχειν.", "seq": 1262}
{"id": "Olympiodorus_Passim_1263", "series": "CAG", "text": "Καλῶς προσέθηκεν ὁ φιλόσοφος τῶν κατὰ μηδεμίαν συμπλοκήν·", "seq": 1263}
{"id": "Olympiodorus_Passim_1264", "series": "CAG", "text": "πολλαὶ γάρ εἰσι συμπλοκαί, αἱ μὲν κατὰ φωνὴν αἱ δὲ κατὰ τὸ σημαινόμενον·", "seq": 1264}
{"id": "Olympiodorus_Passim_1265", "series": "CAG", "text": "κατὰ μὲν φωνὴν οἷον ζῷον λογικὸν θνητόν, κατὰ δὲ τὸ σημαινόμενον οἷον Σωκράτης τρέχει·", "seq": 1265}
{"id": "Olympiodorus_Passim_1266", "series": "CAG", "text": "ἰστέον γάρ, ὡς ἔφαμεν, ὅτι τὰ ταῖς λέξεσι σύνθετα γραμματικοῖς καὶ μόνοις ἐστίν, οἷον τὸ ζῷον λογικὸν θνητόν, τὸ Κόρακος πέτρα, τὸ Ἄρειος πάγος, τὰ δὲ τοῖς ἐνθυμήμασιν σύνθετα κατὰ συμπλοκὴν καὶ μόνον καλοῦσιν οἱ φιλόσοφοι, ἐπεὶ τούτοις τὴν ψῆφον ἀποδεδώκασι, ἐκεῖνα καλοῦντες ἁπλᾶ, εἰ καὶ ταῖς λέξεσι πεφύκασι σύνθετα.", "seq": 1266}
{"id": "Olympiodorus_Passim_1267", "series": "CAG", "text": "κατὰ μηδεμίαν τοίνυν συμπλοκὴν εἴρηκεν ὁ φιλόσοφος σημαινόμενον, ὅτι αἱ κατηγορίαι οὔτε ταῖς φωναῖς οὔτε τῷ σημαινομένῳ κατὰ συμπλοκὴν ὑπάρχουσι.", "seq": 1267}
{"id": "Olympiodorus_Passim_1268", "series": "CAG", "text": "1b27 Ἔστι δὲ οὐσία μὲν ὡς τύπῳ εἰπεῖν οἷον ἄνθρωπος.", "seq": 1268}
{"id": "Olympiodorus_Passim_1269", "series": "CAG", "text": "Ἐνταῦθα ἡ σκιαγραφία τῶν κατηγοριῶν, ὡς ἐλέγομεν ἐν τῇ θεωρίᾳ πρὸ τῆς διδασκαλίας τῶν κατηγοριῶν, οἷον ὅτι σκιαγραφίαν τούτων ἀποδίδωσιν ὁ φιλόσοφος.", "seq": 1269}
{"id": "Olympiodorus_Passim_1270", "series": "CAG", "text": "ἰστέον οὖν ὅτι αὐτὸς μὲν διὰ παραδειγμάτων ταύτας ἐχαρακτήρισεν, ἡμεῖς δὲ τὰς ὑπογραφὰς αὐτῶν ἐν τοῖς προτελείοις τοῖς εἰσαγομένοις ἀποδεδώκαμεν.", "seq": 1270}
{"id": "Olympiodorus_Passim_1271", "series": "CAG", "text": "οὐδὲν δὲ ἄτοπον καὶ νῦν ταύτας εἰπεῖν.", "seq": 1271}
{"id": "Olympiodorus_Passim_1272", "series": "CAG", "text": "οὐσία τοίνυν ἐστὶν αὐθυπόστατον πρᾶγμα.", "seq": 1272}
{"id": "Olympiodorus_Passim_1273", "series": "CAG", "text": "μάθοις δὲ τὸ λεγόμενον ἐκ τοῦ ἐναντίου·", "seq": 1273}
{"id": "Olympiodorus_Passim_1274", "series": "CAG", "text": "συμβεβηκὸς γάρ ἐστι τὸ ἐν ὑποκειμένῳ τὸ δεόμενον ἑτέρου πρὸς ὕπαρξιν.", "seq": 1274}
{"id": "Olympiodorus_Passim_1275", "series": "CAG", "text": "εἰ δὲ τὸ συμβεβηκὸς ἐν ὑποκειμένῳ, τοῦτ᾿ ἔστιν ἐν ἑτέρῳ ἔχον τὴν ὕπαρξιν, δῆλον ὅτι αὐθυπόστατός ἐστιν ἡ οὐσία ἑτέρου μὴ δεομένη πρὸς ὕπαρξιν.", "seq": 1275}
{"id": "Olympiodorus_Passim_1276", "series": "CAG", "text": "ποσὸν δέ ἐστι τὸ καταμετρούμενον, οἷον δίπηχυ, τρίπηχυ.", "seq": 1276}
{"id": "Olympiodorus_Passim_1277", "series": "CAG", "text": "ποιὸν τὸ παρωνύμως κατηγορούμενον, οἷον λευκόν, γραμματικόν.", "seq": 1277}
{"id": "Olympiodorus_Passim_1278", "series": "CAG", "text": "πρός τι δὲ τὸ ἐν σχέσει θεωρούμενον, ὡς πατήρ, υἱός.", "seq": 1278}
{"id": "Olympiodorus_Passim_1279", "series": "CAG", "text": "ποῦ δέ ἐστιν οὐσία ἐν τόπῳ, οἷον Σωκράτης ἐν Λυκείῳ.", "seq": 1279}
{"id": "Olympiodorus_Passim_1280", "series": "CAG", "text": "ποτέ δέ ἐστιν οἷον οὐσία ἐν χρόνῳ, οἷον Σωκράτης ἐν τῷ Πελοποννησιακῷ πολέμῳ.", "seq": 1280}
{"id": "Olympiodorus_Passim_1281", "series": "CAG", "text": "κεῖσθαι δέ ἐστιν ἡ τοιάδε τῶν μορίων σχέσις, οἷον ἀνάκειται, κάθηται.", "seq": 1281}
{"id": "Olympiodorus_Passim_1282", "series": "CAG", "text": "ἔχειν δέ ἐστιν οὐσίας παρ᾿ οὐσίαν παράθεσις, οἷον δακτύλιος ἐν χειρί.", "seq": 1282}
{"id": "Olympiodorus_Passim_1283", "series": "CAG", "text": "ποιεῖν δέ ἐστιν τὸ εἴς τι ἐνεργεῖν, πάσχειν δὲ τὸ ὑφ᾿ ἑτέρου ἀλλοιοῦσθαι.", "seq": 1283}
{"id": "Olympiodorus_Passim_1284", "series": "CAG", "text": "2a4 Ἕκαστον δὲ τῶν εἰρημένων αὐτὸ μὲν καθ᾿ ἑαυτὸ ἐν οὐδεμιᾷ καταφάσει λέγεται <ἢ ἀποφάσει>, τῇ δὲ πρὸς ἄλληλα τούτων συμπλοκῇ κατάφασις ἢ ἀπόφασις γίνεται.", "seq": 1284}
{"id": "Olympiodorus_Passim_1285", "series": "CAG", "text": "Ἐνταῦθα βούλεται τὰς ἁπλᾶς φωνὰς ὁ φιλόσοφος χωρίσαι ἀπὸ τῶν καταφάσεων καὶ ἀποφάσεων.", "seq": 1285}
{"id": "Olympiodorus_Passim_1286", "series": "CAG", "text": "πρὸς δὲ τελείαν τούτων διάκρισιν κέχρηται κανόνι τοιούτῳ·", "seq": 1286}
{"id": "Olympiodorus_Passim_1287", "series": "CAG", "text": "ἐὰν ᾖ ἕν, πράγματα δὲ δύο τινά, καὶ τῷ μὲν ἁρμόσῃ τῷ δὲ οὐχ ἁρμόσῃ, διάφορά ἐστιν ἐκεῖνα δηλονότι.", "seq": 1287}
{"id": "Olympiodorus_Passim_1288", "series": "CAG", "text": "οἷόν τι λέγω·", "seq": 1288}
{"id": "Olympiodorus_Passim_1289", "series": "CAG", "text": "εἰσὶ δύο τινά, ζῷον καὶ φυτόν·", "seq": 1289}
{"id": "Olympiodorus_Passim_1290", "series": "CAG", "text": "τούτων τὸ αἰσθητικὸν τῷ μὲν ὑπάρχει, λέγω δὴ τῷ ζῴῳ, τῷ δὲ οὐχ ὑπάρχει, λέγω δὴ τῷ φυτῷ·", "seq": 1290}
{"id": "Olympiodorus_Passim_1291", "series": "CAG", "text": "δῆλον οὖν ὅτι ταῦτα διάφορά εἰσιν, τοῦτ᾿ ἔστι τὸ ζῷον καὶ φυτόν.", "seq": 1291}
{"id": "Olympiodorus_Passim_1292", "series": "CAG", "text": "οὕτως οὖν καὶ ἐνταῦθά εἰσιν ἁπλαῖ φωναὶ καὶ κατάφασις καὶ ἀπόφασις·", "seq": 1292}
{"id": "Olympiodorus_Passim_1293", "series": "CAG", "text": "τὸ δὲ ἀληθεύειν ἢ ψεύδεσθαι καταφάσει καὶ ἀποφάσει ἁρμόζει, ταῖς δὲ ἁπλαῖς φωναῖς οὐκ ἐφαρμόζει·", "seq": 1293}
{"id": "Olympiodorus_Passim_1294", "series": "CAG", "text": "δῆλον ἄρα ὅτι καὶ διαφέρουσιν αὗται αἱ ἁπλαῖ φωναὶ καὶ αἱ καταφάσεις καὶ αἱ ἀποφάσεις.", "seq": 1294}
{"id": "Olympiodorus_Passim_1295", "series": "CAG", "text": "ὅθεν καὶ αὐτός φησιν ὅτι ἕκαστον τῶν εἰρημένων, τοῦτ᾿ ἔστι τῶν ἁπλῶν φωνῶν, λέγω δὴ τῶν κατηγοριῶν, αὐτὰ καθ᾿ αὑτὰ οὔτε κατάφασιν σημαίνει οὔτε ἀπόφασιν, τῇ δὲ πρὸς ἄλληλα τούτων συμπλοκῇ κατάφασις γίνεται καὶ ἀπόφασις.", "seq": 1295}
{"id": "Olympiodorus_Passim_1296", "series": "CAG", "text": "οἷον συμπλέκω τὴν οὐσίαν καὶ τὴν ποιὸν κατηγορίαν, τοῦτ᾿ ἔστι τὸ ἄνθρωπος τρέχει, καὶ γίνεται κατάφασις δηλονότι.", "seq": 1296}
{"id": "Olympiodorus_Passim_1297", "series": "CAG", "text": "τὸ δὲ οὔ ἀρνητικὸν μόριον μεταξὺ τούτων λαμβανόμενον ἀπόφασις γίνεται, οἷον ἄνθρωπος οὐ τρέχει.", "seq": 1297}
{"id": "Olympiodorus_Passim_1298", "series": "CAG", "text": "Περὶ οὐσίας.", "seq": 1298}
{"id": "Olympiodorus_Passim_1299", "series": "CAG", "text": "2a11 Οὐσία δέ ἐστιν ἡ κυριώτατά τε καὶ πρώτως καὶ μάλιστα λεγομένη, ἣ μήτε καθ᾿ ὑποκειμένου τινὸς λέγεται μήτε ἐν ὑποκειμένῳ τινί ἐστιν.", "seq": 1299}
{"id": "Olympiodorus_Passim_1300", "series": "CAG", "text": "Ἐπειδὴ αἱ κατηγορίαι καὶ λέγονται καὶ εἰσὶ καὶ αὐτὸ τοῦτο κατηγοροῦνται, διότι μὲν λέγονται, τῶν λεγομένων ἐποιήσατο τὴν διαίρεσιν, διότι δὲ εἰσί, τὰ ὄντα διεῖλεν, διότι δὲ κατηγοροῦνται, ὡρίσατο ὁμώνυμα, συνώνυμα, παρώνυμα·", "seq": 1300}
{"id": "Olympiodorus_Passim_1301", "series": "CAG", "text": "ταῦτα γὰρ κατηγορίας τρόποι εἰσίν.", "seq": 1301}
{"id": "Olympiodorus_Passim_1302", "series": "CAG", "text": "ἐν ᾧ δὲ μάλιστα προσῆκεν ταῖς κατηγορίαις τὸ συνωνύμως κατηγορεῖσθαι, ἐνδιέτριψε τῷ λόγῳ τῷ περὶ τῶν συνωνύμων, παραδοὺς αὐτῶν τὸ ἴδιον.", "seq": 1302}
{"id": "Olympiodorus_Passim_1303", "series": "CAG", "text": "ἦν δὲ τοῦτο τὸ μεταδιδόναι τοῖς οἰκείοις ὑποκειμένοις τῶν ἰδίων κατηγορουμένων.", "seq": 1303}
{"id": "Olympiodorus_Passim_1304", "series": "CAG", "text": "τοῦτο δὲ εἶπεν, ὅτε ἔλεγεν ὅταν ἕτερον καθ᾿ ἑτέρου κατηγορῆται ὡς καθ᾿ ὑποκειμένου, ὅσα κατὰ τοῦ κατηγορημένου λέγεται, τοσαῦτα καὶ κατὰ τοῦ ὑποκειμένου ῥηθήσεται.", "seq": 1304}
{"id": "Olympiodorus_Passim_1305", "series": "CAG", "text": "εἶτα ἐδίδαξεν ποῖα μὲν τῶν συνωνύμων τὰς αὐτὰς ἔχει διαφοράς, ποῖα δὲ ἑτέρας, καί φησιν ὅτι τὰ ἑτερογενῆ ἑτέρας ἔχει τὰς διαφοράς, τὰ δὲ ὑπάλληλα τὰς αὐτάς.", "seq": 1305}
{"id": "Olympiodorus_Passim_1306", "series": "CAG", "text": "καὶ ἁπλῶς εἰπεῖν, πέντε μέν τινας ὁρισμοὺς ἀποδέδωκεν, ὁμωνύμων, συνωνύμων, παρωνύμων, τῆς ἐν ὑποκειμένῳ φωνῆς, τῆς καθ᾿ ὑποκειμένου, τρεῖς δὲ διαιρέσεις, ** τῶν λεγομένων κατὰ συμπλοκὴν εἰς τέσσαρα, τῶν ἄνευ συμπλοκῆς εἰς τὰς δέκα κατηγορίας, καὶ τρεῖς κανόνας, δύο μὲν τοῦ βάθους τῶν κατηγοριῶν ἕνα δὲ τοῦ πλάτους.", "seq": 1306}
{"id": "Olympiodorus_Passim_1307", "series": "CAG", "text": "καὶ διαλαβὼν περὶ τούτων ἐν τῷ πρώτῳ τμήματι καὶ οὕτω προπαρασκευάσας ἡμᾶς, μέτεισι λοιπὸν ἐπὶ τὸ δεύτερον τμῆμα ἐντεῦθεν ἐφαπτόμενος τῶν ἀγώνων καὶ ποιεῖται τὴν ἀρχὴν ἀπὸ τῆς οὐσίας.", "seq": 1307}
{"id": "Olympiodorus_Passim_1308", "series": "CAG", "text": "εἰκότως, ἐπειδὴ αὕτη πρώτη τῶν ἄλλων ἐστίν·", "seq": 1308}
{"id": "Olympiodorus_Passim_1309", "series": "CAG", "text": "ὄντων μὲν γὰρ τῶν συμβεβηκότων ἀνάγκη πάντως οὐσίαν ὑπάρχειν, οὔσης δὲ ταύτης οὐκ ἀνάγκη πάντως εἶναι καὶ τὰ συμβεβηκότα·", "seq": 1309}
{"id": "Olympiodorus_Passim_1310", "series": "CAG", "text": "ὥστε συνεισφέρεται μέν, οὐ συνεισφέρει δέ.", "seq": 1310}
{"id": "Olympiodorus_Passim_1311", "series": "CAG", "text": "ἀλλὰ καὶ συναναιρεῖ μέν, οὐ συναναιρεῖται δέ·", "seq": 1311}
{"id": "Olympiodorus_Passim_1312", "series": "CAG", "text": "ἀναιρουμένης μὲν γὰρ οὐσίας ἀνῄρηται καὶ τὸ συμβεβηκός, ἀναιρουμένων δὲ τῶν συμβεβηκότων οὐκ ἀνῄρηται ἡ οὐσία.", "seq": 1312}
{"id": "Olympiodorus_Passim_1313", "series": "CAG", "text": "τὰ δὲ τοιαῦτα φύσει πρῶτά ἐστιν.", "seq": 1313}
{"id": "Olympiodorus_Passim_1314", "series": "CAG", "text": "Οὐκοῦν ἐπειδὴ καλῶς ἡμῖν ὑπεξείργαστο ὁ λόγος ὁ περὶ τῆς τάξεως, φέρε ζητήσωμεν ἐπὶ τῆς παρούσης θεωρίας ἕξ τινα·", "seq": 1314}
{"id": "Olympiodorus_Passim_1315", "series": "CAG", "text": "πρῶτον μὲν πόσα τὰ σημαινόμενα τῆς οὐσίας, δεύτερον δὲ περὶ ποίου σημαινομένου ὁ λόγος ἐστί, τρίτον ποίῳ τρόπῳ διαιρέσεως κέχρηται, τέταρτον διὰ τί τὴν ἄτομον τῆς καθόλου πρώτην ἐκάλεσεν, πέμπτον εἰ γένος ἡ οὐσία, πῶς ἐπιδέχεται τὸ πρῶτον καὶ τὸ δεύτερον, ἕκτον ζητήσωμεν εἰ ὑγιής ἐστιν ἡ ἀποδεδομένη ὑπογραφὴ τῆς οὐσίας.", "seq": 1315}
{"id": "Olympiodorus_Passim_1316", "series": "CAG", "text": "οὐχ ἓν τοίνυν ἀλλὰ πολλὰ σημαινόμενα τῆς οὐσίας ἔστιν·", "seq": 1316}
{"id": "Olympiodorus_Passim_1317", "series": "CAG", "text": "λέγεται γὰρ οὐσία καὶ πάντα τὰ ὄντα, καθὸ ὕπαρξιν ἔχει τινά, ἔστιν δὲ οὐσία καὶ ἡ ἁπλῆ (καὶ αὕτη πάλιν διττή·", "seq": 1317}
{"id": "Olympiodorus_Passim_1318", "series": "CAG", "text": "ἢ κρείττων τῆς συνθέτου, ὡς ἡ μία τῶν πάντων ἀρχή, ἢ χείρων τῆς συνθέτου, ὡς ἡ ἀνείδεος ὕλη), ἔστι δὲ οὐσία καὶ ἡ σύνθετος, οἷον ἄνθρωπος, ἵππος.", "seq": 1318}
{"id": "Olympiodorus_Passim_1319", "series": "CAG", "text": "τοσαῦτα τοίνυν σημαινόμενα τῆς οὐσίας.", "seq": 1319}
{"id": "Olympiodorus_Passim_1320", "series": "CAG", "text": "ἐπὶ τούτοις δεύτερον ζητήσωμεν περὶ ποίου σημαινομένου διαλέγεται.", "seq": 1320}
{"id": "Olympiodorus_Passim_1321", "series": "CAG", "text": "φημὶ δὴ ὅτι οὐ περὶ τοῦ σημαινομένου ἐκείνου τοῦ δηλοῦντος πάντα τὰ ὄντα·", "seq": 1321}
{"id": "Olympiodorus_Passim_1322", "series": "CAG", "text": "ταῦτα γὰρ ὑπὸ πασῶν τῶν κατηγοριῶν διδάσκεται καὶ οὐχ ὑπὸ μιᾶς μόνης.", "seq": 1322}
{"id": "Olympiodorus_Passim_1323", "series": "CAG", "text": "ἀλλ᾿ οὐδὲ μὴν περὶ τῆς ἁπλῆς διαλέγεται, οὔτε τῆς κρείττονος τῆς συνθέτου (τοῦτο γὰρ θεολογίας ἔργον διδάξαι), οὔτε περὶ τῆς χείρονος·", "seq": 1323}
{"id": "Olympiodorus_Passim_1324", "series": "CAG", "text": "τοῦτο γὰρ φυσιολογίᾳ προσήκει.", "seq": 1324}
{"id": "Olympiodorus_Passim_1325", "series": "CAG", "text": "λείπεται οὖν περὶ τῆς συνθέτου αὐτὸν διαλαβεῖν.", "seq": 1325}
{"id": "Olympiodorus_Passim_1326", "series": "CAG", "text": "οὐχὶ συνθέτου ἁπλῶς, ἐπεὶ εὑρισκόμεθα πάντα τὰ φυσικὰ συγγράμματα τοῦ φιλοσόφου ἐν τούτῳ περιλαμβάνοντες, ἀλλὰ περὶ ταύτης φαμὲν διαλέγεσθαι ὡς ὑπὸ φωνῆς σημαινομένης, ἐπεὶ καὶ ἡ λογικὴ πραγματεία περὶ πραγμάτων διαλέγεται, οὐχ ὅτι πράγματα, ἀλλ᾿ ὅτι ὑπὸ φωνῶν σημαίνονται.", "seq": 1326}
{"id": "Olympiodorus_Passim_1327", "series": "CAG", "text": "τρίτον ἦν τῶν ζητουμένων, ποίῳ τρόπῳ διαιρέσεως κέχρηται.", "seq": 1327}
{"id": "Olympiodorus_Passim_1328", "series": "CAG", "text": "διαιρεῖ τοίνυν ὁ φιλόσοφος τὴν οὐσίαν εἰς καθόλου καὶ μερικήν.", "seq": 1328}
{"id": "Olympiodorus_Passim_1329", "series": "CAG", "text": "καὶ ἐπειδὴ ἡ οὐσία γένος ἐστὶ γενικώτατον τὰ δὲ γενικώτατα γένη ἔχει καὶ γένη καὶ εἴδη καὶ ἄτομα, τὰ μὲν ἄτομα πρῶτα ἐκάλεσεν τὰ δὲ γένη καὶ τὰ εἴδη δεύτερα, οὐ κεχρημένος διαιρέσει κυρίως, ἀλλὰ τρόπῳ διδασκαλικῷ μιμούμενος τρόπον διαιρετικόν.", "seq": 1329}
{"id": "Olympiodorus_Passim_1330", "series": "CAG", "text": "τέταρτον ἐπὶ τούτοις ζητήσωμεν πῶς ἐνταῦθα τὴν ἄτομον οὐσίαν πρώτην καλεῖ τὴν δὲ καθόλου δευτέραν, ἐν δὲ τῇ Μετὰ φυσικὰ τὸ ἀνάπαλιν πρῶτα μὲν τὰ καθόλου τάττει δεύτερα δὲ τὰ μερικά.", "seq": 1330}
{"id": "Olympiodorus_Passim_1331", "series": "CAG", "text": "φαμὲν οὖν ἡμεῖς ὅτι διττὴ ἡ τάξις, ἡ μὲν φυσική, ἥτις καὶ τὰ καθόλου πρῶτα οἶδεν τῶν μερικῶν, ἡ δὲ πρὸς ἡμᾶς, ἥτις τὰ μερικὰ οἶδεν πρὸ τῶν καθόλου.", "seq": 1331}
{"id": "Olympiodorus_Passim_1332", "series": "CAG", "text": "διττῆς οὖν οὔσης τῆς τάξεως, οὐ τῇ τάξει τῇ φυσικῇ κέχρηται, ἀλλὰ τῇ πρὸς ἡμᾶς·", "seq": 1332}
{"id": "Olympiodorus_Passim_1333", "series": "CAG", "text": "ἐπειδὴ γὰρ εἰσαγωγικὸν τὸ σύγγραμμα πέφυκεν, φιλανθρώπως ποιῶν ὁ φιλόσοφος ἁρμόζεται πρὸς ἡμᾶς.", "seq": 1333}
{"id": "Olympiodorus_Passim_1334", "series": "CAG", "text": "ἐν δὲ τοῖς Μετὰ φυσικὰ τοῖς πράγμασιν ἑπόμενος ἀπονέμει κἀκείνοις τὸ ἴδιον, τὸ καθόλου τῶν μερικῶν προτάττων.", "seq": 1334}
{"id": "Olympiodorus_Passim_1335", "series": "CAG", "text": "ὁ δὲ Ἀλέξανδρος καὶ ἰδίας ἐπιλύσεως εὐπορεῖ·", "seq": 1335}
{"id": "Olympiodorus_Passim_1336", "series": "CAG", "text": "φησὶ γὰρ ὅτι τὰ ἄτομα πρῶτα ὑπάρχει τῶν καθόλου (πρῶτα δέ φησι τῇ φύσει)·", "seq": 1336}
{"id": "Olympiodorus_Passim_1337", "series": "CAG", "text": "συνεισφέρεται γὰρ καὶ οὐ συνεισφέρει·", "seq": 1337}
{"id": "Olympiodorus_Passim_1338", "series": "CAG", "text": "τοῦ γὰρ <κοινοῦ> κυνὸς ὄντος ἀνάγκη καὶ τὸν ἄτομον εἶναι κύνα, ἐπεὶ τινός ἐστι, τοῦ δὲ ἀτόμου ὄντος οὐ πάντως ἀνάγκη καὶ τὸν κοινὸν ὑπάρχειν.", "seq": 1338}
