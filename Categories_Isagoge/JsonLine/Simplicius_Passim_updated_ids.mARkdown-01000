{"id": "Simplicius_Passim_4769", "series": "CAG", "text": "ἢ ἐπὶ μὲν τῶν σωμάτων ἀνάγκη συγχωρεῖν·", "seq": 4769}
{"id": "Simplicius_Passim_4770", "series": "CAG", "text": "ἡ γὰρ λευκότης συμβεβηκὸς οὖσα οὐσιώδης διαφορὰ γίνεται ἐπὶ ψιμυθίου·", "seq": 4770}
{"id": "Simplicius_Passim_4771", "series": "CAG", "text": "ἐπὶ δὲ τῶν ἐπιστημῶν πῶς ἔχει;", "seq": 4771}
{"id": "Simplicius_Passim_4772", "series": "CAG", "text": "ἢ καὶ ἡ γραμματική, ἥτις εἴη ψυχῆς ἣ φύσει τοιαύτη, γένοιτο ἂν εἰδοποιὸς διαφορά.", "seq": 4772}
{"id": "Simplicius_Passim_4773", "series": "CAG", "text": "καὶ τοῦτο δὲ προσθετέον, ὅτι ταῖς ποιότησι συντακτέον τοὺς κατ᾿ αὐτὰς ποιούς, καθ᾿ ὅσον περὶ αὐτούς εἰσιν αἱ ποιότητες, μὴ προσποιουμένους τὸ ὑποκείμενον μηδὲ κατὰ σύλληψιν τοῦ ὑποκειμένου ποιοῦντας τὸ ποιόν, ἵνα μὴ κατηγορίαι δύο νοῶνται, ἀλλ᾿ εἰς τοῦτο ἀνιόντας ἀπ᾿ αὐτῶν, ἀφ᾿ οὗ λέγονται.", "seq": 4773}
{"id": "Simplicius_Passim_4774", "series": "CAG", "text": "οὐδὲν δὲ χεῖρον ὑπομνῆσαι πάλιν, ὅτι αἱ νοηταὶ ποιότητες καὶ αἱ αἰσθηταὶ οὐδαμῶς ὑπὸ τὸ αὐτὸ γένος ταχθήσονται·", "seq": 4774}
{"id": "Simplicius_Passim_4775", "series": "CAG", "text": "οὐδὲ γὰρ αἱ κατηγορίαι περὶ τῶν νοητῶν εἰσιν, ἀλλὰ περὶ τῶν λεγομένων, οὐδὲ δυνατὸν τῶν ὄντως ὄντων καὶ τῶν ἐν γενέσει καὶ φθορᾷ φερομένων ὡς ἰσοστοίχων ἓν εἶναι γένος ποιότητος.", "seq": 4775}
{"id": "Simplicius_Passim_4776", "series": "CAG", "text": "ἀλλ᾿ ἐπεὶ περὶ πάντων τῶν τῆς ποιότητος εἰδῶν εἴρηται τὰ αὐτάρκη, καιρὸς ἂν εἴη λοιπὸν καὶ τὰ ἴδια τῆς ποιότητος ἐπισκέψασθαι ἤτοι τὰ ὑπάρχοντα αὐτῇ.", "seq": 4776}
{"id": "Simplicius_Passim_4777", "series": "CAG", "text": "10b12 Ὑπάρχει δὲ καὶ ἐναντιότης κατὰ τὸ ποιόν ἕως τοῦ ὡσαύτως δὲ καὶ ἐπὶ τῶν ἄλλων τῶν κατὰ τὸ ποιὸν ἐναντίων.", "seq": 4777}
{"id": "Simplicius_Passim_4778", "series": "CAG", "text": "Ὥσπερ ἐπὶ τῶν ἄλλων κατηγοριῶν μετὰ τὴν διαίρεσιν ἐπῆγεν τὰ ὑπάρχοντα ἑκάστῃ, τά τε κοινὰ πρὸς ἄλλας καὶ τὰ ἴδια, οὕτως καὶ ἐνταῦθα.", "seq": 4778}
{"id": "Simplicius_Passim_4779", "series": "CAG", "text": "καὶ πρῶτον τὴν ἐναντιότητα προχειρίζεται ὡς ὑπάρχουσαν τῷ ποιῷ, ὑπάρχει δὲ καὶ ἐναντιότης εἰπὼν καὶ τὸν καί σύνδεσμον προσθείς, διότι καὶ ἄλλα ὑπάρχοντα ἐπάξει, ὥσπερ τὸ μᾶλλον καὶ τὸ ἧττον καὶ τὸ ὅμοιον.", "seq": 4779}
{"id": "Simplicius_Passim_4780", "series": "CAG", "text": "κατὰ τὸ ποιὸν δὲ εἶπεν ἀντὶ τοῦ κατὰ τὴν ποιότητα·", "seq": 4780}
{"id": "Simplicius_Passim_4781", "series": "CAG", "text": "δηλοῖ δὲ τὰ ἐπαχθέντα ὑποδείγματα, οἷον δικαιοσύνη ἀδικίᾳ ἐναντίον·", "seq": 4781}
{"id": "Simplicius_Passim_4782", "series": "CAG", "text": "ποιότητες γὰρ αὗται καὶ οὐχὶ ποιά.", "seq": 4782}
{"id": "Simplicius_Passim_4783", "series": "CAG", "text": "ἴσως δὲ διὰ τοῦτο τὸ ποιὸν ἀντὶ τῆς ποιότητος εἶπεν, ὅτι συνείληπται ἐν τῷ ποιῷ καὶ ἡ ποιότης, καὶ τοῦ ποιοῦ ἐπιδεχομένου πάντως καὶ ἡ ποιότης ἐπιδέχεται, ἐπειδὴ κατὰ τὴν ποιότητα καὶ τὸ ποιὸν ἐπιδέχεται.", "seq": 4783}
{"id": "Simplicius_Passim_4784", "series": "CAG", "text": "κατασκευάζει δὲ ἐκ τῆς ἐπαγωγῆς, τῶν τε ψυχικῶν καὶ τῶν σωματικῶν ποιοτήτων παραδείγματα προσθείς.", "seq": 4784}
{"id": "Simplicius_Passim_4785", "series": "CAG", "text": "οὐ μόνον δὲ ταῖς ποιότησιν ὑπάρχειν τὴν ἐναντιότητά φησιν, ἀλλὰ καὶ τοῖς κατ᾿ ἐκείνας τὰς ποιότητας ποιοῖς λεγομένοις.", "seq": 4785}
{"id": "Simplicius_Passim_4786", "series": "CAG", "text": "οὔτε δὲ πάσῃ τῇ ποιότητι ὑπάρχει ἡ ἐναντίωσις·", "seq": 4786}
{"id": "Simplicius_Passim_4787", "series": "CAG", "text": "οὔτε γὰρ τοῖς κατὰ τὸ σχῆμα ποιοῖς, οἷον τῷ τριγώνῳ καὶ τετραγώνῳ, οὔτε τοῖς μέσοις χρώμασιν, οἷον πυρρῷ ἢ ὠχρῷ, δῆλον δὲ ὅτι οὐδὲ ταῖς κατὰ τὰς ἄλλας αἰσθήσεις [ἐν] μεσότησιν, οἷον χλιαρῷ ἢ τῇ τῆς μέσης χορδῆς ἀπηχήσει·", "seq": 4787}
{"id": "Simplicius_Passim_4788", "series": "CAG", "text": "καὶ τοῦτο εἰκότως, εἴπερ ἐναντία ἐστὶν τὰ πλεῖστον ἀλλήλων διεστηκότα.", "seq": 4788}
{"id": "Simplicius_Passim_4789", "series": "CAG", "text": "ἀλλὰ μὴν οὐδὲ μόνῃ τῇ ποιότητι ὑπάρχει ἡ ἐναντίωσις·", "seq": 4789}
{"id": "Simplicius_Passim_4790", "series": "CAG", "text": "καὶ γὰρ τοῖς πρός τι πρόσεστιν, ὡς μεμαθήκαμεν·", "seq": 4790}
{"id": "Simplicius_Passim_4791", "series": "CAG", "text": "ὥστε οὐκ ἔστιν ἴδιον τῆς ποιότητος τοῦτο.", "seq": 4791}
{"id": "Simplicius_Passim_4792", "series": "CAG", "text": "ἐπάγει δὲ τούτοις θεώρημά τι πρὸς πάσας χρήσιμον τὰς κατηγορίας, ἐν αἷς θεωρεῖται ἐναντίωσις.", "seq": 4792}
{"id": "Simplicius_Passim_4793", "series": "CAG", "text": "ἐὰν γὰρ τῶν ἐναντίων, φησίν, τὸ ἕτερον ποιὸν ὑπάρχῃ, καὶ τὸ ἐναντίον αὐτῷ ποιὸν ἔσται, καὶ καθόλου, ἐὰν τὸ ἕτερον τῶν ἀντιδιαιρουμένων ὡς ἐναντίων ἔν τινι γένει ὑπάρχῃ, καὶ τὸ ἀντιδιαιρούμενον πρὸς αὐτὸ ὡς ἐναντίον ἐν τῷ αὐτῷ γένει ὑπάρξει.", "seq": 4793}
{"id": "Simplicius_Passim_4794", "series": "CAG", "text": "γένοιτο δ᾿ ἄν, φησί, τοῦτο δῆλον, εἰ προχειριζοίμεθα τὰς ἄλλας κατηγορίας, οἰκείως εἰσαγωγικῇ πραγματείᾳ τὰ τοιαῦτα ἐκ τῆς ἐπαγωγῆς πιστούμενοι.", "seq": 4794}
{"id": "Simplicius_Passim_4795", "series": "CAG", "text": "γένοιτο δ᾿ ἂν καὶ ἄλλως δῆλον ἀπὸ τοῦ τῶν ἐναντίων ὅρου·", "seq": 4795}
{"id": "Simplicius_Passim_4796", "series": "CAG", "text": "εἰ γὰρ ἐναντία ἐστὶν τὰ ὑπὸ τὸ αὐτὸ γένος πλεῖστον ἀλλήλων διεστηκότα, δῆλον ὅτι ὑφ᾿ ὃ τὸ ἕτερον ἀνάγεται γένος, ὑπὸ τοῦτο καὶ τὸ λοιπόν.", "seq": 4796}
{"id": "Simplicius_Passim_4797", "series": "CAG", "text": "ἀλλ᾿ αὐτὸς μήπω τοῦ τῶν ἐναντίων ὅρου ἀποδοθέντος εἰκότως οὐκ ἐδοκίμασεν αὐτῷ χρήσασθαι.", "seq": 4797}
{"id": "Simplicius_Passim_4798", "series": "CAG", "text": "ἐὰν οὖν ζητῶμεν ὅτι ** τῶν κατηγοριῶν, ἐν αἷς ἐστιν ἐναντίωσις, ἐμάθομεν ἐντεῦθεν, ὅπως δεῖ μεθοδεύειν τὴν εὕρεσιν.", "seq": 4798}
{"id": "Simplicius_Passim_4799", "series": "CAG", "text": "ληψόμεθα γὰρ τὸ ἐναντίον τοῦ ζητουμένου, εἴπερ εἴη γνωριμώτερον, καὶ ἐὰν γνωσθῇ ἐν ποίᾳ ἐστὶν ἐκεῖνο κατηγορίᾳ, εἰσόμεθα ὅτι καὶ τὸ οὗ ἐστιν ἐναντίον ἐν τῇ αὐτῇ κατηγορίᾳ τακτέον, οἷον εἰ τὴν ἀδικίαν ζητῶμεν ἐν ποίῳ ἐστὶν γένει, ληπτέον τὴν δικαιοσύνην·", "seq": 4799}
{"id": "Simplicius_Passim_4800", "series": "CAG", "text": "ἔστιν δὲ αὕτη ποιότης, καὶ ἡ ἀδικία ἄρα ποιότης·", "seq": 4800}
{"id": "Simplicius_Passim_4801", "series": "CAG", "text": "καὶ εἰ ἡ τυφλότης ὁράσει ἐναντίον, ἡ δὲ ὅρασις ποιότης, καὶ ἡ τυφλότης ἔσται ποιότης·", "seq": 4801}
{"id": "Simplicius_Passim_4802", "series": "CAG", "text": "οὐδεμιᾷ γὰρ τῶν ἄλλων κατηγοριῶν ἐφαρμόσει.", "seq": 4802}
{"id": "Simplicius_Passim_4803", "series": "CAG", "text": "Ἀλλὰ διὰ τί εἶπεν εἰ ἔστιν ἡ δικαιοσύνη τῇ ἀδικίᾳ ἐναντίον;", "seq": 4803}
{"id": "Simplicius_Passim_4804", "series": "CAG", "text": "διὰ τί γὰρ τὸ εἰ τὸ ὑποθετικόν;", "seq": 4804}
{"id": "Simplicius_Passim_4805", "series": "CAG", "text": "ἢ ὅτι τινὲς οὐ συνεχώρουν τῇ δικαιοσύνῃ ἐναντίον εἶναι τὴν ἀδικίαν, ἀλλὰ τὴν μὲν ἐναντίαν ἕξιν ἀνώνυμον ἔλεγον, τὴν δὲ ἀδικίαν στέρησιν, τὰς γὰρ ἕξεις καταφατικῶς δεῖν προσαγορεύειν καὶ τὰς στερήσεις ἀρνητικῶς, οὐ καλῶς τοῦτο λέγοντες·", "seq": 4805}
{"id": "Simplicius_Passim_4806", "series": "CAG", "text": "καὶ γὰρ ἕξεις ἀποφατικῶς προσαγορεύομεν, ὡς τὴν τῇ σωφροσύνῃ ἀντικειμένην ἀκολασίαν, καὶ στερήσεις καταφατικῶς, ὡς τὴν τυφλότητα καὶ χωλότητα.", "seq": 4806}
{"id": "Simplicius_Passim_4807", "series": "CAG", "text": "καὶ τοῦτο μὲν ἀληθές, μήποτε δὲ διὰ τοῦτο εἶπεν ὁ Ἀριστοτέλης εἰ ἔστιν ἡ δικαιοσύνη τῇ ἀδικίᾳ ἐναντίον, ὅτι οὔπω τίνα ἐστὶν τὰ ἐναντία παραδέδωκεν, καὶ ὅτι κατ᾿ ἀλήθειαν οὐχ ὡς ἐναντία ταῦτα ἀντίκειται, ἀλλ᾿ ὡς ἕξις καὶ στέρησις.", "seq": 4807}
{"id": "Simplicius_Passim_4808", "series": "CAG", "text": "διὸ καὶ ἀκριβέστερον εἶπεν Ἀρχύτας οὐ μόνον ἐναντίωσιν εἰπὼν ὑπάρχειν τῇ ποιότητι, ἀλλὰ καὶ στέρησιν, γράφων οὕτως·", "seq": 4808}
{"id": "Simplicius_Passim_4809", "series": "CAG", "text": "“καὶ τᾷ ποιότητι δὲ κοινά τινα συνήρτηται, οἷον τό τε ἐναντιότατά τινα ἐπιδέχεσθαι καὶ στέρησιν”.", "seq": 4809}
{"id": "Simplicius_Passim_4810", "series": "CAG", "text": "Ἀποροῦσι δέ τινες πρὸς τὸ ἀπὸ τῶν ἐναντίων θεώρημα οὕτως.", "seq": 4810}
{"id": "Simplicius_Passim_4811", "series": "CAG", "text": "“εἰ γὰρ τοῦτο, φησίν, ὑγιές ἐστιν, ἔσται καὶ ἡ στέρησις ἡ τῷ εἴδει ἐναντία οὐσία·", "seq": 4811}
{"id": "Simplicius_Passim_4812", "series": "CAG", "text": "οὐσία γὰρ καὶ τὸ εἶδος.", "seq": 4812}
{"id": "Simplicius_Passim_4813", "series": "CAG", "text": "εἰ δέ τις λέγοι ὅτι κοινότερον ἡ στέρησις ἐναντία λέγεται τῷ εἴδει, ψεῦδος ἐρεῖ·", "seq": 4813}
{"id": "Simplicius_Passim_4814", "series": "CAG", "text": "εἰ γὰρ εἶδος καὶ στέρησις αἱ ἀρχαὶ τῶν φυσικῶν, ἐναντία λέγονται, καὶ ἐξ ἐναντίων ἡ γένεσις·", "seq": 4814}
{"id": "Simplicius_Passim_4815", "series": "CAG", "text": "εἰ δὲ ἐναντία ταῦτα, οὐκέτι ἔσονται δύο ἀρχαί, ἀλλ᾿ ἓν τὸ κοινὸν αὐτῶν γένος, ἀφ᾿ οὗπερ καὶ αἱ δύο ὑφίστανται”.", "seq": 4815}
{"id": "Simplicius_Passim_4816", "series": "CAG", "text": "ἀλλὰ τοῦτο μὲν λύειν ῥᾴδιον·", "seq": 4816}
{"id": "Simplicius_Passim_4817", "series": "CAG", "text": "οὐ γὰρ πρῶται αὗται ἀρχαί, ἀλλὰ τῶν φυσικῶν ἀρχαί, καὶ οὐδὲν θαυμαστόν, εἴ τι κοινὸν εἴη τούτων αἴτιον, εἴτε φύσις εἴτε τὸ εἶδος, τῇ παρουσίᾳ τῇ ἑαυτοῦ καὶ τῇ ἀπουσίᾳ ἑκάτερον τούτων ἀπεργαζόμενον.", "seq": 4817}
{"id": "Simplicius_Passim_4818", "series": "CAG", "text": "πρὸς δὲ τὸ πρῶτον δυνατὸν μὲν λέγειν ὅτι τῆς ὕλης καὶ τοῦ εἴδους ὄντων ὑπὸ τὴν οὐσίαν, ἐπεὶ μετὰ τῆς ὕλης συνείληπται, ἔσται οὕτως καὶ αὐτὴ διὰ τὸ εἶδος καὶ τὴν ὕλην ἐν τῇ οὐσίᾳ·", "seq": 4818}
{"id": "Simplicius_Passim_4819", "series": "CAG", "text": "εἰ δέ τις ἐν τῷ εἴδει περιέχεσθαι λέγοι τὴν στέρησιν κατὰ τὴν ἀπουσίαν αὐτοῦ, ἔσται καὶ οὕτως ἐν τῇ οὐσίᾳ περιειλημμένη.", "seq": 4819}
{"id": "Simplicius_Passim_4820", "series": "CAG", "text": "ῥητέον δὲ μᾶλλον, ὅτι ὁ κανὼν οὐκ ἐπὶ πάντων εἴληπται τῶν ἐναντίων, ἀλλ᾿ ἐφ᾿ ὧν προδήλως τὸ ἕτερον ὑπό τι γένος ἐστίν, ὑπὸ τὸ αὐτὸ καὶ θάτερον ἀνάγκη εἶναι.", "seq": 4820}
{"id": "Simplicius_Passim_4821", "series": "CAG", "text": "τοιγαροῦν καὶ ὁ Ἀριστοτέλης οὐκ εἶπεν ὅτι τὰ ἐναντία ὑπὸ τὸ αὐτὸ γένος ἐστίν, ἀλλ᾿ ὅτι τῶν ἐναντίων ἐὰν τὸ ἕτερον ὑπό τι γένος ᾖ, καὶ τὸ ἕτερον ὑπὸ τὸ αὐτὸ γένος ἔσται.", "seq": 4821}
{"id": "Simplicius_Passim_4822", "series": "CAG", "text": "καίτοι ἐν τοῖς ἑξῆς, ἐν οἷς τὰ εἴδη διαιρεῖται τῆς ἀντιθέσεως, τὰ κυρίως ἐναντία ὑπὸ τὸ αὐτὸ γένος εἶναι βούλεται·", "seq": 4822}
{"id": "Simplicius_Passim_4823", "series": "CAG", "text": "καὶ γὰρ τὰ ἐν τοῖς ἐναντίοις δοκοῦντα γένεσιν εἶναι κοινόν τι ἐπαναβεβηκὸς ἔχει γένος, ὡς ἡ δικαιοσύνη καὶ ἀδικία.", "seq": 4823}
{"id": "Simplicius_Passim_4824", "series": "CAG", "text": "διὸ καὶ αὐτὸς οὐ τὰ προσεχῆ, ἀλλὰ τὰ πόρρω γένη ἔλαβεν·", "seq": 4824}
{"id": "Simplicius_Passim_4825", "series": "CAG", "text": "οὐ γὰρ εἶπεν, ἐὰν θάτερον ὑπ᾿ ἀρετὴν ἢ ἕξιν ᾖ τῶν ἐναντίων, ὅτι καὶ τὸ ἕτερον, ἀλλ᾿ ἐὰν θάτερον ᾖ ποιόν, καὶ θάτερον.", "seq": 4825}
{"id": "Simplicius_Passim_4826", "series": "CAG", "text": "τί οὖν εἴ τινες τὰ πρῶτα γένη ἐναντία τίθενται, ὡς τὸ ταὐτὸν καὶ θάτερον, ἢ τὰς δύο συστοιχίας, ὡς οἱ Πυθαγόρειοι;", "seq": 4826}
{"id": "Simplicius_Passim_4827", "series": "CAG", "text": "ἢ οὐδὲ ἐκεῖνα πρῶτα·", "seq": 4827}
{"id": "Simplicius_Passim_4828", "series": "CAG", "text": "οὐ γὰρ δυνατὸν οὐδὲ τοῖς Πυθαγορείοις ἀρέσκον τὸ πολλὰ εἶναι τὰ πρῶτα.", "seq": 4828}
{"id": "Simplicius_Passim_4829", "series": "CAG", "text": "Ἀλλὰ διὰ τί αἱ πλεῖσται ἐναντιώσεις κατὰ τὸ ποιὸν μάλιστα θεωροῦνται;", "seq": 4829}
{"id": "Simplicius_Passim_4830", "series": "CAG", "text": "ἢ γὰρ ἐν χρώμασίν εἰσιν τἀναντία, ὡς λευκὸν μέλαν, ἢ ἐν χυμοῖς, ὡς γλυκὺ πικρόν, ἢ ἐν ἁπτοῖς, ὡς θερμὸν ψυχρόν, μαλακὸν σκληρόν, ἢ ἐν ψόφοις, ὡς ὀξὺ βαρύ, καὶ περὶ σῶμα, ὡς νόσος ὑγίεια, κάλλος αἶσχος, καὶ περὶ ψυχήν, ὡς ἀρετὴ καὶ κακία, καὶ ἄλλαι πολλαὶ τοιαῦται.", "seq": 4830}
{"id": "Simplicius_Passim_4831", "series": "CAG", "text": "καὶ αὐτὸ δὲ τοῦτο ζητήσεως ἄξιον, διὰ τί τῇ ποιότητι ὅλως ὑπάρχει τἀναντία, περὶ οὐσίαν μὴ θεωρούμενα.", "seq": 4831}
{"id": "Simplicius_Passim_4832", "series": "CAG", "text": "καὶ ῥητέον οἶμαι ὅτι τἀναντία συνυπάρχειν ἀλλήλοις ἀδυνατεῖ·", "seq": 4832}
{"id": "Simplicius_Passim_4833", "series": "CAG", "text": "γίνεσθαι οὖν αὐτὰ καὶ ἀπογίνεσθαι ἀνάγκη, καὶ διὰ τοῦτο ἐν μὲν τῇ οὐσίᾳ οὐδαμῶς θεωρεῖται, ἐν δὲ τῇ ποιότητι μάλιστα ὡς ἐπεισοδιώδει.", "seq": 4833}
{"id": "Simplicius_Passim_4834", "series": "CAG", "text": "καὶ γὰρ ** ὅπου μὲν ἔστιν, ὡς περιττὸν καὶ ἄρτιον, ὅπου δὲ οὐκ ἔστιν, ὡς ἐν τῷ ὡρισμένῳ ποσῷ.", "seq": 4834}
{"id": "Simplicius_Passim_4835", "series": "CAG", "text": "ἐν μέντοι τῇ ποιότητι, ἐπειδὴ τῶν ἐπισυνισταμένων ἐστὶ καὶ ἐπ᾿ ἄλλοις καὶ ἄλλοις ἐπιγινομένων, εἰκότως ἡ ἐναντίωσις ἐγγίνεται·", "seq": 4835}
{"id": "Simplicius_Passim_4836", "series": "CAG", "text": "τὰ γὰρ ἐναντία ἐπ᾿ ἄλλοις καὶ περὶ ἄλλα *** ὑποστάσει τῶν ποιῶν καὶ τὰ ἐναντία πέφυκεν μετ᾿ αὐτῶν συνυφίστασθαι.", "seq": 4836}
{"id": "Simplicius_Passim_4837", "series": "CAG", "text": "καὶ ἄλλως δέ, ἐπειδὴ <ἡ> πρώτη διαφορὰ κατὰ τὰς ποιότητάς ἐστιν, καὶ ἡ μεγίστη διαφορὰ κατ᾿ αὐτὰς ἔσται, ἥτις ἐστὶν ἐναντίωσις·", "seq": 4837}
{"id": "Simplicius_Passim_4838", "series": "CAG", "text": "καὶ ἐπεὶ ἡ πρώτη τομὴ κατὰ τὰς ποιότητας ἐγγίνεται, πορρωτέρω προϊοῦσα αὕτη τὰ ἐναντία παράγει.", "seq": 4838}
{"id": "Simplicius_Passim_4839", "series": "CAG", "text": "πλεῖσται δὲ ἐναντιώσεις εἰσὶν ἐν τῷ ποιῷ, διότι πολυειδεῖς εἰσιν αἱ ποιότητες.", "seq": 4839}
{"id": "Simplicius_Passim_4840", "series": "CAG", "text": "δεῖ δὲ καὶ τὰς ἐναντιώσεις ἀνευρίσκειν προσφόρως, ἐφ᾿ ἑκάστων χρωμένους ταῖς οἰκείαις δυνάμεσιν.", "seq": 4840}
{"id": "Simplicius_Passim_4841", "series": "CAG", "text": "ἐπὶ μὲν οὖν τῶν σωμάτων, διότι αἰσθηταί εἰσιν αἱ ἐναντιώσεις, αἰσθήσει θηρευτέον αὐτάς·", "seq": 4841}
{"id": "Simplicius_Passim_4842", "series": "CAG", "text": "τὰς δὲ τῆς ψυχῆς λογισμῷ θηρευτέον, διότι τούτῳ περιληπταί εἰσιν.", "seq": 4842}
{"id": "Simplicius_Passim_4843", "series": "CAG", "text": "εἰκότως δὲ τοῦτο τὸ περὶ τῶν ἐναντίων θεώρημα τῷ περὶ τῆς ποιότητος συνέζευξε λόγῳ, διότι, ὡς εἴρηται, πρὸς ποιότητα μάλιστα συγγενῶς ἔχει τὸ ἐναντίον·", "seq": 4843}
{"id": "Simplicius_Passim_4844", "series": "CAG", "text": "καὶ γὰρ ἐν ταῖς ἄλλαις κατηγορίαις ἐναντία κατὰ τὸ ἐν ἑκάστῃ ποιὸν ἐγγίνεσθαι δοκεῖ.", "seq": 4844}
{"id": "Simplicius_Passim_4845", "series": "CAG", "text": "δεῖ δὲ τὰ ἐναντία λαμβάνειν οὐ μετὰ τοῦ ὑποκειμένου (κοινὸν γάρ ἐστιν αὐτοῖς τὸ ὑποκείμενον, καὶ οὐκέτι ὅλα ὅλοις ἀντικείμενα ληφθήσεται οὐδὲ ὄντως ἔσται ἐναντία), ἀλλὰ μόνον, καθὸ ποιόν ἐστιν ἑκάτερον, κατὰ τοῦτο δεῖ θεωρεῖν αὐτὰ ὡς ἐναντία·", "seq": 4845}
{"id": "Simplicius_Passim_4846", "series": "CAG", "text": "ἔστιν δὲ ποιὰ κατὰ τὸ ἔχειν ποιότητα, ὥστε κατὰ τὴν ποιότητα αὐτοῖς ἡ ἐναντίωσις.", "seq": 4846}
{"id": "Simplicius_Passim_4847", "series": "CAG", "text": "Ἀλλὰ διὰ τί τὰ μεταξὺ οὔτε ἀλλήλοις ἐστὶν ἐναντία οὔτε τοῖς ἄκροις;", "seq": 4847}
