{"id": "Simplicius_Passim_3400", "series": "CAG", "text": "ἀπορίαν οὖν ἔχειν εἰκότως φησίν, πῶς τινες οὐσίαι δοκοῦσιν τῶν πρός τι·", "seq": 3400}
{"id": "Simplicius_Passim_3401", "series": "CAG", "text": "ἡ γὰρ χεὶρ οὐσία οὖσα τινὸς λέγεται χεὶρ καὶ ὁ ποὺς τινὸς λέγεται πούς, τὰ δὲ τινὸς λεγόμενα τῶν πρός τι ἐδόκει.", "seq": 3401}
{"id": "Simplicius_Passim_3402", "series": "CAG", "text": "ἀνάγκη οὖν ἢ τὰ μέρη τῶν οὐσιῶν μὴ λέγειν οὐσίας, ὅπερ ἄτοπον, τὸ ἐκ μὴ οὐσίας εἶναι τὴν οὐσίαν, καὶ μέντοι καὶ τοῖς προειρημένοις ἐστὶν ὑπεναντίον (αὐτὸς γὰρ εἶπεν ὅτι τὰ μέρη τῶν οὐσιῶν οὐσίαι), ἢ τὸν ἀποδιδόμενον τῶν πρός τι λόγον ἐπανορθῶσαι τὸν ὅσα ἑτέρων εἶναι λέγεται, ταῦτα εἰπόντα πρός τι·", "seq": 3402}
{"id": "Simplicius_Passim_3403", "series": "CAG", "text": "καὶ γὰρ ἡ χεὶρ τοῦ χειρωτοῦ λέγεται καὶ ἡ κεφαλὴ τοῦ κεφαλωτοῦ.", "seq": 3403}
{"id": "Simplicius_Passim_3404", "series": "CAG", "text": "αὐτὸς δὲ καθολικώτερον ποιῶν τὸν λόγον περὶ πάσης οὐσίας ζητεῖ, εἰ ἔστιν τῶν πρός τι, τῆς τε πρώτης καὶ τῆς δευτέρας καὶ τῶν ἐν ταύταις μερῶν.", "seq": 3404}
{"id": "Simplicius_Passim_3405", "series": "CAG", "text": "καὶ τὴν μὲν πρώτην καὶ ἄτομον οὐσίαν καὶ τὰ ταύτης μέρη ἐναργῶς φησιν μὴ λέγεσθαι τῶν πρός τι κατὰ τὸν ὁρισμόν.", "seq": 3405}
{"id": "Simplicius_Passim_3406", "series": "CAG", "text": "ὁ γὰρ ἄτομος ἄνθρωπος οὐ λέγεται τινός τις ἄνθρωπος·", "seq": 3406}
{"id": "Simplicius_Passim_3407", "series": "CAG", "text": "εἰ δὲ ἦν πρός τι, οὕτως ἂν ἐλέγετο, ὥσπερ τὸ δεξιὸν ἀριστεροῦ δεξιόν·", "seq": 3407}
{"id": "Simplicius_Passim_3408", "series": "CAG", "text": "εἰ οὖν τὸ ἑτέρου λέγεσθαι αὐτὸ τοῦτο ὅπερ ἐστίν, τοῦτό ἐστιν τὸ πρός τι, καὶ ὁ τὶς ἄνθρωπος τινός τις ἄνθρωπος ἂν λέγοιτο·", "seq": 3408}
{"id": "Simplicius_Passim_3409", "series": "CAG", "text": "εἰ δὲ μὴ λέγεται οὕτως, οὐκ ἔστιν τῶν πρός τι.", "seq": 3409}
{"id": "Simplicius_Passim_3410", "series": "CAG", "text": "ὁμοίως δὲ καὶ τὸ ἄτομον μέρος·", "seq": 3410}
{"id": "Simplicius_Passim_3411", "series": "CAG", "text": "οὐδὲ γὰρ ἡ τὶς χεὶρ τινός τις χεὶρ λέγεται, ἔδει δὲ εἴπερ ἦν πρός τι, διότι τὰ ἄτομα ταύτῃ διαφέρει τῶν κοινῶν ἐν τῇ κατηγορίᾳ, καθ᾿ ὅσον προστίθεται αὐτοῖς τὸ τὶ τὸ ἓν ἀριθμῷ·", "seq": 3411}
{"id": "Simplicius_Passim_3412", "series": "CAG", "text": "ὅταν οὖν περὶ τῆς ἀτόμου οὐσίας κατηγορῶμεν, ‘τὶς ἄνθρωπος’ λέγομεν, καὶ ἡ κατηγορία γίνεται ‘τινός τις ἄνθρωπος’ ἐπὶ δὲ τῶν δευτέρων οὐσιῶν ἐπὶ μὲν τῶν ὅλων πάλιν διαφαίνεται τὸ μὴ εἶναι πρός τι·", "seq": 3412}
{"id": "Simplicius_Passim_3413", "series": "CAG", "text": "ὁ γὰρ ἄνθρωπος οὐ λέγεται τινὸς ἄνθρωπος οὐδὲ ὁ βοῦς τινὸς βοῦς οὐδὲ τὸ ξύλον τινὸς ξύλον·", "seq": 3413}
{"id": "Simplicius_Passim_3414", "series": "CAG", "text": "οὐσίαν γὰρ ἔχουσιν καθ᾿ αὑτά.", "seq": 3414}
{"id": "Simplicius_Passim_3415", "series": "CAG", "text": "εἰ μέντοι τὸν ἄνθρωπον ἢ τὸν βοῦν τινὸς λέγοιμεν ὡς κτῆμα ὥσπερ τὸν ἀγρόν, οὐ καθὸ εἰσὶν ἀποδίδομεν, ἀλλὰ καθὸ συμβέβηκεν αὐτοῖς κτήμασιν εἶναι.", "seq": 3415}
{"id": "Simplicius_Passim_3416", "series": "CAG", "text": "ἀλλ᾿ ἐπιστάσεως ἄξιον, διὰ τί τοῦτο οὐκ εἶπεν καὶ ἐπὶ τῆς ἀτόμου οὐσίας τῆς ὅλης·", "seq": 3416}
{"id": "Simplicius_Passim_3417", "series": "CAG", "text": "καὶ γὰρ ἐπὶ ταύτης δυνατὸν ἦν εἰπεῖν ὅτι ὁ τὶς ἄνθρωπος ἢ οἷον ὁ Δάος τινὸς ἦν ὡς κτῆμα τοῦ οἰκείου δεσπότου.", "seq": 3417}
{"id": "Simplicius_Passim_3418", "series": "CAG", "text": "ἀλλ᾿ ἴσως ἴδιον εὑρὼν ὡς ἄτομον τὸ τινός τις μὴ ἔχον ἀκόλουθον τὴν κατηγορίαν, τούτῳ προσεχρήσατο.", "seq": 3418}
{"id": "Simplicius_Passim_3419", "series": "CAG", "text": "δείξας οὖν ὅτι οὔτε αἱ πρῶται οὐσίαι αἱ ὅλαι οὔτε τὰ μέρη αὐτῶν πρός τι λέγεται, ἀλλ᾿ οὔτε αἱ δεύτεραι οὐσίαι αἱ ὅλαι, ἐπ᾿ ἐνίων, φησί, τῶν δευτέρων οὐσιῶν, τουτέστιν ἐπὶ τῶν μερῶν ἔχει ἀμφισβήτησιν.", "seq": 3419}
{"id": "Simplicius_Passim_3420", "series": "CAG", "text": "ὡς γὰρ τοῦ τινὸς ἀνθρώπου ἐστὶν μέρος ἡ τὶς κεφαλή, οὕτως καὶ τοῦ ἀνθρώπου τοῦ ἁπλῶς ἡ ἁπλῶς κεφαλή.", "seq": 3420}
{"id": "Simplicius_Passim_3421", "series": "CAG", "text": "ἀλλὰ τὰ μὲν ἄτομα μέρη ἀπέδειξεν μὴ ὄντα πρός τι διὰ τὸ μὴ λέγεσθαι τινός τις κεφαλή, ἐπὶ δὲ τῶν κοινῶν ἐνδέδωκεν ὅτι ταῦτα διὰ τὸ ἕκαστον αὐτῶν ὅπερ ἐστὶν ἑτέρου λέγεσθαι (μέρη γὰρ ὄντα τῶν ὅλων ἐστίν) δοκεῖ πρός τι εἶναι·", "seq": 3421}
{"id": "Simplicius_Passim_3422", "series": "CAG", "text": "οὐ γὰρ ἦν ἐπὶ τούτων εἰπεῖν, ὅπερ ἐπὶ τῶν ἀτόμων οὐσιῶν ἐκώλυεν εἶναι πρός τι ἐκείνας.", "seq": 3422}
{"id": "Simplicius_Passim_3423", "series": "CAG", "text": "Ταῦτα οὖν εἰπὼν συνορᾷ ὅτι διορθώσεως δεῖταί τινος ὁ ἀποδοθεὶς τῶν πρός τι ὁρισμὸς πρὸς τὸ λυθῆναι τὸ ἄπορον·", "seq": 3423}
{"id": "Simplicius_Passim_3424", "series": "CAG", "text": "εἰ γὰρ ἱκανῶς, φησίν, ἀποδέδοται, ἢ τῶν χαλεπῶν ἢ τῶν ἀδυνάτων ἐστὶν τὸ δεῖξαι ὡς οὐδεμία οὐσία τῶν πρός τί ἐστιν·", "seq": 3424}
{"id": "Simplicius_Passim_3425", "series": "CAG", "text": "τὰ γὰρ μέρη τῶν δευτέρων οὐσιῶν τινὸς λέγονται τοῦ ὅλου, καὶ διὰ τοῦτο τῷ ἀποδοθέντι ὁρισμῷ τῶν πρός τι ὑποπίπτουσιν.", "seq": 3425}
{"id": "Simplicius_Passim_3426", "series": "CAG", "text": "διὰ τοῦτο οὖν, ἵνα μὴ εὑρεθῇ τις οὐσία τῶν πρός τι οὖσα, ἕτερον ὁρισμὸν αὐτῶν ἀποδίδωσιν τὸν λέγοντα ὅτι ἔστιν τὰ πρός τι οἷς τὸ εἶναι ταὐτόν ἐστιν τῷ πρός τί πως ἔχειν, οὐκέτι τὸ λέγεσθαι πρὸς ἕτερον, ἀλλὰ τὸ εἶναι τοῖς πρός τι ἀποδούς.", "seq": 3426}
{"id": "Simplicius_Passim_3427", "series": "CAG", "text": "καὶ γὰρ τὸ μὲν λέγεσθαι τὴν οὐσίαν αὐτῶν οὐ δηλοῖ, τὸ δὲ εἶναι πρὸς ἕτερον αὐτὴν τὴν οὐσίαν παρίστησιν, καὶ τὸ μὲν λέγεσθαι καὶ ἄλλοις συμβέβηκεν ὥσπερ τοῖς μέρεσιν, τὸ δὲ εἶναι τοῖς πρός τι μόνοις, διὸ ἡ κεφαλὴ λέγεται μὲν τινός, ἐπειδὴ δὲ οὐκ ἔστιν τὸ εἶναι αὐτῆς ἐν τῇ σχέσει τοῦ πρὸς ὃ λέγεται (ἔστιν γὰρ κεφαλὴ ὡς ὑποκείμενόν τι πρᾶγμα καὶ ἔστιν λόγον αὐτῆς ἀποδοῦναι καθ᾿ ἑαυτήν, οὐδὲν δὲ πρός τι καθὸ πρός τι ὑπόκειται καθ᾿ ἑαυτό), οὐκ ἂν εἴη τῶν πρός τι ἡ κεφαλή·", "seq": 3427}
{"id": "Simplicius_Passim_3428", "series": "CAG", "text": "οὖσα γὰρ καθ᾿ ἑαυτὴν οὕτως καὶ ἄλλων λέγεται, ὧν ἐστι μέρος·", "seq": 3428}
{"id": "Simplicius_Passim_3429", "series": "CAG", "text": "τὰ δὲ πρός τι οὐκ ὄντα τι ἄλλο καθ᾿ αὑτὰ ἔπειτα πρός τι λέγεται, ἀλλ᾿ αὐτὸ τὸ εἶναι ἐν τούτῳ ἔχει ἐν τῷ πρὸς ἕτερόν πως ἔχειν.", "seq": 3429}
{"id": "Simplicius_Passim_3430", "series": "CAG", "text": "οὐ γὰρ εἴ τι μετ᾿ ἄλλου ὑφέστηκεν, ἤδη καὶ πρός τί ἐστιν ὡς πρὸς ἐκεῖνο·", "seq": 3430}
{"id": "Simplicius_Passim_3431", "series": "CAG", "text": "καὶ γὰρ ἡ γραμμὴ μετὰ τοῦ ἐπιπέδου ὑφέστηκεν καὶ οὐκ ἔστιν πρός τι ὡς γραμμὴ πρὸς ἐπίπεδον·", "seq": 3431}
{"id": "Simplicius_Passim_3432", "series": "CAG", "text": "καθὸ δὲ πέρας, πρός τί ἐστιν πρὸς τὸ πεπερατωμένον, καὶ καθὸ δὲ μέρος τι, πρὸς ὅλον.", "seq": 3432}
{"id": "Simplicius_Passim_3433", "series": "CAG", "text": "οὕτως δὲ καὶ ἡ κεφαλὴ ὡς μὲν οὐσία καθ᾿ αὑτὴν οὐκ ἔστιν τῶν πρός τι, ὡς δὲ μέρος πρὸς ὅλον ἔχει τὸ εἶναι·", "seq": 3433}
{"id": "Simplicius_Passim_3434", "series": "CAG", "text": "ὅλου γὰρ μέρος καὶ τὸ ὅλον μερῶν ὅλον.", "seq": 3434}
{"id": "Simplicius_Passim_3435", "series": "CAG", "text": "εἰ μέντοι κατὰ τὸ λέγεσθαι χαρακτηρίζοιτο τὰ πρός τι, καὶ ἡ κεφαλὴ τοῦ κεφαλωτοῦ λέγεται καὶ ἡ χεὶρ τοῦ χειρωτοῦ καὶ τὸ πηδάλιον τοῦ πηδαλιωτοῦ.", "seq": 3435}
{"id": "Simplicius_Passim_3436", "series": "CAG", "text": "ἀλλὰ προσεκτέον ὅτι καθὸ μὲν κεφαλὴ καὶ ὅπερ κεφαλή, οὐχ ἑτέρου, ᾗ δὲ μέρος, ἑτέρου·", "seq": 3436}
{"id": "Simplicius_Passim_3437", "series": "CAG", "text": "κατὰ συμβεβηκὸς οὖν πρός τι, ὥσπερ καὶ οἰκία, καθὸ μὲν οἰκία, καθ᾿ αὑτήν, καθὸ δέ τινος κτῆμα, πρός τι.", "seq": 3437}
{"id": "Simplicius_Passim_3438", "series": "CAG", "text": "ἵνα οὖν μὴ ἐνοχλῇ τὰ κατὰ συμβεβηκὸς πρός τι, ἀποδίδωσιν ἄλλον ὅρον τῶν πρός τι παραιτησάμενος τὸν πρότερον, πρός τι λέγων εἶναι οἷς τὸ εἶναι ταὐτόν ἐστιν τῷ πρός τί πως ἔχειν·", "seq": 3438}
{"id": "Simplicius_Passim_3439", "series": "CAG", "text": "τὸ γοῦν διπλάσιον ὅ ἐστιν, ταὐτόν ἐστιν τῇ σχέσει ἣν ἔχει τὸ ὑποκείμενον, καὶ τὸ ἥμισυ ἀνάπαλιν ταὐτόν ἐστιν τῇ σχέσει τῇ πρὸς τὸ διπλάσιον καὶ οὐδὲν ἕτερον.", "seq": 3439}
{"id": "Simplicius_Passim_3440", "series": "CAG", "text": "ὁ δὲ πρότερος ὁρισμὸς ὁ κατὰ τὸ λέγεσθαι παρηκολούθει μὲν ἅπασιν τοῖς πρός τι ὡς κοινόν τι συμβεβηκὸς καὶ πλεονάζον, οὐ μὴν κατὰ τοῦτο ἦν τὰ πρός τι, ἀλλὰ καθὸ τὰ ὑποκείμενα πλεονάζει τῇ σχέσει.", "seq": 3440}
{"id": "Simplicius_Passim_3441", "series": "CAG", "text": "διὸ ὁ μὲν πρῶτος ὅρος τὸ τί ἐστιν οὐκ ἀποδέδωκεν τῶν πρός τι, ὁ δὲ δεύτερος καὶ τὴν οὐσίαν ἀφωρίσατο, καὶ ἐκεῖνος μὲν οὐκ ἀντιστρέφει πρὸς τὸ ὁριστόν (οὐ γὰρ εἴ τι πρὸς ἕτερον λέγεται, τοῦτο πρός τί ἐστιν), οὗτος δὲ ἀντιστρέφει.", "seq": 3441}
{"id": "Simplicius_Passim_3442", "series": "CAG", "text": "ταῦτα μὲν οὖν τοῖς ἄλλοις ἐξηγηταῖς τοῦ Ἀριστοτέλους δοκεῖ.", "seq": 3442}
{"id": "Simplicius_Passim_3443", "series": "CAG", "text": "Ὁ δὲ κριτικώτατος Συριανὸς “ὅτι μέν, φησίν, οὔτε τὴν πρώτην οὐσίαν οὔτε τὴν δευτέραν πρός τι εἶναι ἀνέχεται, πάνυ κατορθοῖ·", "seq": 3443}
{"id": "Simplicius_Passim_3444", "series": "CAG", "text": "πᾶσα μὲν γὰρ οὐσία καθ᾿ αὑτήν ἐστιν καὶ ἑαυτῆς, ὡς καὶ Ἀρχύτᾳ δοκεῖ, τὰ δὲ πρός τι τῇ πρὸς ἄλληλα σχέσει δέδεται καὶ ἀλλήλων ἐστίν.", "seq": 3444}
{"id": "Simplicius_Passim_3445", "series": "CAG", "text": "ὅτι δὲ παρέπεσθαί φησι τῷ ἀποδοθέντι λόγῳ τῶν πρός τι τὸ τινὰς τῶν δευτέρων οὐσιῶν εἶναι πρός τι, τοῦτο οὐκέτι ὁρῶ πῶς γίνεται.", "seq": 3445}
{"id": "Simplicius_Passim_3446", "series": "CAG", "text": "εἰ μὲν γὰρ ἁπλῶς εἴρητο πρός τι τὰ τινὸς λεγόμενα, ἴσως ἂν ἦν εἰπεῖν ὅτι ἡ χεὶρ τινὸς λεγομένη πρός τί ἐστιν·", "seq": 3446}
{"id": "Simplicius_Passim_3447", "series": "CAG", "text": "ἐπειδὴ δὲ σαφῶς εἴρηται ὅσα αὐτὰ ἅπερ ἐστὶν ἑτέρων εἶναι λέγεται, ἐξετάζειν ἔδει, εἰ ἡ χεὶρ ὡς χεὶρ καὶ καθὸ χεὶρ ἑτέρου λέγεται ἢ ὡς μέρος καὶ οὐχ ᾗ αὐτὸ ὅπερ ἐστίν.", "seq": 3447}
{"id": "Simplicius_Passim_3448", "series": "CAG", "text": "ὥσπερ οὖν ὅταν ὁ βοῦς ἢ τὸ ξύλον τινὸς εἶναι λέγεται, οὐχ ᾗ ἐστιν ἅ ἐστιν, ἀλλ᾿ ᾗ κτήματά ἐστίν τινος, οὕτως οὐδ᾿ ἂν ἡ κεφαλὴ τινὸς λέγηται, ᾗ τοιόνδε εἶδος ἔχει, τινὸς λέγεται εἶναι, ἀλλ᾿ ᾗ μέρος ἐστὶν ζῴου καὶ συμβέβηκεν αὐτῷ ὥσπερ ἄλλα τινὰ οὕτως καὶ ἡ σχέσις τῶν πρός τι, καὶ οὐκ ἀναγκάζεται ἐκ τοῦ ἀποδοθέντος ὁρισμοῦ καὶ τὰ καθ᾿ ἑαυτὸ τοῖς πρός τι συντάττεσθαι.", "seq": 3448}
{"id": "Simplicius_Passim_3449", "series": "CAG", "text": "καὶ γὰρ ὃν αὐτὸς ἀποδίδωσιν οἷς τὸ εἶναι ταὐτόν ἐστι τῷ πρός τί πως ἔχειν, ἰσοδυναμεῖ καὶ κατὰ Πορφύριον τῷ προτέρῳ, ὃς κατὰ τὴν αὐτὴν ἔννοιαν ἀποδέδοται·", "seq": 3449}
{"id": "Simplicius_Passim_3450", "series": "CAG", "text": "οὐδὲ γὰρ τὰ αὐτὰ ἅπερ ἐστὶν ἑτέρων εἶναι λεγόμενα δι᾿ ἄλλο τι ἔχει τοῦτο ἢ διὰ τὸ εἶναι αὐτῶν ταὐτὸν τὸ εἶναι τῷ πρός τί πως ἔχειν”.", "seq": 3450}
{"id": "Simplicius_Passim_3451", "series": "CAG", "text": "ἴσως δὲ ἡ διαφορὰ ἐν τούτῳ ἐστίν, καθ᾿ ὅσον ἐκεῖνος μὲν ἀπὸ τοῦ λέγεσθαι τὸ εἶναι ἐνεδείξατο, ὡς ἀπὸ ἐναργεστέρου, οὗτος δὲ ἀπὸ τοῦ εἶναι καὶ τὸ λέγεσθαι, ὡς ἀπὸ αἰτιωδεστέρου.", "seq": 3451}
{"id": "Simplicius_Passim_3452", "series": "CAG", "text": "Ἐπὶ δὲ τοῖς εἰρημένοις ὁ Ἀριστοτέλης ὥσπερ πόρισμά τι ἀναφαινόμενον παραδίδωσιν ὅτι ἄν τις εἰδῇ τι τῶν πρός τι ὡρισμένως, καὶ τὸ πρὸς ὃ λέγεται ὡρισμένως εἴσεται.", "seq": 3452}
{"id": "Simplicius_Passim_3453", "series": "CAG", "text": "τούτῳ δὲ ἑπόμενον δείκνυσιν τὸ τὴν κεφαλὴν καὶ τὴν χεῖρα μὴ εἶναι τῶν πρός τι·", "seq": 3453}
{"id": "Simplicius_Passim_3454", "series": "CAG", "text": "τοῦ γὰρ τὸ ἄλλο σῶμα ἐγκεκαλυμμένου γινώσκειν μὲν ἔστιν καὶ τὴν κεφαλὴν καὶ τὴν χεῖρα, ὅτου δέ ἐστιν, οὐκ ἔστιν εἰδέναι·", "seq": 3454}
{"id": "Simplicius_Passim_3455", "series": "CAG", "text": "καίτοι γε εἰ ἦν πρός τι, πάντως ἂν ἔγνωμεν, ὥσπερ ἐπὶ τοῦ διπλασίου ὅτι ἡμίσεος.", "seq": 3455}
{"id": "Simplicius_Passim_3456", "series": "CAG", "text": "καὶ ὅτι μὲν ὁ τὸ ἕτερον ὡρισμένως εἰδὼς καὶ τὸ ἕτερον ὡρισμένως οἶδεν, δείκνυσιν ἐκ τοῦ τὸ πρός τι κατὰ τὴν σχέσιν τὴν πρὸς ἕτερον θεωρεῖσθαι καὶ διὰ τοῦτο ἐνυπάρχειν τῇ σχέσει καὶ συμπληροῦν αὐτὴν καὶ τὸ ἕτερον, πρὸς ὃ ἡ σχέσις·", "seq": 3456}
{"id": "Simplicius_Passim_3457", "series": "CAG", "text": "ὁ οὖν εἰδὼς τὸ ἕτερον ὡρισμένως οἶδεν καὶ τὸ λοιπόν, πρὸς ὅ πως εἶχεν τὸ ἕτερον τῶν πρός τι.", "seq": 3457}
{"id": "Simplicius_Passim_3458", "series": "CAG", "text": "μετὰ δὲ τὴν ἀπὸ τῆς ἐννοίας ἔφοδον καὶ ἐκ τῆς ἐπαγωγῆς τὸ αὐτὸ παραδίδωσιν.", "seq": 3458}
{"id": "Simplicius_Passim_3459", "series": "CAG", "text": "ὁ γὰρ εἰδὼς ὅτι τὰ τέσσαρα διπλάσιά ἐστιν ὡρισμένως, οἶδεν καὶ τὰ δύο ὡρισμένως ὧν ἐστι διπλάσια τὰ τέσσαρα καὶ οὐχὶ μόνον τὸν κοινὸν ὃν οἶδεν τοῦ διπλασίου καὶ τοῦ ἡμίσεος λόγον.", "seq": 3459}
{"id": "Simplicius_Passim_3460", "series": "CAG", "text": "καὶ ἐπὶ τοῦ καλλίονος δὲ ὡσαύτως, εἰ οἶδέν τις αὐτὸ ὡς κάλλιον, καὶ ὅτου κάλλιόν ἐστιν οἶδεν.", "seq": 3460}
{"id": "Simplicius_Passim_3461", "series": "CAG", "text": "εἰ δὲ νομίζοι τις τὸ μὲν κάλλιον ἀφωρισμένως εἰδέναι, τὸ δὲ χεῖρον οὗ ἐστιν κάλλιον οὐκ ἀφωρισμένως, οὐδὲν κωλύει τοῦτο ὃ κάλλιον ὑπολαμβάνει, πάντων εἶναι χεῖρον.", "seq": 3461}
{"id": "Simplicius_Passim_3462", "series": "CAG", "text": "ὑπόληψις οὖν, φησίν, τοῦτό ἐστιν, οὐκ ἐπιστήμη, ἐπιστήμῃ χρησάμενος, ἥτις ἐπὶ τῶν καθόλου μόνων κυρίως λέγεται·", "seq": 3462}
{"id": "Simplicius_Passim_3463", "series": "CAG", "text": "καὶ αὐτὸς δὲ δῆλον ἐποίησεν ὅτι τὴν ἀκριβῆ καὶ ἐπὶ τῶν αἰσθητῶν γνῶσιν ἐπιστήμην ἐκάλεσεν, εἰπὼν οὐ γὰρ ἔτι εἴσεται ἀκριβῶς.", "seq": 3463}
{"id": "Simplicius_Passim_3464", "series": "CAG", "text": "εἰ δὲ τοῦτο οὕτως ἔχει, οὐδὲ ἡ χεὶρ οὐδὲ ἡ κεφαλὴ οὐδὲ ἄλλη τις οὐσία ἔσται τῶν πρός τι.", "seq": 3464}
{"id": "Simplicius_Passim_3465", "series": "CAG", "text": "εἰ γὰρ ἐγκεκαλυμμένος τις προτείνει χεῖρα ἢ ἄλλο μέρος, ὅτι μὲν χεὶρ ὡρισμένως εἰσόμεθα, τίνος δέ ἐστιν χεὶρ οὐκέτι ὡρισμένως ἴσμεν·", "seq": 3465}
{"id": "Simplicius_Passim_3466", "series": "CAG", "text": "τὸ δὲ αἴτιον, ὅτι ἕκαστον τούτων ἐστὶν ὅπερ ἐστὶν οὐκ ἐκ τοῦ πρὸς ἕτερόν πως ἔχειν, ἀλλ᾿ ἐκ τοῦ τοιάνδε ἔχειν οὐσίαν καὶ τοιάνδε ποιότητα.", "seq": 3466}
{"id": "Simplicius_Passim_3467", "series": "CAG", "text": "εἰ οὖν τὰ μὲν μέρη ὡρισμένως γινώσκομεν, πρὸς ἃ δὲ λέγεται οὐκέτι ὡρισμένως, οὐκ ἔστιν τὰ μέρη τῆς οὐσίας πρός τι.", "seq": 3467}
{"id": "Simplicius_Passim_3468", "series": "CAG", "text": "εἰ δὲ ταῦτα μὴ ἔστιν πρός τι, οὐδὲ ἄλλη οὐσία ἔσται τῶν πρός τι·", "seq": 3468}
{"id": "Simplicius_Passim_3469", "series": "CAG", "text": "αὕτη γὰρ μόνη δοκεῖ τῶν πρός τι εἶναι.", "seq": 3469}
{"id": "Simplicius_Passim_3470", "series": "CAG", "text": "χρὴ δὲ ἐφιστάνειν ὅτι διὰ τούτου τοῦ ἐπιχειρήματος τὰ ἄτομα μέρη δείκνυται μὴ ὄντα τῶν πρός τι καθὸ οὐσία·", "seq": 3470}
{"id": "Simplicius_Passim_3471", "series": "CAG", "text": "ταῦτα γάρ ἐστιν τὰ ὡρισμένα·", "seq": 3471}
{"id": "Simplicius_Passim_3472", "series": "CAG", "text": "πῶς οὖν καθόλου ἐπήνεγκεν ὡς εἰ μὴ ἔστιν αὕτη τῶν πρός τι, οὐδεμία οὐσία τῶν πρός τί ἐστιν;", "seq": 3472}
{"id": "Simplicius_Passim_3473", "series": "CAG", "text": "ἢ ὅτι ὡς ἂν ἔχῃ τὰ καθ᾿ ἕκαστα, οὕτως ἔχει καὶ τὰ κοινά·", "seq": 3473}
{"id": "Simplicius_Passim_3474", "series": "CAG", "text": "κυριώτερον δὲ ἀποδέδεικται ἐκ τοῦ τὸ εἶναι αὐτοῖς μὴ εἶναι ταὐτὸν τῷ πρός τί πως ἔχειν.", "seq": 3474}
{"id": "Simplicius_Passim_3475", "series": "CAG", "text": "προσέθηκεν δὲ ὅτι χαλεπὸν περὶ τῶν τοιούτων σφοδρῶς ἀποφαίνεσθαι μὴ πολλάκις ἐπεσκεμμένους·", "seq": 3475}
{"id": "Simplicius_Passim_3476", "series": "CAG", "text": "φιλόσοφον γὰρ τὸ μὴ διατείνεσθαι ἀνεξετάστως.", "seq": 3476}
{"id": "Simplicius_Passim_3477", "series": "CAG", "text": "τί οὖν, φαίη τις ἄν, ὄφελος τῆς ζητήσεως τῷ τὸ ἀληθὲς μὴ εὑρίσκοντι;", "seq": 3477}
{"id": "Simplicius_Passim_3478", "series": "CAG", "text": "ὅτι καὶ αὐτὸ τὸ διηπορηκέναι περί τινων οὐκ ἄχρηστον καὶ ὅτι πρὸς τὴν εὕρεσιν ἑτοιμότεροι ἐσόμεθα προηπορηκότες καὶ ὅτι, κἂν μὴ γνωστὸν ᾖ, αἱ περὶ αὐτὸ ἀπορίαι γνωσταὶ οὖσαι διευρύνουσιν ἡμῶν τὴν γνῶσιν καὶ τὴν αἰτίαν τοῦ ἄγνωστον εἶναι παραδεικνύουσιν, ὠφελιμώτατον δὲ καὶ τοῦτο.", "seq": 3478}
{"id": "Simplicius_Passim_3479", "series": "CAG", "text": "ἀλλὰ ταῦτα μὲν εἴρηται καλῶς·", "seq": 3479}
{"id": "Simplicius_Passim_3480", "series": "CAG", "text": "ἐπιστῆσαι δὲ ἄξιον, ὡς οἶμαι, εἰ τούτων ἔδει τῶν λόγων πρὸς τὸ ἀποφήνασθαι ὅτι οὐδεμία οὐσία τῶν πρός τί ἐστιν, προδήλου ὄντος ὅτι ἡ οὐσία καθ᾿ αὑτὸ οὖσα ἀντίκειται τοῖς πρός τι.", "seq": 3480}
{"id": "Simplicius_Passim_3481", "series": "CAG", "text": "ἀλλ᾿ ἴσως οὐ πρὸς τὸ προσεχὲς εἴρηται, ἀλλὰ πρὸς τὸ ἀνωτέρω·", "seq": 3481}
{"id": "Simplicius_Passim_3482", "series": "CAG", "text": "εἴποι γὰρ ἄν τις, ὅτι ὁ τὴν χεῖρα τοῦ ἐγκεκαλυμμένου γινώσκων οὐχ ὡρισμένως αὐτὴν γινώσκει·", "seq": 3482}
{"id": "Simplicius_Passim_3483", "series": "CAG", "text": "οὐ γὰρ τὴν τινὰ χεῖρα γινώσκει, ἀλλ᾿ ἀορίστως χεῖρα, εἰ καὶ τὸ ἄτομον αὐτῆς εἶδος γινώσκων οὐ πάντως οἶδεν καὶ τίνος ἐστίν.", "seq": 3483}
{"id": "Simplicius_Passim_3484", "series": "CAG", "text": "Ἀλλὰ καιρὸς ἂν εἴη λοιπὸν μετὰ τὴν τῆς λέξεως διερμήνευσιν τὰς ἐπαχθείσας ἀπορίας ἰδεῖν καὶ τὰς λύσεις αὐτῶν ἐπισκέψασθαι.", "seq": 3484}
{"id": "Simplicius_Passim_3485", "series": "CAG", "text": "λέγουσιν δέ τινες, ὅτι καὶ ἡ ἄτομος οὐσία τοῦτο ὅπερ ἐστὶν ἑτέρου καὶ λέγεται καὶ ἔστιν·", "seq": 3485}
{"id": "Simplicius_Passim_3486", "series": "CAG", "text": "ὁ γὰρ Σωκράτης ὅπερ ἐστὶν τοῦ θεοῦ ἐστιν.", "seq": 3486}
{"id": "Simplicius_Passim_3487", "series": "CAG", "text": "ἀλλ᾿ ὡς κτῆμα δηλονότι καὶ οὐχ ὡς πρός τι·", "seq": 3487}
{"id": "Simplicius_Passim_3488", "series": "CAG", "text": "κατὰ συμβεβηκὸς οὖν.", "seq": 3488}
{"id": "Simplicius_Passim_3489", "series": "CAG", "text": "ὥστε καὶ ἐπὶ πάντων τῶν κατὰ συμβεβηκὸς λεγομένων ἡ αὐτὴ λύσις ἁρμόσει·", "seq": 3489}
{"id": "Simplicius_Passim_3490", "series": "CAG", "text": "ἐάν τις ἀντὶ τοῦ καθ᾿ αὑτὸ προηγουμένως λεγομένου τὸ κατὰ συμβεβηκὸς μεταλάβῃ, καὶ τὸ μὴ λεγόμενον ἑτέρου λεχθήσεται.", "seq": 3490}
{"id": "Simplicius_Passim_3491", "series": "CAG", "text": "εἰ δὲ ἄνθρωπος ὅμοιος θεῷ λέγεται καὶ ὅλως εἰκὼν παραδείγματι, ἆρα καὶ τὰ τοιαῦτα πρός τί ἐστιν τῆς σχέσεως οὐκ ἀντιστρεφούσης;", "seq": 3491}
{"id": "Simplicius_Passim_3492", "series": "CAG", "text": "οὐ γὰρ δὴ καὶ ὁ θεὸς ὅμοιος ἀνθρώπῳ ἢ τὸ παράδειγμα τῇ εἰκόνι.", "seq": 3492}
{"id": "Simplicius_Passim_3493", "series": "CAG", "text": "ἢ τὸ μὲν παράδειγμα ἀντιστρέφει (ὡς γὰρ εἰκὼν παραδείγματός ἐστιν, οὕτως καὶ παράδειγμα εἰκόνος), τὸ δὲ ὅμοιον οὐκέτι, ἀλλ᾿ ἡ μὲν εἰκὼν ὁμοία τῷ παραδείγματι, τὸ δὲ παράδειγμα ὁμοίας εἰκόνος παράδειγμα.", "seq": 3493}
{"id": "Simplicius_Passim_3494", "series": "CAG", "text": "εἰ δὲ δυσχεραίνει τις τὴν ὁποιανοῦν ἀπ᾿ ἐκείνων σχέσιν πρὸς τὰ τῇδε, ἐννοείτω τὴν ἄσχετον καλουμένην σχέσιν καὶ τὴν ἀνεπίκλιτον πρόνοιαν, καθ᾿ ἣν δεσπόζουσιν ἡμῶν οἱ θεοί, κτήματα δὲ ἡμεῖς αὐτῶν ἐσμεν, καὶ προνοοῦσιν μὲν ἐκεῖνοι, κατευθυνόμεθα δὲ ἡμεῖς.", "seq": 3494}
{"id": "Simplicius_Passim_3495", "series": "CAG", "text": "Τινὲς δὲ τὸν νῦν ὡς ἀκριβέστερον ἀποδοθέντα ὁρισμὸν τοῦτον ἐπιχειροῦσιν διασύρειν ὡς τὸ ὁριστὸν ἐν ἑαυτῷ περιλαβόντα·", "seq": 3495}
{"id": "Simplicius_Passim_3496", "series": "CAG", "text": "τὰ γὰρ πρός τι ὁριζόμενος οἷς τὸ εἶναι, φησίν, ταὐτόν ἐστιν τῷ πρός τί πως ἔχειν.", "seq": 3496}
{"id": "Simplicius_Passim_3497", "series": "CAG", "text": "ἀλλὰ καὶ ἀσαφῆ τὴν ἀπόδοσιν ἐποιήσατο, ὡς καὶ Βοήθῳ καὶ Ἀρίστωνι δοκεῖ, ὅπερ καὶ αὐτὸ κακία ὁρισμοῦ ἐστιν, διόπερ ὁ Ἀρίστων ὡς ἐπὶ σαφέστερον μεταλαμβάνων “τὰ πρός τί πως ἔχοντα, φησίν, ταῦτά ἐστιν, οἷς τὸ εἶναι ταὐτόν ἐστιν τῷ πῶς ἔχειν πρὸς ἕτερον”·", "seq": 3497}
{"id": "Simplicius_Passim_3498", "series": "CAG", "text": "[καὶ] οὕτως δὲ καὶ Ἀνδρόνικος ἀποδίδωσιν.", "seq": 3498}
{"id": "Simplicius_Passim_3499", "series": "CAG", "text": "τὴν δὲ ἀπορίαν ὁ μὲν Ἀχαϊκὸς λύων φησὶν οὐ τὸ ὁριστὸν ἐν τῷ ὅρῳ περιειλῆφθαι, ἀλλὰ καὶ τῷ δευτέρῳ πρός τι ὁμωνύμως αὐτὸν κεχρῆσθαί φησιν ἀντὶ τοῦ πρὸς ὁτιοῦν, ὡς εἰ ἔλεγεν “οἷς τὸ εἶναι ταὐτόν ἐστιν τῷ πρὸς ὁτιοῦν πως ἔχειν”.", "seq": 3499}
{"id": "Simplicius_Passim_3500", "series": "CAG", "text": "δύναται δέ τις κἀκεῖνο λέγειν, ὅπερ καὶ πρότερον, ὡς τὰ γενικώτατα καὶ ἀρχηγικώτατα γένη δι᾿ ἑαυτῶν ἀνάγκη σαφηνίζεσθαι, ἅτε μὴ ἔχοντά τι καθολικώτερον, δι᾿ οὗ κατὰ νόμον τις αὐτῶν ποιήσεται τὴν ἀπόδοσιν.", "seq": 3500}
{"id": "Simplicius_Passim_3501", "series": "CAG", "text": "λύουσιν καὶ οὕτως τὴν ἀπορίαν·", "seq": 3501}
{"id": "Simplicius_Passim_3502", "series": "CAG", "text": "‘τὸ λευκὸν ἔστι μὲν καὶ ἐπὶ τῆς λευκότητος εἰπεῖν, ἔστιν δὲ καὶ ἐπὶ τοῦ μετέχοντος σώματος τῆς λευκότητος.", "seq": 3502}
{"id": "Simplicius_Passim_3503", "series": "CAG", "text": "ἂν οὖν ὁ μέν τις τὸ λευκὸν εἴπῃ χρῶμα διακριτικὸν ὄψεως, ὁ δέ τις ἀκούσῃ ἐπὶ τοῦ μετέχοντος σώματος, δῆλον ὅτι ἄτοπος δόξει ὁ λόγος·", "seq": 3503}
{"id": "Simplicius_Passim_3504", "series": "CAG", "text": "οὐ γάρ ἐστιν τὸ σῶμα χρῶμα διακριτικὸν ὄψεως.", "seq": 3504}
{"id": "Simplicius_Passim_3505", "series": "CAG", "text": "ἔστιν οὖν διόρθωσις τοῦ τοιούτου παρακούσματος τὸ λέγειν ὅτι τὸ λευκὸν καθὸ λευκὸν καὶ ᾗ λευκὸν χρῶμά ἐστιν διακριτικὸν ὄψεως, καὶ οὐ δήπου τὸ ζητούμενον λαμβάνεται ἐν τῇ τοιαύτῃ προσθήκῃ·", "seq": 3505}
{"id": "Simplicius_Passim_3506", "series": "CAG", "text": "τοὐναντίον γὰρ μὴ προστεθέντος ψευδὴς γίνεται ὁ ὅρος.", "seq": 3506}
{"id": "Simplicius_Passim_3507", "series": "CAG", "text": "καὶ ἐνταῦθα οὖν οὐχ ἁπλῶς εἴρηται τὰ πρός τι ὅτι ἐστὶν τὰ αὐτὰ τῷ πρός τί πως ἔχειν, ἀλλὰ πρόσκειται οἷς τὸ εἶναι ταὐτόν ἐστι τῷ πρός τί πως ἔχειν·", "seq": 3507}
{"id": "Simplicius_Passim_3508", "series": "CAG", "text": "τὸ γὰρ εἶναι τῶν πρός τί ἐστιν τὸ σχέσιν εἶναι ἑτέρου πρὸς ἕτερον, οἷον τὰ τέσσαρα καὶ δύο οὐ καθὸ τέσσαρα καὶ δύο, ταύτῃ πρός τί ἐστιν, ἀλλὰ καθ᾿ ὅσον θεωρεῖταί τις ὑπεροχὴ τοῦ μείζονος πρὸς τὸ ἔλαττον αὐτῷ τῷ ἐλάττονι ὑπερέχουσα τὸ ἔλαττον’.", "seq": 3508}
{"id": "Simplicius_Passim_3509", "series": "CAG", "text": "μήποτε δὲ οὐδὲ ἄλλως οἷόν τέ ἐστιν ἀποδοῦναι τὰ πρός τι.", "seq": 3509}
{"id": "Simplicius_Passim_3510", "series": "CAG", "text": "κατ᾿ αὐτὴν γὰρ μόνην τὴν σχέσιν ὑφέστηκεν, καὶ ὁ τῆς σχέσεως λόγος ἕτερος ὢν τῶν ὑποκειμένων, οὗτος εἰδοποιεῖ τὰ πρός τι·", "seq": 3510}
{"id": "Simplicius_Passim_3511", "series": "CAG", "text": "αὐτὰ μὲν γὰρ τὰ ὑποκείμενα οὐκ ἔστιν τὰ πρός τι, ἡ δὲ σχέσις αὐτῶν ἡ πρὸς ἄλληλα ἧς μετέχει τὰ ὑποκείμενα.", "seq": 3511}
{"id": "Simplicius_Passim_3512", "series": "CAG", "text": "ὁ οὖν τὰ μετέχοντα αὐτὰ ὁριζόμενος κατὰ τὴν μέθεξιν ἀναγκάζεται τὴν μέθεξιν ἐν τῷ ὁρισμῷ παραλαβεῖν.", "seq": 3512}
{"id": "Simplicius_Passim_3513", "series": "CAG", "text": "ὅτι γὰρ τὰ πρός τι, ἃ ὁρίζεται, τὰ μετέχοντά ἐστιν, δηλοῖ τὸ πληθυντικῶς εἰρῆσθαι, τῆς τοῦ γένους αὐτοῦ ἰδιότητος μιᾶς οὔσης·", "seq": 3513}
{"id": "Simplicius_Passim_3514", "series": "CAG", "text": "ὅλως γὰρ οὐδὲ δυνατὸν οἶμαι περὶ τῆς σχέσεως αὐτῆς εἰπεῖν ὅτι πρός τί πως <ἔχει, ἀλλὰ κατὰ τὸ πῶς> ἔχειν ἄλλο πρὸς κατὰ τοῦτο θεωρεῖται, ὥσπερ καὶ ἡ τοῦ ἔχειν κατηγορία οὐκ ἐν τῷ ἔχειν τι αὐτὴν λέγεται, ἀλλ᾿ ἐν τῷ ἄλλο τι ἔχειν.", "seq": 3514}
{"id": "Simplicius_Passim_3515", "series": "CAG", "text": "σαφέστερον δὲ ταύτην τὴν ἔννοιαν δηλοῦσιν ὅ τε τοῦ Ἀχαϊκοῦ ὁρισμὸς λέγων “οἷς τὸ εἶναι ταὐτόν ἐστιν τῷ πρὸς ὁτιοῦν πως ἔχειν” καὶ ὁ Ἀρίστωνος καὶ Ἀνδρονίκου ὁ λέγων “οἷς τὸ εἶναι ταὐτόν ἐστιν τῷ πρὸς ἕτερόν πως ἔχειν”.", "seq": 3515}
{"id": "Simplicius_Passim_3516", "series": "CAG", "text": "ὡς γὰρ ἐπὶ τῶν μετεχόντων τῆς τοῦ πρός τι σχέσεως καὶ κατὰ ταύτην ἀφοριζομένων εἴρηται τοῦτο, εἰ καὶ δύναταί πως καὶ ἐπ᾿ αὐτῆς ἀκούεσθαι τῆς σχέσεως·", "seq": 3516}
{"id": "Simplicius_Passim_3517", "series": "CAG", "text": "τὸ γὰρ εἶναι τῶν κατὰ <τὰ> πρός τι σχέσεων ταὐτόν ἐστιν τῷ ἕτερον πρὸς ἕτερόν πως ἔχειν.", "seq": 3517}
{"id": "Simplicius_Passim_3518", "series": "CAG", "text": "καὶ ὁ φιλόσοφος δὲ Συριανὸς οὕτω λύει τὴν ἀπορίαν, ὡς τῆς ὁμωνυμίας πλανώσης τῶν μετεχόντων πρὸς τὸ μετεχόμενον·", "seq": 3518}
{"id": "Simplicius_Passim_3519", "series": "CAG", "text": "πολὺ γὰρ συνανακέκραται τοῖς μετέχουσιν, διὸ μεταβαλλομένων ἐκείνων αὐτὰ καὶ γίνεται καὶ φθείρεται, ὡς ἐν ἐκείνοις οὐδὲν ἧττον ἢ ἐν ἑαυτοῖς τὸ κῦρος ἔχοντα.", "seq": 3519}
{"id": "Simplicius_Passim_3520", "series": "CAG", "text": "Πρὸς δὲ τοὺς ζητοῦντας, τίνα ἔσχεν χρείαν ἡ τοῦ δευτέρου ὁρισμοῦ προσθήκη, ὁ θεῖος Ἰάμβλιχος ὑπαντῶν “διότι, φησίν, ὁ πρῶτος περιελάμβανεν δικαιοσύνην, λευκότητα·", "seq": 3520}
{"id": "Simplicius_Passim_3521", "series": "CAG", "text": "τινῶν γὰρ λέγονται καὶ αὗται”.", "seq": 3521}
{"id": "Simplicius_Passim_3522", "series": "CAG", "text": "πρὸς ὃ ῥητέον οἶμαι τὰ αὐτοῦ, ὅτι ἄλλο ἐστὶν τὸ ἐν ἑτέροις εἶναι καὶ μετὰ ἑτέρων καὶ ἄλλο τὸ αὐτὰ ἅπερ ἐστὶν ἑτέρων λέγεσθαι·", "seq": 3522}
{"id": "Simplicius_Passim_3523", "series": "CAG", "text": "δικαιοσύνη γὰρ καὶ λευκότης, κἂν ἐν ἑτέροις ὦσιν, ἀλλ᾿ ἔχουσιν οἰκείους λόγους καθ᾿ οὓς ἀφορίζονται, εἰ μὴ ἄρα τις λαμβάνοι καθὸ ἕξις ἐστὶν ἡ δικαιοσύνη·", "seq": 3523}
{"id": "Simplicius_Passim_3524", "series": "CAG", "text": "κατὰ τοῦτο δὲ καὶ πρός τί ἐστιν.", "seq": 3524}
{"id": "Simplicius_Passim_3525", "series": "CAG", "text": "“ἔτι, φησίν, ὁ λέγων πρός τι τὸ ἑτέρου λεγόμενον τὴν τοῦ ἑνὸς μόνην σχέσιν παρίστησιν, τὴν δὲ τῶν δύο πρὸς ἄλληλα οὐκέτι ἐπιδείκνυσιν, ἀλλ᾿ οἷον ἐφ᾿ ἡμισείας ἀποδίδωσιν τὸν ὅρον, διὸ καὶ ἄλλα περιλαμβάνει τῶν μὴ πρός τι·", "seq": 3525}
{"id": "Simplicius_Passim_3526", "series": "CAG", "text": "ὁ μέντοι δεύτερος τὰς τῶν δύο σχέσεις συλλαμβάνει πρὸς ἄλληλα”.", "seq": 3526}
{"id": "Simplicius_Passim_3527", "series": "CAG", "text": "καὶ ταῦτα δὲ ἐπιστάσεως ἄξια νομίζω·", "seq": 3527}
{"id": "Simplicius_Passim_3528", "series": "CAG", "text": "πῶς γὰρ τὴν τοῦ ἑνὸς μόνην παρίστησιν ὁ πληθυντικῶς εἰπών;", "seq": 3528}
{"id": "Simplicius_Passim_3529", "series": "CAG", "text": "εἰ γὰρ μὴ ἐπ᾿ ἀμφοῖν ἀκούειν τις βούλεται τοῦτο, οὐδὲ τὸ οἷς τὸ εἶναι ταὐτόν ἐστιν τῷ πρός τί πως ἔχειν ἐπ᾿ ἀμφοῖν ἀκούσει·", "seq": 3529}
{"id": "Simplicius_Passim_3530", "series": "CAG", "text": "οὐ γὰρ εἶπεν ‘πρὸς ἄλληλα’, ἀλλὰ πρός τι.", "seq": 3530}
{"id": "Simplicius_Passim_3531", "series": "CAG", "text": "“τρίτον δὲ ἐκεῖνος μὲν ὁ ὅρος λέγεσθαι ἑτέρου φησὶ τὰ πρός τι, οὗτος δὲ αὐτὸ τὸ εἶναι τῶν πρός τι καὶ τὴν οὐσίαν ἀφορίζει·", "seq": 3531}
{"id": "Simplicius_Passim_3532", "series": "CAG", "text": "καὶ κατ᾿ ἐκεῖνον ἡ χείρ, φησίν, πρός τί ἐστιν, ὅτι ἑτέρου λέγεται τοῦ ἔχοντος, κατὰ δὲ τοῦτον οὐ ταὐτόν ἐστιν τὸ εἶναι χεὶρ τῷ πρός τί πως ἔχειν”.", "seq": 3532}
{"id": "Simplicius_Passim_3533", "series": "CAG", "text": "καὶ πρὸς ταῦτα δὲ οἶμαι ῥᾴδιον εἰπεῖν ὡς εἰ ἀληθῶς λέγοιτο, πάντως καὶ ἔστιν ὅπερ λέγεται·", "seq": 3533}
{"id": "Simplicius_Passim_3534", "series": "CAG", "text": "τὸ μὲν γὰρ εἶναι τοῦ λέγεσθαι αἴτιον, τὸ δὲ λέγεσθαι τοῦ εἶναι τεκμήριον, ὥστε ἀπ᾿ αἰτίας μὲν οὗτος ὁ ὅρος, σαφέστερος δὲ ἐκεῖνος ἀπὸ γνωριμωτέρου γενόμενος, ἄμφω δὲ εἰς τὴν αὐτὴν τείνουσιν ἔννοιαν, ἐπεὶ καὶ εἴ τις ἀμφισβητεῖ πρὸς τὸ εἶναι ἀπὸ τοῦ λέγεσθαι ἂν αὐτὸ ῥᾳδίως πιστώσαιτο.", "seq": 3534}
{"id": "Simplicius_Passim_3535", "series": "CAG", "text": "καὶ ἡ χεὶρ δὲ οὐδὲ κατ᾿ ἐκεῖνον εἴη ἂν τῶν πρός τι·", "seq": 3535}
{"id": "Simplicius_Passim_3536", "series": "CAG", "text": "οὐ γὰρ καθὸ χεὶρ ἐν τούτῳ ἔχει τὸ εἶναι ἐν τῷ ἑτέρου λέγεσθαι, ἀλλ᾿ εἴπερ ἄρα καθὸ μέρος, ὥσπερ καὶ ἐπὶ τούτου τοῦ ὅρου ἀπελογιζόμεθα.", "seq": 3536}
{"id": "Simplicius_Passim_3537", "series": "CAG", "text": "διὸ ὡς μὲν μέρος καὶ ὅλον ἄμφω ἔχει σχέσιν πρὸς ἄλληλα, ὡς δὲ χεὶρ οὔτε αὐτὴ πρὸς τὸ ὅλον οὔτε τὸ ὅλον πρὸς αὐτήν.", "seq": 3537}
{"id": "Simplicius_Passim_3538", "series": "CAG", "text": "“ἔτι δέ, φησίν, παρίστησιν ὁ δεύτερος ὅρος, ὡς μέσον τι ἡ σχέσις ἐστὶν τῶν ὑποκειμένων καὶ ἐχόντων τὴν σχέσιν”.", "seq": 3538}
{"id": "Simplicius_Passim_3539", "series": "CAG", "text": "καὶ ὁ πρότερος δέ, εἰ ἐν τῇ πρὸς ἕτερον ἀπονεύσει τὰ πρός τι ἀφορίζεται, ὡς μέσον τι θεωρεῖ τὴν ἀπόνευσιν τοῦ τε ἀπονεύοντος καὶ τοῦ πρὸς ὃ ἀπονεύει.", "seq": 3539}
{"id": "Simplicius_Passim_3540", "series": "CAG", "text": "ταῦτα μὲν οὖν περὶ τούτου.", "seq": 3540}
{"id": "Simplicius_Passim_3541", "series": "CAG", "text": "Προσκείσθω δὲ καὶ ἄλλη τις ἀπορία περὶ τῶν πρός τι ταῖς εἰρημέναις τοιάδε·", "seq": 3541}
{"id": "Simplicius_Passim_3542", "series": "CAG", "text": "τὰς δέκα κατηγορίας δέκα γένη λέγομεν καὶ ἑκάστην αὐτῶν εἰς οἰκεῖα εἴδη διῃρῆσθαί φαμεν, ἓν δὲ τῶν δέκα γενῶν εἶναι τὰ πρός τι τιθέμεθα·", "seq": 3542}
{"id": "Simplicius_Passim_3543", "series": "CAG", "text": "ἀλλὰ μὴν τὸ γένος εἰδῶν ἐστι γένος, καὶ τὸ εἶδος δὲ γένους ἐστίν, ὥστε τῶν πρός τι ἂν εἴη τὸ γένος καὶ εἶδος ἓν τῶν πρός τι.", "seq": 3543}
{"id": "Simplicius_Passim_3544", "series": "CAG", "text": "τούτων δὴ οὕτως ἐχόντων πολλὰ ἄτοπα δοκεῖ ἀναφαίνεσθαι.", "seq": 3544}
