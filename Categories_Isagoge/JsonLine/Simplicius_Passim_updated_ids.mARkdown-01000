{"id": "Simplicius_Passim_3013", "series": "CAG", "text": "οὐ πᾶσιν δέ, φησί, τοῖς πρός τι ὑπάρχει τὰ ἐναντία·", "seq": 3013}
{"id": "Simplicius_Passim_3014", "series": "CAG", "text": "οὐ γὰρ δὴ τῷ διπλασίῳ οὔτε τῷ τριπλασίῳ οὔτε τῶν πολλαπλασίων οὐδενί, ἅπερ πάντα τῶν πρός τί ἐστιν.", "seq": 3014}
{"id": "Simplicius_Passim_3015", "series": "CAG", "text": "διὰ τί οὖν ἄρα καὶ ὑπάρχει καὶ οὐχ ὑπάρχει τοῖς πρός τι ἡ ἐναντιότης;", "seq": 3015}
{"id": "Simplicius_Passim_3016", "series": "CAG", "text": "ἢ ὅτι ἄνευ μὲν ἄλλης κατηγορίας καθ᾿ αὑτὰ οὐδὲ ἐπινοηθῆναι δύναται τὰ πρός τι, συνυφίσταται δὲ ἀεὶ ταῖς ἄλλαις·", "seq": 3016}
{"id": "Simplicius_Passim_3017", "series": "CAG", "text": "διὰ τοῦτο οὖν, ὅταν μὲν ἐπὶ κατηγορίας ληφθείη ἐχούσης ἐναντίωσιν, ἕξει καὶ αὐτὰ τὴν ἐναντίωσιν·", "seq": 3017}
{"id": "Simplicius_Passim_3018", "series": "CAG", "text": "ἐὰν δὲ ἐν τοῖς μὴ ἔχουσιν ἐναντίωσιν θεωρῆται, οὐδὲ αὐτὰ ἕξει τὴν ἐναντίωσιν.", "seq": 3018}
{"id": "Simplicius_Passim_3019", "series": "CAG", "text": "ὅσα γὰρ ἂν ὑπάρχῃ τῷ ὑποκειμένῳ γένει τοῖς πρός τι, ταῦτα καὶ αὐτοῖς τοῖς πρός τι συμβέβηκεν ὡς ἐπὶ τὸ πλεῖστον, ὥστε ὅταν μὲν ἐν ἕξει ἢ ὅλως ποιότητι συνθεωρῆται, ἐπιδέχεται ἐναντίωσιν, διότι καὶ ἡ ποιότης·", "seq": 3019}
{"id": "Simplicius_Passim_3020", "series": "CAG", "text": "ὅταν δὲ διπλασίῳ ἢ τριπλασίῳ ἢ ὅλως ποσότητι, οὐκέτι, διότι οὐδὲ ἡ ποσότης ἐναντίωσιν ἐπεδέχετο·", "seq": 3020}
{"id": "Simplicius_Passim_3021", "series": "CAG", "text": "ὁμοίως δὲ καὶ ὅταν οὐσίᾳ συνέπηται, ὡς ἐπὶ πατρὸς καὶ υἱοῦ·", "seq": 3021}
{"id": "Simplicius_Passim_3022", "series": "CAG", "text": "οὐδὲ γὰρ ἡ οὐσία ἐπεδέχετο.", "seq": 3022}
{"id": "Simplicius_Passim_3023", "series": "CAG", "text": "καὶ δῆλον ὅτι καθ᾿ ὅσον μὲν ἐπιδέχεται ἐναντίωσιν, τοῖς ἐπιδεχομένοις γένεσιν κοινωνεῖ, καθ᾿ ὅσον δὲ μὴ ἐπιδέχεται, τοῖς μὴ ἐπιδεχομένοις, κατ᾿ ἄμφω δὲ πᾶσιν ὁμοῦ τοῖς γένεσιν, ὥστε οὐδὲ ἴδιόν ἐστι τῶν πρός τι τὸ ἐπιδέχεσθαι τὰ ἐναντία·", "seq": 3023}
{"id": "Simplicius_Passim_3024", "series": "CAG", "text": "οὔτε γὰρ παντὶ οὔτε μόνῳ ὑπάρχει ἐναντιότης.", "seq": 3024}
{"id": "Simplicius_Passim_3025", "series": "CAG", "text": "Δοκεῖ δέ, φησίν, καὶ τὸ μᾶλλον καὶ τὸ ἧττον ἐπιδέχεσθαι τὰ πρός τι, τὸ μὲν δοκεῖ προσθεὶς οὐχ ὡς μὴ ἐπιδεχομένου μέν, δοκοῦντος δὲ ἐπιδέχεσθαι, ἀλλ᾿ ὡς ἀρχαίαν δόξαν ἐξηγούμενος·", "seq": 3025}
{"id": "Simplicius_Passim_3026", "series": "CAG", "text": "τὸ δὲ μᾶλλον καὶ τὸ ἧττον ἐπιδέχεται κατὰ τὸ ὅμοιον·", "seq": 3026}
{"id": "Simplicius_Passim_3027", "series": "CAG", "text": "μᾶλλον γὰρ ὅμοιον τὸ μᾶλλον τοῦ αὐτοῦ εἴδους μετέχον καὶ ἧττον τὸ ἧττον·", "seq": 3027}
{"id": "Simplicius_Passim_3028", "series": "CAG", "text": "τὸ δὲ ὅμοιον τῶν πρός τι.", "seq": 3028}
{"id": "Simplicius_Passim_3029", "series": "CAG", "text": "ἀλλὰ τοῦτο μὲν σαφές.", "seq": 3029}
{"id": "Simplicius_Passim_3030", "series": "CAG", "text": "πῶς δὲ ἀντὶ τοῦ εἰπεῖν ‘καὶ ἄνισον μᾶλλον καὶ ἧττον’ ἀνισαίτερον μᾶλλον καὶ ἧττον εἶπεν;", "seq": 3030}
{"id": "Simplicius_Passim_3031", "series": "CAG", "text": "εἰ γὰρ ἀνισαίτερόν ἐστιν ἄνισον ἤδη προσειληφὸς τὸ μᾶλλον, πῶς ἀνισαίτερον μᾶλλον καὶ ἧττον εἶπεν;", "seq": 3031}
{"id": "Simplicius_Passim_3032", "series": "CAG", "text": "ἢ διὰ τὸ ἀσυνηθέστερον τῆς λέξεως αὐτὸ τὸ μετὰ τοῦ μᾶλλον ἄνισον παρήγαγεν.", "seq": 3032}
{"id": "Simplicius_Passim_3033", "series": "CAG", "text": "πῶς οὖν καὶ τὸ ἧττον ἐπήγαγεν;", "seq": 3033}
{"id": "Simplicius_Passim_3034", "series": "CAG", "text": "ἢ ὅτι καὶ τὸ μᾶλλον ἄνισον ἐπίτασιν ἔχει καὶ ἄνεσιν, ὥστε μᾶλλον ἀνισαίτερον καὶ ἧττον εἶναι·", "seq": 3034}
{"id": "Simplicius_Passim_3035", "series": "CAG", "text": "καὶ γὰρ μᾶλλον ὁμοιότερον καὶ ἧττον λέγομεν, ὅταν ὁμοιότερον ὄν τι ἄλλου τινὸς τοῦτο τὸ ὁμοιότερον ἐπιτείνηται καὶ ἀνιῆται.", "seq": 3035}
{"id": "Simplicius_Passim_3036", "series": "CAG", "text": "καὶ ἄλλως δὲ ὁ Ἰάμβλιχος ἐξηγεῖται, ὅτι τὴν ἐπ᾿ ἄπειρον τοῦ ἀνίσου πρόοδον ἐνδεικνύμενος ἀνισαίτερον αὐτὸ προσηγόρευσεν·", "seq": 3036}
{"id": "Simplicius_Passim_3037", "series": "CAG", "text": "οὐ γὰρ ἵσταται τοῦτο οὐδὲ μέγα ποτὲ γίνεται, ἀλλ᾿ ἀεὶ μεῖζον, οὔτε μικρόν, ἀλλ᾿ ἀεὶ ἧττον κατὰ τὴν ἐπ᾿ ἄπειρον προσθήκην τε καὶ ἀφαίρεσιν.", "seq": 3037}
{"id": "Simplicius_Passim_3038", "series": "CAG", "text": "ἐπιστῆσαι δὲ ἄξιον, ὅτι οὐκ εἶπεν ἰσαίτερον, ἀλλὰ ἀνισαίτερον, διότι οὐχ ὁμοίως ἐν τῷ ἴσῳ θεωρεῖται τὸ μᾶλλον καὶ ἧττον ὡς ἐν τῷ ἀνίσῳ.", "seq": 3038}
{"id": "Simplicius_Passim_3039", "series": "CAG", "text": "καὶ εἴη ἂν ζητήσεως ἄξιον, διὰ τί ἐν μὲν τῷ ὁμοίῳ καὶ ἀνομοίῳ ὁμοίως τὸ μᾶλλον καὶ ἧττον θεωρεῖται, ἐν δὲ τῷ ἴσῳ καὶ ἀνίσῳ οὐχ ὁμοίως.", "seq": 3039}
{"id": "Simplicius_Passim_3040", "series": "CAG", "text": "ἀλλὰ πῶς ἴδιον ὂν τοῦ ποσοῦ τὸ ἴσον τε καὶ ἄνισον ἐπιδέχεται τὸ μᾶλλον καὶ τὸ ἧττον τοῦ ποσοῦ μὴ ἐπιδεχομένου;", "seq": 3040}
{"id": "Simplicius_Passim_3041", "series": "CAG", "text": "ἢ ὅτι τὸ μὲν ποσὸν ᾗ ποσὸν οὐκ ἐπιδέχεται, τὰ δὲ συμβεβηκότα τῷ ποσῷ οὐ καθὸ ποσά, ἀλλὰ καθὸ ποιὰ μᾶλλον, κατὰ τοῦτο ἐπιδέχεται τὸ μᾶλλον καὶ τὸ ἧττον.", "seq": 3041}
{"id": "Simplicius_Passim_3042", "series": "CAG", "text": "ὁμοιότης γὰρ ἦν ποσοῦ τὸ ἴσον·", "seq": 3042}
{"id": "Simplicius_Passim_3043", "series": "CAG", "text": "ἡ δὲ ὁμοιότης ποιόν·", "seq": 3043}
{"id": "Simplicius_Passim_3044", "series": "CAG", "text": "τὸ δὲ ποιὸν ἐπιδέχεται τὸ μᾶλλον καὶ ἧττον.", "seq": 3044}
{"id": "Simplicius_Passim_3045", "series": "CAG", "text": "πάλιν δὲ οὐκέτι πάντα τὰ πρός τι ἐπιδέχεται τὸ μᾶλλον καὶ ἧττον·", "seq": 3045}
{"id": "Simplicius_Passim_3046", "series": "CAG", "text": "τὰ γὰρ ἐν ὑποκειμένοις συνιστάμενα μὴ ἔχουσιν οὐδὲ αὐτὰ ἔχει.", "seq": 3046}
{"id": "Simplicius_Passim_3047", "series": "CAG", "text": "τὸ δὲ διπλάσιον καὶ τριπλάσιον καὶ ὅλως τὰ ὡρισμένα ποσὰ οὐκ ἐπιδέχεται·", "seq": 3047}
{"id": "Simplicius_Passim_3048", "series": "CAG", "text": "τὰ γὰρ ἤδη διωρισμένα οὐκ ἐπιδέχεται τὴν κατὰ τὸ μᾶλλον καὶ ἧττον ἀοριστίαν.", "seq": 3048}
{"id": "Simplicius_Passim_3049", "series": "CAG", "text": "Ἀλλ᾿ ἐπὶ τὰς ἀντιλήψεις πάλιν τὰς πρὸς τὰ παρακολουθοῦντα ῥηθείσας καὶ τὰς τῶν ἀντιλήψεων διαλύσεις τρεπτέον.", "seq": 3049}
{"id": "Simplicius_Passim_3050", "series": "CAG", "text": "ἀπορήσειε γὰρ ἄν τις, πῶς ἡ ἀρετὴ καὶ ἡ κακία τῶν πρός τι·", "seq": 3050}
{"id": "Simplicius_Passim_3051", "series": "CAG", "text": "τὸ γὰρ τινὸς εἶναι οἷον τοῦ σπουδαίου καὶ τοῦ φαύλου μεθέξεως ἦν, ἀλλ᾿ οὐ σχέσεως δηλωτικόν.", "seq": 3051}
{"id": "Simplicius_Passim_3052", "series": "CAG", "text": "καὶ δυνατὸν μὲν λέγειν ὅπερ καὶ πρότερον εἴρηται, ὅτι κατὰ τὴν ἐπὶ τὸ γένος ἀναφορὰν ἔχει τὸ πρός τι ταῦτα·", "seq": 3052}
{"id": "Simplicius_Passim_3053", "series": "CAG", "text": "ἡ γὰρ ἕξις οὐχ ὡς μετεχομένη μόνον θεωρεῖται, ἀλλὰ καὶ καθ᾿ ὅσον ἔχει πως πρὸς τὸ ἐχόμενον καὶ τὸ ἔχον, καθ᾿ ὃ καὶ πρός τί ἐστιν.", "seq": 3053}
{"id": "Simplicius_Passim_3054", "series": "CAG", "text": "ἔστιν δὲ καὶ ἄλλως τὴν ἀρετὴν καὶ τὴν κακίαν τῶν πρός τι λέγειν, καθότι ποιότητες οὖσαι καὶ μεσότητές εἰσίν τινες, ἡ μὲν ὡς συμμετρία, ἡ δὲ ὡς ἀσυμμετρία·", "seq": 3054}
{"id": "Simplicius_Passim_3055", "series": "CAG", "text": "ἔχει γὰρ σχέσιν πρὸς τὰ ἄκρα τὸ μέσον, καὶ ἥ τε συμμετρία πρὸς τὰ σύμμετρα καὶ ἡ ἀσυμμετρία πρὸς τὰ ἀσύμμετρα·", "seq": 3055}
{"id": "Simplicius_Passim_3056", "series": "CAG", "text": "ὥστε καθ᾿ ὅσον μὲν ποιότητες, ἐναντίαι εἰσίν, καθ᾿ ὅσον δὲ μεσότητες, πρός τι.", "seq": 3056}
{"id": "Simplicius_Passim_3057", "series": "CAG", "text": "ὥστε οὐδὲ τοῦτο ἀπορεῖν χρή, πῶς ἄλλης οὔσης ἀντιθέσεως τῶν πρός τι καὶ ἄλλης τῶν ἐναντίων οὐ συγχυθήσονται αἱ ἀντιθέσεις, εἴπερ ἔσται καὶ ἐν τοῖς πρός τι ἐναντία·", "seq": 3057}
{"id": "Simplicius_Passim_3058", "series": "CAG", "text": "οὐ γὰρ καθὸ πρός τί ἐστιν ἐναντία, ἀλλ᾿ ὡς αὐτός φησιν ἐν τοῖς πρός τί ἐστιν ἐναντιότης·", "seq": 3058}
{"id": "Simplicius_Passim_3059", "series": "CAG", "text": "ἔχει γὰρ ἔνια τῶν ὑποκειμένων αὐτοῖς ἐναντιότητα καθὸ ποιά, ἀλλ᾿ οὐ καθὸ πρός τι·", "seq": 3059}
{"id": "Simplicius_Passim_3060", "series": "CAG", "text": "οὔτε γὰρ τὰ ἐναντία καθὸ ἐναντία πρός τί ἐστιν οὔτε τὰ πρός τι <καθὸ πρός τι> ἐναντία.", "seq": 3060}
{"id": "Simplicius_Passim_3061", "series": "CAG", "text": "καὶ ὅλως πρός τι μέν εἰσιν καθὸ ἕξεις, ἕξις δὲ ἕξει οὐκ ἔστιν ἐναντία, ἀλλὰ τὸ ἐναντίον ἔχουσιν καθὸ τοιαίδε ἕξεις, ταὐτὸν δὲ εἰπεῖν καθὸ ποιότητες.", "seq": 3061}
{"id": "Simplicius_Passim_3062", "series": "CAG", "text": "ἐπισημαίνονται δὲ ὅτι ἡ ἐπιστήμη καὶ εἴδησις καὶ γνῶσις ἤτοι τῇ φωνῇ μόνῃ διαφέρουσιν ἢ εἴπερ εἴδησιν μὲν τὴν τῶν εἰδῶν θεωρητικὴν λέγομεν, γνῶσιν δὲ τὴν τῶν γενῶν, ἐπιστήμην δὲ τὴν ἐπαναβεβηκυῖαν ταύτας, ἔσται οὐ κατὰ φωνὴν μόνον, ἀλλὰ καὶ πραγματική τις τούτων διαφορά.", "seq": 3062}
{"id": "Simplicius_Passim_3063", "series": "CAG", "text": "ἀλλ᾿ οὐδεμία σχέσις, φαῖεν ἄν, ἐπίτασιν καὶ ἄνεσιν ἐπιδέχεται·", "seq": 3063}
{"id": "Simplicius_Passim_3064", "series": "CAG", "text": "τὸ γὰρ πρὸς ἕτερον ὁμοίως ἔχουσιν.", "seq": 3064}
{"id": "Simplicius_Passim_3065", "series": "CAG", "text": "ἢ οὐ καθὸ σχέσεις ἢ πρός τι, ἀλλὰ καθὸ τοιάδε καὶ ποιά, τὸ μᾶλλον καὶ ἧττον ἐπιδέχονται.", "seq": 3065}
{"id": "Simplicius_Passim_3066", "series": "CAG", "text": "ἀλλ᾿ οὐκ ἐν τοῖς ποιοῖς μόνοις αὐτοῖς, φασίν, θεωρεῖται τὸ μᾶλλόν τε καὶ ἧττον, ἀλλὰ καὶ ἐν τοῖς ποσοῖς, ὥσπερ ἐν τῷ ἴσῳ τε καὶ ἀνίσῳ καὶ μείζονι καὶ μικροτέρῳ.", "seq": 3066}
{"id": "Simplicius_Passim_3067", "series": "CAG", "text": "ἢ καὶ αὗται ποσώδεις εἰσὶν ποιότητες καὶ κατὰ τὴν ποιότητα γίνεται ἐπίτασίς τε καὶ ἄνεσις.", "seq": 3067}
{"id": "Simplicius_Passim_3068", "series": "CAG", "text": "εἰ δέ τις τὸ διπλάσιον ἐπίτασιν καὶ ἄνεσιν ἐπιδέχεσθαι νομίζει τῇ αὐξήσει καὶ μειώσει τῶν ἐν τῷ αὐτῷ λόγῳ ἀριθμῶν, ὥστε τὸ ἐν τοῖς διακοσίοις καὶ ἑκατὸν μᾶλλον διπλάσιον νομίζειν τοῦ ἐν τοῖς τέτρασιν καὶ δύο, ἀγνοεῖ οὗτος, ὅτι καὶ ἐν πλείοσιν καὶ ἐν ἐλάττοσιν ἀριθμοῖς ὁ αὐτὸς θεωρεῖται λόγος οὔτε ἐπίτασιν οὔτε ἄνεσιν ἐπιδεχόμενος.", "seq": 3068}
{"id": "Simplicius_Passim_3069", "series": "CAG", "text": "Ἰστέον δὲ ὅτι ὁ Ἀρχύτας τούτων τῶν παρακολουθημάτων τὸ μὲν τὰ ἐναντία ἐπιδέχεσθαι παρῆκεν, καίτοι καὶ ἐπὶ τῆς οὐσίας καὶ ἐπὶ τῆς ποιότητος μνημονεύσας αὐτοῦ (“καὶ γὰρ τᾷ ποιότητι, φησίν, κοινά τινα συναρτητέον, τό τε ἐναντιότατά τινα ἐπιδέχεσθαι καὶ στέρησιν”), τὸ δὲ μᾶλλον καὶ ἧττον προσήκατο λέγων·", "seq": 3069}
{"id": "Simplicius_Passim_3070", "series": "CAG", "text": "“καὶ τὸ ποτ᾿ ἄλλο δέ πως ἔχον ἐπιδέχεται τὸ μᾶλλον καὶ ἧττον·", "seq": 3070}
{"id": "Simplicius_Passim_3071", "series": "CAG", "text": "μᾶλλον μὲν γὰρ ἔστιν ἦμεν μεῖζόν τινος καὶ μεῖον πάλιν τῶ αὐτῶ τούτω, πλὰν οὐκ ἐπὶ πάντων τῶν <ποτ᾿> ἄλλο πως ἐχόντων·", "seq": 3071}
{"id": "Simplicius_Passim_3072", "series": "CAG", "text": "οὐ γὰρ ἔστιν μᾶλλον πατέρα ἦμεν οὐδὲ ἧσσον, οὐδὲ μὰν ἀδελφὸν ἢ υἱόν.", "seq": 3072}
{"id": "Simplicius_Passim_3073", "series": "CAG", "text": "λέγω δὲ ταῦτα ἐπιλογιζόμενος οὐκ ἐπὶ τὰς διαθέσιας ἀμφοτέρων τῶν ἠθέων, πῶς ἔχοντι εὐνοίας ποτ᾿ ἀλλήλως τοὶ συγγενέες καὶ τοὶ ὁμάδελφοι, ἀλλ᾿ ἐπ᾿ αὐτὰν τὰν τᾶς φύσιος ἔννοιαν”.", "seq": 3073}
{"id": "Simplicius_Passim_3074", "series": "CAG", "text": "διὰ τί οὖν παρῆκεν τὰ ἐναντία;", "seq": 3074}
{"id": "Simplicius_Passim_3075", "series": "CAG", "text": "ἢ ὅτι οὐ καθ᾿ αὑτὸ ὑπῆρχεν τοῖς πρός τι, ἀλλὰ κατὰ συμβεβηκός, διότι ἐν τοῖς ὑποκειμένοις·", "seq": 3075}
{"id": "Simplicius_Passim_3076", "series": "CAG", "text": "ηὐλαβήθη οὖν, ἵνα μή τις εἰς ταὐτὸ συγχέῃ τὰς μεσότητας καὶ τὰ ὑποκείμενα αὐταῖς καὶ ἤτοι ἀναιρῇ τὰς μεσότητας μηδὲν ἄλλο παρὰ τὰ ὑποκείμενα ἢ τὴν ἐκείνων σύνοδον ἀποφαίνηται αὐτὰς ὑπάρχειν, καίτοι τὸ μέσον ἕν τι γένος ἐστὶ κοινὸν καὶ συνδετικὸν τῶν ἄκρων, ἕτερον ἐκείνων ὑπάρχον, ἐν οἷς ἡ ἐναντίωσις θεωρεῖται, κατὰ τὸ ποιῶδες, ἀλλ᾿ οὐ κατὰ τὴν σχέσιν αὐτῶν θεωρουμένη.", "seq": 3076}
{"id": "Simplicius_Passim_3077", "series": "CAG", "text": "τὰ μὲν οὖν ἐναντία διὰ τοῦτο παρῆκεν, τὸ δὲ μᾶλλον καὶ ἧττον προσήκατο ὡς οἰκεῖόν τισι τῶν πρός τι.", "seq": 3077}
{"id": "Simplicius_Passim_3078", "series": "CAG", "text": "ἐπεὶ γάρ ἐστίν τινα καὶ ἐν τῇ τοιαύτῃ κατηγορίᾳ ἐν τῷ γένει τοῦ ἀπείρου ὑφεστηκότα, ἐν ᾧ τὸ μᾶλλον καὶ ἧττον καὶ σφόδρα καὶ ἠρέμα καὶ τὰ τοιαῦτα πρόεισιν ἀορίστως ἐπιτεινόμενα καὶ ἀνιέμενα, εἰκότως ὡς αὐτῷ τῷ πρός τι συμφυὲς τὸ μᾶλλον καὶ ἧττον ὑποτίθεται·", "seq": 3078}
{"id": "Simplicius_Passim_3079", "series": "CAG", "text": "αὐτίκα τὸ μεῖζον καὶ ἧσσον, ἐφ᾿ ὧν αὐτὸς τὰ τοῦ μᾶλλον καὶ ἧττον παραδείγματα προεβάλετο, [ἃ] τῆς τοῦ ἀπείρου φύσεώς ἐστιν.", "seq": 3079}
{"id": "Simplicius_Passim_3080", "series": "CAG", "text": "ἐπειδὴ δὲ ἄλλα εἴδη τοῦ πρός τι τῷ πέρατί ἐστιν συγγενῆ, ὡρισμένην ἕξει τὴν κατηγορίαν ἐκεῖνα καὶ οὔτε ἄνεσιν οὔτε ἐπίτασιν ἐπιδέξεται·", "seq": 3080}
