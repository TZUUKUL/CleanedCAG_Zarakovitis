{"id": "Simplicius_Passim_1795", "series": "CAG", "text": "3b33 Δοκεῖ δὲ ἡ οὐσία οὐκ ἐπιδέχεσθαι τὸ μᾶλλον καὶ ἧττον ἕως τοῦ ὥστε οὐκ ἂν ἐπιδέχοιτο ἡ οὐσία τὸ μᾶλλον καὶ τὸ ἧττον.", "seq": 1795}
{"id": "Simplicius_Passim_1796", "series": "CAG", "text": "Ἕκαστον τῶν ὄντων γινώσκομεν ταῖς οἰκείαις διαφοραῖς καὶ ταῖς ἀντιδιῃρημέναις πρὸς αὐτάς·", "seq": 1796}
{"id": "Simplicius_Passim_1797", "series": "CAG", "text": "καὶ γὰρ αἱ μὲν οἰκεῖαι διαφοραὶ τὰ παρόντα καὶ τὰ συμβεβηκότα ἑκάστῳ δηλοῦσιν, αἱ δὲ ἀντιδιαιρούμεναι πρὸς αὐτὰς καὶ ἐν ἑτέραις οὖσαι ταῖς ἰδιότησιν τὰ χωρὶς ὄντα αὐτῶν ἰδιώματα ἐπιδεικνύουσιν, καὶ οὕτως τελεία γίνεται ἡ γνῶσις, ἐπειδὰν γνῶμεν τί τέ ἐστιν ἕκαστον καὶ τί οὐκ ἔστιν.", "seq": 1797}
{"id": "Simplicius_Passim_1798", "series": "CAG", "text": "καὶ ἐνταῦθα οὖν τὸ μὲν συνωνύμως λέγεσθαι ἀπὸ τῶν δευτέρων οὐσιῶν τὰ ἄλλα καὶ τὸ τόδε τι σημαίνειν καὶ ὅσα τοιαῦτα τὴν τοῦ ὑπάρχειν ἰδιότητα ἐδήλου, τὸ δὲ μηδὲν ἐναντίον εἶναι ταῖς οὐσίαις καὶ τὸ μὴ ἐπιδέχεσθαι τὸ μᾶλλον καὶ τὸ ἧττον ἐν τῷ μὴ ὑπάρχειν θεωρεῖται, καὶ γέγονεν οὕτως αὐτῶν ἡ θεωρία κατ᾿ ἀμφότερα τελεία.", "seq": 1798}
{"id": "Simplicius_Passim_1799", "series": "CAG", "text": "κατ᾿ ἄλλον δὲ αὖ τρόπον τὰ πεφυκότα κοινῶς ἐπὶ πλειόνων κατηγορεῖσθαι γενῶν, οἷα καὶ ἡ ἐναντίωσίς ἐστιν καὶ τὸ μᾶλλον καὶ τὸ ἧττον, δεῖ καθ᾿ ἕκαστον γένος ἐπισκοπεῖσθαι, πότερον ὑπάρχει αὐτῷ ταῦτα ἢ οὐχ ὑπάρχει.", "seq": 1799}
{"id": "Simplicius_Passim_1800", "series": "CAG", "text": "ἐπειδὴ δὲ ἐν τοῖς πρὸ τούτων εἰρημένοις μᾶλλον οὐσία ἐλέγετο τὸ εἶδος τοῦ γένους, νῦν δὲ λέγεται ἡ οὐσία μὴ ἐπιδέχεσθαι τὸ μᾶλλον καὶ τὸ ἧττον, εἰκότως ἐφιστάνει καὶ διαλύει τὴν ἔνστασιν, ὅτι οὐχ ὡσαύτως ἑκάτερον λέγεται, ἀλλὰ τὸ μὲν καθ᾿ αὑτό, τὸ δὲ κατὰ συμβεβηκός.", "seq": 1800}
{"id": "Simplicius_Passim_1801", "series": "CAG", "text": "μᾶλλον μὲν γὰρ τὸ εἶδος οὐσία ἢ τὸ γένος οὐχ ᾗ οὐσία οὐδὲ καθὸ ἔστιν, ἀλλ᾿ ᾗ ἐγγυτέρω τῆς ἀτόμου καὶ πρώτης οὐσίας προχωρεῖ τὸ εἶδος ἤπερ τὸ γένος.", "seq": 1801}
{"id": "Simplicius_Passim_1802", "series": "CAG", "text": "τοῦτο δὲ συμβέβηκεν ἄλλως, νυνὶ δὲ καθό ἐστιν ἑκάστη τοῦτο ὅπερ ἐστὶν οὔ φησι λέγεσθαι αὐτὴν μᾶλλον καὶ ἧττον·", "seq": 1802}
{"id": "Simplicius_Passim_1803", "series": "CAG", "text": "οὐκ ἄρα ἐναντία τὰ παρόντα τοῖς πρότερον εἴρηται.", "seq": 1803}
{"id": "Simplicius_Passim_1804", "series": "CAG", "text": "Ἀλλὰ καὶ ἡ χιὼν τοῦ κύκνου, φαίη ἄν τις, μᾶλλόν ἐστιν λευκή, καθόσον ἐγγυτέρω ἐστὶν τοῦ λευκοτάτου.", "seq": 1804}
{"id": "Simplicius_Passim_1805", "series": "CAG", "text": "ἢ κατὰ τοῦθ᾿ ὁμοίως ἕξει πρὸς τὴν οὐσίαν, κατὰ συμβεβηκὸς ἔχουσα τὸ μᾶλλον·", "seq": 1805}
{"id": "Simplicius_Passim_1806", "series": "CAG", "text": "καθόσον δὲ τὸ μετέχον τῆς ποιότητος ἢ μᾶλλον αὐτῆς μετέχει ἢ ἧττον, κατὰ τοσοῦτον αὐτὴ ἡ κατατεταγμένη ποιότης ἔχει τὸ μᾶλλον καὶ τὸ ἧττον.", "seq": 1806}
{"id": "Simplicius_Passim_1807", "series": "CAG", "text": "ἐπεισοδιώδης γὰρ ἡ ποιότης τῇ οὐσίᾳ, ἡ μέντοι οὐσία οὐκ ἐν ἄλλῳ γίνεταί τινι ὥστε μᾶλλον ἢ ἧττον μετέχεσθαι, ἀλλ᾿ ἐν αὐτῇ τὰ ἄλλα.", "seq": 1807}
{"id": "Simplicius_Passim_1808", "series": "CAG", "text": "διὰ τοῦτο οὖν τὴν μὲν κατὰ συμβεβηκὸς σύγκρισιν ἐπιδέχεται ἡ οὐσία, τὴν δὲ καθ᾿ αὑτό, ἥτις ἐν τοῖς ὁμοειδέσιν γίνεται, οὐκέτι.", "seq": 1808}
{"id": "Simplicius_Passim_1809", "series": "CAG", "text": "ὁ γὰρ ἄνθρωπος οὔτε ἄλλου ἀνθρώπου μᾶλλον ἄνθρωπος οὔτε αὐτὸς ἑαυτοῦ, ἀλλ᾿ οὐδὲ ὁ Σωκράτης ἐν Ἀκαδημίᾳ μᾶλλον Σωκράτης ἢ ἐν Δηλίῳ·", "seq": 1809}
{"id": "Simplicius_Passim_1810", "series": "CAG", "text": "τὸ μέντοι λευκὸν σῶμα καὶ ἄλλου σώματος λευκοῦ λευκότερον ἂν εἴη τῷ μᾶλλον μετέχειν τοῦ λευκοῦ, καὶ αὐτὸ αὑτοῦ μᾶλλον ἂν εἴη καὶ ἧττον λευκόν, κατ᾿ ἄλλον δηλονότι καὶ ἄλλον χρόνον, οὐ γὰρ δὴ κατὰ τὸν αὐτόν.", "seq": 1810}
{"id": "Simplicius_Passim_1811", "series": "CAG", "text": "τὸ δὲ λευκὸν τοῦ μέλανος οὐ λέγεται λευκότερον·", "seq": 1811}
{"id": "Simplicius_Passim_1812", "series": "CAG", "text": "λέγεται μὲν γὰρ ἀεὶ τὸ μᾶλλον πρὸς τὸ ἧττον, ἐπιτεινόμενον δὲ τὸ ἧττον εἰς τὸ ὅμοιον καταντᾷ, ἀλλ᾿ ἡ τοῦ μέλανος ἐπίτασις οὐδέποτε ὅμοιον τὸ μέλαν τῷ λευκῷ ποιεῖ, τοὐναντίον δὲ πλέον αὐτοῦ ἀφίστησιν, ὥστε οὐκ ἂν τὸ ἐναντίον πρὸς τὸ ἑαυτῷ ἐναντίον λαμβάνοι τὴν τοῦ μᾶλλον καὶ ἧττον σύγκρισιν, ἀλλ᾿ οὐδὲ πρὸς τὸ ἀνομοειδὲς κυρίως·", "seq": 1812}
{"id": "Simplicius_Passim_1813", "series": "CAG", "text": "τῶν γὰρ ὁμοειδῶν αἱ συγκρίσεις.", "seq": 1813}
{"id": "Simplicius_Passim_1814", "series": "CAG", "text": "εἰ τοίνυν ἐν ταῖς ὁμοειδέσιν οὐσίαις οὐκ ἔστιν ἡ κατὰ τὸ μᾶλλον καὶ ἧττον σύγκρισις, οὐδὲ ἐν οὐσίαις ὅλως ἔσται.", "seq": 1814}
{"id": "Simplicius_Passim_1815", "series": "CAG", "text": "Οὐ μὴν οὐδὲ τοῦτο ἴδιον τῆς οὐσίας ἐστίν.", "seq": 1815}
{"id": "Simplicius_Passim_1816", "series": "CAG", "text": "καὶ γὰρ ἐπὶ τῶν ἀριθμῶν καὶ τοῦ ὡρισμένου ποσοῦ οὐκ ἔστιν μᾶλλον τὰ τρία αὐτὰ ἑαυτῶν οὔτε ἄλλων·", "seq": 1816}
{"id": "Simplicius_Passim_1817", "series": "CAG", "text": "αὐτὰ μὲν γὰρ αὑτῶν οὐκ ἂν παραλλάττοι ὡρισμένα ἀεὶ ἐν τῷ αὐτῷ ποσῷ, τῶν δὲ τεσσάρων οὐκ ἔσται μᾶλλον, οὐδὲ γὰρ λέγεται πρὸς αὐτὰ μᾶλλον.", "seq": 1817}
{"id": "Simplicius_Passim_1818", "series": "CAG", "text": "καὶ ὅλως πᾶσα προσθήκη καὶ ἀφαίρεσις ποσοῦ ἑτερότητα ποιεῖ παντελῆ·", "seq": 1818}
{"id": "Simplicius_Passim_1819", "series": "CAG", "text": "οὐ γίνεται δὲ πρὸς τὸ ἕτερον, ἀλλὰ πρὸς τὸ αὐτὸ καὶ ὅμοιον ἡ ἐπίτασις.", "seq": 1819}
{"id": "Simplicius_Passim_1820", "series": "CAG", "text": "καὶ τῶν πρός τι δὲ ἔνια, οἷον τὸ ἴσον καὶ διπλάσιον καὶ ὁ πατὴρ καὶ τὰ τοιαῦτα, οὐκ ἐπιδέχεται τὸ μᾶλλον καὶ τὸ ἧττον.", "seq": 1820}
{"id": "Simplicius_Passim_1821", "series": "CAG", "text": "καὶ ἐν τῷ ποιῷ δὲ τὰ σχήματα οὔτε μᾶλλον οὔτε ἧττόν ἐστιν.", "seq": 1821}
{"id": "Simplicius_Passim_1822", "series": "CAG", "text": "διὰ πάντα δὴ οὖν ταῦτα οὔτε ὑπάρχει τῇ οὐσίᾳ τὸ μᾶλλον καὶ τὸ ἧττον οὔτε ἴδιον αὐτῆς τὸ μὴ ὑπάρχειν ἐστίν.", "seq": 1822}
{"id": "Simplicius_Passim_1823", "series": "CAG", "text": "Ἀπορήσειε δ᾿ ἄν τις, εἰ ὁ μᾶλλον λογικὸς οὐ μᾶλλόν ἐστιν ἄνθρωπος.", "seq": 1823}
{"id": "Simplicius_Passim_1824", "series": "CAG", "text": "ἢ πρῶτον μὲν οὐ κατὰ τὴν οὐσίαν ἔχει τὸ μᾶλλον λογικόν, ἀλλὰ κατὰ τὴν ἕξιν ἢ κατὰ τὴν ἐνέργειαν.", "seq": 1824}
{"id": "Simplicius_Passim_1825", "series": "CAG", "text": "ἔπειτα οὐδὲν ἄτοπον τὰς μὲν συντρεχούσας τοῖς εἴδεσι ποιότητας, οἷον τὴν λογικὴν ἐπὶ ἀνθρώπου καὶ τὴν θερμότητα ἐπὶ πυρός, δέχεσθαι τὸ μᾶλλον καὶ ἧττον, οὐ μέντοι τὸ εἶδος αὐτό, ἐπεὶ καὶ ὁ σπουδαῖος, ὅταν μᾶλλον ἄνθρωπος λέγηται, οὐχ ᾗ ἄνθρωπος, ἀλλ᾿ ᾗ οὕτως διακείμενος, ταύτῃ ἐπιτείνεται·", "seq": 1825}
