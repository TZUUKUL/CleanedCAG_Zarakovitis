{"id": "Simplicius_Passim_4428", "series": "CAG", "text": "καὶ γὰρ τῇ χιόνι τὸ λευκὸν καὶ τῷ κόρακι τὸ μέλαν παραγίνεται κατά τι πάθος προηγησάμενον, ὃ ἐν τῇ φυσικῇ συστάσει ὑπάρχει.", "seq": 4428}
{"id": "Simplicius_Passim_4429", "series": "CAG", "text": "καὶ μή τις οἰέσθω με λέγειν ὅτι ἡ τροπὴ αὕτη ἡ προηγησαμένη καὶ ἡ κίνησις τὰ χρώματα ποιεῖ, ἀλλ᾿ οἱ μὲν λόγοι τῶν χρωμάτων ἐν τῇ φύσει ἑστήκασιν, τὰ δὲ τρεπόμενα κατὰ τὴν τῆς τροπῆς πρὸς τοὺς λόγους οἰκειότητα μεταλαμβάνει τῶν λόγων καὶ εἰδοποιεῖται ἀπ᾿ αὐτῶν.", "seq": 4429}
{"id": "Simplicius_Passim_4430", "series": "CAG", "text": "ἄλλος γάρ ἐστιν αὐτὸς ὁ λόγος ὁ ἑστὼς καὶ ἄλλο τὸ ὑποκείμενον (ἁπλᾶ ταῦτα), καὶ ἄλλο τὸ ἐκ τοῦ ὑποκειμένου καὶ τῆς τοῦ λόγου μεθέξεως συγκείμενον, ἐν ᾧ καὶ ἡ τροπὴ καὶ τὸ πάθος θεωρεῖται·", "seq": 4430}
{"id": "Simplicius_Passim_4431", "series": "CAG", "text": "τὸ γὰρ ἁπλοῦν οὐκ ἄν τι πάθοι καθ᾿ ἑαυτό.", "seq": 4431}
{"id": "Simplicius_Passim_4432", "series": "CAG", "text": "καὶ ἐν τοῖς ὠχριῶσιν οὖν ἢ ἐρυθριῶσιν οὐχὶ ἡ τροπὴ τὸ χρῶμα ποιεῖ, ἀλλὰ τὸ ἴδιον τοῦ αἵματος χρῶμα μεθίστησιν ποτὲ μὲν ἐπὶ τὸ ἐντός, ποτὲ δὲ ἐπὶ τὸ ἐκτός.", "seq": 4432}
{"id": "Simplicius_Passim_4433", "series": "CAG", "text": "κἂν λέγῃ οὖν ἀπὸ πάθους ἐγγίνεσθαι τὰ χρώματα, οὐδὲν ἄλλο λέγει ἢ ὅτι διὰ τῶν παθῶν ἐπιτήδεια γίνεται τὰ σώματα εἰς καταδοχὴν τῶν τοιούτων χρωμάτων.", "seq": 4433}
{"id": "Simplicius_Passim_4434", "series": "CAG", "text": "Ἀλλὰ πῶς, φησὶν Εὔδωρος, ἐν μὲν τῷ πρώτῳ εἴδει τῆς ποιότητος θερμότητας καὶ ψύξεις καὶ νόσον καὶ ὑγείαν ἐν ταῖς διαθέσεσι κατηρίθμησεν, ἐνταῦθα δὲ ὡς εἰς ἄλλο εἶδος τὴν παθητικὴν ποιότητα αὐτὰς καταλέγει;", "seq": 4434}
{"id": "Simplicius_Passim_4435", "series": "CAG", "text": "ἢ φήσομεν ὡς ἐκεῖ μὲν κατὰ τὸ διακεῖσθαι οὕτω καὶ πῶς ἔχειν θέσεως κατὰ τὸ θερμὸν καὶ ψυχρὸν ἐλαμβάνετο, ἐνταῦθα δὲ κατὰ τὸ πάθος ἐμποιεῖν εἰς ἄλλο ἡ παθητικὴ ποιότης θεωρεῖται.", "seq": 4435}
{"id": "Simplicius_Passim_4436", "series": "CAG", "text": "τὸ δὲ αὐτὸ κατ᾿ ἄλλο καὶ ἄλλο λαμβανόμενον οὐδὲν κωλύει ὑπ᾿ ἄλλο τάττεσθαι καὶ ἄλλο εἶδος, ὡς ὁ Σωκράτης καθὸ μὲν ἄνθρωπος οὐσία ἂν εἴη, καθὸ δὲ πατὴρ τῶν πρός τι·", "seq": 4436}
{"id": "Simplicius_Passim_4437", "series": "CAG", "text": "καὶ ἡ θερμότης οὖν, καθὸ μὲν διατίθησί πως τὸ ὑποκείμενον, διάθεσις ἂν εἴη, καθὸ δὲ θερμαίνει τὴν αἴσθησιν, παθητικὴ ποιότης.", "seq": 4437}
{"id": "Simplicius_Passim_4438", "series": "CAG", "text": "καὶ κατ᾿ ἄλλον δὲ τρόπον ἐν διαφόροις εἴδεσίν ἐστιν ἡ αὐτή, διότι κατὰ μὲν τὴν ἰδιότητα καὶ τὸν χαρακτῆρα ἡ διάθεσις θεωρεῖται, κατὰ δὲ τὴν ἔμμονον τροπὴν τοῦ πάθους ἡ παθητικὴ ποιότης.", "seq": 4438}
{"id": "Simplicius_Passim_4439", "series": "CAG", "text": "Ἀλλὰ πῶς ἐκεῖ τὰ ταχὺ μεταβάλλοντα εἰπὼν διαθέσεις ἐνταῦθα τὰ ταχὺ μεταβάλλοντα πάθη μὲν λέγει, οὐκέτι δὲ ποιότητας;", "seq": 4439}
{"id": "Simplicius_Passim_4440", "series": "CAG", "text": "ἢ ὅτι τῶν εὐκινήτων τὰ μέν ἐστιν διαθέσεις, αἵτινες διὰ τοῦτο καὶ ποιότητές εἰσιν καὶ χαρακτῆρα φέρουσιν τοῦ διακειμένου, αἱ δὲ εὐανάλυτοι κινήσεις, αἵτινες ἐν τοῖς πάθεσιν θεωροῦνται μόνοις·", "seq": 4440}
{"id": "Simplicius_Passim_4441", "series": "CAG", "text": "διὸ καὶ πάθη καλοῦνται καὶ οὐκ ἀξιοῦνται τοῦ τῆς ποιότητος ὀνόματος, ἐπειδὴ οὐδὲ λέγονται κατ᾿ αὐτὰς ποιοὶ οἱ πάσχοντες.", "seq": 4441}
{"id": "Simplicius_Passim_4442", "series": "CAG", "text": "οὐδὲν οὖν ἄτοπον, εἰ τὸ μὲν ὑπὸ τὴν ποιότητα τάττεται, τὸ δὲ οὔ.", "seq": 4442}
{"id": "Simplicius_Passim_4443", "series": "CAG", "text": "Ἐπιστάσεως δὲ καὶ πάλιν ἄξιον, πῶς ὑπὸ τὴν ποιότητα τάξας τὰ πάθη, εἴπερ τρίτον εἶδος ποιότητος παθητικαὶ ποιότητές φησιν καὶ πάθη, ὅμως ὕστερον πάθη μέν φησιν τὰ τοιαῦτα λέγεται, ποιότητες δὲ οὔ.", "seq": 4443}
{"id": "Simplicius_Passim_4444", "series": "CAG", "text": "καὶ γὰρ τινὲς μὲν οἴονται ἐλλιπῶς εἰρῆσθαι τὸ ποιότητες δὲ οὔ·", "seq": 4444}
{"id": "Simplicius_Passim_4445", "series": "CAG", "text": "λείπειν γὰρ τὸ ‘οὔκ εἰσιν παθητικαί’, ὡς εἶναι μὲν αὐτὰς ποιότητας, παθητικὰς δὲ οὔ·", "seq": 4445}
{"id": "Simplicius_Passim_4446", "series": "CAG", "text": "ἄλλοι δὲ ἐπὶ ταὐτὸν οἴονται φέρειν αὐτὸν τὰ πάθη καὶ τὰς παθητικὰς ποιότητας, καίτοι σαφῶς οὕτως διορίζοντα.", "seq": 4446}
{"id": "Simplicius_Passim_4447", "series": "CAG", "text": "ἀλλ᾿ ἴσως ὡς ὑποπῖπτον τὸ πάθος ὑπὸ τὴν παθητικὴν ποιότητα κατά τι σύμπτωμα αὐτῆς πρόσκαιρον, οὕτως αὐτὸ ὑποτάττεσθαι αὐτῇ φησιν.", "seq": 4447}
{"id": "Simplicius_Passim_4448", "series": "CAG", "text": "Ἀλέξανδρος δὲ οὐδὲ ζητεῖν ἀξιοῖ, εἰ τὰ πάθη ὑπὸ τὴν ποιότητα·", "seq": 4448}
{"id": "Simplicius_Passim_4449", "series": "CAG", "text": "αὐτὸς γὰρ ὁ Ἀριστοτέλης οὐ μόνον τὰς παθητικὰς ποιότητας, ἀλλὰ καὶ τὰ πάθη ὑπὸ τὸ αὐτὸ εἶδος ἔταξεν εἰπὼν τρίτον δὲ γένος παθητικαὶ ποιότητες καὶ πάθη·", "seq": 4449}
{"id": "Simplicius_Passim_4450", "series": "CAG", "text": "οὐ γὰρ εὔλογον εἰς ταὐτὸν ἄγειν αὐτὰ μέλλοντα λέγειν αὐτῶν τὴν διαφοράν.", "seq": 4450}
{"id": "Simplicius_Passim_4451", "series": "CAG", "text": "διὰ γὰρ τούτων εἶδος τῆς ποιότητος καὶ τὸ πάθος ἀφορίζεται, ὥστε καὶ ποιότητα·", "seq": 4451}
{"id": "Simplicius_Passim_4452", "series": "CAG", "text": "τοῖς γὰρ εἴδεσιν ὑπάρχει τὰ ὀνόματα τῶν γενῶν.", "seq": 4452}
{"id": "Simplicius_Passim_4453", "series": "CAG", "text": "ἀλλ᾿ ὅτι μὲν ποιότητας ἁπλῶς λέγειν τὰ πάθη σαφῶς μαχομένων ἐστὶν πρὸς τὴν Ἀριστοτέλους λέξιν, πρόδηλον, εἰπόντος ὥστε πάθη μὲν τὰ τοιαῦτα λέγεται, ποιότητες δὲ οὔ.", "seq": 4453}
{"id": "Simplicius_Passim_4454", "series": "CAG", "text": "ἀλλὰ καὶ τὸ πάντῃ τῆς ποιότητος ἐξορίζειν τὰ πάθη, καὶ τοῦτο μάχεται τῷ ἓν γένος ποιότητος εἰπεῖν καὶ τὰ πάθη.", "seq": 4454}
{"id": "Simplicius_Passim_4455", "series": "CAG", "text": "ἀλλὰ καὶ τὸ τὰ πάθη εἰς ταὐτὸν ἄγειν ταῖς παθητικαῖς ποιότησιν ἐναργῶς ἄτοπον, οὕτως αὐτὰ σαφῶς τοῦ Ἀριστοτέλους διακρίνοντος.", "seq": 4455}
{"id": "Simplicius_Passim_4456", "series": "CAG", "text": "μήποτε οὖν παθητικὴ μὲν ποιότης, ᾗ μὲν ποιότης, οὐκ ἔστιν τὸ πάθος, συγγενῶς δὲ ἔχει πρὸς αὐτήν.", "seq": 4456}
{"id": "Simplicius_Passim_4457", "series": "CAG", "text": "οὐδὲ γὰρ ἐπινοῆσαι οὐδὲ ὀνομάσαι δυνατὸν παθητικὴν ποιότητα ἄνευ πάθους.", "seq": 4457}
{"id": "Simplicius_Passim_4458", "series": "CAG", "text": "ἔοικεν γάρ πως ἀτελὲς εἶδος εἶναι τῆς παθητικῆς ποιότητος τὸ πάθος, οὗ τελειότης ἐστὶν ἡ παθητικὴ ποιότης.", "seq": 4458}
{"id": "Simplicius_Passim_4459", "series": "CAG", "text": "ὥσπερ οὖν ἡ διάθεσις τῇ ἕξει συνεπλάκη, οὕτως καὶ ἐνταῦθα τὸ πάθος τῇ παθητικῇ ποιότητι συνέζευξεν·", "seq": 4459}
{"id": "Simplicius_Passim_4460", "series": "CAG", "text": "ὡς γὰρ ἡ διάθεσις προηγεῖται τῆς ἕξεως, οὕτως καὶ τὸ πάθος οἷον ὑπόθεσίς ἐστιν τῆς παθητικῆς ποιότητος.", "seq": 4460}
{"id": "Simplicius_Passim_4461", "series": "CAG", "text": "διὸ καθ᾿ ὅσον μὲν ὡς ἀτελῆ προηγεῖται καὶ ἀπὸ τούτων ἐπ᾿ ἐκεῖνα ἡ μετάβασις, ταύτῃ οὐκ ἀφίστησιν αὐτὰ τῶν ποιοτήτων·", "seq": 4461}
{"id": "Simplicius_Passim_4462", "series": "CAG", "text": "διότι δὲ ἀπολείπεται τῆς ἐν αὐταῖς τελειότητος τῇ τε φύσει τῶν εἰδῶν καὶ τῇ μονίμῳ καταστάσει, ταύτῃ χωρίζει αὐτὰ ὡς ἕτερα.", "seq": 4462}
{"id": "Simplicius_Passim_4463", "series": "CAG", "text": "Λέγοντος δὲ τοῦ Ἀριστοτέλους ὥσπερ τὰ ὀλιγοχρόνια χρώματα ἀπὸ πάθους γίνεται, οὕτως καὶ τὰ πολυχρόνια ἀπὸ τοῦ αὐτοῦ συμβαίνειν, ἄλογον νομίζουσιν οἱ περὶ τὸν Νικόστρατον τὸ πάντα τὰ χρώματα πάθους ἐγγινομένου γίνεσθαι καὶ μάλιστα τὰ σύμφυτα καὶ οὐσιώδη, ὥσπερ τὸ τῆς χιόνος·", "seq": 4463}
{"id": "Simplicius_Passim_4464", "series": "CAG", "text": "ἐν γὰρ τοῖς παραδείγμασιν τοῖς ἀπὸ τοῦ φόβου καὶ τῆς αἰσχύνης ὡς ἐπιγινόμενα τὰ πάθη παρέθετο, ὥστε καὶ ἐπὶ πάντων οὕτως ἔοικεν δοξάζειν.", "seq": 4464}
{"id": "Simplicius_Passim_4465", "series": "CAG", "text": "ἢ εἰ τοῖς χυμοῖς τοῖς περὶ τὸ σῶμα, ὁποῖοί ποτε ἂν ὦσιν μέχρι τῆς ἐπιφανείας διατείνοντες, συνέπεται τὰ χρώματα παραπλήσια αὐτοῖς φαινόμενα, τρέπονται δὲ οἱ χυμοὶ ὑπὸ τῶν παθῶν, εὔλογον καὶ τὰ χρώματα συνακολουθεῖν ταῖς τροπαῖς ἢ ταῖς ποιαῖς κράσεσι τῶν σωμάτων.", "seq": 4465}
{"id": "Simplicius_Passim_4466", "series": "CAG", "text": "οὐ μέντοι οὐδὲ τοῦτό φησιν, ὅτι αἱ σύμφυτοι χρόαι ἔξωθεν ἐπιγίνονται οἷον τῇ χιόνι ἡ λευκότης, ἀλλ᾿ ὅτι εἴ τις νοήσειεν τὴν πρώτην σύστασιν τῆς χιόνος ὅπως ἐξ ἀρχῆς γέγονεν, εὑρήσει τὸ σωματοειδὲς αὐτῆς καὶ ὑποκείμενον κατὰ τὴν ποιὰν τροπὴν καὶ ποιὰν κρᾶσιν τὸ τοιόνδε χρῶμα εἰληφός.", "seq": 4466}
{"id": "Simplicius_Passim_4467", "series": "CAG", "text": "ὑπομνήσειε δ᾿ ἄν τις τοῦτο καὶ ἀπὸ τῶν ὁρωμένων·", "seq": 4467}
{"id": "Simplicius_Passim_4468", "series": "CAG", "text": "ὥσπερ γὰρ τὰ φαινόμενα χρώματα ταῖς ποιαῖς κράσεσι τῶν σωμάτων ἀφομοιοῦται, οὕτως ἔχει καὶ ἐπὶ τῶν ἄλλων, κἂν φυσικῶς γίνωνται.", "seq": 4468}
{"id": "Simplicius_Passim_4469", "series": "CAG", "text": "εἰσὶν δέ τινες οἳ τὰς συμφύτους ταύτας ποιότητας οὔ φασιν εἶναι πάθη ἢ παθητικὰς ποιότητας, ἀλλὰ μέρη οὐσιῶν καὶ οὐσίας.", "seq": 4469}
{"id": "Simplicius_Passim_4470", "series": "CAG", "text": "δῆλον οὖν ὅτι οὗτοι οὐδὲ τὴν ἀρχὴν παραδέχονται τὰ περὶ τῶν συμφύτων χροιῶν ἠπορημένα.", "seq": 4470}
{"id": "Simplicius_Passim_4471", "series": "CAG", "text": "Ἀνδρόνικος δὲ ἠξίου μὴ διαιρεῖσθαι τὰς παθητικὰς ποιότητας εἰς τὸ ἐμποιεῖν πάθη καὶ εἰς τὸ ἐκ πάθους συνίστασθαι, ἀλλὰ πάσας ὡς ἐκ πάθους συνισταμένας παθητικὰς εἶναι, τὸ δὲ πάθους ποιητικαῖς εἶναι συμβαίνειν αὐταῖς·", "seq": 4471}
{"id": "Simplicius_Passim_4472", "series": "CAG", "text": "“τὸ γὰρ θερμὸν θερμαίνειν δύναται·", "seq": 4472}
{"id": "Simplicius_Passim_4473", "series": "CAG", "text": "ἀλλὰ καθ᾿ ὅσον εἰς ἄλλα ποιεῖ, οὐ ποιὰ ἀλλὰ ποιητικὰ καλοῦμεν αὐτά, οἷον οὐ θερμὰ ἀλλὰ θερμαντικά, ἅπερ ἤδη πρός τι, καθάπερ τὸ καυστικὸν καὶ τὸ καυστὸν καὶ τὰ ὅμοια.", "seq": 4473}
{"id": "Simplicius_Passim_4474", "series": "CAG", "text": "διὸ θερμὸν μὲν ἔστιν καὶ μηδενὸς ὄντος θερμαντοῦ, θερμαντικὸν δὲ οὐκέτι·", "seq": 4474}
{"id": "Simplicius_Passim_4475", "series": "CAG", "text": "ποιὰ γὰρ κατὰ τὸ πῶς ἔχειν, ἀλλ᾿ οὐ κατὰ τὸ πρός τι λέγεται”.", "seq": 4475}
{"id": "Simplicius_Passim_4476", "series": "CAG", "text": "πρὸς δὴ τοῦτο καλῶς ἠπορημένον ῥητέον ὅτι τὰς ἐν ταῖς αἰσθήσεσι γινομένας παθητικὰς ποιότητας οὐ καθ᾿ ὅσον ἐκ ποιοῦντός τινος καὶ πάσχοντος συνίστανται, κατὰ τοῦτο δεῖ θεωρεῖν, οὐδὲ καθ᾿ ὅσον πρὸς ἀντιστρέφοντα λέγονται, ἀλλὰ τὸ ἁπλοῦν καὶ ἁπλωτὸν εἶδος τοῦ πάθους αὐτὸ καθ᾿ αὑτὸ νοεῖν ὡς ποιότητα, μηδὲν ἐφαπτομένους τῆς τοῦ ποιοῦντος εἰς αὐτὸ ἐνεργείας καὶ συζεύξεως·", "seq": 4476}
{"id": "Simplicius_Passim_4477", "series": "CAG", "text": "ποιὸν γὰρ τοῦτο τὸ εἶδος κεχωρισμένον τῶν πρός τι καὶ ἄλλο εἶδος παρὰ τὰ δεδεγμένα τὸ πάθος, αἰσθητικόν τι καὶ ἀφομοιωτικὸν πρὸς τὰ πρωτουργὰ πάθη, διὸ καὶ ἀντιδιαιρεῖται πρὸς τὰς ἀπὸ πάθους ἐγγινομένας παθητικὰς ποιότητας.", "seq": 4477}
{"id": "Simplicius_Passim_4478", "series": "CAG", "text": "Φέρεται δέ τις καὶ τοιαύτη πρὸς τὰ εἰρημένα ἀντίληψις, τὸ πάθος ἐμποιεῖν ἢ καὶ ἐκ πάθους ἐγγεγονέναι τὴν παθητικὴν ποιότητα σχέσιν μόνον ἐμφαίνειν κατὰ τὸ ἔκ τινος ἐγγεγονέναι ἢ εἴς τι ἐμποιεῖν, αὐτὸ δὲ μὴ λέγειν ὅτι ποτέ ἐστιν ἡ παθητικὴ ποιότης.", "seq": 4478}
{"id": "Simplicius_Passim_4479", "series": "CAG", "text": "ἡμεῖς δὲ καὶ πρὸς τοῦτο ἐροῦμεν ὡς οὐκ ἔστιν ἐκ τῆς σχέσεως ἠρτημένη ἡ παθητικὴ ποιότης, ἀλλ᾿ αὕτη μὲν ἄλλως ἐπισυμβαίνει, τὸ δὲ ἴδιον τῆς παθητικῆς ποιότητος κατ᾿ αὐτὴν τὴν μεταβολὴν θεωρεῖται, οὐ τὴν κατὰ τὸ εἶναι (τοῦτο γὰρ οὐκ ἔστιν ποιότητος), ἀλλὰ μετὰ τὸ προϋποκεῖσθαι τὴν οὐσίαν ἐπιγινόμενον αὐτῇ, ὥσπερ καὶ ἡ ποιότης τῷ εἶναι ἐπεισέρχεται.", "seq": 4479}
{"id": "Simplicius_Passim_4480", "series": "CAG", "text": "τοιαῦτα καὶ περὶ τῶν ἀποριῶν εἰρήσθω.", "seq": 4480}
{"id": "Simplicius_Passim_4481", "series": "CAG", "text": "Διαφέρουσιν δὲ αἱ τρίται ποιότητες αὗται τῶν μὲν πρώτων, ὡς καὶ Πορφύριος καὶ Ἰάμβλιχός φασιν, ὅτι ἐκεῖναι μὲν ἐκ διδασκαλίας τὸ τέλειον ἔχουσιν, αὗται δὲ φύσει ὑπάρχουσιν.", "seq": 4481}
{"id": "Simplicius_Passim_4482", "series": "CAG", "text": "μήποτε δὲ καὶ τὰ φύσει παρείληπται ἐν ἐκείναις, ὥσπερ θερμότης καὶ ψύξις καὶ τὰ τοιαῦτα, ἡ δὲ διαφορὰ τῶν ἐνταῦθα μὲν κατὰ πάθος εἶναι, ἐκεῖ δὲ κατὰ διάθεσιν καὶ ἕξιν.", "seq": 4482}
{"id": "Simplicius_Passim_4483", "series": "CAG", "text": "τῶν δὲ δευτέρων διαφέρει, καθ᾿ ὅσον ἐκεῖναι μὲν ἐν τῷ δυνάμει ἐθεωροῦντο καὶ ἐπιτηδειότητες ἦσαν, αὗται δὲ ἐντελέχειαι μᾶλλόν εἰσιν καὶ κατ᾿ εἶδός τι ἤδη ὑφεστήκασιν.", "seq": 4483}
{"id": "Simplicius_Passim_4484", "series": "CAG", "text": "Τάξιν δὲ εἴ τις ποθεῖ μαθεῖν αὐτῶν, ῥητέον ὡς ἡ ἐκ πάθους καὶ μεταβολῆς εἰδοποιία ἀπολείπεται τῶν πρώτων καὶ αὐτοφυῶν ποιοτήτων, ὅσαι τέ εἰσιν κατ᾿ ἐνέργειαν καὶ ὅσαι κατὰ φυσικὴν δύναμιν πρώτως συνίστανται καὶ κατὰ κίνησιν ἑτεροιώσεις.", "seq": 4484}
{"id": "Simplicius_Passim_4485", "series": "CAG", "text": "ὁ μέντοι Ἀρχύτας ἔοικεν προτάξαι τὸ κατὰ τὸ πάθος εἶδος τῆς ποιότητος τοῦ κατὰ τὸ δυνάμει, καὶ ἴσως τοῦτο μᾶλλον ἔχει λόγον, διότι τὸ ἐνεργείᾳ προηγεῖσθαι χρὴ τοῦ δυνάμει, ὁποῖόν ποτε ἂν ᾖ.", "seq": 4485}
{"id": "Simplicius_Passim_4486", "series": "CAG", "text": "Καὶ τοῦτο δὲ ἰστέον, ὅτι τὸ ὅλον εἶδος τοῦτο τῆς ποιότητος ὁ Ἀρχύτας ἐν τῷ πάθει κυρίως εἰδοποιεῖ καὶ τοῦτο αὐτοῦ κοινὸν στοιχεῖον ἀπέδωκεν, ὁμοῦ μὲν ἐν κοινῷ περιλαβὼν ὅρῳ τάς τε παθητικὰς ποιότητας καὶ τὰ πάθη καὶ ταύτῃ τὰ πολλὰ τῶν ἀπόρων διαφυγών, ὁμοῦ δὲ καὶ τὴν φύσιν αὐτῶν ὡρισμένως περιλαβών·", "seq": 4486}
{"id": "Simplicius_Passim_4487", "series": "CAG", "text": "οὐ γάρ ἐστιν τὸ εἶδος τοῦτο τῆς ποιότητος καθαρὸν ὕλης καὶ σώματος οὐδὲ ἐν εἴδει παγίως ἱστάμενον, ἀλλ᾿ ἔοικεν μέση τις εἶναι φύσις τῶν τε σωμάτων καὶ τῶν εἰδῶν, κατὰ μὲν τὸ πάσχειν τοῖς σώμασι προσεοικυῖα, κατὰ δὲ τὸ γενέσθαι εἶδος ἀπὸ τοῦ πάθους ἢ μορφὴν προσλαμβάνειν ἐν ἑαυτῷ ἀπὸ τοῦ εἴδους, ταύτῃ δὲ τῷ λόγῳ συγγενὴς ὑπάρχουσα.", "seq": 4487}
{"id": "Simplicius_Passim_4488", "series": "CAG", "text": "Καὶ ὅτι μὲν τροπή τις καὶ ἀλλοίωσις θεωρεῖται κατὰ τὰς τοιαύτας ποιότητας, πρόδηλον·", "seq": 4488}
{"id": "Simplicius_Passim_4489", "series": "CAG", "text": "ὁρᾶται γὰρ τοῦτο·", "seq": 4489}
{"id": "Simplicius_Passim_4490", "series": "CAG", "text": "ἀλλ᾿ ἐκεῖνο ζητήσεως ἄξιον, μήποτε οὐκ ἔστιν ἡ τοιαύτη τροπὴ αἰτία τῶν τοιούτων ποιοτήτων, ἀλλ᾿ αὐτὴ μὲν τῶν ὧν οὐκ ἄνευ λόγον παρέχεται, ἡ δὲ ἐν αὐτῇ θεωρουμένη μορφὴ τὴν ποιότητα κυρίως συνίστησιν.", "seq": 4490}
{"id": "Simplicius_Passim_4491", "series": "CAG", "text": "ἡ γὰρ κίνησις ὡς ἐν ὕλης τάξει προϋπόκειται καὶ ὑπουργεῖ τῇ προηγουμένῃ αἰτίᾳ, ἥτις ἐστὶν ἡ ἀπὸ τοῦ λόγου κατιοῦσα μοῖρα καὶ μορφοῦσα τὴν ἀόριστον κίνησιν·", "seq": 4491}
{"id": "Simplicius_Passim_4492", "series": "CAG", "text": "καὶ αὐτὴ μὲν οὔτε πάσχει οὔτε ἀλλοιοῦται, ἤτοι δὲ ἐμποιεῖ πάθος ἢ ἐπὶ πάθει προηγουμένως συνίσταται.", "seq": 4492}
{"id": "Simplicius_Passim_4493", "series": "CAG", "text": "μήποτε δὲ ἀληθέστερον εἰπεῖν ὅτι κατ᾿ αὐτὴν γίνεται τὸ πάθος ἐν τῷ ὑποκειμένῳ.", "seq": 4493}
{"id": "Simplicius_Passim_4494", "series": "CAG", "text": "καὶ ἐπὶ τῶν χρωμάτων οὖν τροπαὶ μὲν γίνονται περὶ τὸ σύνθετον σῶμα, οἱ δὲ λόγοι εἰσὶν ἑκάστων χρωμάτων ἐν τῇ φύσει, ὧν δόσις γίνεται καὶ μετοχὴ ἐν τῷ χροιᾶς μεταλαμβάνειν τὰ σώματα.", "seq": 4494}
{"id": "Simplicius_Passim_4495", "series": "CAG", "text": "Ἀλλὰ τί ποτέ ἐστιν τὸ πάθος τοῦτο, ζητεῖν ἄξιον.", "seq": 4495}
{"id": "Simplicius_Passim_4496", "series": "CAG", "text": "λέγεται γὰρ πάθος ἢ τὸ ἀναιρετικὸν τῆς οὐσίας, ὡς ἡ σῆψις σώματος φθορὰν ἐπάγουσα τῷ σηπομένῳ, ἢ τὸ τούτῳ ἀντίθετον τὸ συνέχον διὰ τῆς μεταβολῆς ἐν τῷ κατὰ φύσιν τὸ ὑποκείμενον, ὡς τὰς αἰσθήσεις τὰ κατ᾿ αὐτὰς πάθη συνέχει ὡς αἰσθητικάς·", "seq": 4496}
{"id": "Simplicius_Passim_4497", "series": "CAG", "text": "ἄλλως δὲ πάθος λέγεται καὶ ἡ ἀπὸ τοῦ δυνάμει εἰς ἐνέργειαν μεταβολή, ὡς ὅταν ὁ κηρὸς εἰς παντοῖα σχήματα μεταπλαττόμενος πάσχειν λέγηται.", "seq": 4497}
{"id": "Simplicius_Passim_4498", "series": "CAG", "text": "δυνατὸν δὲ τὰ πάθη καὶ κατὰ τὰ εἴδη τῶν κινήσεων διαιρεῖν·", "seq": 4498}
{"id": "Simplicius_Passim_4499", "series": "CAG", "text": "ἢ γὰρ κατ᾿ οὐσίαν γίνεται τὰ πάθη ἢ κατὰ τὸ ποσόν, ἀλλ᾿ οὔτε τὸ κατ᾿ οὐσίαν οὔτε τὸ κατὰ ποσὸν προσήκει τῷ νῦν ζητουμένῳ πάθει, ἀλλ᾿ οὐδὲ πᾶν τὸ κατὰ ποιόν, εἴπερ ἓν εἶδος ποιότητος ἀφώρισται τοῦτο·", "seq": 4499}
{"id": "Simplicius_Passim_4500", "series": "CAG", "text": "ἀλλ᾿, εἴπερ ἄρα, ἐν τῷ γίνεσθαι τὰ τοιαῦτά ἐστιν πάθη καὶ ἐν τῷ μεταβάλλειν εἰς τὰς κατ᾿ ἐνέργειαν παθητικὰς ποιότητας·", "seq": 4500}
{"id": "Simplicius_Passim_4501", "series": "CAG", "text": "ἀφορμαὶ γάρ εἰσιν καὶ οἷον ὑποκατασκευαὶ τῶν παθητικῶν ποιοτήτων.", "seq": 4501}
{"id": "Simplicius_Passim_4502", "series": "CAG", "text": "διὸ καὶ ἐν τῇ Μετὰ τὰ φυσικὰ τὸ πάθος διαιρούμενος “πάθος, φησίν, λέγεται ἕνα μὲν τρόπον ἡ ποιότης, καθ᾿ ἣν ἀλλοιοῦσθαι ἐνδέχεται, οἷον τὸ λευκὸν καὶ τὸ μέλαν καὶ γλυκὺ καὶ πικρὸν καὶ βαρύτης καὶ κουφότης καὶ ὅσα ἄλλα τοιαῦτα·", "seq": 4502}
{"id": "Simplicius_Passim_4503", "series": "CAG", "text": "ἕνα δὲ αἱ τούτων ἐνέργειαι καὶ ἀλλοιώσεις·", "seq": 4503}
{"id": "Simplicius_Passim_4504", "series": "CAG", "text": "ἔτι δὲ τούτων μᾶλλον αἱ βλαβεραὶ ἀλλοιώσεις καὶ κινήσεις, καὶ μάλιστα αἱ λυπηραὶ βλάβαι·", "seq": 4504}
{"id": "Simplicius_Passim_4505", "series": "CAG", "text": "ἔτι τὰ μεγέθη τῶν συμφορῶν καὶ λυπηρῶν πάθη λέγεται”.", "seq": 4505}
{"id": "Simplicius_Passim_4506", "series": "CAG", "text": "ἐν γὰρ τούτοις ὀρθῶς τὴν ἀλλοίωσιν καὶ τὴν κατ᾿ ἐνέργειαν ἀλλοίωσιν βλάβην τε καὶ κίνησιν καὶ τὰ τοιαῦτα ὡς κινήσεις ὑπήγαγεν ὑπὸ τὸ πάθος.", "seq": 4506}
{"id": "Simplicius_Passim_4507", "series": "CAG", "text": "καὶ ἐντεῦθεν δὲ καταφαίνεται ὡς εἰκότως οὐκ ἀπέκρινεν τὰ πάθη τῶν ποιοτήτων·", "seq": 4507}
{"id": "Simplicius_Passim_4508", "series": "CAG", "text": "περὶ γὰρ τὴν ἀλλοίωσιν καὶ κίνησιν τῶν παθῶν ὑφίστανται αἱ παθητικαὶ ποιότητες καὶ συμπληροῦνται καὶ εἰδοποιοῦνται ὑπ᾿ αὐτῶν, τὸ δὲ ἀτελὲς καὶ ὡς ἐν ὕλης τάξει προκαταβεβλημένον καὶ συγγενὲς πρὸς ποιότητας ἀπὸ τῶν παθῶν θεωρεῖται.", "seq": 4508}
{"id": "Simplicius_Passim_4509", "series": "CAG", "text": "Ἐπεὶ δὲ τὸ μόνιμον καὶ δυσκίνητον χαρακτηριστικὸν εἶναι δοκεῖ τῆς παθητικῆς ποιότητος καὶ διακριτικὸν αὐτῆς ἀπὸ τοῦ πάθους, οὐχ οὕτως ἀκουστέον τοῦ μονίμου ὡς ἐπὶ τῆς ἕξεως, ἀλλ᾿ ὡς πρὸς τὸ πάθος δεῖ τὸ μόνιμον ἐννοεῖν.", "seq": 4509}
{"id": "Simplicius_Passim_4510", "series": "CAG", "text": "δεῖ γὰρ ὁπωσοῦν μένειν ἐκεῖνο τὸ νομιζόμενον ποιόν, ἵνα ᾖ τε καὶ λέγηται ὁπωσοῦν ποιόν, οὐ τῷ μονίμῳ εἰδοποιούμενον ὥσπερ ἡ ἕξις, ἀλλὰ τῇ ἐν τῷ πάθει διαμενούσῃ ποιότητι.", "seq": 4510}
{"id": "Simplicius_Passim_4511", "series": "CAG", "text": "Ἐπειδὴ δὲ τὰς παθητικὰς ποιότητας εἴς τε ψυχὴν καὶ σῶμα διεῖλεν, δεῖ ζητεῖν, εἰ αἱ ἐκστάσεις καὶ ὀργαὶ καὶ τὰ τοιαῦτα τῆς ψυχῆς ἐστιν ἴδια ἢ κοινὰ καὶ τοῦ ἔχοντος.", "seq": 4511}
{"id": "Simplicius_Passim_4512", "series": "CAG", "text": "εἰ τοίνυν ἀρέσκει αὐτῷ ἐν τῷ πρώτῳ Περὶ ψυχῆς ἀπὸ τοῦ σώματος ὡρμῆσθαι τὰ τοιαῦτα, ὥστε πολλάκις μὲν εὐκινήτους ἡμᾶς γίνεσθαι πρὸς ὀργὴν καίτοι μικρῶν ὄντων τῶν παροξυνόντων, πολλάκις δὲ καίτοι μεγάλων ὄντων μὴ κινεῖσθαι, ὅταν μὴ ὀργᾷ τὸ σῶμα μηδὲ ᾖ ἀφ᾿ ἑαυτοῦ πρὸς τὸ πάθος ἠρεθισμένον—εἰ τοίνυν τοῦτο οὕτως ἔχει, τῆς ψυχῆς εἶπεν τὰ πάθη κατὰ τὸ ἐπικρατοῦν αὐτῆς καὶ πλεονάζον ἐν τῷ συνθέτῳ ζῴῳ·", "seq": 4512}
{"id": "Simplicius_Passim_4513", "series": "CAG", "text": "αἱ γὰρ πρὸς τὸ σῶμα συγγενεῖς τῇ ψυχῇ καταστάσεις καὶ αἱ ῥέπουσαι εἰς γένεσιν καὶ μὴ κρατοῦσαι ἑαυτῶν καὶ αἱ παραγόμεναι ὑπὸ τοῦ σώματος καὶ ὑλικώτεραι, αὗται τῶν ψυχικῶν τούτων παθῶν εἰσιν αἰτίαι.", "seq": 4513}
{"id": "Simplicius_Passim_4514", "series": "CAG", "text": "ταῦτα μὲν οὖν καὶ περὶ τούτων εἰρήσθω.", "seq": 4514}
{"id": "Simplicius_Passim_4515", "series": "CAG", "text": "μεταβαίνειν δὲ ἤδη καιρὸς ἐπὶ τὸ τέταρτον τῆς ποιότητος εἶδος τῷ Ἀριστοτέλει παρακολουθοῦντα.", "seq": 4515}
{"id": "Simplicius_Passim_4516", "series": "CAG", "text": "10α11 Τέταρτον δὲ γένος ποιότητος ἕως τοῦ ποιὰ οὖν λέγεται τὰ παρωνύμως ἀπὸ τῶν εἰρημένων ποιοτήτων λεγόμενα ἢ ὁπωσοῦν ἄλλως ἀπ᾿ αὐτῶν.", "seq": 4516}
{"id": "Simplicius_Passim_4517", "series": "CAG", "text": "Τετάρτην εἰκότως καὶ τελευταίαν ἀποδίδωσιν τούτῳ τῷ γένει ἤτοι εἴδει τῆς ποιότητος τάξιν, διότι ἐπιπολῆς καὶ οἷον ἔξωθεν ἐπ᾿ ἐσχάτῳ τοῦ σώματος συνίσταται.", "seq": 4517}
{"id": "Simplicius_Passim_4518", "series": "CAG", "text": "πολυμερὲς δέ ἐστιν καὶ πολυειδὲς τὸ γένος τοῦτο.", "seq": 4518}
{"id": "Simplicius_Passim_4519", "series": "CAG", "text": "καὶ ἔστιν ἐν αὐτῷ σχῆμα μὲν τὸ ὑπὸ τινὸς ἢ τινῶν ὅρων περιεχόμενον, ὃ καὶ ἐπιπέδου καὶ στερεοῦ πέρας ἐστίν·", "seq": 4519}
{"id": "Simplicius_Passim_4520", "series": "CAG", "text": "ληπτέον δὲ αὐτὸ οὐ κατὰ τὸ πλῆθος τῶν γραμμῶν καὶ τῶν ἐπιπέδων (ποσὸν γὰρ οὕτως ἔσται), ἀλλὰ οὐδὲ κατὰ τὸ χρῶμα, ἀλλὰ κατὰ τὸν τῆς ἐπιφανείας ποιὸν σχηματισμὸν κατὰ τὸ γεγωνιῶσθαι ἢ ἀγώνιον εἶναι.", "seq": 4520}
{"id": "Simplicius_Passim_4521", "series": "CAG", "text": "ἡ δὲ περὶ ἕκαστον μορφὴ διχῶς λέγεται παρὰ τῷ Ἀριστοτέλει, κατά γε τὰ οὐσιώδη εἴδη καὶ κατὰ τὰ τῆς ἐπιφανείας ποιὰ τυπώματα.", "seq": 4521}
{"id": "Simplicius_Passim_4522", "series": "CAG", "text": "νῦν οὖν θεωρεῖται οὐ κατὰ τὸ οὐσιῶδες εἶδος (οὐδὲ γάρ ἐστι ποιότης τὸ τοιοῦτον), ἀλλὰ κατὰ τὸ ἐπιφαινόμενον τοῖς οὐσιώδεσιν περὶ τὴν ἐπιφάνειαν εἴδεσιν, καθ᾿ ὃ καλά τινα καὶ εὔμορφα λέγομεν ἢ δυσειδῆ καὶ ἄμορφα·", "seq": 4522}
{"id": "Simplicius_Passim_4523", "series": "CAG", "text": "αἱ γὰρ τοιαῦται μορφαὶ ποιότητές εἰσιν, ἄλλαι μὲν παρὰ τὸ χρῶμα καὶ τὸ σχῆμα, ἐπιστῆσαι δὲ ἄξιον, μήποτε καὶ ἐκείνων περιεκτικαί, κἂν μὴ προσιῆται τοῦτο Ἰάμβλιχος.", "seq": 4523}
{"id": "Simplicius_Passim_4524", "series": "CAG", "text": "τινὲς δὲ τὴν μὲν μορφὴν ἐπὶ ζῴου μόνου λέγεσθαι νομίζουσιν, τὸ δὲ σχῆμα ἐπὶ τοῦ ἀψύχου εἴδους, οὔτε κατὰ τὴν τεχνικὴν συνήθειαν καλῶς οὔτε τὴν τῶν πολλῶν χρῆσιν·", "seq": 4524}
{"id": "Simplicius_Passim_4525", "series": "CAG", "text": "ἐπαλλάττει γὰρ ταῦτα τὰ ὀνόματα, ὁμοίως μὲν καὶ ἐπὶ τῶν ἐμψύχων τὸ σχῆμα, ὁμοίως δὲ καὶ ἐπὶ τῶν ἀψύχων τὴν μορφὴν λέγουσα.", "seq": 4525}
{"id": "Simplicius_Passim_4526", "series": "CAG", "text": "καὶ ὁ λόγος δὲ ἑκατέρου τῇ τοιαύτῃ χρήσει συμμαρτυρεῖ·", "seq": 4526}
{"id": "Simplicius_Passim_4527", "series": "CAG", "text": "εἰ γὰρ κατὰ τὸ πέρας τῆς ἐπιφανείας καὶ τὴν τύπωσιν αὐτῆς ἡ μορφὴ λέγεται, οὐδὲν ἐμφαίνει ζωῆς ἐχόμενον·", "seq": 4527}
{"id": "Simplicius_Passim_4528", "series": "CAG", "text": "δύναται γὰρ καὶ τοῖς ἀψύχοις ἐφαρμόζειν·", "seq": 4528}
{"id": "Simplicius_Passim_4529", "series": "CAG", "text": "ὅ τε ὅρος τοῦ σχήματος οὐδὲν κωλύεται καὶ τοῖς φυσικοῖς καὶ τοῖς τῶν ζῴων σώμασιν ἐφαρμόζειν.", "seq": 4529}
{"id": "Simplicius_Passim_4530", "series": "CAG", "text": "ἀλλ᾿ εἰ ἄρα, ῥητέον τὸ μὲν σχῆμα μόνης τῆς ἔξωθεν περιγραφῆς ἔχεσθαι, τὴν δὲ μορφὴν καὶ τῆς ἐν ταῖς ἀποπερατώσεσι συμμετρίας ἢ ἀμετρίας·", "seq": 4530}
{"id": "Simplicius_Passim_4531", "series": "CAG", "text": "τὴν γὰρ ἐπὶ τῇ ἐπιφανείᾳ τελευτὴν τοῦ εἴδους μιμεῖται ἡ μορφή.", "seq": 4531}
{"id": "Simplicius_Passim_4532", "series": "CAG", "text": "τινὲς δὲ τὴν μορφὴν ἐπὶ τῶν φυσικῶν ἀκούουσι μόνον, καὶ δοκεῖ ταύτην τὴν δόξαν ἐν τοῖς ἑξῆς προσίεσθαι ὁ Ἰάμβλιχος, ὡς οὐ λεγομένης τῆς μορφῆς ἐπὶ τῶν μαθηματικῶν καὶ ὅλως τῶν σχημάτων, καὶ διὰ τοῦτό φησιν τὴν περὶ ἕκαστον μορφὴν εἰρῆσθαι, διότι ὡς ἔνυλος εἰς τὸ ἄτομον κατετάγη.", "seq": 4532}
{"id": "Simplicius_Passim_4533", "series": "CAG", "text": "εὐθύτητα δὲ καὶ καμπυλότητά φησιν Ἰάμβλιχος τὴν κοινὴν ἐπὶ τῶν γεωμετρικῶν σχημάτων καὶ ἐπὶ τῆς μορφῆς εἰρῆσθαι ποιότητα, καὶ διὰ τὸ κοινὸν καὶ διατεῖνον ἐπ᾿ ἄμφω καὶ ἐπὶ μορφῶν καὶ σχημάτων κοινῶς ὁρώμενον καὶ περιττεῦον ἑκατέρου ἰδίᾳ καταλέγεσθαι.", "seq": 4533}
{"id": "Simplicius_Passim_4534", "series": "CAG", "text": "“αὐτὴ μὲν γάρ, φησίν, ἡ γραμμή, καθ᾿ ὅσον ἐστὶν γραμμή, ποσόν ἐστιν, ἡ δὲ εὐθεῖα, καθ᾿ ὅσον ἐστὶν εὐθεῖα ἢ καμπύλη, ποιὰ ἂν νοηθείη·", "seq": 4534}
{"id": "Simplicius_Passim_4535", "series": "CAG", "text": "καὶ ἡ ἐπιφάνεια, καθ᾿ ὅσον μέν ἐστιν ἐπιφάνεια, ποσόν, καθ᾿ ὅσον δὲ ἐπίπεδος ἐπιφάνεια, ποιόν·", "seq": 4535}
{"id": "Simplicius_Passim_4536", "series": "CAG", "text": "καὶ ἐπὶ τῆς μορφῆς δέ, φησίν, ταῦτα ὡσαύτως θεωρεῖται”.", "seq": 4536}
{"id": "Simplicius_Passim_4537", "series": "CAG", "text": "μήποτε οὖν ἡ εὐθύτης καὶ ἡ καμπυλότης γραμμῶν ἂν εἴη καθ᾿ αὑτὰς καὶ ἐπιφανειῶν, μορφῆς δὲ οὐ καθ᾿ αὑτό, ἀλλ᾿ εἰ ἄρα, κατὰ συμβεβηκός, καθ᾿ ὅσον οἶμαι καὶ τὸ σχῆμα περιέχει ἡ μορφή.", "seq": 4537}
{"id": "Simplicius_Passim_4538", "series": "CAG", "text": "εἴ τι δὲ ἄλλο τούτοις ὅμοιον τοῖς εὐθέσι καὶ καμπύλοις προσέθηκεν τὰ ἑλικοειδῆ καὶ κωνοειδῆ καὶ φακοειδῆ λέγων τῶν σχημάτων καὶ τὰ τοιαῦτα, ἅπερ μικτὴν ἔχει τὴν φύσιν ἐξ εὐθέος καὶ περιφεροῦς, ὡς καὶ οἱ γεωμέτραι φασίν.", "seq": 4538}
{"id": "Simplicius_Passim_4539", "series": "CAG", "text": "ὅτι δὲ ποιότητες αὗται, ἀπὸ τοῦ λόγου τῆς ποιότητος κατασκευάζει·", "seq": 4539}
{"id": "Simplicius_Passim_4540", "series": "CAG", "text": "εἰ γὰρ ἀφ᾿ ἑκάστου τούτων ποιόν τι λέγεται, ἀφ᾿ οὗ δὲ ποιόν τι λέγεται, τοῦτο ποιότης ἐστίν, ποιότης ἂν εἴη ἑκάστη τούτων.", "seq": 4540}
{"id": "Simplicius_Passim_4541", "series": "CAG", "text": "Τὸ δὲ μανὸν καὶ πυκνὸν οὐχ ὡς ἀπὸ μανότητος καὶ πυκνότητος παρωνομάσθαι φησὶν οὐδὲ πῶς ἔχοντα παρέχεσθαι τὸ μανὸν καὶ πυκνόν, ἀλλὰ τῷ τὰ μόρια διεστηκέναι ἀπ᾿ ἀλλήλων, ὡς παρεμπίπτειν τι ἑτερογενὲς σῶμα, τούτῳ λέγεται μανόν, ὡς σπογγιαὶ καὶ κισσήρεις, πυκνὸν δὲ τὸ τὰ μόρια σύνεγγυς ἔχον, ὡς μηδὲν ἑτερογενὲς μεταξὺ παρεμπίπτειν, ὡς ἐπὶ χρυσοῦ καὶ σιδήρου θεωρεῖται.", "seq": 4541}
{"id": "Simplicius_Passim_4542", "series": "CAG", "text": "εἰ οὖν θέσιν μᾶλλον τῶν μορίων δηλοῖ ταῦτα, ἀλλ᾿ οὐχὶ τὸν χαρακτῆρα, οὐκ ἂν εἴη ποιά.", "seq": 4542}
{"id": "Simplicius_Passim_4543", "series": "CAG", "text": "ἀλλὰ καὶ τὸ λεῖον τοῦτό ἐστιν, οὗ τὰ μόρια ἐπ᾿ εὐθείας ἐπ᾿ ἴσης κεῖται, ὡς ἐπὶ τῶν ἀποτεταμένων μαρμάρων, τραχὺ δέ, οὗ μὴ ἐπ᾿ ἴσης κεῖται, ἀλλὰ τὰ μὲν ὑπερέχει, τὰ δὲ ἐλλείπει, ὡς ἐπὶ τοῦ πρίονος·", "seq": 4543}
{"id": "Simplicius_Passim_4544", "series": "CAG", "text": "θέσιν ἄρα καὶ τὰ τοιαῦτα δηλοῖ.", "seq": 4544}
{"id": "Simplicius_Passim_4545", "series": "CAG", "text": "ἡ δὲ θέσις ἤτοι τῆς τῶν πρός τι κατηγορίας ἐστίν, ὡς εἴρηται ἐν ἐκείνοις, ἢ ὑπὸ τὸ κεῖσθαι ὑπάγεται·", "seq": 4545}
{"id": "Simplicius_Passim_4546", "series": "CAG", "text": "καὶ γὰρ τὰ κείμενα θέσιν τινὰ δηλοῖ.", "seq": 4546}
{"id": "Simplicius_Passim_4547", "series": "CAG", "text": "ἐπιστῆσαι δὲ ἄξιον, ὡς οἶμαι, μήποτε ἡ μανότης καὶ πυκνότης καὶ λειότης καὶ τραχύτης καὶ ποιότητές τινές εἰσιν κατὰ τὸν χαρακτῆρα, ὡς θερμότης καὶ ψυχρότης, καὶ θέσιν τινὰ δηλοῦσιν κατὰ τὴν τῶν μορίων σύνταξιν·", "seq": 4547}
{"id": "Simplicius_Passim_4548", "series": "CAG", "text": "καὶ οὐδὲν θαυμαστὸν τὸ αὐτὸ κατ᾿ ἄλλο καὶ ἄλλο ὑπ᾿ ἄλλην καὶ ἄλλην κατηγορίαν ἀνάγεσθαι, ὡς καὶ τῷ Ἀριστοτέλει καὶ τοῖς τοῦ Ἀριστοτέλους ἐξηγηταῖς δοκεῖ.", "seq": 4548}
{"id": "Simplicius_Passim_4549", "series": "CAG", "text": "Πληρώσας δὲ τὰ εἴδη τῆς ποιότητος ἐπήγαγεν ἴσως μὲν οὖν καὶ ἄλλος ἂν φανείη τρόπος ποιότητος, οὐχ ὡς φιλόσοφον εὐλάβειαν ἐνδεικνύμενος, ὥς τινες οἴονται, οὐδὲ ὅτι δυσδιαίρετος ὁ περὶ τῶν πρώτων γενῶν λόγος, ὡς ἄλλοι, οὐδὲ ὅτι τὰς διαφορὰς ἐνδείκνυται, καθ᾿ ἃς λογικὸν καὶ ἄλογον καὶ τὰ ἄλλα θεωρεῖται ποιὰ τὰ οὐσιώδη καὶ διαιρετικὰ τῶν γενῶν·", "seq": 4549}
{"id": "Simplicius_Passim_4550", "series": "CAG", "text": "οὐσίαι γάρ εἰσιν ἐκεῖνα μᾶλλον, ἀλλ᾿ οὐ ποιότητες·", "seq": 4550}
{"id": "Simplicius_Passim_4551", "series": "CAG", "text": "εἰ δὲ ποιότητες ἦσαν, οὐκ ἂν οὕτως εἰς ἐσχάτην τάξιν ἀπερρίφησαν.", "seq": 4551}
{"id": "Simplicius_Passim_4552", "series": "CAG", "text": "Ἀνδρόνικος δὲ πέμπτον εἰσάγει γένος, ἐν ᾧ τάττει μανότητα πυκνότητα, κουφότητα βαρύτητα, λεπτότητα παχύτητα, οὐ τὴν κατὰ τὸν ὄγκον, ἀλλὰ καθὸ ἀέρα λέγομεν λεπτὸν εἶναι καὶ τοῦ ὕδατος λεπτότερον·", "seq": 4552}
{"id": "Simplicius_Passim_4553", "series": "CAG", "text": "“ποιὰ γάρ, φησί, λέγομεν πάντα τὰ τοιαῦτα τῷ ἀπὸ ποιότητος εἶναι αὐτά, ὁμοίως δὲ καὶ τὸ διαφανὲς καὶ τὸ σκοτεινόν, ὥστε, φησίν, ἢ ἄλλο τι γένος ποιότητος τοῦτο θετέον ἢ συζευκτέον αὐτὰ ταῖς παθητικαῖς·", "seq": 4553}
{"id": "Simplicius_Passim_4554", "series": "CAG", "text": "τῷ γὰρ παθεῖν τι τὸ σῶμα τούτων ἕκαστον τοιοῦτον γέγονεν, διαφέρει δὲ ἐκείνων, ὅτι πάθους οὔκ εἰσιν ἐμποιητικαὶ αὗται”.", "seq": 4554}
{"id": "Simplicius_Passim_4555", "series": "CAG", "text": "Εὔδωρος δὲ τὴν παχύτητα καὶ λεπτότητα εἰς ἕτερον τάττει γένος, τὰς δὲ ἄλλας οὔ.", "seq": 4555}
{"id": "Simplicius_Passim_4556", "series": "CAG", "text": "οἱ δὲ περὶ τὸν Ἀχαϊκὸν ταύτας μὲν εἰς τὸ τέταρτον γένος τάττουσιν συνεπομένας τῷ μανῷ καὶ πυκνῷ, ἐκείνας δὲ μᾶλλον αἰνίττεσθαι τὸν Ἀριστοτέλη φασὶν ἐν τῷ ἴσως δὲ καὶ ἄλλο γένος, ἃς ἐν τῇ Περὶ γενέσεως καὶ φθορᾶς τῷ θερμῷ καὶ ὑγρῷ καὶ ψυχρῷ καὶ ξηρῷ συνέταξεν·", "seq": 4556}
{"id": "Simplicius_Passim_4557", "series": "CAG", "text": "εἰσὶν δὲ αὗται βαρὺ κοῦφον, σκληρὸν μαλακόν, τραχὺ λεῖον, παχὺ λεπτόν.", "seq": 4557}
{"id": "Simplicius_Passim_4558", "series": "CAG", "text": "ἀλλὰ πῶς ἄν τις ταῦτα παραδέξαιτο μηδενὸς ὑπ᾿ αὐτοῦ λεγομένου ἑνὸς γένους, ὑφ᾿ ὃ ταῦτα ταχθήσεται, ὡς ἐν μὲν τῷ πρώτῳ ἕξις ἦν καὶ διάθεσις ἐν δὲ τῷ δευτέρῳ φυσικὴ δύναμις, καὶ ἐπὶ τῶν ἄλλων ἕν τι;", "seq": 4558}
{"id": "Simplicius_Passim_4559", "series": "CAG", "text": "βέλτιον οὖν λέγειν ὅτι κατὰ τὸ ἀληθὲς εἰσί τινες καὶ ἄλλοι τρόποι, οὓς ἐν τῇ Μετὰ τὰ φυσικὰ ὡς ἐν τελειοτέρᾳ πραγματείᾳ παραδίδωσιν·", "seq": 4559}
{"id": "Simplicius_Passim_4560", "series": "CAG", "text": "ἐνταῦθα δὲ ὡς ἐν εἰσαγωγῇ τοὺς μάλιστα λεγομένους ἐξέθετο.", "seq": 4560}
{"id": "Simplicius_Passim_4561", "series": "CAG", "text": "Κοινῶς δὲ περὶ πάντων τῶν εἰδῶν ἐπάγει ὅτι ποιότητές εἰσιν αἱ εἰρημέναι, ποιὰ δὲ τὰ κατ᾿ αὐτὰς παρωνύμως λεγόμενα ἢ ὁπωσοῦν ἀπ᾿ αὐτῶν.", "seq": 4561}
{"id": "Simplicius_Passim_4562", "series": "CAG", "text": "τοῦτο δὲ εἶπεν, ἐπειδὴ τινὰ μὲν παρωνύμως λέγεται, ὡς ἀπὸ τῆς λευκότητος τὸ λευκόν, ἔνια δὲ ὁμωνύμως, ὡς τρίγωνον καὶ τετράγωνον καὶ τῶν ἄλλων σχημάτων ἕκαστον·", "seq": 4562}
{"id": "Simplicius_Passim_4563", "series": "CAG", "text": "ἐπὶ γὰρ τούτων τρίγωνον καὶ ἡ ποιότης καὶ τὸ μετέχον καλεῖται.", "seq": 4563}
{"id": "Simplicius_Passim_4564", "series": "CAG", "text": "ἔτι δὲ ἐπ᾿ ἐνίων μὲν ἀμφότερα ὠνόμασται, ὡς γραμματικὴ καὶ ὁ γραμματικός, ἐπ᾿ ἐνίων δὲ οὐθέτερον, ὡς ἡ πρὸς γραμματικὴν ἐπιτηδειότης καὶ ὁ κατ᾿ αὐτὴν εὐφυῶς διακείμενος, ἐπ᾿ ἐνίων δὲ τὸ ἕτερον μόνον ὠνόμασται, τὸ ποιὸν μέν, ὡς ἐπὶ τοῦ δρομικοῦ καὶ πυκτικοῦ·", "seq": 4564}
{"id": "Simplicius_Passim_4565", "series": "CAG", "text": "ἀνώνυμοι γὰρ αἱ ἐπιτηδειότητες·", "seq": 4565}
{"id": "Simplicius_Passim_4566", "series": "CAG", "text": "ἡ γὰρ πυκτικὴ καὶ δρομικὴ αἱ κατ᾿ ἐνέργειάν εἰσιν ἐπιστῆμαι, ἀφ᾿ ὧν πύκται καὶ δρομεῖς οἱ ποιοὶ λέγονται·", "seq": 4566}
{"id": "Simplicius_Passim_4567", "series": "CAG", "text": "οἱ γὰρ πυκτικοὶ καὶ δρομικοὶ τοὺς δυνάμει ποιοὺς σημαίνουσιν ἀπὸ ἐλπίδος ἧς ἕξουσιν ἕξεως παρωνομασμένους.", "seq": 4567}
{"id": "Simplicius_Passim_4568", "series": "CAG", "text": "ἔστιν δὲ ὅπου τῇ μὲν ἕξει κεῖται ὄνομα, ὡς τῇ ἀρετῇ, τῷ δὲ κατ᾿ αὐτὴν ποιῷ οὐκέτι·", "seq": 4568}
{"id": "Simplicius_Passim_4569", "series": "CAG", "text": "οὐδὲ γὰρ λέγεται ἐνάρετος, ὁ δὲ σπουδαῖος οὐκ ἀπὸ τῆς ἀρετῆς παρωνόμασται οὐδὲ ὁ ἐνάρετος, ὥσπερ οὐδὲ ὁ ἐγγράμματος ἀπὸ τῆς γραμματικῆς.", "seq": 4569}
{"id": "Simplicius_Passim_4570", "series": "CAG", "text": "ἐπ᾿ ἐνίων δὲ καὶ παραλλάττουσιν αἱ τῶν ὀνομάτων σημασίαι παρὰ τὴν τῶν πραγμάτων δήλωσιν διὰ τὴν ἀνωμαλίαν τῆς χρήσεως.", "seq": 4570}
{"id": "Simplicius_Passim_4571", "series": "CAG", "text": "ὁ γὰρ δίκαιος κατὰ μὲν τὸ ὄνομα ἀπὸ τῆς δίκης παρωνόμασται, κατὰ δὲ τὰ πράγματα ἀπὸ τῆς δικαιοσύνης·", "seq": 4571}
{"id": "Simplicius_Passim_4572", "series": "CAG", "text": "ὁ δὲ δικαιόσυνος κατὰ μὲν τὴν λέξιν ἀπὸ τῆς δικαιοσύνης, ὥσπερ καὶ ὁ εὐφρόσυνος ἀπὸ τῆς εὐφροσύνης, κατὰ δὲ τὰ πράγματα οὐκ ἔχει παράθεσιν.", "seq": 4572}
{"id": "Simplicius_Passim_4573", "series": "CAG", "text": "διὰ ταῦτα οὖν πάντα προσέθηκεν τὸ ἢ ὁπωσοῦν ἄλλως ἀπ᾿ αὐτῶν.", "seq": 4573}
{"id": "Simplicius_Passim_4574", "series": "CAG", "text": "ἀνήγαγεν δὲ ταῦτα ἢ εἰς τὸ μὴ κεῖσθαι ταῖς ποιότησιν ὀνόματα, ὡς ἐπὶ τῶν φυσικῶν δυνάμεων, ἢ εἰς τὴν συνήθειαν μὴ ἔχουσαν ἐν χρήσει τὸ ἕτερον, ὡς ἐπὶ τῆς ἀρετῆς καὶ ἐναρέτου.", "seq": 4574}
{"id": "Simplicius_Passim_4575", "series": "CAG", "text": "καὶ δῆλον ὅτι ἐπ᾿ ὀλίγων μὲν ταῦτα συμπίπτει, τὰ δὲ πολλὰ παρωνόμασται ταῖς ποιότησιν, ἀφ᾿ ὧν ἔχει τὸ ποιὰ εἶναι.", "seq": 4575}
{"id": "Simplicius_Passim_4576", "series": "CAG", "text": "αὕτη μὲν ἡ τῆς λέξεως σαφήνεια.", "seq": 4576}
{"id": "Simplicius_Passim_4577", "series": "CAG", "text": "Τρεπτέον δὲ λοιπὸν ἐπὶ τὰς καθ᾿ ἕκαστα ζητήσεις τε καὶ διαλύσεις πρὸ τούτου δὲ ἀκριβέστερον ἔτι τῶν εἰρημένων ποιητέον διάκρισιν.", "seq": 4577}
{"id": "Simplicius_Passim_4578", "series": "CAG", "text": "τὸ τοίνυν σχῆμα οἱ Στωικοὶ τὴν τάσιν παρέχεσθαι λέγουσιν, ὥσπερ καὶ τὴν μεταξὺ τῶν σημείων διάστασιν·", "seq": 4578}
{"id": "Simplicius_Passim_4579", "series": "CAG", "text": "διὸ καὶ εὐθεῖαν ὁρίζονται γραμμὴν τὴν εἰς ἄκρον τεταμένην.", "seq": 4579}
{"id": "Simplicius_Passim_4580", "series": "CAG", "text": "ἀλλ᾿ οὕτως ἀναιρεθήσεται ἡ μαθηματικὴ οὐσία, ἥτις ἀκίνητός τέ ἐστιν καὶ ἀλλοιώσεως πάσης καὶ διὰ τοῦτο καὶ τάσεως ἀπηλλαγμένη.", "seq": 4580}
{"id": "Simplicius_Passim_4581", "series": "CAG", "text": "εἰ δέ τις τὴν ἀσώματον οὐσίαν τῶν σχημάτων καὶ ἀμφισβητήσιμον εἶναι νομίζοι, εἴτε ἔστιν εἴτε μέχρι ὑποθέσεως ὑπάρχει, νῦν δὲ εἶναι τὸν λόγον οἴεται περὶ τῶν ἐν τοῖς σώμασιν σχημάτων, καὶ οὕτως ἐροῦμεν κατὰ Ἀριστοτέλη μὴ εἶναι τάσιν τὴν τοῦ σχήματος αἰτίαν.", "seq": 4581}
{"id": "Simplicius_Passim_4582", "series": "CAG", "text": "κίνησις γὰρ ἂν οὕτως καὶ μεταβολὴ γίνοιτο τῆς ποιότητος αἰτία, ὅπερ οὐκ ἀρέσκει τῷ Ἀριστοτέλει, ἀλλ᾿ οὐδὲ ἔχει λόγον·", "seq": 4582}
{"id": "Simplicius_Passim_4583", "series": "CAG", "text": "ἐν ὅρῳ μὲν γὰρ ἡ ποιότης θεωρεῖται, ἀόριστον δὲ πρᾶγμα ἡ κίνησίς ἐστιν καὶ μᾶλλον ἐφιέμενον τοῦ ὁρίζεσθαι.", "seq": 4583}
{"id": "Simplicius_Passim_4584", "series": "CAG", "text": "εἰ δέ τις διττὰ σχήματα ὑποτιθοῖτο, τὰ μὲν ἀσώματα, ὡς τὰς ἰδέας κύκλου τε καὶ τῶν ἄλλων σχημάτων ὁ Πλάτων φησίν, τὰ δὲ ὡς περὶ τοῖς σώμασιν μεριζόμενα, καὶ τρίτα δὲ κατ᾿ ἄλλην τινὰ μεταξὺ φύσιν τῶν τε ἰδεῶν καὶ τῶν γινομένων, ἕπεται ζητεῖν, εἰ ἄλλως μέν ἐστιν τὰ ἀσώματα σχήματα, ἄλλως δὲ τὰ σωματοειδῆ, καὶ εἰ κατὰ κοινὸν λόγον ἀμφοτέρων τούτων νυνὶ τὰ σχήματα λέγεται ἢ κατὰ μόνον τὸν ἐπὶ τῶν σωμάτων θεωρούμενον, καὶ πότερον τὸ διακρατοῦν ἐν ποιῷ σχήματι ἀπὸ ποιότητος γίνεται τοῦ σχήματος ὡς ἑτέρας οὔσης παρὰ τὸ διακρατούμενον ἢ οὐδὲ διακρατοῦν τι ἔστιν, ἀλλ᾿ ἐν ἀποτελέσματος τάξει τὸ σχῆμα θεωρεῖται ἄλλως ἐπισυνιστάμενον τῇ φύσει τῶν σωμάτων κατ᾿ αὐτὸ μόνον τὸ πεπεράνθαι.", "seq": 4584}
{"id": "Simplicius_Passim_4585", "series": "CAG", "text": "ἀλλὰ κοινὸν μὲν σωμάτων καὶ ἀσωμάτων οὐδὲν ἂν εἴη πρότερον εἶδος ὡς ἕτερον ἀμφοῖν, εἰ μὴ ἄρα τις λέγοι τὰ ἀσώματα σχήματα ὡς αἰτίαν παρέχοντα τοῖς ἐπὶ τῶν † σχημάτων σώμασιν καὶ σχήμασιν κοινὴν αὐτοῖς παρέχειν ἀρχηγὸν δύναμιν, ἥτις συντάττει πρὸς ἑαυτὴν τὰ ὁρώμενα σχήματα καὶ συνάγει καὶ ὁμοῦ πάρεστι πᾶσιν, καὶ κατὰ τοῦτο ἂν ἔχοι τὸ κοινόν.", "seq": 4585}
{"id": "Simplicius_Passim_4586", "series": "CAG", "text": "ἀλλ᾿ οὐδὲν τοῦτο ταῖς Ἀριστοτέλους ὑποθέσεσιν προσήκει.", "seq": 4586}
{"id": "Simplicius_Passim_4587", "series": "CAG", "text": "ὅθεν οὔτε τὸ διακρατοῦν ἐν τῷ σχήματι τῆς ποιότητος εὐλόγως ἄν τις θείη·", "seq": 4587}
{"id": "Simplicius_Passim_4588", "series": "CAG", "text": "οὐδὲ γὰρ οὕτως ἐνεργοῦσιν αἱ ποιότητες κατ᾿ αὐτόν, ἀλλ᾿ ἔχονται μόνον.", "seq": 4588}
{"id": "Simplicius_Passim_4589", "series": "CAG", "text": "περὶ δὲ τοῦ ἐν ἀποτελέσματος τάξει εἶναι τὰ σχήματα, εἰ μέν τις οὕτως λέγοι αὐτὰ ὡς συμβεβηκότα συμπτώματα κατ᾿ ἐπακολούθησιν ἢ ὡς ἔτυχεν, οὐκ ἀποδεξόμεθα τὸν λόγον·", "seq": 4589}
{"id": "Simplicius_Passim_4590", "series": "CAG", "text": "οὐδὲν γὰρ τῶν κατὰ φύσιν γινομένων τοιαύτην ἔχει τὴν ὑπόστασιν·", "seq": 4590}
{"id": "Simplicius_Passim_4591", "series": "CAG", "text": "εἰ δὲ ὡς κατὰ μετουσίαν εἰδῶν τινων καὶ λόγων φυσικῶν τὰ περὶ τοῖς σώμασιν τοῖς φυσικοῖς σχήματα λέγοι ἀπογεννᾶσθαι, παραδεξόμεθα, καὶ συγχωρήσομεν τὸ σχῆμα εἶναί τε καθ᾿ ἑαυτὸ καὶ ἀπὸ τῆς τοιαύτης αἰτίας παράγεσθαι.", "seq": 4591}
{"id": "Simplicius_Passim_4592", "series": "CAG", "text": "ἐπειδὴ δέ τινες καὶ τὸ σχῆμα, ὥσπερ καὶ τὸ χρῶμα καὶ τὸ γλυκὺ καὶ τὸ σκληρὸν ἐν τοῖς πρός τι τίθενται ὡς πρὸς αἴσθησιν λεγόμενα, δῆλον ὅτι οὗτοι πάντα συμφύρουσιν·", "seq": 4592}
{"id": "Simplicius_Passim_4593", "series": "CAG", "text": "οὕτω γὰρ καὶ ἡ οὐσία καὶ τὰ ἄλλα γένη ὡς αἰσθητὰ πρός τι ἔσται.", "seq": 4593}
{"id": "Simplicius_Passim_4594", "series": "CAG", "text": "ἀλλὰ χρὴ αὐτὰ ἕκαστα καθ᾿ ἑαυτὰ διαιροῦντας ἐν οἰκείοις γένεσι τιθέναι, καὶ τότε ὡς αἰσθητὰ πρὸς αἴσθησιν τῶν πρός τι λέγειν.", "seq": 4594}
{"id": "Simplicius_Passim_4595", "series": "CAG", "text": "“Περὶ δὲ τῆς μορφῆς ἐπισκεπτέον, εἰ κατὰ τὸ ποιὸν σχῆμα ἡ μορφὴ ὑφίσταται, ὥς τινες οἴονται, καὶ διὰ τοῦτο συνέταξεν αὐτὴν τῷ σχήματι.", "seq": 4595}
{"id": "Simplicius_Passim_4596", "series": "CAG", "text": "οὔτε γὰρ τῷ † Ἀνδρονίκῳ δοκεῖ τοῦτο οὔτε ἀληθές ἐστιν.", "seq": 4596}
{"id": "Simplicius_Passim_4597", "series": "CAG", "text": "οὐ δοκεῖ μὲν γάρ, διότι τὸ σχῆμα ἁπλῶς εἰπὼν τὴν μορφὴν οὐχ ἁπλῶς εἶπεν, ἀλλὰ τὴν περὶ ἕκαστον ὑπάρχουσαν μορφήν.", "seq": 4597}
{"id": "Simplicius_Passim_4598", "series": "CAG", "text": "ἡ γὰρ ἐν τούτοις ἀκριβολογία διίστησιν αὐτὰ σαφῶς ἀπ᾿ ἀλλήλων.", "seq": 4598}
{"id": "Simplicius_Passim_4599", "series": "CAG", "text": "τὸ μὲν γὰρ σχῆμα παρίστησιν ὡς κοινόν τι καὶ πλείοσιν ὑπάρχον κατ᾿ ἀριθμὸν ἢ κατ᾿ εἶδος διαφέρουσιν, τὴν δὲ μορφὴν ἐνδείκνυται ὡς μετὰ τῶν καθ᾿ ἕκαστα σωμάτων φυσικῶν ἀποτελευτῶσαν, ὅταν οἱ μεριζόμενοι περὶ τοῖς αἰσθητοῖς τῶν γινομένων λόγοι ἔσχατον ἴχνος ἀφ᾿ ἑαυτῶν ἀποτυπώσωνται ἐν τοῖς σώμασιν οἰκεῖον καὶ πρόσφορον αὐτῷ τῷ καθ᾿ ἕκαστον λόγῳ.", "seq": 4599}
{"id": "Simplicius_Passim_4600", "series": "CAG", "text": "διὰ ταῦτα μὲν οὐκ ἄν τις ἀρέσκειν αὐτῷ φαίη τὸ μετὰ τοῦ σχήματος συνυφίστασθαι καὶ τὴν μορφήν·", "seq": 4600}
{"id": "Simplicius_Passim_4601", "series": "CAG", "text": "ὅτι δὲ οὔτε ἔχει ὀρθότητα ἡ τοιαύτη δόξα, ῥᾴδιον ἐντεῦθεν καταμαθεῖν.", "seq": 4601}
