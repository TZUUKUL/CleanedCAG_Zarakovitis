{"id": "Simplicius_Passim_6865", "series": "CAG", "text": "δείκνυσιν οὖν νῦν, πῶς τὰ ὡς ἕξις καὶ στέρησις ἀντικείμενα διαφέρει τῶν ὡς τὰ πρός τι ἀντικειμένων, ἀπὸ τοῦ ὁρισμοῦ τῶν πρός τι τὴν ἀπόδειξιν ποιούμενος, ὥσπερ καὶ πρότερον, ὅτε τῶν ἐναντίων ἐχώριζεν τὰ πρός τι.", "seq": 6865}
{"id": "Simplicius_Passim_6866", "series": "CAG", "text": "λέγει οὖν ὅτι τὰ μὲν πρός τι αὐτὰ ἅπερ ἐστὶ τῶν ἀντικειμένων λέγεται, οὔτε δὲ ἡ ὄψις τυφλότητός ἐστιν ὄψις (καὶ τοῦτο πρόδηλον), ἀλλ᾿ οὐδὲ ἡ τυφλότης ὄψεως τυφλότης·", "seq": 6866}
{"id": "Simplicius_Passim_6867", "series": "CAG", "text": "ὀφθαλμοῦ γὰρ ἑκάτερον, καὶ ἡ ἕξις καὶ ἡ στέρησις.", "seq": 6867}
{"id": "Simplicius_Passim_6868", "series": "CAG", "text": "ὅτι δὲ οὐ λέγεται ἡ τυφλότης ὄψεως τυφλότης κατὰ τὰ πρός τι, διὰ τοῦ δευτέρου μάλιστα ἐπιχειρήματος δείκνυται·", "seq": 6868}
{"id": "Simplicius_Passim_6869", "series": "CAG", "text": "εἰ γὰρ ὡς πρός τι λέγοιτο πρὸς τὴν ὄψιν ἡ τυφλότης, ἐπειδὴ τὰ πρός τι πρὸς ἀντιστρέφοντα λέγεται, ἐλέγετο ἂν καὶ ἡ ὄψις τυφλότητος ὄψις·", "seq": 6869}
{"id": "Simplicius_Passim_6870", "series": "CAG", "text": "νῦν δὲ οὐ λέγεται.", "seq": 6870}
{"id": "Simplicius_Passim_6871", "series": "CAG", "text": "διαφέροι δὲ ἄν, ὡς ἔφαμεν, καὶ τῷ τὰ μὲν πρός τι ἅμα εἶναι τῇ φύσει, τὴν δὲ ἕξιν καὶ στέρησιν πρὸς τῷ μὴ συνεισάγειν ἄλληλα καὶ ἀναιρετικὰ εἶναι ἀλλήλων.", "seq": 6871}
{"id": "Simplicius_Passim_6872", "series": "CAG", "text": "εἰπὼν δὲ ἡ γὰρ ὄψις οὐκ ἔστιν τυφλότητος ὄψις προσέθηκεν οὐδὲ ἄλλως οὐδαμῶς πρὸς αὐτὸ λέγεται, διότι τὰ ἐναντία αὐτὰ μὲν ἅπερ ἦν οὐκ ἐλέγετο τῶν ἀντικειμένων, ἄλλως δὲ τὸ ἕτερον πρὸς τὸ ἕτερον ἐλέγετο·", "seq": 6872}
{"id": "Simplicius_Passim_6873", "series": "CAG", "text": "ἐναντίον γὰρ αὐτῷ λέγεται.", "seq": 6873}
{"id": "Simplicius_Passim_6874", "series": "CAG", "text": "ἀλλὰ καὶ ἡ στέρησις, εἰ μὴ καὶ αὐτὸ ὅπερ ἐστὶν τῆς ἕξεως λέγεται, ἀλλὰ στέρησίς γε αὐτῆς λέγεται, ἡ μέντοι ἕξις κατ᾿ οὐδὲν πρὸς τὴν στέρησιν λέγεται.", "seq": 6874}
{"id": "Simplicius_Passim_6875", "series": "CAG", "text": "διὰ μὲν οὖν τούτων ἔδειξεν οὐκ ὀνόματι μόνον ἀλλὰ καὶ πράγματι διαφέρουσαν τὴν τῆς ἕξεως καὶ στερήσεως ἀντίθεσιν πρὸς τὴν τῶν ὡς πρός τι ἀντικειμένων, διὰ δὲ τῶν ἑξῆς τὴν αὐτὴν πρὸς τὴν τῶν ἐναντίων παραβάλλει.", "seq": 6875}
{"id": "Simplicius_Passim_6876", "series": "CAG", "text": "12b26 Ὅτι δὲ οὐδ᾿ ὡς τἀναντία ἀντίκειται τὰ κατὰ στέρησιν καὶ ἕξιν λεγόμενα ἕως τοῦ οὔτε νωδὸς ὢν ὀδόντας ἔφυσεν.", "seq": 6876}
{"id": "Simplicius_Passim_6877", "series": "CAG", "text": "Δείκνυσιν ἐν τούτοις, ὅτι τὰ κατὰ στέρησιν καὶ ἕξιν λεγόμενα ἀντικεῖσθαι διαφέρει τῶν ὡς ἐναντίων ἀντικειμένων τῶν τε ἀμέσων καὶ τῶν ἐμμέσων, ὧν τὴν διαφορὰν ἀναγκαίως προέλαβεν, ἵνα κατ᾿ ἄμφω τὴν τῶν ἐναντίων πρὸς τὰς ἄλλας ἀντιθέσεις διαφορὰν ἐπιδείξῃ·", "seq": 6877}
{"id": "Simplicius_Passim_6878", "series": "CAG", "text": "καὶ πρῶτον μὲν τῶν ἀμέσων ἐναντίων χωρίζων τὰ κατὰ ἕξιν καὶ στέρησιν ἀμφοτέρων τῶν τοῦ ἀμέσου τρόπων ἐμνημόνευσεν, τῶν τε ἐν ὑποκειμένῳ ὄντων καὶ τῶν καθ᾿ ὑποκειμένου λεγομένων, εἰπὼν ἐν οἷς πέφυκεν γίνεσθαι ἢ ὧν κατηγορεῖται.", "seq": 6878}
{"id": "Simplicius_Passim_6879", "series": "CAG", "text": "παραδείγματα δὲ τῶν μὲν ἐν ὑποκειμένῳ ὑγίειαν καὶ νόσον παρέθετο ἐν σώματι γινόμενα, τῶν δὲ καθ᾿ ὑποκειμένου περιττὸν καὶ ἄρτιον κατὰ τοῦ ἀριθμοῦ λεγόμενα, ἢ ὡς εἶπον πρότερον, τὸ δίχα διαιρεῖσθαι κατὰ τοῦ ἀρτίου ἀριθμοῦ·", "seq": 6879}
{"id": "Simplicius_Passim_6880", "series": "CAG", "text": "τὰ γὰρ εἴδη οὐ λέγεται καθ᾿ ὑποκειμένων τῶν γενῶν, ἀλλ᾿ αἱ διαφοραὶ καθ᾿ ὑποκειμένων τῶν εἰδῶν.", "seq": 6880}
{"id": "Simplicius_Passim_6881", "series": "CAG", "text": "ἀμφοῖν δὲ τούτοιν τῶν ἐναντίων χωρίζει τὰ κατὰ στέρησιν καὶ ἕξιν, ὅτι τούτων μὲν ἀνάγκη ἀεὶ θάτερον τῷ δεκτικῷ ὑπάρχειν·", "seq": 6881}
{"id": "Simplicius_Passim_6882", "series": "CAG", "text": "τὸ γὰρ σῶμα ἢ ὑγιαίνει ἢ νοσεῖ, καὶ ὁ ἀριθμὸς ὁ ἐν τοῖς εἴδεσιν ἢ δίχα διαιρεῖται ἢ οὔ·", "seq": 6882}
{"id": "Simplicius_Passim_6883", "series": "CAG", "text": "τῆς δὲ στερήσεως καὶ ἕξεως οὐκ ἀνάγκη ἀεὶ θάτερον τῷ δεκτικῷ ὑπάρχειν·", "seq": 6883}
{"id": "Simplicius_Passim_6884", "series": "CAG", "text": "οὐ γὰρ ἁπλῶς ἀντέκειτο, ἀλλ᾿ ὅτε ἐπεφύκει·", "seq": 6884}
{"id": "Simplicius_Passim_6885", "series": "CAG", "text": "τὰ γοῦν κυνίδια, ὅταν μήπω πεφυκότα ᾖ ἔχειν ὄψιν, οὐδέτερον λέγεται, οὔτε ὄψιν ἔχειν οὔτε τυφλὰ εἶναι, καὶ τὰ παιδία τὰ μήπω πεφυκότα ὀδόντας ἔχειν οὔτε ὀδόντας ἔχειν ῥηθείη οὔτε νωδὰ εἶναι·", "seq": 6885}
{"id": "Simplicius_Passim_6886", "series": "CAG", "text": "ἀφ᾿ οὗ δ᾿ ἂν ἔχειν πεφυκότα ᾖ, ἀπ᾿ ἐκείνου τὰ μὲν ὁρᾶν λέγεται ἢ τυφλὰ εἶναι, τὰ δὲ ὀδόντας ἔχειν ἢ νωδὰ εἶναι.", "seq": 6886}
{"id": "Simplicius_Passim_6887", "series": "CAG", "text": "γέγονεν οὖν ἡ διαφορὰ παρὰ τὸ ἀεὶ ἢ ποτέ·", "seq": 6887}
{"id": "Simplicius_Passim_6888", "series": "CAG", "text": "τὰ μὲν γὰρ ἄμεσα ἐναντία εὐθὺς ἀπὸ πρώτης γε ἔχει τὴν διάστασιν, ἡ δὲ στέρησις καὶ ἡ ἕξις οὐκ εὐθὺς ἀπ᾿ ἀρχῆς ἀλλ᾿ ἀφ᾿ οὗ χρόνου ἔχειν πέφυκεν.", "seq": 6888}
{"id": "Simplicius_Passim_6889", "series": "CAG", "text": "εἰ δέ τινα εὐθὺς ἀπ᾿ ἀρχῆς τὴν ἕξιν ἔχει ὥσπερ τὰ ζῷα πάντα τὴν ἁφὴν καὶ εἰ τύχοι ἀπ᾿ ἀρχῆς στερούμενα αὐτῆς, καὶ τὴν στέρησιν ἀπ᾿ ἀρχῆς ἔχει·", "seq": 6889}
{"id": "Simplicius_Passim_6890", "series": "CAG", "text": "ἀλλ᾿ οὐκ ἐπὶ πάντων ἀληθὲς τοῦτο, ἀλλ᾿ εἴπερ ἄρα, ἐπὶ τῶν ἐξ ἀρχῆς πεφυκότων.", "seq": 6890}
{"id": "Simplicius_Passim_6891", "series": "CAG", "text": "τὰ δὲ ἄμεσα ἐναντία πάντα οὕτως ἐξ ἀρχῆς πέφυκεν, ὥστε αὕτη ἂν εἴη ἡ διαφορά, ὅτι τὰ μὲν ἄμεσα ἐναντία πάντα οὕτως, τῶν δὲ κατὰ στέρησιν καὶ ἕξιν τὰ μὲν οὕτως, τὰ δὲ οὐχ οὕτως.", "seq": 6891}
{"id": "Simplicius_Passim_6892", "series": "CAG", "text": "ἐπὶ δὲ τῶν ἐμμέσων ἐναντίων οὐχ ὁ αὐτὸς τρόπος γίνεται τῆς ἀντιθέσεως τούτων τε καὶ τῶν κατὰ ἕξιν καὶ στέρησιν, διότι τῶν μὲν ἐμμέσων ἐναντίων οὐδέποτε ἀναγκαῖον θάτερον παντὶ ὑπάρχειν τῷ δεκτικῷ·", "seq": 6892}
{"id": "Simplicius_Passim_6893", "series": "CAG", "text": "οὔτε γὰρ λευκὸν ἢ μέλαν πᾶν ἀναγκαῖον εἶναι τὸ δεκτικόν (ἐγχωρεῖ γὰρ καὶ ξανθὸν εἶναι), οὔτε θερμὸν καὶ ψυχρόν (ἐγχωρεῖ γὰρ καὶ χλιαρὸν εἶναι), ἐπὶ δὲ τῆς ἕξεως καὶ στερήσεώς ποτε ἀνάγκη θάτερον·", "seq": 6893}
{"id": "Simplicius_Passim_6894", "series": "CAG", "text": "ἀφ᾿ οὗ γὰρ ἦν πεφυκὸς ἔχειν, ἀπὸ τοῦδε ἐξ ἀνάγκης ἢ ἐστέρηται ἢ ἔχει τὴν ἕξιν.", "seq": 6894}
{"id": "Simplicius_Passim_6895", "series": "CAG", "text": "ἐπεὶ δέ τινα καὶ τῶν ἐμμέσων ἐναντίων ἔστιν ὧν φύσει τὸ ἕτερον ὑπάρχει, ὡς τῷ πυρὶ ἡ θερμότης, καὶ τούτων διοίσει τὰ κατὰ ἕξιν καὶ στέρησιν.", "seq": 6895}
{"id": "Simplicius_Passim_6896", "series": "CAG", "text": "ἐπὶ μὲν γὰρ τούτων ἀφωρισμένως τὸ ἕτερον οἷον τῇ χιόνι ἡ λευκότης καὶ ἐξ ἀνάγκης ἀεὶ καὶ πρόδηλον πότερον, ἐπὶ δὲ τῶν κατὰ ἕξιν καὶ στέρησιν οὔτε ἀφωρισμένως οὔτε ἀεὶ θάτερον ὑπάρχει καὶ ἄδηλον πότερον·", "seq": 6896}
{"id": "Simplicius_Passim_6897", "series": "CAG", "text": "οὔτε γὰρ ἡ ὄψις οὔτε ἡ τυφλότης ὡρισμένως ἀεὶ παραγίνονται.", "seq": 6897}
{"id": "Simplicius_Passim_6898", "series": "CAG", "text": "ἡ διαφορὰ οὖν τῶν κατὰ ἕξιν καὶ στέρησιν πρὸς τὰ ἐναντία κατὰ τὸ ἀεὶ καὶ κατὰ τὸ ποτὲ γίνεται·", "seq": 6898}
{"id": "Simplicius_Passim_6899", "series": "CAG", "text": "καὶ γὰρ τῶν μὲν ἀμέσων ἐναντίων διαφέρει τῷ ἐκείνων μὲν ἐξ ἀνάγκης ἀεὶ πάντως θάτερον ὑπάρχειν τῷ δεκτικῷ, οἷον ἢ ὑγιαίνει ἢ νοσεῖ, τούτων δὲ οὐκ ἐξ ἀνάγκης ἀεὶ πάντων, ἀλλὰ τινῶν ποτέ·", "seq": 6899}
{"id": "Simplicius_Passim_6900", "series": "CAG", "text": "τὸ γὰρ σκυλάκιον οὐδέτερον ἔχει·", "seq": 6900}
{"id": "Simplicius_Passim_6901", "series": "CAG", "text": "τῶν δὲ ἐμμέσων, ὅτι ἐκείνων μὲν οὐδέποτε ἐξ ἀνάγκης θάτερον ὑπάρχει τῷ δεκτικῷ, τούτων δὲ ποτὲ ἐξ ἀνάγκης θάτερον ὑπάρχει ἀφ᾿ οὗ πέφυκεν, τινῶν δὲ καὶ ἀπ᾿ ἀρχῆς.", "seq": 6901}
{"id": "Simplicius_Passim_6902", "series": "CAG", "text": "ἀλλὰ κἀκείνων οἷς φύσει τὸ ἓν ὑπάρχει διοίσει τῷ ποτὲ καὶ τῷ ἀφωρισμένως·", "seq": 6902}
{"id": "Simplicius_Passim_6903", "series": "CAG", "text": "ἐκείνων μὲν γὰρ πάντως ἀεὶ τὸ ἕτερον, τούτων δὲ τινῶν ποτέ, κἀκείνων μὲν ἀφωρισμένως θάτερον, ἐπὶ δὲ τούτων οὐκ ἀφωρισμένως ἀλλ᾿ ὁπότερα ἔτυχεν.", "seq": 6903}
{"id": "Simplicius_Passim_6904", "series": "CAG", "text": "εἰπόντος δὲ Ἀριστοτέλους, ὡς ἀναγκαῖον ἦν παντὶ θάτερον ὑπάρχειν, δοκεῖ τισιν ἀσάφειαν ἐμποιεῖν τὸ παντὶ προσκείμενον.", "seq": 6904}
{"id": "Simplicius_Passim_6905", "series": "CAG", "text": "οὐ μὴν ἔχει γε οὕτως, ἀλλ᾿ ἀντιδιαστολὴν διασαφεῖ πρὸς τὸ τισὶν ἀναγκαῖον, ὡς τοῖς σύμφυτον ἔχουσιν ἓν τῶν ἐναντίων, οὐ πᾶσιν δέ.", "seq": 6905}
{"id": "Simplicius_Passim_6906", "series": "CAG", "text": "Τί οὖν, εἰ ἀπὸ γεννήσεως ἐγγίνοιτο ἡ ὅρασις ὡς ἐπ᾿ ἀνθρώπων ἀεί;", "seq": 6906}
