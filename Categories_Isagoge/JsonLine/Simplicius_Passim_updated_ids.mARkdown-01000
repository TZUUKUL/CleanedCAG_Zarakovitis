{"id": "Simplicius_Passim_1827", "series": "CAG", "text": "ἢ ὁ μὲν σπουδαῖος, ἅτε μὴ κατ᾿ οὐσίαν οὔσης τῆς διαθέσεως, οὐδὲν θαυμαστὸν εἰ κατὰ τὴν ἐπεισοδιώδη ποιότητα τὸ μᾶλλον ἔχοι·", "seq": 1827}
{"id": "Simplicius_Passim_1828", "series": "CAG", "text": "ὁ δὲ ἄνθρωπος λογικὸς καὶ τὸ πῦρ θερμὸν οὐ κατὰ ἐπεισοδιώδη ἀλλὰ κατὰ οὐσιώδη ποιότητά ἐστι τοιαῦτα συμπληρωτικὴν οὖσαν τοῦ εἴδους·", "seq": 1828}
{"id": "Simplicius_Passim_1829", "series": "CAG", "text": "καὶ εἴπερ αὕτη τὸ μᾶλλον καὶ τὸ ἧττον ἐπιδέχοιτο, ἀνάγκη καὶ τὸ εἶδος ὅλον αὐτὸ ἐπιδέχεσθαι, ὥστε καὶ τὴν οὐσίαν.", "seq": 1829}
{"id": "Simplicius_Passim_1830", "series": "CAG", "text": "μήποτε οὖν, εἰ μὲν κατ᾿ οὐσίαν ἐστὶν ἡ τοῦ λογικοῦ διαφορά, εἰδητική τίς ἐστιν καὶ οὐ κατὰ τὸ μᾶλλον καὶ ἧττον θεωρουμένη, ὥσπερ ἐν ἀνθρώπῳ καὶ δαίμονι·", "seq": 1830}
{"id": "Simplicius_Passim_1831", "series": "CAG", "text": "οὐ γὰρ δήποτε τὸ ἧττον τοῦ ἀνθρώπου ἐπιτεινόμενον εἰς δαιμονίαν ἥξει τελειότητα·", "seq": 1831}
{"id": "Simplicius_Passim_1832", "series": "CAG", "text": "εἰ δὲ κατὰ ἕξιν ἢ ἐνέργειαν, οὐκέτι περὶ τὴν οὐσίαν ἐστὶν ἡ τοιαύτη διαφορά.", "seq": 1832}
{"id": "Simplicius_Passim_1833", "series": "CAG", "text": "Ἀλλὰ πῶς ἡ ὕλη οὐσία τις οὖσα καὶ αὐτὴ τὸ μᾶλλον καὶ ἧττον δέχεται καὶ μικρὸν καὶ μέγα καὶ τἀναντία ὅλως φαντάζεται, καίτοι οὐσία τις οὖσα καὶ ἡ ὕλη, ὥσπερ καὶ τὸ εἶδος;", "seq": 1833}
{"id": "Simplicius_Passim_1834", "series": "CAG", "text": "ἢ καὶ αὐτὴ καθ᾿ ἑαυτὴν μὲν οὐδαμῶς διαφέρει·", "seq": 1834}
{"id": "Simplicius_Passim_1835", "series": "CAG", "text": "δυνάμει γὰρ πάντα ἐστὶν ὡσαύτως καὶ τὴν ἴσην πρὸς ὅλα τὰ ὄντα ἔμφασιν καὶ ὑποδοχὴν τῆς οὐσίας ἥ γε πρώτη ὕλη παραδέχεται·", "seq": 1835}
{"id": "Simplicius_Passim_1836", "series": "CAG", "text": "ἀπὸ δὲ τῆς τοῦ εἴδους σχέσεως παραγίνεται εἰς αὐτὴν ἡ τοιαύτη παράλλαξις.", "seq": 1836}
{"id": "Simplicius_Passim_1837", "series": "CAG", "text": "4a10 Μάλιστα δὲ οὐσίας δοκεῖ ἴδιον ἕως τοῦ ἐπὶ δὲ τῶν ἄλλων οὐδενὸς φαίνεται τὸ τοιοῦτον.", "seq": 1837}
{"id": "Simplicius_Passim_1838", "series": "CAG", "text": "Εἰπὼν ὅσα τῇ οὐσίᾳ κοινὰ καὶ πρὸς ἄλλα παρακολουθεῖ καὶ μὴ μόνῃ αὐτῇ ὑπάρχει καὶ ὅσα μὴ πάσῃ καὶ διὰ τοῦτο δείξας μηδὲν τούτων τῆς οὐσίας ἴδιον ὂν ἐπὶ τὸ μάλιστα ἴδιον αὐτῆς δοκοῦν μετελήλυθεν·", "seq": 1838}
{"id": "Simplicius_Passim_1839", "series": "CAG", "text": "τοῦτο δέ ἐστιν τὸ ταὐτὸν καὶ ἓν ἀριθμῷ ὂν τῶν ἐναντίων εἶναι δεκτικόν.", "seq": 1839}
{"id": "Simplicius_Passim_1840", "series": "CAG", "text": "καὶ τὸ μὲν μάλιστα δηλοῖ τὴν ὡς πρὸς τὰ εἰρημένα παράθεσιν, ὅτι μᾶλλον ἐκείνων ἴδιον, τὸ δὲ δοκεῖ πάλιν προσκείμενον ἐνδείκνυται ὅτι οὐδὲ τοῦτο κυρίως ἴδιόν ἐστιν, δοκεῖ δὲ ἴδιον διὰ τὸ μόνῃ τῇ οὐσίᾳ ὑπάρχειν·", "seq": 1840}
{"id": "Simplicius_Passim_1841", "series": "CAG", "text": "ἅμα δὲ ἐνδείκνυται τὸ δοκεῖ, ὅτι οὐχ οἷόν τε τὸ κυρίως ἴδιον ἐπὶ τῶν πρώτων γενῶν λαβεῖν, διὰ τὴν ἁπλότητα δηλονότι καὶ τὴν ὁλικότητα τῶν πρώτων γενῶν.", "seq": 1841}
{"id": "Simplicius_Passim_1842", "series": "CAG", "text": "τῶν δὲ ἐναντίων ἐστὶ δεκτικὸν ἡ οὐσία οὐχ ἅμα δηλονότι·", "seq": 1842}
{"id": "Simplicius_Passim_1843", "series": "CAG", "text": "οὐ γὰρ δὴ ἅμα δέξαιτο ἄν τι τὰ ἐναντία (ἀδύνατον γὰρ τοῦτο), ἀλλὰ παρὰ μέρος, τοῦ μὲν ἐξισταμένου τῶν ἐναντίων, τοῦ δὲ ἐγγινομένου.", "seq": 1843}
{"id": "Simplicius_Passim_1844", "series": "CAG", "text": "δηλοῖ δὲ τοῦτο καὶ ἐπὶ τῶν παραδειγμάτων.", "seq": 1844}
{"id": "Simplicius_Passim_1845", "series": "CAG", "text": "τὸν δὲ τρόπον τοῦ ἰδίου παρέστησεν, ὅτι ὡς μόνῳ ὑπάρχον ἴδιον αὐτὸ εἶπεν, ἐκ τοῦ ἐπ᾿ οὐδενὸς τῶν ἄλλων ὅσα μή εἰσιν οὐσίαι θεωρεῖσθαι τοῦτο τὸ ἰδίωμα.", "seq": 1845}
{"id": "Simplicius_Passim_1846", "series": "CAG", "text": "εἰ γὰρ ἐπὶ μὲν τῶν ἄλλων οὐκ ἔστιν, ἡ δὲ τὶς οὐσία ἡ ἄτομος ἀνὰ μέρος τἀναντία δέχεται, δηλονότι ἴδιον ῥηθήσεται τῆς οὐσίας οὐχ ὡς παντί (κρεῖττον γὰρ τοῦ παντὶ καὶ μὴ μόνῳ ἰδίου τὸ μόνῳ καὶ μὴ παντί·", "seq": 1846}
{"id": "Simplicius_Passim_1847", "series": "CAG", "text": "τὰ γὰρ ἴδια συστέλλεσθαι χαίρουσι), ἀλλ᾿ ὡς μόνῳ ὑπάρχον·", "seq": 1847}
{"id": "Simplicius_Passim_1848", "series": "CAG", "text": "καὶ ἐν τῷ πέμπτῳ δὲ τῶν Τοπικῶν οὕτως τὸ ἴδιον ὡρίσατο.", "seq": 1848}
{"id": "Simplicius_Passim_1849", "series": "CAG", "text": "ἔστιν δὲ καὶ κατὰ τὴν ἀντιστροφὴν αὐτὸ θεωρεῖν.", "seq": 1849}
{"id": "Simplicius_Passim_1850", "series": "CAG", "text": "εἰ γὰρ οὐσία ἐστὶν τὸ γένος, ἔστιν τι πάντως λαβεῖν ὑπὸ τὸ γένος ἓν ἄτομον, ὃ ταὐτὸν ὑπάρχον τῶν ἐναντίων ἐστὶ δεκτικόν, εἴ τε ἓν ὂν καὶ ταὐτὸν τἀναντία δέχεται, οὐσία τὸ τοιοῦτόν ἐστιν·", "seq": 1850}
{"id": "Simplicius_Passim_1851", "series": "CAG", "text": "ἴδιον οὖν ὡς ἐπὶ μόνης τῆς ἀτόμου οὐσίας θεωρούμενον.", "seq": 1851}
{"id": "Simplicius_Passim_1852", "series": "CAG", "text": "τὰ δὲ παραδείγματα ἐπὶ τοῦ τινὸς ἀνθρώπου πρόεισιν ὁτὲ μὲν κατὰ τὸ σῶμα, ὡς ἐπὶ τοῦ λευκοῦ καὶ μέλανος καὶ θερμοῦ καὶ ψυχροῦ, ὁτὲ δὲ κατὰ τὴν ψυχήν, ὡς ἐπὶ τοῦ φαύλου καὶ σπουδαίου.", "seq": 1852}
{"id": "Simplicius_Passim_1853", "series": "CAG", "text": "δοκοῦσι δὲ καὶ αἱ δεύτεραι οὐσίαι δεκτικαὶ τῶν ἐναντίων εἶναι·", "seq": 1853}
{"id": "Simplicius_Passim_1854", "series": "CAG", "text": "ὡς γὰρ Σωκράτης ἄφρων καὶ φρόνιμος, οὕτω καὶ ὁ ἄνθρωπος καὶ τὸ ζῷόν ἐστιν·", "seq": 1854}
{"id": "Simplicius_Passim_1855", "series": "CAG", "text": "ἀλλ᾿ εἰ διὰ τὸν Σωκράτη καὶ ὁ ἄνθρωπος καὶ τὸ ζῷον, οὐ καθ᾿ αὑτό, ἀλλὰ κατὰ συμβεβηκὸς ὑπάρχει τούτοις, διότι τοῖς ὑπ᾿ αὐτὰ ὑπάρχει.", "seq": 1855}
{"id": "Simplicius_Passim_1856", "series": "CAG", "text": "τὸ δὲ ἓν ἀριθμῷ πρόσκειται δηλοῦν ὅτι εἰ μὲν τὸν ἄνθρωπον καθόλου τις λαμβάνοι, οὐκ ἐπιδέχεται τἀναντία, εἰ δὲ τὸν ἐν τῷδε ἄνθρωπον, οἷον Σωκράτη, ἐπιδέχεται.", "seq": 1856}
{"id": "Simplicius_Passim_1857", "series": "CAG", "text": "Ἀλλ᾿ εἰ τὰ γένη, φασίν, καὶ τὰ εἴδη ἐπιδέχεται τἀναντία, οἷον ἄνθρωπος δειλίαν καὶ θρασύτητα, οὐ μόνον ἐν τῇ οὐσίᾳ ἔσται τοῦτο, ἀλλὰ καὶ ἐν ἄλλοις πλείοσιν·", "seq": 1857}
{"id": "Simplicius_Passim_1858", "series": "CAG", "text": "κίνησις γὰρ ταχεῖα καὶ βραδεῖα γίνεται, καὶ ἕξις καὶ διάθεσις καὶ πρᾶξις ἐπιδέχεται τἀναντία.", "seq": 1858}
{"id": "Simplicius_Passim_1859", "series": "CAG", "text": "ἢ πρῶτον μὲν τὰ καθόλου λαμβάνουσιν, ἀλλ᾿ οὐ τὰ συνυπάρχοντα κοινὰ τοῖς ἀτόμοις·", "seq": 1859}
{"id": "Simplicius_Passim_1860", "series": "CAG", "text": "ἔπειτα οὐχ ἓν ἀριθμῷ τούτων ἕκαστόν ἐστιν, ἀλλ᾿ ἄλλο καὶ ἄλλο, τὸ μὲν τοιονδί, τὸ δὲ θάτερον τῶν ἐναντίων, καὶ οὐκ αὐτὰ ἐπιδέχεται τὰ ἐναντία, ἀλλὰ τὰ ὑπ᾿ αὐτά·", "seq": 1860}
{"id": "Simplicius_Passim_1861", "series": "CAG", "text": "ἡ μὲν γὰρ γενικὴ ἕξις οὔτε φαύλη οὔτε σπουδαία, αἱ δὲ ὑπ᾿ αὐτὴν αἱ μὲν σπουδαῖαι, αἱ δὲ φαῦλαι, καὶ οὐχ ὑπομένει τὴν τῶν ἐναντίων μεταβολὴν τὸ κοινὸν θεωρούμενον.", "seq": 1861}
{"id": "Simplicius_Passim_1862", "series": "CAG", "text": "ἄλλο τοίνυν ἐστὶ τὸ οἷς πρόσεστιν τὰ ἐναντία, ἄλλο δὲ τὸ ἐπιδεκτικὸν εἶναι τῶν ἐναντίων ἀνὰ μέρος, καὶ τοῖς μὲν γένεσιν πρόσεστιν τὰ ἐναντία, τὸ δὲ ἐπιδεκτικὸν μόνῃ τῇ ὕλῃ καὶ ταῖς μετὰ τῆς ὕλης συνθέτοις οὐσίαις, τοῖς δὲ γένεσιν κατὰ συμβεβηκός.", "seq": 1862}
{"id": "Simplicius_Passim_1863", "series": "CAG", "text": "διὸ προσθετέον τῷ ἰδιώματι τῆς οὐσίας τὸ μὴ κατὰ συμβεβηκὸς τἀναντία δέχεσθαι, προσθετέον δὲ καὶ τὸ “κατὰ τὴν ἐν αὑτῷ μεταβολήν”, ἵνα τὰ ἐπὶ τῶν γενῶν ἠπορημένα μὴ παραδεχώμεθα.", "seq": 1863}
{"id": "Simplicius_Passim_1864", "series": "CAG", "text": "Πάλιν δὲ τὴν νοητὴν οὐσίαν ἐπεισάγουσιν ἐνταῦθα ὡς μὴ ἐπιδεχομένην τἀναντία.", "seq": 1864}
{"id": "Simplicius_Passim_1865", "series": "CAG", "text": "ἀλλὰ τὸ αὐτὸ ῥητέον, ὅτι οὐ περὶ ἐκείνης νῦν ὁ λόγος, ἀλλὰ περὶ τῆς λεγομένης.", "seq": 1865}
{"id": "Simplicius_Passim_1866", "series": "CAG", "text": "ἀλλὰ τίνος, φασίν, ἐναντίου ὁ ἥλιός ἐστιν δεκτικός, ὅς γε ἐν ἑνὶ εἴδει ἀεί ἐστιν ὡσαύτως;", "seq": 1866}
{"id": "Simplicius_Passim_1867", "series": "CAG", "text": "οὐδὲ γὰρ τῇ κινήσει αὐτοῦ οὐδέν ἐστιν ἐναντίον.", "seq": 1867}
{"id": "Simplicius_Passim_1868", "series": "CAG", "text": "πῶς δὲ ὅλως ἐπὶ τῶν ἀιδίων οὐσιῶν ἀληθὲς τὸ παρὰ μέρος τἀναντία δέχεσθαι;", "seq": 1868}
{"id": "Simplicius_Passim_1869", "series": "CAG", "text": "ὁ γὰρ οὐρανὸς οὐκ ἂν σταίη οὐδέποτε·", "seq": 1869}
{"id": "Simplicius_Passim_1870", "series": "CAG", "text": "στάσις δὲ κινήσει ἐναντία.", "seq": 1870}
{"id": "Simplicius_Passim_1871", "series": "CAG", "text": "ἀλλὰ καὶ τὸ πῦρ τῶν φθαρτῶν ὂν θερμότητος μέν ἐστιν ἐπιδεκτικόν, ψυχρότητος δὲ οὔ, καὶ ἡ χιὼν ἀνάπαλιν.", "seq": 1871}
{"id": "Simplicius_Passim_1872", "series": "CAG", "text": "ἢ πρὸς μὲν τὰς ἀπὸ τῶν ἀιδίων οὐσιῶν ἐνστάσεις ῥητέον ὡς τὸ ἰδίωμα ἐνταῦθα πάσης τῆς ἐν μεταβολαῖς δυναμένης γίνεσθαι οὐσίας τίθεται, ἀλλ᾿ οὐ τῆς κατὰ τὸ ἀμετάβλητον οὐσιωμένης.", "seq": 1872}
{"id": "Simplicius_Passim_1873", "series": "CAG", "text": "πρὸς δὲ τὰς ἀπὸ τοῦ πυρὸς καὶ τῆς χιόνος, ὅτι ἐπιδεκτικὴν εἶναι τῶν ἐναντίων φησίν, ἀλλ᾿ οὐχὶ οὐσιῶσθαι ἐν τοῖς ἐναντίοις·", "seq": 1873}
{"id": "Simplicius_Passim_1874", "series": "CAG", "text": "τὸ δὲ πῦρ οὐκ ἐδέξατο τὴν θερμότητα, ἀλλ᾿ ἐν τῇ οὐσίᾳ αὐτοῦ ἐστιν.", "seq": 1874}
{"id": "Simplicius_Passim_1875", "series": "CAG", "text": "οὐδὲν δὲ ἑαυτὸ ἐπιδέχεται, ἀλλὰ τῶν ἔξωθέν τι, οἷον τὸ ὕδωρ θερμότητα ἐπιδέχεται ἐπίκτητον οὖσαν ποιότητα, ὑγρότητα δὲ οὐκέτι·", "seq": 1875}
{"id": "Simplicius_Passim_1876", "series": "CAG", "text": "σύμφυτος γάρ ἐστιν αὐτῷ.", "seq": 1876}
{"id": "Simplicius_Passim_1877", "series": "CAG", "text": "καὶ τὰ οὐράνια τοίνυν ἐν τῇ κυκλοφορίᾳ τὸ εἶναι ἔχει καὶ οὐκ ἂν ἔχοι τινὰ παραδοχὴν τοῦ ἐναντίου.", "seq": 1877}
{"id": "Simplicius_Passim_1878", "series": "CAG", "text": "εἰ δὲ μήτε ποιότητές εἰσιν αἱ τοιαῦται ἰδιότητες, ἀλλ᾿ οὐσιώδεις διαφοραὶ καὶ συμπληρωτικαὶ τῆς οὐσίας, οὐκ ἂν μένον τι ἐξίσταιτο τῶν κατ᾿ οὐσίαν ὑπαρχόντων·", "seq": 1878}
{"id": "Simplicius_Passim_1879", "series": "CAG", "text": "ἀλλ᾿ οἷς μὴ φύσει καὶ ἀχωρίστως θάτερον ὑπάρχει, ταῦτα τῶν ἐναντίων ἐστὶν δεκτικά.", "seq": 1879}
{"id": "Simplicius_Passim_1880", "series": "CAG", "text": "οὐκ ἐπὶ πάντων δὲ τῶν ἐναντίων δεῖ τὸ ἐπιδεκτικὸν ἐπιζητεῖν, ἀλλ᾿ ἀρκεῖ καὶ ἐφ᾿ ἡστινοσοῦν ἐναντιώσεως·", "seq": 1880}
{"id": "Simplicius_Passim_1881", "series": "CAG", "text": "οὕτως καὶ τὸ πῦρ κατὰ τόπον τὴν ἐναντίωσιν δεχόμενον δειχθείη ἄν.", "seq": 1881}
{"id": "Simplicius_Passim_1882", "series": "CAG", "text": "ἀλλ᾿ ὁ ἥλιος ἄτομος ὢν οὐσία τίνος μετέχει ἐναντιώσεως;", "seq": 1882}
{"id": "Simplicius_Passim_1883", "series": "CAG", "text": "ἢ κἂν μὴ ἐπιδεκτικὸς τῶν ἐναντίων ἐστίν, ἀλλ᾿ ἐν τῷ γένει, φασίν, αὐτοῦ, τουτέστιν τῇ ἀτόμῳ οὐσίᾳ, ἔστι λαβεῖν τι τῶν ἀτόμων, ὃ δεκτικόν ἐστι τῶν ἐναντίων.", "seq": 1883}
{"id": "Simplicius_Passim_1884", "series": "CAG", "text": "εἰ δέ τις τοῦτο δέξαιτο, οὐδὲ τῇ ἀτόμῳ πάσῃ οὐσίᾳ ὑπάρχει τὸ ἰδίωμα, ἀλλὰ τινὶ μόνον τῇ ἐν γενέσει καὶ φθορᾷ.", "seq": 1884}
{"id": "Simplicius_Passim_1885", "series": "CAG", "text": "Διὰ τούτου δὲ τοῦ ἰδιώματος καὶ ἐκεῖνο σαφῶς ἐνδείκνυται, ὡς ἡ οὐσία καὶ μάλιστα ἡ ἄτομος ὑπόκειται πανταχοῦ πᾶσιν καὶ περὶ αὐτὴν καὶ ἐν αὐτῇ τὰ ἄλλα ὑπάρχει καὶ οὐδενὶ τῶν ἄλλων τὸ ἐπιδεκτικὸν πρόσεστιν.", "seq": 1885}
{"id": "Simplicius_Passim_1886", "series": "CAG", "text": "οὐδὲ γὰρ πρὸς τὴν οἰκείαν ὑπόστασιν ἑαυτοῖς ἐξαρκεῖ τὰ συμβεβηκότα, διὸ οὐδὲ ὑπόκειται οὐδενί, ἀλλ᾿ ἑτέρας ὑποβάθρας προσδεῖται·", "seq": 1886}
{"id": "Simplicius_Passim_1887", "series": "CAG", "text": "διὸ οὐδὲ δέχεται ταῦτα τὰ ἐναντία.", "seq": 1887}
{"id": "Simplicius_Passim_1888", "series": "CAG", "text": "τὸ μὲν γὰρ ὑποκείμενον, οἷον τὸ σῶμα, λευκὸν καὶ μέλαν γίνεται τὸ αὐτὸ μένον, τὸ δὲ λευκὸν ἐξίσταται τοῦ μέλανος ἐπιγινομένου, καὶ τὸ μὲν ζῷον καὶ ὁ ἄνθρωπος, ἐπειδὴ ὑπομένει, δέχεται ταναντία, καθόσον εἰσὶν οὐσίαι ἐν τῷ τινὶ ἀνθρώπῳ, τὸ δὲ χρῶμα οὐχ ὑπομένει, διὰ τοῦτο οὐχ ὑποδέχεται·", "seq": 1888}
{"id": "Simplicius_Passim_1889", "series": "CAG", "text": "ὅταν γὰρ ἀπίῃ τὸ λευκόν, συναπέρχεται μετ᾿ αὐτοῦ καὶ τὸ χρῶμα καὶ οὐκέτι ἔστιν, καὶ ἅμα τῷ παραγίνεσθαι τὴν μελανίαν παραγίνεται μετ᾿ αὐτῆς ἡ χρόα, ἢ εἰ μὴ τοῦτο, ἔστιν ὅτε περ ἔστιν, οὐ μέντοι μένον τὸ χρῶμα τὰ εἰσιόντα καὶ ἐξιόντα δέχεται.", "seq": 1889}
{"id": "Simplicius_Passim_1890", "series": "CAG", "text": "Ἀλλὰ τοῦτο, φασίν, συμβεβηκός ἐστιν περὶ τὴν οὐσίαν, ὃ δέ ἐστιν ἡ οὐσία, οὐκ εἴρηται.", "seq": 1890}
{"id": "Simplicius_Passim_1891", "series": "CAG", "text": "ἢ τῆς αἰσθητῆς οὐσίας συμπεφορημένης οὔσης καὶ ἐν ἄλλῳ τὸ εἶναι ἐχούσης καὶ τὰ ἰδιώματα ἔσται τοιαῦτα, ὁποία αὐτῆς ἐστιν ἡ φύσις·", "seq": 1891}
{"id": "Simplicius_Passim_1892", "series": "CAG", "text": "ὁ δὲ ζητῶν αὐτὸ τὸ εἶναι ἀόρατόν τι ζητεῖ καὶ κρεῖττον ἢ κατὰ τὴν αἰσθητὴν οὐσίαν, ὃ ἐπὶ πᾶσι ταὐτὸν ὑπάρχει οὐσίας εἶδος, δι᾿ ὅπερ ἐφ᾿ ἑκάστου καὶ ἐπὶ τοῖς κοινοῖς καὶ ἐπὶ τοῖς ἁπλοῖς καὶ ἐπὶ τοῖς συνθέτοις τὸ εἶναι λέγεται καὶ ἐφ᾿ ἑκάστου τῶν ἐννέα·", "seq": 1892}
{"id": "Simplicius_Passim_1893", "series": "CAG", "text": "τὸ γὰρ λευκὸν κατὰ μετάληψιν τοῦ ὄντος λευκὸν εἶναι λέγεται.", "seq": 1893}
{"id": "Simplicius_Passim_1894", "series": "CAG", "text": "Ἀλλ᾿ εἰ ἡ αἰσθητή, φασίν, οὐσία οὐκ ἄνευ μεγέθους οὐδὲ ἄνευ ποιότητος, πῶς ἔτι τὰ συμβεβηκότα χωρίζομεν, οἷον θερμόν, ξηρόν;", "seq": 1894}
{"id": "Simplicius_Passim_1895", "series": "CAG", "text": "τί γὰρ ἔσται οὐσία;", "seq": 1895}
{"id": "Simplicius_Passim_1896", "series": "CAG", "text": "ποιαὶ γὰρ οὐσίαι αὗται·", "seq": 1896}
{"id": "Simplicius_Passim_1897", "series": "CAG", "text": "τί οὖν ἐστιν περὶ ὃ ἡ ποιὰ οὐσία;", "seq": 1897}
{"id": "Simplicius_Passim_1898", "series": "CAG", "text": "ἢ δηλονότι τὸ ὑποκείμενον.", "seq": 1898}
{"id": "Simplicius_Passim_1899", "series": "CAG", "text": "ἔσται οὖν τὸ πῦρ οὐχ ὅλον οὐσία, ἀλλά τι αὐτοῦ οἷον μέρος·", "seq": 1899}
{"id": "Simplicius_Passim_1900", "series": "CAG", "text": "τοῦτο δὲ ἔσται ἡ ὕλη.", "seq": 1900}
{"id": "Simplicius_Passim_1901", "series": "CAG", "text": "καὶ οὗτος δὴ ὁ λόγος δύο ψευδῶς λαμβάνει·", "seq": 1901}
{"id": "Simplicius_Passim_1902", "series": "CAG", "text": "ἓν μέν, διότι τὸ σύμμικτον καὶ συμπεφορημένον τῆς ἐνταῦθα οὐσίας ἀποδιαλαμβάνων θεωρεῖ, καίτοι μηδαμῶς ὑφεστηκὸς κατ᾿ ἰδίαν ἕκαστον, ἀλλ᾿ ἐν ἀλλήλοις καὶ μετ᾿ ἀλλήλων πάντων ἐχόντων τὸ ὁπωσοῦν ὑφεστάναι·", "seq": 1902}
{"id": "Simplicius_Passim_1903", "series": "CAG", "text": "δεύτερον δέ, διότι τὸ θερμὸν καὶ τὸ ξηρὸν καὶ τὰς κατ᾿ εἴδη διαφορὰς ὡς ποιότητας λαμβάνει καὶ τὴν κατὰ τὸ εἶδος οὐσίαν οὐ προσποιεῖται ἐν τῷ λόγῳ.", "seq": 1903}
{"id": "Simplicius_Passim_1904", "series": "CAG", "text": "ἀπὸ γὰρ τούτων πάντων εἰς τὴν ἀτοπίαν προῆλθεν τοῦ νομίζειν εἶναι τὴν ὕλην κυρίως οὐσίαν.", "seq": 1904}
{"id": "Simplicius_Passim_1905", "series": "CAG", "text": "Καὶ Ἀρχύτας δὲ τὸ αὐτὸ ἴδιον τῆς οὐσίας ἀποδέδωκεν λέγων “τᾶς ὠσίας ἴδιον ὑπάρχειν τὸ τὰν αὐτὰν καὶ μίαν ἀριθμῷ διαμένοισαν τῶν ἐναντίων δεκτικὰν ἦμεν.", "seq": 1905}
{"id": "Simplicius_Passim_1906", "series": "CAG", "text": "ἐναντίον γὰρ ὕπνῳ μὲν ἐγρήγορσις, ταχυτᾶτι δὲ βραδυτάς, ὑγιείᾳ δὲ νόσος, καὶ ὁ αὐτὸς ἄνθρωπος καὶ εἷς ἀριθμῷ γίνεται δεκτικὸς τούτων·", "seq": 1906}
{"id": "Simplicius_Passim_1907", "series": "CAG", "text": "καὶ γὰρ ἐγρήγορεν καὶ εὕδει, καὶ βραδιόνως καὶ ταχιόνως κινέεται, καὶ ὑγιαίνει δὲ καὶ νοσεῖ, καὶ τῶν τούτοις ὁμοίων δεκτικός ἐντι, οὐ κατὰ τὸν αὐτὸν δὲ χρόνον”.", "seq": 1907}
{"id": "Simplicius_Passim_1908", "series": "CAG", "text": "ἐν δὲ τούτοις τό τε ἰδίωμα τῆς οὐσίας εἴρηται τὸ αὐτὸ καὶ τὴν αἰτίαν τῆς ἀνὰ μέρος μεταβολῆς τῶν ἐναντίων εἶπεν διὰ τοῦ “οὐ κατὰ τὸν αὐτὸν δὲ χρόνον”, καὶ ἔτι τὰς ἀπορίας ἔλυσεν τὰς ἀπὸ τῶν συμφύτων καὶ ἀεὶ κινουμένων καὶ ἀεὶ ὄντων προσαγομένας·", "seq": 1908}
{"id": "Simplicius_Passim_1909", "series": "CAG", "text": "πᾶσαι γὰρ αὗται οὐ κατὰ χρόνον παραγίνονται.", "seq": 1909}
{"id": "Simplicius_Passim_1910", "series": "CAG", "text": "τὰς δὲ ἀπὸ τῶν γενῶν ἀμφισβητήσεις ἔλυσεν προσθεὶς τὸ “διαμένοισαν”, ἐπεὶ ἐκεῖνά γε οὐ διαμένει·", "seq": 1910}
{"id": "Simplicius_Passim_1911", "series": "CAG", "text": "οὐ γὰρ τὸ ἐν τῷ λευκῷ χρῶμα δέχεται τὸ μέλαν, ἀλλ᾿ ἐξίσταται μετὰ τοῦ λευκοῦ καὶ οὐκέτι τὸ αὐτὸ διαμένει.", "seq": 1911}
{"id": "Simplicius_Passim_1912", "series": "CAG", "text": "Ὁ δὲ Ἰάμβλιχος Πυθαγορικώτερον καὶ διὰ πάσης οὐσίας κατὰ ἀναλογίαν διατεῖνον τὸ ἰδίωμα τοῦτο τῆς οὐσίας ἐπέδειξεν.", "seq": 1912}
{"id": "Simplicius_Passim_1913", "series": "CAG", "text": "“ἐν μὲν γὰρ τῇ νοητῇ, φησίν, οὐσίᾳ κίνησις καὶ στάσις, ταὐτότητες καὶ ἑτερότητες τῇ οὐσίᾳ ἅμα συνυπάρχουσιν, καὶ ἡ ἐναντίωσις ἐνταῦθα ἐν τῇ οὐσίᾳ ὑπάρχει οὐ παρὰ μέρος ἀλλ᾿ ἅμα, καὶ τὸ δεκτικὸν ἄλλως ἐπ᾿ αὐτῆς λέγεται ἢ ὡς ἐπὶ τῶν συνθέτων θεωρεῖται·", "seq": 1913}
{"id": "Simplicius_Passim_1914", "series": "CAG", "text": "ἐνταῦθα μὲν γὰρ διαστάσεως γινομένης ἄλλο μέν ἐστιν τὸ ὑποκείμενον, ἄλλο δὲ τὸ ἐγγινόμενον·", "seq": 1914}
{"id": "Simplicius_Passim_1915", "series": "CAG", "text": "ἐπὶ δὲ τῆς ἁπλουστάτης οὐσίας οὐκ ἄλλο μέν ἐστιν ἐν ᾧ γίνεται, ἄλλο δὲ τὸ ἐγγινόμενον, οὐδὲ ἐν ἄλλῳ καὶ ἄλλῳ, ἀλλ᾿ ἓν πάντα ἐστίν.", "seq": 1915}
{"id": "Simplicius_Passim_1916", "series": "CAG", "text": "ἐπὶ δὲ τῆς ἀεικινήτου οὐσίας σύλληψις καὶ οἷον συνοχὴ πάσης φύσεως θεωρεῖται κατὰ τὸν οὐρανόν, οὐ μόνον ἐκ τοῦ περιέχειν πάσας καὶ μηδεμίαν ἔξω αὐτῆς ὑπάρχειν, ἀλλὰ καὶ ὅτι οὐδενὸς οὔτε ῥοπῇ κινουμένου οὔτε προαιρέσει ἐμψύχου ἢ ἀψύχου ἅμα δύο τινὰς ὑπομένειν φορὰς δυναμένου ἀντιθέτους ἀλλήλαις (λέγω δὲ οἷον πρόσω καὶ ὀπίσω ἢ πάλιν εἰς δεξιὰ καὶ ἀριστερὰ καὶ ἄνω καὶ κάτω), μόνον ὁρᾶται τοῦτο ἔμπαλιν οὐ δυνάμενον μίαν ἡντιναοῦν καθ᾿ ἑαυτὴν κινεῖσθαι ἢ δύο μόνας ἢ τρεῖς, ἀλλ᾿ ἅμα πάσας.", "seq": 1916}
{"id": "Simplicius_Passim_1917", "series": "CAG", "text": "καὶ ἀμήχανόν τι περὶ αὐτὸ καὶ θαυμαστὸν ὑπάρχει τὸ τῆς ἐναντιώσεως ἑκάστῃ συλληπτικὴν ὑπάρχειν τὴν ἐναντίαν.", "seq": 1917}
{"id": "Simplicius_Passim_1918", "series": "CAG", "text": "ἡ γὰρ καθ᾿ ἕκαστον καὶ δοκοῦσα καὶ φερομένη ἀναφορὰ περὶ τὸ διχοτόμημα τοῦ ὁρίζοντος καὶ ἄνοδός τις ὑπάρχουσα ἐκ τῶν ὑπὸ γῆν εἰς τὰ ὑπὲρ γῆν εὐθὺς βιαστική ἐστιν τῆς ἐναντίας κινήσεως, τουτέστιν τῆς ἐν θατέρῳ διχοτομήματι τοῦ ὁρίζοντος, λεγομένης δὲ καταδύσεως·", "seq": 1918}
{"id": "Simplicius_Passim_1919", "series": "CAG", "text": "προωθεῖ γὰρ καὶ προκυλίνδει τρόπον τινὰ δι᾿ ἑαυτῆς τὸ σύμπαν κύτος καὶ ἐπείγει, ὥστε ἀποτελεῖν ἐκείνην οὐκ ἔλαττον ἤπερ κἀκείνη δι᾿ ἑαυτῆς τὴν ταύτης ἀπεργάζεται κίνησιν διὰ τῆς προώσεως.", "seq": 1919}
{"id": "Simplicius_Passim_1920", "series": "CAG", "text": "τὸ δὲ ἐοικὸς νοείσθω καὶ ἐπὶ τοῦ πρόσω καὶ ὀπίσω·", "seq": 1920}
{"id": "Simplicius_Passim_1921", "series": "CAG", "text": "κατὰ γὰρ τὸ λεγόμενον μεσουράνημα ἐν ἑκάστῳ οἰκήσεως ἀποκλίματι θεωρουμένου τοῦ πρόσω, τοῦ δὲ ὀπίσω κατὰ τὸ ἀντίθετον αὐτοῦ, ὃ λέγεται ἀντιμεσουράνημα, ἡ δι᾿ ἀλλήλων καὶ ἐξ ἀλλήλων ἔπειξις καὶ ἀντιπερίστασις ἀκολούθως ἀποδείκνυσθαι δύναται.", "seq": 1921}
{"id": "Simplicius_Passim_1922", "series": "CAG", "text": "τῶν δὲ λεχθεισῶν τεσσάρων περιστάσεων κοινῶς μὲν τῷ σύμπαντι ἐπινοουμένων οὐρανῷ βραχεῖάν τινα ἔνστασιν λαμβάνει τὰ περὶ τοὺς πόλους, ἀμοιροῦντα ἐκείνων διὰ τὴν τοῦ τόπου ταὐτότητα.", "seq": 1922}
{"id": "Simplicius_Passim_1923", "series": "CAG", "text": "καὶ ἐπὶ τῶν πλανωμένων δὲ ἔξεστιν τὰ λεχθέντα θεωρεῖν·", "seq": 1923}
{"id": "Simplicius_Passim_1924", "series": "CAG", "text": "ἀναφορὰς γὰρ καὶ καταφορὰς καὶ προόδους καὶ ἐπιστροφὰς ποιοῦνται οὐ μόνον δι᾿ ὧν εἴπομεν, ἀλλὰ καὶ προποδίζοντες καὶ ἀναποδίζοντες, καὶ τὴν ἐπὶ δεξιὰ καὶ ἀριστερὰ φορὰν περὶ αὐτοὺς τρανεστέραν ἔστιν ἰδεῖν εἰς βορέαν ἢ εἰς νότον ἀπὸ τοῦ μέσου καὶ ἀνάπαλιν ἐπὶ τὸ μέσον ἀμφοτέρωθεν φερομένων, ὥστε κίνησιν ἐκ κινήσεων καὶ πασῶν κινήσεων συνεκτικὴν προσεῖναι τῷ οὐρανῷ ἅμα τὰς ἐναντίας κινήσεις ἐν ἑαυτῷ περιέχοντι καὶ ἀπεργαζομένῳ τὰ ἐναντία κινήματα ἀπὸ τῶν ἐναντίων.", "seq": 1924}
{"id": "Simplicius_Passim_1925", "series": "CAG", "text": "πάρεστιν ἄρα καὶ τῷ οὐρανῷ τἀναντία καὶ ἅμα πάρεστιν καὶ ἐν ἀλλήλοις ὑφέστηκεν καὶ ἀπ᾿ ἀλλήλων ἤρτηται.", "seq": 1925}
{"id": "Simplicius_Passim_1926", "series": "CAG", "text": "πλὴν τό γε τοσοῦτον διέστηκεν τῆς νοητῆς ἐναντιώσεως, ὅτι ἡ μὲν ἑνὶ ὑπῆρχεν καὶ κατὰ μίαν οὐσίαν, ἡ δὲ ἐν ἄλλῳ καὶ ἄλλῳ καὶ περὶ ἄλλην καὶ ἄλλην οὐσίαν τὰς ἐναντίας ποιεῖται κινήσεις.", "seq": 1926}
{"id": "Simplicius_Passim_1927", "series": "CAG", "text": "ἡ δὲ τελευταία φύσις τῆς οὐσίας οὐδὲ σύμφυτα τὰ ἐναντία ἔχει ἅμα ἀμφότερα, ἀλλ᾿ εἴ που σύμφυτόν τι τῶν ἐναντίων ἐν αὐτῇ ὑπάρχει, μεμερισμένον ἔχει τὸ ἕτερον αὐτῶν, τὰ δὲ πολλὰ ὡς ἐπίκτητα ἔξωθεν παραδέχεται καὶ ταῦτα οὐχ ἅμα οὔτε κατὰ τὴν οὐσίαν οὔτε κατὰ τὸν χρόνον, ἀλλ᾿ ἄλλοτε ἄλλα καὶ ἐν ἄλλῳ μορίῳ τοῦ σώματος μεταλαμβάνουσα, ὥστε καὶ περὶ ταύτην, ᾗ πέφυκεν ταύτῃ, θεωρεῖται τὸ τῆς ἐναντιώσεως.", "seq": 1927}
{"id": "Simplicius_Passim_1928", "series": "CAG", "text": "πέφηνεν ἄρα τὸ ἰδίωμα τοῦτο τῆς οὐσίας κοινὸν κατὰ πᾶσαν οὐσίαν ὑπάρχον”.", "seq": 1928}
{"id": "Simplicius_Passim_1929", "series": "CAG", "text": "ἴδωμεν δέ, τίνα ὁ Ἀριστοτέλης τοῖς εἰρημένοις προσαπορεῖ.", "seq": 1929}
{"id": "Simplicius_Passim_1930", "series": "CAG", "text": "4a22 Εἰ μή τις ἐνίσταιτο τὸν λόγον καὶ τὴν δόξαν φάσκων ἕως τοῦ ὥστε ἴδιον οὐσίας εἴη τὸ ταὐτὸν καὶ ἓν ἀριθμῷ ὂν τῶν ἐναντίων εἶναι δεκτικόν.", "seq": 1930}
{"id": "Simplicius_Passim_1931", "series": "CAG", "text": "Ἐπειδὴ καὶ λόγος καὶ δόξα ἀληθὴς καὶ ψευδὴς εἶναι δοκεῖ καὶ ἔστιν ἐναντίον τὸ ἀληθὲς τῷ ψεύδει, ὁ δὲ λόγος οὐκ ἔστιν οὐσία, ἀλλ᾿ ὁ μὲν ἐν προφορᾷ ποσόν, ὁ δὲ ἐν δόξῃ ποιόν, εἰκότως ἀπορεῖ, μήποτε οὐ μόνῃ τῇ οὐσίᾳ προσήκει τὸ τῶν ἐναντίων εἶναι δεκτικόν.", "seq": 1931}
{"id": "Simplicius_Passim_1932", "series": "CAG", "text": "καὶ λύει τὴν ἀπορίαν κατὰ ἀντιπαράστασιν καὶ ἔνστασιν.", "seq": 1932}
{"id": "Simplicius_Passim_1933", "series": "CAG", "text": "πρότερον γὰρ συγχωρήσας δέχεσθαι τὸ ἀληθὲς καὶ ψεῦδος τὸν λόγον καὶ τὴν δόξαν δείκνυσιν ὅτι οὐχ ὡς ἡ οὐσία δέχεται·", "seq": 1933}
{"id": "Simplicius_Passim_1934", "series": "CAG", "text": "ἐκείνη μὲν γὰρ τῇ ἑαυτῆς μεταβολῇ δέχεται τὰ ἐναντία, ὁ δὲ λόγος καὶ ἡ δόξα οὐ τῇ ἑαυτῶν μεταβολῇ, ἀλλὰ τῇ τοῦ πράγματος.", "seq": 1934}
{"id": "Simplicius_Passim_1935", "series": "CAG", "text": "εἶτα καὶ τὸ δέχεσθαι ὅλως ἀναιρεῖ·", "seq": 1935}
{"id": "Simplicius_Passim_1936", "series": "CAG", "text": "τὸ μὲν γὰρ δεχόμενον μεταβολήν τινα ὑπομένει, ἐν δὲ τῷ λόγῳ καὶ τῇ δόξῃ οὐδεμία γίνεται μεταβολή, ἀλλὰ τῷ τὸ πρᾶγμα μεταβάλλειν ὁ λόγος καὶ ἡ δόξα ἀληθὴς καὶ ψευδὴς λέγεται·", "seq": 1936}
{"id": "Simplicius_Passim_1937", "series": "CAG", "text": "κυρίως δὲ εἶπεν τὸ λέγεσθαι καὶ οὐ γίνεσθαι.", "seq": 1937}
{"id": "Simplicius_Passim_1938", "series": "CAG", "text": "ἔστιν δὲ καὶ οὕτως ἐπιχειρῆσαι·", "seq": 1938}
{"id": "Simplicius_Passim_1939", "series": "CAG", "text": "οὐκ ἔστιν εἷς κατ᾿ ἀριθμὸν ὁ πρότερος ῥηθεὶς λόγος τῷ δευτέρῳ καὶ κατ᾿ αὐτὸν τὸν Ἀριστοτέλη·", "seq": 1939}
{"id": "Simplicius_Passim_1940", "series": "CAG", "text": "εἴρηται γάρ, φησί, καὶ οὐκέτι ἔσται τὸ ῥηθὲν λαβεῖν.", "seq": 1940}
{"id": "Simplicius_Passim_1941", "series": "CAG", "text": "τῶν γὰρ κατὰ διέξοδον κινουμένων ἐστὶν ὁ λόγος, καὶ διὰ τοῦτο οὐδὲ τῶν θέσιν ἐχόντων ἐστίν, ὥστε τῷ εἴδει ὁ αὐτὸς γίνεται ὁ πρότερος ῥηθεὶς τῷ δευτέρῳ, ὁ ἀληθὴς τῷ ψευδεῖ, καὶ οὐχὶ τῷ ἀριθμῷ, ὡς εἴρηται ἐπὶ τῆς οὐσίας.", "seq": 1941}
{"id": "Simplicius_Passim_1942", "series": "CAG", "text": "καὶ ἡ δόξα δὲ λόγος ἐστὶν ἐντός, ἐν διεξόδῳ καὶ αὐτὴ ὑπάρχουσα, καὶ τὰ αὐτὰ ἂν καὶ περὶ αὐτῆς λέγοιτο.", "seq": 1942}
{"id": "Simplicius_Passim_1943", "series": "CAG", "text": "Ἀλλ᾿ ἀποροῦσί τινες καὶ πρὸς ταύτας ἐνιστάμενοι τὰς ἐπιχειρήσεις καὶ λέγουσιν ὡς κἂν μὴ πάσχῃ τὸ τῶν ἐκτὸς πάθος ὁ λόγος καὶ ἡ δόξα, οὐκ ἤδη διὰ τοῦτο οὐδὲ πάσχει, ἀλλὰ πάσχει ὡς ὁ λόγος καὶ δέχεται ἐν ἑαυτῷ μεταβολὴν τὴν κατὰ τὸ ἀληθεύειν καὶ ψεύδεσθαι·", "seq": 1943}
{"id": "Simplicius_Passim_1944", "series": "CAG", "text": "λόγου γὰρ καὶ δόξης αὕτη ἐναντίωσις.", "seq": 1944}
{"id": "Simplicius_Passim_1945", "series": "CAG", "text": "ἐπεὶ ὥρα γε, φησί, λέγειν μηδὲ τὴν ψυχὴν δεκτικὴν εἶναι τῶν ἐναντίων, ἐπεὶ οὐ δέχεται τὸ λευκὸν καὶ μέλαν·", "seq": 1945}
{"id": "Simplicius_Passim_1946", "series": "CAG", "text": "οὐ γὰρ πέφυκεν τούτων εἶναι δεκτική, ὧν δὲ πέφυκεν, ταῦτα δέχεται, φρόνησιν καὶ ἀφροσύνην.", "seq": 1946}
{"id": "Simplicius_Passim_1947", "series": "CAG", "text": "καὶ ὁ λόγος οὖν καὶ ἡ δόξα τὴν λόγου καὶ δόξης μεταβολὴν τὴν κατὰ τὸ ἀληθὲς καὶ ψεῦδος δέχεται, ἀλλ᾿ οὐχὶ τὴν κατὰ τὸ καθῆσθαι καὶ μὴ καθῆσθαι.", "seq": 1947}
{"id": "Simplicius_Passim_1948", "series": "CAG", "text": "ἔσται οὖν περὶ αὐτὰ κατὰ μεταβολὴν μὲν ἡ ἐναντίωσις, ἀλλὰ τὴν προσήκουσαν τῷ λόγῳ καὶ τῇ δόξῃ.", "seq": 1948}
{"id": "Simplicius_Passim_1949", "series": "CAG", "text": "μήποτε οὖν μέσον χωρήσαντα τῶν τε Ἀριστοτέλους λόγων καὶ τῶν πρὸς αὐτοὺς ἐνισταμένων δεῖ λέγειν ὅτι ἄλλος οὗτος καταδοχῆς ἐστι τρόπος, ὅταν ἄλλου πάσχοντος αὐτό τι μὴ μεταβάλλον ἀλλοιοτέραν ὅμως ἀναδέχεται σχέσιν, ὡς ὁρῶμεν καὶ ἐπὶ τῶν πρός τι·", "seq": 1949}
{"id": "Simplicius_Passim_1950", "series": "CAG", "text": "τὸ γὰρ πρότερον ὂν δεξιὸν μηδὲν αὐτὸ μεταβάλλον ἀριστερὸν γίνεται ἄλλου μεταστάντος.", "seq": 1950}
{"id": "Simplicius_Passim_1951", "series": "CAG", "text": "καὶ ὁ λόγος δὲ καὶ ἡ δόξα κατὰ τὴν πρὸς τὰ πράγματα σχέσιν ἔχοντα τὸ ἀληθεύειν καὶ ψεύδεσθαι οὐδὲν θαυμαστὸν εἰ τῶν πραγμάτων μεταβαλλόντων ἀμείβει τὴν σχέσιν οὐδὲν αὐτὰ πάσχοντα.", "seq": 1951}
{"id": "Simplicius_Passim_1952", "series": "CAG", "text": "ὁ δέ γε Ἀριστοτέλης τὴν καταδοχὴν ἐκείνην ἀπέφησεν, καθ᾿ ἣν ἀνάγκη πάσχειν τι τὸ δεχόμενον·", "seq": 1952}
{"id": "Simplicius_Passim_1953", "series": "CAG", "text": "κἂν λέγοιτο οὖν μεταβάλλειν κατὰ τὴν λόγου καὶ δόξης μεταβολήν, ἀλλ᾿ οὔτι γε πάσχοντα μεταβάλλει, ὥσπερ τὸ σῶμα θερμαινόμενον καὶ ψυχόμενον.", "seq": 1953}
{"id": "Simplicius_Passim_1954", "series": "CAG", "text": "Ἀλλὰ τίνι, φησίν, ἐπερείσαντες τὴν διάνοιαν τὰ μὲν οὐσίας εἴποιμεν, τὰ δὲ πάθη;", "seq": 1954}
{"id": "Simplicius_Passim_1955", "series": "CAG", "text": "ἆρα τῷ τινὶ εἶναι καὶ τῷ τόδε καὶ τῷ ὑποκείμενον εἶναι καὶ μὴ ἐν ὑποκειμένῳ καὶ τῷ ὅ ἐστιν μὴ ἄλλου εἶναι;", "seq": 1955}
{"id": "Simplicius_Passim_1956", "series": "CAG", "text": "ἀλλ᾿ ἡ δευτέρα οὐσία οὐδὲν τούτων ἔχει σχεδόν·", "seq": 1956}
{"id": "Simplicius_Passim_1957", "series": "CAG", "text": "καὶ γὰρ κατ᾿ ἄλλου λέγεται καὶ ἐν ἄλλῳ ἐστὶν καὶ ἄλλου, καὶ τὸ τόδε οὐκ ἐφαρμόττει αὐτῇ.", "seq": 1957}
{"id": "Simplicius_Passim_1958", "series": "CAG", "text": "ἢ ὁ ταῦτα λέγων εἰς τὴν ἄσχετον εἰδικὴν καὶ γενικὴν οὐσίαν ἀφορᾷ, ἀλλ᾿ οὐκ εἰς τὴν κατατεταγμένην καὶ ἤδη γενομένην αἰσθητήν, ᾗ πάντα ὑπάρχει τὰ εἰρημένα κατὰ τὴν ἐν τῷ ἀτόμῳ κατάταξιν.", "seq": 1958}
{"id": "Simplicius_Passim_1959", "series": "CAG", "text": "τὸ δὲ ἐν ἄλλῳ εἰ πρόσεστιν αὐτῇ καὶ ἄλλου, οὐχ ὡς ἐν ὑποκειμένῳ οὐδὲ ὡς τὸ λευκὸν τοῦ σώματος, ἀλλ᾿ ὡς τὰ μέρη τῆς οὐσίας.", "seq": 1959}
{"id": "Simplicius_Passim_1960", "series": "CAG", "text": "χρὴ δὲ καὶ τοῦτο εἰδέναι, ὡς τῶν ἀνωτάτω γενῶν οὐχ οἷόν τε ἀκριβεῖς ὅρους ἀποδιδόναι, ἀλλ᾿ ὑπομνήσει μᾶλλον καὶ ὑπογραφῇ ἐοίκασιν οἱ περὶ αὐτῶν λόγοι, καὶ δεῖ μὴ πλέον οὗ δύνανται παρ᾿ αὐτῶν ἀπαιτεῖν.", "seq": 1960}
{"id": "Simplicius_Passim_1961", "series": "CAG", "text": "ἀρκεῖ οὖν καὶ ἴδιόν τι ἀποδοῦναι περὶ αὐτῶν, ἀφ᾿ οὗ δυνατὸν τί ἐστι γινώσκειν.", "seq": 1961}
{"id": "Simplicius_Passim_1962", "series": "CAG", "text": "Αὐτὸ δὲ τοῦτο ἐπιστάσεως ἄξιον, πῶς λέγεται ἡ οὐσία κατὰ τὴν αὑτῆς μεταβολὴν δεκτικὴ τῶν ἐναντίων.", "seq": 1962}
{"id": "Simplicius_Passim_1963", "series": "CAG", "text": "οὔτε γὰρ ἡ ὕλη κατὰ τοὺς ἀπαθῆ τὴν ὕλην λέγοντας μεταβάλλει ἢ τρέπεται ἢ πάσχει τἀναντία, ἀλλὰ περὶ αὐτὴν αἱ μεταβολαὶ γίνονται·", "seq": 1963}
{"id": "Simplicius_Passim_1964", "series": "CAG", "text": "καὶ τὸ εἶδος δέ, εἰ ἀκίνητόν ἐστι πάντῃ καὶ μένον τὸ αὐτὸ δέχεται τὰς κατὰ τὸ ποιὸν ἐναντιώσεις, οὐδὲ τοῦτο κατὰ τὴν ἐν ἑαυτῷ μεταβολὴν ἕξει τἀναντία·", "seq": 1964}
{"id": "Simplicius_Passim_1965", "series": "CAG", "text": "ἀλλ᾿ εἴπερ ἄρα, μόνον τὸ σύνθετον μεταβάλλον καὶ τρεπόμενον τὰς ἐναντιώσεις ἕξει, καὶ οὕτως ἐπὶ μόνης τῆς ἀτόμου καὶ συνθέτου οὐσίας τὸ ἴδιον τοῦτο ἀποδοθήσεται, καὶ εἰς στενὸν κομιδῇ ἀποκλεισθήσεται ἡ τοῦ ἰδίου τῆς οὐσίας ἀπόδοσις.", "seq": 1965}
{"id": "Simplicius_Passim_1966", "series": "CAG", "text": "ἀλλὰ μὴν ἐὰν χρησώμεθα ταῖς ἐνίων Περιπατητικῶν δόξαις καὶ πάσχειν τὴν ὕλην ἀποφηνώμεθα, πῶς ἁπλῆ οὖσα ἡ ὕλη καὶ κατὰ τὸ δυνάμει μόνον ἱσταμένη μεταβάλλουσα ἐξ οὗπέρ ἐστιν καὶ εἰς ἐνέργειαν ἐρχομένη οὐ φθορὰν ἕξει τὴν μεταβολήν;", "seq": 1966}
{"id": "Simplicius_Passim_1967", "series": "CAG", "text": "τὸ γὰρ ἁπλοῦν μὴ ἐν ἄλλῳ μὲν ἔχον τὸ εἶναι, κατ᾿ ἄλλο δὲ μεταβάλλον φθορὰν ἕξει τὴν μεταβολὴν ὅλον ἀφ᾿ ἑαυτοῦ ἐξιστάμενον.", "seq": 1967}
{"id": "Simplicius_Passim_1968", "series": "CAG", "text": "εἰ δέ τις ταῦτα εὐλαβούμενος περὶ τὴν ὕλην λέγει τὴν ἐναντίωσιν, οὐκέτι τῷ αὐτήν τι παθεῖν ἢ μεταβάλλειν, ἀλλὰ κατὰ συμβεβηκὸς ἕξει περὶ αὑτὴν τὰ ἐναντία.", "seq": 1968}
{"id": "Simplicius_Passim_1969", "series": "CAG", "text": "καὶ ἐπὶ τοῦ εἴδους δὲ ὁ αὐτὸς λόγος·", "seq": 1969}
{"id": "Simplicius_Passim_1970", "series": "CAG", "text": "εἰ γὰρ αἱ νοηταὶ μὲν αὐτοῦ ἰδιότητες αἱ αὐταὶ μένουσιν, περὶ δὲ τὰς αἰσθητὰς αὐτοῦ διαφορὰς ἐναντίαι συμβαίνουσι ποιότητες, τὸ μὲν εἶδος ἔσται μένον πανταχοῦ ἀκίνητον, ἄλλο δὲ ἔσται τὸ τρεπόμενον, καὶ οὐ κατὰ τὴν ἐν αὐτῷ τῷ εἴδει μεταβολὴν ὁ ἄνθρωπος ἐκ λευκοῦ μέλας γίνεται.", "seq": 1970}
{"id": "Simplicius_Passim_1971", "series": "CAG", "text": "πρὸς δὲ ταῦτα συμμέτρως τοῖς παροῦσιν ἔστιν εἰπεῖν ὅτι ἕκαστον ὡς πέφυκεν, οὕτως καὶ μεταβάλλει, καὶ ἡ μὲν ὕλη μεταβολὴν ἔχει τὴν ἄλλοτε ἄλλου εἴδους ὑποδοχήν (αὐτὸ γὰρ τοῦτο ὑποδοχὴ βούλεται εἶναι), τὸ δὲ εἶδος τὴν κατὰ ποιότητα ἀλλοίωσιν.", "seq": 1971}
{"id": "Simplicius_Passim_1972", "series": "CAG", "text": "καὶ μήποτε καὶ προανεῖλεν ὁ Ἀριστοτέλης τὰς τοιαύτας ἀπορίας εἰπὼν τὸ ταὐτὸν καὶ ἓν ἀριθμῷ μένον·", "seq": 1972}
{"id": "Simplicius_Passim_1973", "series": "CAG", "text": "δῆλον γὰρ ὅτι τὴν τοῦ τοιούτου μεταβολὴν ἐπιζητεῖν χρή.", "seq": 1973}
{"id": "Simplicius_Passim_1974", "series": "CAG", "text": "ἀλλὰ περὶ μὲν οὐσίας ἀρκεῖ τοσαῦτα.", "seq": 1974}
{"id": "Simplicius_Passim_1975", "series": "CAG", "text": "Περὶ ποσοῦ.", "seq": 1975}
{"id": "Simplicius_Passim_1976", "series": "CAG", "text": "4b20 Τοῦ δὲ ποσοῦ τὸ μέν ἐστι διωρισμένον, τὸ δὲ συνεχές.", "seq": 1976}
{"id": "Simplicius_Passim_1977", "series": "CAG", "text": "Μετὰ τὴν οὐσίαν περὶ τοῦ ποσοῦ διδάσκειν ὁ Ἀριστοτέλης προτίθεται.", "seq": 1977}
{"id": "Simplicius_Passim_1978", "series": "CAG", "text": "καὶ δεῖ πρῶτον τὴν αἰτίαν τῆς τάξεως εὑρεῖν, δι᾿ ἣν δεύτερον τὸ ποσὸν μετὰ τὴν οὐσίαν ἐτάχθη.", "seq": 1978}
{"id": "Simplicius_Passim_1979", "series": "CAG", "text": "λέγουσιν οὖν ὅτι συνυφίσταται τῷ ὄντι τὸ ποσόν (ἅμα γὰρ ὄν τί ἐστιν καὶ εὐθὺς ἢ ἓν ἢ πολλὰ ἀνάγκη αὐτὸ εἶναι), καὶ ὅτι τὰ πλεῖστα κοινά ἐστιν τῇ τε οὐσίᾳ καὶ τῷ ποσῷ, ὡς τὸ μὴ ἔχειν ἐναντίον καὶ τὸ μὴ ἐπιδέχεσθαι τὸ μᾶλλον καὶ τὸ ἧττον, καίτοι τὸ ποιὸν ἀμφότερα ταῦτα ἔχει, καὶ ὅτι προηγεῖται τὸ ἄποιον διαστατὸν τῆς ἐν αὐτῷ ἐγγινομένης ποιότητος, καὶ ὅτι τῶν μὲν ἄλλων ἀναιρεθέντων οὐκ ἀναιρεῖται ἡ οὐσία, εἰ τὸ διαστατὸν καταλείποιτο, τούτου δὲ ἀναιρεθέντος συνανῄρηται ἡ σωματικὴ οὐσία·", "seq": 1979}
{"id": "Simplicius_Passim_1980", "series": "CAG", "text": "ὥστε σύνεγγύς ἐστιν τῇ οὐσίᾳ τὸ ποσόν.", "seq": 1980}
{"id": "Simplicius_Passim_1981", "series": "CAG", "text": "προστίθει δὲ ὅτι καὶ ἐν ταῖς κινήσεσιν ἡ κατὰ ποσὸν κίνησις, τουτέστιν ἡ αὔξησις καὶ μείωσις, ἐγγυτέρω ἐστὶν τῆς κατ᾿ οὐσίαν, τουτέστιν τῆς γενέσεως καὶ φθορᾶς, ἤπερ ἡ ἀλλοίωσις κατὰ ποιότητα οὖσα κίνησις.", "seq": 1981}
{"id": "Simplicius_Passim_1982", "series": "CAG", "text": "καίτοι δὲ οὕτως ἐγγὺς οὖσα τῆς οὐσίας ἡ ποσότης ἄλλη παρὰ τὴν οὐσίαν ἐστίν.", "seq": 1982}
{"id": "Simplicius_Passim_1983", "series": "CAG", "text": "περὶ γὰρ τὴν οὐσίαν ἡ μεταβολὴ τῆς ποσότητος γίνεται, ὅταν τὸ ἐνιαυσιαῖον παιδίον εἰς μεῖζον μεταβάλλῃ, τοῦ εἴδους τοῦ αὐτοῦ μένοντος·", "seq": 1983}
{"id": "Simplicius_Passim_1984", "series": "CAG", "text": "τὸ γὰρ ὑπομένον καὶ ἀνὰ μέρος ἑκάτερον δεχόμενον ἀνάγκη ἕτερον ἑκατέρου εἶναι.", "seq": 1984}
{"id": "Simplicius_Passim_1985", "series": "CAG", "text": "καὶ οὕτως καὶ τὸ ποιὸν ἕτερον τῆς οὐσίας δείκνυται, ὡς ἀπὸ πάθους ἐπὶ πάθος μεταβαλλούσης αὐτῆς καὶ ἀπὸ διαθέσεως ἐπὶ διάθεσιν.", "seq": 1985}
{"id": "Simplicius_Passim_1986", "series": "CAG", "text": "Ὁ μέντοι Ἀρχύτας μετὰ τὴν οὐσίαν τὸ ποιὸν ἔταξεν, ὡδέ πως αὐτῇ τὴν τάξιν παραδιδούς·", "seq": 1986}
{"id": "Simplicius_Passim_1987", "series": "CAG", "text": "“ἁ δὲ τάξις αὐτῶν ὧδε ἔχει·", "seq": 1987}
{"id": "Simplicius_Passim_1988", "series": "CAG", "text": "πρώτα μὲν τέτακται οὐσία διὰ τὸ μόναν ταύταν ὑποκεῖσθαι τοῖς ἄλλοις καὶ αὐτὰν καθ᾿ ἑαυτὰν δύνασθαι νοεῖσθαι, τὰς δὲ ἄλλας μὴ ἄνευ ταύτας·", "seq": 1988}
{"id": "Simplicius_Passim_1989", "series": "CAG", "text": "ἤτοι γὰρ κατὰ ταύτας ἢ ταύτῃ ἐν ὑποκειμένῳ κατηγορεῦνται·", "seq": 1989}
{"id": "Simplicius_Passim_1990", "series": "CAG", "text": "δευτέρα δὲ ἁ ποιότας·", "seq": 1990}
{"id": "Simplicius_Passim_1991", "series": "CAG", "text": "ἄνευ γὰρ τῶ τί ἐστιν ἦμεν ἀδύνατον ποιόν τι ἦμεν”.", "seq": 1991}
{"id": "Simplicius_Passim_1992", "series": "CAG", "text": "ἐν δὲ τούτοις παντός ἐστιν ἐπιζητεῖν τοῦ φιλομαθῶς ἔχοντος, εἰς τί βλέπων ἑκάτερος ὁ μὲν τὸ ποιὸν προέταξεν, ὁ δὲ τὸ ποσόν.", "seq": 1992}
{"id": "Simplicius_Passim_1993", "series": "CAG", "text": "ἔοικεν τοίνυν ὁ μὲν Ἀρχύτας τὸ καθ᾿ αὑτὸ νοητὸν ὂν καὶ ὄντως ἐν τοῖς πᾶσι γένεσι τὴν συμπλήρωσιν παρέχον καὶ πᾶσι παρὸν ἀμερίστως καὶ ὑπ᾿ αὐτῶν μετεχόμενον, τοῦτο προϋπάρχειν ὑποθέμενος κατὰ τὴν πρὸς τοῦτο συγγένειαν τὴν τάξιν τοῖς γένεσιν ἀποδεδωκέναι.", "seq": 1993}
{"id": "Simplicius_Passim_1994", "series": "CAG", "text": "τοιγαροῦν τὴν οὐσίαν προτάττει τῶν ὅλων, διότι τοῖς ἄλλοις ὑποκειμένη πᾶσιν τὸ εἶναι ἀφ᾿ ἑαυτῆς παρέχει, ὥσπερ καὶ ἡ καθ᾿ αὑτὴν οὐσία τοῖς πᾶσιν ἐνδίδωσι τὸ εἶναι.", "seq": 1994}
{"id": "Simplicius_Passim_1995", "series": "CAG", "text": "ἔτι δὲ ἡ οὐσία, φησίν, αὐτὴ καθ᾿ αὑτὴν ἔστιν τε καὶ νοεῖται, αἱ δὲ ἄλλαι οὐκ ἄνευ ταύτης·", "seq": 1995}
{"id": "Simplicius_Passim_1996", "series": "CAG", "text": "καὶ κατὰ ταῦτα οὖν συγγενῶς ἂν ἔχοι πρὸς τὸ καθ᾿ αὑτὸ ὂν καὶ ἀπολελυμένον πάσης σχέσεως.", "seq": 1996}
{"id": "Simplicius_Passim_1997", "series": "CAG", "text": "οὕτως μὲν οὖν ἡ οὐσία προετάχθη τῶν ἄλλων γενῶν.", "seq": 1997}
{"id": "Simplicius_Passim_1998", "series": "CAG", "text": "ἐπειδὴ δὲ τὰς νοητὰς οὐσίας οὐκ ἄλλως ἢ κατὰ τὰ εἴδη γνωρίζομεν, καὶ τὰς αἰσθητὰς δὲ εἰ μέλλοιμεν πρὸς ἐκείνας ἀναφέροντες γνωρίζειν, ἀπὸ τῶν ἰδιωμάτων αὐτὰς καὶ τῶν χαρακτήρων ἐπιγνωσόμεθα τῶν περὶ τὴν οὐσίαν, οἵτινες κατὰ τὴν ποιότητα θεωροῦνται, εἰκότως τὸ ποιὸν προηγουμένην ἕξει τῶν ἄλλων τάξιν μετὰ τὴν οὐσίαν.", "seq": 1998}
{"id": "Simplicius_Passim_1999", "series": "CAG", "text": "ἔτι δέ, εἰ τῆς μὲν ποιότητος ἀναιρεθείσης πᾶσα ἰδιότης καὶ πᾶς χαρακτὴρ καὶ νοητὸς καὶ αἰσθητὸς ἀναιρεῖται, τῆς δὲ ποσότητος ἀναιρεθείσης τὸ αἰσθητὸν μόνον καὶ σύνθετον ἀναιρεῖται, δῆλον οἶμαι πόσῳ τὸ ποιὸν τοῦ ποσοῦ διενήνοχεν πρὸς τὴν τῆς νοητῆς οὐσίας συγγένειαν.", "seq": 1999}
{"id": "Simplicius_Passim_2000", "series": "CAG", "text": "εἰ δέ τις τὴν νοητὴν οὐσίαν μὴ προσποιούμενος ἀπὸ τῆς πρὸς τὴν αἰσθητὴν οὐσίαν σχέσεως βούλοιτο ταῖς ἄλλαις κατηγορίαις τὴν τάξιν ἀποδιδόναι, καὶ οὕτως, ἐπειδὴ κυριωτάτη οὐσία ἡ κατὰ τὸ εἶδός ἐστιν, τὸ συγγενὲς πρὸς τὸ εἶδος, ὅπερ ἐστὶ τὸ ποιόν, τοῦτο ἂν εἴη τῇ οὐσίᾳ συγγενέστερον.", "seq": 2000}
{"id": "Simplicius_Passim_2001", "series": "CAG", "text": "ἔτι δέ, εἰ τὸ μὲν ποιὸν ἀμέριστόν ἐστιν καὶ ἀδιάστατον καὶ ἀμερίστως διαιρεῖται περὶ τοῖς σώμασιν, τὸ δὲ ποσὸν διαστατὸν καὶ διαιρετὸν καὶ μεριστόν, εὐλόγως ἂν προτάττοιτο τὸ ποιὸν ὡς ταῖς ἀσωμάτοις ἀρχαῖς οἰκειότερον.", "seq": 2001}
{"id": "Simplicius_Passim_2002", "series": "CAG", "text": "καὶ τοῦτο δὲ εἰ δοκεῖ προσθετέον, ὅτι ὥσπερ ἡ οὐσία τοῦ ποσοῦ προϋπάρχει, διότι τὸ εἶναι τῷ ποσῷ ἀπὸ τῆς οὐσίας ἐνδίδοται, οὕτως καὶ μετὰ τὸ ποιὸν ἂν εἴη τὸ ποσόν, ἐπειδὴ τὸν χαρακτῆρα αὐτὸν καὶ τὴν ἰδιότητα ἀπὸ τῆς ποιότητος ἔχει.", "seq": 2002}
{"id": "Simplicius_Passim_2003", "series": "CAG", "text": "ἀλλὰ συνυφίσταται, φασί, τῷ ὄντι τὸ ποσόν·", "seq": 2003}
{"id": "Simplicius_Passim_2004", "series": "CAG", "text": "ἢ γὰρ ἓν εὐθὺς ἢ πολλά.", "seq": 2004}
{"id": "Simplicius_Passim_2005", "series": "CAG", "text": "ἢ πρὸ τοῦ ποσοῦ τὸ ποιὸν συνυφίσταται, ὁ χαρακτὴρ αὐτός, καθ᾿ ὃν ἓν λέγεται, ὁπότε καὶ αὐτὸ τὸ ἓν καὶ τὰ πολλὰ κατὰ τὸν τοῦ ποιοῦ χαρακτῆρα ὑφέστηκεν.", "seq": 2005}
{"id": "Simplicius_Passim_2006", "series": "CAG", "text": "εἰ δὲ κοινὰ πλείονα τῷ ποσῷ πρὸς τὴν οὐσίαν ὑπάρχει, οὐ χρή, φησὶν ὁ θεῖος Ἰάμβλιχος, ἀπὸ συμβεβηκότων καὶ τῶν ἄλλως παρακολουθούντων τὴν κατ᾿ οὐσίαν αὐτῶν τάξιν συλλογίζεσθαι.", "seq": 2006}
{"id": "Simplicius_Passim_2007", "series": "CAG", "text": "ῥητέον δὲ ἴσως, ὅτι τὰ πορρώτερον διεστῶτα πολλάκις ἐναργεστέραν προφαίνει τὴν ἀνόμοιον ὁμοιότητα, ὡς ἡ ἀδιαίρετος ἐν τῷ ἀριθμῷ μονὰς ὁμοία δοκεῖ τῇ πρὸ τοῦ ἀριθμοῦ μονάδι καὶ τὴν ὕλην τῷ πρώτῳ αἰτίῳ ἀνομοίως ὡμοιῶσθαί φασιν.", "seq": 2007}
{"id": "Simplicius_Passim_2008", "series": "CAG", "text": "ἀλλ᾿ ὁ μὲν Ἀρχύτας εἰς ταῦτα ἢ τοιαῦτά τινα ἀποβλέψας ἴσως τὸ ποιὸν προτέθεικεν τοῦ ποσοῦ, ὁ δὲ Ἀριστοτέλης πρώτην οὐσίαν ὑποθέμενος τὴν σύνθετον καὶ σωματικὴν διὰ τὸ γνωριμωτέραν εἶναι ταύτην τῇ συνηθείᾳ τῇ λεκτικῇ εἰκότως ταύτῃ τὸ ποσὸν συνέταξεν ὡς οἰκειότερον καὶ γνωριμώτερον καὶ τῇ διαστάσει τῆς τοιαύτης οὐσίας συνυπάρχον.", "seq": 2008}
{"id": "Simplicius_Passim_2009", "series": "CAG", "text": "καὶ οὐδὲν θαυμαστὸν ἑκάτερον οἰκείαν τὴν τάξιν ἀποδεδωκέναι ταῖς ἑαυτοῦ ὑποθέσεσιν.", "seq": 2009}
{"id": "Simplicius_Passim_2010", "series": "CAG", "text": "Διαιρεῖται δὲ τὸ ποσὸν εἴς τε τὸ συνεχὲς καὶ εἰς τὸ διωρισμένον.", "seq": 2010}
{"id": "Simplicius_Passim_2011", "series": "CAG", "text": "ταῦτα γὰρ ὑπὸ γένος ἐστὶν τὸ ποσόν·", "seq": 2011}
{"id": "Simplicius_Passim_2012", "series": "CAG", "text": "καὶ γὰρ ἐν τῷ τί ἐστιν αὐτῶν κατηγορεῖται τὸ ποσὸν καὶ οὔτε κατὰ συμβεβηκὸς οὔτε ὄνομα μόνον ἐστίν, ἀλλ᾿ ἐπίσης μετέχει τοῦ ποσοῦ·", "seq": 2012}
{"id": "Simplicius_Passim_2013", "series": "CAG", "text": "ἀμφότερα γὰρ ὁμοίως τὸ ἴσον καὶ τὸ ἄνισον ἐπιδέχεται καὶ τὸ διπλάσιον καὶ ἥμισυ.", "seq": 2013}
{"id": "Simplicius_Passim_2014", "series": "CAG", "text": "γίνεται δὲ ἡ διαίρεσις αὕτη οὐκ εἰς εἴδη τοῦ ποσοῦ, ἀλλ᾿ εἰς διαφοράς·", "seq": 2014}
{"id": "Simplicius_Passim_2015", "series": "CAG", "text": "εἴδη μὲν γὰρ τοῦ ποσοῦ τὸ μέγεθος καὶ τὸ πλῆθος, διαφοραὶ δὲ τὸ συνεχὲς καὶ διωρισμένον·", "seq": 2015}
{"id": "Simplicius_Passim_2016", "series": "CAG", "text": "τὸ γὰρ μέγεθος ποσόν ἐστι συνεχὲς καὶ τὸ πλῆθος ποσὸν διωρισμένον.", "seq": 2016}
{"id": "Simplicius_Passim_2017", "series": "CAG", "text": "αὐτὸς δὲ εἴδη τοῦ ποσοῦ κατὰ μὲν τὴν τοῦ διωρισμένου διαφορὰν τὸν ἀριθμὸν καὶ τὸν λόγον ἔθετο, κατὰ δὲ τὴν τοῦ συνεχοῦς γραμμὴν καὶ ἐπιφάνειαν καὶ σῶμα, ἔτι δὲ καὶ τόπον καὶ χρόνον, καὶ ἴσως ἀκριβέστερον τοῦτο.", "seq": 2017}
{"id": "Simplicius_Passim_2018", "series": "CAG", "text": "δοκεῖ γὰρ καὶ τῷ Ἰαμβλίχῳ μὴ παρισοῦσθαι τῷ διωρισμένῳ τὸ πλῆθος, διότι καὶ ὁ λόγος διωρισμένος μέν τίς ἐστιν, ὥσπερ καὶ ὁ ἀριθμός, πλῆθος δὲ οὐκ ἔστιν ὁ λόγος·", "seq": 2018}
{"id": "Simplicius_Passim_2019", "series": "CAG", "text": "κἂν γὰρ πολύς ἐστιν ὁ λόγος, ἀλλ᾿ ἄλλο τὸ πολὺ εἶναι τὸ μετέχον πλήθους, ὡς πολλοὶ οἱ ἄνθρωποι, καὶ ἄλλο τὸ πλῆθος εἶναι κατ᾿ αὐτὸ τοῦτο χαρακτηριζόμενον.", "seq": 2019}
{"id": "Simplicius_Passim_2020", "series": "CAG", "text": "μήποτε δὲ οὐδὲ τὸ μέγεθος ταὐτόν ἐστιν τῷ συνεχεῖ·", "seq": 2020}
{"id": "Simplicius_Passim_2021", "series": "CAG", "text": "καὶ γὰρ ὁ χρόνος συνεχὴς μέν ἐστιν ὡς δείκνυσιν, μέγεθος δὲ οὐκ ἔστιν.", "seq": 2021}
{"id": "Simplicius_Passim_2022", "series": "CAG", "text": "τρία γὰρ εἴδη τοῦ μεγέθους, γραμμὴ καὶ ἐπιφάνεια καὶ σῶμα, ὧν οὐδέν ἐστιν χρόνος·", "seq": 2022}
{"id": "Simplicius_Passim_2023", "series": "CAG", "text": "κἂν γὰρ μακρὸς λέγηται χρόνος (“ἅπανθ᾿ ὁ μακρὸς κἀναρίθμητος χρόνος”), ἀλλὰ καὶ πολὺς οὐδὲν ἧττον.", "seq": 2023}
{"id": "Simplicius_Passim_2024", "series": "CAG", "text": "καὶ ἐπιδιαίρεσιν δὲ τοῦ ποσοῦ ποιεῖται, τὸ μὲν ἐκ θέσιν ἐχόντων τῶν ἐν αὐτῷ μορίων λέγων εἶναι, τὸ δὲ οὐκ ἐξ ἐχόντων θέσιν.", "seq": 2024}
{"id": "Simplicius_Passim_2025", "series": "CAG", "text": "διαφέρει δὲ αὕτη τῆς προειρημένης.", "seq": 2025}
{"id": "Simplicius_Passim_2026", "series": "CAG", "text": "οὔτε γὰρ τὰ συνεχῆ τὰ αὐτά ἐστι τοῖς θέσιν ἔχουσιν, ἀλλὰ τὰ μὲν ἐκ θέσιν ἐχόντων πάντως καὶ συνεχῆ ἐστιν, τὰ δὲ συνεχῆ οὐ πάντως θέσιν ἔχει·", "seq": 2026}
{"id": "Simplicius_Passim_2027", "series": "CAG", "text": "ὁ γοῦν χρόνος συνεχὴς μέν ἐστιν, οὐ μέντοι τῶν θέσιν ἐχόντων.", "seq": 2027}
{"id": "Simplicius_Passim_2028", "series": "CAG", "text": "ἀνάπαλιν δὲ πᾶν μὲν διωρισμένον ἐξ οὐκ ἐχόντων θέσιν ἐστίν, οὐ μὴν πᾶν τὸ οὐκ ἐξ ἐχόντων θέσιν ἤδη καὶ διωρισμένον ἐστίν·", "seq": 2028}
{"id": "Simplicius_Passim_2029", "series": "CAG", "text": "πάλιν γὰρ ὁ χρόνος ἐξ οὐκ ἐχόντων θέσιν ὢν οὐκ ἔστιν διωρισμένος.", "seq": 2029}
{"id": "Simplicius_Passim_2030", "series": "CAG", "text": "καὶ οὐδὲν θαυμαστὸν τοῦ αὐτοῦ κατ᾿ ἄλλην καὶ ἄλλην ἐπιβολὴν πλείονας γενέσθαι διαιρέσεις ὡς τοῦ ζῴου κατά τε τὸ λογικὸν καὶ τὸ ἄλογον καὶ αὖ πάλιν κατά τε τὸ θνητὸν καὶ ἀθάνατον.", "seq": 2030}
{"id": "Simplicius_Passim_2031", "series": "CAG", "text": "κατὰ δὲ τὰς τοιαύτας διαφορὰς οὐδὲ τὰ τμήματα τοῖς τμήμασι πάντως ἐφαρμόζει·", "seq": 2031}
{"id": "Simplicius_Passim_2032", "series": "CAG", "text": "οὐ γὰρ μόνα τὰ λογικὰ ὑπόποδά ἐστιν, ἀλλὰ καὶ τῶν ἀλόγων πολλά.", "seq": 2032}
{"id": "Simplicius_Passim_2033", "series": "CAG", "text": "Λοιπὸν δὲ εἰπεῖν, τίνα μέν ἐστιν τὰ συνεχῆ, τίνα δὲ τὰ διωρισμένα.", "seq": 2033}
{"id": "Simplicius_Passim_2034", "series": "CAG", "text": "ἐν δὲ τῇ Φυσικῇ ἀκροάσει, συνεχῆ ἐστιν, φησίν, ὧν τὰ πέρατα ἕν, ὥσπερ ἁπτόμενα, ὧν τὰ πέρατα ἅμα·", "seq": 2034}
{"id": "Simplicius_Passim_2035", "series": "CAG", "text": "ἐνταῦθα δὲ συνεχῆ φησιν εἶναι τὰ πρὸς ἕνα κοινὸν ὅρον συνάπτοντα, διωρισμένα δὲ τὰ μὴ ἔχοντα κοινὸν ὅρον, πρὸς ὃν συνάπτει τὰ μόρια αὐτῶν.", "seq": 2035}
{"id": "Simplicius_Passim_2036", "series": "CAG", "text": "καὶ τῷ μὲν διωρισμένῳ ὑποτίθησιν τὸν ἀριθμὸν καὶ τὸν λόγον·", "seq": 2036}
{"id": "Simplicius_Passim_2037", "series": "CAG", "text": "τῶν γὰρ πέντε οὐκ ἔστιν μονὰς μέσος ὅρος συνάπτων τὰ τρία καὶ τὰ δύο·", "seq": 2037}
{"id": "Simplicius_Passim_2038", "series": "CAG", "text": "εἰ δέ τις λέγοι μονάδα εἶναι καθ᾿ ἕτερον τῶν μερῶν τὴν συνάπτουσαν, ἐπειδὴ ἡ μονὰς οὐκ ἔστιν πέρας τοῦ ἀριθμοῦ, ὡς τὸ σημεῖον τῆς γραμμῆς, ἀλλὰ μέρος, ἄλλη ἂν εἴη μονὰς παρὰ τὰς πέντε, καὶ οὔτε πέντε ἔτι, ἀλλὰ ἓξ ἔσται, οὔτε κοινὸν πέρας ἡ μονὰς ἐκείνη, πρὸς ἣν συνάψει τὰ μόρια.", "seq": 2038}
{"id": "Simplicius_Passim_2039", "series": "CAG", "text": "καὶ γὰρ ὁ μὲν ἀριθμὸς ἐκ μονάδων σύγκειται καὶ εἰς μονάδας διαιρεῖται, διὸ οὐδὲ ἐπ᾿ ἄπειρον ἡ διαίρεσις αὐτοῦ, ἀλλὰ μέχρι τῶν μονάδων·", "seq": 2039}
{"id": "Simplicius_Passim_2040", "series": "CAG", "text": "ἡ δὲ γραμμὴ οὐδὲ σύγκειται ἐκ σημείων οὔτε διαιρεῖται εἰς σημεῖα, διὸ καὶ ἐπ᾿ ἄπειρόν ἐστιν διαιρετή.", "seq": 2040}
{"id": "Simplicius_Passim_2041", "series": "CAG", "text": "ἐπειδὴ δὲ καὶ τὸν λόγον τοῦ διωρισμένου ποσοῦ φησιν εἶναι, λόγον ἀκουστέον οὐ τὸν ἐν διανοίᾳ, ἀλλὰ τὸν ἐν τῇ φωνῇ·", "seq": 2041}
{"id": "Simplicius_Passim_2042", "series": "CAG", "text": "οὗτος γάρ ἐστι ποσόν.", "seq": 2042}
{"id": "Simplicius_Passim_2043", "series": "CAG", "text": "πᾶς γὰρ λόγος ἐξ ὀνομάτων καὶ ῥημάτων συνέστηκεν, πᾶν δὲ στοιχεῖον λόγου ἐκ συλλαβῶν, πᾶσα δὲ συλλαβὴ χρόνοις καταμετρεῖται, χρόνῳ ἢ μακρῷ ἢ βραχεῖ, αἱ δὲ μακραὶ πρὸς τὰς βραχείας ἔχουσι λόγον ὃν δύο πρὸς ἕν, τὸ δὲ ἓν καὶ δύο ἀριθμός, ὁ δὲ ἀριθμὸς ποσὸν διωρισμένον, ὥστε καὶ ὁ λόγος διωρισμένος.", "seq": 2043}
{"id": "Simplicius_Passim_2044", "series": "CAG", "text": "καὶ γὰρ ἐν τούτῳ οὐδὲν ἔστι κοινὸν λαβεῖν, ὃ συνάπτει αὐτοῦ τὰ μέρη, οἷον ἐν τῷ Σωκράτης οὐδὲν ἔστι κοινὸν τῶν συλλαβῶν λαβεῖν, ὃ συνάπτει αὐτὰς πρὸς ἀλλήλας.", "seq": 2044}
{"id": "Simplicius_Passim_2045", "series": "CAG", "text": "οὐδὲ γὰρ τὸ σημαινόμενον ἔστιν εἰπεῖν ὅτι συνάπτει αὐτάς·", "seq": 2045}
{"id": "Simplicius_Passim_2046", "series": "CAG", "text": "καὶ γὰρ αἱ ἄσημοι φωναί, οἷον τὸ βλίτυρι, ὡσαύτως καταμετροῦνται καὶ οὐ συνάπτονται.", "seq": 2046}
{"id": "Simplicius_Passim_2047", "series": "CAG", "text": "οὕτως μὲν οὖν ὁ ἐν τῇ φωνῇ λόγος διωρισμένος ἐστίν·", "seq": 2047}
{"id": "Simplicius_Passim_2048", "series": "CAG", "text": "ὁ δὲ ἐν τῇ διανοίᾳ οὐδὲ ποσὸν ὅλως, ἀλλ᾿ ἢ ἐνέργεια ἢ πάθος ἢ τὸ συναμφότερον, ὡς ὁ Ἰάμβλιχός φησιν·", "seq": 2048}
{"id": "Simplicius_Passim_2049", "series": "CAG", "text": "ὁ μέντοι Πορφύριος ποιὸν αὐτὸν εἶναι λέγει.", "seq": 2049}
{"id": "Simplicius_Passim_2050", "series": "CAG", "text": "τοῦ μὲν οὖν διωρισμένου ποσοῦ εἴδη ὅ τε ἀριθμός ἐστιν καὶ ὁ λόγος, τοῦ δὲ συνεχοῦς γραμμὴ πρώτη·", "seq": 2050}
{"id": "Simplicius_Passim_2051", "series": "CAG", "text": "τὸ γὰρ σημεῖον, καθ᾿ ὃ διαιρεῖται ἡ γραμμή, κοινὸν ὅρον ἔχει, καὶ κατ᾿ ἐκεῖνο συνάπτεται ἀλλήλοις τὰ μόρια τῆς γραμμῆς·", "seq": 2051}
{"id": "Simplicius_Passim_2052", "series": "CAG", "text": "μετὰ δὲ τὴν γραμμὴν ἡ ἐπιφάνεια, καὶ αὐτὴ κοινὸν ὅρον ἔχουσα τὴν γραμμήν, καθ᾿ ἣν διαιρεῖται, καὶ μετὰ τὴν ἐπιφάνειαν τὸ σῶμα τῇ ἐπιφανείᾳ διαιρούμενον.", "seq": 2052}
{"id": "Simplicius_Passim_2053", "series": "CAG", "text": "Ἐπιστῆσαι δὲ ἄξιον, πῶς τὰ τοῦ σώματος μόρια κοινὸν ὅρον ἔχειν γραμμήν φησιν ἢ ἐπιφάνειαν·", "seq": 2053}
{"id": "Simplicius_Passim_2054", "series": "CAG", "text": "ἔστιν δὲ ὅπου καὶ ἐπιφάνειαν γέγραπται.", "seq": 2054}
{"id": "Simplicius_Passim_2055", "series": "CAG", "text": "καὶ γὰρ ὁ κοινὸς ὅρος τῶν σωμάτων ἐπιφάνεια πάντως ἐστίν, ὡς τῶν ἐπιφανειῶν γραμμὴ καὶ τῶν γραμμῶν σημεῖον.", "seq": 2055}
{"id": "Simplicius_Passim_2056", "series": "CAG", "text": "ὁ μὲν οὖν Πορφύριος ἐπιστήσας “ἔστιν, φησίν, τινὰ τῶν στερεῶν σωμάτων, ἃ κατὰ γραμμὴν τὴν συνέχειαν ἔχει·", "seq": 2056}
{"id": "Simplicius_Passim_2057", "series": "CAG", "text": "καὶ γὰρ σῶμα ἀξιοῖ ἀκούειν ὁ Ἑρμῖνος οὐ τὸ φυσικόν (οὐσία γάρ), ἀλλὰ τὸ μαθηματικόν, ὃ κατὰ ψιλὰς τὰς πάντῃ διαστάσεις λαμβάνεται”.", "seq": 2057}
{"id": "Simplicius_Passim_2058", "series": "CAG", "text": "καίτοι καὶ τὰ μαθηματικὰ σώματα οὐ γραμμῇ, ἀλλ᾿ ἐπιπέδῳ μαθηματικῷ διαιρεῖται.", "seq": 2058}
{"id": "Simplicius_Passim_2059", "series": "CAG", "text": "μήποτε οὖν διὰ τὴν στερεὰν εἶπεν γωνίαν, τὰ γὰρ στερεὰ παραλληλεπίπεδα κατὰ γραμμὴν γωνιακὴν συνάπτεται ἀλλήλοις.", "seq": 2059}
{"id": "Simplicius_Passim_2060", "series": "CAG", "text": "Ἀλλὰ πῶς ἡ διαιρεθεῖσα γραμμὴ ἔτι κοινὸν ὅρον ἔχει τὸ σημεῖον, ἡ δὲ διαιρεθεῖσα ἐπιφάνεια κοινὸν ὅρον ἔχει τὴν γραμμὴν ἢ τὸ σῶμα τὴν ἐπιφάνειαν;", "seq": 2060}
{"id": "Simplicius_Passim_2061", "series": "CAG", "text": "τὰ γὰρ διαιρεθέντα οἰκείοις πέρασιν περιγραφόμενα καὶ οἰκείους ἔχοντα ὅρους οὐκέτι κοινὸν ὅρον ἔχει, πρὸς ὃν συνάπτει τὰ μόρια αὐτῶν.", "seq": 2061}
{"id": "Simplicius_Passim_2062", "series": "CAG", "text": "ἢ δυνάμει δεῖ θεωρεῖν τὴν διαίρεσιν, ἀλλ᾿ οὐκ ἐνεργείᾳ, καὶ δυνάμει ἐν μὲν τῇ γραμμῇ τὸ κοινὸν σημεῖον, ἐν δὲ τῇ ἐπιφανείᾳ τὴν γραμμήν, ἐν δὲ τῷ σώματι τὴν ἐπιφάνειαν, εἰ μέλλοι ἓν εἶναι τὸ ἀμφοῖν πέρας, ὅπερ δεῖ προσεῖναι τῷ συνεχεῖ·", "seq": 2062}
{"id": "Simplicius_Passim_2063", "series": "CAG", "text": "ἐνεργείᾳ γὰρ ληφθέντα ταῦτα καὶ δύο γενόμενα, εἰ μὲν παρακείμενα εἴη, ἅμα ποιεῖ τὰ πέρατα καὶ ἁπτόμενα τὰ πεπερατωμένα, εἰ δὲ μή, οὐδὲ ἁπτόμενα δύναται εἶναι.", "seq": 2063}
{"id": "Simplicius_Passim_2064", "series": "CAG", "text": "Τὸ δὲ σῶμα, καθόσον μὲν τριχῇ διαστατὸν καὶ μετρεῖσθαι πέφυκεν, ποσὸν ὑπάρχει·", "seq": 2064}
{"id": "Simplicius_Passim_2065", "series": "CAG", "text": "καθόσον μέντοι ὑποκείμενόν ἐστιν καὶ ταὐτὸν καὶ ἓν ἀριθμῷ μένον τῶν ἐναντίων ἐστὶ δεκτικόν, κατὰ τοῦτο οὐσία ἐστίν·", "seq": 2065}
{"id": "Simplicius_Passim_2066", "series": "CAG", "text": "ὥστε οὐ καλῶς οἱ περὶ τὸν Λούκιον ἐγκαλοῦσιν ὡς τὸ σῶμα τῆς οὐσίας ὂν εἰς τὸ ποσὸν μετενεγκόντι.", "seq": 2066}
{"id": "Simplicius_Passim_2067", "series": "CAG", "text": "Ἐπιστῆσαι δὲ ἄξιον, ὅπως εἶπεν·", "seq": 2067}
{"id": "Simplicius_Passim_2068", "series": "CAG", "text": "ἔτι δὲ παρὰ ταῦτα χρόνος καὶ τόπος ἐστὶν ποσά, διότι οὐχ ἥνωται τῷ σώματι οὐδὲ ὁ χρόνος οὐδὲ ὁ τόπος, ἀλλ᾿ ἔξωθεν ταῦτα ἐπακολουθεῖ.", "seq": 2068}
{"id": "Simplicius_Passim_2069", "series": "CAG", "text": "καὶ ὁ μὲν τόπος περὶ τὸ σῶμα ὢν καὶ τὴν τοῦ σώματος διάστασιν συνδιέστηκεν τοῖς σώμασιν, καὶ καθόσον μὲν διάστημα καὶ αὐτὸς καὶ ἐπιφάνεια, ποσὸν ἂν εἴη, καθόσον δὲ περιέχον καὶ πέρας, πρός τι.", "seq": 2069}
{"id": "Simplicius_Passim_2070", "series": "CAG", "text": "συνεχὴς δέ ἐστιν ὁ τόπος, διότι καὶ τὰ τούτου μόρια πρὸς κοινὸν ὅρον συνάπτει·", "seq": 2070}
{"id": "Simplicius_Passim_2071", "series": "CAG", "text": "τὰ γὰρ τοῦ σώματος μόρια πρός τινα κοινὸν ὅρον συνάπτοντα τόπους τινὰς κατέχει μόρια ὄντα τοῦ τόπου, οἵτινες καὶ αὐτοὶ πρὸς κοινὸν ὅρον συνάπτουσιν, πρὸς ὃν καὶ τὰ τοῦ σώματος μόρια.", "seq": 2071}
{"id": "Simplicius_Passim_2072", "series": "CAG", "text": "εἰ δὲ ἐπιφάνεια ἐστὶν ὁ τόπος τοῦ περιέχοντος καθὸ περιέχει, ἡ δὲ ἐπιφάνεια συνεχής, πρόδηλον ὅτι καὶ ὁ τόπος.", "seq": 2072}
{"id": "Simplicius_Passim_2073", "series": "CAG", "text": "ἀλλ᾿ οὐκ ἐχρήσατο ταύτῃ τῇ ἀποδείξει, διότι οὔπω ἔγνωστο, τί ἐστιν τόπος·", "seq": 2073}
{"id": "Simplicius_Passim_2074", "series": "CAG", "text": "φυσικῆς γὰρ ἦν θεωρίας ἡ σκέψις.", "seq": 2074}
{"id": "Simplicius_Passim_2075", "series": "CAG", "text": "ἐπιστῆσαι δὲ ἄξιον, ὅτι ἐνταῦθα τὰ τοῦ σώματος μόρια τὰ συνεχῆ οὐ καθ᾿ ἑαυτὰ ἐν τόπῳ εἶναί φησι·", "seq": 2075}
{"id": "Simplicius_Passim_2076", "series": "CAG", "text": "καὶ γὰρ κατέχει μὲν καὶ αὐτὰ τόπον, οὐ μὴν καθ᾿ αὑτά, ἐπειδὴ οὐδέ ἐστιν ἐν τόπῳ καθ᾿ ἑαυτὰ οὐδὲ περιέχεται καθ᾿ ἑαυτά.", "seq": 2076}
{"id": "Simplicius_Passim_2077", "series": "CAG", "text": "ὁ δὲ χρόνος ποσὸν μέν ἐστιν καὶ αὐτός, ὅτι ἐν διαστήματι θεωρεῖται, καὶ ἔστιν ἀριθμὸς κινήσεως·", "seq": 2077}
{"id": "Simplicius_Passim_2078", "series": "CAG", "text": "συνεχὲς δέ ἐστιν, διότι τὸ παρεληλυθὸς αὐτοῦ καὶ τὸ μέλλον πρὸς κοινὸν ὅρον τὸ νῦν συνάπτει καὶ συνδεῖται κατὰ τοῦτο.", "seq": 2078}
{"id": "Simplicius_Passim_2079", "series": "CAG", "text": "ἔοικεν δὲ ὁ χρόνος εἶναι κυριώτατα συνεχής·", "seq": 2079}
{"id": "Simplicius_Passim_2080", "series": "CAG", "text": "τῶν μὲν γὰρ ἄλλων συνεχῶν ἕκαστον καὶ διαιρεθείη ἄν, ὁ δὲ χρόνος ἀεὶ συνεχὴς καὶ οὐδέποτε ἐξ ἁπτομένων.", "seq": 2080}
{"id": "Simplicius_Passim_2081", "series": "CAG", "text": "κατά τε οὖν τοῦτο διαφέρει τῶν ἄλλων συνεχῶν καὶ ὅτι ἐκεῖνα μὲν ἐκ θέσιν ἐχόντων, οὗτος δὲ οὐκ ἐξ ἐχόντων θέσιν.", "seq": 2081}
{"id": "Simplicius_Passim_2082", "series": "CAG", "text": "ταῦτα μὲν οὖν εἰς σαφήνειαν τῶν τῷ Ἀριστοτέλει δεδογμένων εἰρήσθω.", "seq": 2082}
{"id": "Simplicius_Passim_2083", "series": "CAG", "text": "Ἀποροῦσι δέ τινες, πῶς τὸ ποσὸν γένος λέγεται τοῦ διωρισμένου καὶ συνεχοῦς, εἴπερ πρότερόν ἐστιν φύσει τὸ διωρισμένον τοῦ συνεχοῦς.", "seq": 2083}
{"id": "Simplicius_Passim_2084", "series": "CAG", "text": "ἐν οἷς γὰρ τὸ μὲν μᾶλλον, τὸ δὲ ἧττον καὶ τὸ μὲν πρότερον, τὸ δὲ ὕστερον, ἐν τούτοις οὐ δύναται εἶναι κοινὸν γένος, διότι τῶν μὲν εἰδῶν ἕκαστον ἀναιρεθὲν οὐ συναναιρεῖ τὸ γένος, τὰ δὲ ἀντικείμενα ἅμα εἴδη ἀναιρεθέντα ἀναιρεῖ τὸ γένος·", "seq": 2084}
{"id": "Simplicius_Passim_2085", "series": "CAG", "text": "ἐφ᾿ ὧν οὖν τὸ μᾶλλον καὶ τὸ ἧττον καὶ τὸ πρότερον καὶ ὕστερον, ἀναιρεθέντος τοῦ μᾶλλον καὶ τοῦ προτέρου συναναιρεῖται καὶ τὸ ἧττον καὶ ὕστερον, ὥστε καὶ τὸ γένος.", "seq": 2085}
{"id": "Simplicius_Passim_2086", "series": "CAG", "text": "διὰ τοῦτο μὲν οὖν, ἐν οἷς τὸ πρότερον καὶ τὸ ὕστερον ἔστιν, οὐ δύναταί τι ὡς γένος κατηγορεῖσθαι.", "seq": 2086}
{"id": "Simplicius_Passim_2087", "series": "CAG", "text": "ὅτι δὲ πρότερον φύσει τὸ διωρισμένον τοῦ συνεχοῦς, δεικνύουσιν ἐκ τοῦ συναναιρεῖν μέν, μὴ συναναιρεῖσθαι δέ·", "seq": 2087}
{"id": "Simplicius_Passim_2088", "series": "CAG", "text": "τριῶν μὲν γὰρ ἀναιρεθέντων ἀναιρεῖται τὸ τρίγωνον, τριγώνου δὲ ἀναιρεθέντος οὐκ ἀναιρεῖται τὰ τρία.", "seq": 2088}
{"id": "Simplicius_Passim_2089", "series": "CAG", "text": "καὶ τὸ μὲν διωρισμένον συνεπιφέρεται·", "seq": 2089}
{"id": "Simplicius_Passim_2090", "series": "CAG", "text": "τῷ γὰρ τριγώνῳ συνεισφέρεται τὰ τρία·", "seq": 2090}
{"id": "Simplicius_Passim_2091", "series": "CAG", "text": "τὸ δὲ συνεχὲς συνεπιφέρει·", "seq": 2091}
{"id": "Simplicius_Passim_2092", "series": "CAG", "text": "τὸ γὰρ τρίγωνον εἰσάγει τὸν τρία.", "seq": 2092}
{"id": "Simplicius_Passim_2093", "series": "CAG", "text": "ἔτι δὲ τὸ μὲν ἁπλοῦν ἐστιν, φασίν, καὶ καθ᾿ ἑαυτὸ ὑφεστηκός τε καὶ νοούμενον, τὸ δὲ καὶ θέσιν προσείληφεν.", "seq": 2093}
{"id": "Simplicius_Passim_2094", "series": "CAG", "text": "ἔτι δὲ καὶ ἐκ τῶν ἐπιστημῶν, διότι, φασί, πρεσβυτέρα ἐστὶν ἀριθμητικὴ γεωμετρίας·", "seq": 2094}
{"id": "Simplicius_Passim_2095", "series": "CAG", "text": "δῆλον δὲ ὅτι οὐκ ἂν εἴη τοῦτο ἀληθές, εἰ μὴ καὶ ὁ ἀριθμὸς τοῦ μεγέθους εἴη πρεσβύτερος.", "seq": 2095}
{"id": "Simplicius_Passim_2096", "series": "CAG", "text": "τινὲς δὲ τὸ αὐτὸ κατασκευάζουσιν ἐκ τοῦ τὸ συνεχὲς διαιρετὸν εἶναι εἰς ἀεὶ διαιρετά·", "seq": 2096}
{"id": "Simplicius_Passim_2097", "series": "CAG", "text": "μὴ ὄντος οὖν τοῦ διωρισμένου οὐδ᾿ ἂν αὐτὸ εἴη.", "seq": 2097}
{"id": "Simplicius_Passim_2098", "series": "CAG", "text": "ἔστιν δὲ οἶμαι καὶ τοῦτο λέγειν, ὅτι ποσὸν τὸ μετρούμενον εἶναί φαμεν, πᾶν δὲ μέτρον κατὰ ἀριθμὸν γίνεται, ὁ δὲ ἀριθμὸς διωρισμένον ποσόν·", "seq": 2098}
{"id": "Simplicius_Passim_2099", "series": "CAG", "text": "προηγεῖται ἄρα τοῦτο τοῦ συνεχοῦς.", "seq": 2099}
{"id": "Simplicius_Passim_2100", "series": "CAG", "text": "πρὸς δὴ ταῦτα τὸ μὲν φιλονεικεῖν ὡς οὐκ ἔστιν φύσει πρότερον τὸ διωρισμένον, διότι ἀπὸ τῆς τοῦ συνεχοῦς διαιρέσεως τὸ εἶναι ἔχει τὸ διωρισμένον, καὶ ἔστιν τινὰ συνεχῆ ἀδιαίρετα, ὡς αἱ ἄτομοι, βίαιον δοκεῖ.", "seq": 2100}
{"id": "Simplicius_Passim_2101", "series": "CAG", "text": "ῥητέον δὲ μᾶλλον, ὅτι καθόσον μὲν τὸ πρότερον ἔχουσιν καὶ ὕστερον, οὐκ ἔστιν ὑπὸ τὸ αὐτὸ γένος, καθ᾿ ὅσον δὲ δι᾿ ἑαυτῶν προσεχῶς ἐπικοινωνεῖ τῷ ποσῷ καὶ οὐδέν ἐστι τὸ κωλῦον ἐπίσης μετέχειν καὶ τὸ συνεχὲς τοῦ ποσοῦ ὥσπερ καὶ τὸ διωρισμένον, κατὰ τοῦτο δὲ γένος ἂν εἴη τὸ ποσὸν ἀμφοῖν·", "seq": 2101}
{"id": "Simplicius_Passim_2102", "series": "CAG", "text": "ἀρκεῖ γὰρ πρὸς τοῦτο ἡ ἄμεσος μέθεξις·", "seq": 2102}
{"id": "Simplicius_Passim_2103", "series": "CAG", "text": "κἂν γὰρ πρὸ τοῦ τριγώνου τὰ τρία ποσόν, ἀλλὰ καὶ τὸ συνεχὲς πρὸ τοῦ τριγώνου ποσόν.", "seq": 2103}
{"id": "Simplicius_Passim_2104", "series": "CAG", "text": "οὕτως δὲ καὶ ἐπὶ τῆς καταφάσεως καὶ ἀποφάσεως ὁρῶμεν·", "seq": 2104}
{"id": "Simplicius_Passim_2105", "series": "CAG", "text": "καὶ γὰρ προτέρα τῇ φύσει τῆς ἀποφάσεως ἡ κατάφασις, καὶ ὅμως κατὰ τὸ ἀποφαίνεσθαι καὶ κατὰ τὸ ἀληθεύειν ἢ ψεύδεσθαι ἐπίσης ἔχοντα ὁρῶντες ὑπὸ τὸ αὐτὸ γένος εἶναί φαμεν.", "seq": 2105}
{"id": "Simplicius_Passim_2106", "series": "CAG", "text": "ταῦτα δὲ καὶ Ἀριστοτέλης ἐπὶ τοῦ διωρισμένου καὶ συνεχοῦς ἐννοῶν προτάττει μὲν πανταχοῦ τὸ διωρισμένον·", "seq": 2106}
{"id": "Simplicius_Passim_2107", "series": "CAG", "text": "καὶ γὰρ ἐν τῇ πρώτῃ διαιρέσει τοῦ ποσοῦ, φησίν, τὸ μέν ἐστι διωρισμένον, τὸ δὲ συνεχές, καὶ ἐν τῇ διαριθμήσει τῶν καθ᾿ ἕκαστα πρῶτα τὰ ὑπὸ τὸ διωρισμένον παραδίδωσι λέγων·", "seq": 2107}
{"id": "Simplicius_Passim_2108", "series": "CAG", "text": "ἔστι δὲ διωρισμένα μὲν ὅ τε ἀριθμὸς καὶ ὁ λόγος·", "seq": 2108}
{"id": "Simplicius_Passim_2109", "series": "CAG", "text": "κατὰ δὲ τὴν ἐπίσης τοῦ ποσοῦ μέθεξιν ὡς ὑπὸ γένος αὐτὰ τὸ ποσὸν ἀντιδιαιρεῖ.", "seq": 2109}
{"id": "Simplicius_Passim_2110", "series": "CAG", "text": "Ἔτι δὲ ὁ Πλωτῖνος ζητεῖ ἐν τῷ πρώτῳ περὶ τοῦ ὄντος·", "seq": 2110}
{"id": "Simplicius_Passim_2111", "series": "CAG", "text": "‘εἰ τὸ συνεχὲς ποσόν ἐστιν, οὐκ ἔστιν τὸ διωρισμένον ποσόν·", "seq": 2111}
{"id": "Simplicius_Passim_2112", "series": "CAG", "text": "εἰ δὲ ἄμφω ποσά, δεικτέον τί τὸ ἐν ἀμφοτέροις κοινόν’.", "seq": 2112}
{"id": "Simplicius_Passim_2113", "series": "CAG", "text": "καὶ λύει τὴν ζήτησιν ἐν τῷ τρίτῳ λέγων ὅτι κοινὸν αὐτοῖς ἐστιν τὸ τοσόνδε, δηλονότι τὸ ὡς μέτρον καὶ ὡς πέρας θεωρούμενον, καθ᾿ ὃ ποσὸν ἕκαστον γινώσκεται.", "seq": 2113}
{"id": "Simplicius_Passim_2114", "series": "CAG", "text": "τοῦτο γὰρ οὐκ ἀπὸ τοῦ ἀριθμοῦ τῷ μεγέθει ἐνεδόθη, ὥς τισιν δοκεῖ, ἀλλ᾿ ἔστιν ἴδιον μέτρον καὶ τοῦ ἡνωμένου τε καὶ ἀλληλουχουμένου καὶ ἔτι μέντοι τοῦ διωρισμένου.", "seq": 2114}
{"id": "Simplicius_Passim_2115", "series": "CAG", "text": "ἰδία γὰρ καὶ φύσις ἑκάστου, ὡς καὶ ἐν τῷ παντὶ κόσμῳ θεωρεῖται τοῦ μὲν συνεχοῦς ἡ φύσις, ἥτις καλεῖται μέγεθος, κατὰ ἕνωσιν καὶ ἀλληλουχίαν, τοῦ δὲ διωρισμένου, ἥτις καλεῖται πλῆθος, κατὰ σωρείαν καὶ παράθεσιν·", "seq": 2115}
{"id": "Simplicius_Passim_2116", "series": "CAG", "text": "καὶ γὰρ κατὰ μὲν τὴν τοῦ μεγέθους οὐσίαν εἷς ὁ κόσμος ἔστιν τε καὶ νοεῖται σφαιρικὸς καὶ συμπεφυκὼς ἑαυτῷ, διατεταμένος τε καὶ ἀλληλουχούμενος, κατὰ δὲ τὸ πλῆθος ἥ τε σύνταξις καὶ ἡ διακόσμησις ἡ ἐκ τοσῶνδε φέρε εἰπεῖν στοιχείων καὶ ζῴων ἢ φυτῶν θεωρεῖται καὶ ἐναντιοτήτων ἢ ὁμοιοτήτων τόσων καὶ τόσων.", "seq": 2116}
{"id": "Simplicius_Passim_2117", "series": "CAG", "text": "εἰ οὖν ἐν ταῖς εἰκόσιν οὕτω ταῦτα κεχώρισται, πολὺ πρότερον ἐν τοῖς νοουμένοις γένεσιν καὶ πρὸ τούτων ἐν τοῖς καθ᾿ αὑτὰ ἀύλοις εἴδεσιν διέστηκεν, κοινὸν ἔχοντα, ὡς εἴρηται, τὸ μέτρον καὶ πέρας.", "seq": 2117}
{"id": "Simplicius_Passim_2118", "series": "CAG", "text": "Ἐγκαλοῦσιν δὲ οἱ περὶ τὸν Λούκιον καὶ Νικόστρατον τῇ διαιρέσει πρῶτον μὲν ὡς μὴ δεόντως καὶ τὸ μέγεθος ποσὸν λεγούσῃ·", "seq": 2118}
{"id": "Simplicius_Passim_2119", "series": "CAG", "text": "πηλίκον γὰρ ἔδει τοῦτο λέγειν, ποσὸν δὲ τὸν ἀριθμόν, τὸ δὲ κοινὸν ἢ ἄλλο τι ἢ ὁμωνύμως τῷ ἑνὶ τῶν εἰδῶν ποσὸν καὶ αὐτὸ ὀνομάζειν.", "seq": 2119}
{"id": "Simplicius_Passim_2120", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ κἂν κατὰ τὸ πλεῖστον τὸ μὲν συνεχὲς πηλίκον, τὸ δὲ διωρισμένον ποσόν, ἀλλὰ καὶ ὑπαλλάττει πολλάκις (τὸ γοῦν ὕδωρ συνεχὲς ὂν ποσὸν λέγομεν, ἀλλ᾿ οὐ πηλίκον·", "seq": 2120}
{"id": "Simplicius_Passim_2121", "series": "CAG", "text": "πολὺ γὰρ καὶ οὐχὶ μέγα·", "seq": 2121}
{"id": "Simplicius_Passim_2122", "series": "CAG", "text": "καὶ τὸν χρόνον ποσὸν λέγομεν), εἰκότως οὔτε δύο πεποίηκεν κατηγορίας τὸ ποσὸν καὶ πηλίκον οὔτε κατὰ τὸ πηλίκον καὶ ποσὸν διεῖλεν, ἀλλὰ κατὰ τὸ συνεχὲς καὶ διωρισμένον, ἅπερ οὐδέποτε ὑπαλλάττει.", "seq": 2122}
{"id": "Simplicius_Passim_2123", "series": "CAG", "text": "Αἰτιῶνται δὲ καὶ τὸ εἰς δύο γενέσθαι τὴν διαίρεσιν·", "seq": 2123}
{"id": "Simplicius_Passim_2124", "series": "CAG", "text": "ἔδει γὰρ μετὰ τὸν ἀριθμὸν καὶ τὸ μέγεθος τρίτον εἶδος τάττειν τὸ βάρος ἢ τὴν ῥοπήν, ὡς Ἀρχύτας καὶ ὡς ὕστερον Ἀθηνόδωρος ἔταξεν καὶ Πτολεμαῖος ὁ μαθηματικός.", "seq": 2124}
{"id": "Simplicius_Passim_2125", "series": "CAG", "text": "ἀλλὰ ῥητέον ὅτι ἡ βαρύτης ποιότητός ἐστιν, ὡς ἡ πυκνότης καὶ παχύτης οὐχὶ κατὰ τὸ ποσόν, ἀλλὰ κατὰ τὸ ποιόν, καὶ τὰ τούτοις ἀντικείμενα.", "seq": 2125}
{"id": "Simplicius_Passim_2126", "series": "CAG", "text": "ἀλλ᾿ ἡ μνᾶ καὶ τὸ τάλαντον τὰ ἐπὶ βάρους λεγόμενα ποῦ ἂν περιληφθείη;", "seq": 2126}
{"id": "Simplicius_Passim_2127", "series": "CAG", "text": "ἢ εἰς μὲν τὰ προηγούμενα ποσὰ φήσομεν οὐδαμῶς, εἰς δὲ τὰ κατὰ συμβεβηκός·", "seq": 2127}
{"id": "Simplicius_Passim_2128", "series": "CAG", "text": "οὔτε γὰρ κατ᾿ ἀριθμὸν ἁπλῶς οὔτε κατὰ μέγεθος.", "seq": 2128}
{"id": "Simplicius_Passim_2129", "series": "CAG", "text": "ἀλλ᾿ ἐπιστῆσαι χρή, μήποτε οὐχ ὡς τὸ λευκὸν κατὰ συμβεβηκὸς ποσόν, ὅτι ἡ ἐπιφάνεια ποσόν, οὕτως καὶ ἡ ῥοπή, ἀλλ᾿ αὐτὴ καθ᾿ αὑτήν ἐστι ποσόν, διότι καθ᾿ αὑτὴν ἐπιδέχεται τὸ τοῦ ποσοῦ ἴδιον, τὸ ἴσον καὶ ἄνισον, ὥσπερ καὶ τὴν ὑπερβολὴν καὶ ἔλλειψιν.", "seq": 2129}
{"id": "Simplicius_Passim_2130", "series": "CAG", "text": "δεῖ γὰρ οἶμαι καὶ τῷ Ἀρχύτᾳ προσέχειν τὸν νοῦν τριχῇ καὶ αὐτῷ διελόντι τὸ ποσόν·", "seq": 2130}
{"id": "Simplicius_Passim_2131", "series": "CAG", "text": "γράφει γὰρ οὕτως·", "seq": 2131}
{"id": "Simplicius_Passim_2132", "series": "CAG", "text": "“τᾶς ποσότητος διαφοραὶ τρεῖς·", "seq": 2132}
{"id": "Simplicius_Passim_2133", "series": "CAG", "text": "τὸ μὲν γὰρ αὐτᾶς ἐστιν ἐν ῥοπᾷ ὡς τὸ τάλαντον, τὸ δὲ ἐν μεγέθει ὡς τὸ δίπαχυ, τὸ δὲ ἐν πλάθει ὡς τὸ δέκα”.", "seq": 2133}
{"id": "Simplicius_Passim_2134", "series": "CAG", "text": "καὶ ταύτην μὲν ὁ Ἰάμβλιχος ἀποδέχεται τὴν διαίρεσιν, καὶ ὡς κατὰ τὸ τελειότατον μέτρον τοῦ ποσοῦ τὴν τριάδα γενομένην καὶ ὡς τοῖς πράγμασι σύμφωνον·", "seq": 2134}
{"id": "Simplicius_Passim_2135", "series": "CAG", "text": "“ἡ γὰρ κατὰ ῥοπὴν ποσότης οὔτε τῷ μεγέθει οὔτε τῷ πλήθει ἐστὶν ἡ αὐτή, ἀλλ᾿ ἐν κινήσει μᾶλλον θεωρεῖται καὶ κατὰ βάρος ἢ κουφότητα ἔχει τὸ ποσόν.", "seq": 2135}
{"id": "Simplicius_Passim_2136", "series": "CAG", "text": "παραλέλειπται οὖν, φησίν, αὕτη ἡ διαίρεσις οὕτως ἔχουσα·", "seq": 2136}
{"id": "Simplicius_Passim_2137", "series": "CAG", "text": "‘τῶν ποσῶν τὰ μὲν ἔχει ῥοπήν, τὰ δὲ οὐκ ἔχει’, καὶ δῆλον ὅτι οὔτε τοῖς συνεχέσι καὶ διωρισμένοις ἡ αὐτή ἐστιν οὔτε τοῖς θέσιν ἔχουσιν καὶ μή.", "seq": 2137}
{"id": "Simplicius_Passim_2138", "series": "CAG", "text": "καὶ ἐν τῷ παντὶ δέ, φησίν, ἐναργὴς ἡ διαίρεσις αὕτη φαίνεται τῶν μὲν τεσσάρων στοιχείων ῥοπὴν ἐχόντων, τοῦ δὲ οὐρανοῦ ἀρρεποῦς ὄντος.", "seq": 2138}
{"id": "Simplicius_Passim_2139", "series": "CAG", "text": "καὶ ἐν ταῖς κινήσεσιν αἱ μὲν ἐπ᾿ εὐθείας κινήσεις μετὰ ῥοπῆς γίνονται ἀρχὴν ἔχουσαι καὶ τελευτὴν καὶ στάσει μεταξὺ διαλαμβανόμεναι, ἡ δὲ κατὰ κύκλον συνεχὴς καὶ ἄναρχος οὖσα καὶ ἀτελεύτητος, ὡς ἂν ἀεικίνητος οὖσα, ἀρρεπής ἐστιν.", "seq": 2139}
{"id": "Simplicius_Passim_2140", "series": "CAG", "text": "καὶ ἐν τοῖς ἀσωμάτοις δέ, φησίν, ποσοῖς ἐναργὴς ἡ τοιαύτη διαφορά·", "seq": 2140}
{"id": "Simplicius_Passim_2141", "series": "CAG", "text": "ἐὰν γάρ τις τὴν ψυχὴν ὑποθῆται ὡς καθ᾿ ἑαυτὸ ποσόν, ᾗ νεύει εἰς τὸ σῶμα, ῥοπὴν ἕξει τὴν ἐπὶ τὸ κάτω, ᾗ δὲ ἀπὸ τῶν κάτω πρὸς τὸ νοητὸν νεύει, ἐπὶ τὸ ἄνω·", "seq": 2141}
{"id": "Simplicius_Passim_2142", "series": "CAG", "text": "ὁ δὲ νοῦς ἀρρεπὲς ποσόν.", "seq": 2142}
{"id": "Simplicius_Passim_2143", "series": "CAG", "text": "διὰ τί δέ, φησίν, τὰ μὲν διαστήματα τῆς φωνῆς ποσὰ λέγομεν, τὰ δὲ τῆς ῥοπῆς διαστήματα οὐ λέγομεν ποσά;”", "seq": 2143}
{"id": "Simplicius_Passim_2144", "series": "CAG", "text": "πρὸς δὲ Κορνοῦτον καὶ Πορφύριον τὴν ῥοπὴν κατὰ βαρύτητα καὶ κουφότητα θεωρουμένην ποιότητα λέγοντάς φησιν τὴν ῥοπὴν μὴ εἶναι βαρύτητα καὶ κουφότητα, ἀλλὰ μέτρον βαρύτητος καὶ κουφότητος·", "seq": 2144}
{"id": "Simplicius_Passim_2145", "series": "CAG", "text": "“αὐτὰ μὲν γὰρ καθ᾿ αὑτὰ τὰ βαρέα ἢ κοῦφα ἐπ᾿ ἄπειρον ἂν προΐοι μηδένα ἔχοντα ὅρον ἐξ ἑαυτῶν, ἐπειδὴ δὲ ἡ ἀπὸ τῶν μέτρων τῆς ῥοπῆς δύναμις τάξιν καὶ ὅρον ἐντέθεικεν, τηνικαῦτα εἰς εὐταξίαν κατέστη”.", "seq": 2145}
{"id": "Simplicius_Passim_2146", "series": "CAG", "text": "κοινῶς μὲν δὴ περὶ τοῦ ποσοῦ ταῦτα διαπορεῖται καὶ οὕτως διαλύεται.", "seq": 2146}
{"id": "Simplicius_Passim_2147", "series": "CAG", "text": "Κατ᾿ ἰδίαν δὲ περὶ ἑκάστου τῶν εἰδῶν τοῦ ποσοῦ διαποροῦντες περὶ τοῦ ἀριθμοῦ πρώτου διαιρούμενοι λέγουσιν ὡς ἄλλη μέν τίς ἐστιν τοῦ ἀριθμοῦ φύσις, καθ᾿ ἥν ἐστιν ὡρισμένος καὶ πόσος βαρυτόνως, ἄλλη δέ, καθ᾿ ἣν τὸ ποσὸν αὐτῷ ἀορίστως καὶ ὀξυτόνως ὑπάρχει·", "seq": 2147}
{"id": "Simplicius_Passim_2148", "series": "CAG", "text": "καὶ ταύτην εἶναι τὴν δηλουμένην, ὅταν ποσὸν τὸν ἀριθμὸν εἶναι λέγωμεν, τὴν δὲ ἑτέραν παραλελεῖφθαι τοῖς περὶ αὐτοῦ διαλεχθεῖσιν.", "seq": 2148}
{"id": "Simplicius_Passim_2149", "series": "CAG", "text": "πρὸς οὓς εὐθὺς ἐνίστασθαι προσήκει·", "seq": 2149}
{"id": "Simplicius_Passim_2150", "series": "CAG", "text": "οὐ γὰρ ἄλλο μὲν ὁ ἀριθμὸς ἔχει τὸ ποσὸς εἶναι, ἄλλο δὲ τὸ τοσόσδε εἶναι·", "seq": 2150}
{"id": "Simplicius_Passim_2151", "series": "CAG", "text": "εἰ γὰρ πᾶν τὸ μετασχὸν ἀριθμοῦ τὸ τοσόνδε εἶναι ἔχει, πῶς ἂν ὁ ἀριθμὸς ἄλλο τι εἴη παρὰ τὸ τοσόνδε;", "seq": 2151}
{"id": "Simplicius_Passim_2152", "series": "CAG", "text": "οὐ γὰρ τὸ ποσὸν εἴληπται τὸ ὕλῃ ἀναλογοῦν ἐν τῷ ἀριθμῷ, ἀλλὰ τὸ διωρισμένον **, ὃ ἤδη ἀριθμός ἐστιν·", "seq": 2152}
{"id": "Simplicius_Passim_2153", "series": "CAG", "text": "τὸ μὲν γὰρ διωρισμένον μόνον ποσὸν πλῆθος ποιεῖ, τὸ δὲ καὶ ὡρισμένον ἀριθμόν.", "seq": 2153}
{"id": "Simplicius_Passim_2154", "series": "CAG", "text": "ἔτι δὲ τῶν συνθέτων καὶ ἐνύλων τοῦτο ἴδιον τὸ ἄλλα μὲν αὐτὰ εἶναι, ἄλλο δὲ τὸ εἶναι αὐτῶν, ὥσπερ ἄλλο μὲν ἄνθρωπος ὁ σύνθετος αὐτός, ἄλλο δὲ τὸ ἀνθρώπῳ εἶναι, ἡ κατὰ τὸ εἶδος ὑπόστασις·", "seq": 2154}
{"id": "Simplicius_Passim_2155", "series": "CAG", "text": "τὰ δὲ ἄυλα εἴδη καὶ ἀσύνθετα, ὡς καὶ Ἀριστοτέλης ἀποδείκνυσιν, ταὐτὸν ἔχει τὸ ἕκαστον καὶ τὸ ἑκάστῳ εἶναι.", "seq": 2155}
{"id": "Simplicius_Passim_2156", "series": "CAG", "text": "εἰ δέ τις ἕκαστον τῶν ὄντων οὐσιοῦν βουλόμενος ἄλλην μὲν τὴν οὐσίαν αὐτοῦ ἀπαιτεῖ εἶναι, ἄλλην δὲ τὴν ἰδιότητα καὶ τὸ εἶδος, ἐννοείτω ὡς ὁ εἰδητικὸς ἀριθμὸς καὶ τῶν ἄλλων εἰδῶν ἕκαστον ταῖς οὐσίαις τῶν ὄντων συνυπάρχουσιν οὔτε πρότερα αὐτῶν οὔτε ὕστερα ὄντα, ἀλλὰ κατὰ τὰς οὐσίας οὐσιωμένα, ὥσπερ αἱ οὐσίαι κατὰ τοὺς ἀριθμοὺς ἠρίθμηνται.", "seq": 2156}
{"id": "Simplicius_Passim_2157", "series": "CAG", "text": "Ἀλλὰ διὰ τί, φησὶν ὁ Πλωτῖνος, οὐσιώδους ὄντος ἐκείνου τοῦ ἀριθμοῦ ὁ ἐνταῦθα οὐκ ἔστιν οὐσία;", "seq": 2157}
{"id": "Simplicius_Passim_2158", "series": "CAG", "text": "ἢ ὅτι οὐδὲ τὰ ἄλλα, ὅσα ἐστὶν ἐνταῦθα ὡς ἐν ἑτέροις ἕτερα, καὶ ἐν τῷ νῷ ὡς συμβεβηκότα θεωρεῖται, ἀλλ᾿ αὐτὰ καθ᾿ αὑτὰ ἕστηκεν, οἷον ἡ δικαιοσύνη ἐνταῦθα μέν ἐστιν ἕξις τῆς ψυχῆς, ὅτι κατὰ μέθεξιν ὑφίσταται καὶ οἷον πεπόνθησιν, ἐν δὲ τῷ νῷ αὐτὸ τοῦτο ὅπερ ἐστίν·", "seq": 2158}
{"id": "Simplicius_Passim_2159", "series": "CAG", "text": "καὶ γὰρ καὶ ὁ ἐν τῇ ψυχῇ τῆς δικαιοσύνης λόγος οὐσιώδης ἐστὶν ὑπόστασις.", "seq": 2159}
{"id": "Simplicius_Passim_2160", "series": "CAG", "text": "οὕτως δὲ καὶ ὁ ἀριθμὸς καὶ τῶν ἄλλων εἰδῶν ἕκαστον ἐν μὲν τοῖς αἰσθητοῖς μεριστῶς μετεχόμενον συμβεβηκὸς γίνεται, ἐν δὲ τοῖς ἀύλοις εἴδεσιν μονοειδῶς ἕστηκεν κατ᾿ ἐνέργειαν ἐν ταῖς οὐσίαις ἀφωρισμένα.", "seq": 2160}
{"id": "Simplicius_Passim_2161", "series": "CAG", "text": "οὗτος μὲν οὖν ἄλλος λόγων τρόπος, ὡς ὁ θεῖος Ἰάμβλιχός φησιν.", "seq": 2161}
{"id": "Simplicius_Passim_2162", "series": "CAG", "text": "Περὶ δὲ τοῦ μοναδικοῦ ἀριθμοῦ διαπορεῖ πάλιν ὁ Πλωτῖνος, καθ᾿ ὃν πέντε ἵπποι θεωροῦνται καὶ τὰ ἄλλα ὡσαύτως κατὰ σύνθεσιν μονάδων μετρεῖται, πότερον ἐνυπάρχει ἢ χωρὶς ὢν μετρεῖ, ὥσπερ ὁ κανών·", "seq": 2162}
{"id": "Simplicius_Passim_2163", "series": "CAG", "text": "‘καὶ γὰρ εἰ χωρὶς ὢν μετρεῖ, ποσὰ οὐκ ἔσται τὰ ὑποκείμενα μὴ μετέχοντα τοῦ ποσοῦ·", "seq": 2163}
{"id": "Simplicius_Passim_2164", "series": "CAG", "text": "ἔπειτα μέτρα μὲν ἔστω τὰ κεχωρισμένα ὡς μετροῦντα, διὰ τί δὲ ποσά;", "seq": 2164}
{"id": "Simplicius_Passim_2165", "series": "CAG", "text": "ἡ γὰρ αὐτοποσότης οὐ πάντως ἐστὶ ποσόν’.", "seq": 2165}
{"id": "Simplicius_Passim_2166", "series": "CAG", "text": "τοῦτο δὲ αὐτὸς μὲν λύων ‘εἰ ἐν τοῖς οὖσιν ὄντες, φησίν, οἱ ἀριθμοὶ εἰς μηδεμίαν ἄλλην κατηγορίαν ἀνάγονται, ποσὸν ἂν εἶεν’·", "seq": 2166}
{"id": "Simplicius_Passim_2167", "series": "CAG", "text": "ὁ δὲ Ἰάμβλιχός φησιν ὅτι “ὥσπερ τὰ ἄλλα ἔνυλα εἴδη, οὕτως καὶ ὁ ἀριθμὸς πάρεστι μὲν καὶ συνυπάρχει τοῖς διαριθμουμένοις πράγμασιν, οὐ μέντοι ἐν αὐτοῖς ἁπλῶς ἔχει τὴν ὑπόστασιν, οὐδὲ ἐπιγινομένην αὐτοῖς κατ᾿ ἐπακολούθησιν οὐδὲ ἐν συμβεβηκότος τάξει παραγινομένην, ἔχουσαν δέ τινα ἰδίαν μετὰ τῶν πραγμάτων οὐσίαν, καθ᾿ ἣν ἀφορίζει καὶ πρὸς τὸ οἰκεῖον μέτρον συντάττει τὰ μετέχοντα”.", "seq": 2167}
{"id": "Simplicius_Passim_2168", "series": "CAG", "text": "καὶ τὴν ποσότητα δὲ ποσὸν εἶναι οὐκ ἄτοπον ὁ Ἰάμβλιχός φησιν, ὡς καὶ ἑαυτῇ παρέχουσαν ὅπερ τοῖς ἄλλοις δίδωσιν·", "seq": 2168}
{"id": "Simplicius_Passim_2169", "series": "CAG", "text": "“καὶ γὰρ πρώτως, φησίν, ἀφ᾿ ἑαυτῶν ἄρχεται τὰ χωριστὰ εἴδη τῆς ὄντως ἰδέας καὶ κατὰ τὴν εἰς ἑαυτὰ ἐνέργειαν ἑαυτοῖς τε παρέχει τὸ οἰκεῖον εἶδος καὶ τοῖς ἄλλοις ἀφ᾿ ἑαυτῶν ὁμοῦ ἐνδίδωσιν”.", "seq": 2169}
{"id": "Simplicius_Passim_2170", "series": "CAG", "text": "ἀξιῶ δὲ ἐφιστάνειν ἐγώ, πῶς ἡ ποσότης μετέχειν ἂν ἑαυτῆς λέγοιτο, ὥστε εἶναι ποσόν, καὶ ἡ ἰσότης ἴσον καὶ ἐπὶ τῶν ἄλλων ὁμοίως·", "seq": 2170}
{"id": "Simplicius_Passim_2171", "series": "CAG", "text": "τὸ γὰρ μετέχον ἄλλο τι ὂν ἔπειτα μετέχει.", "seq": 2171}
{"id": "Simplicius_Passim_2172", "series": "CAG", "text": "ἀλλ᾿ ὁ ἀριθμὸς ποσὸν εἰκότως λέγεται·", "seq": 2172}
{"id": "Simplicius_Passim_2173", "series": "CAG", "text": "διαφορὰ γάρ τις ἡ τοῦ ὡρισμένου μετὰ τοῦ γένους τῆς ποσότητος ποσὸν ποιεῖ τὸ ὅλον.", "seq": 2173}
{"id": "Simplicius_Passim_2174", "series": "CAG", "text": "εἴη δὲ ἂν καὶ ποσότης τις ὁ ἀριθμός, ὅτι τὰ γένη τῶν εἰδῶν συνωνύμως κατηγορεῖται.", "seq": 2174}
{"id": "Simplicius_Passim_2175", "series": "CAG", "text": "εἴτε δὲ κατὰ τὸ ἀριθμεῖν εἴτε κατὰ τὸ ἀριθμεῖσθαί ἐστιν ὁ ἀριθμός, πανταχῇ ἂν οὕτως τοῦ ποσοῦ εἴη.", "seq": 2175}
{"id": "Simplicius_Passim_2176", "series": "CAG", "text": "περὶ μὲν οὖν ἀριθμοῦ τοσαῦτα.", "seq": 2176}
{"id": "Simplicius_Passim_2177", "series": "CAG", "text": "Περὶ δὲ λόγου ἀποροῦσιν, πῶς ὁ λόγος ἐν ποσῷ, πρῶτον μέν, ὅτι τὰ ἄνευ συμπλοκῆς εἰς τὰς κατηγορίας ἀνάγεται, λόγος δὲ πᾶς κατὰ συμπλοκήν·", "seq": 2177}
{"id": "Simplicius_Passim_2178", "series": "CAG", "text": "ἔπειτα, εἰ τοσόσδε ὁ λόγος, κατὰ μὲν τὸ τοσόνδε ποσὸν ἔσται ὡς κατὰ συμβεβηκός, καθὸ μέντοι λόγος σημαντικός ἐστιν κατὰ πληγὴν τοῦ ἀέρος ὑφεστηκώς, εἴτε οὖν πληγὴ ὁ λόγος εἴτε τύπωσις τῆς πληγῆς μορφοῦσα αὐτήν, ἢ πάθος ἐστὶν ἢ ποίησις, ποίησις μὲν τῆς κατὰ φαντασίαν ὁρμῆς τοῦ ἡγεμονικοῦ, πάθος δὲ τοῦ ἀέρος·", "seq": 2178}
{"id": "Simplicius_Passim_2179", "series": "CAG", "text": "ἔσται οὖν ἢ τοῦ ποιεῖν ἢ τοῦ πάσχειν ὁ λόγος ὁ ἐν τῇ φωνῇ ἢ καὶ τοῦ ποιεῖν καὶ τοῦ πάσχειν, ἀλλ᾿ οὐχὶ ποσόν.", "seq": 2179}
{"id": "Simplicius_Passim_2180", "series": "CAG", "text": "εἰ δέ τις κατὰ τὴν πληγὴν μόνην ἀφορίζοιτο τὴν φωνὴν καὶ τὸν λόγον, εἰς κίνησιν αὐτὸν ἀνάξει·", "seq": 2180}
{"id": "Simplicius_Passim_2181", "series": "CAG", "text": "εἰ δὲ κατὰ τὸν πληγέντα ἀέρα, οὐ μία κατηγορία, εἴγε οὐχ ἓν τὸ σημαντικὸν καὶ συσσημαντικὸν καὶ τὸ ἐνεργοῦν καὶ τὸ ἐν ᾧ ἐγγινόμενον ἐνεργεῖ.", "seq": 2181}
{"id": "Simplicius_Passim_2182", "series": "CAG", "text": "πρὸς δὴ ταῦτα ἀπαντῶν ὁ Ἰάμβλιχος “οὐχ ἁπλῶς, φησίν, ἐν πληγῇ ἀέρος τὴν φωνὴν τιθέμεθα·", "seq": 2182}
{"id": "Simplicius_Passim_2183", "series": "CAG", "text": "πλήττει γὰρ καὶ δάκτυλος τὸν ἀέρα καὶ οὔπω ποιεῖ φωνήν·", "seq": 2183}
{"id": "Simplicius_Passim_2184", "series": "CAG", "text": "ἀλλ᾿ ἡ ποσὴ πληγὴ καὶ σφοδρὰ καὶ τοσήδε καὶ τοιῶσδε, ὥστε ἀκουστὴ γενέσθαι, καὶ ἡ τῷ μέτρῳ τῆς ἀκοῆς συνεξισουμένη καὶ ἡ τὸ ὑπερβάλλον καὶ τὸ ἐλλεῖπον ἐν ἑαυτῇ ἔχουσα, αὕτη κυρίως ἂν φωνὴ νομίζοιτο.", "seq": 2184}
{"id": "Simplicius_Passim_2185", "series": "CAG", "text": "κατὰ τὸ μέγεθος οὖν τῆς πληγῆς καὶ ποσὸν μέτρον τὴν φωνὴν τιθέμενος ποσὴν αὐτὴν εἰκότως εἶναι ἀποφαίνεται”.", "seq": 2185}
{"id": "Simplicius_Passim_2186", "series": "CAG", "text": "ταῦτα μὲν οὖν αὐταῖς λέξεσιν ὁ θεῖος Ἰάμβλιχος γέγραφεν.", "seq": 2186}
{"id": "Simplicius_Passim_2187", "series": "CAG", "text": "Ἀπορίας δὲ ἄξιον οἶμαι, πῶς οὐχὶ τούτῳ τῷ λόγῳ καὶ τὸ τῆς γεύσεως καὶ τὸ τῆς ὀσφρήσεως ἴδιον αἰσθητὸν ποσὸν ἂν εἴη·", "seq": 2187}
{"id": "Simplicius_Passim_2188", "series": "CAG", "text": "ἡ γὰρ τοσήδε καὶ τοιάδε ποιότης τοῦ χυμοῦ καὶ τοῦ ἀτμοῦ ὥστε αἰσθητὴ γενέσθαι, αὕτη ἂν εἴη καὶ γευστὴ καὶ ὀσφραντή.", "seq": 2188}
{"id": "Simplicius_Passim_2189", "series": "CAG", "text": "ἀλλ᾿ οὐδὲ Ἀριστοτέλης κατὰ τὸ κοινὸν τοῦτο φαίνεται ποσὸν εἰπὼν τὸν λόγον, ἀλλ᾿ ὅτι καταμετρεῖται συλλαβῇ βραχείᾳ καὶ μακρᾷ.", "seq": 2189}
{"id": "Simplicius_Passim_2190", "series": "CAG", "text": "τοῦτο δέ φασιν οὐκ αὔταρκες·", "seq": 2190}
{"id": "Simplicius_Passim_2191", "series": "CAG", "text": "οὐδὲ γὰρ ὁ λόγος καθὸ λόγος μετρεῖται οὐδὲ ἡ βραχεῖα συλλαβὴ καθὸ συλλαβὴ *, ἀλλ᾿ ὅτι ἐν χρόνῳ πλείονι ἢ ἐλάττονι, ὥστε ὁ χρόνος ἂν εἴη ὁ μετρῶν τὸν χρόνον, ὁ ἐλάττων τὸν μείζονα, ὁ τῆς συλλαβῆς τὸν τοῦ λόγου·", "seq": 2191}
{"id": "Simplicius_Passim_2192", "series": "CAG", "text": "κατὰ συμβεβηκὸς οὖν ἡ συλλαβὴ τὸν λόγον μετρεῖ.", "seq": 2192}
{"id": "Simplicius_Passim_2193", "series": "CAG", "text": "πρὸς δὴ ταῦτά φησιν ὁ Πορφύριος, ὅτι οὐκ ἐπειδὴ ἐν βραχεῖ χρόνῳ λέγεται ἡ βραχεῖα συλλαβή, διὰ τοῦτό ἐστι βραχεῖα, ἀλλὰ τῇ ἑαυτῆς φύσει ἔχει τὴν σμικρότητα·", "seq": 2193}
{"id": "Simplicius_Passim_2194", "series": "CAG", "text": "ὁμοίως δὲ καὶ ἡ μακρά.", "seq": 2194}
{"id": "Simplicius_Passim_2195", "series": "CAG", "text": "καὶ γὰρ ἡ μὲν στενουμένης τῆς ἀρτηρίας δι᾿ ὀλιγότητα πνεύματος λέγεται βραχεῖα, ἡ δὲ εὐρυνομένης διὰ πλῆθος μακρά, ὥστε ἡ μὲν ὡς βραχεῖα φύσει ἐν βραχεῖ χρόνῳ λέγεται, ἡ δὲ ὡς μακρὰ ἐν μακρῷ.", "seq": 2195}
{"id": "Simplicius_Passim_2196", "series": "CAG", "text": "δυνατὸν δὲ καὶ τὴν φύσει βραχεῖαν ἐν μακρῷ χρόνῳ προενέγκασθαι καὶ τὴν φύσει μακρὰν ἐν βραχεῖ.", "seq": 2196}
{"id": "Simplicius_Passim_2197", "series": "CAG", "text": "τούτῳ γὰρ διαφέρει μετρικὸς ῥυθμικοῦ·", "seq": 2197}
{"id": "Simplicius_Passim_2198", "series": "CAG", "text": "ὁ μὲν γὰρ τοῖς κατὰ φύσιν μήκεσι χρῆται, ὁ δὲ ἐναλλάττει τὰς φύσεις ἑκατέρου·", "seq": 2198}
{"id": "Simplicius_Passim_2199", "series": "CAG", "text": "ὅταν γὰρ μεταβάλλῃ τὸ δακτυλικὸν μέτρον εἰς παιώνιον ῥυθμόν, ταῖς μακραῖς ὡς βραχείαις καὶ ἀνάπαλιν ἐνίοτε χρῆται·", "seq": 2199}
{"id": "Simplicius_Passim_2200", "series": "CAG", "text": "ὁ δὲ μετρικός, ἐὰν δεηθείη, τὰ στοιχεῖα μεταβάλλει, οἷον τὸ ξηρὸν ξερὸν λέγει καὶ τὸν Διόνυσον Διώνυσον.", "seq": 2200}
{"id": "Simplicius_Passim_2201", "series": "CAG", "text": "εἰ οὖν διέστηκεν ἐπὶ τούτων τὸ φύσει βραχὺ καὶ <τὸ> τῷ χρόνῳ, οὐ τῷ βραχεῖ χρόνῳ συλλαβὴ βραχεῖα λέγεται, ἀλλὰ τῷ βραχεῖα εἶναι ἐν βραχεῖ χρόνῳ λέγεται.", "seq": 2201}
{"id": "Simplicius_Passim_2202", "series": "CAG", "text": "Διὰ τί δέ, φασίν, οὐ τοῖς γράμμασιν εἶπεν μετρεῖσθαι τὸν λόγον, ἀλλὰ ταῖς συλλαβαῖς;", "seq": 2202}
{"id": "Simplicius_Passim_2203", "series": "CAG", "text": "ἢ ὅτι τὰ μὲν γράμματα κατὰ τὸν χαρακτῆρα θεωρούμενα οὐ ποιεῖ ἐκφώνησιν, τὰ δὲ στοιχεῖα κατὰ τὴν δύναμιν νοούμενα καὶ τὴν ἐκφώνησιν τὸ μῆκος ἔχει ** καθ᾿ ἃ τὸ ποσὸν τοῦ λόγου·", "seq": 2203}
{"id": "Simplicius_Passim_2204", "series": "CAG", "text": "διὸ καὶ ἐν ἑνὶ καὶ ἐν πλείοσιν οὐδὲν ἧττον συλλαβὴ γίνεται, καὶ τὸ μῆκος καὶ ἡ βραχύτης τῆς ἐκφωνήσεως γίνεται, ὡς ἂν ἔχῃ φύσεως τὰ στοιχεῖα.", "seq": 2204}
{"id": "Simplicius_Passim_2205", "series": "CAG", "text": "Πῶς δέ, φασίν, βραχείᾳ καὶ μακρᾷ καταμετρεῖσθαι τὸν λόγον εἶπεν;", "seq": 2205}
{"id": "Simplicius_Passim_2206", "series": "CAG", "text": "ἤρκει γὰρ ἡ βραχεῖα καταμετροῦσα καὶ τὴν μακράν.", "seq": 2206}
{"id": "Simplicius_Passim_2207", "series": "CAG", "text": "ἢ οὐ πᾶσα βραχεῖα δὶς γενομένη καταμετρεῖ τὴν μακράν·", "seq": 2207}
{"id": "Simplicius_Passim_2208", "series": "CAG", "text": "καὶ γὰρ καὶ τῆς μακρᾶς μακροτέραν ὑποτίθενται.", "seq": 2208}
{"id": "Simplicius_Passim_2209", "series": "CAG", "text": "δεῖ οὖν τὴν μακρὰν μὲν τὰς μακράς, τὴν δὲ βραχεῖαν τὰς βραχείας μετρεῖν.", "seq": 2209}
{"id": "Simplicius_Passim_2210", "series": "CAG", "text": "ἢ πᾶσα μὲν βραχεῖα ὑπὸ βραχείας μετρεῖται, οὐχ ἅπαξ δὲ οὐδὲ ἀεὶ τῆς αὐτῆς, ἀλλὰ ἄλλοτε ἄλλης·", "seq": 2210}
{"id": "Simplicius_Passim_2211", "series": "CAG", "text": "καὶ ἡ μακρὰ δὲ ὡσαύτως οὐκ ἀεὶ ὑπὸ τῆς αὐτῆς μακρᾶς ἢ ὑπὸ τῆς αὐτῆς βραχείας μετρεῖται, ἀλλ᾿ ὡς ἂν τύχῃ συναπαρτίζοντα τὰ καταμετροῦντα τῷ μήκει τῶν καταμετρουμένων τὸ δὲ ‘μετρεῖται’ δύναται δηλοῦν καὶ τὸ ‘σύγκειται ἐκ τούτων’·", "seq": 2211}
{"id": "Simplicius_Passim_2212", "series": "CAG", "text": "ᾗ τοίνυν ὁ λόγος ἐκ μέτρων συνέστηκεν τῶν συλλαβῶν, ποσὸν ἂν εἴη κατ᾿ αὐτὸ τὸ εἶναι, οὐχ ἁπλῶς δὲ ποσόν, ἀλλὰ σημαντικόν, ὥσπερ ὁ τόπος περιεκτικόν.", "seq": 2212}
{"id": "Simplicius_Passim_2213", "series": "CAG", "text": "τὸ οὖν τοσόνδε οὐκ ἐπεισοδιῶδες, ὥσπερ οὐδὲ τῷ ἀριθμῷ ἢ τῷ μεγέθει.", "seq": 2213}
{"id": "Simplicius_Passim_2214", "series": "CAG", "text": "Ἀλλ᾿ ἐκεῖνο οἶμαι ἀπορίας ἄξιον, εἰ πᾶν ποσὸν μέτρον ἐστὶν ὡς μετροῦν·", "seq": 2214}
{"id": "Simplicius_Passim_2215", "series": "CAG", "text": "ὁ γοῦν ἀριθμὸς μετρεῖ τὰ διωρισμένα καὶ ὁ πῆχυς τὰ συνεχῆ, ὁ δὲ λόγος τί μετρεῖ;", "seq": 2215}
{"id": "Simplicius_Passim_2216", "series": "CAG", "text": "ἢ μετροῦσι μὲν τὰ τοῦ λόγου μόρια συλλαβαί, μετρεῖται δὲ ὁ λόγος·", "seq": 2216}
{"id": "Simplicius_Passim_2217", "series": "CAG", "text": "οὐ γὰρ τὰ μετροῦντα μόνον ἐστὶν ποσά, ἀλλὰ καὶ τὰ μετρούμενα.", "seq": 2217}
{"id": "Simplicius_Passim_2218", "series": "CAG", "text": "Πρὸς δέ γε τὸ πρῶτον τῶν ἀπορηθέντων τὸ λέγον ὅτι τὰ ἄνευ συμπλοκῆς εἰς τὰς κατηγορίας ἀνάγεται, λόγος δὲ πᾶς μετὰ συμπλοκῆς θεωρεῖται, ῥητέον ὅτι καὶ τὸ ὄνομα καὶ τὸ ῥῆμα λόγος ἐστὶν κατὰ τοῦτο τοῦ λόγου τὸ σημαινόμενον, μᾶλλον δὲ καὶ πᾶσα λέξις, κἂν ἄσημος εἴη·", "seq": 2218}
{"id": "Simplicius_Passim_2219", "series": "CAG", "text": "καὶ αὐτὴ γὰρ συλλαβαῖς καταμετρεῖται καὶ διὰ τοῦτο ποσόν.", "seq": 2219}
{"id": "Simplicius_Passim_2220", "series": "CAG", "text": "ἔπειτα δέ, κἂν κατὰ συμπλοκὴν ὁ λόγος, ἀλλ᾿ ᾗ ποσόν, ὑπὸ τὸ ποσὸν ἀνάγεται τὸ ὡς γένος, ὥσπερ καὶ ἡ σύνθετος ἐκ πολλῶν οὐσιῶν οὐσία ὑπὸ τὴν οὐσίαν καὶ τὸ σύνθετον χρῶμα ὑπὸ τὸ χρῶμα καὶ τὸ ποιόν·", "seq": 2220}
{"id": "Simplicius_Passim_2221", "series": "CAG", "text": "ὑφ᾿ ὃ γὰρ τὰ ἁπλᾶ, ὑπὸ τοῦτο καὶ τὰ ἐκ τῶν ἁπλῶν ἐκείνων συγκείμενα.", "seq": 2221}
{"id": "Simplicius_Passim_2222", "series": "CAG", "text": "Ἀλλὰ διὰ τί, φασίν, ἐνδοιάζων εἶπεν·", "seq": 2222}
{"id": "Simplicius_Passim_2223", "series": "CAG", "text": "εἰ τὰ πέντε τῶν δέκα μόριον;", "seq": 2223}
{"id": "Simplicius_Passim_2224", "series": "CAG", "text": "ἢ οὐ διὰ τὸ ἀμφίβολον·", "seq": 2224}
{"id": "Simplicius_Passim_2225", "series": "CAG", "text": "ἀλλ᾿ ὅτι πολλαχῶς οἷόν τε διελεῖν τὰ δέκα, καὶ γὰρ εἰς ἓξ καὶ τέσσαρα, καὶ ἑπτὰ καὶ τρία, καὶ ὀκτὼ καὶ δύο, καὶ ἐννέα καὶ ἕν.", "seq": 2225}
{"id": "Simplicius_Passim_2226", "series": "CAG", "text": "τοσαῦτα μὲν οὖν περὶ τοῦ διωρισμένου ποσοῦ ἠπόρηταί τε καὶ διαλύεται.", "seq": 2226}
{"id": "Simplicius_Passim_2227", "series": "CAG", "text": "Περὶ δὲ τοῦ συνεχοῦς ὁ αὐτὸς ἀνὴρ ἀπορεῖ τοιάδε·", "seq": 2227}
{"id": "Simplicius_Passim_2228", "series": "CAG", "text": "‘τὸ σῶμα, φησίν, ᾗ σῶμα, καὶ ἐπιφάνεια καὶ γραμμὴ καὶ ὅλως μέγεθος, ᾗ τοιαῦτα, οὐκ ἔστι ποσά, ἀλλὰ ποσὰ λέγεται τῷ μετασχεῖν τοῦ τοσοῦδε καὶ τῷ ἀριθμοῦ μετασχεῖν·", "seq": 2228}
{"id": "Simplicius_Passim_2229", "series": "CAG", "text": "μόνος ἄρα ὁ ἀριθμὸς ποσόν’.", "seq": 2229}
{"id": "Simplicius_Passim_2230", "series": "CAG", "text": "λύων δὲ ταῦτα πάλιν ἐν τῷ τρίτῳ φησὶν πρόοδον εἶναι τῆς στιγμῆς εἰς τὸ πόρρω, καὶ εἰ μὲν ἐφ᾿ ἕν, γραμμὴ γίνεται, εἰ δὲ ἐπὶ δύο, ἐπίπεδον, εἰ δὲ ἐπὶ τρία, σῶμα, καὶ εἰ μὲν ἐπὶ πολὺ ἡ διάστασις, μέγα, εἰ δὲ ἐπ᾿ ὀλίγον, μικρόν, καὶ ὅταν μὲν κατὰ κοινὸν ὅρον ἡ πρόοδος γίνεται, συνεχὲς τὸ τοιοῦτον, ὅταν δὲ κατὰ ἴδιον, διῃρημένον·", "seq": 2230}
{"id": "Simplicius_Passim_2231", "series": "CAG", "text": "ποσὸν οὖν καὶ τὸ μέγεθος, ἀλλ᾿ ἀορίστως μὲν μέγα ἢ μικρὸν ἢ ὡς ἐπὶ πλήθους πολὺ ἢ ὀλίγον, ὁρισθὲν δὲ μέτρῳ τινὶ ἢ ἀριθμῷ ἢ πήχει ὡρισμένως λέγεται.", "seq": 2231}
{"id": "Simplicius_Passim_2232", "series": "CAG", "text": "ἀλλ᾿ ἐπιστῆσαι χρή, ὅτι κἂν ὁρισθῇ μέτρῳ ἡ γραμμὴ ἢ ὅλως τὸ συνεχὲς ποσόν, ὡρισμένον μὲν γίνεται ποσόν, ἀλλὰ κατὰ μέθεξιν ἴσχει τοῦτο, τῷ δὲ αὑτῆς λόγῳ διάστασίς ἐστι μόνον καὶ οὐχὶ ποσόν.", "seq": 2232}
{"id": "Simplicius_Passim_2233", "series": "CAG", "text": "εἰ γὰρ ποσὸν τοῦτό ἐστι καθ᾿ ὃ καὶ ποσόν ἐστι, δυνατὸν λέγειν ὅτι αὕτη ἡ διάστασις μεταλαμβάνει μὲν ποσοῦ, οὐ μέντοι ἐστὶν τῷ ἑαυτῆς λόγῳ ποσόν.", "seq": 2233}
{"id": "Simplicius_Passim_2234", "series": "CAG", "text": "μήποτε οὖν οὔτε καθὸ μετρεῖται ὡρισμένον ποσόν ἐστιν τῷ ἑαυτοῦ λόγῳ τὸ συνεχές, ἀλλὰ κατὰ μέθεξιν, οὔτε μὴ μεμετρημένον ἀόριστον ποσὸν ἢ ὅλως ποσὸν τῷ ἑαυτοῦ λόγῳ, ἀλλὰ ποσόν ἐστιν τὸ συνεχές, καθ᾿ ὅσον ἢ ἐφ᾿ ἓν ἢ ἐπὶ δύο ἢ ἐπὶ τρία διέστηκεν τῷ ἑαυτοῦ λόγῳ.", "seq": 2234}
{"id": "Simplicius_Passim_2235", "series": "CAG", "text": "ὥσπερ γὰρ ὁ ἀριθμὸς κατὰ τὸν διορισμὸν ἔχει τὸ ποσόν, οὕτως καὶ τὸ μέγεθος κατὰ τὴν διάστασιν·", "seq": 2235}
{"id": "Simplicius_Passim_2236", "series": "CAG", "text": "τὸ γὰρ ἀποστὰν οἶμαι τοῦ ἑνὸς καὶ ἀμεροῦς καὶ κινδυνεῦον εἰς ἄπειρον καὶ ἀόριστον ὑπενεχθῆναι, τοῦτο μέτρου ἐδεήθη καθ᾿ ὃ καὶ ποσὸν ἐγένετο, ἵνα ὁρισθῇ τῷ ποσὸν γενέσθαι·", "seq": 2236}
{"id": "Simplicius_Passim_2237", "series": "CAG", "text": "διττὸν δὲ ὂν κατά τε τὸ διωρισμένον καὶ κατὰ τὸ συνεχὲς διττῆς ἐδεήθη ποσότητος.", "seq": 2237}
{"id": "Simplicius_Passim_2238", "series": "CAG", "text": "Διὰ τί δέ, φασίν, μὴ προδιδάξας περὶ τόπου ἢ χρόνου ὡς ἐγνωσμένοις αὐτοῖς χρῆται;", "seq": 2238}
{"id": "Simplicius_Passim_2239", "series": "CAG", "text": "ἢ ὅτι οὐ τὴν οὐσίαν αὐτῶν παραδοῦναι προτίθεται·", "seq": 2239}
{"id": "Simplicius_Passim_2240", "series": "CAG", "text": "φυσικῆς γὰρ ἦν τοῦτο σκέψεως, ἣν ἐν τῇ Φυσικῇ ἀκροάσει πραγματεύεται·", "seq": 2240}
{"id": "Simplicius_Passim_2241", "series": "CAG", "text": "ἀλλ᾿ ὅπερ ἤρκει τῇ λογικῇ θεωρίᾳ, κατὰ τὴν κοινὴν περὶ αὐτῶν ἔννοιαν τὴν εἰς τὸ οἰκεῖον γένος τὸ ποσὸν ἀναγωγὴν αὐτῶν ἐποιήσατο.", "seq": 2241}
{"id": "Simplicius_Passim_2242", "series": "CAG", "text": "Ἀλλ᾿ ἄμεινον ἴσως, φασίν, Ἀνδρόνικος ἐποίησεν, ἰδίας μὲν ποιήσας κατηγορίας τὸν τόπον καὶ τὸν χρόνον, ὑποτάξας δὲ αὐταῖς τὸ ποῦ καὶ τὸ ποτέ.", "seq": 2242}
{"id": "Simplicius_Passim_2243", "series": "CAG", "text": "ἢ καὶ πρὸς τοῦτο ῥητέον ὅτι ἄλλη μέν ἐστιν ἔννοια τοῦ χρόνου, καθ᾿ ἥν ἐστιν διάστημα ὁ χρόνος, ἄλλη δὲ τοῦ ποτέ, καθ᾿ ἣν ἡ σχέσις τῶν ἐν τῷ χρόνῳ θεωρεῖται πρὸς τὸν χρόνον·", "seq": 2243}
{"id": "Simplicius_Passim_2244", "series": "CAG", "text": "καὶ ἐπὶ τόπου δὲ καὶ τῶν ἐν τόπῳ ὁ αὐτὸς ἁρμόσει λόγος.", "seq": 2244}
{"id": "Simplicius_Passim_2245", "series": "CAG", "text": "διόπερ Ἀριστοτέλης ὀρθῶς ἀλλαχοῦ μὲν τίθησι τὰ ποσά, ἀλλαχοῦ δὲ τὴν πρὸς τὰ ποσὰ ταῦτα σχέσιν κατέταξεν.", "seq": 2245}
{"id": "Simplicius_Passim_2246", "series": "CAG", "text": "Ἀλλὰ ζητήσοι ἄν τις οἶμαι δικαίως, διὰ τί ὥσπερ τὴν τοῦ χρόνου καὶ τοῦ τόπου μέθεξιν ἐν ἄλλαις τέθεικεν κατηγορίαις, οὐχ οὕτως καὶ τὴν τῆς οὐσίας ἢ τοῦ ποιοῦ ἢ ἄλλου τινὸς ποσοῦ, οἷον ἀριθμοῦ ἢ μεγέθους μέθεξιν, ἰδίας πεποίηκεν κατηγορίας;", "seq": 2246}
{"id": "Simplicius_Passim_2247", "series": "CAG", "text": "ἢ κἂν τὰ συμβεβηκότα ἐν τῇ οὐσίᾳ θεωρῆται κἂν ἡ οὐσία ἐν τοῖς συμβεβηκόσιν, ἐνυπάρχει ταῦτα ἀλλήλοις, καὶ διὰ τοῦτο καὶ ἡ σχέσις αὐτῶν συνῄρηται, καὶ οὐκ ἄλλο μέν τί ἐστιν ἡ οὐσία, ἄλλο δὲ ἡ πρὸς τὴν οὐσίαν σχέσις·", "seq": 2247}
{"id": "Simplicius_Passim_2248", "series": "CAG", "text": "ὁ δὲ χρόνος καὶ ὁ τόπος ἔξωθέν πως θεωρούμενοι ἄλλοι μὲν αὐτοί εἰσιν, ἄλλη δὲ ἡ πρὸς ταῦτα σχέσις τῶν ἐν τόπῳ καὶ χρόνῳ ὄντων.", "seq": 2248}
{"id": "Simplicius_Passim_2249", "series": "CAG", "text": "καὶ γὰρ ἐν τῇ φύσει τῶν ἔξωθεν παρακολουθούντων ὁ χρόνος καὶ ὁ τόπος δοκεῖ, ὥσπερ τῶν συμπληρούντων ὕλη καὶ εἶδος καὶ κίνησις.", "seq": 2249}
{"id": "Simplicius_Passim_2250", "series": "CAG", "text": "μήποτε δὲ τὸ ποτὲ οὐχ ἁπλῶς τὸ ἐν χρόνῳ δηλοῖ οὐδὲ τὸ ποῦ τὸ ἐν τόπῳ, ἀλλὰ τὴν τοῦ χρόνου καὶ τὴν τοῦ τόπου ἰδιότητα, καθὸ τοιοῦτοι, ὥσπερ καθὸ διαστάσεις καὶ ποσὰ ἐν τῷ ποσῷ κατηριθμήθησαν.", "seq": 2250}
{"id": "Simplicius_Passim_2251", "series": "CAG", "text": "Εἰ δέ τις τὸν χρόνον ὡς μέτρον κινήσεως τῷ πρός τι νομίζει δεῖν ὑπάγειν, τὸ μέτρον διχῇ διαιρετέον, ἢ αὐτὸ καθ᾿ αὑτὸ ἢ κατὰ τὴν πρὸς τὸ μετρούμενον ἀναφοράν, καὶ ὡς μὲν καθ᾿ αὑτὸ τὸ μέτρον ποσὸν καὶ ἀρχὴ καὶ γένος ἐστὶ τῶν ποσῶν πάντων, ὡς δὲ πρὸς τὸ μετρούμενον, πρός τι ἂν εἴη·", "seq": 2251}
{"id": "Simplicius_Passim_2252", "series": "CAG", "text": "οὕτως δὲ καὶ τὸ τῆς κινήσεως μέτρον ὁ χρόνος ὡς μὲν καθ᾿ αὑτὸ ποσὸν ἂν εἴη τι καθότι μέτρον, ὡς δὲ πρὸς τὴν κίνησιν πρός τι, καὶ οὐδὲν ἄτοπον κατ᾿ ἄλλας καὶ ἄλλας ἐννοίας εἰς διαφόρους κατηγορίας ἀνάγεσθαι.", "seq": 2252}
{"id": "Simplicius_Passim_2253", "series": "CAG", "text": "Μετὰ δὲ τὸν χρόνον περὶ τοῦ τόπου διαποροῦσιν·", "seq": 2253}
{"id": "Simplicius_Passim_2254", "series": "CAG", "text": "εἰ περιεκτικός ἐστι σώματος, ἢ ὡς οὐσιώδης ποιότης συμπληρωτικὴ τῆς οὐσίας ἐστὶν καὶ οὐκέτι ποσόν, ἢ εἰ κατ᾿ αὐτὴν τὴν σχέσιν θεωρεῖται μόνην, τῷ πρός τι ἀποδοθήσεται.", "seq": 2254}
{"id": "Simplicius_Passim_2255", "series": "CAG", "text": "κἀνταῦθα δὲ τὸ αὐτὸ ῥητέον, ὅτι κατὰ μὲν τὴν διάστασιν, καθ᾿ ὅσον πέρας ὢν τοῦ περιέχοντος καθ᾿ ὃ περιέχει τὸ περιεχόμενον ἐπιφάνειά ἐστιν ὁ τόπος, κατὰ τοσοῦτον ποσὸν αὐτὸν ἀνάγκη λέγειν·", "seq": 2255}
{"id": "Simplicius_Passim_2256", "series": "CAG", "text": "κατὰ δὲ τὴν πρὸς τὸ περιεχόμενον σχέσιν οὐδὲν θαυμαστὸν εἰ καὶ ὁ τόπος εἰς τὸ πρός τι ἀνάγοιτο, ὥσπερ καὶ ὁ χρόνος.", "seq": 2256}
{"id": "Simplicius_Passim_2257", "series": "CAG", "text": "μέχρι μὲν οὖν τούτου προῆλθον αἱ πρὸς τὴν πρώτην τοῦ ποσοῦ διαίρεσιν ἀπορίαι τε καὶ λύσεις.", "seq": 2257}
{"id": "Simplicius_Passim_2258", "series": "CAG", "text": "Ὁ δὲ θεῖος Ἰάμβλιχος κἀνταῦθα τὴν ἑαυτοῦ θεωρητικὴν ἐπιστήμην παραδεικνὺς τὰς πρώτας ἀρχὰς ἡμῖν τῶν τε δύο τοῦ ποσοῦ εἰδῶν καὶ τῆς μιᾶς ἀμφοῖν περιοχῆς ἐκφαίνων ὡδί πως γέγραφεν·", "seq": 2258}
{"id": "Simplicius_Passim_2259", "series": "CAG", "text": "“ἐπειδὴ γὰρ ἡ τοῦ ἑνὸς δύναμις, ἀφ᾿ οὗ πᾶν τὸ ποσὸν ἀπογεννᾶται, διατείνεται δι᾿ ὅλων ἡ αὐτὴ καὶ ὁρίζει ἕκαστον προϊοῦσα ἀφ᾿ ἑαυτῆς, ᾗ μὲν δι᾿ ὅλων διήκει παντάπασιν ἀδιαιρέτως, τὸ συνεχὲς ὑφίστησιν, καὶ ᾗ τὴν πρόοδον ποιεῖται μίαν καὶ ἀδιαίρετον καὶ ἄνευ διορισμοῦ·", "seq": 2259}
{"id": "Simplicius_Passim_2260", "series": "CAG", "text": "ᾗ δὲ προϊοῦσα ἵσταται καθ᾿ ἕκαστον τῶν εἰδῶν καὶ ᾗ ὁρίζει ἕκαστον καὶ ἕκαστον ἓν ποιεῖ, ταύτῃ τὸ διωρισμένον παράγει·", "seq": 2260}
{"id": "Simplicius_Passim_2261", "series": "CAG", "text": "κατὰ δὲ τὴν περιέχουσαν ἅμα τὰς δύο ταύτας ἐνεργείας μίαν κυριωτάτην αἰτίαν τὰ δύο ποσὰ παράγει.", "seq": 2261}
{"id": "Simplicius_Passim_2262", "series": "CAG", "text": "καὶ κατὰ μὲν τὴν πανταχοῦ ταὐτότητα καὶ ὅλην ἐφ᾿ ἑκάστων τε τῶν μορίων καὶ ἐπὶ πάντων τὸ συνεχὲς ἀπεργάζεται, κατὰ δὲ τὴν ἐφ᾿ ἕκαστον αὐτῶν πρὸς ἑαυτὰ ταὐτότητα καὶ κατὰ τὸ ἐν ἑνὶ ἑκάστῳ ὅλην εἶναι τὸ διωρισμένον ἀπογεννᾷ.", "seq": 2262}
{"id": "Simplicius_Passim_2263", "series": "CAG", "text": "καὶ κατὰ μὲν τὴν ἐν ἀλλήλοις ἕνωσιν τῶν νοητῶν ποσῶν τὸ συνεχές, κατὰ δὲ τὴν διακεκριμένην αὐτῶν ἀπ᾿ ἀλλήλων ἕνωσιν τὸ διωρισμένον ὑφίστησιν.", "seq": 2263}
{"id": "Simplicius_Passim_2264", "series": "CAG", "text": "καὶ κατὰ μὲν τὴν ἑστῶσαν αὐτοῦ ἐνέργειαν τὸ διωρισμένον, κατὰ δὲ τὴν προϊοῦσαν τὸ συνεχὲς δημιουργεῖ·", "seq": 2264}
{"id": "Simplicius_Passim_2265", "series": "CAG", "text": "ἐπεὶ δὲ ἅμα καὶ μένει καὶ πρόεισιν, τὰ δύο ἀπογεννᾷ.", "seq": 2265}
{"id": "Simplicius_Passim_2266", "series": "CAG", "text": "περιέχει γὰρ ἡ τῶν νοητῶν μέτρων δύναμις ἅμα ἀμφότερα τὰ μένοντα καὶ προϊόντα ἐν ἑνὶ τῷ αὐτῷ·", "seq": 2266}
{"id": "Simplicius_Passim_2267", "series": "CAG", "text": "ὅθεν δή, εἴ τις τοῖς νοητοῖς καὶ θείοις μέτροις τὰ ἕτερα τούτων νέμει, εἰ μὲν τὰ ἀκίνητα μόνα, ὑπὸ Περιπατητικῶν παρακρουσμάτων ἐξηπάτηται, εἰ δὲ τὰ προϊόντα, ὑπὸ Στωικῶν.”", "seq": 2267}
{"id": "Simplicius_Passim_2268", "series": "CAG", "text": "5a15 Ἔτι τὰ μὲν ἐκ θέσιν ἐχόντων πρὸς ἄλληλα ἕως τοῦ τῶν δὲ ἄλλων οὐδὲν αὐτὸ καθ᾿ ἑαυτό, ἀλλ᾿ ἢ ἄρα κατὰ συμβεβηκός.", "seq": 2268}
{"id": "Simplicius_Passim_2269", "series": "CAG", "text": "Μετὰ τὴν πρώτην τοῦ ποσοῦ διαίρεσιν καὶ ἑτέραν ἐπάγει, καθ᾿ ἣν τὰ μὲν ἐκ θέσιν ἐχόντων πρὸς ἄλληλα τῶν ἐν αὐτοῖς μορίων συνέστηκεν, τὰ δὲ οὐκ ἐξ ἐχόντων θέσιν.", "seq": 2269}
{"id": "Simplicius_Passim_2270", "series": "CAG", "text": "ἐδεήθη δὲ καὶ ταύτης διὰ τὸ μίαν μὴ ἐπιδέχεσθαι τὰς ὅλας διαφοράς.", "seq": 2270}
{"id": "Simplicius_Passim_2271", "series": "CAG", "text": "καὶ γὰρ πᾶν μὲν τὸ ἐκ θέσιν ἐχόντων συνεχές ἐστιν, οὐκέτι δὲ τὸ συνεχὲς πᾶν ἐκ θέσιν ἐχόντων·", "seq": 2271}
{"id": "Simplicius_Passim_2272", "series": "CAG", "text": "ὁ γὰρ χρόνος οὐκ ἔχει θέσιν.", "seq": 2272}
{"id": "Simplicius_Passim_2273", "series": "CAG", "text": "ἀνάπαλιν δὲ πᾶν μὲν τὸ διωρισμένον οὐκ ἔχει θέσιν, οὐκέτι δὲ πᾶν τὸ μὴ ἔχον θέσιν διωρισμένον ἐστίν·", "seq": 2273}
{"id": "Simplicius_Passim_2274", "series": "CAG", "text": "πάλιν γὰρ ὁ χρόνος μὴ ἔχων θέσιν διωρισμένος οὐκ ἔστιν.", "seq": 2274}
{"id": "Simplicius_Passim_2275", "series": "CAG", "text": "παρείληπται οὖν καὶ ἡ δευτέρα διαίρεσις, ὥστε τὰς ὑπὸ τῆς προτέρας παραλειφθείσας διαφορὰς προστεθῆναι, καὶ καλεῖται ἡ τοιαύτη ἐπιδιαίρεσις, δευτέρα τις οὖσα τοῦ αὐτοῦ γένους διαίρεσις καθ᾿ ἑτέρας διαφοράς.", "seq": 2275}
{"id": "Simplicius_Passim_2276", "series": "CAG", "text": "ὡς γὰρ ἐπὶ τοῦ ζῴου ἡ τὸ θνητὸν καὶ ἀθάνατον διαιροῦσα οὐκ ἐπεδέχετο τὰς κατὰ τὸ λογικὸν καὶ ἄλογον οὐδὲ ἐκεῖναι ταύτας, καὶ διὰ τοῦτο ἐδέησεν ἐπιδιαιρέσεως, οὕτως καὶ ἐνταῦθα, ἵνα πάσας περιλάβῃ τὰς ὑπὸ τὸ ποσὸν διαφοράς, ταῖς δύο ἐχρήσατο διαιρέσεσιν.", "seq": 2276}
{"id": "Simplicius_Passim_2277", "series": "CAG", "text": "Ζητεῖν δὲ ἄξιον, τί τὸ θέσιν ἔχον.", "seq": 2277}
{"id": "Simplicius_Passim_2278", "series": "CAG", "text": "ἆρα, ὥς τινες οἴονται, τριῶν τούτων δεῖται τὸ θέσιν ἔχον, τοῦ τε τόπου ἐν ᾧ κεῖται καὶ τοῦ τὰ μόρια συνυπάρχειν, ἀλλὰ μὴ τῶν ἑτέρων γινομένων τὰ ἕτερα ἀφανίζεσθαι, καὶ τοῦ συνέχειαν καὶ ἀλληλουχίαν ἔχειν πρὸς ἄλληλα;", "seq": 2278}
{"id": "Simplicius_Passim_2279", "series": "CAG", "text": "ἢ τὸ μὲν συνυπάρχειν ἀλλήλοις τὰ μόρια πάντως προσεῖναι δεῖ τοῖς θέσιν ἔχουσιν, τὸ δὲ ἐν τόπῳ εἶναι οὐ πάντως οὔτε κατὰ τὴν φύσιν τῶν πραγμάτων οὔτε κατὰ τὴν τοῦ Ἀριστοτέλους παράδοσιν.", "seq": 2279}
{"id": "Simplicius_Passim_2280", "series": "CAG", "text": "τὰ γὰρ μὴ διεστηκότα πλεοναχῶς, οἷον ἡ γραμμή, ἐν τόπῳ μὲν οὐκ ἔστιν, ὥστε οὐδὲ ἐν τόπῳ τεθήσεται, θέσιν δὲ ἔχειν λέγεται.", "seq": 2280}
{"id": "Simplicius_Passim_2281", "series": "CAG", "text": "καὶ ὁ Ἀριστοτέλης δὲ οὐχ ἁπλῶς εἶπεν θέσιν ἔχοντα αὐτὰ ἐν τόπῳ, ἀλλὰ πρὸς ἄλληλα τῶν ἐν ἑαυτοῖς μορίων·", "seq": 2281}
{"id": "Simplicius_Passim_2282", "series": "CAG", "text": "τοῦτο δέ ἐστιν, ὥς φησιν Ἰάμβλιχος, ὧν τὰ μόρια πάντα συνυπάρχει ἀλλήλοις, καὶ τῇ τούτων ἀθρόᾳ λήψει τῷ ὅλῳ τῷ ἐξ αὐτῶν τὸ εἶναι ὑπάρχει.", "seq": 2282}
{"id": "Simplicius_Passim_2283", "series": "CAG", "text": "διὰ γὰρ τοῦ πρὸς ἄλληλα εἰπεῖν δείκνυσιν ὅτι οὐ τὴν κατὰ τόπον θέσιν λέγει, ἀλλὰ τὴν κατὰ σχέσιν, ἀντιδιαστέλλων ταῦτα τοῖς πρὸς τῷ γίνεσθαι τὸ εἶναι ἔχουσιν, ὧν τὰ μόρια οὐδέποτε ὑπομένει.", "seq": 2283}
{"id": "Simplicius_Passim_2284", "series": "CAG", "text": "κυρίως μὲν γὰρ θέσις ἐπὶ τῶν ἐν τόπῳ λέγεται, ἤδη δὲ καὶ ἐφ᾿ ἑκάστου τῶν ποσῶν, ὧν τὰ μόρια συνυπάρχει, κεῖσθαι ἐν ἐκείνῳ ἐν ᾧ ἐστι λέγεται, ὥσπερ γραμμὴ ἐν τῇ ἐπιφανείᾳ καὶ ἐπιφάνεια ἐν τῷ σώματι·", "seq": 2284}
{"id": "Simplicius_Passim_2285", "series": "CAG", "text": "καὶ τὸ σημεῖον γάρ, ὅταν μονάδα θέσιν ἔχουσαν λέγωσιν, οὐχ ὡς ἐν τόπῳ κεῖται, ἀλλ᾿ ὡς ἐν γραμμῇ.", "seq": 2285}
{"id": "Simplicius_Passim_2286", "series": "CAG", "text": "ἕκαστον οὖν τῶν συνεχῶν ποσῶν, ὡς ἔχει φύσεως, οὕτως ἔχει καὶ τὴν οἰκείαν θέσιν·", "seq": 2286}
{"id": "Simplicius_Passim_2287", "series": "CAG", "text": "τὸ μὲν σῶμα, ἐπειδὴ ἐν τόπῳ ἐστίν, ἐν τόπῳ καὶ τὴν θέσιν ἔχει, ἡ δὲ ἐπιφάνεια ἐν τῷ σώματι, ἡ δὲ γραμμὴ ἐν τῇ ἐπιφανείᾳ, τὸ δὲ σημεῖον ἐν τῇ γραμμῇ·", "seq": 2287}
{"id": "Simplicius_Passim_2288", "series": "CAG", "text": "καὶ γὰρ σαφῶς καὶ Ἀριστοτέλης εἶπεν ὅτι τὰ τῆς γραμμῆς μόρια ἐν τῷ ἐπιπέδῳ κεῖται.", "seq": 2288}
{"id": "Simplicius_Passim_2289", "series": "CAG", "text": "καὶ ὅλως, εἰ τὰ θέσιν ἔχοντα ἐν τόπῳ τὴν θέσιν ἔχειν ἐβούλετο, οὐκ ἂν καὶ τὰ τοῦ τόπου μόρια ἔλεγε θέσιν ἔχειν·", "seq": 2289}
{"id": "Simplicius_Passim_2290", "series": "CAG", "text": "οὐ γὰρ ἂν εἴη ὁ τόπος ἐν τόπῳ, ἵνα μὴ ἐπ᾿ ἄπειρον τόπους πρὸ τόπων ζητῶμεν, ἀλλ᾿ ὡς ἐπιφάνεια ὢν ὁ τόπος ἐν τῷ σώματι τὴν θέσιν ἔχει, οὗ πέρας ἐστὶν ὡς ἐπιφάνεια.", "seq": 2290}
{"id": "Simplicius_Passim_2291", "series": "CAG", "text": "καὶ αὐτὸς δὲ Ἀριστοτέλης ‘ὡς τὸ εἶναι, φησίν, ἔχει τὰ μαθηματικά, οὕτως καὶ τὸ κεῖσθαί που’.", "seq": 2291}
{"id": "Simplicius_Passim_2292", "series": "CAG", "text": "θαυμάσοι δ᾿ ἄν τις τοῦ θείου Ἰαμβλίχου ταῦτα περὶ τόπου γράφοντος·", "seq": 2292}
{"id": "Simplicius_Passim_2293", "series": "CAG", "text": "“ὁ δὲ τόπος ὡς μὲν ἐπιφάνεια εἴη ἂν ἐν τῷ σώματι, οὗ πέρας οὖσα περιέχει τὸ σῶμα, ὡς δὲ τόπος ἐν τῷ περιεχομένῳ ὑπ᾿ αὐτοῦ·", "seq": 2293}
{"id": "Simplicius_Passim_2294", "series": "CAG", "text": "δι᾿ ὃ γὰρ τὸ εἶναι αὐτῷ τόπῳ ὑπάρχει, ἐν τούτῳ [γὰρ] καὶ κεῖσθαι λέγοιτο”.", "seq": 2294}
{"id": "Simplicius_Passim_2295", "series": "CAG", "text": "τὸ γὰρ τὸν τόπον ἐν τόπῳ εἶναι καὶ τὸ ἀγγεῖον ἐν τῷ οἴνῳ (καὶ τοῦτο γὰρ κατὰ τὴν αὐτὴν ἀναλογίαν ἀκολουθήσει) πῶς οὐ δόξει τῶν ἀπεμφαινόντων;", "seq": 2295}
{"id": "Simplicius_Passim_2296", "series": "CAG", "text": "προϊὼν δὲ “μήποτε, φησί, κατὰ συμβεβηκὸς ὁ τόπος θέσιν ἔχει τῷ τὸ σῶμα τὸ κατέχον αὐτὸν θέσιν ἔχειν·", "seq": 2296}
{"id": "Simplicius_Passim_2297", "series": "CAG", "text": "καὶ ἡ ἐπιφάνεια δὲ κατὰ συμβεβηκός ἐστιν ἐν τόπῳ”.", "seq": 2297}
{"id": "Simplicius_Passim_2298", "series": "CAG", "text": "ταὐτὸν δὲ τόπος καὶ ἐπιφάνεια κατὰ τὸ ὑποκείμενον, καὶ ἄμεινον κατὰ τὴν Ἀριστοτελικὴν περὶ τοῦ τόπου ἔννοιαν οὕτως ἀκούειν.", "seq": 2298}
{"id": "Simplicius_Passim_2299", "series": "CAG", "text": "ἀλλ᾿ εἴ τις διάστημα λέγει τὸν τόπον ἀεὶ μὲν ἔχον σῶμα, αὐτὸ δὲ τὸ καθ᾿ αὑτὸ κενὸν σώματος καὶ ἄλλο παρὰ τὸ σῶμα θεωρούμενον, ἆρα οὐκ ἂν καὶ τοῦτο ἐκ θέσιν ἐχόντων τῶν ἑαυτοῦ μορίων λέγοιτο, συνεχές τε ὂν καὶ συνυπάρχοντα ἔχον τὰ μόρια ἀλλήλοις;", "seq": 2299}
{"id": "Simplicius_Passim_2300", "series": "CAG", "text": "καὶ ποῦ ἂν κέοιτο;", "seq": 2300}
{"id": "Simplicius_Passim_2301", "series": "CAG", "text": "οὐδὲ γὰρ πέρας ἐστί τινος τοῦτο.", "seq": 2301}
{"id": "Simplicius_Passim_2302", "series": "CAG", "text": "μήποτε οὖν ὅπερ ἡ τάξις ἐστὶν ἐν τοῖς διωρισμένοις, τοῦτο ἡ θέσις ἐν τοῖς συνεχέσιν·", "seq": 2302}
{"id": "Simplicius_Passim_2303", "series": "CAG", "text": "ὥσπερ γὰρ τὰ διωρισμένα διὰ τὴν ἀπὸ τοῦ ἑνὸς ἔκστασιν ἐδεήθη τάξεως, ἵνα κατὰ ταύτην πρὸς τῷ ἑνὶ μένῃ καὶ μὴ ἀτάκτως διεσπασμένα συγχέηται, οὕτως καὶ τὰ συνεχῆ τοῦ ἀμεροῦς ἐκπεσόντα, ἐν ᾧ πάντα ἐν ταὐτῷ ἦν, ἐδεήθη θέσεως καθ᾿ ἣν ἄλλα ἄλλοις συνάπτει μόρια κατὰ τὴν τοῦ εἴδους ἐπιπρέπειαν, ἵνα μὴ συμπεφυρμένα ᾖ.", "seq": 2303}
{"id": "Simplicius_Passim_2304", "series": "CAG", "text": "καὶ κατά γε ταύτην τὴν ἔννοιαν οὐκ ἀναγκαῖόν που κεῖσθαι τὰ κείμενα ὡς ἐν ἄλλῳ·", "seq": 2304}
{"id": "Simplicius_Passim_2305", "series": "CAG", "text": "ἡ γὰρ θέσις παρὰ τὸ θεῖν οἶμαι καὶ ἴεσθαι λεγομένη τὴν ἔκτασιν σημαίνει.", "seq": 2305}
{"id": "Simplicius_Passim_2306", "series": "CAG", "text": "ἀλλὰ ταῦτα μὲν περὶ τῶν θέσιν ἐχόντων.", "seq": 2306}
{"id": "Simplicius_Passim_2307", "series": "CAG", "text": "Τὰ δὲ μὴ ἔχοντα θέσιν ἀπαριθμούμενος πρῶτον ἔταξε τὸν λόγον καί φησιν αὐτὸν μήτε κεῖσθαί που μήτε τὰ μόρια θέσιν ἔχειν πρὸς ἄλληλα.", "seq": 2307}
{"id": "Simplicius_Passim_2308", "series": "CAG", "text": "εἰ γὰρ ὑπομένειν δεῖ τὰ θέσιν ἔχοντα, ὁ δὲ λόγος ἅμα τε εἴρηται καὶ οὐκ ἔτι ἔστιν, πῶς ἂν ἔχοι θέσιν;", "seq": 2308}
{"id": "Simplicius_Passim_2309", "series": "CAG", "text": "καὶ ἐπὶ τοῦ χρόνου δὲ τὸ αὐτὸ ἀξιοῖ, ἀφ᾿ οὗ καὶ σαφῶς ἐνεδείξατο ὅτι δεῖ τοῖς θέσιν ἔχουσιν προσεῖναι τὸ ὑπομένειν τὰ μόρια·", "seq": 2309}
{"id": "Simplicius_Passim_2310", "series": "CAG", "text": "ὃ γὰρ μή ἐστι, φησίν, ὑπομένον, πῶς ἂν τοῦτο θέσιν τινὰ ἔχοι;", "seq": 2310}
{"id": "Simplicius_Passim_2311", "series": "CAG", "text": "τάξιν δὲ ἔχειν ταῦτα λέγεται, καθ᾿ ὅσον τοῦ τε λόγου ἡ μὲν προτέρα συλλαβὴ λέγεται, ἡ δὲ ὑστέρα, καὶ τοῦ χρόνου τὸ μὲν πρότερον γίνεται μέρος, τὸ δὲ ὕστερον.", "seq": 2311}
{"id": "Simplicius_Passim_2312", "series": "CAG", "text": "διὸ καίτοι συνεχὴς ὢν ὁ χρόνος θέσιν οὐ λέγεται ἔχειν·", "seq": 2312}
{"id": "Simplicius_Passim_2313", "series": "CAG", "text": "ἐπειδὴ γὰρ συνακολουθεῖ τῇ κινήσει, πᾶσα δὲ κίνησις ἐν τῷ γίνεσθαι ἔχει τὸ εἶναι, καὶ ὁ χρόνος τὸ αὐτὸ πάσχει, καὶ διὰ τοῦτο καίτοι συνεχὴς ὢν οὐκ ἔχει θέσιν, ὅτι οὐχ ὑπομένει αὐτοῦ τὰ μόρια.", "seq": 2313}
{"id": "Simplicius_Passim_2314", "series": "CAG", "text": "Ἀλλὰ διὰ τί ὁ ἀριθμὸς οὐκ ἔχει θέσιν;", "seq": 2314}
{"id": "Simplicius_Passim_2315", "series": "CAG", "text": "ὑπομένειν γὰρ αὐτοῦ δοκεῖ τὰ μόρια.", "seq": 2315}
{"id": "Simplicius_Passim_2316", "series": "CAG", "text": "“ὅτι, φησὶν ὁ Ἰάμβλιχος, ἡ μονὰς σημεῖον ἄθετόν ἐστιν, ὁ δὲ ἀριθμὸς ἐκ μονάδων συνέστηκεν, καὶ ὅτι οὐδὲ τὰ μόρια ὑπομένει·", "seq": 2316}
{"id": "Simplicius_Passim_2317", "series": "CAG", "text": "οὐδὲ γὰρ εἰ ἔστιν τὰ διηριθμημένα, ἔστιν που ὁ ἀριθμός, ἐπεὶ οὐδὲ ὁ λόγος ἔστιν που, ὅτι ἔστιν τὰ ὑπ᾿ αὐτοῦ λεγόμενα.", "seq": 2317}
{"id": "Simplicius_Passim_2318", "series": "CAG", "text": "ὡς δὲ ὁ λόγος ἐν τῷ λέγεσθαι, οὕτως καὶ ὁ ἀριθμὸς ἐν τῷ ἀριθμεῖσθαι ὑφέστηκεν, καὶ διὰ τοῦτο οὐχ ὑπομένει οὐδετέρου τὰ μόρια, ὥστε οὐκ ἔχουσιν θέσιν”.", "seq": 2318}
{"id": "Simplicius_Passim_2319", "series": "CAG", "text": "ταῦτα μὲν ὁ θεῖός φησιν Ἰάμβλιχος.", "seq": 2319}
{"id": "Simplicius_Passim_2320", "series": "CAG", "text": "θαυμάζω δέ, εἰ ὁ ἀριθμὸς διὰ τὸ μὴ ὑπομένειν τὰ μόρια λέγεται μὴ ἔχειν θέσιν·", "seq": 2320}
{"id": "Simplicius_Passim_2321", "series": "CAG", "text": "οὐ γὰρ ὡς ὁ λόγος ἐν τῷ λέγεσθαι ἔχει τὸ εἶναι, οὕτως καὶ ὁ ἀριθμὸς ἐν τῷ ἀριθμεῖσθαι·", "seq": 2321}
{"id": "Simplicius_Passim_2322", "series": "CAG", "text": "κἂν γὰρ μὴ ἀριθμῆται τοὺς πέντε μου δακτύλους, ἠρίθμηνται κατὰ τὸ ἑαυτῶν εἶδος.", "seq": 2322}
{"id": "Simplicius_Passim_2323", "series": "CAG", "text": "ἀλλὰ μᾶλλον διὰ τὸ μὴ συνεχὴς εἶναι·", "seq": 2323}
{"id": "Simplicius_Passim_2324", "series": "CAG", "text": "δεῖ γὰρ καὶ συνεχῆ εἶναι καὶ ἐκτετάσθαι τὰ θέσιν ἔχοντα·", "seq": 2324}
{"id": "Simplicius_Passim_2325", "series": "CAG", "text": "οὕτως γὰρ καὶ ἡ πρὸς ἄλληλα τῶν μορίων θέσις ὁραθήσεται, τίνα τίσιν τῶν μορίων συνάπτεται.", "seq": 2325}
{"id": "Simplicius_Passim_2326", "series": "CAG", "text": "ἐν γὰρ τῇ τριάδι ποία μονὰς πρὸς ποίαν σύγκειται, οὐκ ἔστιν εἰπεῖν, ὥσπερ ἐπὶ τῆς γραμμῆς ποῖον μόριον ποίῳ συνάπτει, ἐναργές ἐστιν ἰδεῖν.", "seq": 2326}
{"id": "Simplicius_Passim_2327", "series": "CAG", "text": "Διὰ τί δὲ οὐχ ὡς ἐπὶ τοῦ λόγου καὶ ἐπὶ τοῦ χρόνου σαφῶς ἀνεῖλεν τὸ θέσιν ἔχειν, οὕτως καὶ ἐπὶ τοῦ ἀριθμοῦ, ἀλλ᾿ ὅτι θέσιν οὐ πάνυ λάβοις ἂν αὐτοῦ;", "seq": 2327}
{"id": "Simplicius_Passim_2328", "series": "CAG", "text": "ἢ ὡς οἱ ἐξηγηταί φασιν, ὅτι δοκεῖ καὶ ὁ ἀριθμὸς ἐπιδέχεσθαι θέσιν διὰ τὰ ἀριθμούμενα.", "seq": 2328}
{"id": "Simplicius_Passim_2329", "series": "CAG", "text": "μήποτε δὲ χαρακτηριστικοῦ ὄντος τῶν θέσιν ἐχόντων μάλιστα τοῦ τὰ μόρια ὑπομένειν, ὁ μὲν λόγος καὶ ὁ χρόνος οὐκ ἔχει τοῦτο, ὁ δὲ ἀριθμὸς ἔχει, καὶ εἴπερ εἶχεν τὴν συνέχειαν, ἦν ἂν τῶν θέσιν ἐχόντων.", "seq": 2329}
{"id": "Simplicius_Passim_2330", "series": "CAG", "text": "κἂν θέσιν δὲ μὴ ἔχῃ ὅ τε λόγος καὶ ὁ χρόνος καὶ ὁ ἀριθμός, ἀλλὰ τάξιν ἔχει, ὡς εἴρηται, ταῦτα ἀντὶ τῆς θέσεως.", "seq": 2330}
{"id": "Simplicius_Passim_2331", "series": "CAG", "text": "ἡ δὲ τάξις κυρίως μὲν ὡς ἐπὶ διωρισμένων θεωρεῖται κατὰ τὸ πρότερον καὶ ὕστερον λαμβανομένη, καὶ ἐπὶ τοῦ χρόνου δέ, καθ᾿ ὅσον προηγεῖται τὸ παρεληλυθὸς τοῦ ἐνεστῶτος καὶ τοῦτο τοῦ μέλλοντος, ὥστε καὶ ἐπὶ τούτου κατὰ τὸν διορισμὸν ἡ τάξις ἔοικεν θεωρεῖσθαι.", "seq": 2331}
{"id": "Simplicius_Passim_2332", "series": "CAG", "text": "ἐν δὲ τῷ ἀριθμῷ ἡ τάξις οὐκ ἐν ἑκάστῳ·", "seq": 2332}
{"id": "Simplicius_Passim_2333", "series": "CAG", "text": "οὐ γὰρ ἔστιν ἐν τῇ τριάδι τάξις τῶν μονάδων, ἀλλ᾿ ἐν τῷ χύματι τῶν ἀριθμῶν, ὅτι ἡ μονὰς προηγεῖται τῆς δυάδος καὶ ἡ δυὰς τῆς τριάδος καὶ ἐφεξῆς.", "seq": 2333}
{"id": "Simplicius_Passim_2334", "series": "CAG", "text": "ἐν δὲ τῷ λόγῳ ἡ τάξις, καθ᾿ ὅσον ἄλλα μέρη τοῦ λόγου ἄλλων προηγεῖται καὶ ἄλλαι συλλαβαὶ ἄλλων.", "seq": 2334}
{"id": "Simplicius_Passim_2335", "series": "CAG", "text": "κἀνταῦθα δὲ ἀπορῶ, πῶς ὁ θεῖος Ἰάμβλιχος περὶ τοῦ λόγου φησὶν ὅτι δοκεῖ μήτε τάξιν ἐμφαίνειν, εἴ τις αὐτοῦ τὸ μῆκος μόνον καὶ τὴν διέξοδον τῆς φωνῆς θεωροίη, κἂν ᾖ ἄσημος.", "seq": 2335}
{"id": "Simplicius_Passim_2336", "series": "CAG", "text": "τί γὰρ μᾶλλον ἡ ἑτέρα συλλαβὴ τῆς ἑτέρας προτέτακται;", "seq": 2336}
{"id": "Simplicius_Passim_2337", "series": "CAG", "text": "παντὶ γὰρ δῆλον ὅτι ἔστιν τάξις ἐν τῷ λόγῳ, καὶ οὐκ ἄν τις τὸ Σωκράτης ὄνομα εἴποι τὴν κρα συλλαβὴν πρώτην προενεγκάμενος.", "seq": 2337}
{"id": "Simplicius_Passim_2338", "series": "CAG", "text": "θεωρητικῶς δὲ τοῖς θέσιν ἔχουσιν ποσοῖς ἐπιβάλλων “τοῦτο, φησίν, τὸ γένος ἕδραν παρέχεται πᾶσιν ὅσα ποτέ ἐστιν ποσά, τοῖς τε ἁπλουστέροις ἐν τοῖς συνθέτοις καὶ τούτοις ἐν τοῖς ἁπλοῖς·", "seq": 2338}
{"id": "Simplicius_Passim_2339", "series": "CAG", "text": "διχῶς γὰρ τοῦ ἁπλοῦ λαμβανομένου τὸ μὲν ὡς συνταττόμενον τοῖς συνθέτοις καὶ περιεχόμενον ὑπ᾿ αὐτῶν, ὡς ἡ ἐπιφάνεια ὑπὸ τοῦ σώματος, θέσιν ἔχει ἐν ** τῷ σώματι, τὸ δὲ ὡς ὑπερέχον καὶ ἐξῃρημένον ἕδραν ἐν ἑαυτῷ παρέξει τοῖς συνθέτοις·", "seq": 2339}
{"id": "Simplicius_Passim_2340", "series": "CAG", "text": "προσδεόμεθα οὖν τῆς θέσεως, ἵνα τὴν πρὸς τὰ δεύτερα ποσὰ συνέχειαν νοήσωμεν”.", "seq": 2340}
{"id": "Simplicius_Passim_2341", "series": "CAG", "text": "Ἐπιστῆσαι δὲ ἄξιον, ὅτι κατὰ μὲν τὴν πρώτην διαίρεσιν πέντε μὲν ἦν συνεχῆ, δύο δὲ διωρισμένα·", "seq": 2341}
{"id": "Simplicius_Passim_2342", "series": "CAG", "text": "κατὰ δὲ τὴν δευτέραν τέτταρα μὲν τὰ θέσιν ἔχοντα, γραμμή, ἐπιφάνεια, σῶμα, τόπος, τρία δὲ τὰ μὴ ἔχοντα, ἀριθμός, χρόνος, λόγος, ὧν δύο μέν, φησὶν Ἰάμβλιχος, τάξιν ἔχει, ἀριθμὸς καὶ χρόνος·", "seq": 2342}
{"id": "Simplicius_Passim_2343", "series": "CAG", "text": "λόγος δὲ πῶς μὲν ἔχει τάξιν, πῶς δὲ οὐκ ἔχει, φησίν, ὡς ἐν τοῖς πρὸ τούτων διώρισται, ὥστε καὶ ἄλλη τρίτη γέγονεν διαίρεσις, καθ᾿ ἣν τῶν ποσῶν τὰ μὲν ἔχει τάξιν, τὰ δὲ οὐκ ἔχει.", "seq": 2343}
{"id": "Simplicius_Passim_2344", "series": "CAG", "text": "καὶ ἄλλην δὲ τετάρτην ἐφεξῆς προστίθησιν διαίρεσιν, καθ᾿ ἣν τῶν ποσῶν τὰ μέν ἐστι προηγουμένως ποσά, ὅσα καθ᾿ αὑτά ἐστιν τοιαῦτα, ὡς ἀριθμὸς καὶ μέγεθος καὶ χρόνος καὶ τὰ τοιαῦτα, ὧν τὸ ποσὸν ἐν τῷ τί ἐστιν κατηγορεῖται·", "seq": 2344}
{"id": "Simplicius_Passim_2345", "series": "CAG", "text": "τὰ δὲ κατὰ συμβεβηκός, ὅσα κατ᾿ ἄλλο τι ποσὰ εἶναι λέγεται, οἷον τὸ λευκὸν πολὺ λέγεται ἢ μέγα, οὐ καθὸ λευκόν, ἀλλὰ κατὰ τὴν ἐπιφάνειαν, καὶ ὁ ἄνθρωπος μακρὸς κατὰ τὸ μῆκος, καὶ ἡ κίνησις δὲ πολλὴ ἢ διὰ τὸν χρόνον ἢ διὰ τὸν τόπον·", "seq": 2345}
{"id": "Simplicius_Passim_2346", "series": "CAG", "text": "ἐὰν γὰρ ἀποδιδῷ τις τὸ ποσὸν αὐτῆς, ἢ ἐνιαυσιαίαν λέγων κατὰ τὸν χρόνον ἀποδώσει ἢ σταδιαίαν κατὰ τὸν τόπον.", "seq": 2346}
{"id": "Simplicius_Passim_2347", "series": "CAG", "text": "δοκεῖ οὖν κατὰ ταῦτα καὶ ἡ κίνησις μετέχειν τοῦ ποσοῦ, ἀλλ᾿ οὐκ εἶναι ποσόν.", "seq": 2347}
{"id": "Simplicius_Passim_2348", "series": "CAG", "text": "Καὶ ἔοικεν πολλή τις ἀμφιβολία γεγονέναι περὶ τὴν κίνησιν, εἴπερ οἱ μὲν ὑπὸ τὸ πρός τι αὐτὴν ἀνάγεσθαί φασιν, οἱ δὲ ὑπὸ πλείονας κατηγορίας ἐν αἷς θεωρεῖται (καὶ γὰρ ἐν ποσῷ κίνησις, ὡς αὔξησις καὶ μείωσις, καὶ ἐν ποιῷ, ὡς ἀλλοίωσις, καὶ κατὰ τόπον ἄλλη, καὶ δὴ καὶ κατ᾿ οὐσίαν)·", "seq": 2348}
{"id": "Simplicius_Passim_2349", "series": "CAG", "text": "ἄλλοι δέ τινες τὸ δυνάμει καὶ ἐνεργείᾳ κοινῶς ἐπὶ πάντων τῶν γενῶν θεωροῦντες τὴν κίνησιν ἐντελέχειαν οὖσαν τοῦ κινητοῦ, ᾗ κινητόν, κατὰ τὴν Ἀριστοτέλους ἀπόδοσιν, κοινὴν εἶναι τῶν δέκα γενῶν φασιν·", "seq": 2349}
{"id": "Simplicius_Passim_2350", "series": "CAG", "text": "οἱ δὲ ἐν τῷ ποιεῖν καὶ πάσχειν αὐτὴν κατατάττουσιν·", "seq": 2350}
{"id": "Simplicius_Passim_2351", "series": "CAG", "text": "Πλωτῖνος δὲ αὐτὴν καθ᾿ αὑτὴν πρὸ τοῦ ποιεῖν καὶ πάσχειν ὡς γένος ἴδιον τὴν κίνησιν ἀφωρίσατο·", "seq": 2351}
{"id": "Simplicius_Passim_2352", "series": "CAG", "text": "ὁ μέντοι Ἰάμβλιχος ποσὸν αὐτὴν εἶναι βούλεται·", "seq": 2352}
{"id": "Simplicius_Passim_2353", "series": "CAG", "text": "“εἰ γὰρ τὸ εἶναι αὐτῇ κινήσει ἐκ διαστημάτων ὑφέστηκεν καὶ ἐν διαστήματι, φησίν, αὐτὴ καθ᾿ αὑτὴν ἔχει τὴν διέξοδον, ποσὴ ἂν εἴη δι᾿ ἑαυτήν, ἐπεὶ καὶ ὁ λόγος ποσὸς θεωρεῖται, ὅτι ἐκ διαστημάτων ποσῶν τοσόσδε ὑφέστηκεν καὶ καταμετρεῖται τῷ τοσῷδε μήκει καὶ ἔστιν μετρητός”.", "seq": 2353}
{"id": "Simplicius_Passim_2354", "series": "CAG", "text": "καὶ θαυμαστὸν οὐδὲν κατὰ μὲν τὸ διάστημα ποσὸν εἶναι τὴν κίνησιν, κατὰ δὲ τὴν ἐκ τοῦ δυνάμει εἰς τὸ ἐνεργείᾳ μεταβολὴν ἐν πάσαις θεωρεῖσθαι ταῖς κατηγορίαις καὶ κατ᾿ ἄλλην καὶ ἄλλην ἑαυτῆς φύσιν ἄλλως καὶ ἄλλως θεωρεῖσθαι.", "seq": 2354}
{"id": "Simplicius_Passim_2355", "series": "CAG", "text": "μήποτε δὲ καὶ τὸ λευκὸν οὐ κατὰ τὴν ἐπιφάνειαν διέστηκεν ἁπλῶς, ἀλλ᾿ ἔχει ἰδίαν διάστασιν τὸ ἐν γενέσει λευκὸν τὴν συνεκτεινομένην τῇ ἐπιφανείᾳ ἄλλῃ οὔσῃ παρὰ τὸ λευκόν, ὥσπερ καὶ ἡ κίνησις ἐλέγετο διάστασιν ἔχειν ἰδίαν ἄλλην παρὰ τὸν χρόνον καὶ τὸν τόπον·", "seq": 2355}
{"id": "Simplicius_Passim_2356", "series": "CAG", "text": "καὶ γὰρ αἱ ποιότητες προϊοῦσαι εἰς τὴν γένεσιν οὐ φυλάττουσιν τὴν εἰδητικὴν ἀμέρειαν, ἀλλ᾿ εἰς τὴν γενητὴν διάστασιν ὑποβαίνουσιν καὶ καθ᾿ ἑαυτάς.", "seq": 2356}
{"id": "Simplicius_Passim_2357", "series": "CAG", "text": "Ἀποροῦσι δὲ καὶ πρὸς τὰ ἐνταῦθα λεγόμενα οἱ αὐτοὶ ἄνδρες οὐδὲν ἔχειν θέσιν λέγοντες·", "seq": 2357}
{"id": "Simplicius_Passim_2358", "series": "CAG", "text": "εἰ γὰρ θέσιν ἔχειν ἐκεῖνα λέγεται, ὧν τὰ μόρια ὑπομένει, πάντων δὲ ῥεόντων οὐδὲν ὑπομένοι, οὐδὲ θέσιν ἄν τι κυρίως ἔχοι.", "seq": 2358}
{"id": "Simplicius_Passim_2359", "series": "CAG", "text": "ἢ κἂν ἡ ὕλη ῥέῃ συνεχῶς καὶ τοῦτο δοίη τις καὶ τὰ σώματα ἐπ᾿ ἄπειρον ἔχει προσθήκας καὶ ἀφαιρέσεις, ἀλλ᾿ ὅμως ἔστιν τι καὶ τὸ μένον ἐναργῶς, εἴτε τὸ δεύτερον ὑποκείμενον, ὥς τινες λέγουσιν, εἴτε τὸ ἰδίως ποιόν, ὡς ἄλλοι, εἴτε ἡ κατὰ τὸ εἶδος οὐσία ἢ ἡ ἄτομος καὶ σύνθετος οὐσία ἢ καὶ ἄλλο τι τοιοῦτον, ὃ καὶ ἐν ταῖς μεταβολαῖς ὑπομένει καὶ ἀπ᾿ ἀρχῆς ἄχρι τέλους γνωρίζεται·", "seq": 2359}
{"id": "Simplicius_Passim_2360", "series": "CAG", "text": "περὶ γὰρ τῶν ἐναργῶν ὁ λόγος, ἀλλ᾿ οὐχὶ περὶ τῶν ἀφανῶν καὶ ἀμφισβητουμένων.", "seq": 2360}
{"id": "Simplicius_Passim_2361", "series": "CAG", "text": "δεύτερον δέ, ᾧ λόγῳ, φασίν, τὸ λευκὸν κατὰ συμβεβηκὸς εἶναι ποσὸν [ὡς] ὁ Ἀριστοτέλης λέγει, τῷ τὴν ἐπιφάνειαν ποσὸν εἶναι, τούτῳ τῷ λόγῳ καὶ ἡ ἐπιφάνεια κατὰ συμβεβηκὸς ἔσται ποσὸν τῷ πλήθους μετέχειν.", "seq": 2361}
{"id": "Simplicius_Passim_2362", "series": "CAG", "text": "ἀλλ᾿ ὑπομνηστέον τῶν ἔμπροσθεν εἰρημένων ἐν οἷς ἐλέγομεν ἄλλο μὲν εἶδος εἶναι τοῦ ποσοῦ τὸ κατὰ τὸ πλῆθος, ἄλλο δὲ τὸ κατὰ τὸ μέγεθος ἴδιον ποσὸν καὶ ἀντιθέτως ἔχον πρὸς τὸ κατὰ τὸ πλῆθος ποσόν.", "seq": 2362}
{"id": "Simplicius_Passim_2363", "series": "CAG", "text": "ἔτι δέ, εἰ τοῖς προηγουμένοις ποσοῖς ἑπτὰ τὸν ἀριθμὸν οὖσιν συνακολουθεῖ τινα ἀόριστα κατηγορήματα, οἷον τῷ μὲν πλήθει τὸ πολὺ καὶ ὀλίγον, τῷ δὲ μεγέθει τὸ μέγα καὶ μικρόν, καὶ ταῦτα κατηγορεῖν εἰώθαμεν οἰκείως μὲν τῶν καθ᾿ αὑτὰ ποσῶν, κατὰ συμβεβηκὸς δὲ τῶν ἄλλων διὰ τὰ προηγούμενα, οἷον διὰ τὴν ἐπιφάνειαν, διὰ τὸν χρόνον, δῆλον ὅτι προηγουμένως ποσὰ δείκνυται ἡ ἐπιφάνεια καὶ ὁ χρόνος, εἴπερ διὰ ταῦτα καὶ τοῖς ἄλλοις συνυπάρχει τὰ παρακολουθοῦντα τῷ ποσῷ.", "seq": 2363}
{"id": "Simplicius_Passim_2364", "series": "CAG", "text": "5b11 Ἔτι τῷ ποσῷ οὐδέν ἐστιν ἐναντίον ἕως τοῦ οὐκ ἔστιν ἄρα τὸ μέγα τῷ μικρῷ ἐναντίον οὐδὲ τὸ πολὺ τῷ ὀλίγῳ.", "seq": 2364}
{"id": "Simplicius_Passim_2365", "series": "CAG", "text": "Ὥσπερ ἐπὶ τῆς οὐσίας μετὰ τὴν διαίρεσιν τῶν εἰδῶν αὐτῆς καὶ τῶν διαφορῶν ἐπὶ τὰ ἴδια αὐτῆς καὶ τὰ παρακολουθοῦντα μεταβέβηκεν, οὕτως καὶ ἐπὶ τοῦ ποσοῦ ποιεῖ.", "seq": 2365}
{"id": "Simplicius_Passim_2366", "series": "CAG", "text": "καὶ πρῶτον τίνα τὰ κοινῇ ὑπάρχοντα τῷ ποσῷ πρὸς ἄλλας κατηγορίας παραδίδωσιν, εἶθ᾿ οὕτως τὰ ἴδια αὐτοῦ θεωρεῖ.", "seq": 2366}
{"id": "Simplicius_Passim_2367", "series": "CAG", "text": "λέγει δὴ οὖν, ὅτι τῷ ποσῷ οὐδέν ἐστιν ἐναντίον.", "seq": 2367}
{"id": "Simplicius_Passim_2368", "series": "CAG", "text": "καὶ κάλλιον ἴσως πρὸ τῆς τῶν Ἀριστοτέλους ἐξεργασίας ἕκαστον τῶν εἰδῶν τοῦ ποσοῦ προχειρισάμενον ἰδεῖν, ὅπως οὐκ ἔχει ἐναντίον καὶ ὅπως τὰ δοκοῦντα εἶναι ἐν ἑκάστῳ εἴδει τοῦ ποσοῦ ἐναντία οὐ καθὸ ποσὸν ὑπάρχει αὐτῷ, ἀλλὰ κατ᾿ ἄλλην κατηγορίαν, ὑφ᾿ ἣν ὑπάγεται.", "seq": 2368}
{"id": "Simplicius_Passim_2369", "series": "CAG", "text": "αὐτίκα ἡ γραμμή, καθ᾿ ὅσον μέν ἐστιν γραμμή, οὐδεμίαν ἔχει ἐναντίωσιν·", "seq": 2369}
{"id": "Simplicius_Passim_2370", "series": "CAG", "text": "καθ᾿ ὅσον δὲ ποιὰ γραμμή, κατὰ τοσοῦτον τὸ εὐθὺ καὶ τὸ κυρτὸν ἔχει περὶ τὴν γραμμὴν θεωρούμενα.", "seq": 2370}
{"id": "Simplicius_Passim_2371", "series": "CAG", "text": "πάλιν ἡ ἐπιφάνεια, καθὸ μὲν διχῇ διέστηκεν, οὐδὲν ἔχει ἐναντίον·", "seq": 2371}
{"id": "Simplicius_Passim_2372", "series": "CAG", "text": "τραχύτης δὲ καὶ λειότης περὶ αὐτὴν οὐχ ᾗ ἐπιφάνεια, ἀλλ᾿ ᾗ τοιάδε ἐπιφάνεια θεωρεῖται κατὰ τὸ ποιὸν αὐτῆς, ὡς λευκὴ καὶ μέλαινα οὐ καθὸ ἐπιφάνεια, ἀλλὰ καθὸ ποιὰ ἐπιφάνεια.", "seq": 2372}
{"id": "Simplicius_Passim_2373", "series": "CAG", "text": "καὶ τὸ σῶμα δὲ καθὸ σῶμα, τουτέστιν καθὸ τρεῖς ἔχει διαστάσεις, οὐδὲν ἔχει ἐναντίον·", "seq": 2373}
{"id": "Simplicius_Passim_2374", "series": "CAG", "text": "τὸ γὰρ ἀσώματον οὐκ ἔστιν τῷ σώματι ἐναντίον, ὡς μὲν ὁ Ἰάμβλιχός φησιν, διότι τὰ ἐναντία ὑπὸ τὸ αὐτὸ γένος ἐστίν, ταῦτα δὲ οὐκ ἔστιν ὑπὸ τὸ αὐτὸ γένος.", "seq": 2374}
{"id": "Simplicius_Passim_2375", "series": "CAG", "text": "μήποτε δὲ γένος μὲν αὐτῶν οὐδὲν κωλύει τὸ αὐτὸ εἶναι τὴν οὐσίαν·", "seq": 2375}
{"id": "Simplicius_Passim_2376", "series": "CAG", "text": "τῆς γὰρ οὐσίας τὸ μὲν σῶμά φαμεν, τὸ δὲ ἀσώματον·", "seq": 2376}
{"id": "Simplicius_Passim_2377", "series": "CAG", "text": "ἀλλὰ τὸ ἀσώματον, εἰ μὲν ἀπόφασιν καὶ στέρησιν σημαίνοι, οὐκ ἂν εἴη ἐναντίον τῷ σώματι·", "seq": 2377}
{"id": "Simplicius_Passim_2378", "series": "CAG", "text": "τὰ γὰρ ἐναντία ἐν καταφάσει·", "seq": 2378}
{"id": "Simplicius_Passim_2379", "series": "CAG", "text": "εἰ δὲ κατάφασιν καὶ αὐτὸ δηλοῖ, ἢ κρεῖττον τοῦ σώματός ἐστιν καὶ αἴτιον τοῦ σώματος ἢ χεῖρον καὶ ἐν τῷ σώματι τὸ εἶναι ἔχον·", "seq": 2379}
{"id": "Simplicius_Passim_2380", "series": "CAG", "text": "ἑκατέρως δὲ οὐκ ἂν εἴη ἐναντία, τὰ γὰρ ἐναντία ἰσοσθενῆ βούλεται εἶναι καὶ ὁμοίως τῷ οἰκείῳ γένει προσεχῆ.", "seq": 2380}
{"id": "Simplicius_Passim_2381", "series": "CAG", "text": "ἀλλ᾿ οὐδὲ τῷ χρόνῳ ἐστίν τι ἐναντίον, καθ᾿ ὅσον ἀφορίζει τῷ οἰκείῳ μέτρῳ τὴν κίνησιν.", "seq": 2381}
{"id": "Simplicius_Passim_2382", "series": "CAG", "text": "εἰ δέ τις τὴν ἡμέραν τῇ νυκτὶ νομίζει ἐναντίον, οὐ καθὸ χρόνος ποιεῖται τὴν ἐναντίωσιν (ὁ γὰρ αὐτός ἐστιν, εἴπερ ὅταν ἀλλαχοῦ ἡμέρα, ἀλλαχοῦ νύξ ἐστιν), ἀλλὰ καθὸ πῇ μὲν πεφώτισται, πῇ δὲ ἐσκίασται ὁ ἀήρ·", "seq": 2382}
{"id": "Simplicius_Passim_2383", "series": "CAG", "text": "καθὸ δὲ τοιοῦτος, οὐ ποσός ἐστιν, ἀλλὰ ποιός.", "seq": 2383}
{"id": "Simplicius_Passim_2384", "series": "CAG", "text": "καὶ τῷ ἀριθμῷ δὲ οὐδέν ἐστιν ἐναντίον·", "seq": 2384}
{"id": "Simplicius_Passim_2385", "series": "CAG", "text": "ἀφώρισται γὰρ καὶ οὐδὲν ἔχει ἐναντίον οἷον τὰ δύο ἢ τρία.", "seq": 2385}
{"id": "Simplicius_Passim_2386", "series": "CAG", "text": "πᾶν γὰρ τὸ ὡρισμένον ἕν τί ἐστιν καὶ κατὰ τοῦτο οὐκ ἐπιδέχεται οὐδεμίαν ὑπεροχὴν καὶ ἔλλειψιν, ὥσπερ τὸ ἴσον·", "seq": 2386}
{"id": "Simplicius_Passim_2387", "series": "CAG", "text": "τὸ δέ γε ἄνισον ἐπιδέχεται τὸ μᾶλλον καὶ τὸ ἧττον, διόπερ ἐστὶν ἀόριστον.", "seq": 2387}
{"id": "Simplicius_Passim_2388", "series": "CAG", "text": "ἀλλὰ τί ἂν λέγοιμεν, εἴ τις τὸ περιττὸν καὶ ἄρτιον ἐναντία λέγοι, τοῦ ἀριθμοῦ δύο εἴδη ταῦτα τιθέμενος, καὶ αὐτοῦ δὲ τοῦ ποσοῦ τὸ μὲν συνεχὲς εἶναι φάσκων, τὸ δὲ διωρισμένον, καὶ ταῦτα ὡς ἐναντία τιθέμενος;", "seq": 2388}
{"id": "Simplicius_Passim_2389", "series": "CAG", "text": "ἢ καὶ ἐπὶ τῆς οὐσίας ἡ εἰς τὰ ἀντικείμενα διαίρεσις·", "seq": 2389}
{"id": "Simplicius_Passim_2390", "series": "CAG", "text": "τοῦ γὰρ ζῴου τὸ μὲν λογικόν, τὸ δὲ ἄλογον ἦν καὶ τὸ μὲν θνητόν, τὸ δὲ ἀθάνατον·", "seq": 2390}
{"id": "Simplicius_Passim_2391", "series": "CAG", "text": "καὶ ὅμως συνεχωροῦμεν τῇ οὐσίᾳ μηδὲν εἶναι ἐναντίον.", "seq": 2391}
{"id": "Simplicius_Passim_2392", "series": "CAG", "text": "ἄλλο γάρ ἐστιν τὸ περὶ τὴν οὐσίαν καὶ περὶ τὸ ποσὸν θεωρεῖν ἐναντίωσιν, κατὰ τὰς περὶ αὐτὰ ποιότητας συμβαῖνον, καὶ ἄλλο τὸ αὐτῇ τῇ οὐσίᾳ ἢ τῇ ποσῷ μὴ εἶναι ἐναντίον.", "seq": 2392}
{"id": "Simplicius_Passim_2393", "series": "CAG", "text": "καὶ ὁ λόγος δέ, καθὸ ποσός ἐστιν, οὐκ ἔχει ἐναντίον·", "seq": 2393}
{"id": "Simplicius_Passim_2394", "series": "CAG", "text": "τὸ γὰρ ἀληθὲς καὶ ψεῦδος ὑπάρχει τῷ λόγῳ, καθὸ σημαντικός ἐστιν, ἀλλ᾿ οὐ καθ᾿ ὅσον ἐν διαστάσει προφέρεται καὶ καταμετρεῖται συλλαβῇ βραχείᾳ καὶ μακρᾷ.", "seq": 2394}
{"id": "Simplicius_Passim_2395", "series": "CAG", "text": "λοιπὸς δὲ τῶν ποσῶν ὁ τόπος ἐστίν, καὶ ἀμφισβητεῖται οὗτος μήποτε κατὰ τὸ ἄνω καὶ τὸ κάτω τὴν ἐναντίωσιν ἐπιδέχεται, ἅπερ ἢ εἴδη ἢ μέρη τοῦ τόπου δοκεῖ.", "seq": 2395}
{"id": "Simplicius_Passim_2396", "series": "CAG", "text": "ἀλλ᾿ οἱ μὲν οὐδὲ εἶναι φύσει τὸ ἄνω καὶ τὸ κάτω νομίζουσιν, ἀλλὰ κατὰ τὴν πρὸς ἡμᾶς σχέσιν θεωρεῖσθαι, ὅσοι τὸ ὑπὲρ κεφαλῆς ἡμῶν ἄνω λέγουσιν, τὸ δὲ ὑπὸ τοὺς πόδας κάτω, καὶ τὸ αὐτὸ ἄνω καὶ κάτω τίθενται κατὰ τὰς διαφόρους σχέσεις, καὶ δῆλον ὅτι οὐκ ἂν εἴη οὕτως ἐναντία·", "seq": 2396}
{"id": "Simplicius_Passim_2397", "series": "CAG", "text": "οὐ γὰρ ὑπάρχει τῷ αὐτῷ κατὰ ταὐτὸν τὰ ἐναντία.", "seq": 2397}
{"id": "Simplicius_Passim_2398", "series": "CAG", "text": "οἱ δὲ τὸ ἄνω καὶ τὸ κάτω οὐ κατὰ σχέσιν, ἀλλὰ κατὰ τὴν τοῦ παντὸς διάστασιν λαμβάνουσιν, τήν τε ἀπὸ τοῦ μέσου πρὸς τὰ πέρατα καὶ τὴν ἀπὸ τῶν περάτων πρὸς τὸ μέσον·", "seq": 2398}
{"id": "Simplicius_Passim_2399", "series": "CAG", "text": "φύσει γὰρ διάφορα ταῦτα.", "seq": 2399}
{"id": "Simplicius_Passim_2400", "series": "CAG", "text": "ἀλλὰ καὶ πρὸς τούτους ῥητέον ὡς τὸ ἄνω καὶ κάτω οὐ τόπον σημαίνει, ἀλλὰ τὴν ποῦ κατηγορίαν, ὥσπερ τὸ χθὲς καὶ σήμερον οὐ χρόνον, ἀλλὰ τὸ ποτέ, τουτέστιν τὸ κατὰ χρόνον.", "seq": 2400}
{"id": "Simplicius_Passim_2401", "series": "CAG", "text": "ταῦτα γὰρ καὶ τῷ Ἀνδρονίκῳ δοκεῖ.", "seq": 2401}
{"id": "Simplicius_Passim_2402", "series": "CAG", "text": "μήποτε δὲ καὶ τὸ ἄνω καὶ τὸ κάτω τόπου διαφοραί εἰσιν καὶ τὸ χθὲς καὶ τὸ σήμερον χρόνου, οὐ μέντοι καθὸ ποσὸν ὁ τόπος καὶ ὁ χρόνος ἔχει τοῦτο, ἀλλ᾿ ὁ μὲν κατὰ τὴν θέσιν καὶ τὸ τοπικὸν ἰδίωμα, ὅπερ ἐν τῇ τοῦ ποῦ κατηγορίᾳ παραδέδοται, ὁ δὲ κατὰ τὰ ὑπὸ τῆς κινήσεως μέτρα.", "seq": 2402}
{"id": "Simplicius_Passim_2403", "series": "CAG", "text": "καὶ γὰρ ὁ τόπος καὶ ὁ χρόνος ἐν μὲν τῷ ποσῷ κατὰ τὴν διάστασιν μόνην παραδίδονται, κατὰ μέντοι τὸν ἴδιον χαρακτῆρα ὁ μὲν τόπος ἐν τῇ ποῦ κατηγορίᾳ, ὁ δὲ χρόνος ἐν τῇ ποτέ, ὥστε καθὸ ποσὸν ὁ τόπος, οὐκ ἔχει τὸ ἄνω καὶ τὸ κάτω, ἀλλὰ καθὸ τοιόνδε ποσόν.", "seq": 2403}
{"id": "Simplicius_Passim_2404", "series": "CAG", "text": "Ὁ μέντοι Ἀριστοτέλης εἰ μή τις, φησίν, τὸ πολὺ τῷ ὀλίγῳ φαίη ἐναντίον ἢ τὸ μέγα τῷ μικρῷ·", "seq": 2404}
{"id": "Simplicius_Passim_2405", "series": "CAG", "text": "δοκεῖ γὰρ ταῦτα ποσὰ ὄντα ἐναντία εἶναι.", "seq": 2405}
{"id": "Simplicius_Passim_2406", "series": "CAG", "text": "ἀλλὰ δείκνυσιν πρῶτον μέν, ὅτι οὐκ ἔστιν ποσά, ἀλλὰ πρός τι, ἔπειτα ὅτι, κἂν ποσὰ ᾖ κἂν μὴ ποσά, οὐκ ἔστιν ἐναντία.", "seq": 2406}
{"id": "Simplicius_Passim_2407", "series": "CAG", "text": "καὶ ὅτι μὲν οὐκ ἔστιν ποσά, ἀλλὰ πρός τι τὸ μέγα καὶ τὸ μικρόν, δείκνυσιν οὕτως·", "seq": 2407}
{"id": "Simplicius_Passim_2408", "series": "CAG", "text": "‘εἰ τὰ μικρὰ μεγάλα λέγεται καὶ τὰ μεγάλα μικρὰ πρὸς τὰ ὁμογενῆ παραβαλλόμενα, οὐδὲν ἔσται καθ᾿ αὑτὸ μέγα ἢ μικρόν, ἀλλὰ πρὸς ἕτερα ἕξει τὴν ἀναφορὰν καὶ πρός τι ἔσται·", "seq": 2408}
{"id": "Simplicius_Passim_2409", "series": "CAG", "text": "ἀλλὰ μὴν τὸ ἡγούμενον, τὸ ἄρα λῆγον’.", "seq": 2409}
{"id": "Simplicius_Passim_2410", "series": "CAG", "text": "ἐν δὴ τούτῳ τῷ συλλογισμῷ τὸ μὲν συνημμένον ὡς σαφὲς παρῆκεν·", "seq": 2410}
{"id": "Simplicius_Passim_2411", "series": "CAG", "text": "εἰ γὰρ τὰ μεγάλα μικρὰ λέγεται καὶ τὰ μικρὰ μεγάλα, δῆλον ὅτι οὐδὲν ἔσται καθ᾿ αὑτὸ τοιοῦτο·", "seq": 2411}
{"id": "Simplicius_Passim_2412", "series": "CAG", "text": "τὴν δὲ πρόσληψιν ἀποδείκνυσιν ἐκ τοῦ καὶ ὄρος μικρὸν λέγεσθαι καὶ κέγχρον μεγάλην πρὸς τὰ ὁμογενῆ παραβαλλόμενα.", "seq": 2412}
{"id": "Simplicius_Passim_2413", "series": "CAG", "text": "εἶτα τὸ αὐτὸ καὶ ἐπὶ τοῦ πολλοῦ καὶ ὀλίγου δείκνυσιν, πολλοὺς μὲν ἐν τῇ κώμῃ λέγων ἢ ἐν τῷ οἴκῳ ὡς πρὸς κώμην καὶ οἶκον, ὀλίγους δὲ ἐν τῷ ἄστει καὶ τῷ θεάτρῳ ὡς πρὸς αὐτά.", "seq": 2413}
{"id": "Simplicius_Passim_2414", "series": "CAG", "text": "δεύτερον δὲ ἐπιχείρημα ἀπὸ τῆς ἐνεργείας ἐπάγει τῆς σημαντικῆς·", "seq": 2414}
{"id": "Simplicius_Passim_2415", "series": "CAG", "text": "οὐ γὰρ ὅμοιόν τι σημαίνει τὸ τρίπηχυ καὶ τὸ μέγα, ἀλλὰ τὸ μὲν τρίπηχυ ποσόν, τὸ δὲ μέγα πρός τι.", "seq": 2415}
{"id": "Simplicius_Passim_2416", "series": "CAG", "text": "καὶ οἰκείως ἀπὸ τῶν σημασιῶν ποιεῖται τὴν ἀπόδειξιν, ἐπειδὴ κατ᾿ αὐτὰς αἱ κατηγορίαι διεστήκασιν.", "seq": 2416}
{"id": "Simplicius_Passim_2417", "series": "CAG", "text": "καὶ ἔστιν καὶ οὗτος ὁ συλλογισμὸς τοιοῦτος·", "seq": 2417}
{"id": "Simplicius_Passim_2418", "series": "CAG", "text": "‘πᾶν ὃ δηλοῖ ποσόν, ἐκεῖνό ἐστι ποσόν·", "seq": 2418}
{"id": "Simplicius_Passim_2419", "series": "CAG", "text": "τὸ δὲ πολὺ καὶ ὀλίγον ἢ τὸ μέγα καὶ μικρὸν οὐ δηλοῖ ποσόν·", "seq": 2419}
{"id": "Simplicius_Passim_2420", "series": "CAG", "text": "οὐκ ἄρα ἐστὶν ποσά’.", "seq": 2420}
{"id": "Simplicius_Passim_2421", "series": "CAG", "text": "εἶτα κατασκευάζει ἐκ περιουσίας, ὅτι, κἄν τε ποσὰ ᾖ κἄν τε μή, οὐκ ἔστιν ἐναντία.", "seq": 2421}
{"id": "Simplicius_Passim_2422", "series": "CAG", "text": "δείκνυσιν δὲ αὐτὸ οὕτως·", "seq": 2422}
{"id": "Simplicius_Passim_2423", "series": "CAG", "text": "‘τὸ μέγα καὶ μικρὸν καὶ πολὺ καὶ ὀλίγον οὐκ ἔστι καθ᾿ αὑτά, ἀλλὰ πρὸς ἕτερον ἀναφέρεται·", "seq": 2423}
{"id": "Simplicius_Passim_2424", "series": "CAG", "text": "τὰ δὲ τοιαῦτα οὐκ ἔστιν ἐναντία·", "seq": 2424}
{"id": "Simplicius_Passim_2425", "series": "CAG", "text": "τὰ γὰρ ἐναντία καθ᾿ ἑαυτά ἐστιν καὶ ἐπὶ τῆς οἰκείας φύσεως ὑφέστηκεν’.", "seq": 2425}
{"id": "Simplicius_Passim_2426", "series": "CAG", "text": "εἶτα τὸ αὐτὸ καὶ διὰ τῆς εἰς ἀδύνατον ἀπαγωγῆς ἐπιδείκνυσιν·", "seq": 2426}
{"id": "Simplicius_Passim_2427", "series": "CAG", "text": "‘εἰ γὰρ ἔσται τὸ μέγα καὶ τὸ μικρὸν ἐναντία, συμβήσεται ἅμα τὰ ἐναντία ἐπιδέχεσθαι·", "seq": 2427}
{"id": "Simplicius_Passim_2428", "series": "CAG", "text": "ἀλλὰ μὴν τοῦτο ἀδύνατον’.", "seq": 2428}
{"id": "Simplicius_Passim_2429", "series": "CAG", "text": "τὸ δὲ συνημμένον πρόδηλον ἐκ τοῦ τὸ αὐτὸ μέγα καὶ μικρὸν εἶναι.", "seq": 2429}
{"id": "Simplicius_Passim_2430", "series": "CAG", "text": "εἶτα καὶ ἄλλο ἐπάγει συμπέρασμα τοῖς αὐτοῖς λήμμασιν ἔτι ἀτοπώτερον τὸ αὐτὸ ἑαυτῷ ἐναντίον εἶναι·", "seq": 2430}
{"id": "Simplicius_Passim_2431", "series": "CAG", "text": "καὶ τοῦτο γὰρ δῆλον, εἴπερ τὸ αὐτὸ μέγα καὶ μικρόν ἐστιν.", "seq": 2431}
{"id": "Simplicius_Passim_2432", "series": "CAG", "text": "ἀδύνατον δὲ αὐτὸ ἑαυτῷ ἐναντίον εἶναι, διότι τὰ μὲν ἐναντία ἀναιρετικὰ ἀλλήλων ἐστίν, οὐδὲν δὲ ἑαυτοῦ ἀναιρετικόν ἐστιν κατὰ φύσιν.", "seq": 2432}
{"id": "Simplicius_Passim_2433", "series": "CAG", "text": "καὶ δῆλον ὅτι τὰ μὲν πρός τι οὐδὲν κωλύεται ἅμα ἔχειν τὰ ἀντικείμενα, διότι πρὸς ἄλλο καὶ ἄλλο ἀναφέρεται, τὰ δὲ ἐναντία συνυπάρχειν ἀδύνατον·", "seq": 2433}
{"id": "Simplicius_Passim_2434", "series": "CAG", "text": "μάχεται γὰρ ἀλλήλοις.", "seq": 2434}
{"id": "Simplicius_Passim_2435", "series": "CAG", "text": "“Μήποτε δέ, φησὶν Ἰάμβλιχος τῷ Ἀνδρονίκῳ κατα<κολουθῶν>, τὸ μέγα καὶ μικρὸν καὶ τὸ πολὺ καὶ ὀλίγον οὐ μόνον πρός τί ἐστιν, ἀλλὰ καὶ ποσὸν ἀόριστον.", "seq": 2435}
{"id": "Simplicius_Passim_2436", "series": "CAG", "text": "ὅταν γὰρ λέγωμεν μέγα, ποσὸν ἀόριστον δηλοῦμεν·", "seq": 2436}
{"id": "Simplicius_Passim_2437", "series": "CAG", "text": "οὐ γὰρ δηλοῦται πόσῳ ἢ τίνι μεγέθει μέγα ἐστὶν ἢ πόσῳ πλήθει πολύ·", "seq": 2437}
{"id": "Simplicius_Passim_2438", "series": "CAG", "text": "ὅταν δὲ μεῖζον καὶ μικρότερον λέγωμεν, κατὰ τὴν πρὸς ἄλληλα σχέσιν θεωρεῖται.", "seq": 2438}
{"id": "Simplicius_Passim_2439", "series": "CAG", "text": "ὁ δέ γε Ἀριστοτέλης κατὰ τὸ πρός τι μόνον τὸ μέγα καὶ μικρὸν ἐθεώρησεν, ὥσπερ ὁ Πλωτῖνος κατὰ τὸ ἁπλῶς μόνον·", "seq": 2439}
{"id": "Simplicius_Passim_2440", "series": "CAG", "text": "τὸ γὰρ πρός τι μέγα ἀντὶ τοῦ μεῖζον λέγεσθαί φησιν.”", "seq": 2440}
{"id": "Simplicius_Passim_2441", "series": "CAG", "text": "Εἰπόντος δὲ τοῦ Ἀριστοτέλους, ὅτι ὃ μὴ ἔστι καθ᾿ αὑτὸ λαβεῖν, ἀλλὰ πρὸς ἕτερον ἀναφέρεται, τοῦτο οὐκ ἔχει ἐναντίον, ἐνίστανταί τινες πολλὰ καὶ ἐν τοῖς πρός τι ἐναντία λέγοντες εἶναι, οἷον τὴν ἐπιστήμην τῇ ἀγνοίᾳ καὶ τὴν ἀρετὴν τῇ κακίᾳ.", "seq": 2441}
{"id": "Simplicius_Passim_2442", "series": "CAG", "text": "“μήποτε οὖν, φησὶν Ἰάμβλιχος, ἐλλιπῶς εἴρηται, τὸ δὲ πλῆρές ἐστιν τοιοῦτον·", "seq": 2442}
{"id": "Simplicius_Passim_2443", "series": "CAG", "text": "ὃ μὴ ἔστιν καθ᾿ αὑτό, ἀλλὰ πρὸς ἕτερον ἀναφέρεται, οὐδενὶ τούτων τῶν πρὸς ἃ ἀναφέρεταί ἐστιν ἐναντίον·", "seq": 2443}
{"id": "Simplicius_Passim_2444", "series": "CAG", "text": "ἡ γὰρ μεγάλη κέγχρος πρὸς τὴν μικρὰν κέγχρον ἀναφέρεται καὶ οὐκ ἔστιν τὸ μέγα τῷ μικρῷ ἐναντίον”.", "seq": 2444}
{"id": "Simplicius_Passim_2445", "series": "CAG", "text": "μήποτε δὲ ἄμεινον λέγειν ὅτι οὐ πᾶσαν ἀντίθεσιν ἀνεῖλεν ἀπὸ τοῦ ποσοῦ ὁ Ἀριστοτέλης·", "seq": 2445}
{"id": "Simplicius_Passim_2446", "series": "CAG", "text": "οὐ γὰρ καὶ τὴν κατὰ τὸ πρός τι, ἀλλὰ μόνην τὴν κατὰ τὸ ἐναντίον, ὥστε κἂν εἴη τις ἐν τῷ ποσῷ κατὰ τὸ πρός τι ἀντίθεσις, οὐ σαλεύεται διὰ τοῦτο ὁ Ἀριστοτέλους λόγος λέγων τῷ ποσῷ οὐδὲν εἶναι ἐναντίον.", "seq": 2446}
{"id": "Simplicius_Passim_2447", "series": "CAG", "text": "Εἰδέναι δὲ χρή, ὅτι τοῦ ποσοῦ τὸ μέν ἐστιν ὡρισμένον, τὸ δὲ ἀόριστον·", "seq": 2447}
{"id": "Simplicius_Passim_2448", "series": "CAG", "text": "καὶ ὡρισμένον μὲν τὸ περιγεγραμμένον ἤδη καὶ κατὰ μέτρον ὡρισμένον νοούμενον, οἷον δύο ἢ τρία ἢ πηχυαῖον·", "seq": 2448}
{"id": "Simplicius_Passim_2449", "series": "CAG", "text": "ἀόριστον δὲ τὸ ἄνευ περιγραφῆς καὶ ἄδηλον κατὰ τίνα ὑπεροχὴν ὑπερέχει ἢ κατὰ τίνα ἔλλειψιν ἐλλείπει·", "seq": 2449}
{"id": "Simplicius_Passim_2450", "series": "CAG", "text": "τοιαῦτα δὲ τὰ πολλὰ ἢ ὀλίγα καὶ τὸ μέγα καὶ μικρόν.", "seq": 2450}
{"id": "Simplicius_Passim_2451", "series": "CAG", "text": "καὶ αὐτὸ δὲ τὸ ἀόριστον ποσὸν διχῶς λέγεται, τὸ μὲν ἁπλῶς, τὸ δὲ πρός τι.", "seq": 2451}
{"id": "Simplicius_Passim_2452", "series": "CAG", "text": "τὸ μὲν γὰρ μὴ ἀναφερόμενον ἐφ᾿ ἕτερον ὁμογενές, κατὰ δὲ τὴν οἰκείαν διαφορὰν νοούμενον τὴν πρὸς τὰ ἀνομοιογενῆ ἁπλῶς λέγεται, οἷον ὅταν τὸ μικρὸν ὄρος μὴ πρὸς τὰ ὁμογενῆ ἀναφέροντες, πρὸς δὲ τὴν μεγάλην οἰκίαν ὡς πρὸς ὁμογενῆ τιθεμένην μέγα λέγωμεν, τότε ἁπλῶς λέγομεν αὐτὸ μέγα·", "seq": 2452}
{"id": "Simplicius_Passim_2453", "series": "CAG", "text": "τῷ γὰρ καθ᾿ αὑτὸ μεγέθους μετέχειν μεῖζον τῆς οἰκίας λέγεται.", "seq": 2453}
{"id": "Simplicius_Passim_2454", "series": "CAG", "text": "τὰ δὲ πρὸς τὰ ὁμογενῆ συγκρινόμενα καὶ ὡς κατὰ σύγκρισιν τὸ μέγα καὶ μικρὸν ἔχοντα οὐχ ἁπλῶς, ἀλλὰ κατὰ τὴν πρός τι σχέσιν θεωρεῖται.", "seq": 2454}
{"id": "Simplicius_Passim_2455", "series": "CAG", "text": "καὶ ἐπὶ τῶν πολλῶν δὲ ὁ αὐτὸς λόγος ἁρμόζει·", "seq": 2455}
{"id": "Simplicius_Passim_2456", "series": "CAG", "text": "ἄλλο μὲν γάρ ἐστιν τὸ καθ᾿ αὑτὸ θεωρούμενον πλῆθος, ἄλλο δὲ τὸ κατὰ τὴν πρὸς ἕτερον σχέσιν θεωρούμενον, ὅθεν καὶ τὸ μᾶλλον καὶ ἧττον ἐπιδέχεται τὰ τοιαῦτα καὶ τὰ ἐναντία ἅμα ὑπάρχει αὐτοῖς.", "seq": 2456}
{"id": "Simplicius_Passim_2457", "series": "CAG", "text": "Βούλεται δὲ ὁ θεῖος Ἰάμβλιχος τὰ μὲν καθ᾿ αὑτὰ μέγα καὶ μικρὸν καὶ πολὺ καὶ ὀλίγον ἐν τοῖς καθ᾿ αὑτὰ καὶ ἀύλοις εἴδεσιν θεωρεῖσθαι, τὰ μὲν κατὰ τὴν ὑπεροχὴν τῆς δυνάμεως.", "seq": 2457}
{"id": "Simplicius_Passim_2458", "series": "CAG", "text": "τὰ δὲ κατὰ τὸ πλῆθος τῶν καθαρῶν λόγων, τὰ δὲ πρός τι, ἅπερ καὶ κατὰ σύγκρισιν λέγεται, ἐν τοῖς ἐνύλοις ὁρᾶν, ἐν οἷς καὶ τὸ μᾶλλον καὶ ἧττον καὶ τἀναντία ἅμα κατὰ τὴν πρὸς ἕτερον καὶ ἕτερον ἀναφοράν.", "seq": 2458}
{"id": "Simplicius_Passim_2459", "series": "CAG", "text": "“προσιόντος γὰρ τοῦ εἴδους τῇ ὕλῃ σύμμικτός τις ἀπ᾿ ἀμφοῖν γίνεται δύναμις·", "seq": 2459}
{"id": "Simplicius_Passim_2460", "series": "CAG", "text": "καθ᾿ ὅσον μὲν γὰρ μεταλαμβάνει τοῦ εἴδους, ὁμοιοῦται πρὸς αὐτὸ καὶ γίνεται πολὺ καὶ μέγα τὸ ἔνυλον, κατὰ δὲ τὴν οἰκείαν ἀπειρίαν τοῦ μᾶλλον καὶ ἧττον καὶ τῆς πρός τι σχέσεως καὶ τῆς ἐπὶ τὰ ἐναντία μεταβολῆς μεταλαμβάνει.", "seq": 2460}
{"id": "Simplicius_Passim_2461", "series": "CAG", "text": "τούτου δὴ οὖν, φησίν, οὕτως ἔχοντος οὐκ ὀρθῶς ὑπολαμβάνουσιν οἱ ἁπλῶς ταῦτα πάντα ἡγούμενοι λέγεσθαι, ὥσπερ ὁ Πλωτῖνος·", "seq": 2461}
{"id": "Simplicius_Passim_2462", "series": "CAG", "text": "καὶ γὰρ ἡ συνήθεια ἐπὶ τῶν πρός τι πολλάκις αὐτοῖς χρῆται, καὶ οἱ κέγχρον μεγάλην λέγοντες κατὰ τὴν πρὸς τὸ ὁμογενὲς σύγκρισιν ὡς τὸ μεῖζον δηλοῦσαν κατὰ τὸ πρός τι λέγουσιν.", "seq": 2462}
{"id": "Simplicius_Passim_2463", "series": "CAG", "text": "‘ἀλλὰ τὸ μέγεθος, φησὶν ὁ Πλωτῖνος, οὐκ ἔστιν τῶν πρός τι, ἀλλὰ τὸ μεῖζον, ὥσπερ καὶ τὸ διπλάσιον’.", "seq": 2463}
{"id": "Simplicius_Passim_2464", "series": "CAG", "text": "ἢ οὐχ οὕτως ἔχει·", "seq": 2464}
{"id": "Simplicius_Passim_2465", "series": "CAG", "text": "διατείνει γὰρ ἡ τοῦ μεγέθους ἔννοια ἐπί τε τὰ καθ᾿ αὑτὰ μεγέθη καὶ τὰ πρὸς ἄλληλα·", "seq": 2465}
{"id": "Simplicius_Passim_2466", "series": "CAG", "text": "οὐδὲ γὰρ ἂν μεῖζον ἐλέγετο μὴ μετέχον τοῦ μεγέθους καὶ παραδηλοῦν τὴν κατὰ τὸ μέγεθος ὑπεροχήν ‘ἀλλὰ τὰ πολλά, φασίν, οὐδὲν ἄλλο ἐστὶν ἢ πολὺ πλῆθος ἐν ἀριθμῷ θεωρούμενον, ὥστε οὐκ ἂν εἴη πρός τι’.", "seq": 2466}
{"id": "Simplicius_Passim_2467", "series": "CAG", "text": "ἢ ῥᾴδιον ἄλλο εἶδος ἀριθμοῦ ἀντιθεῖναι, ὃ καὶ πρός τι ποσὸν λέγεται, ἐν ᾧ αἱ δέκα σχέσεις τῶν λόγων περιέχονται·", "seq": 2467}
{"id": "Simplicius_Passim_2468", "series": "CAG", "text": "ἐν τούτῳ γάρ ἐστιν καὶ τὸ πλεῖον καὶ τὸ ἔλαττον.", "seq": 2468}
{"id": "Simplicius_Passim_2469", "series": "CAG", "text": "εἰ δὲ καὶ ἀριθμοῦ ἐπέκτασίν τις ἁπλῶς λέγοι τὸ πλῆθος, τὸ δὲ ὀλίγον ἀριθμοῦ συστολήν, οὐδὲν ἧττόν ἐστιν καὶ ἐν ταῖς προόδοις τῶν διαφόρων ἀριθμῶν ἐναρμόνιός τις πρὸς ἀλλήλους διαφορά, καθ᾿ ἣν ὑπερέχουσίν τε καὶ ὑπερέχονται καὶ πλείονές εἰσιν καὶ ἐλάττονες.", "seq": 2469}
{"id": "Simplicius_Passim_2470", "series": "CAG", "text": "καὶ ἐπὶ τοῦ συνεχοῦς δὲ τοῦ σημείου ἢ πόρρω ἢ ἐγγὺς προϊόντος πολλαὶ γίνονται διαφορότητες τῆς σχέσεως καὶ τῆς ὑπεροχῆς καὶ ἐλλείψεως, ἢ ταχὺ ἱσταμένου ἐν τῇ προόδῳ ἢ βραδέως καὶ ἢ ἐν λόγῳ τὴν ὑπεροχὴν πρὸς τὴν ἔλλειψιν ἀφορίζοντος ἢ ἀλόγως·", "seq": 2470}
{"id": "Simplicius_Passim_2471", "series": "CAG", "text": "ὡς γὰρ τὸ ἓν ἐπὶ πολλὰ ἢ ἐπ᾿ ὀλίγα προϊὸν ποιεῖ τὰς τῶν ἀριθμῶν παραλλαγάς, οὕτως καὶ τὸ σημεῖον τὰς διαφόρους σχέσεις τῶν μεγεθῶν ἀπεργάζεται.", "seq": 2471}
{"id": "Simplicius_Passim_2472", "series": "CAG", "text": "‘ἀλλὰ τίς ὅρος τῆς προόδου κατά τε τὸ πολὺ καὶ ὀλίγον καὶ τὸ μέγα καὶ τὸ μικρόν;", "seq": 2472}
{"id": "Simplicius_Passim_2473", "series": "CAG", "text": "οὐ γὰρ δὴ ἐπ᾿ ἄπειρον πρόεισιν, ἀλλ᾿ ἔχει καὶ ἐν τῷ προϊέναι τι μέτρον’.", "seq": 2473}
{"id": "Simplicius_Passim_2474", "series": "CAG", "text": "ἢ δῆλον ὅτι ἕκαστον εἶδος συνυπάγει μετὰ τῆς οἰκείας ἰδιότητος καὶ ποσοῦ τι μέτρον σύμμετρον τῇ ἰδιότητι·", "seq": 2474}
{"id": "Simplicius_Passim_2475", "series": "CAG", "text": "οὐ γὰρ σχῆμα μόνον ἐπιφέρει μεθ᾿ ἑαυτοῦ τὸ εἶδος, ἀλλὰ καὶ μέγεθος, ὃ μετὰ διαστάσεως εἰς τὴν ὕλην παραγίνεται.", "seq": 2475}
{"id": "Simplicius_Passim_2476", "series": "CAG", "text": "πλάτος δὲ ἔχει καὶ τοῦτο ἐνθάδε διὰ τὸ ἀόριστόν πως τῆς ἐνύλου φύσεως, ἐὰν δὲ πολὺ τὸν ὅρον παραλλάξῃ ἢ πρὸς τὸ μεῖζον ἢ πρὸς τὸ ἔλαττον, τέρας νομίζεται (ὡς ἡ ἐφ᾿ ἡμῶν ὀφθεῖσα Κίλισσα γυνὴ τεσσάρων πηχῶν ἔχουσα τὸ μῆκος καὶ οἱ νᾶνοι πολλαχοῦ γεγονότες).", "seq": 2476}
{"id": "Simplicius_Passim_2477", "series": "CAG", "text": "ἀόριστον οὖν τι καθ᾿ ἕκαστον γένος καὶ εἶδος ἐν τοῖς ἐνύλοις παρεισέρχεται κατά τε ὑπεροχὴν καὶ κατὰ ἔλλειψιν, λόγοι μέντοι οἱ αὐτοὶ διήκουσι πάντων, οἳ μεταληφθέντες ποιοῦσι τοιαῦτα εἶναι τὰ μετέχοντα, οἷοίπερ εἰσὶν αὐτοί, ὥσπερ μεγέθους, καλοῦ καὶ τῶν ἄλλων.", "seq": 2477}
{"id": "Simplicius_Passim_2478", "series": "CAG", "text": "καὶ τὰ μὲν ἀπολύτως αὐτῶν μετέχοντα ἔσται ἁπλῶς εἰδοποιούμενα, τὰ δὲ ἐν σχέσει τῶν πρός τι, ὥσπερ εἰ λέγοι τις θερμὸν μὲν ἁπλῶς, θερμότερον δὲ τῶν πρός τι, καὶ τὰ μὲν ὡς καθ᾿ αὑτά, τὰ δὲ ἐν ἑτέροις, καὶ τὰ μὲν ὡς ἄυλα, τὰ δὲ ὡς ἔνυλα”.", "seq": 2478}
{"id": "Simplicius_Passim_2479", "series": "CAG", "text": "Θεωρητικώτερον δὲ τοῖς εἰρημένοις περὶ τοῦ ποσοῦ ἐπιβάλλων ὁ θεῖος Ἰάμβλιχος “παντός, φησίν, ποσοῦ κοινὴ ἔννοια τοιάδε ἐστίν·", "seq": 2479}
{"id": "Simplicius_Passim_2480", "series": "CAG", "text": "ποσὸν ὑπάρχει τὸ διαιρετὸν εἰς ἐνυπάρχοντα μέρη·", "seq": 2480}
{"id": "Simplicius_Passim_2481", "series": "CAG", "text": "τοῦτο γὰρ ἐπὶ πλήθους καὶ μεγέθους ὡσαύτως διατείνει.", "seq": 2481}
{"id": "Simplicius_Passim_2482", "series": "CAG", "text": "τούτου δὲ τὸ μὲν ἀριθμητόν ἐστιν, τὸ δὲ μετρητόν, καὶ ἑκάτερον λέγεται καὶ ἀορίστως πως καὶ ὡρισμένως, οἷον τὸ μῆκος ὡρισμένως, ὅτι μετὰ περάτων, ἀορίστως δέ, ὅτι ἄδηλον μέχρι πόσου τὰ πέρατα ἀφορίζονται.", "seq": 2482}
{"id": "Simplicius_Passim_2483", "series": "CAG", "text": "εἰ δὲ πάντα τὰ κατὰ τὴν κοινωνίαν τοῦ αὐτοῦ γένους [ἤτοι τοῦ ποσοῦ] ἀφώρισται, οὐδὲν διαφέρει, εἰ τὸ μὲν ἐφ᾿ ἕν, τὸ δὲ ἐπὶ δύο, τὸ δὲ ἐπὶ τρία διέστηκεν·", "seq": 2483}
{"id": "Simplicius_Passim_2484", "series": "CAG", "text": "οὐ γὰρ διὰ τοῦτο ἀπογνωστέον τὴν μετουσίαν τοῦ κοινοῦ γένους, οὐδὲ ἐπὶ τῶν ἀριθμῶν, ὅτι ἡ δυὰς τῆς τριάδος προηγεῖται καὶ αὕτη τῆς τετράδος καὶ ἐφεξῆς·", "seq": 2484}
{"id": "Simplicius_Passim_2485", "series": "CAG", "text": "οὐ γὰρ ἡ δυὰς τὴν τριάδα ποιεῖ ὡς προτέρα οὖσα τὴν δευτέραν, ἀλλὰ κατ᾿ ἄλλο μὲν τὸ πρότερον αὐτοῖς καὶ ὕστερον διηρίθμηνται, κατ᾿ ἄλλο δὲ ἡ κοινωνία αὐτοῖς τοῦ γένους ἐνυπάρχει, καθ᾿ ἣν οὐδὲν μᾶλλον οὐδὲ ἧττον τὰ ἕτερα ἐν αὐτῷ περιέχεται”.", "seq": 2485}
{"id": "Simplicius_Passim_2486", "series": "CAG", "text": "ἐν δὲ τούτοις τὰ μὲν ἄλλα μοι φανερὰ δοκεῖ καλῶς εἰρημένα, πῶς δὲ ποσὸν εἶναί φησιν τὸ διαιρετὸν εἰς ἐνυπάρχοντα μέρη, οὐ πάνυ τι παρακολουθῶ.", "seq": 2486}
{"id": "Simplicius_Passim_2487", "series": "CAG", "text": "τοῦτο γὰρ ὅλου μᾶλλον ἀλλ᾿ οὐχὶ ποσοῦ παραστατικόν μοι δοκεῖ·", "seq": 2487}
{"id": "Simplicius_Passim_2488", "series": "CAG", "text": "ἄλλη δὲ ὅλου καὶ ἄλλη ποσοῦ ἔννοια·", "seq": 2488}
{"id": "Simplicius_Passim_2489", "series": "CAG", "text": "τὸ μὲν γὰρ ὅλον καὶ τὸ μέρη ἔχειν καὶ τῇ οὐσίᾳ ὑπάρχει[ν] καὶ οὐ καθὸ ποσόν, ἀλλὰ καθὸ εἶδος ἢ ἄτομον.", "seq": 2489}
{"id": "Simplicius_Passim_2490", "series": "CAG", "text": "διὸ καὶ Ἀριστοτέλης “μὴ ταραττέτω, φησίν, ἡμᾶς τὰ μέρη τῶν οὐσιῶν ὡς ἐν ὑποκειμένοις ὄντα τοῖς ὅλοις”.", "seq": 2490}
{"id": "Simplicius_Passim_2491", "series": "CAG", "text": "εἰ οὖν μέρη ἔχει ἡ οὐσία, ἡ μὲν κατὰ τὸ εἶδος τὰ συμπληρωτικὰ τοῦ εἴδους, οἷον τὸ ζῷον τὸ λογικόν, τὸ θνητόν, ἡ δὲ κατὰ τὸ ἄτομον τὰ συμπληρωτικὰ τοῦ ἀτόμου, οἷον κεφαλήν, χεῖρας, πόδας, δῆλον ὅτι καὶ διαιρεῖται εἰς τὰ ἐνυπάρχοντα μέρη, ὥστε οὐκ ἔστιν τοῦ ποσοῦ ἴδιον, ἀλλ᾿ ἐκεῖνο καθ᾿ ὃ δυνατὸν εἰπεῖν πόσον ἐστὶν ἕκαστον, οἷον δύο ἢ τρία ἢ δίπηχυ.", "seq": 2491}
{"id": "Simplicius_Passim_2492", "series": "CAG", "text": "τὸ γὰρ μέτρον ἴδιον τοῦ ποσοῦ·", "seq": 2492}
{"id": "Simplicius_Passim_2493", "series": "CAG", "text": "κἂν γὰρ ἀόριστον ᾖ ποσόν, οὕτως ἀόριστον λέγεται ὡς μήπω τοῦ μέτρου γνωσθέντος, κἂν ἄπειρον ὑποτεθῇ τι, οὕτως ἄπειρον ὑποτίθεται ὡς ἀδιεξιτήτως καταμετρούμενον.", "seq": 2493}
{"id": "Simplicius_Passim_2494", "series": "CAG", "text": "ὅπερ γὰρ καὶ πρότερον εἶπον, οὐδὲ ἡ διάστασις καθ᾿ αὑτὴν δοκεῖ μοι ποσὸν εἶναι, ἀλλὰ μᾶλλον ποιόν·", "seq": 2494}
{"id": "Simplicius_Passim_2495", "series": "CAG", "text": "ἡ δὲ γραμμὴ καὶ ἡ ἐπιφάνεια καὶ τὸ σῶμα διὰ τὸ ἐφ᾿ ἓν καὶ ἐπὶ δύο καὶ ἐπὶ τρία διεστάναι ποσόν ἐστιν καθ᾿ αὑτά.", "seq": 2495}
{"id": "Simplicius_Passim_2496", "series": "CAG", "text": "μήποτε δὲ ὁ θεῖος Ἰάμβλιχος κατὰ τὸ διαιρετὸν ἀφωρίσατο τὸ ποσόν, ἀλλ᾿ οὐχὶ κατὰ τὸ εἰς μέρη μόνον·", "seq": 2496}
{"id": "Simplicius_Passim_2497", "series": "CAG", "text": "τὸ γὰρ διαιρετὸν εἰς τὰ μέρη οὐχ ὡς ὅλον μόνον, ἀλλὰ καὶ ὡς ἓν εἰς πολλὰ διαιρεῖται, ὅπερ ὡς ποσῷ ὑπάρχει.", "seq": 2497}
{"id": "Simplicius_Passim_2498", "series": "CAG", "text": "6a12 Μάλιστα δὲ ἡ ἐναντιότης τοῦ ποσοῦ περὶ τόπον δοκεῖ ὑπάρχειν ἕως τοῦ ἐναντία ὁρίζονται.", "seq": 2498}
{"id": "Simplicius_Passim_2499", "series": "CAG", "text": "Εἰπὼν τῷ ποσῷ μηδὲν εἶναι ἐναντίον πάνυ ἐπιστημονικῶς παρατίθεται τὰ δοκοῦντα ποσὰ καὶ ἐναντία·", "seq": 2499}
{"id": "Simplicius_Passim_2500", "series": "CAG", "text": "τούτων γὰρ διελεγχθέντων ἀσφαλὴς λοιπὸν ὁ λόγος ὁ καθόλου δεικνὺς τῷ ποσῷ μηδὲν εἶναι ἐναντίον.", "seq": 2500}
