{"id": "Elias_Passim_5186", "series": "CAG", "text": "μέσον γὰρ τὸ ἅμα), καὶ ὅτι τὰ ἅμα ἐκ τῆς ἀποφάσεως τῶν ἄκρων γνωρίζονται·", "seq": 5186}
{"id": "Elias_Passim_5187", "series": "CAG", "text": "ἃ γὰρ μήτε πρότερα ἀλλήλων μήτε ὕστερα, ταῦτα ἅμα.", "seq": 5187}
{"id": "Elias_Passim_5188", "series": "CAG", "text": "τρία δὲ εἴδη τῶν ἅμα λέγει, καὶ τρία ἀντικεῖσθαι τοῖς τέσσαρσιν εἴδεσι τοῦ προτέρου·", "seq": 5188}
{"id": "Elias_Passim_5189", "series": "CAG", "text": "τῷ γὰρ ἑνί, ὡς εἴρηται, οὐδὲν ἀντιτίθησι.", "seq": 5189}
{"id": "Elias_Passim_5190", "series": "CAG", "text": "πρῶτον δὲ εἶδος τῶν ἅμα τὸ τῷ χρόνῳ ἅμα, ὡς τὰ μόρια τοῦ ἐμβρύου.", "seq": 5190}
{"id": "Elias_Passim_5191", "series": "CAG", "text": "τοῦτο κυρίως ἅμα καὶ ἀντίκειται τῷ κατὰ χρόνον προτέρῳ.", "seq": 5191}
{"id": "Elias_Passim_5192", "series": "CAG", "text": "δεύτερον εἶδος τῶν ἅμα τὸ ἀντιστρέφον καὶ ἐξισάζον, μηδαμῶς δὲ ἕτερον ἑτέρου αἴτιον τοῦ εἶναι, ὡς τὸ δεξιὸν καὶ τὸ ἀριστερόν·", "seq": 5192}
{"id": "Elias_Passim_5193", "series": "CAG", "text": "ὡς μὲν γὰρ δεξιὸν καὶ ἀριστερὸν ἅμα καὶ ἀντιστρέφοντα, ὡς δὲ πράγματα οὐδὲν οὐδενὸς αἴτιον·", "seq": 5193}
{"id": "Elias_Passim_5194", "series": "CAG", "text": "οὐδὲ γὰρ ἡ δεξιὰ χεὶρ τῆς ἀριστερᾶς αἰτία καὶ τὸ ἀνάπαλιν ὡς χεὶρ χειρός.", "seq": 5194}
{"id": "Elias_Passim_5195", "series": "CAG", "text": "τοῦτο τὸ σημαινόμενον δύο σημαινομένοις τοῦ προτέρου ἀντίκειται, τῷ τῇ φύσει προτέρῳ, ἐν ᾧ τὸ μεῖζον καὶ ἔλαττον (τοῦτο γὰρ ἴσον καὶ μόνον), καὶ τῷ ἀντιστρέφοντι μὲν κατὰ τὸ εἶναι ὁπωσοῦν δὲ δυναμένῳ αἰτίῳ εἶναι τῷ ἑνί, ὡς πατὴρ καὶ υἱός·", "seq": 5195}
{"id": "Elias_Passim_5196", "series": "CAG", "text": "ἐνταῦθα γὰρ οὐδὲν οὐδενὸς αἴτιον, ὡς τὸ δεξιὸν καὶ ἀριστερόν.", "seq": 5196}
{"id": "Elias_Passim_5197", "series": "CAG", "text": "τρίτον σημαινόμενον τῶν ἅμα τὸ τῇ τάξει ἅμα, ὡς τὰ ἐκ τῆς διαιρέσεως καταγόμενα, τὸ λογικὸν καὶ ἄλογον·", "seq": 5197}
{"id": "Elias_Passim_5198", "series": "CAG", "text": "τοῦτο ἀντίκειται τῷ τῇ τάξει προτέρῳ.", "seq": 5198}
{"id": "Elias_Passim_5199", "series": "CAG", "text": "ταῦτα μὲν ἐν τούτοις.", "seq": 5199}
{"id": "Elias_Passim_5200", "series": "CAG", "text": "Ἐφ᾿ οἷς διαλέγεται καὶ περὶ κινήσεως, οὐχὶ τὸν πρέποντα τῇ φυσικῇ τρόπον·", "seq": 5200}
{"id": "Elias_Passim_5201", "series": "CAG", "text": "τοῦτο γὰρ ποιεῖ ἐν τοῖς τελευταίοις τῆς Φυσικῆς τέτταρσι λόγοις καὶ ἐν τῷ τρίτῳ·", "seq": 5201}
{"id": "Elias_Passim_5202", "series": "CAG", "text": "οὐ γὰρ νῦν ὁρίζεται τὴν κίνησιν οὐδὲ λέγει τὰ αἴτια τῆς κινήσεως.", "seq": 5202}
{"id": "Elias_Passim_5203", "series": "CAG", "text": "ἀλλὰ τὸν πρέποντα τῇ διαλεκτικῇ τρόπον διαλέγεται περὶ αὐτῆς, ἀπαριθμεῖται τὰ σημαινόμενα τῆς κινήσεως, λέγει τὰς διαφορὰς αὐτῆς καὶ ποία ποίᾳ ἀντίκειται.", "seq": 5203}
{"id": "Elias_Passim_5204", "series": "CAG", "text": "διαλέγεται δὲ περὶ κινήσεως, ἐπειδὴ καὶ αὐτῆς ἐδεήθη ἐν ταῖς κατηγορίαις, ἐν μὲν τῇ οὐσίᾳ λέγων ὅτι ἡ οὐσία κατὰ τὴν οἰκείαν ἑαυτῆς μεταβολὴν τῶν ἐναντίων ἐστὶ δεκτική (ἡ δὲ μεταβολὴ κίνησις), καὶ ἐν τῇ ποιότητι, ὅτε ἔλεγε τὰς ἕξεις [καὶ διαθέσεις] ἀμεταβλήτους εἶναι, ἡ δὲ μεταβολὴ κίνησις (ποτὲ γὰρ καὶ αὗται μεταβάλλονται ἐν μεγάλῃ μεταβολῇ), καὶ ὅτε τὸν λόγον καὶ τὴν δόξαν ἔλεγεν αὐτὰ μὲν ἀκίνητα διαμένειν, τοῦ δὲ πράγματος μεταβάλλοντος καὶ αὐτὰ μεταβάλλειν.", "seq": 5204}
{"id": "Elias_Passim_5205", "series": "CAG", "text": "ἓξ δὲ εἴδη τῆς κινήσεως·", "seq": 5205}
{"id": "Elias_Passim_5206", "series": "CAG", "text": "γένεσις, φθορά, αὔξησις, μείωσις, ἀλλοίωσις, ἡ κατὰ τόπον μεταβολή.", "seq": 5206}
{"id": "Elias_Passim_5207", "series": "CAG", "text": "ἓξ δὲ εἴδη εἰσὶ δι᾿ αἰτίαν τοιαύτην·", "seq": 5207}
{"id": "Elias_Passim_5208", "series": "CAG", "text": "ἡ κίνησις ἐξάλλαξίς ἐστι καὶ ἔκστασις.", "seq": 5208}
{"id": "Elias_Passim_5209", "series": "CAG", "text": "ἐξίσταται δέ τις ἢ ἑαυτοῦ καὶ ποιεῖ γένεσιν καὶ φθοράν, ἢ τῶν ἑαυτοῦ (καὶ τοῦτο διχῶς·", "seq": 5209}
{"id": "Elias_Passim_5210", "series": "CAG", "text": "ἢ γὰρ μεριστὸν καὶ ποιεῖ τὸ ποσόν, ἐν ᾧ αὔξησις καὶ μείωσις, ἢ ἀμέριστον καὶ ποιεῖ τὸ ποιόν, ἐν ᾧ ἡ ἀλλοίωσις), ἢ τῶν περὶ αὐτὸν καὶ ποιεῖ τὴν κατὰ τόπον μεταβολήν·", "seq": 5210}
{"id": "Elias_Passim_5211", "series": "CAG", "text": "ὁ γὰρ τόπος περὶ ἡμᾶς καὶ οὐκ ἐν ἡμῖν.", "seq": 5211}
{"id": "Elias_Passim_5212", "series": "CAG", "text": "ἰστέον δὲ καὶ τοῦτο, ὅτι οὐχ ὡς γένος εἰς εἴδη ἡ κίνησις διαιρεῖται·", "seq": 5212}
{"id": "Elias_Passim_5213", "series": "CAG", "text": "ἐν γὰρ τοῖς ὡς γένος εἰς εἴδη διαιρουμένοις οὐκ ἔστι τάξις·", "seq": 5213}
{"id": "Elias_Passim_5214", "series": "CAG", "text": "προτέρα δὲ ἡ κατὰ τόπον κίνησις τῶν λοιπῶν διὰ τὰ οὐράνια·", "seq": 5214}
{"id": "Elias_Passim_5215", "series": "CAG", "text": "ταῦτα γὰρ τὴν μὲν κατὰ τόπον κίνησιν ἔλαχον, οὐδεμιᾶς δὲ ἄλλης κινήσεως μετέσχον, οὔτε γενέσεως ἢ φθορᾶς, οὐκ αὐξήσεως ἢ μειώσεως ἢ ἀλλοιώσεως.", "seq": 5215}
{"id": "Elias_Passim_5216", "series": "CAG", "text": "Τρία προεθέμεθα ζητῆσαι περὶ κινήσεως, τὴν ἀπαρίθμησιν τῶν εἰδῶν αὐτῆς καὶ τὰς διαφορὰς αὐτῆς καὶ ποία <ποίᾳ> ἐστὶν ἐναντία, ὧν τὸ πρῶτον διήνυσται ἡμῖν.", "seq": 5216}
{"id": "Elias_Passim_5217", "series": "CAG", "text": "ἀλλ᾿ εἴπωμεν τὸ δεύτερον, τοῦτ᾿ ἔστι τὸ εἰπεῖν τὰς διαφορὰς αὐτῆς.", "seq": 5217}
{"id": "Elias_Passim_5218", "series": "CAG", "text": "ὅτι μὲν οὖν ἡ κατὰ τόπον οὐδεμία ἐστὶ τῶν ἄλλων, δηλοῦσι τὰ οὐράνια, ὡς προείρηται, ταύτην μόνην ἔχοντα οὐδεμίαν δὲ τῶν λοιπῶν.", "seq": 5218}
{"id": "Elias_Passim_5219", "series": "CAG", "text": "ὅτι δὲ καὶ αἱ ἀντικείμεναι οὔκ εἰσιν αἱ αὐταί, ἄντικρυς δῆλον·", "seq": 5219}
{"id": "Elias_Passim_5220", "series": "CAG", "text": "οὐ γὰρ ταὐτὸν ἡ γένεσις τῇ φθορᾷ·", "seq": 5220}
{"id": "Elias_Passim_5221", "series": "CAG", "text": "ἡ μὲν γὰρ ἀπὸ τοῦ μὴ ὄντος εἰς τὸ εἶναι παράγει, ἡ γένεσις, ἡ δὲ ἀπὸ τοῦ ὄντος εἰς τὸ μὴ ὄν.", "seq": 5221}
{"id": "Elias_Passim_5222", "series": "CAG", "text": "ἀλλ᾿ οὐδὲ ἡ αὔξησις τῇ μειώσει ταὐτόν·", "seq": 5222}
{"id": "Elias_Passim_5223", "series": "CAG", "text": "ἡ μὲν γὰρ ἀπὸ ἐλάττονος ὄγκου εἰς μείζονα ἄγει, ἡ δὲ ἀπὸ μείζονος εἰς ἐλάττονα, ἡ μείωσις.", "seq": 5223}
{"id": "Elias_Passim_5224", "series": "CAG", "text": "δοκοῦσι δὲ αὗται αἱ δύο, αὔξησις καὶ μείωσις διακρίσεις πως εἶναι καὶ συγκρίσεις καὶ ἀλλοιώσεις.", "seq": 5224}
{"id": "Elias_Passim_5225", "series": "CAG", "text": "πρὸς ὅ φαμεν ὅτι οὐ ταὐτὸν ἀλλοίωσις καὶ αὔξησις·", "seq": 5225}
{"id": "Elias_Passim_5226", "series": "CAG", "text": "πολλὰ γὰρ αὔξονται μὴ ἀλλοιούμενα·", "seq": 5226}
{"id": "Elias_Passim_5227", "series": "CAG", "text": "τὸ γὰρ τετράγωνον γνώμονος περιτεθέντος ηὔξηται μέν, οὐκ ἠλλοίωται δέ.", "seq": 5227}
{"id": "Elias_Passim_5228", "series": "CAG", "text": "οὐδὲ ἡ μείωσις καὶ ἀλλοίωσις ταὐτόν·", "seq": 5228}
{"id": "Elias_Passim_5229", "series": "CAG", "text": "ἀφαιρεθέντος γὰρ τοῦ αὐτοῦ γνώμονος μεμείωται μὲν τὸ τετράγωνον, οὐκ ἠλλοίωται δέ.", "seq": 5229}
{"id": "Elias_Passim_5230", "series": "CAG", "text": "ἀλλ᾿ οὐ συνᾴδει τὰ νῦν λεγόμενα τοῖς ἐν τῇ Φυσικῇ·", "seq": 5230}
{"id": "Elias_Passim_5231", "series": "CAG", "text": "οὐκ ἂν γὰρ πάσχοι ὁ Ἀριστοτέλης ἐν τῇ Φυσικῇ γενέσθαι αὔξησιν χωρὶς ἀλλοιώσεως·", "seq": 5231}
{"id": "Elias_Passim_5232", "series": "CAG", "text": "τὴν γὰρ αὔξησιν βούλεται καὶ χωρὶς σωμάτων εἶναι μονάδων καὶ κατὰ τὰς τρεῖς γενέσθαι διαστάσεις καὶ ὑπὸ φυσικῆς ψυχῆς.", "seq": 5232}
{"id": "Elias_Passim_5233", "series": "CAG", "text": "οὐ κυρίως οὖν αὔξησις ἐπὶ τετραγώνου οὐδὲ ἐπ᾿ εὐθείας προσθήκην δεξαμένης οὐδὲ ἐπὶ δεξαμενῆς ὕδωρ δεξαμένης εἰς προσθήκην.", "seq": 5233}
{"id": "Elias_Passim_5234", "series": "CAG", "text": "φέρε οὖν ἡμεῖς ταῦτα διακρίνωμεν ἄλλως·", "seq": 5234}
{"id": "Elias_Passim_5235", "series": "CAG", "text": "ἰστέον ὅτι πᾶσαι αἱ κινήσεις δέονται τῆς κατὰ τόπον κινήσεως, καὶ ἡ γένεσις (δεῖ γὰρ καταβληθῆναι τὸ σπέρμα ἐν τῇ μήτρᾳ ἢ ἐν τῇ γῇ), ἀλλὰ καὶ ἡ αὔξησις τῷ πλείονα τόπον καταλαβεῖν, καὶ ἡ μείωσις τῷ ἐλάττονα τόπον καταλαβεῖν, καὶ ἡ ἀλλοίωσις τῷ ἔξω γενέσθαι τὸ θερμὸν περὶ τὴν ἐπιφάνειαν, ὡς ἐπὶ τῶν θυμουμένων, ἢ ἐντός, ὡς ἐπὶ τῶν ὠχριώντων ἢ φοβουμένων.", "seq": 5235}
{"id": "Elias_Passim_5236", "series": "CAG", "text": "οὐκ ἐξ ἀνάγκης οὖν ἡ κατὰ τόπον κίνησις ἡ αὐτὴ ταῖς ἄλλαις, κἂν εἰ πᾶσαι δέωνται αὐτῆς, διὰ τὰ οὐράνια.", "seq": 5236}
{"id": "Elias_Passim_5237", "series": "CAG", "text": "ὁμοίως καὶ τῆς ἀλλοιώσεως πᾶσαι δέονται, ἡ γένεσις ἵνα ποιήσῃ σάρκα, ὀστοῦν καὶ τὰ τοιαῦτα, ἡ αὔξησις ἵνα ποιήσῃ χυμόν, αἷμα, καὶ οὐκ ἤδη ἡ αὐτὴ ταῖς ἄλλαις ἡ ἀλλοίωσις·", "seq": 5237}
{"id": "Elias_Passim_5238", "series": "CAG", "text": "πολλὰ γὰρ ἀλλοιοῦται μὴ αὐξανόμενα, ὡς τὰ λευκαινόμενα ἢ μελαινόμενα, καὶ ὅτι ἀλλοίωσις γίνεται μὲν καὶ ἀπὸ μέρους, ὡς ἡ ἐν ἑνὶ μορίῳ ψώρα, αὔξησις δὲ ἀπὸ μέρους οὐ γίνεται·", "seq": 5238}
{"id": "Elias_Passim_5239", "series": "CAG", "text": "κατὰ γὰρ τὰς τρεῖς γίνεται διαστάσεις.", "seq": 5239}
{"id": "Elias_Passim_5240", "series": "CAG", "text": "15b1 Ἔστι δὲ κινήσει μὲν ἐναντίον ἠρεμία.", "seq": 5240}
{"id": "Elias_Passim_5241", "series": "CAG", "text": "Τρία τινὰ προεθέμεθα ζητῆσαι, τὰ εἴδη τῆς κινήσεως, τὰς διαφορὰς αὐτῶν καὶ τὰ ἐναντία ταῖς κινήσεσιν, ὧν τὰ δύο ἤνυσται ἡμῖν.", "seq": 5241}
{"id": "Elias_Passim_5242", "series": "CAG", "text": "ἀλλ᾿ ἔλθωμεν καὶ ἐπὶ τὸ τρίτον καὶ εἴπωμεν τὰ ἐναντία ταῖς κινήσεσιν.", "seq": 5242}
{"id": "Elias_Passim_5243", "series": "CAG", "text": "ἐναντίον τοίνυν τῇ κινήσει ἡ ἠρεμία, τῇ δὲ τοιᾷδε κινήσει τοιάδε κίνησις.", "seq": 5243}
{"id": "Elias_Passim_5244", "series": "CAG", "text": "ἀλλὰ τῇ μὲν ἁπλῶς κινήσει <ἡ> ἠρεμία μόνη μάχεται διὰ τὸ μὴ εἶναι ἄλλην κίνησιν παρὰ τὴν ἁπλῶς κίνησιν, τῇ δὲ ἀλλοιώσει ἐναντίον ἡ τοιάδε ἀλλοίωσις καὶ τῇ κατὰ τόπον κινήσει ἡ τοιάδε κατὰ τόπον κίνησις ἐναντίον.", "seq": 5244}
{"id": "Elias_Passim_5245", "series": "CAG", "text": "ἐναντίας δὲ κινήσεις λέγει ὁ Ἀριστοτέλης τὰς ἀπὸ τῶν ἐναντίων ἀρχομένας καὶ εἰς τὰ ἐναντία ληγούσας, διὸ ἡ γένεσις τῇ φθορᾷ ἐναντίον (ἡ μὲν γὰρ ἀπὸ τοῦ μὴ ὄντος ἄρχεται καὶ εἰς τὸ ὂν λήγει, ἡ φθορὰ δὲ τοὐναντίον), καὶ ἡ αὔξησις τῇ μειώσει.", "seq": 5245}
{"id": "Elias_Passim_5246", "series": "CAG", "text": "διὸ ἐπὶ κύκλου ἐναντίαι οὐ γίνονται κινήσεις, καὶ <εἰ> ἐπὶ θάτερα γίνεται κίνησις, διὰ τὸ ἀπὸ τοῦ αὐτοῦ ἄρχεσθαι δύνασθαι αὐτὰς καὶ εἰς τὸ αὐτὸ λήγειν.", "seq": 5246}
{"id": "Elias_Passim_5247", "series": "CAG", "text": "δεῖ δὲ εἰδέναι ὅτι ἑκάστην κίνησιν δύο ἠρεμίαι παρασπίζουσιν, ἥ τε ὅθεν ἤρξατο καὶ εἰς ὃ λήγει.", "seq": 5247}
{"id": "Elias_Passim_5248", "series": "CAG", "text": "διὸ ἀποροῦσιν ὅτι ποία μᾶλλον τῶν ἠρεμιῶν μάχεται τῇ κινήσει, ἡ ὅθεν ἤρξατο ἢ εἰς ὃ λήγει.", "seq": 5248}
{"id": "Elias_Passim_5249", "series": "CAG", "text": "καὶ λέγω ὅτι ἡ ὅθεν ἤρξατο, ἐπειδὴ αὕτη μείζων γίνεται προκόπτοντος ἐν τῇ κινήσει τοῦ κινουμένου, μειοῦται δὲ ἀεὶ τὸ διάστημα τὸ μεταξὺ τοῦ κινουμένου καὶ τῆς εἰς ἣν μέλλει λήγειν ἠρεμίας·", "seq": 5249}
{"id": "Elias_Passim_5250", "series": "CAG", "text": "ἐναντία δέ ἐστι τὰ πλεῖστον ἀλλήλων διεστῶτα.", "seq": 5250}
{"id": "Elias_Passim_5251", "series": "CAG", "text": "ἡ πρώτη ἄρα μᾶλλον μάχεται ἠρεμία τῇ κινήσει ἤπερ ἡ εἰς ὃ λήγει.", "seq": 5251}
{"id": "Elias_Passim_5252", "series": "CAG", "text": "ἀποροῦσι δὲ καὶ τοῦτο·", "seq": 5252}
{"id": "Elias_Passim_5253", "series": "CAG", "text": "ὅτι εἰ τῇ κινήσει μάχεται καὶ ἡ ἠρεμία καὶ ἡ τοιάδε κίνησις, πῶς δύο ἀντέταξεν <ἑνὶ> ἡ φύσις;", "seq": 5253}
{"id": "Elias_Passim_5254", "series": "CAG", "text": "πρὸς ὅ φαμεν δύο λύσεις·", "seq": 5254}
{"id": "Elias_Passim_5255", "series": "CAG", "text": "ὅτι κἀνταῦθα δύο δυσὶ μάχονται·", "seq": 5255}
{"id": "Elias_Passim_5256", "series": "CAG", "text": "ὡς μὲν γὰρ κινήσει ἁπλῶς ἡ ἠρεμία μάχεται, ὡς δὲ τοιᾷδε κινήσει ἡ τοιάδε κίνησις.", "seq": 5256}
{"id": "Elias_Passim_5257", "series": "CAG", "text": "ἢ καὶ ἄλλως·", "seq": 5257}
{"id": "Elias_Passim_5258", "series": "CAG", "text": "ὅτι ἓν ἑνὶ μάχεται·", "seq": 5258}
{"id": "Elias_Passim_5259", "series": "CAG", "text": "ἐὰν γὰρ ἡ κίνησις ᾖ κατὰ φύσιν, καὶ ἡ ἠρεμία αὐτῆς παρὰ φύσιν ἐστὶ καὶ ἡ ἀντικειμένη κίνησις.", "seq": 5259}
{"id": "Elias_Passim_5260", "series": "CAG", "text": "ἓν οὖν ἑνὶ μάχεται ὡς τῇ κατὰ φύσιν τὰ παρὰ φύσιν.", "seq": 5260}
{"id": "Elias_Passim_5261", "series": "CAG", "text": "καὶ ταῦτα μὲν περὶ κινήσεως.", "seq": 5261}
{"id": "Elias_Passim_5262", "series": "CAG", "text": "Ἐφ᾿ οἷς διαλέγεται καὶ περὶ τοῦ ἔχειν, οὐ τοῦ ποιοῦντος μίαν τῶν κατηγοριῶν·", "seq": 5262}
{"id": "Elias_Passim_5263", "series": "CAG", "text": "ἄτοπον γὰρ ἐν τῷ τρίτῳ τμήματι μετὰ τὰς κατηγορίας περὶ τῶν κατηγοριῶν πάλιν διαλέγεσθαι ἄλλως τε καὶ αὐτοῦ διαρρήδην εἰπόντος ἐπὶ τῶν συνθέτων ἓξ κατηγοριῶν μηδὲν πλέον ἔχειν εἰπεῖν ἢ ὅσα περὶ αὐτῶν εἴρηται καὶ ἀνωτέρω.", "seq": 5263}
{"id": "Elias_Passim_5264", "series": "CAG", "text": "διαλέγεται οὖν περὶ <τῆς> τοῦ ἔχειν ὁμωνύμου φωνῆς τῆς καὶ τὴν κατηγορίαν περιεχούσης.", "seq": 5264}
{"id": "Elias_Passim_5265", "series": "CAG", "text": "ἓξ δὲ σημαινόμενα τοῦ ἔχειν·", "seq": 5265}
{"id": "Elias_Passim_5266", "series": "CAG", "text": "λεγόμεθα γὰρ ποσότητα ἔχειν, ὡς δίπηχυ ἢ τρίπηχυ μέγεθος, λεγόμεθα ποιότητα ἔχειν, λευκότητα ἢ μελανίαν.", "seq": 5266}
{"id": "Elias_Passim_5267", "series": "CAG", "text": "καὶ δύο σημαινόμενα τῆς τοῦ ἔχειν κατηγορίας τὸ ὅλον περὶ ὅλον καὶ ὅλον περὶ μέρος.", "seq": 5267}
{"id": "Elias_Passim_5268", "series": "CAG", "text": "ἄλλο σημαινόμενον τοῦ ἔχειν πέμπτον τὸ ἔχειν τὸν μέδιμνον τοὺς πυρούς.", "seq": 5268}
{"id": "Elias_Passim_5269", "series": "CAG", "text": "ἕκτον σημαινόμενον τοῦ ἔχειν, καθ᾿ ὃ λέγομεν τὸν ἄνδρα γυναῖκα ἔχειν καὶ τὴν γυναῖκα ἄνδρα.", "seq": 5269}
{"id": "Elias_Passim_5270", "series": "CAG", "text": "ἐκβάλλει δὲ τοῦτον τὸν τρόπον τοῦ ἔχειν ὡς ἀλλότριον·", "seq": 5270}
{"id": "Elias_Passim_5271", "series": "CAG", "text": "ἄλλο γὰρ δεῖ ἔχειν τὸ ἔχον παρὰ τὸ ἐχόμενον, οὐδὲν δὲ μᾶλλον ἡ γυνὴ ἔχει τὸν ἄνδρα ἢ ὁ ἀνὴρ τὴν γυναῖκα.", "seq": 5271}
{"id": "Elias_Passim_5272", "series": "CAG", "text": "ταῦτα ἔχει ἡ πρᾶξις.", "seq": 5272}
{"id": "Elias_Passim_5273", "series": "CAG", "text": "συγκαταπαύεται δὲ αὐτῇ σὺν θεῷ καὶ τὰ σχόλαια τῶν Κατηγοριῶν.", "seq": 5273}
