{"id": "Elias_Passim_1412", "series": "CAG", "text": "13 Διὸ ἄχρι τῶν εἰδικωτάτων ἀπὸ τῶν γενικωτάτων κατιόντας παρεκελεύετο ὁ Πλάτων παύεσθαι.", "seq": 1412}
{"id": "Elias_Passim_1413", "series": "CAG", "text": "Ἐνταῦθα δηλοῖ τὸ πρῶτον διαιρετικὸν παράγγελμα τὸ λέγον δεῖν τὰς διαιρέσεις ἀπὸ τῶν γενικωτάτων μέχρι τῶν εἰδικωτάτων προάγειν καὶ μὴ ἅπτεσθαι τῶν ἀτόμων.", "seq": 1413}
{"id": "Elias_Passim_1414", "series": "CAG", "text": "ἡ μέντοι σύνταξις καθ᾿ ὑπέρβατόν ἐστιν.", "seq": 1414}
{"id": "Elias_Passim_1415", "series": "CAG", "text": "6.", "seq": 1415}
{"id": "Elias_Passim_1416", "series": "CAG", "text": "15 Κατιέναι δὲ διὰ τῶν διὰ μέσου.", "seq": 1416}
{"id": "Elias_Passim_1417", "series": "CAG", "text": "Πάλιν τὸ δεύτερον δηλοῖ διαιρετικὸν παράγγελμα τὸ λέγον ὅτι οὐ δεῖ ὑπερβάθμιον πόδα τείνειν καὶ ἀπὸ τῶν γενικωτάτων ἔρχεσθαι ἐπὶ τὰ εἰδικώτατα ὑπερβαίνοντα τὰ μέσα.", "seq": 1417}
{"id": "Elias_Passim_1418", "series": "CAG", "text": "6.", "seq": 1418}
{"id": "Elias_Passim_1419", "series": "CAG", "text": "15 Διαιροῦντας ταῖς εἰδοποιοῖς διαφοραῖς.", "seq": 1419}
{"id": "Elias_Passim_1420", "series": "CAG", "text": "Ἐνταῦθα τὴν τρίτην ἐσήμανε διαιρετικὴν μέθοδον τὴν λέγουσαν συμβεβηκυίαις διαφοραῖς μὴ τέμνειν τὰ καθόλου, ἀλλ᾿ οὐσιώδεσιν.", "seq": 1420}
{"id": "Elias_Passim_1421", "series": "CAG", "text": "6.", "seq": 1421}
{"id": "Elias_Passim_1422", "series": "CAG", "text": "16 Τὰ δὲ ἄτομά φησιν ἐᾶν.", "seq": 1422}
{"id": "Elias_Passim_1423", "series": "CAG", "text": "Τὸ ἄτομον πολλὰ σημαίνει·", "seq": 1423}
{"id": "Elias_Passim_1424", "series": "CAG", "text": "ἄτομον γὰρ ἢ τὸ δυσδιαίρετον, ὡς ἀδάμας, ἢ τὸ μὴ ἐπιδεχόμενον διαίρεσιν, ὡς τὸ σημεῖον, ἢ τὸ μικρότατον, ὡς ὁ κόκκος τῆς ψάμμου, ἢ τὸ μὴ σωζόμενον ἐν τῇ διαιρέσει ἀλλὰ φθειρόμενον, ὡς εἴ τις τὸν Σωκράτην διέλοι ἐνεργείᾳ εἰς χεῖρας καὶ πόδας, καθ᾿ ὃ σημαινόμενον νῦν δεῖ ἀκοῦσαι τὸ ἄτομον.", "seq": 1424}
{"id": "Elias_Passim_1425", "series": "CAG", "text": "<Πρᾶξις κζ'>.", "seq": 1425}
{"id": "Elias_Passim_1426", "series": "CAG", "text": "6.", "seq": 1426}
{"id": "Elias_Passim_1427", "series": "CAG", "text": "16 Κατιόντων μὲν οὖν εἰς τὰ εἰδικώτατα ἀνάγκη διαιροῦντας διὰ πλήθους ἰέναι, ἀνιόντων δὲ εἰς τὰ γενικώτατα ἀνάγκη συναιρεῖν τὸ πλῆθος.", "seq": 1427}
{"id": "Elias_Passim_1428", "series": "CAG", "text": "Ὑποσχόμενος ὁ Πορφύριος δύο παραδείγμασιν ὑποβάλλειν τὰ γενικώτατα καὶ ὑπάλληλα καὶ εἰδικώτατα, ἑνὶ μὲν ἀπὸ τῶν κατηγοριῶν ἑτέρῳ δὲ ἀπὸ τῶν γενεαλογιῶν, δείξας ὅτι οὐχ ὥσπερ ἐπὶ τῶν γενεαλογιῶν εἰς ἕνα ἀνάγεται τὸν Δία, οὕτως καὶ ἐπὶ τῶν κατηγοριῶν δυνατόν, ἐπειδὴ οὐ γένος τῶν κατηγοριῶν τὸ ὄν (διὰ δὲ τοῦ ἀπὸ τῶν κατηγοριῶν τέσσαρά τινα λογικὰ προβλήματα ἐξητάσαμεν), ἐνταῦθα οὖν ἐπὶ τῆς παρούσης θεωρίας μέχρι πέρατος τῶν περὶ τοῦ εἴδους λόγων τέσσαρά τινα λογικὰ θεωρήματα ζητεῖ·", "seq": 1428}
{"id": "Elias_Passim_1429", "series": "CAG", "text": "πρῶτον μὲν ὅτι τεσσάρων ὄντων γενικωτάτων ὑπαλλήλων εἰδικωτάτων καὶ ἀτόμων καὶ δύο ἄκρων ἐν τούτοις θεωρουμένων, γενικωτάτων καὶ ἀτόμων, δύο ἔξεστί σοι ὁδοὺς βαδίζειν, τὴν μὲν ἀπὸ τῶν γενικωτάτων ἐπὶ τὰ ἄτομα τὴν δὲ ἀπὸ τῶν ἀτόμων ἐπὶ τὰ γενικώτατα, καὶ ὄνομα τῇ μὲν τῶν ὁδῶν κάθοδος τῇ δὲ τῶν ὁδῶν ἄνοδος, καὶ ἔοικεν ἡ μὲν κάθοδος τῇ ἀπὸ μονάδος ἐπὶ δεκάδα, ἡ δὲ ἄνοδος τῇ ἀπὸ δεκάδος ἐπὶ μονάδα·", "seq": 1429}
{"id": "Elias_Passim_1430", "series": "CAG", "text": "ἡ μὲν γὰρ κάθοδος τὸ ἓν πολλὰ ποιεῖ, ἡ δὲ ἄνοδος τὰ πολλὰ ἓν ποιεῖ.", "seq": 1430}
{"id": "Elias_Passim_1431", "series": "CAG", "text": "καὶ ἄμεινον τὰ πολλὰ ἓν ποιεῖν ἢ τὸ ἓν πολλά, ἐπειδὴ καὶ τὸ συνιστᾶν τοῦ διαιρεῖν πολὺ ἄμεινον καὶ τὸ σώζειν τοῦ φθείρειν, ὡς δηλοῦσι καὶ οἱ ἅμα σταθμιζόμενοι χρυσοῖ πλείονα ὁλκὴν εἰσάγοντες τῆς ἀπὸ ἑκάστου ἰδίας συναγομένης ὁλκῆς.", "seq": 1431}
{"id": "Elias_Passim_1432", "series": "CAG", "text": "τὸ μὲν τὸ πρῶτον.", "seq": 1432}
{"id": "Elias_Passim_1433", "series": "CAG", "text": "δεύτερον ὅτι τεσσάρων ὄντων γενικωτάτων ὑπαλλήλων εἰδικωτάτων καὶ ἀτόμων τὸ μὲν γενικώτατον μοναχῶς κατηγορεῖται, τὸ δὲ ἄτομον μοναχῶς ὑπόκειται, τὰ δὲ μέσα καὶ κατηγορεῖται καὶ ὑπόκειται.", "seq": 1433}
{"id": "Elias_Passim_1434", "series": "CAG", "text": "καὶ τὸ μὲν γενικώτατον τριχῶς κατηγορεῖται, ὑπαλλήλων εἰδικωτάτων καὶ ἀτόμων, τὸ δὲ ἄτομον τριχῶς ὑπόκειται, εἰδικωτάτῳ ὑπαλλήλῳ καὶ γενικωτάτῳ, τὰ δὲ μέσα κατηγορεῖται καὶ ὑπόκειται, ἀλλ᾿ οὐχ ὁμοίως·", "seq": 1434}
{"id": "Elias_Passim_1435", "series": "CAG", "text": "τὰ μὲν γὰρ ὑπάλληλα μοναχῶς ὑπόκειται (τοῖς γενικωτάτοις γὰρ μόνον), διχῶς δὲ κατηγορεῖται (εἰδικωτάτων γὰρ καὶ ἀτόμων), τὰ δὲ εἰδικώτατα πᾶν τοὐναντίον διχῶς μὲν ὑπόκειται (γενικωτάτοις γὰρ καὶ ὑπαλλήλοις), μοναχῶς δὲ κατηγορεῖται·", "seq": 1435}
{"id": "Elias_Passim_1436", "series": "CAG", "text": "ἀτόμων γὰρ μόνον.", "seq": 1436}
{"id": "Elias_Passim_1437", "series": "CAG", "text": "τοῦτο δεύτερον.", "seq": 1437}
{"id": "Elias_Passim_1438", "series": "CAG", "text": "τρίτον ὅτι τεσσάρων ὄντων, ὡς εἴρηται, γενικωτάτων ὑπαλλήλων εἰδικωτάτων καὶ ἀτόμων, τὸ μὲν γενικώτατον καὶ ὑπάλληλον καὶ εἰδικώτατον ὑπεγράφη, τὸ δὲ ἄτομον οὐχ ὑπεγράφη.", "seq": 1438}
{"id": "Elias_Passim_1439", "series": "CAG", "text": "διὸ νῦν καὶ τὸ ἄτομον ὑπογράφει λέγων οὕτως·", "seq": 1439}
{"id": "Elias_Passim_1440", "series": "CAG", "text": "ἄτομόν ἐστιν τὸ ἐξ ἰδιοτήτων συστάν, ὧν τὸ ἄθροισμα οὐκ ἂν ἐπ᾿ ἄλλου ποτὲ τὸ αὐτὸ γένοιτο, ὥσπερ καὶ αἱ ἰδιότητες τοῦ Σωκράτους τὸ Ἀθηναῖον εἶναι, τὸ Σωφρονίσκου υἱόν, τὸ φιλόσοφον, τὸ προκοίλιον, τὸ σιμόν, τὸ φαλακρόν·", "seq": 1440}
{"id": "Elias_Passim_1441", "series": "CAG", "text": "ταῦτα γὰρ πάντα ἅμα ἄλλῳ ὑπάρξαι οὐ δύνανται.", "seq": 1441}
{"id": "Elias_Passim_1442", "series": "CAG", "text": "εἰ δὲ ἐρεῖς ὅτι ‘καὶ ἄλλῳ δύνανται ταῦτα ὑπάρξαι·", "seq": 1442}
{"id": "Elias_Passim_1443", "series": "CAG", "text": "τί γὰρ ἄτοπον;", "seq": 1443}
{"id": "Elias_Passim_1444", "series": "CAG", "text": "οὐ δήπου καὶ τὸ ἐν αὐτῷ τῷ τόπῳ ἑστάναι·", "seq": 1444}
{"id": "Elias_Passim_1445", "series": "CAG", "text": "ἓν γὰρ ὂν τῶν συμβεβηκότων τῷ Σωκράτει οὐ δύναται καὶ ἄλλῳ ὑπάρξαι, ἵνα οἱ δύο ἐν τῷ αὐτῷ χρόνῳ καὶ ἐν τῷ αὐτῷ τόπῳ σταῖεν, ἵνα μὴ χωρήσῃ σῶμα διὰ σώματος.", "seq": 1445}
{"id": "Elias_Passim_1446", "series": "CAG", "text": "τοῦτο τρίτον.", "seq": 1446}
{"id": "Elias_Passim_1447", "series": "CAG", "text": "τέταρτον ὅτι τεσσάρων ὄντων γενικωτάτων ὑπαλλήλων εἰδικωτάτων ἀτόμων τὸ μὲν γενικώτατον μόνως ὅλον, τὸ δὲ ἄτομον μόνως μέρος, τὰ δὲ μέσα ὅλα καὶ μέρη, ὅλα μὲν τῶν ὑποκάτω μέρη δὲ τῶν ἐπάνω, καὶ ὅτι τὸ μὲν ὅλον μερῶν ὅλον καὶ οὐ μέρους (πολλὰ γὰρ τὰ μέρη, εἴ γε τὸ διαιρούμενον τοὐλάχιστον εἰς δύο διαιρεῖται), τὰ δὲ μέρη ὅλου μέρη·", "seq": 1447}
{"id": "Elias_Passim_1448", "series": "CAG", "text": "ἓν γὰρ τὸ ὅλον.", "seq": 1448}
{"id": "Elias_Passim_1449", "series": "CAG", "text": "ταῦτα ἔχει ἡ θεωρία.", "seq": 1449}
{"id": "Elias_Passim_1450", "series": "CAG", "text": "δεῖ δὲ εἰδέναι ὅτι τινὲς τῶν ἀρχαιοτέρων τὴν μὲν διαίρεσιν τὴν ἐκ γένους τοῦ γενικωτάτου μέχρις ἀτόμων γινομένην διαίρεσιν συνθετικὴν ἐκάλεσαν, τὴν δὲ ἐξ ἀτόμων μέχρι τοῦ γενικωτάτου γένους χωροῦσαν συναίρεσιν ἀναλυτικὴν προσηγόρευσαν·", "seq": 1450}
{"id": "Elias_Passim_1451", "series": "CAG", "text": "ἀπὸ γάρ, φασίν, ἁπλοῦ κατ᾿ ἐνέργειαν τοῦ γένους τοῦ γενικωτάτου χωρεῖ ἡ διαιρετικὴ συνθετικὴ ἐπί τι σύνθετον κατ᾿ ἐνέργειαν πρᾶγμα τὸν Σωκράτη, ἀπὸ δὲ τοῦ κατ᾿ ἐνέργειαν συνθέτου Σωκράτους ἀνάγεται ἡ ἀναλυτικὴ ἐπί τι ἁπλοῦν κατ᾿ ἐνέργειαν τὸ γένος τὸ γενικώτατον.", "seq": 1451}
{"id": "Elias_Passim_1452", "series": "CAG", "text": "<πρὰξις κη'>", "seq": 1452}
{"id": "Elias_Passim_1453", "series": "CAG", "text": "Περὶ διαφορᾶς.", "seq": 1453}
{"id": "Elias_Passim_1454", "series": "CAG", "text": "8.", "seq": 1454}
{"id": "Elias_Passim_1455", "series": "CAG", "text": "8 Διαφορὰ δὲ κοινῶς <τε καὶ ἰδίως> ἰδιαίτατα λεγέσθω.", "seq": 1455}
{"id": "Elias_Passim_1456", "series": "CAG", "text": "Μετὰ τὰ ἐν τῷ τί ἐστι κατηγορούμενα ἔλθωμεν καὶ ἐπὶ τὰ ἐν τῷ ποῖόν τί ἐστι κατηγορούμενα, τοῦτ᾿ ἔστι μετὰ τὸ γένος καὶ τὸ εἶδος ἔλθωμεν καὶ ἐπὶ τὴν διαφορὰν καὶ τὸ ἴδιον καὶ τὸ συμβεβηκός.", "seq": 1456}
{"id": "Elias_Passim_1457", "series": "CAG", "text": "ἢ καὶ ἄλλως·", "seq": 1457}
{"id": "Elias_Passim_1458", "series": "CAG", "text": "μετὰ τὰ ἄκρα, φημὶ γένος καὶ εἶδος, ἔλθωμεν καὶ ἐπὶ τὴν μέσην τούτων διαφοράν·", "seq": 1458}
{"id": "Elias_Passim_1459", "series": "CAG", "text": "μέση γὰρ τούτων ἡ διαφορὰ ὡς τὸ μὲν γένος διαιροῦσα, τὸ δὲ εἶδος συμπληροῦσα.", "seq": 1459}
{"id": "Elias_Passim_1460", "series": "CAG", "text": "καὶ ἔχομεν διὰ μὲν τοῦ πρώτου τὴν τάξιν τῶν πέντε, γένους εἴδους διαφορᾶς ἰδίου καὶ συμβεβηκότος (προηγεῖται γὰρ ἀεὶ τὸ τί ἐστι τοῦ ὁποῖόν τί ἐστι), διὰ δὲ τοῦ ἑτέρου τὴν τάξιν τῶν τριῶν, εἴδους καὶ γένους καὶ μέσης τούτων τῆς διαφορᾶς.", "seq": 1460}
{"id": "Elias_Passim_1461", "series": "CAG", "text": "ἀλλ᾿ ἐπεὶ καὶ ἡ διαφορὰ ὁμώνυμος φωνή ἐστιν (ἐν γὰρ ταῖς δέκα κατηγορίαις θεωρεῖται), εἴπωμεν κἀνταῦθα τῷ ἀνωτέρω κανόνι χρώμενοι πρῶτον μὲν τὰ σημαινόμενα, δεύτερον περὶ ποίου σημαινομένου ὁ λόγος, τρίτον ὑπογραφῆς ἀξιώσομεν τοῦτο τὸ σημαινόμενον.", "seq": 1461}
{"id": "Elias_Passim_1462", "series": "CAG", "text": "Ἡ διαφορὰ τοίνυν τριχῶς.", "seq": 1462}
{"id": "Elias_Passim_1463", "series": "CAG", "text": "καὶ λέγομεν ὅτι εὐλόγως, ἐπειδὴ πάντα τὰ ὄντα ἢ οὐσία ἢ συμβεβηκός, τὸ δὲ συμβεβηκὸς διττόν, ἢ ἀχώριστον ἢ χωριστόν·", "seq": 1463}
{"id": "Elias_Passim_1464", "series": "CAG", "text": "τὰ μὲν οὖν τῷ χωριστῷ συμβεβηκότι διαφέροντα τῇ κοινῶς διαφορᾷ λέγονται διαφέρειν, ὡς τὸ καθέζεσθαι τοῦ ἑστάναι, τὰ δὲ τῷ ἀχωρίστῳ συμβεβηκότι διαφέροντα τῇ ἰδίως διαφορᾷ λέγονται διαφέρειν, ὡς τὸ σιμὸν τοῦ γρυποῦ, τὰ δὲ τῇ οὐσίᾳ διαφέροντα τῇ ἰδιαίτατα διαφορᾷ διαφέρουσιν, ὡς τὸ λογικὸν καὶ ἄλογον.", "seq": 1464}
{"id": "Elias_Passim_1465", "series": "CAG", "text": "ἐφ᾿ οἷς τούτων οὕτως ἐχόντων εἴπωμεν δι᾿ ἣν αἰτίαν τοιούτων ἔτυχον ὀνομάτων καὶ ἡ μὲν λέγεται κοινῶς, ἡ δὲ ἰδίως, ἡ δὲ ἰδιαίτατα.", "seq": 1465}
{"id": "Elias_Passim_1466", "series": "CAG", "text": "καὶ λέγομεν ὅτι ἡ κοινῶς διαφορὰ εἴρηται διὰ τοιαύτην αἰτίαν, ἐπειδὴ ἐνδέχεται τὰ ἀντικείμενα ἐνεργείᾳ τῷ αὐτῷ ὑποκειμένῳ ὑπάρξαι, ὡς τὸ καθέζεσθαι καὶ τὸ ἑστάναι τῷ Σωκράτει, εἰ καὶ μὴ κατὰ τὸν αὐτὸν χρόνον.", "seq": 1466}
{"id": "Elias_Passim_1467", "series": "CAG", "text": "ἰδίως δὲ διαφορὰ εἴρηται διὰ τὸ μὴ δύνασθαι ἐνεργείᾳ ὑπάρξαι τῷ αὐτῷ τὰ ἀντικείμενα κατὰ τὸν αὐτὸν χρόνον μήτε ἐν ἄλλῳ χρόνῳ, ὡς τὸ σιμὸν καὶ τὸ γρυπόν·", "seq": 1467}
{"id": "Elias_Passim_1468", "series": "CAG", "text": "οὔτε γὰρ ὁ γρυπὸς σιμός ποτε γίνεται οὔτε ὁ σιμὸς γρυπὸς χωρὶς φθορᾶς τοῦ ὑποκειμένου.", "seq": 1468}
{"id": "Elias_Passim_1469", "series": "CAG", "text": "καλῶς δὲ εἴρηται καὶ τὸ ἐνεργείᾳ·", "seq": 1469}
{"id": "Elias_Passim_1470", "series": "CAG", "text": "ἐπινοίᾳ γὰρ ἐνδέχεται τὰ ἀντικείμενα ὑπάρξαι τινί, καθά φησι καὶ αὐτὸς ὁ Πορφύριος ὅτι ‘δύναται ἐπινοηθῆναι κόραξ λευκὸς καὶ Αἰθίοψ ἀποβάλλοντες τὴν χροιὰν χωρὶς φθορᾶς τοῦ ὑποκειμένου’ διὰ τὸ μηδὲν εἰς τὴν οὐσίαν τοῦ πράγματος συντείνειν τὸ χρῶμα.", "seq": 1470}
{"id": "Elias_Passim_1471", "series": "CAG", "text": "ἰδιαίτατα δὲ εἴρηται διαφορὰ διὰ τὸ μηδὲ ἐπινοίᾳ μηδὲ ἐνεργείᾳ δύνασθαι συστῆναι τὰ ἀντικείμενα ἐν ἑνὶ ὑποκειμένῳ·", "seq": 1471}
{"id": "Elias_Passim_1472", "series": "CAG", "text": "τὸ γὰρ λογικὸν οὐκ ἐπινοεῖται ἄλογον ἢ τὸ ἄλογον λογικόν.", "seq": 1472}
{"id": "Elias_Passim_1473", "series": "CAG", "text": "ἰδιαίτατα δέ ἐστι τὸ ἐπιτεταμένον ἰδίως.", "seq": 1473}
{"id": "Elias_Passim_1474", "series": "CAG", "text": "αὕτη πρώτη αἰτία τοῦ τριττοῦ εἴδους τῆς διαφορᾶς.", "seq": 1474}
{"id": "Elias_Passim_1475", "series": "CAG", "text": "δευτέρα τοιαύτη αἰτία, ὅτι ἡ διαφορὰ ἢ ἀλλοποιός ἐστιν ἢ ἀλλοιοποιός, καὶ εἰ μὲν ἀλλοποιός, ποιεῖ τὴν ἰδιαίτατα (τὰ γὰρ τῇ οὐσίᾳ διαφέροντα ἄλλα καὶ οὐκ ἀλλοῖα λέγονται), ἡ δὲ ἀλλοιοποιὸς ἢ χωριστή ἐστι καὶ ποιεῖ τὴν κοινῶς, ἢ ἀχώριστος καὶ ποιεῖ τὴν ἰδίως·", "seq": 1475}
{"id": "Elias_Passim_1476", "series": "CAG", "text": "τὰ γὰρ συμβεβηκότι διαφέροντα, οἷον σχήμασιν ἢ ἐσθῆτι, ἀλλοῖα.", "seq": 1476}
{"id": "Elias_Passim_1477", "series": "CAG", "text": "διὸ καὶ ὁ ποιητὴς καὶ περὶ τοῦ Ὀδυσσέως μεταμφιεσαμένου τὴν ἐσθῆτα λέγει·", "seq": 1477}
{"id": "Elias_Passim_1478", "series": "CAG", "text": "ἀλλοῖός μοι, ξεῖνε, φάνης νέον ἢ τὸ πάροιθεν.", "seq": 1478}
{"id": "Elias_Passim_1479", "series": "CAG", "text": "διαφέρει δὲ αὕτη ἡ αἰτία τῆς πρώτης, ὅτι ἡ μὲν πρώτη εἰς οὐσίαν καὶ συμβεβηκὸς διεῖλεν, αὕτη δὲ εἰς οὐσιῶδες καὶ ἐπεισοδιῶδες·", "seq": 1479}
{"id": "Elias_Passim_1480", "series": "CAG", "text": "ἄλλο δὲ οὐσία καὶ ἄλλο οὐσιῶδες, ὥσπερ ἄλλο συμβεβηκὸς καὶ ἄλλο κατὰ συμβεβηκός·", "seq": 1480}
{"id": "Elias_Passim_1481", "series": "CAG", "text": "οὐσιώδης μὲν γὰρ ἡ τοῦ πυρὸς θερμότης, οὐσία δὲ οὐκ ἔστιν.", "seq": 1481}
{"id": "Elias_Passim_1482", "series": "CAG", "text": "πάλιν δὲ ἐνδέχεται καὶ οὐσίαν κατὰ συμβεβηκὸς ὑπάρξαι, ὥς φησιν ἐν Κατηγορίαις Ἀριστοτέλης, ὅτι συνέβη τῷ δεσπότῃ καὶ ἄνθρωπον αὐτὸν εἶναι.", "seq": 1482}
{"id": "Elias_Passim_1483", "series": "CAG", "text": "λέγεται οὖν καὶ οὐσία κατὰ συμβεβηκὸς μὴ οὖσα συμβεβηκός.", "seq": 1483}
{"id": "Elias_Passim_1484", "series": "CAG", "text": "αὕτη ἡ δευτέρα αἰτία.", "seq": 1484}
{"id": "Elias_Passim_1485", "series": "CAG", "text": "τρίτη αἰτία, ὅτι ἡ διαφορὰ ἢ χωριστὴ ἢ ἀχώριστος, καὶ εἰ μὲν χωριστή, ποιεῖ τὴν κοινῶς, εἰ δὲ ἀχώριστος, ἢ ἐπεισοδιώδης καὶ ποιεῖ τὴν ἰδίως, ἢ οὐσιώδης καὶ ποιεῖ τὴν ἰδιαίτατα.", "seq": 1485}
{"id": "Elias_Passim_1486", "series": "CAG", "text": "διαφέρει δὲ καὶ αὕτη τῶν πρώτων δύο, ὅτι ἐκεῖναι ἀπὸ ἑνὸς σκέλους κατάγουσι τὴν κοινῶς καὶ ἰδίως (καὶ εὐλόγως, ἐπειδὴ κοινὸν αὐτῶν τὸ συμβεβηκός), αὕτη δὲ ἀπὸ ἑνὸς σκέλους τὴν ἰδίως καὶ ἰδιαίτατα κατάγει·", "seq": 1486}
{"id": "Elias_Passim_1487", "series": "CAG", "text": "κοινὸν γὰρ ἔχουσι τὸ ἀχώριστον.", "seq": 1487}
{"id": "Elias_Passim_1488", "series": "CAG", "text": "Ἀλλ᾿ οὐ μέχρι τούτων τὰ σημαινόμενα τῆς διαφορᾶς·", "seq": 1488}
{"id": "Elias_Passim_1489", "series": "CAG", "text": "καὶ ἡ κοινῶς γὰρ διαφορὰ ἐπιδιαιρεῖται καὶ αἱ λοιπαὶ ὁμοίως.", "seq": 1489}
{"id": "Elias_Passim_1490", "series": "CAG", "text": "καὶ ἡ μὲν κοινῶς οὕτως·", "seq": 1490}
{"id": "Elias_Passim_1491", "series": "CAG", "text": "ἢ γὰρ ταῖς ἡλικίαις παραμετρεῖται, ὡς τὸ βατταρίζειν καὶ γενειάσκειν καὶ ἡβάσκειν, ἢ ἀορίστως ὑπάρχει καὶ οὐ συμπαραμετρεῖται ταῖς ἡλικίαις, ὡς τὸ λευκαίνεσθαι καὶ μελαίνεσθαι.", "seq": 1491}
{"id": "Elias_Passim_1492", "series": "CAG", "text": "ἀλλὰ καὶ ἡ ἰδίως·", "seq": 1492}
{"id": "Elias_Passim_1493", "series": "CAG", "text": "ἢ γὰρ συντίκτεται τῷ πράγματι, ὡς γρυπότης καὶ σιμότης, ἢ ὕστερον ἐπιγίνεται, ὡς οὐλὴ ἐκ τραύματος ἐνσκιρωθεῖσα, οἵα ἡ τοῦ Ὀδυσσέως, δι᾿ ἧς ἐπέγνω αὐτὸν ἡ Εὐρύκλεια.", "seq": 1493}
{"id": "Elias_Passim_1494", "series": "CAG", "text": "ἀλλὰ καὶ ἡ ἰδιαίτατα διαφορὰ ἐπιδιαιρεῖται·", "seq": 1494}
{"id": "Elias_Passim_1495", "series": "CAG", "text": "ἢ γὰρ διαιρετική ἐστιν ἢ συστατική, διαιρετικὴ μὲν ἡ διαιροῦσα τὸ γένος, συστατικὴ δὲ ἡ ποιοῦσα τοὺς ὁρισμούς.", "seq": 1495}
{"id": "Elias_Passim_1496", "series": "CAG", "text": "μετὰ οὖν τὸ γνῶναι ἡμᾶς τὰ σημαινόμενα εἴπωμεν περὶ ποίου σημαινομένου ἐστὶ τῷ φιλοσόφῳ ὁ λόγος.", "seq": 1496}
{"id": "Elias_Passim_1497", "series": "CAG", "text": "καὶ λέγομεν ὅτι οὐδὲ περὶ τῆς κοινῶς οὐδὲ περὶ τῆς ἰδίως σκοπὸν ἔχει διαλαβεῖν, ἀλλὰ περὶ τῆς ἰδιαίτατα, καὶ ταῦτα περὶ ὅλων αὐτῆς τῶν εἰδῶν καὶ τῶν διαιρετικῶν καὶ τῶν συστατικῶν·", "seq": 1497}
{"id": "Elias_Passim_1498", "series": "CAG", "text": "δεόμεθα γὰρ τῶν μὲν διαιρετικῶν εἰς τὰς τῶν γενῶν διαιρέσεις, τῶν δὲ συστατικῶν εἰς τοὺς ὁρισμούς.", "seq": 1498}
{"id": "Elias_Passim_1499", "series": "CAG", "text": "ταῦτα μὲν περὶ τοῦ σημαινομένου.", "seq": 1499}
{"id": "Elias_Passim_1500", "series": "CAG", "text": "ὅπως δὲ τοῦτο καὶ ὑπογραφῆς ἀξιοῖ, ἡ ἑξῆς θεωρία παραστήσει.", "seq": 1500}
{"id": "Elias_Passim_1501", "series": "CAG", "text": "<Πρᾶξις κθ'>.", "seq": 1501}
{"id": "Elias_Passim_1502", "series": "CAG", "text": "8.", "seq": 1502}
{"id": "Elias_Passim_1503", "series": "CAG", "text": "8 Διαφορὰ δὲ κοινῶς τε καὶ ἰδίως καὶ ἰδιαίτατα λεγέσθω.", "seq": 1503}
{"id": "Elias_Passim_1504", "series": "CAG", "text": "Καλῶς εἶπε λεγέσθω·", "seq": 1504}
{"id": "Elias_Passim_1505", "series": "CAG", "text": "αὐτοῦ γάρ εἰσι τὰ ὀνόματα, τὸ κοινῶς καὶ ἰδίως καὶ ἰδιαίτατα·", "seq": 1505}
{"id": "Elias_Passim_1506", "series": "CAG", "text": "ἐν γὰρ τῇ Τοπικῇ πραγματείᾳ, ἧς τόδε τὸ βιβλίον συναγωγή, οὐ μέμνηται Ἀριστοτέλης τούτων τῶν ὀνομάτων·", "seq": 1506}
{"id": "Elias_Passim_1507", "series": "CAG", "text": "ὅπου δὲ κεῖνται παλαιὰ ὀνόματα, κέχρηται αὐτοῖς ὁ Πορφύριος λέγων οὕτω ‘λέγονται’ καὶ ‘λέγουσιν’ ἀντὶ τοῦ ἐκεῖ.", "seq": 1507}
{"id": "Elias_Passim_1508", "series": "CAG", "text": "9.", "seq": 1508}
{"id": "Elias_Passim_1509", "series": "CAG", "text": "16 Καὶ αἱ μὲν καθ᾿ αὑτὸ οὐκ ἐπιδέχονται τὸ μᾶλλον καὶ ἧττον, αἱ δὲ κατὰ συμβεβηκός, κἂν ἀχώριστοι ὦσιν, ἐπίτασιν λαμβάνουσι.", "seq": 1509}
{"id": "Elias_Passim_1510", "series": "CAG", "text": "Διακρίνας ὁ Πορφύριος τὰ τρία εἴδη τῆς διαφορᾶς, τὴν κοινῶς καὶ ἰδίως καὶ ἰδιαίτατα, καὶ ὡς τρία διακρίνας αὐτά, νῦν καὶ ὡς δύο διακρίνει τὴν κοινῶς καὶ ἰδίως ἀπὸ τῆς ἰδιαίτατα, τοῦτ᾿ ἔστι διακρίνει τὰς ἐν τῇ συνηθείᾳ ἀπὸ τῶν κατὰ φιλοσοφίαν, καί φησιν ὅτι ἄλλαι εἰσὶν αἱ κοινῶς καὶ ἰδίως καὶ ἄλλαι αἱ ἰδιαίτατα, διότι αἱ κοινῶς καὶ ἰδίως τὸ μᾶλλον καὶ τὸ ἧττον ἐπιδέχονται (λέγομεν γὰρ μᾶλλον λευκὸν καὶ ἧττον λευκόν, καὶ ἔστι κοινῶς διαφορά·", "seq": 1510}
{"id": "Elias_Passim_1511", "series": "CAG", "text": "χωρίζεται γάρ·", "seq": 1511}
{"id": "Elias_Passim_1512", "series": "CAG", "text": "ἀλλὰ καὶ αἱ ἰδίως ἐπιδέχονται τὸ μᾶλλον καὶ ἧττον·", "seq": 1512}
{"id": "Elias_Passim_1513", "series": "CAG", "text": "λέγομεν γὰρ μᾶλλον γρυπὸν καὶ ἧττον καὶ μᾶλλον σιμὸν καὶ ἧττον, καὶ ἔστιν ἰδίως διαφορά·", "seq": 1513}
{"id": "Elias_Passim_1514", "series": "CAG", "text": "ἀχώριστος γὰρ ἡ γρυπότης καὶ ἡ σιμότης), αἱ δὲ ἰδιαίτατα τὸ μᾶλλον καὶ τὸ ἧττον οὐκ ἐπιδέχονται·", "seq": 1514}
{"id": "Elias_Passim_1515", "series": "CAG", "text": "οὐδὲ γὰρ λέγομεν μᾶλλον λογικὸν καὶ ἧττον, εἰ καὶ μᾶλλον ἐλλόγιμον, ἐπειδὴ τὸ μὲν τῆς ἐνεργείας τὸ ἐλλόγιμον, τὸ δὲ τῆς οὐσίας ἢ ὑπάρξεως, τὸ δὲ εἶναι λογικοῖς πᾶσι τὸ αὐτὸ ὑπάρχει ἐπίτασιν καὶ ἄνεσιν μὴ ἐπιδεχόμενον.", "seq": 1515}
{"id": "Elias_Passim_1516", "series": "CAG", "text": "εἰ οὖν αἱ μὲν ἐπιδέχονται τὸ μᾶλλον καὶ τὸ ἧττον, αἱ δὲ οὐκ ἐπιδέχονται, οὔκ εἰσιν αἱ αὐταί.", "seq": 1516}
{"id": "Elias_Passim_1517", "series": "CAG", "text": "ἔνστασις πρὸς ταῦτα, ὅτι ψευδὴς ὁ λόγος·", "seq": 1517}
{"id": "Elias_Passim_1518", "series": "CAG", "text": "καὶ αἱ ἰδιαίτατα γὰρ τὸ μᾶλλον καὶ τὸ ἧττον ἐπιδέχονται καὶ αἱ κοινῶς καὶ ἰδίως τὸ μᾶλλον καὶ ἧττον οὐκ ἐπιδέχονται·", "seq": 1518}
{"id": "Elias_Passim_1519", "series": "CAG", "text": "ἰδοὺ γὰρ τὸ σχῆμα τὸ ἐν τῷδε τῷ ἱμάντι, τρίγωνον εἰ τύχοι, κοινῶς ὂν διαφορά (χωρίζεται γὰρ χωρὶς φθορᾶς τοῦ ὑποκειμένου καὶ μένει ὁ ἱμὰς ἱμάς), μᾶλλον τρίγωνον ἢ ἧττον τρίγωνον οὐ λέγεται·", "seq": 1519}
{"id": "Elias_Passim_1520", "series": "CAG", "text": "εἰ γὰρ καὶ μέγα τρίγωνον καὶ μεῖζον λέγεται, ἀλλ᾿ οὐκ ἐπιδέχονται τὸ μᾶλλον καὶ ἧττον·", "seq": 1520}
{"id": "Elias_Passim_1521", "series": "CAG", "text": "ἄμφω γὰρ τρίγωνά εἰσι.", "seq": 1521}
{"id": "Elias_Passim_1522", "series": "CAG", "text": "δεῖ δὲ εἰδέναι ὅτι τὸ μᾶλλον καὶ ἧττον θεωρεῖται οὐδὲ ἐν οἷς ὁ ὁρισμὸς πάντῃ ὁ αὐτός ἐστιν, ὡς ἐπὶ δύο τριγώνων, οὐδὲ ἐν οἷς πάντῃ ὁ ὁρισμὸς ἕτερος, ὡς ἐπὶ τριγώνου καὶ κύκλου, ἀλλ᾿ ἐν οἷς πῇ ὁ αὐτὸς καὶ πῇ ἕτερος, ὡς ἐπὶ λευκοῦ·", "seq": 1522}
{"id": "Elias_Passim_1523", "series": "CAG", "text": "λευκὸν γάρ ἐστι χρῶμα διακριτικὸν ὄψεως, ἔστι δὲ μᾶλλον διακρίνειν καὶ ἧττον.", "seq": 1523}
{"id": "Elias_Passim_1524", "series": "CAG", "text": "ἀλλὰ καὶ ἐπὶ τῆς ἰδίως οὐκ ἔστι τὸ μᾶλλον καὶ ἧττον·", "seq": 1524}
{"id": "Elias_Passim_1525", "series": "CAG", "text": "ἰδοὺ γὰρ Ἀθηναῖος καὶ υἱὸς Σωφρονίσκου λέγεται ἐν τῇ ἰδίως διαφορᾷ, ἐπειδὴ ἀχώριστα ταῦτα, καὶ οὐ λέγομεν μᾶλλον υἱὸν Σωφρονίσκου ἢ μᾶλλον Ἀθηναῖον.", "seq": 1525}
{"id": "Elias_Passim_1526", "series": "CAG", "text": "πάλιν δὲ ἐπὶ τῆς ἰδιαίτατα ἐδείξαμεν τὸ μᾶλλον καὶ ἧττον·", "seq": 1526}
{"id": "Elias_Passim_1527", "series": "CAG", "text": "τὸ γὰρ διακριτικὸν τοῦ λευκοῦ καὶ τὸ συγκριτικὸν τοῦ μέλανος ἰδιαίτατα ὄντα διαφοραί, τὸ μὲν τοῦ λευκοῦ τὸ δὲ τοῦ μέλανος, ὁμοίως ἐπιδέχονται τὸ μᾶλλον καὶ ἧττον·", "seq": 1527}
{"id": "Elias_Passim_1528", "series": "CAG", "text": "λέγομεν γὰρ μᾶλλον διακριτικὸν καὶ ἧττον καὶ μᾶλλον συγκριτικὸν καὶ ἧττον.", "seq": 1528}
{"id": "Elias_Passim_1529", "series": "CAG", "text": "αὕτη ἡ ἔνστασις.", "seq": 1529}
{"id": "Elias_Passim_1530", "series": "CAG", "text": "λύσις πρὸς ταῦτα καὶ τέως πρὸς τὴν τελευταίαν ἀπορίαν, ὅτι ὥσπερ τὸ λευκὸν ὡς μὲν εἶδος τοῦ χρώματος τὸ μᾶλλον καὶ ἧττον οὐκ ἐπιδέχεται, ὡς δὲ ἐν τοιᾷδε ἢ τοιᾷδε ὕλῃ ὄν, ἐν σώματι φέρε εἰπεῖν ἢ ψιμυθίῳ, τὸ μᾶλλον καὶ ἧττον ἐπιδέχεται, οὕτως καὶ τὸ διακριτικὸν καὶ τὸ συγκριτικὸν ὡς μὲν ἰδιαίτατα καὶ εἰδοποιοὶ διαφοραί, τὸ μὲν τοῦ λευκοῦ τὸ δὲ τοῦ μέλανος, οὐκ ἐπιδέχονται τὸ μᾶλλον καὶ ἧττον, ὡς δὲ ἐν τοιᾷδε ἢ τοιᾷδε ὕλῃ γενόμενα ἐπιδέχονται τὸ μᾶλλον καὶ ἧττον·", "seq": 1530}
{"id": "Elias_Passim_1531", "series": "CAG", "text": "λέγομεν γὰρ μᾶλλον διακριτικὸν καὶ ἧττον.", "seq": 1531}
{"id": "Elias_Passim_1532", "series": "CAG", "text": "ἀλλὰ καὶ πρὸς τὴν ἀπορίαν τῆς κοινῶς καὶ ἰδίως φαμὲν ὅτι εἰ καὶ μὴ πᾶσαι τὸ μᾶλλον καὶ ἧττον ἐπιδέχονται αἱ κοινῶς καὶ ἰδίως διαφοραί, ἀλλ᾿ οὖν πᾶσαι αἱ διαφοραὶ αἱ ἐπιδεχόμεναι τὸ μᾶλλον καὶ ἧττον συμβεβηκυῖαί εἰσιν, καὶ ἡ κοινῶς καὶ ἡ ἰδίως, οὐδεμία δὲ ἰδιαίτατα διαφορὰ τὸ μᾶλλον καὶ ἧττον ἐπιδέχεται.", "seq": 1532}
{"id": "Elias_Passim_1533", "series": "CAG", "text": "οὐκ ἄρα εἰσὶν αἱ αὐταὶ αἱ κοινῶς καὶ ἰδίως ταῖς ἰδιαίτατα.", "seq": 1533}
{"id": "Elias_Passim_1534", "series": "CAG", "text": "Οὕτως διακρίνας τὰς ἀπὸ τῆς συνηθείας τῶν ἀπὸ τῆς φιλοσοφίας, καὶ αὐτὰς τὰς κατὰ φιλοσοφίαν ἀπ᾿ ἀλλήλων διακρίνει, φημὶ τὰς ἰδιαίτατα·", "seq": 1534}
{"id": "Elias_Passim_1535", "series": "CAG", "text": "τῶν γὰρ ἰδιαίτατα αἱ μέν εἰσι διαιρετικαί, αἱ δὲ συστατικαί.", "seq": 1535}
{"id": "Elias_Passim_1536", "series": "CAG", "text": "διαφέρουσι δὲ καὶ ἀλλήλων αὗται, καὶ οὔκ εἰσιν αἱ αὐταὶ αἱ συστατικαὶ ταῖς διαιρετικαῖς, ἀλλὰ ἄλλαι καὶ ἄλλαι.", "seq": 1536}
{"id": "Elias_Passim_1537", "series": "CAG", "text": "εἰ δέ ποτε ἡ αὐτὴ καὶ συστατικὴ καὶ διαιρετικὴ εὑρεθῇ, ἀλλ᾿ οὐ τοῦ αὐτοῦ πράγματος, ἀλλ᾿ ἄλλου καὶ ἄλλου·", "seq": 1537}
{"id": "Elias_Passim_1538", "series": "CAG", "text": "οἷον τὸ λογικὸν καὶ διαιρετικὴ διαφορὰ καὶ συστατική, ἀλλ᾿ οὐ τοῦ αὐτοῦ·", "seq": 1538}
{"id": "Elias_Passim_1539", "series": "CAG", "text": "διαιρετικὴ μὲν γὰρ τοῦ ζῴου, συστατικὴ δὲ τοῦ ἀνθρώπου.", "seq": 1539}
{"id": "Elias_Passim_1540", "series": "CAG", "text": "πάλιν ἐὰν τὸ αὐτὸ πρᾶγμα ἔχῃ πλείονας διαφοράς, ἄλλαι καὶ ἄλλαι εἰσὶ καὶ οὐχὶ αἱ αὐταί·", "seq": 1540}
{"id": "Elias_Passim_1541", "series": "CAG", "text": "τὸ γὰρ ζῷον ἔχει διαφορὰς πλείονας, τὸ αἰσθητικὸν τὸ ἔμψυχον τὸ λογικὸν καὶ τὸ θνητόν, ἀλλὰ τὸ μὲν αἰσθητικὸν καὶ ἔμψυχον συστατικαὶ αὐτοῦ εἰσι διαφοραί, τὸ δὲ λογικὸν καὶ θνητὸν διαιρετικαί.", "seq": 1541}
{"id": "Elias_Passim_1542", "series": "CAG", "text": "δεῖ οὖν συντόμως εἰπεῖν ὅτι εἰ εὑρεθῇ ποτε ἡ αὐτὴ διαφορὰ καὶ διαιρετικὴ καὶ συστατική, οὐ τοῦ αὐτοῦ πράγματος εὑρεθήσεται, ἀλλ᾿ ἄλλου μὲν διαιρετική, ἄλλου δὲ συστατική.", "seq": 1542}
{"id": "Elias_Passim_1543", "series": "CAG", "text": "εἰ δὲ τοῦ αὐτοῦ, οὐχ ἡ αὐτή, ἀλλ᾿ ἄλλη καὶ ἄλλη.", "seq": 1543}
{"id": "Elias_Passim_1544", "series": "CAG", "text": "ἄλλη διάκρισις τῶν αὐτῶν τούτων·", "seq": 1544}
{"id": "Elias_Passim_1545", "series": "CAG", "text": "οὐ δύνανται αἱ αὐταὶ καὶ συστατικαὶ καὶ διαιρετικαὶ εἶναι·", "seq": 1545}
{"id": "Elias_Passim_1546", "series": "CAG", "text": "εἰ γὰρ αἱ αὐταί, ἔδει ὅπου εἰσὶν αἱ ἕτεραι καὶ τὰς λοιπὰς εἶναι.", "seq": 1546}
{"id": "Elias_Passim_1547", "series": "CAG", "text": "ἀλλὰ μὴν οὐ πάντως ὅπου διαιρετικαί, καὶ συστατικαί·", "seq": 1547}
{"id": "Elias_Passim_1548", "series": "CAG", "text": "ἐπὶ γὰρ τῶν γενικωτάτων διαιρετικαὶ μέν εἰσι, συστατικαὶ δὲ οὔκ εἰσι.", "seq": 1548}
{"id": "Elias_Passim_1549", "series": "CAG", "text": "πάλιν ὅπου συστατικαί, οὐ πάντως διαιρετικαί·", "seq": 1549}
{"id": "Elias_Passim_1550", "series": "CAG", "text": "ἐπὶ γὰρ τῶν εἰδικωτάτων συστατικαὶ μέν εἰσι, διαιρετικαὶ δὲ οὔκ εἰσι.", "seq": 1550}
{"id": "Elias_Passim_1551", "series": "CAG", "text": "πρόσθες δὲ σὺ καὶ τοῦτο, ὅτι πᾶσα διαφορὰ καθ᾿ ἑαυτὴν λαμβανομένη συστατική ἐστι, κἂν συμπλακῇ ἑτέρᾳ τῇ μὴ ἀντικειμένῃ, ὡσαύτως μένει, οἷον τὸ λογικὸν καθ᾿ ἑαυτὸ λαμβανόμενον συστατικὴ διαφορά ἐστι, κἂν προσλάβῃ τὸ μὴ ἀντικείμενον, οἷον τὸ θνητόν, συστατικὴ πάλιν εὑρίσκεται, εἰ δὲ συμπλακείη τῇ ἀντικειμένῃ, τοῦτ᾿ ἔστι τῷ ἀλόγῳ, διαιρετικὴ γίνεται.", "seq": 1551}
{"id": "Elias_Passim_1552", "series": "CAG", "text": "πλὴν πᾶσαι καὶ αἱ διαιρετικαὶ καὶ συστατικαὶ εἰδοποιοὶ καλοῦνται, ἐπειδὴ κρεῖττον τὸ συνιστᾶν τοῦ διαιρεῖν, ὅσῳ κρεῖττον τὸ σώζειν τοῦ φθείρειν·", "seq": 1552}
{"id": "Elias_Passim_1553", "series": "CAG", "text": "ἀπὸ οὖν τοῦ τιμιωτέρου οὕτω καλείσθωσαν, ὡς τὸ", "seq": 1553}
{"id": "Elias_Passim_1554", "series": "CAG", "text": "Τεῦκρε, φίλη κεφαλή.", "seq": 1554}
{"id": "Elias_Passim_1555", "series": "CAG", "text": "<Πρᾶξις λ'>.", "seq": 1555}
{"id": "Elias_Passim_1556", "series": "CAG", "text": "10.", "seq": 1556}
{"id": "Elias_Passim_1557", "series": "CAG", "text": "22 Διαφορά ἐστιν ᾗ περιττεύει τὸ εἶδος τοῦ γένους.", "seq": 1557}
{"id": "Elias_Passim_1558", "series": "CAG", "text": "Ἐπειδὴ ἔγνωμεν τὰ σημαινόμενα τῶν διαφορῶν, τὴν κοινῶς καὶ ἰδίως καὶ ἰδιαίτατα, καὶ ἑκάστης τὰ διττὰ σημαινόμενα, ἔλθωμεν καὶ ἐπὶ τὸ λεῖπον, φημὶ ἐπὶ τὴν ὑπογραφὴν τῆς ἰδιαίτατα, κἄν τε συστατικὴ ᾖ κἄν τε διαιρετική.", "seq": 1558}
{"id": "Elias_Passim_1559", "series": "CAG", "text": "καὶ ὑπογράφει διχῶς ἑκάστην, ἀλλὰ νῦν μὲν τὴν συστατικὴν ὑπογράφει, ἐν δὲ τῇ ἑξῆς θεωρίᾳ τὴν διαιρετικήν.", "seq": 1559}
{"id": "Elias_Passim_1560", "series": "CAG", "text": "ἔχει δὲ ἡ ὑπογραφὴ τὸν τρόπον τοῦτον·", "seq": 1560}
{"id": "Elias_Passim_1561", "series": "CAG", "text": "διαφορά ἐστιν ᾗ περιττεύει τὸ εἶδος τοῦ γένους·", "seq": 1561}
{"id": "Elias_Passim_1562", "series": "CAG", "text": "ἰδοὺ γὰρ ὁ ἄνθρωπος εἶδος ὢν τῷ λογικῷ διαφορᾷ ὄντι περιττεύει τοῦ ζῴου, ὅπερ ἦν αὐτοῦ γένος·", "seq": 1562}
{"id": "Elias_Passim_1563", "series": "CAG", "text": "τὸ γὰρ ζῷον οὔτε λογικὸν οὔτε ἄλογον, ἵνα εὐλύτως ἀμφότερα ᾖ.", "seq": 1563}
{"id": "Elias_Passim_1564", "series": "CAG", "text": "καὶ μὴ νομίσῃ τις ὅτι, ἐπειδὴ εἴπομεν ὅτι περιττεύει τὸ εἶδος τοῦ γένους, ἐπὶ πλέον τὸ εἶδος·", "seq": 1564}
{"id": "Elias_Passim_1565", "series": "CAG", "text": "τοὐναντίον γὰρ ἐπ᾿ ἔλαττον·", "seq": 1565}
{"id": "Elias_Passim_1566", "series": "CAG", "text": "τὰ γὰρ πράγματα ὅσῳ πλουτεῖ προσδιορισμοῖς, πένεται κατὰ τὸ σημαινόμενον·", "seq": 1566}
{"id": "Elias_Passim_1567", "series": "CAG", "text": "ὁ γὰρ ζῷον εἰρηκὼς μόνον πλείονα περιλαμβάνει, φημὶ ἄγγελον καὶ ἄνθρωπον καὶ ἵππον καὶ τὰ λοιπὰ ζῷα·", "seq": 1567}
{"id": "Elias_Passim_1568", "series": "CAG", "text": "εἰ δὲ προσθείη τῷ ζῴῳ τὸ λογικόν, ἐχώρισεν αὐτὸ ἐκ τῶν ἀλόγων, εἰ δὲ θνητόν, ἐχώρισεν ἐκ τῶν ἀθανάτων.", "seq": 1568}
{"id": "Elias_Passim_1569", "series": "CAG", "text": "οὕτω γοῦν ὅσῳ πλείονες διαφοραὶ προστίθενται, ἐπὶ πλέον ἀτομοῦνται τὰ πράγματα.", "seq": 1569}
{"id": "Elias_Passim_1570", "series": "CAG", "text": "ἀλλὰ οὗτος ὁ λόγος δείκνυσι τὰς διαφορὰς ἐν τοῖς εἴδεσιν εἶναι, οὐ μὴν ἐν τοῖς γένεσιν·", "seq": 1570}
{"id": "Elias_Passim_1571", "series": "CAG", "text": "περιττεύει γὰρ ἀεὶ τὸ ἔχον τοῦ μὴ ἔχοντος, οὐ τὸ ἔχον τοῦ ἔχοντος, πολλῷ μᾶλλον δὲ οὐ περιττεύει τὸ μὴ ἔχον τοῦ ἔχοντος.", "seq": 1571}
{"id": "Elias_Passim_1572", "series": "CAG", "text": "πῶς οὖν ὑπῆρξαν αἱ διαφοραὶ μὴ πρότερον ἐν τοῖς γένεσιν ὑπάρξασαι;", "seq": 1572}
{"id": "Elias_Passim_1573", "series": "CAG", "text": "δοκεῖ γὰρ ἄτοπον εἶναι.", "seq": 1573}
{"id": "Elias_Passim_1574", "series": "CAG", "text": "καὶ ἵνα μὴ συνθλιβόμενοι ὑπὸ τῆς ἀπορίας ἀναγκασθῶμεν εἰπεῖν ὅτι ἐν τοῖς γένεσίν εἰσιν αἱ διαφοραί, ἀπορεῖ πρὸς ἑκάτερον, καὶ πρὸς τὸ εἶναι αὐτὰς ἐν τοῖς γένεσι καὶ πρὸς τὸ μὴ εἶναι·", "seq": 1574}
{"id": "Elias_Passim_1575", "series": "CAG", "text": "ὧν γὰρ ἀνάγκη θάτερον ὑπάρχειν, τούτων ἑκάτερον ἀδύνατον ἀποδείκνυσι·", "seq": 1575}
{"id": "Elias_Passim_1576", "series": "CAG", "text": "καὶ τὸ εἶναι γὰρ ἄτοπον καὶ τὸ μὴ εἶναι ἄτοπον.", "seq": 1576}
{"id": "Elias_Passim_1577", "series": "CAG", "text": "Ἀλλ᾿ ἵνα γνῶμεν τὴν ἀπορίαν, δύο λήμματα προσλάβωμεν, ἃ καὶ ἀξιώματα λέγονται, ὡς οἴκοθεν ἀξιοῦντα πιστεύεσθαι καὶ μὴ δεόμενα ἐπεισάκτου μαρτυρίας·", "seq": 1577}
{"id": "Elias_Passim_1578", "series": "CAG", "text": "οὕτω γὰρ καὶ ἀξιολόγους καὶ ἀξιοπίστους φαμὲν τοὺς ἐξ ἑαυτῶν πιστευομένους καὶ οὐκ ἐξ ἄλλων.", "seq": 1578}
{"id": "Elias_Passim_1579", "series": "CAG", "text": "καὶ πρῶτον μὲν λῆμμα τοῦτο·", "seq": 1579}
{"id": "Elias_Passim_1580", "series": "CAG", "text": "οὐ δύναται τὰ ἐναντία συνυπάρξαι ἀλλήλοις ποτὲ τριῶν προσδιορισμῶν φυλαττομένων, ἐν τῷ αὐτῷ ὑποκειμένῳ, ἐν τῷ αὐτῷ μέρει τοῦ ὑποκειμένου, ἐν τῷ αὐτῷ χρόνῳ·", "seq": 1580}
{"id": "Elias_Passim_1581", "series": "CAG", "text": "Σωκράτη μὲν γὰρ ὑγιαίνειν, Πλάτωνα δὲ νοσεῖν δυνατόν·", "seq": 1581}
{"id": "Elias_Passim_1582", "series": "CAG", "text": "ἄλλο γὰρ καὶ ἄλλο ὑποκείμενον.", "seq": 1582}
{"id": "Elias_Passim_1583", "series": "CAG", "text": "πάλιν καὶ τοῦ αὐτοῦ ὄντος ὑποκειμένου, οἷον Σωκράτους, ἐνδέχεται τὰ περὶ πόδα νοσεῖν τὰ δὲ περὶ κεφαλὴν ὑγιαίνειν, ἀλλ᾿ οὐκ ἐν τῷ αὐτῷ μέρει τοῦ ὑποκειμένου.", "seq": 1583}
{"id": "Elias_Passim_1584", "series": "CAG", "text": "ἀλλὰ καὶ τὸ αὐτὸ μέρος τοῦ ὑποκειμένου δυνατὸν νοσεῖν καὶ ὑγιαίνειν, οἷον τὸν ὀφθαλμὸν σήμερον νοσεῖν, αὔριον δὲ ὑγιαίνειν, ἀλλ᾿ οὐκ ἐν τῷ αὐτῷ χρόνῳ.", "seq": 1584}
{"id": "Elias_Passim_1585", "series": "CAG", "text": "τῶν οὖν τριῶν τούτων προσδιορισμῶν φυλαττομένων ἀδύνατον τὰ ἐναντία συνυπάρξαι ἀλλήλοις.", "seq": 1585}
{"id": "Elias_Passim_1586", "series": "CAG", "text": "οὗτος πρῶτος προσδιορισμός.", "seq": 1586}
{"id": "Elias_Passim_1587", "series": "CAG", "text": "δεύτερος προσδιορισμός·", "seq": 1587}
{"id": "Elias_Passim_1588", "series": "CAG", "text": "οὐδὲν ἐκ τοῦ μηδαμῇ μηδαμῶς ὄντος ποιεῖ ἡ φύσις καὶ ἡ ταύτην μιμουμένη τέχνη, ἀλλὰ τὸν τρόπον τῆς γενέσεως ταύτης θεῷ μόνῳ παραχωροῦσιν·", "seq": 1588}
{"id": "Elias_Passim_1589", "series": "CAG", "text": "ἥ τε γὰρ φύσις ἄνθρωπον δημιουργοῦσα ἐκ σπέρματος αὐτὸν δημιουργεῖ, ὃ δυνάμει ἄνθρωπός ἐστι, καὶ ἡ τεκτονικὴ θρόνον δημιουργοῦσα ἐκ ξύλου αὐτὸν δημιουργεῖ, ὃ δυνάμει θρόνος ἦν.", "seq": 1589}
{"id": "Elias_Passim_1590", "series": "CAG", "text": "τούτων οὕτως ἐχόντων πρόεισιν ἡ ἀπορία οὕτως λέγουσα·", "seq": 1590}
{"id": "Elias_Passim_1591", "series": "CAG", "text": "εἰσὶν αἱ διαφοραὶ ἐν τοῖς γένεσιν ἢ οὔκ εἰσι, καὶ εἰ μέν εἰσιν, ἄτοπος ὁ λόγος διὰ τὸ πρῶτον λῆμμα·", "seq": 1591}
{"id": "Elias_Passim_1592", "series": "CAG", "text": "τὰ γὰρ ἐναντία συνυπάρξαι ἀλλήλοις, τὸ λογικὸν καὶ ἄλογον καὶ θνητὸν καὶ ἀθάνατον, μήτε εἰς μέρη διειργομένου τοῦ ὑποκειμένου (ἀμερῆ γὰρ τὰ καθόλου), μήτε εἰς χρόνον·", "seq": 1592}
{"id": "Elias_Passim_1593", "series": "CAG", "text": "ἀίδια γὰρ τὰ καθόλου.", "seq": 1593}
{"id": "Elias_Passim_1594", "series": "CAG", "text": "εἰ δὲ μή εἰσιν ἐν τοῖς γένεσιν αἱ διαφοραί, καὶ οὕτως ἄτοπος ὁ λόγος διὰ τὸ δεύτερον λῆμμα·", "seq": 1594}
{"id": "Elias_Passim_1595", "series": "CAG", "text": "ἐπειδὴ γὰρ οὐδέν ἐστι παρὰ τὰ γένη καὶ τὰ εἴδη, εὑρεθήσονται ἐκ τοῦ μηδαμῇ μηδαμῶς ὄντος προελθοῦσαι αἱ διαφοραὶ ἐν τοῖς εἴδεσιν, ὅπερ ἀπηγόρευται διὰ τὸ δεύτερον λῆμμα.", "seq": 1595}
{"id": "Elias_Passim_1596", "series": "CAG", "text": "αὕτη ἡ ἀπορία.", "seq": 1596}
{"id": "Elias_Passim_1597", "series": "CAG", "text": "ἐφ᾿ οἷς εἴπωμεν καὶ τὴν λύσιν.", "seq": 1597}
{"id": "Elias_Passim_1598", "series": "CAG", "text": "ἀλλ᾿ ἵνα καὶ τὴν λύσιν νοήσωμεν, δύο καὶ ταύτης λήμματα προλάβωμεν·", "seq": 1598}
{"id": "Elias_Passim_1599", "series": "CAG", "text": "πρῶτον μὲν τοῦτο, ὅτι δυνατὸν τὰ ἐναντία συνυπάρξαι ἀλλήλοις ἐν τῷ αὐτῷ ὑποκειμένῳ ἐν τῷ αὐτῷ μέρει τοῦ ὑποκειμένου ἐν τῷ αὐτῷ χρόνῳ, δυνάμει μέντοι καὶ οὐκ ἐνεργείᾳ.", "seq": 1599}
{"id": "Elias_Passim_1600", "series": "CAG", "text": "οὕτω γοῦν τὸ ἔλαιον καὶ θερμὸν καὶ ψυχρὸν λέγομεν εἶναι·", "seq": 1600}
{"id": "Elias_Passim_1601", "series": "CAG", "text": "καστορίου γὰρ προσβληθέντος γίνεται θερμόν, ῥόδου δὲ ψυχρόν.", "seq": 1601}
{"id": "Elias_Passim_1602", "series": "CAG", "text": "δεύτερον λῆμμα·", "seq": 1602}
{"id": "Elias_Passim_1603", "series": "CAG", "text": "ἔστιν, φησίν, τὶ μέσον τοῦ τε μηδαμῇ μηδαμῶς ὄντος, τοῦτ᾿ ἔστιν τοῦ μηδὲ δυνάμει μηδὲ ἐνεργείᾳ ὄντος, ὡς τὸ εἰπεῖν τὸν λίθον γραμματικόν (τοῦτο γὰρ ἀδύνατον), τοῦ τε ἐνεργείᾳ ὄντος, τοῦτ᾿ ἔστι τοῦ ἐξηγουμένου γραμματικοῦ, τὸ δυνάμει μὲν ὄν, ἐνεργείᾳ δὲ οὐδαμῶς, ὡς τὸ παιδίον τὸ ἄρτι φοιτῆσαν εἰς γραμματικόν, ὅπερ δυνάμει μέν ἐστιν, ἐνεργείᾳ δὲ οὐκ ἔστιν·", "seq": 1603}
{"id": "Elias_Passim_1604", "series": "CAG", "text": "ἀτελὲς γάρ ἐστι.", "seq": 1604}
{"id": "Elias_Passim_1605", "series": "CAG", "text": "τούτων οὕτως ἐχόντων πρόεισι καὶ ἡ λύσις οὕτως·", "seq": 1605}
{"id": "Elias_Passim_1606", "series": "CAG", "text": "καί εἰσιν αἱ διαφοραὶ ἐν τοῖς γένεσιν καὶ οὔκ εἰσι, καὶ διότι μέν εἰσιν, ἔφυγον ἓν ἄτοπον τοῦ δευτέρου τῆς ἀπορίας λήμματος·", "seq": 1606}
{"id": "Elias_Passim_1607", "series": "CAG", "text": "οὐκ ἔστι γὰρ ἐκ τοῦ μηδαμῇ μηδαμῶς ὑπάρξαν ἐν τοῖς εἴδεσιν, * * ἀλλὰ δυνάμει οὖσαι ἐν τοῖς γένεσιν·", "seq": 1607}
{"id": "Elias_Passim_1608", "series": "CAG", "text": "διότι δὲ οὖσαι ἐν τοῖς γένεσι δυνάμει εἰσὶν καὶ οὐκ ἐνεργείᾳ, ἔφυγον τὸ ἄλλο ἄτοπον τοῦ πρώτου λήμματος·", "seq": 1608}
{"id": "Elias_Passim_1609", "series": "CAG", "text": "οὐκ ἔστι γὰρ τὰ ἐναντία συνυπάρξαι ἀλλήλοις·", "seq": 1609}
{"id": "Elias_Passim_1610", "series": "CAG", "text": "τότε γὰρ τὰ ἐναντία συνυπάρξαι ἀλλήλοις, ὅτε ἐνεργείᾳ εἰσίν, ἐπεὶ δυνάμει ὄντων αὐτῶν δυνατὸν συνυπάρχειν.", "seq": 1610}
{"id": "Elias_Passim_1611", "series": "CAG", "text": "καὶ ὅρα πῶς τὸ κατ᾿ ἄμφω ἄβατον ἡμῖν γενόμενον διὰ τὴν ἀπορίαν κατ᾿ ἄμφω πορεύσιμον γέγονε διὰ τὴν λύσιν·", "seq": 1611}
{"id": "Elias_Passim_1612", "series": "CAG", "text": "καὶ εἶναι γὰρ ἐν τοῖς γένεσι τὰς διαφορὰς λέγειν οὐκ ἄτοπον καὶ μὴ εἶναι, ἀλλ᾿ εἶναι μὲν δυνάμει μὴ εἶναι δὲ ἐνεργείᾳ.", "seq": 1612}
{"id": "Elias_Passim_1613", "series": "CAG", "text": "<Πρᾶξις λα'>.", "seq": 1613}
{"id": "Elias_Passim_1614", "series": "CAG", "text": "10.", "seq": 1614}
{"id": "Elias_Passim_1615", "series": "CAG", "text": "22 Διαφορά ἐστιν ᾗ περιττεύει τὸ εἶδος τοῦ γένους.", "seq": 1615}
{"id": "Elias_Passim_1616", "series": "CAG", "text": "Ἀπορήσαντος τοῦ Πορφυρίου πρὸς ἀμφότερα, καὶ πρὸς τὸ εἶναι τὰς διαφορὰς ἐν τοῖς γένεσι καὶ πρὸς τὸ μὴ εἶναι, καὶ δείξαντος πῶς μέν εἰσιν ἐν τοῖς γένεσι πῶς δὲ οὔκ εἰσιν, ὅτι δυνάμει μέν εἰσιν ἐνεργείᾳ δὲ οὔκ εἰσιν, οἱ Πλατωνικοὶ τούτων μὴ ἀνεχόμενοι τέσσαρά τινα ἐγκλήματα προσάγουσι τῇ τοιαύτῃ λύσει.", "seq": 1616}
{"id": "Elias_Passim_1617", "series": "CAG", "text": "πρῶτον μὲν ἔγκλημα τοῦτο·", "seq": 1617}
{"id": "Elias_Passim_1618", "series": "CAG", "text": "εἰ δυνάμει εἰσὶν αἱ διαφοραὶ ἐν τοῖς γένεσιν, ἐνεργείᾳ δὲ ἐν τοῖς εἴδεσιν, ἐπειδὴ πᾶν ἐνεργείᾳ κρεῖττον τοῦ δυνάμει ὡς τέλειον ἀτελοῦς, εὑρεθήσονται τὰ γένη χείρονα τῶν εἰδῶν, ὡς δυνάμει ἔχοντα τὰς διαφορὰς τῶν εἰδῶν ἐνεργείᾳ ἐχόντων, καὶ τὰ καθολικώτερα τῶν μερικωτέρων χείρονα.", "seq": 1618}
{"id": "Elias_Passim_1619", "series": "CAG", "text": "δεύτερον ἔγκλημα, ὅτι καὶ τὸ παράδοξον, τὰ γὰρ εἰδικώτατα χείρω πάντων τιμιώτερα τῶν γενικωτάτων εὑρεθήσεται, ἐπειδὴ τὰ εἰδικώτατα πάσας ἐνεργείᾳ ἔχουσι τὰς διαφοράς, τὰ δὲ γενικώτατα πάσας δυνάμει.", "seq": 1619}
{"id": "Elias_Passim_1620", "series": "CAG", "text": "τρίτον ἔγκλημα τὸ λέγον οὕτως·", "seq": 1620}
{"id": "Elias_Passim_1621", "series": "CAG", "text": "ἐπειδὴ πᾶν δυνάμει ἀγόμενον εἰς τὸ ἐνεργείᾳ ὑπὸ ἄλλου τοιούτου ἐνεργείᾳ ὄντος ἄγεται (ὥσπερ τὸ παιδίον δυνάμει ὂν γραμματικὸν ἄγεται εἰς τὸ ἐνεργείᾳ ὑπὸ τοῦ ἐνεργείᾳ τοιούτου ὄντος, τοῦτ᾿ ἔστι τοῦ τελείου γραμματικοῦ, καὶ ὥσπερ τὸ σπέρμα δυνάμει ὂν ἄνθρωπος ἄγεται εἰς τὸ ἐνεργείᾳ ὑπὸ τοῦ ἐνεργείᾳ ὄντος ἀνθρώπου, τοῦτ᾿ ἔστι τῆς μητρός), πῶς ἐπὶ τοῦ γένους τοῦτο εὐοδοῦται;", "seq": 1621}
{"id": "Elias_Passim_1622", "series": "CAG", "text": "ἐὰν γὰρ δυνάμει αἱ διαφοραὶ ἐν τοῖς γένεσιν ἐν δὲ τοῖς εἴδεσιν ἐνεργείᾳ, ὑπὸ ποίου ἐνεργείᾳ ὄντος τὸ δυνάμει ἐν τῷ γένει ἦλθεν <εἰς τὸ> ἐνεργείᾳ ἐν τῷ εἴδει;", "seq": 1622}
{"id": "Elias_Passim_1623", "series": "CAG", "text": "τέταρτον ἔγκλημα, ἐν ᾧ φασιν ὅτι καὶ μάταιον ὑμῶν τὸ δέος, ὦ Ἀριστοτελικοί·", "seq": 1623}
{"id": "Elias_Passim_1624", "series": "CAG", "text": "δεδίατε γὰρ ἐνεργείᾳ εἰπεῖν τὰς διαφορὰς ἐν τοῖς γένεσιν, ἵνα μὴ δῆθεν τὰ ἐναντία συνυπάρξῃ ἑαυτοῖς ἐν τῷ αὐτῷ ὑποκειμένῳ ἐν τῷ αὐτῷ μέρει τοῦ ὑποκειμένου ἐν τῷ αὐτῷ χρόνῳ, ἀγνοοῦντες ὅτι τὰ ἐναντία περὶ τὸν αὐτὸν τόπον μάχονται, ὥς φησι Πλωτῖνος, [τὰ ἐναντία περὶ τὸν τόπον] καὶ μεταβάλλειν θέλουσιν εἰς ἑαυτά, ὡς τὸ θερμὸν εἰς τὸ ψυχρὸν καὶ τὸ λευκὸν εἰς τὸ μέλαν, καὶ φθαρτικὰ δὲ θέλουσιν εἶναι ἑαυτῶν·", "seq": 1624}
{"id": "Elias_Passim_1625", "series": "CAG", "text": "τὸ δὲ λογικὸν καὶ ἄλογον οὔκ εἰσιν ἐναντία·", "seq": 1625}
{"id": "Elias_Passim_1626", "series": "CAG", "text": "οὐδὲ γὰρ μάχονται περὶ τὸν αὐτὸν τόπον οὐδὲ μεταβάλλουσιν εἰς ἑαυτά ποτε οὔτε φθαρτικὸν τὸ λογικὸν τοῦ ἀλόγου·", "seq": 1626}
{"id": "Elias_Passim_1627", "series": "CAG", "text": "τοὐναντίον γὰρ καὶ διασωστικὰ τὰ λογικὰ τῶν ἀλόγων, καὶ παρακτικὰ τὰ ἀθάνατα τῶν θνητῶν.", "seq": 1627}
{"id": "Elias_Passim_1628", "series": "CAG", "text": "ἢ καὶ ἄλλως·", "seq": 1628}
{"id": "Elias_Passim_1629", "series": "CAG", "text": "ὅτι οὐδὲν ἄτοπον τὰ ἐναντία ἅμα συστῆναι ἐν τῷ αὐτῷ ὑποκειμένῳ ἐν τῷ αὐτῷ μέρει τοῦ ὑποκειμένου ἐν τῷ αὐτῷ χρόνῳ, ἐπὶ ἀσωμάτων μέντοι, οἷα τὰ γένη καὶ τὰ καθόλου, οὐ μὴν ἐπὶ σωμάτων·", "seq": 1629}
{"id": "Elias_Passim_1630", "series": "CAG", "text": "οὕτω γοῦν ἡ ὄψις ἀσώματος οὖσα μιᾷ προσβολῇ κρίνει τὸ λευκὸν τὸ ἐν τῷ χάρτῃ καὶ τὸ μέλαν τὸ ἐν τοῖς γράμμασι, καὶ ἡ ψυχὴ ἀσώματος οὖσα ἅμα κρίνει τὸ ἀγαθὸν καὶ τὸ κακόν (μία γὰρ τῶν ἀντικειμένων ἐπιστήμη, τοῦτ᾿ ἔστιν ὁ εἰδὼς τὸ ἀγαθὸν καὶ τὸ κακὸν οἶδε), καὶ ἡ φύσις ἀσώματος οὖσα ἅμα δημιουργεῖ τὸ λευκὸν τὸ ἐν τῷ ὀφθαλμῷ, οἷον τὸν ἐπιπεφυκότα, καὶ τὸ μέλαν, οἷον τὸ κερατοειδές.", "seq": 1630}
{"id": "Elias_Passim_1631", "series": "CAG", "text": "καὶ οἱ φιλόσοφοι δὲ τὴν φαντασίαν ἀσώματον κατασκευάζουσιν ἐκ τοῦ δέχεσθαι αὐτὴν δευτέρους τύπους καὶ τρίτους καὶ πλείονας τῶν πρώτων μὴ ἐξαφανισθέντων, ὅπερ ἀσωματότητος ἴδιον.", "seq": 1631}
{"id": "Elias_Passim_1632", "series": "CAG", "text": "ταῦτα μὲν τὰ ἐγκλήματα τῶν Πλατωνικῶν.", "seq": 1632}
{"id": "Elias_Passim_1633", "series": "CAG", "text": "φέρε δὲ ἡμεῖς εἰς συμφωνίαν τοὺς φιλοσόφους ἀγάγωμεν.", "seq": 1633}
{"id": "Elias_Passim_1634", "series": "CAG", "text": "δεῖ δὲ εἰδέναι ὅτι τὸ δυνάμει διττόν, ἢ κατ᾿ ἐπιτηδειότητα, ὡς ἐπὶ τοῦ βρέφους τοῦ μακρὰ κῶλα ἔχοντος καὶ λεγομένου δυνάμει πύκτου, ἢ κατ᾿ ἐνέργειαν μὴ παροῦσαν, ὡς ἐπὶ τοῦ καθεύδοντος γραμματικοῦ, καὶ τὸ ἐνεργείᾳ διττόν, ἢ καθ᾿ ἕξιν, ὡς ἐπὶ τοῦ τελείου μὲν κατὰ τὴν γραμματικήν, μὴ ἐνεργοῦντος δὲ κατ᾿ αὐτήν, ἢ κατὰ προχείρισιν, ὡς ἐπὶ τοῦ ἐξηγουμένου γραμματικοῦ.", "seq": 1634}
{"id": "Elias_Passim_1635", "series": "CAG", "text": "τὸ μὲν οὖν ἓν σημαινόμενον τοῦ δυνάμει τὸ κατ᾿ ἐπιτηδειότητα τῷ ἑνὶ σημαινομένῳ τοῦ ἐνεργείᾳ τῷ κατὰ προχείρισιν οὐδέποτε συντρέχει, ἀλλὰ καὶ ἐναντία ἀλλήλοις εἰσί·", "seq": 1635}
{"id": "Elias_Passim_1636", "series": "CAG", "text": "πῶς γὰρ τὸ δυνάμει ἀτελὲς ὂν τῷ τελείῳ ἐνεργείᾳ ταὐτόν ποτε γενήσεται;", "seq": 1636}
{"id": "Elias_Passim_1637", "series": "CAG", "text": "τὸ δὲ ἄλλο σημαινόμενον τοῦ δυνάμει, φημὶ τὸ κατ᾿ ἐνέργειαν μὴ παροῦσαν, τῷ ἑτέρῳ σημαινομένῳ τοῦ ἐνεργείᾳ, τοῦτ᾿ ἔστι τῷ καθ᾿ ἕξιν, συντρέχει καὶ δοκεῖ μὴ ἐναντίον εἶναι.", "seq": 1637}
{"id": "Elias_Passim_1638", "series": "CAG", "text": "ὅταν οὖν λέγωσιν οἱ Πλατωνικοὶ τὰς διαφορὰς ἐνεργείᾳ ἐν τοῖς γένεσιν εἶναι, οὐ κατὰ προχείρισιν αὐτὰς λέγουσιν εἶναι ἀλλὰ καθ᾿ ἕξιν, πάλιν οἱ Ἀριστοτελικοὶ δυνάμει λέγοντες εἶναι τὰς διαφορὰς ἐν τοῖς γένεσιν οὐ κατ᾿ ἐπιτηδειότητα αὐτὰς εἶναι λέγουσιν ἀλλὰ κατ᾿ ἐνέργειαν μὴ παροῦσαν, ὃ δύναται καὶ δυνάμει λέγεσθαι καὶ ἐνεργείᾳ, πρὸς ἄλλο μέντοι καὶ ἄλλο λαμβανόμενον·", "seq": 1638}
{"id": "Elias_Passim_1639", "series": "CAG", "text": "ἐνεργείᾳ γὰρ λέγεται ὡς πρὸς τὸ ἀτελὲς τὸ πρῶτον τὸ κατ᾿ ἐπιτηδειότατα, δυνάμει δὲ ὡς <πρὸς> τὸ κατὰ προχείρισιν.", "seq": 1639}
{"id": "Elias_Passim_1640", "series": "CAG", "text": "τούτων οὖν οὕτως ἐχόντων καὶ διττοῦ ὄντος τοῦ δυνάμει καὶ διττοῦ τοῦ ἐνεργείᾳ οὐ διαφωνεῖ Πλάτων Ἀριστοτέλει, ἀλλ᾿ ἀμφοτέροις τὰ αὐτὰ δοκεῖ.", "seq": 1640}
{"id": "Elias_Passim_1641", "series": "CAG", "text": "<Πρᾶξις λβ'>.", "seq": 1641}
{"id": "Elias_Passim_1642", "series": "CAG", "text": "11.", "seq": 1642}
{"id": "Elias_Passim_1643", "series": "CAG", "text": "7 Διαφορά ἐστι τὸ κατὰ πλειόνων καὶ διαφερόντων τῷ εἴδει ἐν τῷ ποῖόν τί ἐστι κατηγορούμενον.", "seq": 1643}
{"id": "Elias_Passim_1644", "series": "CAG", "text": "Ἔτι διὰ τούτων τὰς συστατικὰς διαφορὰς ὑπογράφει ὁ Πορφύριος, πλὴν οὐ τὰς αὐτὰς ἀλλ᾿ ἑτέρας·", "seq": 1644}
{"id": "Elias_Passim_1645", "series": "CAG", "text": "διττὸν γὰρ τὸ εἶδος τῆς διαφορᾶς, ἢ καθολικώτερον τοῦ εἴδους ἢ ἐξισάζον τῷ εἴδει.", "seq": 1645}
{"id": "Elias_Passim_1646", "series": "CAG", "text": "καὶ ἀνωτέρω μὲν πᾶσαν συστατικὴν διαφορὰν ὑπέγραφεν, καὶ τὴν καθολικωτέραν τοῦ εἴδους καὶ τὴν μερικωτέραν μὲν ἐκείνης ἐξισάζουσαν δὲ τῷ εἴδει·", "seq": 1646}
{"id": "Elias_Passim_1647", "series": "CAG", "text": "τὸ μὲν γὰρ λογικὸν καθολικώτερον τοῦ ἀνθρώπου, εἴδους ὄντος, ὡς ὑπάρχον οὐκ αὐτῷ μόνον ἀλλὰ καὶ θεῷ καὶ ἀγγέλῳ, ἀλλὰ καὶ τὸ θνητὸν ὁμοίως καθολικώτερον ὡς καὶ ἄλλοις ὑπάρχον, τὸ δὲ νοῦ καὶ ἐπιστήμης δεκτικὸν ἐξισάζουσα διαφορὰ τῷ ἀνθρώπῳ·", "seq": 1647}
{"id": "Elias_Passim_1648", "series": "CAG", "text": "οὐδὲ γὰρ ὑπάρχει ἑτέρῳ.", "seq": 1648}
{"id": "Elias_Passim_1649", "series": "CAG", "text": "ἡ οὖν πρώτη ὑπογραφὴ τὰς δύο περιέλαβε (περιττεύει γὰρ ὁ ἄνθρωπος εἶδος ὢν τοῦ ζῴου τοῦ οἰκείου γένους καὶ τῷ λογικῷ καὶ τῷ νοῦ καὶ ἐπιστήμης δεκτικῷ), ἐν δὲ τῇ παρούσῃ θεωρίᾳ τὴν καθολικωτέραν μόνον ὑπογράφει συστατικὴν διαφοράν.", "seq": 1649}
{"id": "Elias_Passim_1650", "series": "CAG", "text": "ἔστι δὲ οὕτως·", "seq": 1650}
{"id": "Elias_Passim_1651", "series": "CAG", "text": "διαφορά ἐστι τὸ κατὰ πλειόνων καὶ διαφερόντων τῷ εἴδει ἐν τῷ ποῖόν τί ἐστι κατηγορούμενον.", "seq": 1651}
{"id": "Elias_Passim_1652", "series": "CAG", "text": "καὶ ὥσπερ τριῶν οὐσῶν ἀποδόσεων τοῦ εἴδους αἱ μὲν δύο παντὶ εἴδει ὑπῆρχον, ἡ δὲ μία τῷ εἰδικωτάτῳ μόνῳ, οὕτω κἀνταῦθα δύο οὐσῶν ὑπογραφῶν τῶν συστατικῶν διαφορῶν ἡ μία ἡ πρώτη πάσῃ συστατικῇ διαφορᾷ ἁρμόζει, ἡ δὲ δευτέρα μόνῃ τῇ καθολικωτέρᾳ τοῦ εἴδους.", "seq": 1652}
{"id": "Elias_Passim_1653", "series": "CAG", "text": "Ἐφ᾿ οἷς σαφηνίσωμεν ἑκάστην λέξιν τῆς ὑπογραφῆς.", "seq": 1653}
{"id": "Elias_Passim_1654", "series": "CAG", "text": "διαφορά ἐστι τὸ κατὰ πλειόνων.", "seq": 1654}
{"id": "Elias_Passim_1655", "series": "CAG", "text": "εὐθέως τοῦτο ἀπορεῖται·", "seq": 1655}
{"id": "Elias_Passim_1656", "series": "CAG", "text": "εἰ γὰρ ἡ διαφορά, φασί, κατὰ πλειόνων, κοινωνία ἐστὶ καὶ οὐκέτι διαφορά, ὥσπερ τὸ ζῷον πολλοῖς ὑπάρχον κοινωνίαν αὐτῶν ποιεῖ, καὶ οὐ διαφοράν.", "seq": 1656}
{"id": "Elias_Passim_1657", "series": "CAG", "text": "πρὸς ὅ φαμεν ὅτι ὡς καθόλου φωνὴ κατὰ πλειόνων φέρεται, ἐπεὶ ὡς διαφορὰ οὐ κατὰ πλειόνων, ἀλλ᾿ ἑνὶ πράγματι ὑπάρχει.", "seq": 1657}
{"id": "Elias_Passim_1658", "series": "CAG", "text": "καὶ διαφερόντων τῷ εἴδει·", "seq": 1658}
{"id": "Elias_Passim_1659", "series": "CAG", "text": "τοῦτο ἤδη ἐσαφηνίσθη, ὅτε τῶν τριῶν ἀποδόσεων τοῦ εἴδους ἐμνημονεύσαμεν.", "seq": 1659}
{"id": "Elias_Passim_1660", "series": "CAG", "text": "ἐν τῷ ποῖόν τί ἐστι κατηγορούμενον·", "seq": 1660}
{"id": "Elias_Passim_1661", "series": "CAG", "text": "ὅτι ἡ διαφορὰ ἐν τῷ ποῖόν τί ἐστι καὶ οὐκ ἐν τῷ τί ἐστι κατηγορεῖται, δείκνυσι τοῦτο καὶ ἐκ τῆς λεκτικῆς συνηθείας οὕτως·", "seq": 1661}
{"id": "Elias_Passim_1662", "series": "CAG", "text": "ἃ ἐρωτώμενοι τίνα ἐστὶν ἀποκρινόμεθα, ἐν τῷ τί ἐστι κατηγοροῦνται, ἃ δὲ ἐρωτώμενοι ποῖά ἐστιν ἀποκρινόμεθα, ἐν τῷ ποῖόν τί ἐστι κατηγοροῦνται·", "seq": 1662}
{"id": "Elias_Passim_1663", "series": "CAG", "text": "τί γάρ ἐστιν ἄνθρωπος ἐρωτώμενοι ζῷόν φαμεν, ὃ γένος ὂν ἐν τῷ τί ἐστι κατηγορεῖται.", "seq": 1663}
{"id": "Elias_Passim_1664", "series": "CAG", "text": "εἰ δὲ ἐρωτηθῶμεν ποῖόν τι ἄνθρωπος, λογικός φαμεν, τοῦτο δέ ἐστι διαφορά.", "seq": 1664}
{"id": "Elias_Passim_1665", "series": "CAG", "text": "ἡ διαφορὰ ἄρα ἐν τῷ ποῖόν τί ἐστι κατηγορεῖται.", "seq": 1665}
{"id": "Elias_Passim_1666", "series": "CAG", "text": "οὕτως μὲν ἐκ τῆς λεκτικῆς συνηθείας.", "seq": 1666}
{"id": "Elias_Passim_1667", "series": "CAG", "text": "ἀλλὰ καὶ ἐξ αὐτῶν τῶν πραγμάτων·", "seq": 1667}
{"id": "Elias_Passim_1668", "series": "CAG", "text": "τὰ γὰρ πράγματα ἢ καθόλου ἢ μερικά·", "seq": 1668}
{"id": "Elias_Passim_1669", "series": "CAG", "text": "τὰ μὲν οὖν μερικὰ ἐξ ὕλης καὶ εἴδους συνέστηκεν, ὡς ὁ ἀνδριὰς ἐξ ὕλης μὲν τοῦ χαλκοῦ εἴδους δὲ τοῦ σχήματος καὶ ὁ ἄνθρωπος ἐξ ὕλης μὲν τοῦ σπέρματος εἴδους δὲ τῆς ἀνθρωπείας μορφῆς, τὰ δὲ καθόλου ὡς ἀσώματα οὐκ ἐξ ὕλης καὶ εἴδους, ἀλλ᾿ ἐκ τῶν ἀναλογούντων ὕλῃ καὶ εἴδει·", "seq": 1669}
{"id": "Elias_Passim_1670", "series": "CAG", "text": "ἀναλογεῖ δὲ τῇ μὲν ὕλῃ τὸ γένος (ἑκάτερον γὰρ τὸ εἶναι δίδωσι μόνον τῷ πράγματι), τῷ δὲ εἴδει ἡ διαφορά (ἑκάτερον γὰρ τοιόνδε τι ποιεῖ)·", "seq": 1670}
{"id": "Elias_Passim_1671", "series": "CAG", "text": "ὥσπερ γὰρ ἡ ὕλη ἀσχημάτιστος οὖσα καὶ ἄμορφος προσερχομένου αὐτῇ τοῦ εἴδους μορφοῦται καὶ τοιόνδε τι σχῆμα γίνεται, οὕτως καὶ τὸ γένος τὸ ἀναλογοῦν τῇ ὕλῃ τῆς διαφορᾶς αὐτῷ προσελθούσης τῆς ἀναλογούσης τῷ εἴδει τοιόνδε τι γίνεται.", "seq": 1671}
{"id": "Elias_Passim_1672", "series": "CAG", "text": "εἰ οὖν τοιόνδε τι ποιεῖ ἡ διαφορά, ἡ διαφορὰ ἄρα ἐν τῷ ποῖόν τί ἐστι κατηγορεῖται.", "seq": 1672}
{"id": "Elias_Passim_1673", "series": "CAG", "text": "καὶ ταῦτα μὲν περὶ τῶν συστατικῶν.", "seq": 1673}
{"id": "Elias_Passim_1674", "series": "CAG", "text": "Ἐφ᾿ οἷς ἔλθωμεν ἐπὶ τὰς διαιρετικάς.", "seq": 1674}
{"id": "Elias_Passim_1675", "series": "CAG", "text": "ὑπογράφει δὲ καὶ αὐτὰς διχῶς·", "seq": 1675}
{"id": "Elias_Passim_1676", "series": "CAG", "text": "διαφορά ἐστι τὸ χωρίζειν πεφυκὸς τὰ ὑπὸ τὸ αὐτὸ γένος, οἷον τὸ λογικὸν διαφορὰ ὂν χωρίζει τὸν ἄνθρωπον ἀπὸ τοῦ ἵππου.", "seq": 1676}
{"id": "Elias_Passim_1677", "series": "CAG", "text": "δεῖ δὲ προσθεῖναι τὸ κατ᾿ οὐσίαν, ἐπειδὴ καὶ τὸ γελαστικὸν χωρίζον ἄνθρωπον ἀπὸ ἵππου διαφορὰ οὐκ ἔστιν, ἀλλ᾿ ἴδιον.", "seq": 1677}
{"id": "Elias_Passim_1678", "series": "CAG", "text": "καὶ ἡμεῖς μὲν τούτῳ ἐχρησάμεθα παραδείγματι, αὐτὸς δὲ ὁ Πορφύριος τῷ πεφυκέναι πλεῖν.", "seq": 1678}
{"id": "Elias_Passim_1679", "series": "CAG", "text": "διὸ καὶ ἀποροῦσιν ὅτι ‘πῶς τὸ πεφυκέναι πλεῖν ἴδιον ἀνθρώπου;", "seq": 1679}
{"id": "Elias_Passim_1680", "series": "CAG", "text": "τί γὰρ καὶ σημαίνει τὸ πλεῖν;", "seq": 1680}
{"id": "Elias_Passim_1681", "series": "CAG", "text": "εἰ μὲν γὰρ τὸ ἐπὶ πλοίου φέρεσθαι, τοῦτο καὶ ἀλόγοις καὶ ἀψύχοις ὑπάρχει.", "seq": 1681}
{"id": "Elias_Passim_1682", "series": "CAG", "text": "εἰ δὲ τὸ νήχεσθαι, καὶ αὐτὸ ἀλόγοις ὑπάρχει’.", "seq": 1682}
{"id": "Elias_Passim_1683", "series": "CAG", "text": "ἀλλ᾿ ἔστι, φησί, καὶ τρίτον σημαινόμενον τοῦ πεφυκέναι πλεῖν, τὸ εἰδέναι πλεῖν καὶ ναυτίλλεσθαι.", "seq": 1683}
{"id": "Elias_Passim_1684", "series": "CAG", "text": "ἀλλ᾿ εἰ καὶ τρίτον σημαινόμενον τοῦ πλεῖν ἐπινοηθῇ, οὐδὲν ἧττον ἄπορος ὁ λόγος·", "seq": 1684}
{"id": "Elias_Passim_1685", "series": "CAG", "text": "εἰ γὰρ τὸ πάσης τινοσοῦν τέχνης καὶ ἐπιστήμης δεκτικὸν οὐσία τοῦ ἀνθρώπου, καὶ τὸ τινὸς τέχνης καὶ ἐπιστήμης δεκτικὸν οὐσία τοῦ ἀνθρώπου, οὐκοῦν καὶ τὸ πεφυκέναι πλεῖν οὐσία τοῦ ἀνθρώπου.", "seq": 1685}
{"id": "Elias_Passim_1686", "series": "CAG", "text": "πρὸς ὅ φαμεν ὅτι τὸ πάσης ἐπιστήμης δεκτικὸν καὶ τινὸς ἐπιστήμης κατ᾿ οὐσίαν ὑπάρχει τῷ ἀνθρώπῳ, τὸ δὲ προσφυῶς ἔχειν πρὸς τόδε ἢ τόδε μᾶλλον οὐκ οὐσία τοῦ ἀνθρώπου ἀλλ᾿ ἴδιον·", "seq": 1686}
{"id": "Elias_Passim_1687", "series": "CAG", "text": "κράσει γάρ τινι ἕπεται ἡ τοιαύτη ἐπιτηδειότης, ἥτις κρᾶσις συμβέβηκε.", "seq": 1687}
{"id": "Elias_Passim_1688", "series": "CAG", "text": "κατὰ τούτου οὖν τοῦ σημαινομένου ἔλαβε τὸ πεφυκέναι πλεῖν ὁ Πορφύριος.", "seq": 1688}
{"id": "Elias_Passim_1689", "series": "CAG", "text": "αὕτη μὲν πρώτη ὑπογραφή.", "seq": 1689}
{"id": "Elias_Passim_1690", "series": "CAG", "text": "δευτέρα δὲ ὑπογραφὴ ἡ λέγουσα ὅτι διαφορά ἐστιν ὅτῳ διαφέρει ἕκαστα.", "seq": 1690}
{"id": "Elias_Passim_1691", "series": "CAG", "text": "δεῖ δὲ προσθεῖναι κἀνταῦθα τὸ κατ᾿ οὐσίαν, ἐπειδὴ καὶ τῷ λευκῷ καὶ τῷ μέλανι διαφέρομεν, ἅπερ οὐ διαφοραὶ ἀλλὰ συμβεβηκότα.", "seq": 1691}
{"id": "Elias_Passim_1692", "series": "CAG", "text": "αὕτη μὲν οὖν ἡ ὑπογραφὴ καθολικωτέρα τῆς πρὸ αὐτῆς·", "seq": 1692}
{"id": "Elias_Passim_1693", "series": "CAG", "text": "ἐκείνη γὰρ τὰ ὑπὸ τὸ αὐτὸ γένος πέφυκε χωρίζειν, αὕτη δὲ καθολικῶς πάντα τὰ κατ᾿ οὐσίαν διαφέροντα.", "seq": 1693}
{"id": "Elias_Passim_1694", "series": "CAG", "text": "Πρᾶξις λγ΄.", "seq": 1694}
{"id": "Elias_Passim_1695", "series": "CAG", "text": "Περὶ ἰδίου.", "seq": 1695}
{"id": "Elias_Passim_1696", "series": "CAG", "text": "12.", "seq": 1696}
{"id": "Elias_Passim_1697", "series": "CAG", "text": "13 Τὸ δὲ ἴδιον διαιροῦσι τετραχῶς.", "seq": 1697}
{"id": "Elias_Passim_1698", "series": "CAG", "text": "Ἐπειδὴ αἱ ἀθρόαι μεταβολαὶ ἀεὶ σφαλεραί εἰσι καὶ οὐ μόνον ἐπὶ σωμάτων ἀλλὰ καὶ ἐν λόγοις καὶ ἐν πράγμασι, διὰ τοῦτο οὐκ ἀθρόον ἀπὸ τῶν πάντῃ οὐσιωδῶν, γένους φημὶ καὶ εἴδους καὶ διαφορᾶς, ἦλθεν ἐπὶ τὰ πάντῃ ἐπεισοδιώδη, φημὶ τὰ συμβεβηκότα, ἀλλὰ γεφύρᾳ τινὶ καὶ κλίμακι μέσῳ κέχρηται τῷ ἰδίῳ·", "seq": 1698}
{"id": "Elias_Passim_1699", "series": "CAG", "text": "τοῦτο γὰρ ὡς ἐν ἐπεισοδιώδεσιν οὐσιῶδες ὑπάρχει·", "seq": 1699}
{"id": "Elias_Passim_1700", "series": "CAG", "text": "ὁρισμὸν γὰρ μιμεῖται καὶ ὑπογραφὴν τῷ ἀντιστρέφειν, καὶ ἐπειδὴ ὁρισμὸν μιμεῖται, οὐσιῶδες, ἐπειδὴ δὲ ὑπογραφήν, ἐπεισοδιῶδες·", "seq": 1700}
{"id": "Elias_Passim_1701", "series": "CAG", "text": "ἡ γὰρ ὑπογραφὴ ἐκ συμβεβηκότων.", "seq": 1701}
{"id": "Elias_Passim_1702", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ καὶ τὸ ἴδιον ὁμώνυμον (ἐν γὰρ ταῖς δέκα κατηγορίαις θεωρεῖται), φέρε διαστελλώμεθα τὴν ὁμωνυμίαν καὶ εἴπωμεν περὶ ποίου ὁ σκοπὸς τοῖς φιλοσόφοις, καὶ τρίτον ὑπογραφέσθω τὸ σημαινόμενον ἐκεῖνο.", "seq": 1702}
{"id": "Elias_Passim_1703", "series": "CAG", "text": "ἔστι τοίνυν πρῶτον σημαινόμενον τοῦ ἰδίου τὸ μόνῳ μὲν ὑπάρχον οὐ παντὶ δέ, ὡς ἀνθρώπῳ τὸ ἰατρεύειν καὶ τὸ γεωμετρεῖν·", "seq": 1703}
{"id": "Elias_Passim_1704", "series": "CAG", "text": "τοῦτο γὰρ μόνῳ ἀνθρώπῳ ὑπάρχει καὶ οὐ παντὶ ἀνθρώπῳ·", "seq": 1704}
{"id": "Elias_Passim_1705", "series": "CAG", "text": "οὐδὲ γὰρ πᾶς ἄνθρωπος ἢ ἰατρὸς ἢ γεωμέτρης.", "seq": 1705}
{"id": "Elias_Passim_1706", "series": "CAG", "text": "δεύτερον σημαινόμενον τοῦ ἰδίου ἀντίστροφον τῷ πρώτῳ τὸ παντὶ μὲν ὑπάρχον οὐ μόνῳ δέ, ὡς ἀνθρώπῳ τὸ εἶναι δίποδι·", "seq": 1706}
{"id": "Elias_Passim_1707", "series": "CAG", "text": "τὸ γὰρ δίπουν πᾶς ἔχει ἄνθρωπος, πλὴν οὐ μόνος·", "seq": 1707}
{"id": "Elias_Passim_1708", "series": "CAG", "text": "ὑπάρχει γὰρ καὶ πτηνοῖς.", "seq": 1708}
{"id": "Elias_Passim_1709", "series": "CAG", "text": "κἂν συμβῇ δὲ τὸν ἕνα πόδα ἀφαιρεθῆναι, ἀλλ᾿ οὖν δίπους λέγεται διὰ τὸ πεφυκέναι.", "seq": 1709}
{"id": "Elias_Passim_1710", "series": "CAG", "text": "τρίτον σημαινόμενον τοῦ ἰδίου τὸ μόνῳ καὶ παντὶ καὶ ποτέ, ὡς μόνῳ καὶ παντὶ ἀνθρώπῳ τὸ ἐν γήρᾳ πολιοῦσθαι·", "seq": 1710}
{"id": "Elias_Passim_1711", "series": "CAG", "text": "καὶ γὰρ εἰ καὶ τὰ ἄλλα ζῷα πολιοῦνται, ἀλλ᾿ οὐ διὰ τὴν ἡλικίαν ὡς ἄνθρωπος ἀλλ᾿ ἐκ κατασκευῆς, ὡς τὸ εἰρημένον τῷ ποιητῇ", "seq": 1711}
{"id": "Elias_Passim_1712", "series": "CAG", "text": "καὶ κύνας ἀργούς.", "seq": 1712}
{"id": "Elias_Passim_1713", "series": "CAG", "text": "τέταρτον σημαινόμενον τοῦ ἰδίου, ἐφ᾿ οὗ πάντα συντρέχει, τὸ μόνῳ καὶ παντὶ καὶ ἀεί, ὡς τὸ γελαστικόν·", "seq": 1713}
{"id": "Elias_Passim_1714", "series": "CAG", "text": "τοῦτο γὰρ καὶ μόνῳ ἀνθρώπῳ ὑπάρχει καὶ παντὶ καὶ ἀεί·", "seq": 1714}
{"id": "Elias_Passim_1715", "series": "CAG", "text": "κἄν τε γὰρ μὴ γελᾷ κἄν τε κλαίῃ, γελαστικὸς λέγεται οὐ τῷ ἤδη γελᾶν, ἀλλὰ τῷ πεφυκέναι·", "seq": 1715}
{"id": "Elias_Passim_1716", "series": "CAG", "text": "ὥσπερ γὰρ καὶ τὸ θνητὸν τὸ πεφυκὸς λέγεται, οὐ τῷ ἤδη θνήσκειν, οὕτως καὶ γελαστικὸς τῷ πεφυκέναι λέγεται, οὐ τῷ ἤδη γελᾶν·", "seq": 1716}
{"id": "Elias_Passim_1717", "series": "CAG", "text": "καὶ ἡ ὕλη γὰρ καίτοι ἀεὶ εἰδοπεποιημένη οὖσα ὅμως ἀνείδεος λέγεται ὡς πεφυκυῖα ἀποβαλεῖν τόδε τὸ εἶδος καὶ δέχεσθαι.", "seq": 1717}
{"id": "Elias_Passim_1718", "series": "CAG", "text": "ἀλλ᾿ οὖν τοῦτο κυρίως ἴδιον καὶ περὶ τούτου οἱ φιλόσοφοι διαλέγονται·", "seq": 1718}
{"id": "Elias_Passim_1719", "series": "CAG", "text": "τὰ γὰρ ἄλλα οὐ κυρίως ἴδια, ἀλλὰ πρός τι καὶ ποτέ·", "seq": 1719}
{"id": "Elias_Passim_1720", "series": "CAG", "text": "πρός τι μὲν τὰ δύο τὰ πρῶτα, τὸ γεωμετρεῖν πρὸς τοὺς μὴ γεωμετροῦντας καὶ τὸ δίπουν πρὸς τὰ τετράποδα, τὸ δὲ τρίτον ποτὲ ἴδιον, τὸ δὲ τέταρτον κυρίως ἴδιον.", "seq": 1720}
{"id": "Elias_Passim_1721", "series": "CAG", "text": "διαφέρει δὲ τὸ πρῶτον σημαινόμενον τοῦ δευτέρου, ὅτι τούτου μᾶλλον ἴδιον τὸ πρῶτον, ἐπειδὴ τὰ ἴδια στενοχωρεῖσθαι θέλοντα τῷ μόνῳ χαρακτηρίζονται καὶ οὐ τῷ παντί.", "seq": 1721}
{"id": "Elias_Passim_1722", "series": "CAG", "text": "τὸ δὲ τρίτον ἔτι μᾶλλον ἴδιον καὶ κρεῖττον τῶν δύο τῶν πρὸ αὐτοῦ, ὅτι τὸ μὲν πρῶτον σημαινόμενον μόνῳ ὑπάρχει οὐ παντὶ δέ, τὸ δεύτερον παντὶ μὲν οὐ μόνῳ δέ, τοῦτο δὲ καὶ μόνῳ καὶ παντί.", "seq": 1722}
{"id": "Elias_Passim_1723", "series": "CAG", "text": "τὸ δὲ τέταρτον τῶν τριῶν κρεῖττον ὡς κυρίως ἴδιον, ὃ καὶ ὑπογράφει λέγων οὕτως·", "seq": 1723}
{"id": "Elias_Passim_1724", "series": "CAG", "text": "ἴδιόν ἐστι τὸ ἀντιστρέφον.", "seq": 1724}
{"id": "Elias_Passim_1725", "series": "CAG", "text": "οὐκ ἀρκεῖ δὲ τοῦτο (ἀντιστρέφει γὰρ καὶ ὁ ὁρισμὸς καὶ τὸ νοῦ καὶ ἐπιστήμης δεκτικόν), ἀλλ᾿ ἴδιόν ἐστι συμβεβηκὸς ἀντιστρέφον, ὡς δοκεῖ καὶ Ἀριστοτέλει ἐν τοῖς Τοπικοῖς, ἀφ᾿ ὧν ἡ παροῦσα πραγματεία συνετέθη.", "seq": 1725}
{"id": "Elias_Passim_1726", "series": "CAG", "text": "ἐπειδὴ δὲ ἀντιστρέφον ἐδείχθη τὸ ἴδιον, ἀποροῦσί τινες ὅτι οὐ μόνον ἀντιστρέφει τὸ ἴδιον ἀλλὰ καὶ ὁ ὁρισμός, ὡς εἴρηται, καὶ ἡ ὑπογραφὴ καὶ τὸ νοῦ καὶ ἐπιστήμης δεκτικὸν καὶ τὰ πρός τι.", "seq": 1726}
{"id": "Elias_Passim_1727", "series": "CAG", "text": "πρὸς ὅ φαμεν ὅτι ὁ ὁρισμὸς οὐσιώδης ἐστὶ καὶ ἀντιστρέφει, τὸ δὲ ἴδιον ἐπεισοδιῶδες, καὶ ἡ ὑπογραφὴ ἐκ πολλῶν συμβεβηκότων, τοῦτο δὲ ἓν συμβεβηκός, καὶ τὸ νοῦ καὶ ἐπιστήμης δεκτικὸν οὐσιῶδες, τὰ δὲ πρός τι οὐδὲ ἀντιστρέφοντα, ἀλλὰ πρὸς ἀντιστρέφοντα λέγονται·", "seq": 1727}
{"id": "Elias_Passim_1728", "series": "CAG", "text": "τὰ γὰρ ἀντιστρέφοντα λέγονται ὅπερ τὸ ἕτερον, οἷον τὸ γελαστικὸν ἄνθρωπος καὶ ὁ ἄνθρωπος γελαστικόν, καὶ τὸ νοῦ καὶ ἐπιστήμης δεκτικὸν ἄνθρωπος καὶ ὁ ἄνθρωπος νοῦ καὶ ἐπιστήμης δεκτικόν·", "seq": 1728}
{"id": "Elias_Passim_1729", "series": "CAG", "text": "τὰ δὲ πρός τι οὐ λέγονται ὅπερ τὸ ἕτερον·", "seq": 1729}
{"id": "Elias_Passim_1730", "series": "CAG", "text": "ὁ γὰρ πατὴρ οὐ λέγεται υἱὸς οὐδὲ ὁ υἱὸς πατήρ.", "seq": 1730}
{"id": "Elias_Passim_1731", "series": "CAG", "text": "ταῦτα ἔχει ἡ πρᾶξις.", "seq": 1731}
{"id": "Elias_Passim_1732", "series": "CAG", "text": "Πρᾶξις λδ΄", "seq": 1732}
{"id": "Elias_Passim_1733", "series": "CAG", "text": "Περὶ συμβεβηκότος.", "seq": 1733}
{"id": "Elias_Passim_1734", "series": "CAG", "text": "12.", "seq": 1734}
{"id": "Elias_Passim_1735", "series": "CAG", "text": "24 Συμβεβηκός ἐστιν ὃ γίνεται καὶ ἀπογίνεται χωρὶς τῆς τοῦ ὑποκειμένου φθορᾶς.", "seq": 1735}
{"id": "Elias_Passim_1736", "series": "CAG", "text": "Αἱ ὑπογραφαὶ τοῦ συμβεβηκότος τὴν τάξιν αὐτοῦ τὴν πρὸς τὰς ἄλλας φωνὰς ἡμῖν ἀποκηρύττουσιν·", "seq": 1736}
{"id": "Elias_Passim_1737", "series": "CAG", "text": "εἰ γὰρ συμβεβηκός ἐστιν ὃ γίνεται καὶ ἀπογίνεται χωρὶς τῆς τοῦ ὑποκειμένου φθορᾶς, ἀβληχρὸν καὶ ἀμενηνὸν καὶ οὐδενόσωρον ποιητικῶς εἰπεῖν ἐστι τὸ συμβεβηκὸς ὡς μήτε παρὸν σῶζον μήτε ἀπὸν φθεῖρον καὶ διὰ τοῦτο καὶ εἰς παρουσίαν περιττὸν καὶ εἰς ἀπουσίαν ἀδιάφθορον.", "seq": 1737}
{"id": "Elias_Passim_1738", "series": "CAG", "text": "ἀντιπέπονθε δὲ τοῦ συμβεβηκότος ἡ διδασκαλία τῇ τῶν ἄλλων φωνῶν διδασκαλίᾳ·", "seq": 1738}
{"id": "Elias_Passim_1739", "series": "CAG", "text": "ἐπὶ γὰρ ἐκείνων διεστέλλετο τὴν ὁμωνυμίαν καὶ ἐφυλοκρίνει τὸ σημαινόμενον, περὶ οὗ διαλέγονται οἱ φιλόσοφοι, καὶ τρίτον ὑπέγραφεν αὐτό, ἐνταῦθα δὲ εὐθὺς ὑπογράφει τὸ συμβεβηκός.", "seq": 1739}
{"id": "Elias_Passim_1740", "series": "CAG", "text": "καὶ λέγομεν ὅτι εὐλόγως τοῦτο ἐποίει, ἐπειδὴ πολλῶν ὄντων τῶν σημαινομένων ἐν ταῖς ἄλλαις φωναῖς οὐ περὶ πάντων διαλέγονται οἱ φιλόσοφοι, χρεία οὖν ἦν ἐκεῖ διαστολῆς, ἐνταῦθα δὲ διττοῦ ὄντος τοῦ σημαινομένου (ἢ γὰρ χωριστόν ἐστι τὸ συμβεβηκὸς ἢ ἀχώριστον), περὶ ἀμφοτέρων δὲ διαλέγονται οἱ φιλόσοφοι, εὐλόγως οὐ διαστέλλεται τὴν ὁμωνυμίαν ἐνταῦθα, ἀλλ᾿ εὐθὺς ἐκ τῶν ὑπογραφῶν ἄρχεται.", "seq": 1740}
{"id": "Elias_Passim_1741", "series": "CAG", "text": "λέγει δὲ τρεῖς ὑπογραφὰς τοῦ συμβεβηκότος, μίαν μὲν τὴν ἤδη εἰρημένην, δευτέραν δὲ τοιαύτην, ὅτι συμβεβηκός ἐστιν ὃ δύναται ὑπάρχειν καὶ μὴ ὑπάρχειν τῷ αὐτῷ, καὶ τρίτην ὃ οὐδὲ γένος ἐστὶν οὐδὲ διαφορὰ οὐδὲ εἶδος οὐδὲ ἴδιον.", "seq": 1741}
{"id": "Elias_Passim_1742", "series": "CAG", "text": "διαφέρουσι δὲ αἱ πρῶται δύο τῆς τρίτης, ὅτι αἱ μὲν τί ἐστι λέγουσι τὸ συμβεβηκός, ἡ δὲ τρίτη τί οὐκ ἔστιν.", "seq": 1742}
{"id": "Elias_Passim_1743", "series": "CAG", "text": "ἡ δὲ πρώτη τῆς δευτέρας διαφέρει, ὅτι ἡ μὲν πρώτη τὴν γένεσιν αὐτοῦ καὶ φθορὰν λέγει, ἡ δὲ δευτέρα τὴν ὕπαρξιν καὶ ἀνυπαρξίαν·", "seq": 1743}
{"id": "Elias_Passim_1744", "series": "CAG", "text": "πρότερον γὰρ γίνεταί τι καὶ οὕτως ὑπάρχει.", "seq": 1744}
{"id": "Elias_Passim_1745", "series": "CAG", "text": "ἔστι δὲ ἀπορῆσαι πρὸς τὰς ὑπογραφάς, καὶ πρὸς μὲν τὰς πρώτας δύο ὑπογραφὰς κοινὴν ἀπορίαν·", "seq": 1745}
{"id": "Elias_Passim_1746", "series": "CAG", "text": "εἰ γὰρ συμβεβηκός ἐστιν ὃ γίνεται καὶ ἀπογίνεται χωρὶς φθορᾶς τοῦ ὑποκειμένου καὶ ὃ δύναται ὑπάρχειν καὶ μὴ ὑπάρχειν τῷ αὐτῷ, οὐκέτι πᾶν συμβεβηκὸς αὕτη ἡ ὑπογραφὴ περιέλαβεν, ἀλλὰ μόνον τὸ χωριστόν.", "seq": 1746}
{"id": "Elias_Passim_1747", "series": "CAG", "text": "πρὸς ὅ φαμεν ὅτι ὅσον μὲν ἐπὶ τῇ ἐνεργείᾳ πᾶν συμβεβηκὸς ἢ ἀχώριστόν ἐστιν ἢ χωριστόν, ὅσον δὲ ἐπὶ τῇ ἐπινοίᾳ πᾶν συμβεβηκὸς χωριστόν.", "seq": 1747}
{"id": "Elias_Passim_1748", "series": "CAG", "text": "διό φησι καὶ αὐτὸς ὁ Πορφύριος ὅτι δύναται ἐπινοηθῆναι καὶ κόραξ λευκὸς καὶ Αἰθίοψ ἀποβάλλων τὴν χροιὰν χωρὶς φθορᾶς τοῦ ὑποκειμένου.", "seq": 1748}
{"id": "Elias_Passim_1749", "series": "CAG", "text": "ἀλλὰ καὶ πρὸς τὴν πρώτην ὑπογραφὴν μόνην ἔστιν ἀπορῆσαι, ὅτι εἰ συμβεβηκός ἐστιν ὃ γίνεται καὶ ἀπογίνεται χωρὶς φθορᾶς τοῦ ὑποκειμένου, πῶς ὁ ἑκτικὸς πυρετὸς συμβεβηκὸς ὢν (θερμασία γάρ ἐστι παρὰ φύσιν), οὐκ ἀπογίνεται χωρὶς φθορᾶς τοῦ ὑποκειμένου·", "seq": 1749}
{"id": "Elias_Passim_1750", "series": "CAG", "text": "εἰ μὴ γὰρ φθείρει τὸν ἄνθρωπον, οὐκ ἀπογίνεται.", "seq": 1750}
{"id": "Elias_Passim_1751", "series": "CAG", "text": "λύσις τούτου, ὅτι ὁ ἑκτικὸς πυρετὸς οὐ φθείρει τὸ ὑποκείμενον·", "seq": 1751}
{"id": "Elias_Passim_1752", "series": "CAG", "text": "οὐδὲν γὰρ τὸ ὑποκείμενον φθείρει, ἐπεὶ λήσει καὶ ἑαυτὸ φθεῖρον, πάντα δὲ τοῦ εἶναι ἐφίεται·", "seq": 1752}
{"id": "Elias_Passim_1753", "series": "CAG", "text": "ὁ γὰρ ἑκτικὸς πυρετὸς ἐν ἄλλῳ μέν ἐστιν, ἄλλο δὲ φθείρει·", "seq": 1753}
{"id": "Elias_Passim_1754", "series": "CAG", "text": "ἔστι μὲν γὰρ ἁπλῶς ἐν σώματι, φθείρει δὲ οὐ τὸ σῶμα (τὸ γὰρ σῶμα ἔμεινε καὶ μετὰ θάνατον σῶμα), ἀλλὰ φθείρει τὴν ὑγρότητα τὴν ἐν τῷ σώματι·", "seq": 1754}
{"id": "Elias_Passim_1755", "series": "CAG", "text": "καθόλου γὰρ ἔστιν εἰπεῖν·", "seq": 1755}
{"id": "Elias_Passim_1756", "series": "CAG", "text": "ποιότης ποιότητι μάχεται, οὐ ποιότης ὑποκειμένῳ·", "seq": 1756}
{"id": "Elias_Passim_1757", "series": "CAG", "text": "ἡ γὰρ θερμότης τῇ ψύξει μάχεται καὶ ἡ ξηρότης τῇ ὑγρότητι, ὧν φθειρομένων φθείρεται καὶ τὸ ζῷον.", "seq": 1757}
{"id": "Elias_Passim_1758", "series": "CAG", "text": "καὶ ἡ ἐμφανὴς γὰρ καῦσις τῆς θρυαλλίδος οὐ τὸ ὑποκείμενον ἔφθειρε (τοῦτο γὰρ μένει καὶ μετὰ τὴν ἀπόσβεσιν αὐτῆς), ἀλλὰ τὴν ὑγρότητα τῆς θρυαλλίδος, καὶ ἡ φαλάκρωσις οὐ τὴν κεφαλὴν φθείρει τὸ ὑποκείμενον ἀλλὰ τὴν τρίχωσιν, καὶ ἡ ἁρμονία οὐ τὰς χορδὰς φθείρει τὸ ὑποκείμενον ἀλλὰ τὸ ἀντικείμενον, φημὶ τὴν ἀναρμοστίαν.", "seq": 1758}
{"id": "Elias_Passim_1759", "series": "CAG", "text": "ταῦτα καὶ πρὸς τὴν ἀπορίαν τῆς πρώτης ὑπογραφῆς λεκτέον.", "seq": 1759}
{"id": "Elias_Passim_1760", "series": "CAG", "text": "ἔστι δὲ καὶ πρὸς τὴν τρίτην ὑπογραφὴν ἀπορῆσαι τρεῖς ἀπορίας·", "seq": 1760}
{"id": "Elias_Passim_1761", "series": "CAG", "text": "μίαν μὲν ὅτι ἡ τρίτη ὑπογραφὴ τί οὐκ ἔστι μόνον λέγει τὸ συμβεβηκός, οὐ μὴν τί ἐστι, δευτέραν δὲ ὅτι ἁρμόζει ἡ τοιαύτη ὑπογραφὴ καὶ τῷ μηδαμῇ μηδαμῶς ὄντι (οὐδὲν γάρ ἐστι τοῦτο τῶν πέντε φωνῶν), καὶ τρίτην ὅτι διὰ τί ἐπὶ μὲν τοῦ συμβεβηκότος ἀποφάσκει μόνον ἡ ὑπογραφή, ἐπὶ δὲ τῶν ἄλλων φωνῶν οὐχ οὕτως, ἀλλὰ καταφατικῶς προῆλθε πᾶσα ὑπογραφὴ αὐτῶν.", "seq": 1761}
{"id": "Elias_Passim_1762", "series": "CAG", "text": "αὗται μὲν αἱ ἀπορίαι.", "seq": 1762}
{"id": "Elias_Passim_1763", "series": "CAG", "text": "πρὸς τὴν πρώτην οὖν φαμεν ὅτι οὐ μόνον τί οὐκ ἔστι λέγει ἡ ὑπογραφή, ἀλλὰ καὶ τί ἐστι·", "seq": 1763}
{"id": "Elias_Passim_1764", "series": "CAG", "text": "ἑαυτὸν γὰρ ἐπελύσατο εἰπὼν ἀεὶ δέ ἐστιν ἐν ὑποκειμένῳ.", "seq": 1764}
{"id": "Elias_Passim_1765", "series": "CAG", "text": "** τὸ συμβεβηκός, οὐχ ἁρμόζει τοῦτο τῷ μηδαμῇ μηδαμῶς ὄντι·", "seq": 1765}
{"id": "Elias_Passim_1766", "series": "CAG", "text": "ἐκεῖνο γὰρ ὅλως μὴ ὂν οὐδὲ ἐν ὑποκειμένῳ ἐστίν.", "seq": 1766}
{"id": "Elias_Passim_1767", "series": "CAG", "text": "καὶ τὴν τρίτην ἀπορίαν λύσεις οὕτω λέγων·", "seq": 1767}
{"id": "Elias_Passim_1768", "series": "CAG", "text": "ἐπὶ τῶν ἄλλων φωνῶν οὐκ ἠδύνατο ἀποφατικῶς προαγαγεῖν τὰς ὑπογραφὰς καὶ εἰπεῖν ‘γένος ἐστὶν ὃ μήτε διαφορὰ μήτε εἶδος μήτε ἴδιον μήτε συμβεβηκός’ ἢ ‘εἶδός ἐστιν ὃ μήτε γένος μήτε διαφορά’ καὶ τὰ λοιπά, μήπω γινωσκομένων αὐτῶν τί εἰσι, διὰ τὸ μὴ εὐθὺς ἀπορεῖν τινα ‘τί γάρ ἐστι γένος καὶ τί εἶδος;’", "seq": 1768}
{"id": "Elias_Passim_1769", "series": "CAG", "text": ".", "seq": 1769}
{"id": "Elias_Passim_1770", "series": "CAG", "text": "ἐκείνων δὲ προεγνωσμένων καὶ ἄλλης λοιπὸν μὴ οὔσης φωνῆς εἰ μὴ ταύτης, εἰκότως καὶ ἀποφατικῶς προῆλθεν ἡ ὑπογραφή.", "seq": 1770}
{"id": "Elias_Passim_1771", "series": "CAG", "text": "<Πρᾶξις λε'>", "seq": 1771}
{"id": "Elias_Passim_1772", "series": "CAG", "text": "13.", "seq": 1772}
{"id": "Elias_Passim_1773", "series": "CAG", "text": "6 Ἀφορισθέντων δὲ πάντων τῶν προτεθέντων.", "seq": 1773}
{"id": "Elias_Passim_1774", "series": "CAG", "text": "Ἐπειδὴ ἔγνωμεν τὴν οὐσίαν τῶν πέντε φωνῶν διὰ τοῦ πρώτου τμήματος ἐκ τῶν ὑπογραφῶν, ἐν τῷ δευτέρῳ τμήματι τῷδε τὰς κοινωνίας καὶ διαφορὰς αὐτῶν λέγει καὶ ἐν τῷ τρίτῳ, ἀλλ᾿ ἐν μὲν τῷ δευτέρῳ πασῶν ὑφὲν τὰς κοινωνίας καὶ διαφορὰς λέγει ἐν δὲ τῷ τρίτῳ πασῶν δύο φωνῶν κοινωνίας λέγει καὶ διαφοράς.", "seq": 1774}
{"id": "Elias_Passim_1775", "series": "CAG", "text": "καὶ ἔδει μὲν αὐτὸν ἐνταῦθα γινόμενον πέρας ἐπιθεῖναι τῇ πραγματείᾳ·", "seq": 1775}
{"id": "Elias_Passim_1776", "series": "CAG", "text": "ἃ γὰρ ὑπέσχετο ποιήσειν, πεποίηκεν ὑπογράψας ἑκάστην φωνήν.", "seq": 1776}
{"id": "Elias_Passim_1777", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ πρὸς Χρυσαόριον αὐτῷ ὁ λόγος, ἄνδρα τὰ πρῶτα φέροντα τῆς ἐν Ῥώμῃ γερουσίας καὶ διὰ τοῦτο περὶ τὰ πολιτικὰ πράγματα ἐπτοημένον, ὡς δεῖσθαι διὰ τοῦτο καὶ τῆς τῶν πάνυ σαφῶν διδασκαλίας, οὐκ ὤκνησεν ἀδολεσχῆσαι ἐν καιρῷ καὶ γράφειν αὐτῷ κοινωνίας καὶ διαφορὰς προδήλους οὔσας ἐκ τῶν εἰρημένων καὶ ἔξω τοῦ σκοποῦ·", "seq": 1777}
{"id": "Elias_Passim_1778", "series": "CAG", "text": "ὁ γὰρ εἰδὼς τί ἐστι γένος καὶ διαφορὰ καὶ ἴδιον καὶ τὰ λοιπά, πρόδηλον ὡς καὶ τὰς κοινωνίας αὐτῶν γινώσκει καὶ τὰς διαφοράς·", "seq": 1778}
{"id": "Elias_Passim_1779", "series": "CAG", "text": "τὰ γὰρ πράγματα οὔτε πάντῃ ὅμοιά ἐστιν ἑαυτοῖς (ἐπεὶ περίεργον ἔσται τὸ ἕτερον, οὐδὲν δὲ μάτην ποιεῖ οὔτε ὁ θεὸς οὔτε ἡ φύσις), οὔτε πάντῃ διαφέρουσιν ἀλλήλων, ἐπεὶ διοίσουσι καὶ τῷ ἐκ μιᾶς εἶναι ἀρχῆς καὶ οὐκέτι μία τῶν ὅλων ἀρχή.", "seq": 1779}
{"id": "Elias_Passim_1780", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ μία τῶν πάντων ἀρχὴ καὶ ἀπειροδύναμος, καθὸ μὲν μία τῶν πάντων ἀρχή, κοινωνοῦσι πάντα, καθὸ δὲ ἀπειροδύναμος, διαφέρουσι.", "seq": 1780}
{"id": "Elias_Passim_1781", "series": "CAG", "text": "καὶ ταῦτα μὲν περὶ τούτου.", "seq": 1781}
{"id": "Elias_Passim_1782", "series": "CAG", "text": "Ἐφ᾿ οἷς εἴπωμεν τὰς κοινωνίας.", "seq": 1782}
{"id": "Elias_Passim_1783", "series": "CAG", "text": "καὶ αὐτὸς μὲν μίαν λέγει αὐτῶν κοινωνίαν, ὅτι πᾶσαι αἱ φωναὶ κοινωνοῦσιν ἀλλήλαις, ὅτι καθόλου εἰσίν.", "seq": 1783}
{"id": "Elias_Passim_1784", "series": "CAG", "text": "ἡμεῖς προσθῶμεν καὶ ἄλλας δύο κοινωνίας αὐτῶν, ὅτι πᾶσαι φιλόσοφοί εἰσι καὶ ὅτι μιᾶς ὁποιασοῦν ἀναιρουμένης καὶ αἱ λοιπαὶ ἀναιροῦνται·", "seq": 1784}
{"id": "Elias_Passim_1785", "series": "CAG", "text": "γένους γὰρ ἀναιρεθέντος εἶδος οὐκ ἔστιν οὐδὲ διαφορά (συνεκλείπουσι γὰρ τῷ μὲν γένει αἱ διαιρετικαὶ διαφοραί, τῷ δὲ εἴδει αἱ συστατικαί), καὶ εἴδους μὴ ὄντος οὐδὲ ὁ χαρακτὴρ αὐτοῦ ἔσται, τὸ ἴδιον, ἰδίου <δὲ> μὴ ὄντος ἄτομον οὐκ ἔστιν οὐδὲ συμβεβηκός.", "seq": 1785}
{"id": "Elias_Passim_1786", "series": "CAG", "text": "καὶ ἀντιστρόφως ἐὰν εἴπῃς, τὸ αὐτὸ εὑρήσεις.", "seq": 1786}
{"id": "Elias_Passim_1787", "series": "CAG", "text": "αὗται μὲν αὐτῶν αἱ κοινωνίαι.", "seq": 1787}
{"id": "Elias_Passim_1788", "series": "CAG", "text": "ἔλθωμεν δὲ καὶ ἐπὶ τὰς διαφορὰς αὐτῶν.", "seq": 1788}
{"id": "Elias_Passim_1789", "series": "CAG", "text": "διχῶς δὲ λαμβάνονται αὐτῶν αἱ διαφοραί·", "seq": 1789}
{"id": "Elias_Passim_1790", "series": "CAG", "text": "ἢ γὰρ κατὰ τὸ ὑποκείμενον ἢ κατὰ τὸ κατηγορούμενον.", "seq": 1790}
{"id": "Elias_Passim_1791", "series": "CAG", "text": "κατὰ μὲν τὸ ὑποκείμενον, ὅτι ἐπὶ πλέον ἐστὶ τὸ γένος τῆς διαφορᾶς καὶ ἡ διαφορὰ τοῦ ἰδίου καὶ τὸ ἴδιον τοῦ εἴδους·", "seq": 1791}
{"id": "Elias_Passim_1792", "series": "CAG", "text": "τὸ γὰρ ἴδιον καὶ τοῦ ἀνθρώπου τοῦ καθόλου κατηγορεῖται καὶ τῶν κατὰ μέρος ἀνθρώπων, ὁ δὲ καθόλου ἄνθρωπος μόνον τῶν κατὰ μέρος ἀνθρώπων κατηγορεῖται.", "seq": 1792}
{"id": "Elias_Passim_1793", "series": "CAG", "text": "οὐ δεῖ δὲ διὰ τοῦτο παραιτεῖσθαι τὸ λέγειν ἀντιστρέφειν τὸ ἴδιον τῷ εἴδει διὰ τὸ δοκεῖν τὸ ἴδιον ἐπὶ πλέον εἶναι·", "seq": 1793}
{"id": "Elias_Passim_1794", "series": "CAG", "text": "εἰ γὰρ καὶ ἀντιστρέφει τὸ ἴδιον τῷ εἴδει καὶ ταύτῃ νομίζεται ἐξισάζειν αὐτῷ, ἀλλ᾿ ἐπὶ πλειόνων φέρεται τὸ ἴδιον, ὡς εἴρηται, ἤπερ τὸ εἶδος, εἴ γε τὸ μὲν γελαστικὸν καὶ ἀνθρώπου καὶ τῶν κατὰ μέρος ἀνθρώπων κατηγορεῖται, τὸ δὲ εἶδος οἷον ἄνθρωπος κατὰ μόνων τῶν κατὰ μέρος ἀνθρώπων.", "seq": 1794}
{"id": "Elias_Passim_1795", "series": "CAG", "text": "ἀντιστρέφει δὲ τὸ ἴδιον ὡς μόνῳ τῷ εἴδει ὑπάρχον καὶ παντὶ καὶ ἀεί, καὶ μὴ ἐκ συμβεβηκότος αὐτῷ.", "seq": 1795}
{"id": "Elias_Passim_1796", "series": "CAG", "text": "τὸ δὲ συμβεβηκὸς οἷον τὸ λευκὸν καὶ τοῦ εἴδους ἐπὶ πλέον οἷον τοῦ ἀνθρώπου καὶ τοῦ ἰδίου οἷον τοῦ γελαστικοῦ, τοῦ μὲν εἴδους, ὅτι πολλοῖς εἴδεσιν ὑπάρχει, τοῦ δὲ ἰδίου, ὅτι τὸ ἴδιον ἑνὶ μόνῳ εἴδει ὑπάρχει.", "seq": 1796}
{"id": "Elias_Passim_1797", "series": "CAG", "text": "καὶ οὕτως μὲν ἐκ τοῦ ὑποκειμένου·", "seq": 1797}
{"id": "Elias_Passim_1798", "series": "CAG", "text": "ἀλλὰ καὶ ἐκ τοῦ τρόπου τῆς κατηγορίας·", "seq": 1798}
{"id": "Elias_Passim_1799", "series": "CAG", "text": "τὰ γὰρ οὐσιώδη, γένος καὶ διαφορά, ὡς καθολικώτερα οὐσιώδη πρῶτον τοῖς εἴδεσιν ὑπάρχουσι καὶ οὕτως τοῖς ἀτόμοις (τὸ γὰρ ζῷον γένος ὂν πρῶτον ὑπάρχει τῷ καθόλου ἀνθρώπῳ, καὶ οὕτως τοῖς κατὰ μέρος, οἷον Σωκράτει καὶ Πλάτωνι), τὸ δὲ συμβεβηκὸς πρῶτον τοῖς ἀτόμοις ὑπάρχει καὶ οὕτως τοῖς εἴδεσιν·", "seq": 1799}
{"id": "Elias_Passim_1800", "series": "CAG", "text": "ὁ γὰρ καθόλου κύκνος λευκὸς λέγεται, καίτοι ἀσώματος ὢν καὶ ἄδεκτος λευκότητος, διὰ τὸ μηδένα τῶν κατὰ μέρος κύκνων ἐκπεφευγέναι τὴν λευκότητα.", "seq": 1800}
{"id": "Elias_Passim_1801", "series": "CAG", "text": "πρόσθες δὲ σὺ καὶ ἄλλα ἴδια αὐτῶν, ὅτι τῶν πέντε φωνῶν αἱ ὑπογραφαὶ διάφοροι, <ὧν δὲ αἱ ὑπογραφαὶ διάφοροι>, καὶ αὐτὰ διάφορα, καὶ ὅτι τὸ μὲν γένος καὶ τὸ εἶδος ἐν τῷ τί ἐστι κατηγορεῖται, ἡ δὲ διαφορὰ καὶ τὸ ἴδιον καὶ τὸ συμβεβηκὸς ἐν τῷ ποῖόν τί ἐστι.", "seq": 1801}
{"id": "Elias_Passim_1802", "series": "CAG", "text": "ταῦτα ἔχει ἡ θεωρία.", "seq": 1802}
{"id": "Elias_Passim_1803", "series": "CAG", "text": "<Πρᾶξις λς'>.", "seq": 1803}
{"id": "Elias_Passim_1804", "series": "CAG", "text": "13.", "seq": 1804}
{"id": "Elias_Passim_1805", "series": "CAG", "text": "23 Κοινὸν δὲ γένους καὶ διαφορᾶς.", "seq": 1805}
{"id": "Elias_Passim_1806", "series": "CAG", "text": "Παραδοὺς ἡμῖν ὁ Πορφύριος ἐν τῷ δευτέρῳ τμήματι ὑφ᾿ ἓν τῶν πέντε φωνῶν τὰ κοινὰ καὶ διαφέροντα, ἐν τῷ τρίτῳ τμήματι παραδίδωσιν ἡμῖν πασῶν τῶν δύο φωνῶν τὰ κοινὰ καὶ ἴδια.", "seq": 1806}
{"id": "Elias_Passim_1807", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ τῶν προτέρων πρότεραι καὶ αἱ συζυγίαι, πρότερα δὲ φύσει γένος καὶ διαφορά, τούτων πρότερον λέγει τὰ κοινὰ καὶ ἴδια.", "seq": 1807}
{"id": "Elias_Passim_1808", "series": "CAG", "text": "καὶ εὐλόγως ἐν μὲν τῇ διδασκαλίᾳ προέταξε τὸ εἶδος τῆς διαφορᾶς ὡς συνεισφερόμενον τῷ γένει, πρὸ δὲ τῆς διδασκαλίας αὐτῶν ἤγουν ὑπογραφῆς καὶ ἐνταῦθα πάλιν προτάττει τὴν διαφορὰν τοῦ εἴδους ὡς καθολικωτέραν.", "seq": 1808}
{"id": "Elias_Passim_1809", "series": "CAG", "text": "ἐπειδὴ δὲ σχεδὸν ἐν πάσαις ταῖς κοινωνίαις καὶ διαφοραῖς μέμνηται τοῦ φύσει προτέρου, εἴπωμεν τί χαρακτηρίζει τὸ φύσει πρότερον.", "seq": 1809}
{"id": "Elias_Passim_1810", "series": "CAG", "text": "δεῖ δὲ εἰδέναι ὅτι χαρακτηρίζει αὐτὸ τὸ συναναιρεῖν καὶ μὴ συναναιρεῖσθαι καὶ συνεισφέρεσθαι καὶ μὴ συνεισφέρειν·", "seq": 1810}
{"id": "Elias_Passim_1811", "series": "CAG", "text": "ἰδοὺ γὰρ τὸ ζῷον φύσει πρότερον τοῦ ἀνθρώπου ὡς συναναιροῦν καὶ μὴ συναναιρούμενον·", "seq": 1811}
{"id": "Elias_Passim_1812", "series": "CAG", "text": "ζῴου γὰρ μὴ ὄντος οὐδὲ ἄνθρωπος ἔστιν, ἀνθρώπου δὲ μὴ ὄντος οὐδὲν ἧττον τὸ ζῷον ἔστιν.", "seq": 1812}
{"id": "Elias_Passim_1813", "series": "CAG", "text": "ἀλλὰ καὶ συνεισφέρεται καὶ οὐ συνεισφέρει·", "seq": 1813}
{"id": "Elias_Passim_1814", "series": "CAG", "text": "ὁ γὰρ ἄνθρωπος εἰσφέρει τὸ ζῷον (εἴ τι γὰρ ἄνθρωπος, ζῷον), τὸ δὲ ζῷον οὐ συνεισφέρει τὸν ἄνθρωπον·", "seq": 1814}
{"id": "Elias_Passim_1815", "series": "CAG", "text": "δύναται γὰρ εἶναι ζῷον χωρὶς ἀνθρώπου.", "seq": 1815}
{"id": "Elias_Passim_1816", "series": "CAG", "text": "καὶ ἐπὶ τῆς διαφορᾶς ὡσαύτως·", "seq": 1816}
{"id": "Elias_Passim_1817", "series": "CAG", "text": "λογικοῦ ἀναιρεθέντος συναναιρεῖται καὶ ἄνθρωπος καὶ πᾶν λογικόν, ἀνθρώπου δὲ μὴ ὄντος ἔστι λογικὸν ἄλλο, οἷον ἄγγελος.", "seq": 1817}
{"id": "Elias_Passim_1818", "series": "CAG", "text": "καὶ ἄνθρωπος μὲν συνεισφέρει τὸ λογικόν (εἴ τι γὰρ ἄνθρωπος, λογικόν), τὸ λογικὸν δὲ οὐ συνεισφέρει τὸν ἄνθρωπον·", "seq": 1818}
{"id": "Elias_Passim_1819", "series": "CAG", "text": "οὐκ εἴ τι γὰρ λογικόν, ἄνθρωπος.", "seq": 1819}
{"id": "Elias_Passim_1820", "series": "CAG", "text": "Τούτων οὕτως ἐχόντων, εἴπωμεν τὰς κοινωνίας αὐτῶν καὶ διαφοράς.", "seq": 1820}
{"id": "Elias_Passim_1821", "series": "CAG", "text": "τρία τοίνυν λέγει κοινὰ καὶ ἓξ ἴδια.", "seq": 1821}
{"id": "Elias_Passim_1822", "series": "CAG", "text": "πρῶτον μὲν κοινὸν γένους καὶ διαφορᾶς τὸ ἀμφότερα κατὰ πλειόνων καὶ διαφερόντων τῷ εἴδει κατηγορεῖσθαι, δεύτερον κοινὸν αὐτῶν τὸ μὴ μόνον αὐτὰ κατηγορεῖσθαι τῶν εἰδῶν, ἀλλὰ καὶ τὰ οἰκεῖα κατηγορούμενα διαβιβάζειν εἰς τὰ εἴδη·", "seq": 1822}
{"id": "Elias_Passim_1823", "series": "CAG", "text": "ἰδοὺ γὰρ τὸ ζῷον γένος ὂν κατηγορεῖται τοῦ ἀνθρώπου, ἀλλὰ καὶ τὸ ἔμψυχον καὶ αἰσθητικὸν κατηγορούμενα τοῦ ζῴου καὶ τοῦ ἀνθρώπου κατηγορεῖται.", "seq": 1823}
{"id": "Elias_Passim_1824", "series": "CAG", "text": "καὶ ἐπὶ τῆς διαφορᾶς ὡσαύτως·", "seq": 1824}
{"id": "Elias_Passim_1825", "series": "CAG", "text": "τὸ λογικὸν γὰρ τοῦ ἀνθρώπου κατηγορεῖται, ἀλλὰ καὶ τὸ λόγῳ κεχρῆσθαι κατηγορούμενον τοῦ λογικοῦ καὶ τοῦ ἀνθρώπου κατηγορεῖται·", "seq": 1825}
{"id": "Elias_Passim_1826", "series": "CAG", "text": "ὁ γὰρ ἄνθρωπος καὶ λόγῳ κέχρηται καὶ λογικός ἐστιν ὡς ἔχων καὶ ἐνδιάθετον λόγον καὶ προφορικόν.", "seq": 1826}
{"id": "Elias_Passim_1827", "series": "CAG", "text": "ὁ μέντοι ἄγγελος λόγῳ οὐ χρῆται ὡς ἐνδιάθετον μόνον ἔχων λόγον, οὐ μὴν καὶ προφορικόν.", "seq": 1827}
{"id": "Elias_Passim_1828", "series": "CAG", "text": "ὅταν δὲ λέγωμεν τὰ τοῦ γένους καὶ τῆς διαφορᾶς κατηγορούμενα καὶ τοῦ εἴδους κατηγορεῖσθαι, μὴ ὡς φωνὴν λάβῃς τὸ κατηγορούμενον ἀλλ᾿ ὡς πρᾶγμα·", "seq": 1828}
{"id": "Elias_Passim_1829", "series": "CAG", "text": "ἰδοὺ γὰρ τὸ δισύλλαβον κατηγορεῖται τοῦ ζῴου, τοῦ δὲ ἀνθρώπου οὐ κατηγορεῖται (οὐδεὶς γὰρ λέγει τὸν ἄνθρωπον δισύλλαβον), ἐπειδὴ ὡς φωνῆς τοῦ ζῴου τὸ δισύλλαβον κατηγορεῖται.", "seq": 1829}
{"id": "Elias_Passim_1830", "series": "CAG", "text": "καὶ ἐπὶ τῆς διαφορᾶς ὡσαύτως·", "seq": 1830}
{"id": "Elias_Passim_1831", "series": "CAG", "text": "τὸ τετρασύλλαβον κατηγορεῖται τῆς διαφορᾶς, τοῦ δὲ ἀνθρώπου οὐ κατηγορεῖται, ἐπειδὴ ὡς φωνῆς τῆς διαφορᾶς κατηγορήθη τὸ τετρασύλλαβον.", "seq": 1831}
{"id": "Elias_Passim_1832", "series": "CAG", "text": "ἐν οἷς καὶ τὸ δεύτερον.", "seq": 1832}
{"id": "Elias_Passim_1833", "series": "CAG", "text": "τρίτον κοινὸν τὸ φύσει πρότερα εἶναι τὸ γένος καὶ τὴν διαφορὰν ὡς συναναιροῦντα καὶ μὴ συναναιρούμενα.", "seq": 1833}
{"id": "Elias_Passim_1834", "series": "CAG", "text": "ἐφ᾿ οἷς ἔλθωμεν καὶ ἐπὶ τὰ ἴδια αὐτῶν.", "seq": 1834}
{"id": "Elias_Passim_1835", "series": "CAG", "text": "πρῶτον οὖν διάφορον γένους καὶ διαφορᾶς, ὅτι διαφέρει τὸ γένος τῆς διαφορᾶς ὡς καθολικώτερον αὐτῆς.", "seq": 1835}
{"id": "Elias_Passim_1836", "series": "CAG", "text": "δεῖ δὲ διαφορὰς λαμβάνειν τὰς διαιρετικάς, οὐ τὰς συστατικὰς τοῦ γένους·", "seq": 1836}
{"id": "Elias_Passim_1837", "series": "CAG", "text": "αὗται γὰρ καθολικώτεραί εἰσιν ἐκείνων, ὧν εἰσι συστατικαί.", "seq": 1837}
{"id": "Elias_Passim_1838", "series": "CAG", "text": "δεύτερον ὅτι τὸ γένος ἐνεργείᾳ, αἱ δὲ διαφοραὶ δυνάμει ἐν τοῖς γένεσι.", "seq": 1838}
{"id": "Elias_Passim_1839", "series": "CAG", "text": "τρίτον ὅτι τὰ γένη τῶν διαφορῶν φύσει πρότερα.", "seq": 1839}
{"id": "Elias_Passim_1840", "series": "CAG", "text": "διὸ καὶ ἀποροῦσιν ὅτι ταὐτὸν τῷ πρώτῳ τὸ τρίτον ἐστίν·", "seq": 1840}
{"id": "Elias_Passim_1841", "series": "CAG", "text": "εἰ γὰρ καθολικώτερον, καὶ φύσει πρότερον.", "seq": 1841}
{"id": "Elias_Passim_1842", "series": "CAG", "text": "ἀλλ᾿ ἵνα μὴ δόξωμεν ἀδολεσχεῖν, τὸ τρίτον πρῶτον ποιήσωμεν καὶ προτάξωμεν τὸ φύσει πρῶτον τοῦ καθολικωτέρου, ὡς ἄλλο καὶ ἄλλο·", "seq": 1842}
{"id": "Elias_Passim_1843", "series": "CAG", "text": "δύναται γὰρ εἶναι τῇ φύσει πρῶτον καὶ μὴ καθόλου, ὡς ἡ μονὰς φύσει μὲν προτέρα τῆς δυάδος, καθολικωτέρα δὲ οὐκ ἔστι, καὶ ἡ οὐσία τῶν ἄλλων κατηγοριῶν φύσει προτέρα, καθολικωτέρα δὲ αὐτῶν οὐκ ἔστιν, ἐπειδὴ οὐδὲ κατηγορεῖται αὐτῶν.", "seq": 1843}
{"id": "Elias_Passim_1844", "series": "CAG", "text": "τέταρτον ὅτι τὸ μὲν γένος ἐν τῷ τί ἐστιν, ἡ δὲ διαφορὰ ἐν τῷ ποῖόν τί ἐστι κατηγορεῖται.", "seq": 1844}
{"id": "Elias_Passim_1845", "series": "CAG", "text": "πέμπτον διάφορον γένους καὶ διαφορᾶς, ὅτι ἐν τοῖς ὁρισμοῖς ἓν μὲν τὸ γένος, διαφοραὶ δὲ πλείους.", "seq": 1845}
{"id": "Elias_Passim_1846", "series": "CAG", "text": "ἕκτον ὅτι ἄλλῳ ἔοικε τὸ γένος (ὕλῃ γάρ), καὶ ἄλλῳ ἔοικεν ἡ διαφορά·", "seq": 1846}
{"id": "Elias_Passim_1847", "series": "CAG", "text": "εἴδει γάρ.", "seq": 1847}
{"id": "Elias_Passim_1848", "series": "CAG", "text": "καὶ ταῦτα ὁ Πορφύριος.", "seq": 1848}
{"id": "Elias_Passim_1849", "series": "CAG", "text": "ἡμεῖς δὲ προσεθήκαμεν τρία κοινὰ καὶ τρία διάφορα.", "seq": 1849}
{"id": "Elias_Passim_1850", "series": "CAG", "text": "καὶ πρῶτον μὲν κοινὸν αὐτῶν τὸ καὶ τὸ γένος καὶ τὴν διαφορὰν ἀμφότερα ἁπλᾶ εἶναι, δεύτερον ὅτι ἀμφότερα μέρη γίνεται τοῦ εἴδους, τρίτον ὅτι πέντε οὐσῶν τῶν φωνῶν ἐκ τούτων μόνων τῶν δύο οἱ ὁρισμοὶ λαμβάνονται.", "seq": 1850}
{"id": "Elias_Passim_1851", "series": "CAG", "text": "καὶ τὸ ἄμφω ὁμοίως μετέχεσθαι ὑπὸ τῶν εἰδῶν, καὶ τὸ ἄμφω συνωνύμως κατηγορεῖσθαι τῶν εἰδῶν, καὶ τὸ ἄμφω συστατικὰ εἶναι τῶν εἰδῶν.", "seq": 1851}
{"id": "Elias_Passim_1852", "series": "CAG", "text": "ταῦτα μὲν τὰ κοινά.", "seq": 1852}
{"id": "Elias_Passim_1853", "series": "CAG", "text": "τὰ δὲ ἴδια τρία·", "seq": 1853}
{"id": "Elias_Passim_1854", "series": "CAG", "text": "πρῶτον μὲν ὅτι οὐδέποτε τὸ γένος τῷ οἰκείῳ εἴδει ἀντιστρέφει, ἡ δὲ διαφορὰ ἀντιστρέφει, ὡς τὸ νοῦ καὶ ἐπιστήμης δεκτικόν·", "seq": 1854}
{"id": "Elias_Passim_1855", "series": "CAG", "text": "ἀντιστρέφει γὰρ πρὸς τὸν ἄνθρωπον.", "seq": 1855}
{"id": "Elias_Passim_1856", "series": "CAG", "text": "δεύτερον ὅτι ἔστι τι γένος μὴ δυνάμενον γενέσθαι εἶδος, πᾶσα δὲ διαφορὰ καὶ συστατικὴ καὶ διαιρετική ἐστιν, οὐ πᾶν δὲ γένος καὶ εἶδός ἐστι.", "seq": 1856}
{"id": "Elias_Passim_1857", "series": "CAG", "text": "τρίτον ὅτι τὸ μὲν γένος καὶ τὸ εἶδος ἄκρα γενέσθαι δύνανται, ἡ δὲ διαφορὰ ἄκρον οὐδέποτε δύναται γενέσθαι·", "seq": 1857}
{"id": "Elias_Passim_1858", "series": "CAG", "text": "ἀεὶ γὰρ μέση ἐστὶ γένους καὶ εἴδους.", "seq": 1858}
{"id": "Elias_Passim_1859", "series": "CAG", "text": "καὶ ὅτι διαφορὰ μὲν διαφορᾷ ἐπιμίγνυται, ἵνα ποιήσῃ εἶδος (ὡς τὸ λογικὸν τῷ θνητῷ μιγνύμενον ποιεῖ τὸ τοῦ ἀνθρώπου εἶδος), γένος δὲ γένει οὐ συνέρχεται πρὸς γένεσιν εἴδους.", "seq": 1859}
{"id": "Elias_Passim_1860", "series": "CAG", "text": "καὶ ὅτι διαφοραί ποτε κατὰ συμβεβηκὸς ὑπάρχουσιν, ὡς αἱ κοινῶς καὶ ἰδίως λεγόμεναι, γένος δὲ κατὰ συμβεβηκὸς οὐκ ἔστι.", "seq": 1860}
{"id": "Elias_Passim_1861", "series": "CAG", "text": "ταῦτα ἔχει ἡ θεωρία.", "seq": 1861}
{"id": "Elias_Passim_1862", "series": "CAG", "text": "Πρᾶξις λς΄.", "seq": 1862}
{"id": "Elias_Passim_1863", "series": "CAG", "text": "15.", "seq": 1863}
{"id": "Elias_Passim_1864", "series": "CAG", "text": "10 Γένος δὲ καὶ εἶδος κοινὸν μὲν ἔχουσι τὸ κατὰ πλειόνων, ὡς εἴρηται, κατηγορεῖσθαι.", "seq": 1864}
{"id": "Elias_Passim_1865", "series": "CAG", "text": "Παραβαλὼν ὁ Πορφύριος τὸ γένος τῇ διαφορᾷ καὶ εἰπὼν τὰ κοινὰ αὐτῶν καὶ διάφορα, παραβάλλει αὐτὸ καὶ πρὸς τὰς λοιπὰς φωνάς, καὶ πρῶτον πρὸς τὸ εἶδος.", "seq": 1865}
{"id": "Elias_Passim_1866", "series": "CAG", "text": "ἀλλὰ πρῶτον παρεγγυᾷ λέγων μὴ δεῖν παραβάλλειν τὸ γένος πρὸς εἶδος, ἔστ᾿ ἂν τὸ αὐτὸ καὶ γένος ᾖ καὶ εἶδος, ὡς τὰ ὑπάλληλα, ἐπεὶ εὑρίσκεται αὐτὸ πρὸς ἑαυτό τις παραβάλλων·", "seq": 1866}
{"id": "Elias_Passim_1867", "series": "CAG", "text": "αὐτοῦ δὲ πρὸς ἑαυτὸ διαφορὰ οὐκ ἔστιν·", "seq": 1867}
{"id": "Elias_Passim_1868", "series": "CAG", "text": "οὐ δεῖ γὰρ παραβάλλειν τὸ σῶμα πρὸς τὸ σῶμα αὐτὸ πρὸς ἑαυτό, ἀλλὰ πρὸς τὸ ἔμψυχον σῶμα, ὅ ἐστιν αὐτοῦ εἶδος.", "seq": 1868}
{"id": "Elias_Passim_1869", "series": "CAG", "text": "ἐφ᾿ οἷς λέγει τρία κοινὰ γένους καὶ εἴδους καὶ πέντε ἴδια.", "seq": 1869}
{"id": "Elias_Passim_1870", "series": "CAG", "text": "καὶ πρῶτον μὲν κοινὸν τὸ ἀμφότερα κατὰ πλειόνων κατηγορεῖσθαι, δεύτερον ὅτι φύσει πρότερα τῶν ἀτόμων, τρίτον τὸ ὁλότητας αὐτὰ εἶναι τῶν ἀτόμων, ἀλλὰ τὸ μὲν εἶδος προσεχὴς ὁλότης τῶν ἀτόμων, τὸ δὲ γένος πόρρω ὁλότης.", "seq": 1870}
{"id": "Elias_Passim_1871", "series": "CAG", "text": "ἔτι κοινὸν ἔχουσι τὸ ἄμφω ἐν τῷ τί ἐστι κατηγορεῖσθαι καὶ τὸ ἐπίσης μετέχεσθαι ὑπὸ τῶν μετεχόντων αὐτῶν καὶ τὸ ἄμφω συνωνύμως τῶν ὑπ᾿ αὐτὰ κατηγορεῖσθαι·", "seq": 1871}
{"id": "Elias_Passim_1872", "series": "CAG", "text": "συνωνύμως δὲ κατηγορεῖται τὸ μεταδιδὸν τῷ ὑποκειμένῳ καὶ τοῦ οἰκείου ὀνόματος καὶ τοῦ ὁρισμοῦ.", "seq": 1872}
{"id": "Elias_Passim_1873", "series": "CAG", "text": "διαφέρουσι δὲ πενταχῶς, καὶ πρῶτον μὲν ὅτι ἐπὶ πλέον τὸ γένος τοῦ εἴδους·", "seq": 1873}
{"id": "Elias_Passim_1874", "series": "CAG", "text": "τὸ μὲν γὰρ γένος περιέχει τὰ εἴδη, τὰ δὲ εἴδη περιέχεται καὶ οὐ περιέχει τὰ γένη.", "seq": 1874}
{"id": "Elias_Passim_1875", "series": "CAG", "text": "δεύτερον ὅτι τὸ γένος τοῦ εἴδους φύσει πρότερον, ὅθεν εἴδους μὲν ὄντος ἔστι καὶ γένος, γένους δὲ ὄντος οὐ πάντως ἔστιν εἶδος.", "seq": 1875}
{"id": "Elias_Passim_1876", "series": "CAG", "text": "τρίτον ὅτι τὸ μὲν γένος τοῦ εἴδους συνωνύμως κατηγορεῖται (μεταδίδωσι γὰρ <τὸ ζῷον> τῷ ἀνθρώπῳ, τοῦτ᾿ ἔστι τῷ εἴδει, τοῦ ἰδίου ὀνόματος καὶ ὁρισμοῦ·", "seq": 1876}
{"id": "Elias_Passim_1877", "series": "CAG", "text": "καὶ γὰρ ὁ ἄνθρωπος καὶ ζῷον λέγεται καὶ οὐσία ἔμψυχος αἰσθητική), τὸ δὲ εἶδος τοῦ γένους οὐκέτι.", "seq": 1877}
{"id": "Elias_Passim_1878", "series": "CAG", "text": "τέταρτον ὅτι ἀντιπλεονεκτοῦσιν ἑαυτά·", "seq": 1878}
{"id": "Elias_Passim_1879", "series": "CAG", "text": "τὸ γὰρ γένος πλείονα εἴδη περιέχει, οἷον τὸ ζῷον γένος ὂν περιέχει ἄγγελον καὶ ἄνθρωπον ἵππον βοῦν καὶ τὰ λοιπά, τὸ δὲ εἶδος τὰς διαφορὰς πάσας ἐνεργείᾳ ἔχει τοῦ γένους δυνάμει ἔχοντος, τιμιώτερον δὲ τὸ ἐνεργείᾳ τοῦ δυνάμει.", "seq": 1879}
{"id": "Elias_Passim_1880", "series": "CAG", "text": "πέμπτον ὅτι ἔστι τι γένος ὃ οὐ δύναται γενέσθαι εἶδος, φημὶ τὸ γενικώτατον, καὶ ἔστιν εἶδος μὴ δυνάμενον γενέσθαι γένος, ὅ ἐστι εἰδικώτατον.", "seq": 1880}
{"id": "Elias_Passim_1881", "series": "CAG", "text": "Οὕτως συμπλέξας τὸ γένος τῷ εἴδει συμπλέκει αὐτὸ καὶ τῷ ἰδίῳ καὶ λέγει τρία κοινὰ καὶ τέσσαρα διάφορα.", "seq": 1881}
{"id": "Elias_Passim_1882", "series": "CAG", "text": "καὶ πρῶτον μὲν κοινόν ἐστι γένους καὶ ἰδίου τὸ ἀμφότερα ἕπεσθαι τοῖς εἴδεσιν·", "seq": 1882}
{"id": "Elias_Passim_1883", "series": "CAG", "text": "εἰ γὰρ ἄνθρωπος, ζῷον, καὶ εἰ ἄνθρωπος, γελαστικόν.", "seq": 1883}
{"id": "Elias_Passim_1884", "series": "CAG", "text": "δεύτερον ὅτι ἀμφότερα ἐπίσης κατηγοροῦνται·", "seq": 1884}
{"id": "Elias_Passim_1885", "series": "CAG", "text": "ἐπίσης γὰρ καὶ τοῦ ζῴου μετέχουσιν οἱ ἄνθρωποι καὶ ἐπίσης τοῦ γελαστικοῦ, εἰ καὶ τῇ ἐνεργείᾳ κατὰ τὸ μᾶλλον καὶ ἧττον διαφέρουσι.", "seq": 1885}
{"id": "Elias_Passim_1886", "series": "CAG", "text": "τρίτον κοινὸν ὅτι συνωνύμως κατηγοροῦνται τῶν εἰδῶν ἀμφότερα·", "seq": 1886}
{"id": "Elias_Passim_1887", "series": "CAG", "text": "ὁ γὰρ ἄνθρωπος καὶ ζῷον λέγεται <καὶ οὐσία ἔμψυχος αἰσθητική, καὶ γελαστικὸς λέγεται> καὶ ζῷον γελᾶν δυνάμενον.", "seq": 1887}
{"id": "Elias_Passim_1888", "series": "CAG", "text": "ταῦτα μὲν κοινά.", "seq": 1888}
{"id": "Elias_Passim_1889", "series": "CAG", "text": "διάφορα δὲ τέσσαρα·", "seq": 1889}
{"id": "Elias_Passim_1890", "series": "CAG", "text": "πρῶτον μὲν ὅτι τὸ γένος τοῦ ἰδίου πρότερον φύσει.", "seq": 1890}
{"id": "Elias_Passim_1891", "series": "CAG", "text": "δεύτερον ὅτι τὸ μὲν γένος κατὰ πλειόνων εἰδῶν κατηγορεῖται, τὸ δὲ ἴδιον ἑνὸς εἴδους, οὗ ἐστιν ἴδιον.", "seq": 1891}
{"id": "Elias_Passim_1892", "series": "CAG", "text": "τρίτον ὅτι τὸ γένος οὐκ ἀντιστρέφει πρὸς τὸ εἶδος, τὸ δὲ ἴδιον ἀντιστρέφει, ὡς τὸ γελαστικόν.", "seq": 1892}
{"id": "Elias_Passim_1893", "series": "CAG", "text": "τέταρτον ὅτι τὸ μὲν ἴδιον παντὶ τῷ εἴδει ὑπάρχει, οὗ ἐστιν ἴδιον, καὶ μόνῳ καὶ ἀεί, τὸ δὲ γένος παντὶ μὲν τῷ εἴδει, οὗ ἐστι γένος, ὑπάρχει καὶ ἀεί, οὐ μὴν καὶ μόνῳ.", "seq": 1893}
{"id": "Elias_Passim_1894", "series": "CAG", "text": "Οὕτως ταῦτα εἰπὼν παραβάλλει τὸ γένος πρὸς τὸ συμβεβηκὸς καὶ ἓν αὐτῶν λέγει κοινὸν ὡς πολὺ διεστώτων, τὸ κατὰ πλειόνων εἰδῶν φέρεσθαι·", "seq": 1894}
{"id": "Elias_Passim_1895", "series": "CAG", "text": "ἐπιστήμονος γάρ ἐστιν εἰπεῖν κοινωνίας τῶν πολὺ διαφερόντων καὶ διαφορὰς τῶν πολὺ κοινωνούντων.", "seq": 1895}
{"id": "Elias_Passim_1896", "series": "CAG", "text": "ἐφ᾿ οἷς λέγει τὰ διάφορα αὐτῶν τέσσαρα ὄντα, καὶ πρῶτον μὲν ὅτι τὸ γένος πρὸ τῶν εἰδῶν ἐστι, τὰ δὲ συμβεβηκότα τῶν εἰδῶν ὕστερα·", "seq": 1896}
{"id": "Elias_Passim_1897", "series": "CAG", "text": "κἂν γὰρ ἀχώριστον ᾖ συμβεβηκός, οἷον γρυπότης ἢ σιμότης, ἀλλ᾿ οὖν πρότερόν ἐστι τὸ ὑποκείμενον ἐκεῖνο, ἐν ᾧ ταῦτα τὸ εἶναι ἔσχον.", "seq": 1897}
{"id": "Elias_Passim_1898", "series": "CAG", "text": "δεύτερον ὅτι τοῦ μὲν γένους ἐπίσης τὰ μετέχοντα μετέχει, τοῦ δὲ συμβεβηκότος οὐκ ἐπίσης·", "seq": 1898}
{"id": "Elias_Passim_1899", "series": "CAG", "text": "λέγομεν γὰρ μᾶλλον λευκὸν καὶ ἧττον καὶ σιμὸν μᾶλλον καὶ ἧττον.", "seq": 1899}
{"id": "Elias_Passim_1900", "series": "CAG", "text": "τρίτον ὅτι τὰ μὲν συμβεβηκότα, ὡς καὶ ἀνωτέρω μεμαθήκαμεν, ἐπὶ τῶν ἀτόμων προηγουμένως ὑφίστανται καὶ κατὰ δευτέραν τάξιν ἐπὶ τῶν εἰδῶν (τὸν γὰρ καθόλου κύκνον λευκὸν λέγομεν καίτοι ἀσώματον ὄντα διὰ τὸ μηδένα τῶν κατὰ μέρος κύκνων ἐκπεφευγέναι τὴν λευκότητα), τὰ δὲ γένη καὶ τὰ εἴδη φύσει πρότερα τῶν ἀτόμων οὐσιῶν.", "seq": 1900}
{"id": "Elias_Passim_1901", "series": "CAG", "text": "τέταρτον ὅτι τὸ μὲν γένος ἐν τῷ τί ἐστι κατηγορεῖται τῶν ὑπ᾿ αὐτό, τὸ δὲ συμβεβηκὸς ἐν τῷ ποῖόν τι ἢ πῶς ἔχον ἕκαστον·", "seq": 1901}
{"id": "Elias_Passim_1902", "series": "CAG", "text": "ποῖος γὰρ Αἰθίοψ ἐρωτηθεὶς ἐρεῖς ‘μέλας’ καὶ πῶς ἔχει Σωκράτης ἐρεῖς ‘κάθηται ἢ περιπατεῖ’.", "seq": 1902}
{"id": "Elias_Passim_1903", "series": "CAG", "text": "<Πρᾶξις λη'>.", "seq": 1903}
{"id": "Elias_Passim_1904", "series": "CAG", "text": "17.", "seq": 1904}
{"id": "Elias_Passim_1905", "series": "CAG", "text": "14 Τὸ μὲν οὖν γένος ᾗ τῶν ἄλλων τεττάρων διαφέρει, εἴρηται.", "seq": 1905}
{"id": "Elias_Passim_1906", "series": "CAG", "text": "Ἐπειδὴ ἔγνωμεν τὰς σχέσεις τοῦ γένους, ἃς ἔχει πρὸς τὰς λοιπὰς φωνάς, φέρε κατὰ δίαυλόν τινα ἑτέραν ἀρχὴν προσστησάμενοι τὴν διαφορὰν εἴπωμεν τὰς σχέσεις, ἃς ποιεῖται ἡ διαφορὰ πρὸς τὰς λοιπὰς φωνάς, τοῦτ᾿ ἔστιν εἶδος, ἴδιον, συμβεβηκός·", "seq": 1906}
{"id": "Elias_Passim_1907", "series": "CAG", "text": "τοῦ μὲν γὰρ γένους αἱ πρὸς τὰς λοιπὰς φωνὰς σχέσεις τέσσαρες, ὡς μεμαθήκαμεν, πρός τε διαφορὰν καὶ εἶδος καὶ ἴδιον καὶ συμβεβηκός, τῆς δὲ διαφορᾶς τρεῖς πρὸς τὰς μετ᾿ αὐτήν, τοῦτ᾿ ἔστιν εἶδος, ἴδιον καὶ συμβεβηκός, τοῦ δὲ εἴδους δύο πρὸς τὰς ἑξῆς, ἴδιον καὶ συμβεβηκός, τοῦ δὲ ἰδίου καὶ συμβεβηκότος μία, ὡς γενέσθαι τὰς ὅλας δέκα, ὧν τέσσαρες ἤδη εἴρηνται ἡμῖν.", "seq": 1907}
{"id": "Elias_Passim_1908", "series": "CAG", "text": "ἀλλ᾿ ἵνα μὴ οὕτως ἰδιωτικῶς ἑκάστην σχέσιν ἀριθμῶμεν (νῦν μὲν γὰρ εὐπετὲς διὰ τὸ πέντε εἶναι τοὺς ὅρους, ἐπὶ πολλῶν δὲ ὅρων διδομένων δυσχερὲς εἰπεῖν πόσαι γίνονται σχέσεις)·", "seq": 1908}
{"id": "Elias_Passim_1909", "series": "CAG", "text": "δεῖ οὖν εἰπεῖν μέθοδόν τινα, δι᾿ ἧς δυνηθῶμεν ὅσων δήποτε ὅρων δοθέντων εἰπεῖν τὸν ἀριθμὸν τῶν σχέσεων.", "seq": 1909}
{"id": "Elias_Passim_1910", "series": "CAG", "text": "ἔστι δὲ ἡ μέθοδος αὕτη·", "seq": 1910}
{"id": "Elias_Passim_1911", "series": "CAG", "text": "δεῖ λαβεῖν πάντας τοὺς ἀναδιδομένους ὅρους, ὅσοι ἂν ὦσι, καὶ πολλαπλασιάσαι ἐπὶ τὸν μονάδι ἐλάττονα καὶ τῶν συναγομένων λαβεῖν τὸ ἥμισυ καὶ τοσαύτας ἀποφαίνεσθαι εἶναι τὰς σχέσεις·", "seq": 1911}
{"id": "Elias_Passim_1912", "series": "CAG", "text": "ὥσπερ ἐνταῦθα πέντε οὐσῶν τῶν φωνῶν δεῖ πολυπλασιάσαι ἐπὶ τὸν μονάδι ἐλάττονα, φημὶ τὸν τέσσαρα, πεντάκις τέσσαρα εἴκοσι, καὶ τούτων λαβεῖν τὸ ἥμισυ καὶ τοσαύτας εἰπεῖν τὰς σχέσεις, τοῦτ᾿ ἔστι δέκα, ὥσπερ καί εἰσι δέκα.", "seq": 1912}
{"id": "Elias_Passim_1913", "series": "CAG", "text": "ὁμοίως καὶ δέκα ὅρων δοθέντων ἐὰν πολυπλασιάσῃς ἐπὶ τὸν μονάδι ἐλάττονα τὸν ἐννέα, δεκάκις ἐννέα ἐνενήκοντα, καὶ τούτων λάβῃς τὸ ἥμισυ, εὑρήσεις τεσσαράκοντα πέντε οὔσας τὰς σχέσεις.", "seq": 1913}
{"id": "Elias_Passim_1914", "series": "CAG", "text": "ἀποροῦσι δὲ ὅτι ‘διὰ τί ἐπὶ τὸν μονάδι ἐλάττονα πολυπλασιάζομεν;’", "seq": 1914}
{"id": "Elias_Passim_1915", "series": "CAG", "text": "καὶ λέγομεν ὅτι ἐπειδὴ οὐδὲν πρὸς ἑαυτὸ παραβάλλεται, ἀλλὰ πρὸς τὸ ἐφεξῆς, διὰ τοῦτο ἐπὶ τὸν μονάδι ἐλάττονα.", "seq": 1915}
{"id": "Elias_Passim_1916", "series": "CAG", "text": "πάλιν ἀποροῦσιν ὅτι ‘διὰ τί τῶν συναγομένων τὸ ἥμισυ λαμβάνεις;’", "seq": 1916}
{"id": "Elias_Passim_1917", "series": "CAG", "text": "καὶ λέγομεν ὅτι εὐλόγως·", "seq": 1917}
{"id": "Elias_Passim_1918", "series": "CAG", "text": "κατὰ ἀλήθειαν μὲν γὰρ πέντε δοθέντων ὅρων εἴκοσι γίνονται αἱ πᾶσαι σχέσεις ἑκάστου τετράκις πρὸς τὰ λοιπὰ παραβαλλομένου, ἀλλὰ τὸ ἥμισυ παραλιμπάνομεν, ἵνα μὴ δὶς τὰ αὐτὰ λέγοντες ἀδολεσχήσωμεν·", "seq": 1918}
{"id": "Elias_Passim_1919", "series": "CAG", "text": "οἷον ὅταν παραβάλωμεν γένος πρὸς διαφορὰν ἢ εἶδος, οὐ δεῖ πάλιν τὸ εἶδος πρὸς τὸ γένος παραβάλλειν ἢ τὴν διαφορὰν πρὸς τὸ γένος, ἐπειδὴ εἴρηνται τούτων αἱ σχέσεις, ὅτε τὸ γένος αὐτοῖς παρεβάλλομεν.", "seq": 1919}
{"id": "Elias_Passim_1920", "series": "CAG", "text": "καὶ ταῦτα μὲν περὶ τούτου.", "seq": 1920}
{"id": "Elias_Passim_1921", "series": "CAG", "text": "δεῖ δὲ εἰδέναι ὅτι ἐπὶ μόνου τοῦ τρία ἐν ὅλῳ τῷ χύματι τῶν ἀριθμῶν παράδοξον συνέβη τὸ ἴσους εἶναι τοὺς ὅρους ταῖς σχέσεσιν·", "seq": 1921}
{"id": "Elias_Passim_1922", "series": "CAG", "text": "ἐὰν γὰρ πολυπλασιάσῃς τὸν τρία ἐπὶ τὸν μονάδι ἐλάττονα, τρὶς δύο ἕξ, καὶ λάβῃς τὸ ἥμισυ, τρεῖς εὑρίσκονται καὶ αἱ σχέσεις καὶ οἱ ὅροι.", "seq": 1922}
{"id": "Elias_Passim_1923", "series": "CAG", "text": "ἄλλην πάλιν μέθοδον ῥητέον, δι᾿ ἧς δυνάμεθα τῶν ἀναδιδομένων ὅρων τὰς σχέσεις εἰδέναι, ὅτι τοσαῦται γίνονται αἱ σχέσεις, ὅσος ὁ ἀριθμὸς τῶν προϋποκειμένων ὅρων·", "seq": 1923}
{"id": "Elias_Passim_1924", "series": "CAG", "text": "ἑνὸς γὰρ ὄντος ὅρου σχέσις οὐ γίνεται (οὐδὲν γὰρ πρὸς ἑαυτὸ παραβάλλεται), ἄλλου δὲ ὅρου προστεθέντος γίνεται μία σχέσις, ἐπειδὴ καὶ εἷς προϋπέκειτο ὅρος, δύο ὅρων προστεθέντων τῷ πρώτῳ γίνονται ἄλλαι δύο σχέσεις, ἐπειδὴ καὶ δύο εἰσὶν οἱ προϋποκείμενοι ὅροι.", "seq": 1924}
{"id": "Elias_Passim_1925", "series": "CAG", "text": "ἔχεις οὖν τὴν πρώτην μίαν σχέσιν καὶ τὰς δύο τὰς προστεθείσας καὶ γίνονται τρεῖς.", "seq": 1925}
{"id": "Elias_Passim_1926", "series": "CAG", "text": "πάλιν τριῶν ὅρων προστεθέντων τῷ πρώτῳ ἓξ γίνονται αἱ σχέσεις, τρεῖς αἱ προστεθεῖσαι καὶ τρεῖς αἱ προηγησάμεναι.", "seq": 1926}
{"id": "Elias_Passim_1927", "series": "CAG", "text": "τεσσάρων ὅρων προστεθέντων προστίθενται τέσσαρες σχέσεις ταῖς ἓξ καὶ γίνονται δέκα.", "seq": 1927}
{"id": "Elias_Passim_1928", "series": "CAG", "text": "ταῦτα ἔχει ἡ θεωρία.", "seq": 1928}
{"id": "Elias_Passim_1929", "series": "CAG", "text": "ἔστι καὶ ἑτέρα μέθοδος τοιαύτη·", "seq": 1929}
{"id": "Elias_Passim_1930", "series": "CAG", "text": "συντιθέντες γὰρ τοὺς ἀπὸ μονάδος ἀριθμοὺς μέχρι τοῦ μονάδι ἐλάττονος τοῦ προτεθέντος ἀριθμοῦ τὸ συναχθὲν πλῆθός φαμεν, καθ᾿ ὃ αἱ σχέσεις γίνονται τοῦ προκειμένου ἀριθμοῦ τῶν πραγμάτων.", "seq": 1930}
{"id": "Elias_Passim_1931", "series": "CAG", "text": "Πρᾶξις λθ΄.", "seq": 1931}
{"id": "Elias_Passim_1932", "series": "CAG", "text": "18.", "seq": 1932}
{"id": "Elias_Passim_1933", "series": "CAG", "text": "11 Κοινὸν τοίνυν διαφορᾶς καὶ εἴδους.", "seq": 1933}
{"id": "Elias_Passim_1934", "series": "CAG", "text": "Ἐπειδὴ μεμαθήκαμεν πρὸς ἃ δεῖ παραβαλεῖν τὴν διαφοράν, ὅτι πρὸς τὰ μέλλοντα, καὶ πρὸς ἃ οὐ δεῖ, ὅτι πρὸς τὰ φθάσαντα, φέρε τὰ μὲν σιωπῶντες τὰ δὲ διδάσκοντες μήτε τι τῶν ὀφειλόντων ῥηθῆναι παραλείψωμεν μήτε ἀδολεσχίᾳ περιπέσωμεν δὶς τὰ αὐτὰ λέγοντες.", "seq": 1934}
{"id": "Elias_Passim_1935", "series": "CAG", "text": "εἴπωμεν οὖν κοινὰ εἴδους καὶ διαφορᾶς.", "seq": 1935}
{"id": "Elias_Passim_1936", "series": "CAG", "text": "λέγει οὖν ὁ Πορφύριος κοινὰ αὐτῶν δύο, πρῶτον μὲν τὸ ἐπίσης μετέχεσθαι·", "seq": 1936}
{"id": "Elias_Passim_1937", "series": "CAG", "text": "τοῦ γὰρ ἀνθρωπείου εἴδους ἐπίσης μετέχει πᾶς ἄνθρωπος καὶ ἐπίσης τοῦ λογικοῦ.", "seq": 1937}
{"id": "Elias_Passim_1938", "series": "CAG", "text": "δεύτερον κοινὸν αὐτῶν τὸ ἀεὶ μετέχεσθαι αὐτά·", "seq": 1938}
{"id": "Elias_Passim_1939", "series": "CAG", "text": "ἀεὶ γὰρ ὁ Σωκράτης ἄνθρωπος καὶ ἀεὶ λογικός.", "seq": 1939}
{"id": "Elias_Passim_1940", "series": "CAG", "text": "ταῦτα μὲν αὐτῶν κοινά.", "seq": 1940}
{"id": "Elias_Passim_1941", "series": "CAG", "text": "διάφορα δὲ αὐτῶν λέγει τέσσαρα·", "seq": 1941}
{"id": "Elias_Passim_1942", "series": "CAG", "text": "πρῶτον ὅτι ἡ διαφορὰ ἐν τῷ ποῖόν τι κατηγορεῖται, τὸ δὲ εἶδος ἐν τῷ τί ἐστι.", "seq": 1942}
{"id": "Elias_Passim_1943", "series": "CAG", "text": "διὸ καὶ ἀποροῦσιν ὅτι καὶ πῶς εὑρίσκομεν τὸ εἶδος ἐν τῷ ποῖόν τί ἐστι κατηγορούμενον·", "seq": 1943}
{"id": "Elias_Passim_1944", "series": "CAG", "text": "ἐὰν γὰρ ἐρωτηθῶμεν τί ἐστι Σωκράτης, ζῷόν φαμεν, ποῖον δὲ ζῷον ἐρωτηθέντες φαμὲν ἄνθρωπος.", "seq": 1944}
{"id": "Elias_Passim_1945", "series": "CAG", "text": "πρὸς τοῦτό φαμεν ὅτι ὅσον ἐφ᾿ ἑαυτὸ τὸ εἶδος ἐν τῷ τί ἐστι κατηγορεῖται καὶ ἡ διαφορὰ ἐν τῷ ποῖόν τί ἐστιν, ἀλλὰ διὰ τὴν διαφορὰν προσελθοῦσαν τῷ γένει καὶ ποιήσασαν τὸ εἶδος ἐν τῷ ποῖόν τί ἐστι κατηγορεῖται τὸ εἶδος.", "seq": 1945}
{"id": "Elias_Passim_1946", "series": "CAG", "text": "διὸ πάλιν ἀποροῦσιν ὅτι διὰ τί μὴ τῇ διαφορᾷ ἐξηκολούθησε τὸ εἶδος τῇ εἰδοποιούσῃ καὶ ἐν τῷ ποῖόν τί ἐστι κατηγορεῖται, ἀλλὰ τῷ γένει καὶ ἐν τῷ τί ἐστι κατηγορεῖται.", "seq": 1946}
{"id": "Elias_Passim_1947", "series": "CAG", "text": "λύσις·", "seq": 1947}
{"id": "Elias_Passim_1948", "series": "CAG", "text": "ὅτι αἱ διαφοραὶ προσελθοῦσαι τῷ γένει οὐκ ἔμειναν διαφοραί, ἀλλ᾿ εἴδη ἐγένοντο.", "seq": 1948}
{"id": "Elias_Passim_1949", "series": "CAG", "text": "τοῦτο τὸ πρῶτον.", "seq": 1949}
{"id": "Elias_Passim_1950", "series": "CAG", "text": "δεύτερον ὅτι ἐπὶ πλεῖον ἡ διαφορὰ τοῦ εἴδους, κἂν μὴ ἀεὶ διὰ τὰς ἀντιστρεφούσας διαφοράς, οἷον τὸ νοῦ καὶ ἐπιστήμης δεκτικόν.", "seq": 1950}
{"id": "Elias_Passim_1951", "series": "CAG", "text": "διὸ καὶ τοῦτο πολλάκις προστέθηκεν ὁ Πορφύριος.", "seq": 1951}
{"id": "Elias_Passim_1952", "series": "CAG", "text": "τοῦτο καὶ τὸ δεύτερον.", "seq": 1952}
{"id": "Elias_Passim_1953", "series": "CAG", "text": "τρίτον αὐτῶν λέγει διάφορον ὅτι ἡ διαφορὰ φύσει προτέρα τοῦ κατ᾿ αὐτὴν εἴδους·", "seq": 1953}
{"id": "Elias_Passim_1954", "series": "CAG", "text": "τὸ γὰρ λογικὸν ἀναιρεθὲν συναναιρεῖ τὸν ἄνθρωπον, ὁ δὲ ἄνθρωπος ἀναιρεθεὶς οὐκ ἀναιρεῖ καὶ τὸ λογικὸν ὄντος θεοῦ, ἀγγέλου.", "seq": 1954}
{"id": "Elias_Passim_1955", "series": "CAG", "text": "ἀλλὰ καὶ συνεισφέρεται καὶ οὐ συνεισφέρει·", "seq": 1955}
{"id": "Elias_Passim_1956", "series": "CAG", "text": "ἄνθρωπον γὰρ ἐὰν εἴπω, συνεισήγαγον καὶ τὸ λογικόν, λογικὸν δὲ ἐὰν εἴπω, οὐ πάντως καὶ ἄνθρωπον συνεισήγαγον.", "seq": 1956}
{"id": "Elias_Passim_1957", "series": "CAG", "text": "τέταρτον διάφορον ὅτι διαφορὰ μὲν διαφορᾷ μίγνυται πρὸς εἴδους γένεσιν, οἷον τὸ λογικὸν καὶ τὸ θνητὸν πρὸς ἀνθρώπου γένεσιν, εἶδος δὲ εἴδει οὐ μίγνυται πρὸς ἄλλου εἴδους γένεσιν.", "seq": 1957}
{"id": "Elias_Passim_1958", "series": "CAG", "text": "καὶ ἀπορεῖ πρὸς τοῦτο ὁ Πορφύριος, ὅτι καὶ εἶδος εἴδει μίγνυται πρὸς ἄλλου εἴδους γένεσιν, οἷον ἵππος ὄνῳ πρὸς ἡμιόνου γένεσιν.", "seq": 1958}
{"id": "Elias_Passim_1959", "series": "CAG", "text": "καὶ λύσιν τούτου φασὶν τοιαύτην, ὅτι ἡ καθόλου μὲν διαφορὰ τῇ καθόλου διαφορᾷ μίγνυται πρὸς εἴδους γένεσιν, ὡς τὸ καθόλου λογικὸν καὶ τὸ καθόλου θνητὸν πρὸς ἀνθρώπου γένεσιν, καθόλου δὲ εἶδος τῷ καθόλου εἴδει οὐ μίγνυται πρὸς εἴδους γένεσιν·", "seq": 1959}
{"id": "Elias_Passim_1960", "series": "CAG", "text": "ὁ γὰρ τὶς ἵππος τῷ τινὶ ὄνῳ μίγνυται πρὸς ἡμιόνου γένεσιν.", "seq": 1960}
{"id": "Elias_Passim_1961", "series": "CAG", "text": "ἀλλ᾿ ἀποκληρωτικὸς ὁ λόγος·", "seq": 1961}
{"id": "Elias_Passim_1962", "series": "CAG", "text": "διὰ τί γὰρ ὡς ἡ καθόλου διαφορὰ τῇ καθόλου διαφορᾷ μίγνυται, μὴ καὶ τὸ καθόλου εἶδος τῷ καθόλου εἴδει ἐμίγη πρὸς εἴδους γένεσιν;", "seq": 1962}
{"id": "Elias_Passim_1963", "series": "CAG", "text": "εἰ γὰρ μὴ τὸ καθόλου εἶδος τῷ καθόλου εἴδει ἐμίγη, οἷον ὁ καθόλου ἵππος τῷ καθόλου ὄνῳ πρὸς τὴν καθόλου γένεσιν τοῦ ἡμιόνου, εὑρεθήσεται ὅλον τὸ εἶδος τὸ τῶν ἡμιόνων ἀναίτιον.", "seq": 1963}
{"id": "Elias_Passim_1964", "series": "CAG", "text": "λύσις τούτου ὅτι καὶ ἡ καθόλου διαφορὰ μίγνυται τῇ καθόλου διαφορᾷ, ἀλλ᾿ οἷον κατὰ παράθεσιν (διακεκριμένως γάρ ἐστι τὸ λογικὸν καὶ τὸ θνητὸν ἐν τῷ ἀνθρώπῳ), καὶ τὸ καθόλου εἶδος τῷ καθόλου εἴδει μίγνυται, κατὰ κρᾶσιν δέ·", "seq": 1964}
{"id": "Elias_Passim_1965", "series": "CAG", "text": "οὐδὲ γὰρ ἔχεις διακρῖναι τὸ ἵππειον εἶδος ἀπὸ τοῦ ὀνείου ἐν τῷ ἡμιόνῳ.", "seq": 1965}
{"id": "Elias_Passim_1966", "series": "CAG", "text": "καὶ ταῦτα μὲν περὶ τούτου.", "seq": 1966}
{"id": "Elias_Passim_1967", "series": "CAG", "text": "Ἐφ᾿ οἷς παραβάλλει διαφορὰν καὶ ἴδιον καὶ τὰ αὐτὰ λέγει κοινά, ἅπερ καὶ ἐπὶ εἴδους καὶ διαφορᾶς.", "seq": 1967}
{"id": "Elias_Passim_1968", "series": "CAG", "text": "πρῶτον μὲν τὸ ἐπίσης μετέχεσθαι ὑπὸ τῶν μετεχόντων (ἐπίσης γὰρ πάντες ἄνθρωποι λογικοὶ καὶ ἐπίσης γελαστικοί), δεύτερον τὸ ἀεὶ συνυπάρχειν·", "seq": 1968}
{"id": "Elias_Passim_1969", "series": "CAG", "text": "κἂν γὰρ κολοβωθῇ ὁ δίπους, ἀλλὰ πρὸς τὸ πεφυκέναι τὸ ἀεὶ λέγεται·", "seq": 1969}
{"id": "Elias_Passim_1970", "series": "CAG", "text": "καὶ τὸ γελαστικὸν γὰρ οὐχὶ τῷ γελᾶν ἀλλὰ τῷ πεφυκέναι ἔχει τὸ ἀεί.", "seq": 1970}
{"id": "Elias_Passim_1971", "series": "CAG", "text": "διαφορὰς δὲ λέγει δύο·", "seq": 1971}
{"id": "Elias_Passim_1972", "series": "CAG", "text": "πρῶτον μὲν ὅτι ἡ διαφορὰ ἐπὶ πλειόνων τινῶν λέγεται πολλάκις, οἷον τὸ λογικὸν ἐπὶ θεοῦ καὶ ἀγγέλου καὶ ἀνθρώπου, τὸ δὲ ἴδιον ἐφ᾿ ἑνὸς εἴδους, οὗ ἐστιν ἴδιον, οἷον τὸ γελαστικὸν ἐπὶ ἀνθρώπου μόνου.", "seq": 1972}
{"id": "Elias_Passim_1973", "series": "CAG", "text": "πρόσκειται δὲ τὸ πολλάκις διὰ τὸ νοῦ καὶ ἐπιστήμης δεκτικόν·", "seq": 1973}
{"id": "Elias_Passim_1974", "series": "CAG", "text": "αὕτη γὰρ ἡ διαφορὰ οὐκ ἐπὶ πλειόνων τινῶν λέγεται, ἀλλ᾿ ἐπὶ μόνου ἀνθρώπου.", "seq": 1974}
{"id": "Elias_Passim_1975", "series": "CAG", "text": "τοῦτο μὲν τὸ πρῶτον αὐτῶν διάφορον.", "seq": 1975}
{"id": "Elias_Passim_1976", "series": "CAG", "text": "δεύτερον δὲ ὅτι ἡ διαφορὰ ἕπεται ἐκείνοις, ὧν εἴη διαφορά, οὐ μὴν καὶ ἀντιστρέφει, τὰ δὲ ἴδια ἀντιστρέφει καὶ ἀντικατηγορεῖται ὧν ἔστιν ἴδια.", "seq": 1976}
{"id": "Elias_Passim_1977", "series": "CAG", "text": "ταῦτα καὶ περὶ διαφορᾶς καὶ ἰδίου.", "seq": 1977}
{"id": "Elias_Passim_1978", "series": "CAG", "text": "Ἐφ᾿ οἷς παραβάλλει τὴν διαφορὰν καὶ πρὸς τὸ συμβεβηκὸς καὶ λέγει δύο αὐτῶν κοινά·", "seq": 1978}
{"id": "Elias_Passim_1979", "series": "CAG", "text": "πρὸς μὲν τὸ πᾶν συμβεβηκὸς τὸ καθόλου κοινὸν αὐτῶν τὸ ἐπὶ πλειόνων λέγεσθαι, πρὸς δὲ τὸ ἀχώριστον συμβεβηκὸς τὸ ἀεὶ ὑπάρχειν·", "seq": 1979}
{"id": "Elias_Passim_1980", "series": "CAG", "text": "ἀεὶ γὰρ ὁ κόραξ μέλας καὶ ὁ Αἰθίοψ καὶ ἀεὶ ὁ ἄνθρωπος λογικός.", "seq": 1980}
{"id": "Elias_Passim_1981", "series": "CAG", "text": "ταῦτα μὲν αὐτῶν τὰ κοινά.", "seq": 1981}
{"id": "Elias_Passim_1982", "series": "CAG", "text": "διάφορα δὲ αὐτῶν λέγει τρία·", "seq": 1982}
{"id": "Elias_Passim_1983", "series": "CAG", "text": "πρῶτον ὅτι ἡ διαφορὰ περιέχει, οὐ περιέχεται δέ (τὸ γὰρ λογικὸν περιέχει τὸν ἄνθρωπον), τὰ δὲ συμβεβηκότα τρόπον μέν τινα περιέχουσι, κατὰ τὶ δὲ περιέχονται·", "seq": 1983}
{"id": "Elias_Passim_1984", "series": "CAG", "text": "καθὸ μὲν γὰρ πλείοσιν εἴδεσιν ὑπάρχει τὸ αὐτὸ συμβεβηκός, περιέχει, καθὸ δὲ ἓν εἶδος οὐ μόνον ἑνὸς συμβεβηκότος δύναται μετέχειν ἀλλὰ πλειόνων, οἷον λευκοῦ καὶ μέλανος, περιέχεσθαι δοκεῖ τότε τὸ συμβεβηκός.", "seq": 1984}
{"id": "Elias_Passim_1985", "series": "CAG", "text": "δεύτερον αὐτῶν διάφορον ὅτι τὸ μὲν συμβεβηκὸς ἐπιδέχεται τὸ μᾶλλον καὶ τὸ ἧττον, ἡ δὲ διαφορὰ οὐκέτι.", "seq": 1985}
{"id": "Elias_Passim_1986", "series": "CAG", "text": "τρίτον αὐτῶν λέγει διάφορον ὅτι αἱ ἐναντίαι διαφοραὶ οὐ μίγνυνταί ποτε, οἷον τὸ λογικὸν καὶ ἄλογον, τὰ δὲ ἐναντία συμβεβηκότα μίγνυνται πρὸς γένεσίν τινος, ὡς τὸ λευκὸν καὶ τὸ μέλαν πρὸς γένεσιν φαιοῦ.", "seq": 1986}
{"id": "Elias_Passim_1987", "series": "CAG", "text": "ταῦτα ἔχει ἡ πρᾶξις.", "seq": 1987}
{"id": "Elias_Passim_1988", "series": "CAG", "text": "<Πρᾶξις μ΄>.", "seq": 1988}
{"id": "Elias_Passim_1989", "series": "CAG", "text": "20.", "seq": 1989}
{"id": "Elias_Passim_1990", "series": "CAG", "text": "12 Εἴδους δὲ καὶ ἰδίου κοινὸν τὸ ἀλλήλων ἀντικατηγορεῖσθαι.", "seq": 1990}
{"id": "Elias_Passim_1991", "series": "CAG", "text": "Παραβαλὼν ὁ Πορφύριος τὸ γένος πρὸς τὰς λοιπὰς τέσσαρας φωνάς, τοῦτ᾿ ἔστι διαφοράν, εἶδος, ἴδιον καὶ συμβεβηκός, εἶτα τὴν διαφορὰν πρὸς τὰς τρεῖς, φημὶ εἶδος, ἴδιον, συμβεβηκός, ἔρχεται καὶ ἐπὶ τὰ λοιπὰ καὶ παραβάλλει τὸ μὲν εἶδος πρὸς ἴδιον καὶ συμβεβηκός, τὸ δὲ ἴδιον καὶ τὸ συμβεβηκὸς πρὸς ἄλληλα, καὶ οὕτως πληροῖ τὴν παροῦσαν ὑπόθεσιν.", "seq": 1991}
{"id": "Elias_Passim_1992", "series": "CAG", "text": "λέγει οὖν κοινὰ εἴδους καὶ ἰδίου δύο·", "seq": 1992}
{"id": "Elias_Passim_1993", "series": "CAG", "text": "πρῶτον μὲν ὅτι ἀντιστρέφουσιν (εἰ γὰρ ἄνθρωπος, γελαστικόν, καὶ εἰ γελαστικόν, ἄνθρωπος), δεύτερον τὸ ἐπίσης μετέχεσθαι·", "seq": 1993}
{"id": "Elias_Passim_1994", "series": "CAG", "text": "ἐπίσης γὰρ πάντες οἱ μετέχοντες τοῦ ἀνθρωπείου εἴδους μετέχουσι καὶ ἐπίσης τοῦ γελαστικοῦ.", "seq": 1994}
{"id": "Elias_Passim_1995", "series": "CAG", "text": "ἐφ᾿ οἷς λέγει αὐτῶν καὶ διάφορα τέσσαρα·", "seq": 1995}
{"id": "Elias_Passim_1996", "series": "CAG", "text": "πρῶτον ὅτι τὸ μὲν εἶδος δύναται ἄλλου γένος εἶναι ὡς ἐπὶ τῶν ὑπαλλήλων, τὸ δὲ ἴδιον ἄλλου ἴδιον οὐ δύναται εἶναι.", "seq": 1996}
{"id": "Elias_Passim_1997", "series": "CAG", "text": "δεύτερον ὅτι τὸ μὲν εἶδος πρότερον τοῦ ἰδίου, τὸ δὲ ἴδιον ἐπιγίνεται τῷ εἴδει·", "seq": 1997}
{"id": "Elias_Passim_1998", "series": "CAG", "text": "πρῶτον γὰρ ἄνθρωπος καὶ τότε γελαστικόν.", "seq": 1998}
{"id": "Elias_Passim_1999", "series": "CAG", "text": "τρίτον ὅτι τὸ εἶδος ἀεὶ ἐνεργείᾳ, τὸ δὲ ἴδιόν ποτε καὶ δυνάμει·", "seq": 1999}
{"id": "Elias_Passim_2000", "series": "CAG", "text": "ἀεὶ γὰρ ὁ Σωκράτης ἐνεργείᾳ ἄνθρωπος, γελᾷ δὲ οὐκ ἀεί, καίπερ ἀεὶ πεφυκὼς γελαστικὸς εἶναι.", "seq": 2000}
{"id": "Elias_Passim_2001", "series": "CAG", "text": "τέταρτον διάφορον εἴδους καὶ ἰδίου, ὅτι ὧν οἱ ὅροι διάφοροι, καὶ αὐτὰ τοιαῦτα·", "seq": 2001}
{"id": "Elias_Passim_2002", "series": "CAG", "text": "ἐπειδὴ οὖν διάφοροι οἱ ὅροι εἴδους καὶ ἰδίου, ἀνάγκη καὶ αὐτὰ διάφορα εἶναι.", "seq": 2002}
{"id": "Elias_Passim_2003", "series": "CAG", "text": "ταῦτα μὲν καὶ περὶ εἴδους καὶ ἰδίου.", "seq": 2003}
{"id": "Elias_Passim_2004", "series": "CAG", "text": "Ἐφ᾿ οἷς συγκρίνει εἶδος καὶ συμβεβηκὸς καὶ λέγει κοινὸν αὐτῶν ἓν τὸ ἐπὶ πολλῶν κατηγορεῖσθαι διὰ τὸ πλεῖστον ἀλλήλων διεστάναι τὸ συμβεβηκὸς καὶ τὸ ᾧ συμβέβηκε·", "seq": 2004}
{"id": "Elias_Passim_2005", "series": "CAG", "text": "τῶν γὰρ πλεῖστον ἀλλήλων διεστώτων παντὸς μὲν τὰς διαφορὰς εἰπεῖν, τὰς δὲ κοινωνίας μόνου ἐπιστήμονος, ὡς ἐπὶ μύρμηκος καὶ ἐλέφαντος·", "seq": 2005}
{"id": "Elias_Passim_2006", "series": "CAG", "text": "καθὸ μὲν γὰρ ζῷα, κοινωνοῦσι μόνον, κατὰ δὲ τὰ ἄλλα διαφέρουσι.", "seq": 2006}
{"id": "Elias_Passim_2007", "series": "CAG", "text": "καὶ ἀνάπαλιν τὰς διαφορὰς τῶν πολὺ κοινωνούντων ἐπιστήμονος μόνου εἰπεῖν, τὰς δὲ κοινωνίας παντός, ὡς ἐπὶ περιστερᾶς καὶ φάττης, ὡς ἐπὶ κυνὸς καὶ λύκου.", "seq": 2007}
{"id": "Elias_Passim_2008", "series": "CAG", "text": "διάφορα δὲ αὐτῶν λέγει τέσσαρα·", "seq": 2008}
{"id": "Elias_Passim_2009", "series": "CAG", "text": "πρῶτον μὲν ὅτι τὸ εἶδος ἐν τῷ τί ἐστι κατηγορεῖται, τὸ δὲ συμβεβηκὸς ἐν τῷ ποῖόν τι ἢ πῶς ἔχον.", "seq": 2009}
{"id": "Elias_Passim_2010", "series": "CAG", "text": "δεύτερον ὅτι ἑκάστη οὐσία ἑνὸς μὲν εἴδους μετέχει, συμβεβηκότων δὲ πολλῶν χωριστῶν τε καὶ ἀχωρίστων.", "seq": 2010}
{"id": "Elias_Passim_2011", "series": "CAG", "text": "τρίτον ὅτι φύσει πρότερα τὰ εἴδη τῶν συμβεβηκότων, κἂν ἀχώριστα ᾖ τὰ συμβεβηκότα.", "seq": 2011}
{"id": "Elias_Passim_2012", "series": "CAG", "text": "τέταρτον ὅτι τὸ μὲν εἶδος ἐπίσης μετέχεται, τὸ δὲ συμβεβηκὸς οὐκ ἐπίσης·", "seq": 2012}
{"id": "Elias_Passim_2013", "series": "CAG", "text": "ἐπιδέχεται γὰρ τὸ μᾶλλον καὶ ἧττον, κἂν ἀχώριστον ᾖ.", "seq": 2013}
{"id": "Elias_Passim_2014", "series": "CAG", "text": "καὶ ταῦτα μὲν περὶ τούτου.", "seq": 2014}
{"id": "Elias_Passim_2015", "series": "CAG", "text": "Ἐφ᾿ οἷς παραβάλλει ἴδιον καὶ ἀχώριστον συμβεβηκὸς καὶ λέγει κοινὰ αὐτῶν δύο·", "seq": 2015}
{"id": "Elias_Passim_2016", "series": "CAG", "text": "πρῶτον μὲν ὅτι ἄνευ τούτων οὐ δύναται ὑποστῆναι τὰ ἐν οἷς εἰσιν·", "seq": 2016}
{"id": "Elias_Passim_2017", "series": "CAG", "text": "οὐδὲ γὰρ ἄνευ γελαστικοῦ ἄνθρωπος οὐδὲ ἄνευ τοῦ μέλανος Αἰθίοψ.", "seq": 2017}
{"id": "Elias_Passim_2018", "series": "CAG", "text": "δεύτερον δὲ ὅτι ὥσπερ παντὶ καὶ ἀεὶ πάρεστι τὸ ἴδιον, οὕτως καὶ τὸ ἀχώριστον συμβεβηκός.", "seq": 2018}
{"id": "Elias_Passim_2019", "series": "CAG", "text": "ταῦτα μὲν τὰ κοινά.", "seq": 2019}
{"id": "Elias_Passim_2020", "series": "CAG", "text": "διάφορα δὲ αὐτῶν λέγει τρία·", "seq": 2020}
{"id": "Elias_Passim_2021", "series": "CAG", "text": "πρῶτον ὅτι τὸ μὲν ἴδιον ἑνὶ μόνῳ εἴδει ὑπάρχει, ὡς τὸ γελαστικὸν ἀνθρώπῳ, τὸ δὲ ἀχώριστον συμβεβηκὸς οἷον τὸ μέλαν οὐκ Αἰθίοπι μόνῳ ἀλλὰ καὶ ἄλλοις πολλοῖς.", "seq": 2021}
{"id": "Elias_Passim_2022", "series": "CAG", "text": "δεύτερον ὅτι τὸ ἴδιον ἀντιστρέφει καὶ ἀντικατηγορεῖται καὶ ἐπίσης ἐστὶν οὗ ἐστιν ἴδιον, τὸ δὲ ἀχώριστον συμβεβηκὸς", "seq": 2022}
{"id": "Elias_Passim_2023", "series": "CAG", "text": "ΕΞΗΓΗΣΙΣ ΣΥΝ ΘΕΩΙ ΤΩΝ ΔΕΚΑ ΚΑΤΗΓΟΡΙΩΝ ΤΗΣ ΦΙΛΟΣΟΦΙΑΣ ΑΠΟ ΦΩΝΗΣ ΔΑΒΙΔ ΤΟΥ ΘΕΟΦΙΛΕΣΤΑΤΟΥ ΦΙΛΟΣΟΦΟΥ.", "seq": 2023}
{"id": "Elias_Passim_2024", "series": "CAG", "text": "Τῶν Ἀριστοτελικῶν ἀρχόμενοι λόγων εὐθὺς ἐκ θυρῶν φίλα τῷ Ἀριστοτέλει διαπραξώμεθα καὶ τὴν φίλην αὐτῷ συντομίαν συνόψει συντομωτάτῃ περιβάλωμεν·", "seq": 2024}
{"id": "Elias_Passim_2025", "series": "CAG", "text": "σύνοψις γὰρ καὶ συντομία φίλαι τῷ Ἀριστοτέλει, Πυθαγορείῳ κατ᾿ ἀλήθειαν γεγονότι καὶ τὴν Πυθαγόρου σιωπὴν εἰς τὴν γείτονα βραχυλογίαν μεταγαγόντι.", "seq": 2025}
{"id": "Elias_Passim_2026", "series": "CAG", "text": "δέκα δέ τισι κεφαλαίοις περικλείομεν τὴν αὐτοῦ φιλοσοφίαν.", "seq": 2026}
{"id": "Elias_Passim_2027", "series": "CAG", "text": "καὶ πρῶτόν ἐστι τῶν δέκα διὰ τί οὕτως ὠνομάσθη ἡ Ἀριστοτέλους φιλοσοφία, Περιπατητική.", "seq": 2027}
{"id": "Elias_Passim_2028", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ τοῦτο μερικὸν καὶ ἀφιλόσοφον (φιλοκαθόλου γὰρ ὁ φιλόσοφος), τὰ καθόλου ζητείσθω διὰ τίνας καὶ πόσας αἰτίας ὠνομάσθησαν αἱ κατὰ φιλοσοφίαν αἱρέσεις.", "seq": 2028}
{"id": "Elias_Passim_2029", "series": "CAG", "text": "δεύτερον τίς ἡ διαίρεσις τῶν Ἀριστοτελικῶν συγγραμμάτων πολλῶν ὄντων, χιλίων τὸν ἀριθμόν, ὥς φησι Πτολεμαῖος ὁ Φιλάδελφος ἀναγραφὴν αὐτῶν ποιησάμενος καὶ τὸν βίον αὐτοῦ καὶ τὴν διάθεσιν.", "seq": 2029}
{"id": "Elias_Passim_2030", "series": "CAG", "text": "τρίτον πόθεν δεῖ ἄρχεσθαι τῶν Ἀριστοτελικῶν συγγραμμάτων.", "seq": 2030}
{"id": "Elias_Passim_2031", "series": "CAG", "text": "τέταρτον τί τὸ τέλος αὐτῶν.", "seq": 2031}
{"id": "Elias_Passim_2032", "series": "CAG", "text": "καὶ ἐπειδὴ ὅπου ἀρχὴ καὶ τέλος, ἔστι τι καὶ μεταξύ, πέμπτον ζητείσθω τίς ἡ μεταξὺ ὁδός.", "seq": 2032}
{"id": "Elias_Passim_2033", "series": "CAG", "text": "ἕκτον ποῖον δεῖ εἶναι τὸν ἀκροατὴν κατὰ ζωὴν καὶ γνῶσιν.", "seq": 2033}
{"id": "Elias_Passim_2034", "series": "CAG", "text": "ἕβδομον ποῖον δεῖ εἶναι τὸν ἐξηγητήν·", "seq": 2034}
{"id": "Elias_Passim_2035", "series": "CAG", "text": "μηδὲ γὰρ οὗτος ἐκφευγέτω τὴν βάσανον διὰ τὸ ἀξίωμα τοῦ ἐξηγητοῦ, ἀλλ᾿ εὐθύνας διδότω ὁποῖός ἐστιν.", "seq": 2035}
{"id": "Elias_Passim_2036", "series": "CAG", "text": "ὄγδοον τί τὸ εἶδος τῆς φράσεως αὐτοῦ.", "seq": 2036}
{"id": "Elias_Passim_2037", "series": "CAG", "text": "ἔνατον διὰ τί ἀσάφειαν ἐπετήδευσεν·", "seq": 2037}
{"id": "Elias_Passim_2038", "series": "CAG", "text": "οὐδὲ γὰρ ἦν φύσει τοιοῦτος, ὡς δηλοῦσιν αἱ Ἐπιστολαὶ αὐτοῦ σαφεῖς οὖσαι καὶ οἱ Τόποι καὶ τὰ Μετέωρα πάνυ σαφῆ ὄντα.", "seq": 2038}
{"id": "Elias_Passim_2039", "series": "CAG", "text": "δέκατον κεφάλαιον πόσα καὶ τίνα δεῖ προλαμβάνειν παντὸς Ἀριστοτελικοῦ βιβλίου.", "seq": 2039}
{"id": "Elias_Passim_2040", "series": "CAG", "text": "Ταῦτα πάντα τοῦ Πρόκλου λέγοντος δεῖν προλαμβάνειν ἀρχομένους τῶν Ἀριστοτελικῶν συνταγμάτων ἐν τῇ συναναγνώσει (σύνταγμα δὲ τούτου Πρόκλειον), καὶ τὴν αἰτίαν μὴ προστιθέντος, φέρε ἡμεῖς ἐκ διαιρέσεώς τινος προσθῶμεν καὶ τὴν αἰτίαν.", "seq": 2040}
{"id": "Elias_Passim_2041", "series": "CAG", "text": "ἡ δὲ διαίρεσις πρόεισιν οὕτως περιέχουσα·", "seq": 2041}
{"id": "Elias_Passim_2042", "series": "CAG", "text": "ἡ Ἀριστοτέλους φιλοσοφία καὶ ὀνομάζεται καὶ ὑφέστηκε.", "seq": 2042}
{"id": "Elias_Passim_2043", "series": "CAG", "text": "καὶ ἐπειδὴ ὀνομάζεται, ζητοῦμεν πρῶτον διὰ τί οὕτως ὠνομάσθησαν αἱ κατὰ φιλοσοφίαν αἱρέσεις καὶ διὰ τί Περιπατητικὴ ἡ τοῦ Ἀριστοτέλους ἐκλήθη φιλοσοφία.", "seq": 2043}
{"id": "Elias_Passim_2044", "series": "CAG", "text": "ἐπειδὴ δὲ ὑφέστηκεν, ἢ καθ᾿ ἑαυτὴν ὑφέστηκε νόμῳ τέχνης καὶ ἐπιστήμης ἢ πρὸς ἡμᾶς ὡς διδακτή.", "seq": 2044}
{"id": "Elias_Passim_2045", "series": "CAG", "text": "ἐπειδὴ οὖν καθ᾿ ἑαυτὴν ὑφέστηκεν, ἢ ἀπὸ τῶν τελείων ἐπὶ τὰ ἀτελῆ καὶ μερικώτερα χωρεῖ ἢ ἀπὸ τῶν ἀτελῶν ἐπὶ τὰ τέλεια, καὶ ζητοῦμεν τίς ἡ ἀρχή, τί τὸ τέλος, τίς ἡ μεταξὺ ὁδός.", "seq": 2045}
{"id": "Elias_Passim_2046", "series": "CAG", "text": "καὶ οὕτως μὲν εἰ καθ᾿ ἑαυτήν.", "seq": 2046}
{"id": "Elias_Passim_2047", "series": "CAG", "text": "εἰ δὲ πρὸς ἡμᾶς, ζητοῦμεν τίς ὁ ἀκροατὴς καὶ τίς ὁ ἐξηγητής.", "seq": 2047}
{"id": "Elias_Passim_2048", "series": "CAG", "text": "ἐπειδὴ δὲ διαιρέσεως συνταγμάτων ἐμνήσθημεν, ἐν δὲ τοῖς συντάγμασίν ἐστι καὶ λέξις καὶ διάνοια, διὰ μὲν τὴν λέξιν ζητοῦμεν τί τὸ εἶδος τῆς φράσεως καὶ διὰ τί τὴν ἀσάφειαν ἐπετήδευσε, διὰ δὲ τὴν διάνοιαν πόσα καὶ ποῖα δεῖ προλαμβάνειν κεφάλαια τῶν Ἀριστοτέλους συνταγμάτων.", "seq": 2048}
{"id": "Elias_Passim_2049", "series": "CAG", "text": "ταῦτα ἔχει ἡ παροῦσα θεωρία.", "seq": 2049}
{"id": "Elias_Passim_2050", "series": "CAG", "text": "Πρῶτον κεφάλαιον ἦν τῶν περικλειόντων τὴν Ἀριστοτέλους φιλοσοφίαν τὸ ζητῆσαι κατὰ πόσους καὶ τίνας τρόπους ὠνομάσθησαν αἱ κατὰ φιλοσοφίαν αἱρέσεις.", "seq": 2050}
{"id": "Elias_Passim_2051", "series": "CAG", "text": "καὶ δεῖ εἰδέναι ὅτι κατὰ ἑπτὰ τρόπους·", "seq": 2051}
{"id": "Elias_Passim_2052", "series": "CAG", "text": "ἢ γὰρ ἀπὸ τοῦ αἱρεσιάρχου, ὡς Πλατωνικοὶ καὶ Ἀριστοτελικοί, ἢ ἀπὸ τῆς πατρίδος τοῦ αἱρεσιάρχου, ὡς Κυρηναϊκοὶ δι᾿ Ἀρίστιππον τὸν Κυρηναῖον.", "seq": 2052}
{"id": "Elias_Passim_2053", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ οὐκ ἀκριβῶς δυνάμεθα παρακολουθεῖν τοῖς λεγομένοις, εἰ μὴ πρῶτον γνῶμεν τί ἐστιν αἵρεσις, φέρε πρότερον περὶ αὐτῆς εἴπωμεν.", "seq": 2053}
{"id": "Elias_Passim_2054", "series": "CAG", "text": "αἵρεσίς ἐστι ἀνδρῶν ἀστείων δόξα πρὸς μὲν ἑαυτοὺς συμφωνούντων πρὸς δὲ ἄλλους διαφωνούντων.", "seq": 2054}
{"id": "Elias_Passim_2055", "series": "CAG", "text": "καὶ καλῶς εἶπεν ‘ἀνδρῶν’ καὶ οὐκ ἀνδρός·", "seq": 2055}
{"id": "Elias_Passim_2056", "series": "CAG", "text": "ἑνὸς γὰρ ἀνδρὸς δόξα αἵρεσιν οὐ ποιεῖ·", "seq": 2056}
{"id": "Elias_Passim_2057", "series": "CAG", "text": "θέσις γὰρ τότε γίνεται, ὡς ἡ Ἡρακλείτου ὅτι πάντα κινεῖται, ἡ Παρμενίδου ὅτι ἓν τὸ ὂν καὶ ἀκίνητον, ἡ Ἀντισθένους ὅτι οὐκ ἔστιν ἀντιλέγειν·", "seq": 2057}
{"id": "Elias_Passim_2058", "series": "CAG", "text": "θέσις γάρ ἐστι παράδοξος ὑπόληψις ἑνὸς τῶν κατὰ φιλοσοφίαν γνωρίμων.", "seq": 2058}
{"id": "Elias_Passim_2059", "series": "CAG", "text": "τὸ δὲ ‘ἀστείων’ καὶ αὐτὸ καλῶς πρόσκειται, ἵν᾿ ὦσιν ἀξιόλογοι καὶ ἐπιστήμονες·", "seq": 2059}
{"id": "Elias_Passim_2060", "series": "CAG", "text": "ἐὰν γὰρ ὦσιν εἰκαιολόγοι καὶ ἀγελαῖοι, οὐ ποιοῦσιν οὐδὲ τέχνην οὐδὲ ἐπιστήμην.", "seq": 2060}
{"id": "Elias_Passim_2061", "series": "CAG", "text": "‘πρὸς ἑαυτοὺς συμφωνούντων καὶ πρὸς ἄλλους διαφωνούντων’·", "seq": 2061}
{"id": "Elias_Passim_2062", "series": "CAG", "text": "ἐὰν γὰρ καὶ πρὸς ἑαυτοὺς καὶ πρὸς ἄλλους συμφωνῶσιν, οὐ ποιοῦσιν αἵρεσιν ἀλλὰ τὸ ἀντικείμενον τῇ αἱρέσει, τοῦτ᾿ ἔστι κοινὴν ἔννοιαν·", "seq": 2062}
{"id": "Elias_Passim_2063", "series": "CAG", "text": "χαρακτηρίζει γὰρ τὴν αἵρεσιν συμφωνία μετὰ διαφωνίας, καὶ οὐκ ἐν τοῖς τυχοῦσιν ἀνθρώποις ἀλλ᾿ ἐν ἀστείοις καὶ ἀξιολόγοις.", "seq": 2063}
{"id": "Elias_Passim_2064", "series": "CAG", "text": "καὶ ταῦτα μὲν περὶ τῆς αἱρέσεως.", "seq": 2064}
{"id": "Elias_Passim_2065", "series": "CAG", "text": "δεῖ δὲ εἰδέναι ὅτι κατὰ ἑπτὰ τρόπους ὀνομάζονται αἱ κατὰ φιλοσοφίαν αἱρέσεις·", "seq": 2065}
{"id": "Elias_Passim_2066", "series": "CAG", "text": "ἢ γὰρ ἀπὸ τοῦ αἱρεσιάρχου, ὡς Πλατωνικοὶ καὶ Ἀριστοτελικοί, ἢ ἀπὸ τῆς πατρίδος τοῦ αἱρεσιάρχου, ὡς Κυρηναϊκοὶ δι᾿ Ἀρίστιππον ἢ Ἐρετριεῖς διὰ Μενέδημον τὸν Ἐρετριέα ἢ Μεγαρικοὶ διὰ Τερψίωνα καὶ Εὐκλείδην τοὺς Μεγαρεῖς, ὅθεν καὶ Μεγαρικὴ φιλοσοφία, ἢ Ἠλιακοὶ διὰ Φαίδωνα τὸν ἀπὸ τῆς Ἤλιδος.", "seq": 2066}
{"id": "Elias_Passim_2067", "series": "CAG", "text": "καὶ οὕτω μὲν ἀπὸ τῆς τοῦ αἱρεσιάρχου πατρίδος.", "seq": 2067}
{"id": "Elias_Passim_2068", "series": "CAG", "text": "Ἢ ἀπὸ τοῦ τόπου, ἐν ᾧ τὰς διατριβὰς ἐποιοῦντο, ὡς οἱ Στωϊκοὶ διὰ τὴν ἐν τῇ Ἀττικῇ ποικίλην στοάν, ἐν ᾗ ἐπαίδευε Ζήνων ὁ Κιττιεύς, οὐχ ὁ Ἐλεάτης ὁ καὶ Παρμενίδειος ὁ ἀμφοτερόγλωσσος, περὶ οὗ εἴρηται", "seq": 2068}
{"id": "Elias_Passim_2069", "series": "CAG", "text": "ἀμφοτερογλώττοιο μέγα σθένος οὐκ ἀλαπαδνὸν Ζήνωνος.", "seq": 2069}
{"id": "Elias_Passim_2070", "series": "CAG", "text": "ἀμφοτερόγλωσσος δ᾿ ἐκλήθη οὐχ ὅτι διαλεκτικὸς ἦν, ὡς ὁ Κιττιεύς, καὶ τὰ αὐτὰ ἀνεσκεύαζε καὶ κατεσκεύαζεν, ἀλλ᾿ ὅτι τῇ ζωῇ διαλεκτικὸς ἦν ἄλλα μὲν λέγων ἄλλα δὲ φρονῶν·", "seq": 2070}
{"id": "Elias_Passim_2071", "series": "CAG", "text": "ἐρωτηθεὶς γὰρ οὗτός ποτε ὑπό του τυράννου τίνες εἰσὶν οἱ μάλιστα ἐπιβουλεύοντες τῇ τυραννίδι αὐτοῦ, τοὺς δορυφόρους ἔδειξεν·", "seq": 2071}
{"id": "Elias_Passim_2072", "series": "CAG", "text": "ὁ δὲ πεισθεὶς καὶ ἀνελὼν αὐτοὺς διεφθάρη·", "seq": 2072}
{"id": "Elias_Passim_2073", "series": "CAG", "text": "ἀγαθὸν γὰρ ἐνόμισε τὸ ψεύσασθαι διὰ τὴν τοῦ τυράννου ἀναίρεσιν.", "seq": 2073}
{"id": "Elias_Passim_2074", "series": "CAG", "text": "καὶ τῷ οἰκείῳ διδασκάλῳ ποτὲ Παρμενίδῃ ἓν λέγοντι τὸ ὂν καὶ τὸ εἶδος, ἐκ τῆς ἐνεργείας πολλὰ τὰ ὄντα, συντίθησιν ἐκ τεσσαράκοντα ἐπιχειρημάτων ὅτι ἓν τὸ ὄν, ἀγαθὸν νομίσας τῷ οἰκείῳ συμμαχεῖν διδασκάλῳ.", "seq": 2074}
{"id": "Elias_Passim_2075", "series": "CAG", "text": "καί ποτε πάλιν τῷ αὐτῷ συνηγορῶν διδασκάλῳ ἀκίνητον λέγοντι τὸ ὄν, διὰ πέντε ἐπιχειρημάτων κατασκευάζει ὅτι ἀκίνητον τὸ ὄν·", "seq": 2075}
{"id": "Elias_Passim_2076", "series": "CAG", "text": "οἷς ἀντειπεῖν μὴ δυνηθεὶς Ἀντισθένης ὁ Κυνικὸς ἀναστὰς ἐβάδισε, νομίσας ἰσχυροτέραν εἶναι πάσης τῆς διὰ λόγων ἀντιλογίας τὴν διὰ τῆς ἐνεργείας ἀπόδειξιν.", "seq": 2076}
{"id": "Elias_Passim_2077", "series": "CAG", "text": "οὕτω μὲν καὶ ἀπὸ τοῦ τόπου τῆς συνουσίας.", "seq": 2077}
{"id": "Elias_Passim_2078", "series": "CAG", "text": "Ἢ ἀπὸ τῆς ἐν τοῖς φιλοσόφοις ἐπικρίσεως, ὡς οἱ Ἐφεκτικοί·", "seq": 2078}
{"id": "Elias_Passim_2079", "series": "CAG", "text": "οὗτοι γὰρ ἀκαταληψίαν δοξάζοντες ἐπεῖχον τὰς λύσεις τῶν προτάσεων.", "seq": 2079}
{"id": "Elias_Passim_2080", "series": "CAG", "text": "ἐκλήθη δὲ καὶ τρίπους ἡ αἵρεσις αὐτῶν, ἐπειδὴ τριπλᾶς ἐποιοῦντο τὰς ἀποκρίσεις·", "seq": 2080}
{"id": "Elias_Passim_2081", "series": "CAG", "text": "ἐρωτώμενοι γὰρ ὅ τι ἡ ψυχή, θνητὴ ἢ ἀθάνατος, ἔλεγον ὅτι ἢ θνητὴ ἢ ἀθάνατος ἢ ἀμφότερα ἢ οὐδέτερον.", "seq": 2081}
{"id": "Elias_Passim_2082", "series": "CAG", "text": "ἐκλήθη δὲ καὶ ἀπορηματικὴ διὰ τὸ ἀπορεῖν μόνον καὶ μὴ ἐπιλύεσθαι.", "seq": 2082}
{"id": "Elias_Passim_2083", "series": "CAG", "text": "οὗτοι δὲ ἀντίκεινται τοῖς Πρωταγορείοις·", "seq": 2083}
{"id": "Elias_Passim_2084", "series": "CAG", "text": "οἱ γὰρ Πρωταγόρειοι τἀληθὲς ἐπρέσβευον, λέγοντες ὅτι τὸ δοκοῦν ἑκάστῳ ἀληθές ἐστιν.", "seq": 2084}
{"id": "Elias_Passim_2085", "series": "CAG", "text": "ἐλέγχει δὲ ὁ Πλάτων ἰδίᾳ ἑκατέρους, τοὺς μὲν Ἐφεκτικοὺς ἐν τῷ Θεαιτήτῳ λέγων πρὸς αὐτοὺς οὕτως·", "seq": 2085}
{"id": "Elias_Passim_2086", "series": "CAG", "text": "ὅτι ‘κατειληφότες λέγετε μὴ εἶναι κατάληψιν ἢ μὴ κατειληφότες;", "seq": 2086}
{"id": "Elias_Passim_2087", "series": "CAG", "text": "καὶ εἰ μὲν κατειληφότες, ἰδοὺ ἔστι κατάληψις·", "seq": 2087}
{"id": "Elias_Passim_2088", "series": "CAG", "text": "εἰ δὲ μὴ κατειληφότες, οὐ πειθόμεθα ὑμῖν μὴ κατειληφόσιν ὅτι ἔστιν ἀκαταληψία’.", "seq": 2088}
{"id": "Elias_Passim_2089", "series": "CAG", "text": "τοὺς δὲ Πρωταγορείους ἐλέγχει ἐν τῷ Πρωταγόρᾳ διαλόγῳ λέγων οὕτως·", "seq": 2089}
{"id": "Elias_Passim_2090", "series": "CAG", "text": "ὅτι ‘ἡμεῖς, ὦ Πρωταγόρα, λέγοντές σε δοξάζειν κακῶς ἀληθεύομεν ἢ ψευδόμεθα;", "seq": 2090}
{"id": "Elias_Passim_2091", "series": "CAG", "text": "εἰ μὲν γὰρ ἀληθεύομεν, σὺ ψεύδῃ, καὶ ἰδοὺ ἔστι τὸ ψεῦδος·", "seq": 2091}
{"id": "Elias_Passim_2092", "series": "CAG", "text": "εἰ δὲ ψευδόμεθα σοῦ ἀληθεύοντος, ἰδοὺ πάλιν ἔστι τὸ ψεῦδος.", "seq": 2092}
{"id": "Elias_Passim_2093", "series": "CAG", "text": "ψεύδῃ οὖν, κἄν τε ἀληθεύῃς κἄν τε ψεύδῃ’.", "seq": 2093}
{"id": "Elias_Passim_2094", "series": "CAG", "text": "καὶ ἐπάγει λέγων ὅτι Πρωταγόρας ψεύδεται, κἄν τε ἀληθεύῃ κἄν τε ψεύδηται.", "seq": 2094}
{"id": "Elias_Passim_2095", "series": "CAG", "text": "ὁ δὲ Ἀριστοτέλης δι᾿ ἑνὸς καὶ τοῦ αὐτοῦ ἐπιχειρήματος ἐλέγχει διὰ τὸ ἀξίωμα τῆς ἀντιφάσεως·", "seq": 2095}
{"id": "Elias_Passim_2096", "series": "CAG", "text": "εἰ γὰρ οἱ μὲν πάντῃ ψευδῆ δοξάζουσιν οἱ δὲ πάντῃ ἀληθῆ, ἀντίφασις τὸ τοιοῦτον, οὐδέποτε δὲ ἡ ἀντίφασις συναληθεύει·", "seq": 2096}
{"id": "Elias_Passim_2097", "series": "CAG", "text": "οὐδὲ γὰρ πάντως ἀληθῆ οὐδὲ πάντως ψευδῆ.", "seq": 2097}
{"id": "Elias_Passim_2098", "series": "CAG", "text": "ταύτης δὲ τῆς αἱρέσεως ἐνόμισάν τινες καὶ τὸν Πλάτωνα εἶναι διὰ τὸ κεχρῆσθαι διστακτικοῖς προσρήμασι, λέγοντα ‘δοκῶ μοι’ καὶ ‘ἴσως’ καὶ ‘τάχα’ καὶ ‘ὑπολαμβάνω’.", "seq": 2098}
{"id": "Elias_Passim_2099", "series": "CAG", "text": "ἀλλὰ ταῦτα μὲν ὁ Πλάτων δι᾿ ἀκρίβειαν ἔλεγεν, οὔτε δὲ ὁ ἀκριβὴς πάντως ἐφεκτικὸς οὔτε ὁ ἐφεκτικὸς ἀκριβής.", "seq": 2099}
{"id": "Elias_Passim_2100", "series": "CAG", "text": "πλὴν οὐκ ἐφεκτικὸς ὁ Πλάτων·", "seq": 2100}
{"id": "Elias_Passim_2101", "series": "CAG", "text": "ἔστι γὰρ πολλαχοῦ ἀκοῦσαι αὐτοῦ λέγοντος καὶ ἀποφαινομένου, ὅπῃ ἔλεγεν ὡς κατὰ τὸν ποιητήν, ἐν μὲν τῷ Φαίδρῳ ὅτι ἡ ψυχὴ πᾶσα ἀθάνατος καὶ ἐν τῷ Φαίδωνι ὅτι ἀδαμαντίνοις δεῖ δεσμοῖς τὴν δόξαν ταύτην ἔχοντα περὶ τῆς ἀθανασίας τῆς ψυχῆς εἰς Ἅιδου ἰέναι, κἀν τοῖς Νόμοις ὅτι ἀληθέστερα τὰ νῦν λεγόμενα τοῦ τὴν Κρήτην νῆσον εἶναι (ἐν Κρήτῃ γὰρ τὰς διατριβὰς ἐποιεῖτο·", "seq": 2101}
{"id": "Elias_Passim_2102", "series": "CAG", "text": "οὐ γὰρ ἠξίου ἔτι σκηνὰς τῶν αὑτοῦ διαλόγων ποιεῖσθαι τὰς Ἀθήνας διὰ τὰ συμβάντα ἐπὶ Σωκράτει), καὶ ἐν τῇ Πολιτείᾳ φησὶν ὅτι μισθωσώμεθα κήρυκα Στέντορος μεγαλοφωνότερον, ὅστις ἀναβὰς ἐφ᾿ ὑψηλοῦ βήματος ἀναβοήσει ὡς ὁ μὲν δίκαιος εὐδαίμων, καὶ εἰ λάθῃ πάντας ἀνθρώπους τοιοῦτος ὢν καὶ διὰ τοῦτο ἄδικος νομιζόμενος μαστιγοῖτο, ὁ δὲ ἄδικος ἄθλιος, καὶ εἰ λάθῃ πάντας ἀνθρώπους τοιοῦτος ὢν καὶ διὰ τοῦτο δίκαιος νομιζόμενος τιμῷτο ὑπὸ πάντων.", "seq": 2102}
{"id": "Elias_Passim_2103", "series": "CAG", "text": "ἐπεξέτεινα δ᾿ ἂν τὰς χρήσεις τοῦ Πλάτωνος κατασκευαζούσας ὅτι οὐκ ἦν ἐφεκτικός, εἰ μὴ ὅτι πρόλογος νῦν Ἀριστοτελικῶν πρόκειται, οὐχὶ δὲ Πλατωνικῶν.", "seq": 2103}
{"id": "Elias_Passim_2104", "series": "CAG", "text": "Πέμπτος τρόπος ἦν τῆς ἐπωνυμίας τῶν κατὰ φιλοσοφίαν αἱρέσεων ἀπὸ τοῦ τρόπου τῆς ζωῆς, ὥσπερ οἱ Κυνικοὶ φιλόσοφοι.", "seq": 2104}
{"id": "Elias_Passim_2105", "series": "CAG", "text": "Κυνικοὶ δὲ ἐκλήθησαν διὰ τέσσαρας αἰτίας·", "seq": 2105}
{"id": "Elias_Passim_2106", "series": "CAG", "text": "ἢ γὰρ διὰ τὸ ἀδιάφορον τοῦ ζῴου, ἐπειδὴ καὶ αὐτοὶ ἀδιαφορίᾳ ἐπετήδευον ὡς οἱ κύνες δημοσίᾳ ἐσθίειν καὶ ἀφροδισιάζεσθαι καὶ ἀνυπόδετοι περιπατεῖν καὶ ἐν πίθοις καὶ ἐν τριόδοις καθεύδειν.", "seq": 2106}
{"id": "Elias_Passim_2107", "series": "CAG", "text": "τοῦτο δὲ ἐποίουν τοῦ φύσει καλοῦ ὀρεγόμενοι·", "seq": 2107}
{"id": "Elias_Passim_2108", "series": "CAG", "text": "ἔλεγον γὰρ ὅτι εἰ ἀγαθόν ἐστι, δεῖ κοινῇ καὶ ἰδίᾳ πράττεσθαι, εἰ δὲ οὐκ ἔστιν ἀγαθόν, οὔτε κοινῇ οὔτε ἰδίᾳ αὐτὸ διαπρακτέον·", "seq": 2108}
{"id": "Elias_Passim_2109", "series": "CAG", "text": "οὐ γὰρ ἦν παρ᾿ αὐτοῖς", "seq": 2109}
{"id": "Elias_Passim_2110", "series": "CAG", "text": "ἀλλὰ τὸ μὲν φάσθαι τὸ δὲ ἐγκεκρυμμένον εἶναι,", "seq": 2110}
{"id": "Elias_Passim_2111", "series": "CAG", "text": "ἀλλ᾿ ἦν παρ᾿ αὐτοῖς τὸ", "seq": 2111}
{"id": "Elias_Passim_2112", "series": "CAG", "text": "εἰπὲ καὶ ἀμφαδίην, ἐπεὶ οὔτινα δείδια ἔμπης.", "seq": 2112}
{"id": "Elias_Passim_2113", "series": "CAG", "text": "αὕτη πρώτη αἰτία.", "seq": 2113}
{"id": "Elias_Passim_2114", "series": "CAG", "text": "δευτέρα αἰτία, ὅτι ἀναιδὲς ζῷον ὁ κύων, ἐπετήδευον δὲ καὶ αὐτοὶ τὴν ἀναίδειαν, οὐ τὴν χείρονα τῆς αἰδοῦς ἀλλὰ τὴν κρείττονα·", "seq": 2114}
{"id": "Elias_Passim_2115", "series": "CAG", "text": "διττὴ γὰρ ἡ ἀναίδεια, ἡ μὲν χείρων τῆς αἰδοῦς ἡ δὲ κρείττων,", "seq": 2115}
{"id": "Elias_Passim_2116", "series": "CAG", "text": "ἥ τ᾿ ἄνδρας μέγα σίνεται ἡ δ᾿ ὀνίνησι.", "seq": 2116}
{"id": "Elias_Passim_2117", "series": "CAG", "text": "ταύτην οὖν τὴν ἀναίδειαν ἐπετήδευον τὴν κρείττονα αἰδοῦς, οἷον ὑλακτοῦντες κατὰ τῶν ἀλλοτρίων τῆς αὑτῶν φιλοσοφίας.", "seq": 2117}
{"id": "Elias_Passim_2118", "series": "CAG", "text": "τρίτη αἰτία, ὅτι φρουρητικὸν ζῷον ὁ κύων·", "seq": 2118}
{"id": "Elias_Passim_2119", "series": "CAG", "text": "ἐφρούρουν δὲ καὶ αὐτοὶ τὰ δόγματα τῆς φιλοσοφίας διὰ τῶν ἀποδείξεων καὶ μέγα ἐφρόνουν ἐπὶ τούτῳ·", "seq": 2119}
{"id": "Elias_Passim_2120", "series": "CAG", "text": "φαίη γὰρ ἂν ἡ τύχη πρὸς Ἀντισθένην τὸν προστάτην τῆς αἱρέσεως ταύτης οὕτως", "seq": 2120}
{"id": "Elias_Passim_2121", "series": "CAG", "text": "ἐννέα δὴ προέηκα τανυγλώχινας ὀϊστούς, τοῦτον δ᾿ οὐ δύναμαι βαλέειν κύνα λυσσητῆρα,", "seq": 2121}
{"id": "Elias_Passim_2122", "series": "CAG", "text": "ὅτι, φησί, τοσαύτας αὐτῷ συμφορὰς ἐπήγαγον, καὶ οὐκ ἠδυνήθην αὐτοῦ καταβαλεῖν τὸ φρόνημα.", "seq": 2122}
{"id": "Elias_Passim_2123", "series": "CAG", "text": "αὕτη καὶ ἡ τρίτη αἰτία.", "seq": 2123}
{"id": "Elias_Passim_2124", "series": "CAG", "text": "τετάρτη δὲ ὅτι διακριτικὸν ζῷον ὁ κύων γνώσει καὶ ἀγνοίᾳ τὸ φίλον καὶ τὸ ἀλλότριον ὁρίζον·", "seq": 2124}
{"id": "Elias_Passim_2125", "series": "CAG", "text": "ὃν γὰρ γινώσκει, νομίζει φίλον εἶναι, καὶ εἰ ῥόπαλον ἐπιφέροιτο, ὃν δ᾿ ἀγνοεῖ, ἐχθρόν, καὶ εἰ δέλεαρ ἐπιφερόμενος εἴη·", "seq": 2125}
{"id": "Elias_Passim_2126", "series": "CAG", "text": "οὕτως οὖν καὶ οὗτοι τοὺς μὲν ἐπιτηδείους πρὸς φιλοσοφίαν φίλους ἐνόμιζον καὶ εὐμενῶς ἐδέχοντο, τοὺς δὲ ἀνεπιτηδείους ἀπήλαυνον δίκην κυνῶν κατ᾿ αὐτῶν ὑλακτοῦντες.", "seq": 2126}
{"id": "Elias_Passim_2127", "series": "CAG", "text": "διὸ καὶ ὁ Πλάτων ἐν τῷ Γοργίᾳ φησὶν ὅτι ἔχει τινὰ σοφίαν ὁ κύων διακρίνειν φίλον ἀπὸ ἐχθροῦ.", "seq": 2127}
{"id": "Elias_Passim_2128", "series": "CAG", "text": "καὶ τὸ διακρίνειν δὲ ἀλήθειαν καὶ ψεῦδος μόνου φιλοσόφου.", "seq": 2128}
{"id": "Elias_Passim_2129", "series": "CAG", "text": "οὕτως καὶ ὁ πέμπτος τρόπος.", "seq": 2129}
{"id": "Elias_Passim_2130", "series": "CAG", "text": "Ἕκτος δὲ τρόπος ἀπὸ τοῦ τέλους, ὥσπερ οἱ Ἡδονικοί·", "seq": 2130}
{"id": "Elias_Passim_2131", "series": "CAG", "text": "τέλος γὰρ τῶν ὄντων τὴν ἡδονὴν ἔλεγον·", "seq": 2131}
{"id": "Elias_Passim_2132", "series": "CAG", "text": "ὧν τῆς φιλοσοφίας κατῆρξεν Ἐπίκουρος, ᾧ συνήκμασεν ὁ Μένανδρος.", "seq": 2132}
{"id": "Elias_Passim_2133", "series": "CAG", "text": "οὗτοι δὲ οἱ Ἐπικούρειοι καὶ μέχρι τῶν οὐρανίων ἵστων τὴν πρόνοιαν, ἵνα μὴ πράγματα σχῇ τὸ θεῖον περιεργαζόμενον τὰ τῇδε.", "seq": 2133}
{"id": "Elias_Passim_2134", "series": "CAG", "text": "μέμνηται δὲ τῆς δόξης ταύτης καὶ Μένανδρος ἐν τοῖς Ἐπιτρέπουσιν, ἡνίκα φησὶν", "seq": 2134}
{"id": "Elias_Passim_2135", "series": "CAG", "text": "οἴει τοσαύτην τοὺς θεοὺς ἄγειν σχολήν, ὡς ἀγαθόν τε καὶ κακὸν καθ᾿ ἡμέραν νέμειν ἑκάστῳ σμικρὸν ἦν;", "seq": 2135}
{"id": "Elias_Passim_2136", "series": "CAG", "text": "οὗτοι ἔλεγον τέλος εἶναι τὴν ἡδονήν, οὐ τὴν αἰσχρὰν δῆθεν τὴν δι᾿ ἀφροδισίων καὶ ἄλλων ἡδυπαθειῶν, ἀλλὰ τὴν ἀσχολίαν τῶν παθῶν καὶ καταστηματικήν, τὴν καθιστῶσαν τὴν ψυχὴν ὥστε μὴ πάσχειν αἰσχρόν τι πάθος·", "seq": 2136}
{"id": "Elias_Passim_2137", "series": "CAG", "text": "οὐδὲ γὰρ ἡδονὴ τέλος τῆς φύσεως·", "seq": 2137}
{"id": "Elias_Passim_2138", "series": "CAG", "text": "οὐδὲ γὰρ διὰ τοῦτο ἐνεργεῖ ἡ φύσις, ἵνα ἡδώμεθα, ἀλλὰ συνέπλεξεν ἡδονὴν τῇ ἐνεργείᾳ οἷον δελεάσασα καὶ γοητεύσασα ἡμᾶς δι᾿ αὐτῆς πρὸς τὸ ἐπίμοχθον τῶν ἐνεργειῶν·", "seq": 2138}
{"id": "Elias_Passim_2139", "series": "CAG", "text": "ἐπίμοχθον γὰρ μὴ πεινῶντα ἐσθίειν καὶ μὴ διψῶντα πίνειν.", "seq": 2139}
{"id": "Elias_Passim_2140", "series": "CAG", "text": "ἡ ἡδονὴ οὖν οὐκ ἔστι τέλος, ἀλλ᾿ ἕπεται ἤτοι συμπλέκεται τῇ κατὰ φύσιν ἐνεργείᾳ, ὥσπερ ἡ σκιὰ τῷ ἐν φωτὶ βαδίζοντι.", "seq": 2140}
{"id": "Elias_Passim_2141", "series": "CAG", "text": "οὕτως καὶ ὁ ἕκτος τρόπος.", "seq": 2141}
{"id": "Elias_Passim_2142", "series": "CAG", "text": "Ἕβδομος τρόπος τῆς ἐπωνυμίας τῶν κατὰ φιλοσοφίαν αἱρέσεων ὁ ὀνομασθεὶς ἀπό τινος συμβεβηκότος, ὡς οἱ Περιπατητικοὶ ἀπὸ τοῦ Πλάτωνος κατὰ περίπατον τὰς συνουσίας ποιουμένου διὰ τὸ ἅμα τῇ ψυχῇ τὸ σῶμα γυμνάζειν.", "seq": 2142}
{"id": "Elias_Passim_2143", "series": "CAG", "text": "καὶ τῶν ἀνθρωπίνων ἀναχωρήσαντος διαδέχεται τὴν σχολὴν αὐτοῦ Σπεύσιππος ὁ υἱὸς τῆς Πρωτώνης ἀδελφῆς τοῦ Πλάτωνος·", "seq": 2143}
{"id": "Elias_Passim_2144", "series": "CAG", "text": "οὐκ ἐτύγχανε γὰρ τηνικαῦτα παρὼν ὁ Ἀριστοτέλης·", "seq": 2144}
{"id": "Elias_Passim_2145", "series": "CAG", "text": "μετασταλεὶς γὰρ ἦν ὑπὸ Φιλίππου ἐν Μακεδονίᾳ ἐπὶ τῷ παιδεῦσαι τὸν υἱὸν αὐτοῦ Ἀλέξανδρον, ὃν παραλαβὼν οὕτως ἐπιμελῶς ἐπαίδευσε τὴν βασιλικὴν ἐπιστήμην ὡς ἐπιλέγειν τὸν Ἀλέξανδρον, ἡνίκα μηδένα ὠφέλησεν, ὅτι ‘σήμερον οὐκ ἐβασίλευσα·", "seq": 2145}
{"id": "Elias_Passim_2146", "series": "CAG", "text": "οὐδένα γὰρ εὐεργέτησα’.", "seq": 2146}
{"id": "Elias_Passim_2147", "series": "CAG", "text": "καί ποτε τοῦ Ἀριστοτέλους εἰπόντος ὅτι ἄπειροι κόσμοι κατὰ Δημόκριτον, ἐπιδακρῦσαί φασι τὸν Ἀλέξανδρον, ὅτι οὐδ᾿ ἑνὸς ὅλου κόσμου ἠδυνήθη ἐπικρατῆσαι.", "seq": 2147}
{"id": "Elias_Passim_2148", "series": "CAG", "text": "ἐκεῖθεν δὲ ὑποστρέψας ὁ Ἀριστοτέλης διαδέχεται τὴν σχολὴν τοῦ Σπευσίππου σὺν Ξενοκράτει, καὶ ἀμφότεροι ἐλέγοντο Περιπατητικοὶ τοῖς τόποις διαφέροντες·", "seq": 2148}
{"id": "Elias_Passim_2149", "series": "CAG", "text": "οἱ μὲν γὰρ ἐκαλοῦντο Λύκειοι Περιπατητικοί, ὡς οἱ Ἀριστοτελικοί, οἱ δὲ ἄλλοι Ἀκαδημαϊκοὶ Περιπατητικοί, ὡς οἱ τοῦ Ξενοκράτους.", "seq": 2149}
{"id": "Elias_Passim_2150", "series": "CAG", "text": "τῷ χρόνῳ δέ, οἷα συμβαίνει, ἐξέλιπε <τῶν> μὲν τὸ ὄνομα τοῦ τόπου καὶ ἐκαλοῦντο Περιπατητικοὶ χωρὶς τοῦ Λύκειοι, τῶν δὲ Ξενοκρατείων τὸ τῆς ἐνεργείας ὄνομα ἐξέλιπε καὶ ἐκαλοῦντο Ἀκαδημαϊκοί.", "seq": 2150}
{"id": "Elias_Passim_2151", "series": "CAG", "text": "Περιπατητικοὶ οὖν ἐκαλοῦντο, οὐχ ὅτι κατὰ περίπατον ἐξηγοῦντο, ἀλλ᾿ ὅτι διεδέξαντο τὴν σχολὴν τοῦ Πλάτωνος, διὰ μέσου Σπευσίππου, κατὰ περίπατον ποιουμένου τὰς ἐξηγήσεις.", "seq": 2151}
{"id": "Elias_Passim_2152", "series": "CAG", "text": "Οὗτοί εἰσιν οἱ ἑπτὰ τρόποι τῆς ἐπωνυμίας τῶν κατὰ φιλοσοφίαν αἱρέσεων.", "seq": 2152}
{"id": "Elias_Passim_2153", "series": "CAG", "text": "προσθῶμεν δὲ καὶ ἡμεῖς καὶ τὴν αἰτίαν τοῦ εἶναι ἑπτὰ μόνον τοὺς τρόπους καὶ μήτε πλείονας μήτε ἐλάττονας.", "seq": 2153}
{"id": "Elias_Passim_2154", "series": "CAG", "text": "δεῖ εἰδέναι ὅτι ὠνομάσθησαν αἱ κατὰ φιλοσοφίαν αἱρέσεις ἢ ἀπὸ τύχης, ὡς Περιπατητικοί, ἢ ἀπὸ διανοίας, <ἀπὸ δὲ διανοίας> ἢ ἀπὸ περιστατικοῦ ἢ ἀπὸ προηγουμένου, καὶ ἀπὸ περιστατικοῦ ἢ ὀνόματος ἢ τόπου.", "seq": 2154}
{"id": "Elias_Passim_2155", "series": "CAG", "text": "καὶ εἰ μὲν ὀνόματος, ὡς Πλατωνικοί, εἰ δὲ τόπου, ἢ χωριστοῦ ἢ ἀχωρίστου.", "seq": 2155}
{"id": "Elias_Passim_2156", "series": "CAG", "text": "καὶ εἰ μὲν ἀχωρίστου, ποιεῖ τὴν τῆς πατρίδος ἐπωνυμίαν, εἰ δὲ χωριστοῦ, ποιεῖ τὴν ἀπὸ τόπου ἐπωνυμίαν.", "seq": 2156}
{"id": "Elias_Passim_2157", "series": "CAG", "text": "ἀπὸ δὲ προηγουμένου ἢ ἀπὸ τοῦ τέλους, ὥσπερ οἱ Ἡδονικοί, ἢ ἀπὸ τῆς πρὸ τέλους κατασκευῆς, καὶ ταύτης ἢ γνωστικῆς ἢ ζωτικῆς.", "seq": 2157}
{"id": "Elias_Passim_2158", "series": "CAG", "text": "καὶ εἰ μὲν γνωστικῆς, ποιεῖ τοὺς Ἐφεκτικούς, εἰ δὲ ζωτικῆς, ποιεῖ τοὺς Κυνικούς.", "seq": 2158}
{"id": "Elias_Passim_2159", "series": "CAG", "text": "ταῦτα καὶ περὶ τῆς αἰτίας τῶν ἐπωνυμιῶν.", "seq": 2159}
{"id": "Elias_Passim_2160", "series": "CAG", "text": "Δεύτερον ἦν κεφάλαιον τῶν προτεθέντων τὸ εἰπεῖν τὴν διαίρεσιν τῶν Ἀριστοτελικῶν συγγραμμάτων χιλίων ὄντων τὸν ἀριθμόν, ὡς Ἀνδρόνικος παραδίδωσιν ὁ † ποίτου ἑνδέκατος γενόμενος διάδοχος.", "seq": 2160}
{"id": "Elias_Passim_2161", "series": "CAG", "text": "τῶν τοίνυν Ἀριστοτελικῶν συγγραμμάτων τὰ μέν εἰσι μερικὰ τὰ δὲ καθόλου τὰ δὲ μεταξύ.", "seq": 2161}
{"id": "Elias_Passim_2162", "series": "CAG", "text": "μερικὰ δὲ λέγονται οὐχ ἁπλῶς τὰ πρὸς ἕνα γεγραμμένα (δυνατὸν γὰρ καὶ καθολικὸν πρᾶγμα πρὸς ἕνα γράψαι·", "seq": 2162}
{"id": "Elias_Passim_2163", "series": "CAG", "text": "οὕτω γοῦν ἡ Περὶ κόσμου πραγματεία καθολικὴ οὖσα προσπεφώνηται Ἀλεξάνδρῳ τῷ βασιλεῖ), ἀλλὰ μερικὰ λέγω ὅσα περὶ ἑνὸς καὶ μερικοῦ καὶ πρὸς ἕνα, ὥσπερ αἱ ἐπιστολαὶ αὐτοῦ·", "seq": 2163}
{"id": "Elias_Passim_2164", "series": "CAG", "text": "αἱ γὰρ ἐπιστολαὶ πρὸς ἕνα εἰσὶ γεγραμμέναι, ἃς ἐν ὀκτὼ βιβλίοις συνήγαγεν Ἀρτέμων τις μετὰ Ἀριστοτέλην γενόμενος.", "seq": 2164}
{"id": "Elias_Passim_2165", "series": "CAG", "text": "καὶ καθόλου δὲ λέγονται ὅσα περὶ πάντων τῶν μονοειδῶν διαλαμβάνει, ὡς ἡ Φυσικὴ ἀκρόασις φυσικῶν πάντων καὶ ἡ Περὶ οὐρανοῦ καὶ τὸ Περὶ γενέσεως καὶ φθορᾶς καὶ τὰ Μετέωρα πάντων τῶν ἐν τῷ μεταρσίῳ τόπῳ ἱσταμένων.", "seq": 2165}
{"id": "Elias_Passim_2166", "series": "CAG", "text": "τὰ δὲ μεταξὺ ὅσα μήτε περὶ πάντων μήτε περὶ ἑνὸς ἀλλὰ περὶ πλειόνων διαλέγεται, ὡς ἡ ἱστορία.", "seq": 2166}
{"id": "Elias_Passim_2167", "series": "CAG", "text": "διττὴ δὲ αὕτη, ἡ μὲν πολιτικὴ ὡς αἱ Πολιτεῖαι, ἃς ἱστόρησεν ἐκ τοῦ πολλὴν γῆν περιελθεῖν ἅμα Ἀλεξάνδρῳ τῷ βασιλεῖ, ἃς ἐκδέδωκε κατὰ στοιχεῖον διακοσίας πεντήκοντα οὔσας τὸν ἀριθμόν, ἡ δὲ φυσικὴ ὡς ἡ Περὶ φυτῶν καὶ ζῴων ἱστορία.", "seq": 2167}
{"id": "Elias_Passim_2168", "series": "CAG", "text": "Τῶν δὲ καθόλου τὰ μέν εἰσιν ὑπομνηματικὰ τὰ δὲ συνταγματικά.", "seq": 2168}
{"id": "Elias_Passim_2169", "series": "CAG", "text": "καὶ ὑπομνηματικὰ μὲν λέγονται ἐν οἷς μόνα τὰ κεφάλαια ἀπεγράφησαν δίχα προοιμίων καὶ ἐπιλόγων καὶ τῆς πρεπούσης ἐκδόσεσιν ἀπαγγελίας.", "seq": 2169}
{"id": "Elias_Passim_2170", "series": "CAG", "text": "τὸ δὲ τοῦ ὑπομνήματος ὄνομα παρὰ Πλάτωνι κεῖται ἐν τῇ Ἐπινομίδι συνόψει οὔσῃ τῶν νόμων·", "seq": 2170}
{"id": "Elias_Passim_2171", "series": "CAG", "text": "φησὶ γὰρ ἐκεῖ περὶ τῶν νόμων ἀνεκδότων μεινάντων ‘ὡς ἄρα φθάνουσί τινες ὑπομνήματα αὐτῶν εἰληφότες’.", "seq": 2171}
{"id": "Elias_Passim_2172", "series": "CAG", "text": "διὸ οὐδὲ δεῖ ἐκ τῶν ὑπομνηματικῶν πιστοῦσθαι τὰς Ἀριστοτέλους δόξας ὡς διόρθωσιν ὑπομεινάντων.", "seq": 2172}
{"id": "Elias_Passim_2173", "series": "CAG", "text": "τῶν δὲ ὑπομνηματικῶν τὰ μὲν μονοειδῆ τὰ δὲ ποικίλα, μονοειδῆ μὲν ὡς ἐνομίσθη τὸ Περὶ ἑρμηνείας ὑπομνηματικὸν διὰ τὴν ἀσάφειαν, πρὶν γράψαι τὸν φιλόσοφον Ἀμμώνιον εἰς αὐτὸ ὑπόμνημα καὶ δεῖξαι ὅτι καὶ προοίμιον ἔχει καὶ ἐπιλόγους καὶ τὴν πρέπουσαν τῇ ἐκδόσει ἀπαγγελίαν, τὰ δὲ ποικίλα ὡς τὰ πρὸς Εὐκαίριον αὐτῷ γεγραμμένα ἑβδομήκοντα βιβλία Περὶ συμμίκτων ζητημάτων χωρὶς προοιμίων καὶ ἐπιλόγου καὶ τῆς διαιρέσεως.", "seq": 2173}
{"id": "Elias_Passim_2174", "series": "CAG", "text": "Τῶν δὲ συνταγματικῶν τὰ μέν εἰσιν αὐτοπρόσωπα, ἃ καὶ ἀκροαματικὰ λέγονται, τὰ δὲ διαλογικά, ἃ καὶ ἐξωτερικὰ λέγονται.", "seq": 2174}
{"id": "Elias_Passim_2175", "series": "CAG", "text": "καὶ ὡς μὲν αὐτοπρόσωπα ἀντίκεινται τοῖς διαλογικοῖς, ὡς δὲ ἀκροαματικὰ ἀντίκεινται τοῖς ἐξωτερικοῖς·", "seq": 2175}
{"id": "Elias_Passim_2176", "series": "CAG", "text": "πάντας γὰρ ἀνθρώπους ὠφελεῖν βουλόμενος ὁ Ἀριστοτέλης ἔγραψε καὶ πρὸς τοὺς ἐπιτηδείους τῆς φιλοσοφίας ἐξ οἰκείου προσώπου (διὸ καὶ ἀκροαματικὰ λέγονται, ὡς δέον αὐτῶν πάντως ἀκροάσασθαι·", "seq": 2176}
{"id": "Elias_Passim_2177", "series": "CAG", "text": "ὅθεν καὶ Φυσικὴ ἀκρόασις, ἐπειδὴ εὐδοκιμεῖν δοκεῖ ὁ Ἀριστοτέλης μάλιστα ἐν αὐτῇ καὶ δέον αὐτῆς πάντως ἀκροάσασθαι τοὺς ἔχοντας ἐπὶ φιλοσοφίαν), ἔγραψε δὲ καὶ πρὸς τοὺς ἀνεπιτηδείους πρὸς φιλοσοφίαν τὰ διαλογικά.", "seq": 2177}
{"id": "Elias_Passim_2178", "series": "CAG", "text": "καὶ ἐν μὲν τοῖς ἀκροαματικοῖς ἅτε δὴ πρὸς ἄνδρας μέλλοντας φιλοσοφεῖν διαλεγόμενος <ἀναγκαστικοῖς, ἐν δὲ τοῖς διαλογικοῖς> πιθανοῖς κέχρηται λόγοις.", "seq": 2178}
{"id": "Elias_Passim_2179", "series": "CAG", "text": "κατασκευάζων δὲ τὴν ἀθανασίαν τῆς ψυχῆς κἀν τοῖς ἀκροαματικοῖς δι᾿ ἀναγκαστικῶν λόγων κατασκευάζει, ἐν δὲ τοῖς διαλογικοῖς διὰ πιθανῶν εἰκότων·", "seq": 2179}
{"id": "Elias_Passim_2180", "series": "CAG", "text": "φησὶ γὰρ ἐν τοῖς Περὶ ψυχῆς ἀκροαματικοῖς ὅτι ἡ ψυχὴ ἄφθαρτος·", "seq": 2180}
{"id": "Elias_Passim_2181", "series": "CAG", "text": "εἰ γὰρ ἦν φθαρτή, ἔδει μάλιστα αὐτὴν φθείρεσθαι ὑπὸ τῆς ἐν τῷ γήρᾳ ἀμαυρώσεως·", "seq": 2181}
{"id": "Elias_Passim_2182", "series": "CAG", "text": "τότε δὲ ἀκμάζει τοῦ σώματος παρακμάσαντος, ὥσπερ οὖν παρακμάζει ὅτε τὸ σῶμα ἀκμάζει·", "seq": 2182}
{"id": "Elias_Passim_2183", "series": "CAG", "text": "τὸ δὲ ὅτε δεῖ φθείρεσθαι ἀκμάζον ἄφθαρτον·", "seq": 2183}
{"id": "Elias_Passim_2184", "series": "CAG", "text": "ἡ ψυχὴ ἄρα ἄφθαρτός ἐστι.", "seq": 2184}
{"id": "Elias_Passim_2185", "series": "CAG", "text": "καὶ οὕτως μὲν ἐν τοῖς ἀκροαματικοῖς.", "seq": 2185}
{"id": "Elias_Passim_2186", "series": "CAG", "text": "ἐν δὲ τοῖς διαλογικοῖς φησιν οὕτως·", "seq": 2186}
{"id": "Elias_Passim_2187", "series": "CAG", "text": "ὅτι ἡ ψυχὴ ἀθάνατος, ἐπειδὴ αὐτοφυῶς πάντες οἱ ἄνθρωποι καὶ σπένδομεν χοὰς τοῖς κατοιχομένοις καὶ ὄμνυμεν κατ᾿ αὐτῶν, οὐδεὶς δὲ τῷ μηδαμῇ μηδαμῶς ὄντι σπένδει ποτὲ ἢ ὄμνυσι κατ᾿ αὐτοῦ.", "seq": 2187}
{"id": "Elias_Passim_2188", "series": "CAG", "text": "ὁ δὲ Ἀλέξανδρος ἄλλην διαφορὰν λέγει τῶν ἀκροαματικῶν πρὸς τὰ διαλογικά, ὅτι ἐν μὲν τοῖς ἀκροαματικοῖς τὰ δοκοῦντα αὐτῷ λέγει καὶ τὰ ἀληθῆ, ἐν δὲ τοῖς διαλογικοῖς τὰ ἄλλοις δοκοῦντα, τὰ ψευδῆ.", "seq": 2188}
{"id": "Elias_Passim_2189", "series": "CAG", "text": "ἀλλ᾿, ὦ Ἀλέξανδρε, ἔστιν εἰπεῖν πρὸς αὐτόν, ὅτι οὐκ ἔστιν τοῦτο φιλοσόφου·", "seq": 2189}
{"id": "Elias_Passim_2190", "series": "CAG", "text": "τὸ γὰρ ψεῦδος μὲν ἑλέσθαι, ἀφανίσαι δὲ τὸ ἀληθές, οὐχὶ θεμιτόν·", "seq": 2190}
{"id": "Elias_Passim_2191", "series": "CAG", "text": "ἐχθρὸς γάρ μοι κεῖνος ἀνὴρ ὁμῶς Ἀΐδαο πύλῃσιν, ὅς χ᾿ ἕτερον μὲν κεύθῃ ἐνὶ φρεσὶν ἄλλο δ᾿ ἐνίσπῃ.", "seq": 2191}
{"id": "Elias_Passim_2192", "series": "CAG", "text": "τοῦτο δὲ εἶπεν ὁ Ἀλέξανδρος, ἐπειδὴ τὴν λογικὴν ψυχὴν βούλεται φθαρτὴν εἶναι, ὁ δὲ Ἀριστοτέλης ἐν τοῖς διαλογικοῖς μάλιστα δοκεῖ κηρύττειν τὴν ἀθανασίαν τῆς ψυχῆς·", "seq": 2192}
{"id": "Elias_Passim_2193", "series": "CAG", "text": "ἵνα οὖν μὴ σχῇ ἐλέγχοντα τὸν Ἀριστοτέλην, διὰ τοῦτο εἶπε τὴν τοιαύτην διαφοράν.", "seq": 2193}
{"id": "Elias_Passim_2194", "series": "CAG", "text": "ἐν οἷς ἡ πρᾶξις.", "seq": 2194}
{"id": "Elias_Passim_2195", "series": "CAG", "text": "Ἡ διαίρεσις τῶν αὐτοπροσώπων κατὰ τὴν διαίρεσιν γίνεται τῆς φιλοσοφίας προστιθεμένου τοῦ λογικοῦ ἤτοι ὀργανικοῦ·", "seq": 2195}
{"id": "Elias_Passim_2196", "series": "CAG", "text": "τῆς γὰρ φιλοσοφίας εἰς δύο διαιρουμένης τὰ αὐτοπρόσωπα εἰς τρία διαιρεῖται·", "seq": 2196}
{"id": "Elias_Passim_2197", "series": "CAG", "text": "τούτων γὰρ τὰ μέν εἰσι θεωρητικὰ τὰ δὲ πρακτικὰ τὰ δὲ λογικὰ ἤτοι ὀργανικά.", "seq": 2197}
{"id": "Elias_Passim_2198", "series": "CAG", "text": "καὶ ἕκαστον τούτων εἰς τρία διαιρεῖται·", "seq": 2198}
{"id": "Elias_Passim_2199", "series": "CAG", "text": "τὰ γὰρ θεωρητικὰ εἰς τρία διαιροῦνται, εἰς φυσιολογικὸν μαθηματικὸν θεολογικόν, τὰ δὲ πρακτικὰ εἰς ἠθικὰ οἰκονομικὰ πολιτικά, τὰ δὲ λογικὰ εἰς τὰ πρὸ τῆς μεθόδου εἰς αὐτὴν τὴν μέθοδον καὶ εἰς τὰ ὑποδυόμενα τὴν μέθοδον.", "seq": 2199}
{"id": "Elias_Passim_2200", "series": "CAG", "text": "τὰ οὖν φυσικὰ τοῦ Ἀριστοτέλους ἢ περὶ τῶν σωματικῶν ἐστιν ἢ περὶ τῶν ἀσωμάτων.", "seq": 2200}
{"id": "Elias_Passim_2201", "series": "CAG", "text": "καὶ εἰ μὲν περὶ ἀσωμάτων, ἢ περὶ τῶν χειρόνων τῶν σωμάτων ἢ περὶ τῶν κρειττόνων.", "seq": 2201}
{"id": "Elias_Passim_2202", "series": "CAG", "text": "καὶ εἰ μὲν περὶ τῶν κρειττόνων τῶν σωμάτων, ὡς ἡ Περὶ τῆς ψυχῆς αὐτοῦ πραγματεία (ἡ γὰρ ψυχὴ κρείττων τοῦ σώματος πέφυκεν εἶναι), εἰ δὲ περὶ χειρόνων τοῦ σώματος, ὡς τὰ Περὶ τῶν χρωμάτων αὐτοῦ ζητήματα·", "seq": 2202}
{"id": "Elias_Passim_2203", "series": "CAG", "text": "τὰ γὰρ χρώματα χείρω τῶν σωμάτων καθέστηκε, καθότι ἐν αὐτοῖς ἔχει τὸ εἶναι.", "seq": 2203}
{"id": "Elias_Passim_2204", "series": "CAG", "text": "ἡ δὲ περὶ τὰ σώματα αὐτοῦ φυσιολογία ἢ περὶ τὰ ὑπὲρ τὴν σελήνην, ὡς τὰ οὐράνια σώματα καὶ ἡ περὶ τούτων ζήτησις, περὶ γαλαξίου περὶ ἄστρων περὶ ἡλίου καὶ σελήνης, ἢ περὶ τῶν ὑπὸ σελήνην, καὶ τούτων ἢ περὶ τὰ καθόλου τῆς τῶν σωμάτων φύσεως, ὡς τὰ Περὶ γενέσεως καὶ φθορᾶς ζητήματα, ἢ περὶ τῶν μερικῶν.", "seq": 2204}
{"id": "Elias_Passim_2205", "series": "CAG", "text": "καὶ εἰ μὲν μερικῶν, ἢ ἐμψύχων ἢ ἀψύχων.", "seq": 2205}
{"id": "Elias_Passim_2206", "series": "CAG", "text": "καὶ εἰ μὲν ἐμψύχων, ἢ αἰσθητικῶν ἢ ἀναισθήτων.", "seq": 2206}
{"id": "Elias_Passim_2207", "series": "CAG", "text": "καὶ εἰ μὲν περὶ ἀναισθήτων ἐμψύχων, ὡς τὰ Περὶ φυτῶν αὐτοῦ ζητήματα, εἰ δὲ αἰσθητικῶν, καὶ τούτων πάλιν ἢ περὶ τῶν καθόλου, ὡς αἱ Περὶ τῶν ζῴων αὐτοῦ ἱστορίαι, ἔνθα διαλέγεται περὶ τῶν ἐν τοῖς ζῴοις παθημάτων, περὶ γήρους καὶ νεότητος, περὶ αὐξήσεως καὶ μειώσεως (ταῦτα γὰρ καθόλου εἰσὶ καὶ πᾶσι τοῖς ζῴοις ὑπάρχει), ἢ αὖ κατ᾿ ἰδίαν, ὡς Περὶ τῆς καθ᾿ ὕπνον μαντικῆς·", "seq": 2207}
{"id": "Elias_Passim_2208", "series": "CAG", "text": "αὕτη γὰρ μόνοις τοῖς ἀνθρώποις ὑπάρχει.", "seq": 2208}
{"id": "Elias_Passim_2209", "series": "CAG", "text": "εἰ δὲ πάλιν περὶ τῶν ὑπὸ σελήνην αὐτοῦ φυσιολογικῶν ζητημάτων, τὰ μὲν ὑπὲρ τὴν γῆν ἐστι τὰ δὲ ἐν τῇ γῇ τὰ δὲ ὑπὸ τὴν γῆν·", "seq": 2209}
{"id": "Elias_Passim_2210", "series": "CAG", "text": "καὶ εἰ μὲν ὑπὲρ τὴν γῆν, ὡς τὰ Μετεωρολογικὰ αὐτοῦ, ἔνθα διαλέγεται περὶ τῆς καπνώδους ἀτμίδος καὶ αὐχμηρώδους, περὶ βροντῆς τε καὶ ἀστραπῆς καὶ νεφῶν καὶ περὶ τῶν διᾳττόντων κομητῶν, δαλῶν τε καὶ αἰγῶν καὶ τῶν ἄλλων εἰδῶν, εἰ δὲ ἐν τῇ γῆ, ὡς ἡ Περὶ θαλασσῶν καὶ ποταμῶν καὶ πηγῶν πραγματεία, εἰ δὲ περὶ τῶν ὑπὸ τὴν γῆν, ὡς ἡ Περὶ τῶν σεισμῶν καὶ χασμάτων αὐτοῦ ζήτησις.", "seq": 2210}
{"id": "Elias_Passim_2211", "series": "CAG", "text": "καὶ ταῦτα μὲν περὶ τῆς φυσιολογικῆς τοῦ Ἀριστοτέλους.", "seq": 2211}
{"id": "Elias_Passim_2212", "series": "CAG", "text": "τὰ δὲ μαθηματικὰ αὐτοῦ ὡς τὰ Ὀπτικὰ καὶ Μηχανικὰ αὐτῷ βιβλία γεγραμμένα, θεολογικὰ δὲ ὡς τὰ Μετὰ τὰ φυσικὰ περὶ ἀρχῆς ζητήματα.", "seq": 2212}
{"id": "Elias_Passim_2213", "series": "CAG", "text": "αὕτη μὲν ἡ διαίρεσις τῶν θεωρητικῶν.", "seq": 2213}
{"id": "Elias_Passim_2214", "series": "CAG", "text": "Τῶν δὲ πρακτικῶν τὰ μέν εἰσιν ἠθικὰ τὰ δὲ οἰκονομικὰ τὰ δὲ πολιτικά.", "seq": 2214}
{"id": "Elias_Passim_2215", "series": "CAG", "text": "ἠθικὰ μὲν ὡς τὰ Εὐδήμεια καὶ Νικομάχεια τά τε μικρὰ καὶ τὰ μεγάλα·", "seq": 2215}
{"id": "Elias_Passim_2216", "series": "CAG", "text": "τὰ μὲν γὰρ τῷ πατρὶ προσφωνεῖ Νικομάχῳ καὶ λέγονται Νικομάχεια μεγάλα, τὰ δὲ τῷ υἱῷ ὁμωνύμῳ τῷ πατρὶ καὶ λέγονται Νικομάχεια μικρά.", "seq": 2216}
{"id": "Elias_Passim_2217", "series": "CAG", "text": "πολιτικὰ δὲ ὡς τὸ Πολιτικὸν σύνταγμα, ἐν ᾧ διδάσκει πῶς δεῖ πολιτεύεσθαι.", "seq": 2217}
{"id": "Elias_Passim_2218", "series": "CAG", "text": "κἀν τῷ δευτέρῳ λόγῳ τοῦ Πολιτικοῦ ἀντιλέγει τῇ Πολιτείᾳ Πλάτωνος ἅτε ὁμοστοίχῳ οὔσῃ τῇ πολιτείᾳ·", "seq": 2218}
{"id": "Elias_Passim_2219", "series": "CAG", "text": "ἐν γὰρ ταῖς Πολιτείαις οὐ διδάσκει πῶς δεῖ πολιτεύεσθαι, ἀλλὰ πῶς οἱ πρὸ αὐτοῦ ἐπολιτεύσαντο ἄνθρωποι.", "seq": 2219}
{"id": "Elias_Passim_2220", "series": "CAG", "text": "ἀλλὰ μὴν καὶ οἰκονομικά εἰσιν αὐτῷ γεγραμμένα βιβλία, ὡς τὸ Οἰκονομικὸν σύνταγμα καὶ Περὶ συμβιώσεως ἀνδρὸς καὶ γυναικός, ἐν ᾧ λέγει ἐκ τεσσάρων σχέσεων συγκεκροτῆσθαι τὸν εὖ ἔχοντα οἶκον, πατρὸς πρὸς τέκνα, ἀνδρὸς πρὸς γυναῖκα, δεσπότου πρὸς δούλους, εἰσιόντων πρὸς ἐξιόντα καὶ ὡς εἴρηται ἡμῖν ἐν τοῖς τῆς Πορφυρίου Εἰσαγωγῆς προλεγομένοις.", "seq": 2220}
{"id": "Elias_Passim_2221", "series": "CAG", "text": "αὕτη καὶ ἡ τοῦ πρακτικοῦ διαίρεσις.", "seq": 2221}
{"id": "Elias_Passim_2222", "series": "CAG", "text": "Τὸ δὲ λογικὸν καὶ αὐτὸ εἰς τρία διαιρεῖται, εἰς τὰ πρὸ τῆς ἀποδείξεως ἤγουν μεθόδου καὶ εἰς αὐτὴν τὴν ἀπόδειξιν καὶ εἰς τὰ ὑποδυόμενα τὴν ἀπόδειξιν.", "seq": 2222}
{"id": "Elias_Passim_2223", "series": "CAG", "text": "καὶ τὰ μὲν πρὸ τῆς μεθόδου καὶ τῆς ἀποδείξεώς εἰσιν αἵ τε Κατηγορίαι καὶ τὸ Περὶ ἑρμηνείας καὶ τὰ Πρότερα ἀναλυτικά, τὰ δὲ αὐτὴν τὴν μέθοδον τῆς ἀποδείξεως διδάσκοντά εἰσι τὰ Δεύτερα ἀναλυτικά, τὰ δὲ ὑποδυόμενα αὐτὴν τὴν ἀπόδειξίν εἰσι τὰ Τοπικά, αἱ Ῥητορικαὶ τέχναι, οἱ Σοφιστικοὶ ἔλεγχοι καὶ τὸ Περὶ ποιητικῆς·", "seq": 2223}
{"id": "Elias_Passim_2224", "series": "CAG", "text": "πέντε γάρ εἰσιν εἴδη τῶν συλλογισμῶν, ἀποδεικτικὸς διαλεκτικὸς ῥητορικὸς σοφιστικὸς ποιητικός.", "seq": 2224}
{"id": "Elias_Passim_2225", "series": "CAG", "text": "καὶ εἰκότως, ἐπειδὴ καὶ αἱ προτάσεις ὅθεν λαμβάνονται πέντε εἰσίν·", "seq": 2225}
{"id": "Elias_Passim_2226", "series": "CAG", "text": "ἢ γὰρ πάντῃ ἀληθεῖς εἰσιν αἱ προτάσεις καὶ ποιοῦσι τὸν ἀποδεικτικόν, ἢ πάντῃ ψευδεῖς καὶ ποιοῦσι τὸν ποιητικὸν τὸν μυθώδη, ἢ πῇ μὲν ἀληθεῖς πῇ δὲ ψευδεῖς, καὶ τοῦτο τριχῶς·", "seq": 2226}
{"id": "Elias_Passim_2227", "series": "CAG", "text": "ἢ γὰρ μᾶλλον ἀληθεύει ἧττον δὲ ψεύδεται καὶ ποιεῖ τὸν διαλεκτικὸν συλλογισμόν, ἢ πλέον ἔχει τὸ ψεῦδος τοῦ ἀληθοῦς καὶ ποιεῖ τὸν σοφιστικόν, ἢ ἐπίσης ἔχει τὸ ἀληθὲς τῷ ψεύδει καὶ ποιεῖ τὸν ῥητορικόν.", "seq": 2227}
{"id": "Elias_Passim_2228", "series": "CAG", "text": "ὅθεν καὶ στάσεις παρὰ μόνοις τοῖς ῥήτορσι διὰ τὸ ἐξισάζειν τὸ ἀληθὲς καὶ τὸ ψεῦδος·", "seq": 2228}
{"id": "Elias_Passim_2229", "series": "CAG", "text": "ἣν γὰρ ἐκτελεῖ χρείαν ἡ στάθμη τῷ τέκτονι διακρίνουσα τὰ εὐθέα ἀπὸ τῶν καμπύλων καὶ παρὰ τοῖς οἰκοδόμοις τὸ βαρύλλιον διακρῖνον τὰ ὀρθὰ ἀπὸ τῶν κεκλιμένων, οὕτω καὶ ἡ λογικὴ ὄργανον οὖσα τῆς φιλοσοφίας διακρίνει τὸ ἀληθὲς καὶ τὸ ψεῦδος καὶ τὸ ἀγαθὸν καὶ τὸ κακόν, ἵνα μὴ ψευδῆ δοξάσωμεν μηδὲ κακὰ διαπραξώμεθα.", "seq": 2229}
{"id": "Elias_Passim_2230", "series": "CAG", "text": "ταῦτα ἔχει καὶ ἡ παροῦσα πρᾶξις.", "seq": 2230}
{"id": "Elias_Passim_2231", "series": "CAG", "text": "Ἐπειδὴ πολλὰ ὄντα τὰ Ἀριστοτελικὰ βιβλία ἔγνωμεν διὰ τῆς διαιρέσεως καὶ διὰ τοῦτο οὐκ ἴσμεν τί μὲν πρῶτον τί δὲ μετέπειτα τί δὲ ὑστάτιον μεταχειρισώμεθα, φέρε τρία τινὰ ζητήσωμεν, τίς ἡ ἀρχὴ τῶν Ἀριστοτελικῶν συγγραμμάτων, τί τὸ τέλος, τίς ἡ μεταξὺ ὁδός.", "seq": 2231}
{"id": "Elias_Passim_2232", "series": "CAG", "text": "ταῦτα δὲ ζητοῦμεν οὐ μόνον διὰ τὸ πλῆθος αὐτῶν ἀλλὰ καὶ διὰ τὴν διαφωνίαν τῶν ἀρχαίων·", "seq": 2232}
{"id": "Elias_Passim_2233", "series": "CAG", "text": "οἱ μὲν γὰρ ἔλεγον ὅτι δεῖ ἀπὸ τῆς φυσικῆς ἄρξασθαι, οἱ δὲ ἀπὸ τῆς λογικῆς, ἄλλοι δὲ ἀπὸ τῆς ἠθικῆς, ἕτεροι δὲ ἀπὸ τῆς μαθηματικῆς·", "seq": 2233}
{"id": "Elias_Passim_2234", "series": "CAG", "text": "Βοηθὸς γὰρ ὁ Σιδώνιος ἀπὸ τῆς φυσικῆς λέγει, Ἀνδρόνικος δὲ ὁ Ῥόδιος ὁ Περιπατητικὸς ὁ ἑνδέκατος διάδοχος τῆς Ἀριστοτέλους σχολῆς ἀπὸ τῆς λογικῆς ἔλεγε, τῶν δὲ Πλατωνικῶν οἱ μὲν ἀπὸ τῆς ἠθικῆς οἱ δὲ ἀπὸ τῶν μαθηματικῶν.", "seq": 2234}
{"id": "Elias_Passim_2235", "series": "CAG", "text": "καὶ πάντες τὰς οἰκείας δόξας κατεσκεύαζον·", "seq": 2235}
{"id": "Elias_Passim_2236", "series": "CAG", "text": "οἱ γὰρ λέγοντες ὅτι δεῖ ἀπὸ τῆς ἠθικῆς ἄρχεσθαι ἔλεγον ὅτι δεῖ πρότερον κοσμῆσαι τὰ ἠθικὰ προκαθάραντας τὴν ψυχὴν ἀπὸ τῶν μοχθηρῶν ἠθῶν, ἵνα καθαρὰ οὖσα καθαρᾷ προσομιλήσῃ τῇ φιλοσοφίᾳ·", "seq": 2236}
{"id": "Elias_Passim_2237", "series": "CAG", "text": "‘μὴ καθαρὸν γὰρ καθαρῶν ἐφάπτεσθαι οὐχὶ θεμιτόν’ κατὰ τὴν Πλάτωνος φωνήν, ὡς καὶ οἱ ἰατρικοί φασι ‘τὰ μὴ καθαρὰ τῶν σωμάτων ὁκόσα ἂν θρέψῃς, μᾶλλον ἂν βλάψοις ὕλην ὑποβάλλων τῇ κακοχυμίᾳ’, καὶ ὡς οὐκ ἔστιν ὄψει λημώσῃ ἢ φλεγμαινούσῃ ἀκριβολογήσασθαι τὰ ὁρατά, οὕτω καὶ ὁ τοῖς μοχθηροῖς δόγμασι προκατειλημμένος τὴν ψυχὴν ἐπιχειρῶν διδάσκειν μείζονας ἀρχὰς αὐτῇ ψευδοδοξίας παρέχει, καὶ ἀπαίδευτος οὐχ ὁ μηδὲν εἰδὼς ἀλλ᾿ ὁ τὸν ἐν αὑτῷ παῖδα μὴ καταστείλας·", "seq": 2237}
{"id": "Elias_Passim_2238", "series": "CAG", "text": "ἔστι γὰρ παῖς ἐν ἡμῖν καὶ γέρουσιν οὖσι, τοῦτ᾿ ἔστιν ἡ ἄλογος ψυχή, ἣν δεῖ παιδεύειν·", "seq": 2238}
{"id": "Elias_Passim_2239", "series": "CAG", "text": "ὅθεν καὶ παιδεία εἴρηται ἡ ἀναγωγὴ ὡς τοῦ ἐν ἡμῖν παιδὸς οὖσα καταστολή, καὶ πεπαιδευμένος παρὰ Πλάτωνι οὐχ ὁ πολλὰ εἰδὼς καὶ ῥέων χρήσεις ἀλλ᾿ ὁ τὸν ἐν αὑτῷ παῖδα κατεσταλμένον ἔχων·", "seq": 2239}
{"id": "Elias_Passim_2240", "series": "CAG", "text": "διό φησιν αὐτὸς ὅτι ‘φιλόσοφον ἐγὼ καλῶ τὸν εὖ ζῶντα, κἂν μήτε γράμματα μήτε νεῖν ἐπίσταται’, τὰ περισπούδαστα τοῖς Ἀθηναίοις, γράμματα μὲν διὰ τὴν σοφίαν, νεῖν δὲ διὰ τὸ ναυμαχεῖν.", "seq": 2240}
{"id": "Elias_Passim_2241", "series": "CAG", "text": "οὕτως μὲν οὗτοι.", "seq": 2241}
{"id": "Elias_Passim_2242", "series": "CAG", "text": "Οἱ δὲ ἀπὸ τῆς φυσικῆς λέγοντες <δεῖν> ἄρχεσθαι ἔλεγον ὅτι τὰ φυσικὰ μαλακώτερά εἰσιν ὡς σύντροφα ἐκ παίδων ψηλαφώμενα ὑφ᾿ ἡμῶν, οἷον σάρκες φλέβες νεῦρα, καὶ ὅτι οἱ ἰατροὶ ἀρχόμενοι τῆς θεραπείας ἀπὸ τῶν μαλακωτέρων ἄρχονται φαρμάκων, ὅτι μάλιστα δοκεῖ Ἀριστοτέλης εὐδοκιμεῖν ἐν ταῖς φυσικαῖς αὐτοῦ πραγματείαις.", "seq": 2242}
{"id": "Elias_Passim_2243", "series": "CAG", "text": "οὕτως καὶ οὗτοι.", "seq": 2243}
{"id": "Elias_Passim_2244", "series": "CAG", "text": "οἱ δὲ λέγοντες ὅτι δεῖ ἀπὸ τῶν μαθηματικῶν ἄρχεσθαί φασιν ὅτι δεῖ ταῦτα πρῶτον ἀναγινώσκειν διὰ τὸ θάρρος τῶν ἀποδείξεων (ταῦτα γὰρ κυρίως μανθάνομεν, τὰ δὲ εἰκάζομεν ἤπερ μανθάνομεν), καὶ ὅτι ἐν τούτοις διδασκόμεθα πῶς δεῖ μανθάνειν, ὅτι γραμμικαῖς ἀνάγκαις, οὐκ ἀξιοπιστίᾳ προσώπων ἀναπαυούμενοι, καὶ διὰ Πλάτωνα ἐπιγράψαντα πρὸ τοῦ μουσείου ‘ἀγεωμέτρητος μηδεὶς εἰσίτω.’", "seq": 2244}
{"id": "Elias_Passim_2245", "series": "CAG", "text": "Οἱ δὲ λέγοντες ὅτι δεῖ ἀπὸ τῆς λογικῆς ἄρχεσθαι ἔφασκον ὅτι ὄργανον ἡ λογικὴ καὶ δεῖ πρῶτον εἰδέναι τὸ ὄργανον καὶ εἶθ᾿ οὕτως ποῦ δεῖ χρήσασθαι τῷ ὀργάνῳ·", "seq": 2245}
{"id": "Elias_Passim_2246", "series": "CAG", "text": "οὕτω γὰρ καὶ ἐπὶ βαναύσων τεχνῶν ἔχει·", "seq": 2246}
{"id": "Elias_Passim_2247", "series": "CAG", "text": "ὁ γὰρ φοιτήσας εἰς τέκτονα πρῶτον μανθάνει τὰ ὄργανα, οἷον τρύπανον τέρετρον, καὶ εἶθ᾿ οὕτως ἄρχεται αὐτῆς τῆς τεκτονικῆς.", "seq": 2247}
{"id": "Elias_Passim_2248", "series": "CAG", "text": "οὕτως μὲν οὖν καὶ οὗτοι.", "seq": 2248}
{"id": "Elias_Passim_2249", "series": "CAG", "text": "φέρε δὲ ἡμεῖς εἴπωμεν τἀληθὲς πόθεν δεῖ ἄρχεσθαι.", "seq": 2249}
{"id": "Elias_Passim_2250", "series": "CAG", "text": "ἔδει τοίνυν ἄρχεσθαι ἡμᾶς ἀπὸ τῆς ἠθικῆς διὰ τοὺς λέγοντας δεῖν ἀπὸ τῆς ἠθικῆς ἄρχεσθαι·", "seq": 2250}
{"id": "Elias_Passim_2251", "series": "CAG", "text": "τούτων γὰρ δριμύτερον οὐδὲν ἔχομεν.", "seq": 2251}
{"id": "Elias_Passim_2252", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ διδασκόμεθα τὰ ἤθη οὐκ ἐκ συνηθείας καθάπερ τὰ πληγῇ νεμόμενα ζῷα, δεῖν ἄρχεσθαι ἀπὸ τῆς λογικῆς, μηδὲ οὕτως ἀμελήσαντας τῶν ἠθῶν ἀλλ᾿ ἁμωσγέπως αὖ κοσμήσαντας διὰ παραινέσεων ἐγγράφων ἢ ἀγράφων, οἷαί εἰσιν αἱ Ἰσοκράτους, ἵν᾿ ἕτοιμον εὕροι ὁ λόγος τὸ ὅ τι ἀκριβῶς ἐπαγιώθη ἐν αὐτῷ·", "seq": 2252}
{"id": "Elias_Passim_2253", "series": "CAG", "text": "ἰστέον γὰρ ὅτι τῆς φιλοσοφίας εἰς τὸ θεωρητικὸν καὶ τὸ πρακτικὸν διαιρουμένης καὶ τοῦ μὲν θεωρητικοῦ περὶ τὸ ἐν λόγοις ἀληθὲς καὶ ψεῦδος καταγινομένου τοῦ δὲ πρακτικοῦ περὶ τὸ ἐν πράξει ἀγαθὸν καὶ κακόν, παρῆλθεν ὁ συλλογισμὸς ὄργανον κοσκίνου δίκην οἷον ἐκλογῆς καὶ ἀπεκλογῆς, ἵν᾿ ἐν μὲν θεωρίᾳ ἐκλέξηται τὸ ἀληθὲς ἐν δὲ πράξει τὸ ἀγαθόν, ἀπεκλέξηται δὲ καὶ τὸ ψεῦδος καὶ τὸ κακόν, ἵνα μήτε ψευδῆ δοξάσωμεν μήτε κακὰ διαπραξώμεθα.", "seq": 2253}
{"id": "Elias_Passim_2254", "series": "CAG", "text": "καὶ εἰ ἦν ἐν τοῖς Πλάτωνος χρόνοις ἡ διαλεκτική, οὐκ ἂν ἐπέγραψεν ὁ Πλάτων πρὸ τοῦ οἰκείου μουσείου ‘ἀγεωμέτρητος μηδεὶς εἰσίτω’, ὁπότε καὶ οὗτος ἐνεδείξατο τὴν δύναμιν αὐτῆς ἐν τῷ Σοφιστῇ λέγων οὕτως ‘γύμναζε σαυτὸν διὰ τῆς καλουμένης παρὰ πολλοῖς ἀδολεσχίας, ἕως ἔτι νέος εἶ, ἐπεὶ διαφεύξεταί σε τἀληθές’, ἀδολεσχίαν καλέσας τὴν ἀποστασίαν τῶν πραγμάτων ἤγουν τὴν λογικήν·", "seq": 2254}
{"id": "Elias_Passim_2255", "series": "CAG", "text": "καὶ γὰρ Ἀριστοτέλης ἐν τῇ λογικῇ ἀντὶ τῶν πραγμάτων εἰσφέρει ταῦτα τὰ στοιχεῖα, ἄλφα βῆτα γάμμα, καὶ διὰ τούτων διδάσκει τὰς συμπλοκὰς τῶν συλλογισμῶν·", "seq": 2255}
{"id": "Elias_Passim_2256", "series": "CAG", "text": "διὸ συνεχῶς αὐτοῖς χρώμενος ἐν τῇ λογικῇ οἷον ἀδολεσχίαν τινὰ ποιεῖ ἑκάστοτε τὰ αὐτὰ λέγων.", "seq": 2256}
{"id": "Elias_Passim_2257", "series": "CAG", "text": "ταῦτα καὶ ἡμεῖς καὶ πόθεν δεῖ ἄρχεσθαι εἴπωμεν.", "seq": 2257}
{"id": "Elias_Passim_2258", "series": "CAG", "text": "ἐν οἷς ἡ πρᾶξις.", "seq": 2258}
{"id": "Elias_Passim_2259", "series": "CAG", "text": "Ἐπειδὴ ἔδειξεν ἡμῖν ὁ λόγος ὅτι δεῖ ἀπὸ τῆς λογικῆς ἄρχεσθαι προκοσμήσαντας τὰ ἤθη, ἵνα καθαροὶ ὄντες καθαρᾷ προσομιλήσωμεν τῇ φιλοσοφίᾳ, ἔτι δὲ τῆς φιλοσοφίας διαιρουμένης εἴς τε τὸ θεωρητικὸν καὶ πρακτικὸν ἡ λογικὴ οἷα κόσκινόν τι οὖσα, ὡς προείπομεν, ἐκλέγεται ἀπὸ μὲν τοῦ θεωρητικοῦ τὸ ἀληθὲς ἀπὸ δὲ τοῦ πρακτικοῦ τὸ ἀγαθόν, ἀπεκλέγεται δὲ καὶ τὸ ψεῦδος τοῦ θεωρητικοῦ καὶ τὸ κακὸν πάλιν τοῦ πρακτικοῦ, ἵνα μήτε ψευδῆ δοξάσωμεν μήτε κακὰ διαπραξώμεθα, ἔχοντες τὴν λογικὴν διακρίνουσαν, ἤγουν τὴν ἀπόδειξιν, ἥτις ἐστὶ τῷ ὄντι τὸ Ἑρμαϊκὸν μῶλυ, ᾗτινι ὁπλισάμενοι οὐ θέλγονται ὑπὸ τῶν Σειρήνων τῶν ἑτεροδόξων αἱρέσεων τῆς φιλοσοφίας, ὥσπερ ὁ Ὀδυσσεύς, τῶν ἑταίρων αὐτοῦ συωθέντων ὑπὸ τοῦ τῆς Κίρκης φαρμάκου, ὁ δὲ τῇ ἀποδείξει μὴ ὁπλισάμενος γίνεται ὗς Βοιωτία·", "seq": 2259}
{"id": "Elias_Passim_2260", "series": "CAG", "text": "συνήγαγεν οὖν ὁ λόγος ὅτι δεῖ ἀπὸ τῆς λογικῆς ἄρχεσθαι τὰ ἤθη πρότερον κοσμήσαντας.", "seq": 2260}
{"id": "Elias_Passim_2261", "series": "CAG", "text": "Καὶ ἐπειδὴ συνεχῶς περὶ τῆς ἀρχῆς ἐζητοῦμεν, ἡ δὲ ἀρχὴ πάντως τέλους ἐστὶν ἀρχή, φέρε περὶ τοῦ τέλους ζητήσωμεν, ἐπειδὴ καὶ τέταρτον κεφάλαιον ἦν τῶν προτεθέντων ζητῆσαι τί τὸ τέλος, καὶ ὅτι γινώσκοντες τί τὸ τέλος προθυμότεροι γινόμεθα, οἱ δὲ μὴ γινώσκοντες τὸ τέλος τυφλοῖς ἐοίκασι βαδίζουσι καὶ φερομένοις οἷ μὴ δεῖ.", "seq": 2261}
{"id": "Elias_Passim_2262", "series": "CAG", "text": "τέλος τοίνυν τῆς Ἀριστοτελικῆς φιλοσοφίας τὸ γνῶναι ὅτι πάντων μία ἐστὶν ἀρχή·", "seq": 2262}
{"id": "Elias_Passim_2263", "series": "CAG", "text": "ἀποδεκτέον γὰρ μᾶλλον ἐπὶ θεοῦ τὸ εἰρημένον ἤπερ ἐπὶ βασιλέως, ὡς παρὰ τῷ ποιητῇ", "seq": 2263}
{"id": "Elias_Passim_2264", "series": "CAG", "text": "οὐκ ἀγαθὸν πολυκοιρανίη.", "seq": 2264}
{"id": "Elias_Passim_2265", "series": "CAG", "text": "ὅτι δὲ μία πάντων ἀρχὴ δείκνυσιν ὁ Ἀριστοτέλης ἐν τῇ Μετὰ τὰ φυσικὰ θεολογῶν οὕτως·", "seq": 2265}
{"id": "Elias_Passim_2266", "series": "CAG", "text": "ἡ ἀρχὴ ἢ μία ἢ πολλαί·", "seq": 2266}
{"id": "Elias_Passim_2267", "series": "CAG", "text": "καὶ εἰ μὲν μία, ἔχομεν τὸ ζητούμενον, εἰ δὲ πολλαί, ἢ τεταγμέναι ἢ ἄτακτοι.", "seq": 2267}
{"id": "Elias_Passim_2268", "series": "CAG", "text": "ἀλλ᾿ εἰ μὲν ἄτακτοι, ἀτακτότερα τὰ ἐξ αὐτῶν καὶ οὐκέτι κόσμος ὁ κόσμος ἀλλ᾿ ἀκοσμία, καὶ ἔσται τὸ παρὰ φύσιν τοῦ κατὰ φύσιν μὴ ὄντος.", "seq": 2268}
{"id": "Elias_Passim_2269", "series": "CAG", "text": "εἰ δὲ τεταγμέναι, ἢ ὑφ᾿ ἑαυτῶν ἐτάχθησαν ἢ ἔξωθεν ὑπό τινος αἰτίας·", "seq": 2269}
{"id": "Elias_Passim_2270", "series": "CAG", "text": "ἀλλ᾿ εἰ μὲν ὑφ᾿ ἑαυτῶν, ἔχουσί τι κοινὸν τὸ συνάπτον αὐτὰς κἀκεῖνο ἡ ἀρχή, εἰ δὲ ὑπ᾿ ἔξωθέν τινος αἰτίας, πάλιν ἢ μιᾶς ἢ πλειόνων.", "seq": 2270}
{"id": "Elias_Passim_2271", "series": "CAG", "text": "καὶ εἰ μὲν μιᾶς, ἐντεῦθεν μία ἐστὶν ἡ ἀρχή, εἰ δὲ πλειόνων, ἢ τεταγμένων ἢ ἀτάκτων.", "seq": 2271}
{"id": "Elias_Passim_2272", "series": "CAG", "text": "οὐ παύσομαι τὰ αὐτὰ πολλάκις ἀνακυκλῶν καὶ ἐφ᾿ ἀπείρῳ, τοῦ ἀπείρου δὲ μὴ ὄντος, μία ἄρα τοῦ παντὸς ἡ ἀρχή.", "seq": 2272}
{"id": "Elias_Passim_2273", "series": "CAG", "text": "ἢ καὶ ἄλλως·", "seq": 2273}
{"id": "Elias_Passim_2274", "series": "CAG", "text": "ὅτι ἡ ἀρχὴ ἢ μία ἢ πολλαί.", "seq": 2274}
{"id": "Elias_Passim_2275", "series": "CAG", "text": "καὶ εἰ μὲν πολλαί, ἢ τὰ αὐτὰ παράγουσιν ἢ ἕτερα.", "seq": 2275}
{"id": "Elias_Passim_2276", "series": "CAG", "text": "καὶ εἰ μὲν τὰ αὐτά, περίεργος ἡ μία τῆς ἄλλης πάντα παραγούσης καὶ περιττὴ ἡ μία, εἰ δὲ ἕτερα, ἀτελὴς ἑκατέρα·", "seq": 2276}
{"id": "Elias_Passim_2277", "series": "CAG", "text": "λείπει γὰρ τῇδε τὰ παραγόμενα ὑπὸ τῆσδε.", "seq": 2277}
{"id": "Elias_Passim_2278", "series": "CAG", "text": "οὐδὲν δὲ τὸ θεῖον ἀτελὲς οὐδέποτε·", "seq": 2278}
{"id": "Elias_Passim_2279", "series": "CAG", "text": "μία ἄρα τοῦ παντὸς ἀρχή.", "seq": 2279}
{"id": "Elias_Passim_2280", "series": "CAG", "text": "καὶ ταύτην βούλεται ποιητικὴν εἶναι οὐρανίων καὶ τῶν ὑπὸ τὴν σελήνην·", "seq": 2280}
{"id": "Elias_Passim_2281", "series": "CAG", "text": "εἰ γὰρ καὶ ἅμα θεὸς ἅμα κόσμος, ἀλλ᾿ οὖν κατ᾿ αἰτίαν προϋπάρχει ὁ θεὸς τοῦ κόσμου, καὶ οὐκ ἐν τοῦ αὐτομάτου ὁ κόσμος ἀλλὰ τὸν θεὸν ἔχει αἴτιον, ὥσπερ καὶ ὁ ἥλιος τοῦ οἰκείου φωτὸς προϋπάρχει κατ᾿ αἰτίαν.", "seq": 2281}
{"id": "Elias_Passim_2282", "series": "CAG", "text": "εἰ δέ τις ἐρεῖ ὅτι πολλαὶ ἀρχαὶ κατὰ Ἀριστοτέλην (ὅσα γὰρ τὰ κύκλῳ κινούμενα, τοσαῦτα καὶ ἀκίνητα·", "seq": 2282}
{"id": "Elias_Passim_2283", "series": "CAG", "text": "λέγει γὰρ ταῖς ἑπτὰ σφαίραις ἑπτὰ νοῦς ἐφεστάναι καὶ κινεῖν, αὐτοὺς δὲ ἀκινήτους εἶναι), ἀλλὰ καὶ οὕτως μία ἀρχή·", "seq": 2283}
{"id": "Elias_Passim_2284", "series": "CAG", "text": "ἐξηρτημένοι γάρ εἰσι πάντες οἱ ὑποβεβηκότες νόες τοῦ ἑνὸς τοῦ κινοῦντος τὴν ἀπλανῆ.", "seq": 2284}
{"id": "Elias_Passim_2285", "series": "CAG", "text": "εἰ δὲ ἐρεῖς ‘καὶ διὰ τί τὸν νοῦν λέγει τὴν πρωτίστην ἀρχὴν καὶ μὴ τὸ ἀγαθόν, ὡς ὁ Πλάτων;’", "seq": 2285}
{"id": "Elias_Passim_2286", "series": "CAG", "text": ", ἐπίστασο ὅτι καὶ μετὰ τὰ φυσιολογικὰ θεολογῶν εὐθὺς ἐν τῇ Μετὰ τὰ φυσικὰ πραγματείᾳ εὐλόγως τὸν νοῦν φυσικωτέραν ἀρχὴν εἶπεν, ἐπεὶ οἶδε καὶ αὐτὸς τὸ ἀγαθὸν τὴν μίαν τοῦ ὄντος ἀρχήν, ὡς δηλοῖ τὸ προοίμιον τῆς Ἠθικῆς αὐτοῦ πραγματείας ἔχον οὕτως ‘πᾶσα τέχνη καὶ πᾶσα μέθοδος ἔτι δὲ πρᾶξίς τε καὶ προαίρεσις ἀγαθοῦ τινος ἐφίεσθαι δοκεῖ.’", "seq": 2286}
{"id": "Elias_Passim_2287", "series": "CAG", "text": "διὸ καὶ καλῶς ἀπεφήναντο τὸ ἀγαθόν, οὗ πάντα ἐφίεται.", "seq": 2287}
{"id": "Elias_Passim_2288", "series": "CAG", "text": "ἰστέον δὲ ὅτι ἀεὶ θεολογῶν ὁ Ἀριστοτέλης φυσιολογεῖ (εἰ γὰρ καὶ περὶ κινούμενα ἡ φυσιολογία περὶ δὲ ἀκίνητα ἡ θεολογία, ἀλλ᾿ οὖν τὰ ἀκίνητα, φημί, τῶν διὰ κινήσεώς εἰσιν αἴτια), ὥσπερ ἀνάπαλιν ὁ Πλάτων ἀεὶ φυσιολογῶν θεολογεῖ, πανταχοῦ παρεγκυκλῶν τὸ δόγμα τῶν ἰδεῶν.", "seq": 2288}
{"id": "Elias_Passim_2289", "series": "CAG", "text": "ἐν οἷς καὶ τὸ τέταρτον κεφάλαιον.", "seq": 2289}
{"id": "Elias_Passim_2290", "series": "CAG", "text": "Πέμπτον δὲ κεφάλαιον ἦν, ἐν ᾧ ἐζητοῦμεν τίνες αἱ μεταξὺ ὁδοί.", "seq": 2290}
{"id": "Elias_Passim_2291", "series": "CAG", "text": "δεῖ δὲ εἰδέναι ὅτι πέντε εἰσὶ βαθμοὶ τῆς φιλοσοφίας, λογικὴ ἠθικὴ φυσικὴ μαθηματικὴ θεολογία.", "seq": 2291}
{"id": "Elias_Passim_2292", "series": "CAG", "text": "ἄκρα μὲν ἐν τούτοις δύο, λογικὴ καὶ θεολογία, μέσα δὲ τὰ λοιπά.", "seq": 2292}
{"id": "Elias_Passim_2293", "series": "CAG", "text": "καὶ τούτων τὰ μὲν περιρραντηρίοις καὶ θειώσεσιν ἔοικε, τὰ δὲ προτελείοις καὶ αὐταῖς ταῖς μυήσεσι·", "seq": 2293}
{"id": "Elias_Passim_2294", "series": "CAG", "text": "περιρραντηρίοις μὲν γὰρ καὶ θειώσεσιν ἔοικεν ἡ ἠθικὴ ἀποκαθαίρουσα τὴν ψυχὴν τῶν μοχθηρῶν δογμάτων, ἵνα τεταγμένη οὖσα καθαρὰ ᾖ καὶ καθαρᾷ προσομιλήσῃ τῇ φιλοσοφίᾳ (ἡ γὰρ τάξις πρὸς τῷ ἑνί, ἡ δὲ ἀταξία πρὸς τῷ πλήθει), προτελείοις δὲ ἔοικεν ἡ φυσική·", "seq": 2294}
{"id": "Elias_Passim_2295", "series": "CAG", "text": "εἰ γὰρ καὶ ἀκίνητα ζητοῦμεν ἐν τῇ θεολογίᾳ κινούμενα δὲ ἐν τῇ φυσιολογίᾳ, ἀλλ᾿ οὖν κινήσεως αἴτια τὰ θεῖα καὶ ἐκ τῶν κινουμένων εἰς ἔννοιαν ἐρχόμεθα τῶν νοητῶν·", "seq": 2295}
