{"id": "Elias_Passim_4997", "series": "CAG", "text": "12a26 Στέρησις δὲ καὶ ἕξις λέγεται μέν τι περὶ τῶν αὐτῶν.", "seq": 4997}
{"id": "Elias_Passim_4998", "series": "CAG", "text": "Ἐπειδὴ πρὸς τὴν διάκρισιν τῶν ἐναντίων ἀπὸ ἕξεως καὶ στερήσεως ἐδεήθη τῆς διαιρέσεως τῶν ἐναντίων καὶ τοῦ ὁρισμοῦ τῆς στερήσεως, ὧν τὸ πρῶτον ἡ φθάσασα ἐδίδαξε θεωρία, τὴν διαίρεσιν τῶν ἐναντίων, φέρε εἴπωμεν καὶ τὸν ὁρισμὸν τῆς στερήσεως.", "seq": 4998}
{"id": "Elias_Passim_4999", "series": "CAG", "text": "ἀλλ᾿ ἵνα τοῦτο γνῶμεν, λήμματά τινα προλάβωμεν.", "seq": 4999}
{"id": "Elias_Passim_5000", "series": "CAG", "text": "ἰστέον ὅτι ἵνα γένηται ἡ στέρησις, τεσσάρων χρεία εἰς συνδρομήν, οἷον ἀπουσίας εἴδους (εἰ μὴ γὰρ ἀπῇ ἡ ὄψις, τυφλότης οὐ γίνεται), καὶ φύσεως δεκτικῆς χρεία (ἐπεὶ ἂν ᾖ λίθος, στέρησιν ὄψεως οὐχ ὑπομένει), καὶ μορίου ἐπιτηδείου (οὐ λέγεται γὰρ ὁ ἄνθρωπος τυφλός, διότι τῇ χειρὶ οὐχ ὁρᾷ, ἐπειδὴ οὐδὲ πέφυκε τῇ χειρὶ ὁρᾶν), ἀλλὰ καὶ χρόνου ἐπιτηδείου·", "seq": 5000}
{"id": "Elias_Passim_5001", "series": "CAG", "text": "τὸ γὰρ νεογνὸν παιδίον οὐ λέγεται νωδόν, ἐπεὶ μὴ ἔχει ὀδόντας, οὐδὲ τὸ ἀρτιγενὲς σκυλάκιον λέγεται τυφλόν, ἐπεὶ μὴ ὁρᾷ·", "seq": 5001}
{"id": "Elias_Passim_5002", "series": "CAG", "text": "οὐ γὰρ πέφυκεν ὁρᾶν ἐν τῷ χρόνῳ ἐκείνῳ.", "seq": 5002}
{"id": "Elias_Passim_5003", "series": "CAG", "text": "αὕτη δὲ ἡ στέρησις τοῦ δυνάμει ἐστί, διὸ οὐδὲ ἐπανακάμπτει ποτέ·", "seq": 5003}
{"id": "Elias_Passim_5004", "series": "CAG", "text": "εἰ γὰρ μὴ ἦν τοῦ δυνάμει ἡ στέρησις, πάντως ἂν ἤγετο εἰς τὸ ἐνεργείᾳ.", "seq": 5004}
{"id": "Elias_Passim_5005", "series": "CAG", "text": "τούτων οὕτως προληφθέντων πρόεισιν <ὁ> ὁρισμὸς τῆς στερήσεως οὕτως·", "seq": 5005}
{"id": "Elias_Passim_5006", "series": "CAG", "text": "στέρησίς ἐστιν ἀπουσία εἴδους φύσεως δεκτικῆς ἐν τῷ πεφυκότι δέχεσθαι καθ᾿ ὃν πέφυκε δέχεσθαι χρόνον.", "seq": 5006}
{"id": "Elias_Passim_5007", "series": "CAG", "text": "οὗτος ὁ ὁρισμός.", "seq": 5007}
{"id": "Elias_Passim_5008", "series": "CAG", "text": "ἰστέον δὲ ὅτι τινὰ καὶ τὸ ὄνομα καὶ τὸ πρᾶγμα στερητικὸν ἔχει, ὥσπερ τὸ ἀναίσθητος ἐπὶ τοῦ ἀποπλήκτου, τινὰ δὲ τὸ ὄνομα στερητικὸν ἔχει, οὐ μὴν τὸ πρᾶγμα, ὡς τὸ ἀθάνατον καὶ ἀσώματον καὶ ἄλογον, τινὰ δὲ τὸ πρᾶγμα στερητικὸν ἔχει, οὐ μὴν τὸ ὄνομα, ὡς τὸ τυφλότης.", "seq": 5008}
{"id": "Elias_Passim_5009", "series": "CAG", "text": "ἀλλ᾿ αὕτη μὲν ἡ ἐν Κατηγορίαις στέρησις.", "seq": 5009}
{"id": "Elias_Passim_5010", "series": "CAG", "text": "οἶδε δὲ καὶ ἄλλας στερήσεις ὁ Ἀριστοτέλης ἐν ταῖς Φυσικαῖς αὑτοῦ πραγματείαις, τὴν στέρησιν τῆς ἐνεργείας, ὡς ἐπὶ τοῦ καθεύδοντος γεωμέτρου·", "seq": 5010}
{"id": "Elias_Passim_5011", "series": "CAG", "text": "οὗτος γὰρ τῆς ἐνεργείας ἐστέρηται.", "seq": 5011}
{"id": "Elias_Passim_5012", "series": "CAG", "text": "καὶ τῆς ἕξεως τῆς τελείας λέγεται στέρησις, ὡς ἐπὶ τοῦ παιδίου τοῦ ἄρτι εἰς γραμματικοῦ φοιτήσαντος·", "seq": 5012}
{"id": "Elias_Passim_5013", "series": "CAG", "text": "τῆς γὰρ τελείας <ἕξεως> τοῦτο ἐστέρηται.", "seq": 5013}
{"id": "Elias_Passim_5014", "series": "CAG", "text": "λέγεται στέρησις καὶ τῆς ὀρθότητος, ὡς ἄφωνον λέγομεν τὸν κακόφωνον·", "seq": 5014}
{"id": "Elias_Passim_5015", "series": "CAG", "text": "οὗτος γὰρ τῆς ὀρθότητος ἐστέρηται τῆς φωνῆς.", "seq": 5015}
{"id": "Elias_Passim_5016", "series": "CAG", "text": "λέγεται στέρησις καὶ τοῦ μεγέθους, καθὸ λέγομεν ἀτράχηλον ζῷον καὶ ἀγίγαρτον ῥοιάν, ἐπειδὴ ποὺ μὲν ὁ τράχηλος βραχὺς ποὺ δὲ τὸ γίγαρτον μικρόν.", "seq": 5016}
{"id": "Elias_Passim_5017", "series": "CAG", "text": "αὗται δὲ αἱ στερήσεις οὔκ εἰσι τοῦ δυνάμει, ἀλλὰ τοῦ ἐνεργείᾳ, μόναι δὲ αἱ τῆς ὀρθότητος καὶ τοῦ μεγέθους·", "seq": 5017}
{"id": "Elias_Passim_5018", "series": "CAG", "text": "διὸ καὶ ἄγονται εἰς τὸ ἐνεργείᾳ.", "seq": 5018}
{"id": "Elias_Passim_5019", "series": "CAG", "text": "Δεῖ δὲ εἰδέναι ὅτι ἄλλο πρός τι καὶ ἄλλο τὰ ὑπὸ τὰ πρός τι (πρός τι αὐτὴ ἡ κατηγορία, ὑπὸ ταύτην δὲ πατὴρ καὶ υἱός), ἄλλο ἕξις καὶ [ἄλλο] στέρησις καὶ ἄλλο τὸ ἔχον ἕξιν ἢ στέρησιν (ἕξιν γὰρ λέγεται ἔχειν ὁ ἄνθρωπος, οἷον τὴν ὅρασιν, ὅρασις δὲ οὐ λέγεται οὐδὲ ἕξις·", "seq": 5019}
{"id": "Elias_Passim_5020", "series": "CAG", "text": "ταὐτὰ καὶ ἐπὶ τυφλότητος καὶ στερήσεως), πάλιν ἄλλα ἐναντία καὶ ἄλλα τὰ ὑπὸ ἐναντία (ἐναντία λευκὸν καὶ μέλαν, ὑπὸ ταῦτα κύκνος, κόραξ, καὶ οὐ λέγεται ὁ κύκνος λευκότης οὐδὲ ὁ κόραξ μελανία), ἄλλο ἀπόφασις καὶ [ἄλλο] κατάφασις καὶ καὶ ἄλλα <τὰ> ὑπὸ ταύτας·", "seq": 5020}
{"id": "Elias_Passim_5021", "series": "CAG", "text": "ἡ μὲν γὰρ κατάφασις καὶ ἀπόφασις ὡς λόγοι εἰσί, τὰ δὲ ὑπ᾿ αὐτὰς πράγματα·", "seq": 5021}
{"id": "Elias_Passim_5022", "series": "CAG", "text": "‘Σωκράτης οὐ κάθηται—Σωκράτης κάθηται’ ἀπόφασις καὶ κατάφασις, ὑπὸ δὲ ταύτας <τὸ> καθῆσθαι Σωκράτην ἢ μὴ καθῆσθαι.", "seq": 5022}
{"id": "Elias_Passim_5023", "series": "CAG", "text": "οὐ ταὐτὸν δὲ ταῦτα, ἐπειδὴ οὐ πάντως ἐν τῷ λέγειν ὅτι Σωκράτης κάθηται ἤδη κατ᾿ ἀλήθειαν κάθηται (ἔστι γὰρ ὅτε ἵσταται), κἂν εἴπω ὅτι οὐ κάθηται, τί κωλύει τὸ καθῆσθαι αὐτόν;", "seq": 5023}
{"id": "Elias_Passim_5024", "series": "CAG", "text": "οὐκ ἐξ ἀνάγκης οὖν οἱ λόγοι πάντως συμφθέγγονται τοῖς πράγμασι.", "seq": 5024}
{"id": "Elias_Passim_5025", "series": "CAG", "text": "πλὴν εἰ καὶ τοσοῦτον ταῦτα διαφέρουσιν ἀλλήλων, ἀλλ᾿ οὖν ὁ τρόπος τῆς ἀντιθέσεως ὁ αὐτός·", "seq": 5025}
{"id": "Elias_Passim_5026", "series": "CAG", "text": "ὡς γὰρ ἀντίκεινται ἕξις καὶ στέρησις, οὕτω καὶ τὰ ἔχοντα τὴν ἕξιν καὶ στέρησιν, καὶ ὡς ἀντίκεινται τὰ ἐναντία, οὕτω καὶ τὰ ὑπ᾿ αὐτά, καὶ ὡς ἀντίκεινται ἀπόφασις καὶ κατάφασις, οὕτω καὶ τὰ ὑπ᾿ αὐτά.", "seq": 5026}
{"id": "Elias_Passim_5027", "series": "CAG", "text": "ἐπὶ δὲ τῶν πρός τι τὰ μετέχοντα ἀντίκεινται ἀλλήλοις, οὐ μὴν ἐπὶ τοῦ πρός τι, αὐτῆς τῆς κατηγορίας, ἔστιν ἀντίθεσις·", "seq": 5027}
{"id": "Elias_Passim_5028", "series": "CAG", "text": "ἡ γὰρ σχέσις μία, αὐτὴ ἡ κατηγορία.", "seq": 5028}
{"id": "Elias_Passim_5029", "series": "CAG", "text": "12b16 Ὅτι δὲ ἡ στέρησις καὶ ἡ ἕξις οὐκ ἀντίκεινται ὡς τὰ πρός τι.", "seq": 5029}
{"id": "Elias_Passim_5030", "series": "CAG", "text": "Μετὰ τὸν ὁρισμὸν τῆς στερήσεως ὀφείλων εἰπεῖν τὴν διαίρεσιν τῶν ἐναντίων ἀπὸ ἕξεως καὶ στερήσεως, δι᾿ ἣν καὶ προελήφθη ὁ ὁρισμὸς τῆς στερήσεως, οὐ τοῦτο ποιεῖ, ἀλλ᾿ αὐτὰ τὰ πρός τι διακρίνει, ἐπειδὴ καὶ ἐπὶ τούτων τὴν αὐτὴν εὑρίσκει διάκρισιν.", "seq": 5030}
{"id": "Elias_Passim_5031", "series": "CAG", "text": "ἔχει δὲ ἡ διάκρισις οὕτως·", "seq": 5031}
{"id": "Elias_Passim_5032", "series": "CAG", "text": "τὰ πρός τι αὐτὰ ἅπερ εἰσὶν ἑτέρων εἶναι λέγονται, ἕξις δὲ καὶ στέρησις αὐτὰ ἅπερ εἰσὶν ἑτέρων οὐδέποτε λέγονται·", "seq": 5032}
{"id": "Elias_Passim_5033", "series": "CAG", "text": "οὐδὲ γὰρ λέγεται ἡ τυφλότης ὄψεως τυφλότης.", "seq": 5033}
{"id": "Elias_Passim_5034", "series": "CAG", "text": "εἰ δέ τις ἐρεῖ ὅτι ναί, λέγεται ὄψεως τυφλότης, λύομεν τοῦτο καὶ κατ᾿ ἔνστασιν καὶ κατὰ ἀντιπαράστασιν.", "seq": 5034}
{"id": "Elias_Passim_5035", "series": "CAG", "text": "κατὰ μὲν ἔνστασιν οὕτως·", "seq": 5035}
{"id": "Elias_Passim_5036", "series": "CAG", "text": "οὐ λέγεται ἡ τυφλότης ὄψεως τυφλότης, ἀλλ᾿ ὄψεως στέρησις·", "seq": 5036}
{"id": "Elias_Passim_5037", "series": "CAG", "text": "οὐδὲ γὰρ αὐτὴ ἡ ὄψις τυφλότης ἐγένετο·", "seq": 5037}
{"id": "Elias_Passim_5038", "series": "CAG", "text": "καθόλου γὰρ αἱ στερήσεις οὐ πρὸς τὰς ὄψεις ἤγουν ἕξεις λέγονται, ἀλλὰ πρὸς τὰ ὑποκείμενα μόρια·", "seq": 5038}
{"id": "Elias_Passim_5039", "series": "CAG", "text": "οὐ λέγεται ἡ χωλότης πήρωσις ὀρθότητος σκελῶν, ἀλλὰ πήρωσις σκελῶν, καὶ τὸ σκότος οὐ φωτὸς σκότος, ἀλλ᾿ ἀέρος σκότος.", "seq": 5039}
{"id": "Elias_Passim_5040", "series": "CAG", "text": "οὕτω καὶ τυφλότης οὐκ ὄψεως τυφλότης, ἀλλ᾿ ὄψεως στέρησις λέγεται διὰ τὴν πρὸς τὸ γένος ἀναφοράν.", "seq": 5040}
{"id": "Elias_Passim_5041", "series": "CAG", "text": "οὕτω μὲν κατ᾿ ἔνστασιν.", "seq": 5041}
{"id": "Elias_Passim_5042", "series": "CAG", "text": "ἀλλὰ καὶ κατὰ ἀντιπαράστασιν οὕτως ἔχει·", "seq": 5042}
{"id": "Elias_Passim_5043", "series": "CAG", "text": "εἰ καὶ συγχωρήσομεν ὅτι λέγεται ὄψεως τυφλότης, οὐ δήπου καὶ ἀντιστρέφει·", "seq": 5043}
{"id": "Elias_Passim_5044", "series": "CAG", "text": "οὐδὲ γὰρ λέγει τις τὴν ὄψιν τυφλότητος ὄψιν, ἐπεὶ μὴ προϋπάρχει τυφλότης ὄψεως.", "seq": 5044}
{"id": "Elias_Passim_5045", "series": "CAG", "text": "ἀλλὰ ναί, φασί, προϋπάρχει, ὡς ἐπὶ τῶν ἐκ γενετῆς τυφλῶν.", "seq": 5045}
{"id": "Elias_Passim_5046", "series": "CAG", "text": "ἀλλὰ ψεῦδος·", "seq": 5046}
{"id": "Elias_Passim_5047", "series": "CAG", "text": "καὶ ἐπὶ τούτων γὰρ προηγεῖται ἡ ὄψις, ὅσον ἐπὶ τὸ πεφυκέναι.", "seq": 5047}
{"id": "Elias_Passim_5048", "series": "CAG", "text": "πάλιν ἐνίστανταί τινες ὅτι εἰ λέγεται ἡ τυφλότης ὄψεως στέρησις, καὶ ὄψεως τυφλότης λεχθήσεται·", "seq": 5048}
{"id": "Elias_Passim_5049", "series": "CAG", "text": "καθόλου γὰρ ἐὰν γένος τινὸς κατηγορῆται ἔχον καὶ ἄλλα εἴδη, ἀνάγκη ἓν τῶν εἰδῶν ἐκείνων κατηγορεῖσθαι τοῦ πράγματος ἐκείνου·", "seq": 5049}
{"id": "Elias_Passim_5050", "series": "CAG", "text": "τὸ ζῷον κατηγορεῖται ἀνθρώπου εἴδη ἔχον τὸ λογικὸν καὶ τὸ ἄλογον·", "seq": 5050}
{"id": "Elias_Passim_5051", "series": "CAG", "text": "ἀνάγκη καὶ τὸ λογικὸν κατηγορεῖσθαι τοῦ ἀνθρώπου.", "seq": 5051}
{"id": "Elias_Passim_5052", "series": "CAG", "text": "ὁ Φιλόπονος τούτου ἐπιλαμβάνεται λέγων ὅτι οὐ καλῶς εἶπεν εἴδη στερήσεως·", "seq": 5052}
{"id": "Elias_Passim_5053", "series": "CAG", "text": "τοῦ γὰρ μὴ ὄντος οὐκ εἰσὶν εἴδη.", "seq": 5053}
{"id": "Elias_Passim_5054", "series": "CAG", "text": "ψευδὴς δὲ ὁ λόγος, ἐπειδὴ μηδαμῇ μηδαμῶς ἀνέλαβε τὴν στέρησιν, ὅπερ ἄτοπον·", "seq": 5054}
{"id": "Elias_Passim_5055", "series": "CAG", "text": "αὕτη γὰρ ἡ στέρησις οὐκ ἔστι πάντῃ μὴ ὄν, ἀλλ᾿ ἀμυδρὸν εἶδος ἔχει.", "seq": 5055}
{"id": "Elias_Passim_5056", "series": "CAG", "text": "διὸ καὶ ἐν ἀρχαῖς ὑπὸ Ἀριστοτέλους τάττεται·", "seq": 5056}
{"id": "Elias_Passim_5057", "series": "CAG", "text": "τὸ δὲ πάντῃ μὴ ὂν ἀρχὴ πῶς ἂν εἴη;", "seq": 5057}
{"id": "Elias_Passim_5058", "series": "CAG", "text": "ἔστι δὲ καὶ ἄλλως διακρῖναι τὰ πρός τι ἀπὸ ἕξεως καὶ στερήσεως, διότι τὰ μὲν πρός τι συναναιρεῖ ἄλληλα, ἕξις δὲ καὶ στέρησις οὐχ οὕτως, καὶ ὅτι τὰ μὲν πρός τι ἅμα ἄπεστι καὶ ἅμα πάρεστιν, ἕξις δὲ καὶ στέρησις οὐδὲ ἅμα πάρεστιν οὐδὲ ἅμα ἄπεστιν.", "seq": 5058}
{"id": "Elias_Passim_5059", "series": "CAG", "text": "12b26 Οὐδὲ ὡς τὰ ἐναντία ἀντίκεινται τὰ κατὰ στέρησιν καὶ ἕξιν.", "seq": 5059}
{"id": "Elias_Passim_5060", "series": "CAG", "text": "Διακρίνας ὁ Ἀριστοτέλης τὰ πρός τι ἀπὸ τῶν ἐναντίων καὶ ἕξεως καὶ στερήσεως, ὀφείλων τὰ αὐτὰ πρός τι διακρῖναι καὶ ἀπὸ τῆς ἀντιφάσεως, ἵνα πληρωθεισῶν τῶν σχέσεων τῶν πρός τι πρὸς τὰ μετὰ ταῦτα ἑτέραν ἀρχὴν προστησάμενος κατὰ δίαυλον εἴπῃ τὴν διάκρισιν τῶν ἐναντίων ἀπὸ πάντων τῶν μετὰ ταῦτα, οὐ τοῦτο ποιεῖ, ἀλλὰ διακρίνει πρῶτον τὰ ἐναντία ἀπὸ ἕξεως καὶ στερήσεως.", "seq": 5060}
{"id": "Elias_Passim_5061", "series": "CAG", "text": "τοῦτο δὲ ποιεῖ, ἐπειδὴ κοινῶν εὐπορήσει λόγων διακρινόντων τὴν ἀντίφασιν ἀπὸ πάντων τῶν μετ᾿ αὐτήν.", "seq": 5061}
{"id": "Elias_Passim_5062", "series": "CAG", "text": "ἔχει δὲ ἡ διάκρισις τῶν ἐναντίων ἀπὸ ἕξεως καὶ στερήσεως οὕτως·", "seq": 5062}
{"id": "Elias_Passim_5063", "series": "CAG", "text": "τριττῶν ὄντων τῶν ἐναντίων, ἀμέσων, ἐμμέσων, καὶ ἐμμέσων ἢ ἀπεῖναι δυναμένων ἀμφοτέρων τοῦ ὑποκειμένου, ὡς ἐπὶ λευκοῦ καὶ μέλανος, ἢ μὴ δυναμένων ἄμφω ἀπεῖναι τοῦ ὑποκειμένου διὰ τὸ ἀφωρισμένως τὸ ἕτερον ὑπάρχειν τῷ ὑποκειμένῳ, τῶν τριῶν εἰδῶν τῶν ἐναντίων διακρίνει ἕξιν καὶ στέρησιν·", "seq": 5063}
{"id": "Elias_Passim_5064", "series": "CAG", "text": "τῶν γὰρ ἀμέσων ἐναντίων ἀνάγκη θατέρου μετέχειν τὸ ὑποκείμενον ζῷον (ἢ γὰρ ὑγιαίνει ὁ ἄνθρωπος ἢ νοσεῖ, καὶ ὁ ἀριθμὸς ἢ ἄρτιος ἢ περιττός), ἕξις δὲ καὶ στέρησις τοῦτο οὐκ ἔχει·", "seq": 5064}
{"id": "Elias_Passim_5065", "series": "CAG", "text": "τὸ γὰρ νεογνὸν παιδίον οὔτε νωδὸν λέγεται οὔτε ὀδόντας ἔχειν, καὶ τὸ ἀρτιγενὲς σκυλάκιον οὔτε ὄψιν ἔχειν λέγεται οὔτε τυφλότητα.", "seq": 5065}
{"id": "Elias_Passim_5066", "series": "CAG", "text": "οὕτως μὲν τῶν ἀμέσων ἐναντίων ταῦτα διαφέρει.", "seq": 5066}
{"id": "Elias_Passim_5067", "series": "CAG", "text": "τῶν δὲ ἐμμέσων ἀμφοτέρων δυναμένων ἀπεῖναι, ὅτι ἐκεῖνα ἄμφω μὲν ἀπεῖναι δύνανται, ἕξις δὲ καὶ στέρησις ἅμα ἀπεῖναι οὐ δύνανται·", "seq": 5067}
{"id": "Elias_Passim_5068", "series": "CAG", "text": "τοῦ γὰρ χρόνου ὄντος ἐπιτηδείου πάντως θάτερον ὑπάρχει τῷ ζῴῳ.", "seq": 5068}
{"id": "Elias_Passim_5069", "series": "CAG", "text": "τῶν δὲ ἐμμέσων ἐναντίων, ἐφ᾿ ὧν τὸ ἕτερον πάντως ὑπάρχει τῷ ζῴῳ, διαφέρει ἕξις καὶ στέρησις, διότι ἐκεῖ ἀφωρισμένως τὸ ἕτερον ὑπάρχει τῷ ὑποκειμένῳ, οἷον τὸ λευκὸν τῇ χιόνι καὶ τὸ μέλαν τῷ κόρακι, ἐπὶ δὲ ἕξεως καὶ στερήσεως οὐχ οὕτως·", "seq": 5069}
{"id": "Elias_Passim_5070", "series": "CAG", "text": "οὐ γὰρ ἀφωρισμένως ὁ δεῖνα ἄνθρωπος τυφλότητα ἔχει ἢ ὄψιν, ἀλλ᾿ ὡς ἔτυχεν.", "seq": 5070}
