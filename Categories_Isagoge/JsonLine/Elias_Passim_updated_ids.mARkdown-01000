{"id": "Elias_Passim_3844", "series": "CAG", "text": "διὸ καὶ ἀποροῦσιν ὅτι διὰ τί μὴ διεῖλε τὸ ποσὸν εἰς τεταγμένον καὶ ἄτακτον.", "seq": 3844}
{"id": "Elias_Passim_3845", "series": "CAG", "text": "καὶ λέγομεν ὅτι ἡ τάξις δι᾿ ὅλων τῶν εἰδῶν τοῦ ποσοῦ διῆλθε, συνεχῶν τε καὶ διωρισμένων·", "seq": 3845}
{"id": "Elias_Passim_3846", "series": "CAG", "text": "ἐπὶ πάντων γὰρ ἁρμόζει λέγειν τὸ πρῶτον καὶ τὸ δεύτερον.", "seq": 3846}
{"id": "Elias_Passim_3847", "series": "CAG", "text": "εἰ οὖν τάξις ἐστὶν ἐν πᾶσι, πῶς τὸ ἔχον τάξιν εἰς τεταγμένον καὶ ἄτακτον εἶχε διαιρεῖσθαι;", "seq": 3847}
{"id": "Elias_Passim_3848", "series": "CAG", "text": "καὶ ταῦτα μὲν ἐν τούτοις.", "seq": 3848}
{"id": "Elias_Passim_3849", "series": "CAG", "text": "Ἐπιδιαιρεῖ δὲ τὸ ποσὸν καὶ ἄλλως λέγων ὅτι τοῦ ποσοῦ τὸ μέν ἐστι κυρίως ποσὸν τὸ δὲ φαινόμενον, καὶ κυρίως μὲν ποσὸν οὗ τὸ μέγα καὶ μικρὸν καὶ πολὺ καὶ ὀλίγον ἀμέσως κατηγορεῖται·", "seq": 3849}
{"id": "Elias_Passim_3850", "series": "CAG", "text": "τὸ γὰρ μέγα καὶ μικρὸν ἐπὶ πάντων λέγομεν τῶν συνεχῶν, μεγάλην γραμμὴν καὶ μικρὰν ἐπιφάνειαν καὶ σῶμα καὶ τόπον λέγοντες κυρίως, πολὺ δὲ καὶ ὀλίγον ἐπὶ ἀριθμοῦ καὶ λόγου καὶ χρόνου κυρίως λέγεται.", "seq": 3850}
{"id": "Elias_Passim_3851", "series": "CAG", "text": "ταῦτα μὲν κυρίως ποσά.", "seq": 3851}
{"id": "Elias_Passim_3852", "series": "CAG", "text": "<φαινόμενα δὲ ποσὰ> ὧν τὸ μέγα καὶ μικρὸν καὶ πολὺ καὶ ὀλίγον οὐκ ἀμέσως ἀλλὰ διὰ μέσου ἑνὸς τῶν ἑπτὰ εἰδῶν τοῦ ποσοῦ κατηγορεῖται, οἷον πολλὴν λέγομεν λευκότητα διὰ μέσου τῆς ἐπιφανείας·", "seq": 3852}
{"id": "Elias_Passim_3853", "series": "CAG", "text": "πολὺ γὰρ τὸ λευκὸν οὐ δι᾿ ἑαυτὸ ἀλλὰ διὰ τὴν ἐπιφάνειαν·", "seq": 3853}
{"id": "Elias_Passim_3854", "series": "CAG", "text": "εἰ γὰρ τὴν ἐπίτασιν τοῦ λευκοῦ ὡς λευκοῦ θέλομεν σημᾶναι, οὐ λέγομεν πολὺ λευκὸν ἀλλὰ λευκῶν λευκὸν ἢ λευκότατον.", "seq": 3854}
{"id": "Elias_Passim_3855", "series": "CAG", "text": "καὶ τὸν πόλεμον τὸν Τρωϊκὸν μέγαν λέγομεν οὐ δι᾿ ἑαυτὸν ἀλλὰ διὰ τὸν χρόνον·", "seq": 3855}
{"id": "Elias_Passim_3856", "series": "CAG", "text": "καὶ τὴν πρᾶξιν μικρὰν λέγομεν διὰ τὸν χρόνον, οὐ δι᾿ ἑαυτήν·", "seq": 3856}
{"id": "Elias_Passim_3857", "series": "CAG", "text": "ἢ γὰρ ἡμερησία ἢ μηνιαία ἢ ἐνιαυσιαία.", "seq": 3857}
{"id": "Elias_Passim_3858", "series": "CAG", "text": "ταῦτα ἔχει ἡ παροῦσα θεωρία.", "seq": 3858}
{"id": "Elias_Passim_3859", "series": "CAG", "text": "5a32 Καὶ οὕτως τάξιν μὲν ἄν τινα, θέσιν δὲ οὐ πάνυ λάβοις.", "seq": 3859}
{"id": "Elias_Passim_3860", "series": "CAG", "text": "Ἐπειδὴ ᾔσθετο ὁ Ἀριστοτέλης ὅτι ἐπὶ τοῦ φυσικοῦ ἀριθμοῦ τοῦ ἀριθμουμένου, οἷον ἵππων δέκα ἢ ἀνθρώπων ἢ ξύλων ἢ λίθων, ὅτι ἔστι θέσιν λαβεῖν καὶ δεῖξαι ποῦ κεῖται, διὰ τοῦτο ἐκόλασεν αὐτὸ εἰπὼν ὅτι θέσιν ἐπὶ τούτου οὐ πάνυ λάβοις ἄν.", "seq": 3860}
{"id": "Elias_Passim_3861", "series": "CAG", "text": "5b11 Ἔτι ποσῷ οὐδέν ἐστιν ἐναντίον.", "seq": 3861}
{"id": "Elias_Passim_3862", "series": "CAG", "text": "Μετὰ τὰς τρεῖς διαιρέσεις τοῦ ποσοῦ, τὴν εἰς συνεχὲς καὶ διωρισμένον καὶ εἰς θετὸν καὶ ἄθετον καὶ κυρίως ποσὸν καὶ φαινόμενον ποσόν, μετάγει τὸν λόγον ἐπὶ τὰ ἴδια τοῦ ποσοῦ.", "seq": 3862}
{"id": "Elias_Passim_3863", "series": "CAG", "text": "καὶ ἤδη μὲν ἀνωτέρω ἓν ἴδιον ἡμῖν παρεδίδου τοῦ ποσοῦ, τὸ μετρεῖσθαι, ὅτε ἔλεγεν ὅτι ὁ λόγος καταμετρεῖται μακρᾷ καὶ βραχείᾳ συλλαβῇ καὶ διὰ τούτου ποσὸν ἐδείκνυτο ὁ λόγος ὡς παντὸς ποσοῦ μετρουμένου.", "seq": 3863}
{"id": "Elias_Passim_3864", "series": "CAG", "text": "ὅτι δὲ τοῦτο ἓν ἴδιον ἡμῖν παρέδωκε, δηλοῖ διὰ τοῦ ἔτι, λέγων ἔτι δὲ τῷ ποσῷ οὐδέν ἐστιν ἐναντίον, ὡς ἂν κατὰ τὸ σιωπώμενον ἑνὸς ἡμῖν ἰδίου τοῦ ποσοῦ παραδεδομένου.", "seq": 3864}
{"id": "Elias_Passim_3865", "series": "CAG", "text": "ἀλλ᾿ ἔχομεν, φασί τινες, καὶ τὸ δεύτερον ἴδιον παραδεδομένον ἀνωτέρω ἐν τῷ περὶ τῆς οὐσίας λόγῳ, ὅτε ἔλεγεν ὅτι ἴδιον τῆς οὐσίας τὸ μηδὲν ἔχειν ἐναντίον, τοῦτο δὲ πάσῃ μὲν τῇ οὐσίᾳ ὑπάρχει, οὐ μόνῃ δέ·", "seq": 3865}
{"id": "Elias_Passim_3866", "series": "CAG", "text": "ὑπάρχει γὰρ καὶ τῷ ποσῷ.", "seq": 3866}
{"id": "Elias_Passim_3867", "series": "CAG", "text": "καὶ λέγομεν ὅτι ἀμφέβαλλεν ἐκεῖ <εἰ> οὐδέν ἐστι τῷ ποσῷ ἐναντίον, λέγων ‘εἰ μή τις φαίη τὸ μέγα τῷ μικρῷ καὶ τὸ πολὺ τῷ ὀλίγῳ ἐναντίον’·", "seq": 3867}
{"id": "Elias_Passim_3868", "series": "CAG", "text": "ταῦτα γὰρ οὐκ ἐναντία.", "seq": 3868}
{"id": "Elias_Passim_3869", "series": "CAG", "text": "ὅτι δὲ οὐκ ἐναντία οὐδὲ ποσὰ ἀλλὰ τῶν πρός τι, δείκνυσι καὶ κατ᾿ ἔνστασιν καὶ κατὰ ἀντιπαράστασιν.", "seq": 3869}
{"id": "Elias_Passim_3870", "series": "CAG", "text": "καὶ κατὰ μὲν ἔνστασιν ὅτι οὐ ποσὰ ἀλλὰ τῶν πρός τι, κατὰ δὲ ἀντιπαράστασιν ὅτι οὐκ ἐναντία ἀλλὰ τῶν πρός τι, ὡς εἶναι κοινὸν καταγώγιον ἐνστάσεως καὶ ἀντιπαραστάσεως τὰ πρός τι·", "seq": 3870}
{"id": "Elias_Passim_3871", "series": "CAG", "text": "εἰ γὰρ δείξομεν ὅτι πρός τι, οὐ ποσά (ἀντιδιῄρηται γὰρ τὸ ποσὸν τοῖς πρός τι), καὶ εἰ δείξομεν πάλιν ὅτι πρός τι, οὐκ ἐναντία·", "seq": 3871}
{"id": "Elias_Passim_3872", "series": "CAG", "text": "τετραχῶς γὰρ τῶν ἀντικειμένων λαμβανομένων ἀντιδιῄρηται τὰ ἐναντία τοῖς πρός τι.", "seq": 3872}
{"id": "Elias_Passim_3873", "series": "CAG", "text": "Δεῖ εἰδέναι ὅτι δύο ἐπιχειρήμασι κέχρηται ἡ ἔνστασις, πρῶτον μὲν λέγουσα ὅτι μέγα καὶ μικρόν, πολὺ καὶ ὀλίγον πρὸς ἄλλο λέγονται, τὸ ποσὸν καθ᾿ αὑτό·", "seq": 3873}
{"id": "Elias_Passim_3874", "series": "CAG", "text": "τὸ ἄρα μέγα καὶ μικρὸν οὐ ποσά.", "seq": 3874}
{"id": "Elias_Passim_3875", "series": "CAG", "text": "δεύτερον δὲ ἐπιχείρημα, ὅτι τὸ μέγα καὶ τὸ μικρὸν καὶ πολὺ καὶ ὀλίγον ἀόριστα·", "seq": 3875}
{"id": "Elias_Passim_3876", "series": "CAG", "text": "μέχρι γὰρ πόσου μέγα καὶ μέχρι πόσου μικρόν, ἄδηλον εἰπεῖν·", "seq": 3876}
{"id": "Elias_Passim_3877", "series": "CAG", "text": "τὸ δὲ ποσὸν ὡρισμένον ποσὸν δηλοῖ·", "seq": 3877}
{"id": "Elias_Passim_3878", "series": "CAG", "text": "ὅταν γὰρ βουλώμεθα τὸν ἀριθμὸν μαθεῖν τῶν ζητουμένων, λέγομεν ὅτι πόσα εἰσί·", "seq": 3878}
{"id": "Elias_Passim_3879", "series": "CAG", "text": "τὸ ἄρα μικρὸν καὶ μέγα, τὸ πολὺ καὶ ὀλίγον οὔκ εἰσι ποσά.", "seq": 3879}
{"id": "Elias_Passim_3880", "series": "CAG", "text": "ταῦτα μὲν ἡ ἔνστασις.", "seq": 3880}
{"id": "Elias_Passim_3881", "series": "CAG", "text": "ἡ δὲ ἀντιπαράστασις τέτρασι κέχρηται ἐπιχειρήμασι, πρῶτον λέγουσα·", "seq": 3881}
{"id": "Elias_Passim_3882", "series": "CAG", "text": "τὸ μέγα καὶ μικρὸν καὶ πολὺ καὶ ὀλίγον αὐτὰ ἅπερ εἰσὶν ἑτέρων εἶναι λέγονται, τὰ δὲ ἐναντία οὐ πρὸς ἕτερον λέγονται, οἷον τὸ μέλαν οὐ λέγεται πρὸς λευκὸν μέλαν, ἀλλὰ λευκῷ ἐναντίον, καὶ ἐπὶ τοῦ λευκοῦ ὁμοίως·", "seq": 3882}
{"id": "Elias_Passim_3883", "series": "CAG", "text": "τὸ ἄρα μέγα καὶ μικρὸν οὐκ ἐναντία.", "seq": 3883}
{"id": "Elias_Passim_3884", "series": "CAG", "text": "δεύτερον ἐπιχείρημα·", "seq": 3884}
{"id": "Elias_Passim_3885", "series": "CAG", "text": "εἰ τὸ μέγα καὶ μικρὸν ἐναντία, συνυπάρξουσι τὰ ἐναντία τοῦ αὐτοῦ δυναμένου καὶ μικρὸν εἶναι καὶ μέγα πρὸς ἄλλο καὶ ἄλλο.", "seq": 3885}
{"id": "Elias_Passim_3886", "series": "CAG", "text": "τρίτον ἐπιχείρημα·", "seq": 3886}
{"id": "Elias_Passim_3887", "series": "CAG", "text": "εἰ τὸ μέγα καὶ μικρὸν καὶ πολὺ καὶ ὀλίγον ἐναντία, ἔσται τι ἑαυτῷ ἐναντίον τοῦ αὐτοῦ δυναμένου καὶ μεγάλου εἶναι καὶ μικροῦ κατὰ τὸν αὐτὸν χρόνον πρὸς ἄλλο καὶ ἄλλο.", "seq": 3887}
{"id": "Elias_Passim_3888", "series": "CAG", "text": "τέταρτον ἐπιχείρημα, ὃ οὐ λέγει ἡ λέξις ἀλλ᾿ ἡμεῖς·", "seq": 3888}
{"id": "Elias_Passim_3889", "series": "CAG", "text": "εἰ τὸ μέγα καὶ μικρὸν καὶ πολὺ καὶ ὀλίγον ἐναντία, οὐκέτι τὰ ἐναντία φθαρτικά εἰσιν ἀλλήλων, ἀλλὰ σωστικά·", "seq": 3889}
{"id": "Elias_Passim_3890", "series": "CAG", "text": "πολλὰ γὰρ μικρὰ ἓν μέγα ποιοῦσι καὶ πολλὰ ὀλίγα πολύ·", "seq": 3890}
{"id": "Elias_Passim_3891", "series": "CAG", "text": "τὰ δὲ ἐναντία ἀεὶ φθαρτικά εἰσι.", "seq": 3891}
{"id": "Elias_Passim_3892", "series": "CAG", "text": "6a12 Μάλιστα δὲ ἡ ἐναντιότης τοῦ ποσοῦ δοκεῖ περὶ τὸν τόπον ὑπάρχειν.", "seq": 3892}
{"id": "Elias_Passim_3893", "series": "CAG", "text": "Ἐλευθερώσας ὁ Ἀριστοτέλης τὸ ποσὸν ἐναντιότητος, τὸ μέγα καὶ μικρὸν καὶ πολὺ καὶ ὀλίγον, καὶ ποσὰ δοκοῦντα εἶναι καὶ ἐναντία, κατὰ ἀλήθειαν δείξας μηδὲ ποσὰ ὄντα μηδὲ ἐναντία διὰ τῆς ἐνστάσεως καὶ ἀντιπαραστάσεως, παραινεῖ διὰ τούτων τῷ θέλοντι ἐναντιότητα ἐν τῷ ποσῷ ἀποθέσθαι μὴ ἐπιχειρεῖν ἀπὸ τοῦ μεγάλου καὶ μικροῦ καὶ πολλοῦ καὶ ὀλίγου, ἀλλ᾿ ἀπὸ τοῦ τόπου·", "seq": 3893}
{"id": "Elias_Passim_3894", "series": "CAG", "text": "ὁ γὰρ τόπος ὁμολογουμένως ποσόν, καὶ ἐναντίον ὁ ἄνω τόπος τῷ κάτω τόπῳ.", "seq": 3894}
{"id": "Elias_Passim_3895", "series": "CAG", "text": "πρὸς ὅ φαμεν ὅτι οὐκ ἐναντίος ὁ ἄνω τόπος τῷ κάτω τόπῳ·", "seq": 3895}
{"id": "Elias_Passim_3896", "series": "CAG", "text": "τὸ γὰρ ἄνω καὶ κάτω διττόν, τὸ μὲν πρὸς τὴν φύσιν τὸ δὲ πρὸς ἡμᾶς·", "seq": 3896}
{"id": "Elias_Passim_3897", "series": "CAG", "text": "πρὸς ἡμᾶς μέν, ὅτι τὸ ἄνω καὶ κάτω τοῖς ποσὶν ὁρίζομεν καὶ τῇ κεφαλῇ, ἄνω μὲν λέγοντες τὸ ὑπὲρ κεφαλὴν ἡμισφαίριον κάτω δὲ τὸ ὑπὸ τοῖς ποσί.", "seq": 3897}
{"id": "Elias_Passim_3898", "series": "CAG", "text": "τὸ δὲ πρὸς τὴν φύσιν ἄνω καὶ κάτω·", "seq": 3898}
{"id": "Elias_Passim_3899", "series": "CAG", "text": "ἄνω μὲν ὅλος ὁ οὐρανὸς ἐφ᾿ ὃν ᾄττει τὰ κοῦφα, κάτω δὲ ἡ γῆ ἐφ᾿ ἣν ᾄττει τὰ βαρέα.", "seq": 3899}
{"id": "Elias_Passim_3900", "series": "CAG", "text": "οὔτε δὲ τὸ πρὸς ἡμᾶς ἄνω καὶ κάτω ἐναντία διὰ τρία ἐπιχειρήματα, ἃ καὶ ἐπὶ τῆς ἀντιπαραστάσεως ἐλέγομεν.", "seq": 3900}
{"id": "Elias_Passim_3901", "series": "CAG", "text": "ὧν πρῶτον τόδε·", "seq": 3901}
{"id": "Elias_Passim_3902", "series": "CAG", "text": "τὸ ἄνω καὶ κάτω ἅπερ ἐστὶν ἑτέρων εἶναι λέγεται, τὰ δὲ ἐναντία ἅπερ ἐστὶν ἑτέρων εἶναι οὐ λέγεται, ὡς εἴρηται·", "seq": 3902}
{"id": "Elias_Passim_3903", "series": "CAG", "text": "τὸ ἄνω καὶ κάτω ἄρα οὐκ ἐναντία.", "seq": 3903}
