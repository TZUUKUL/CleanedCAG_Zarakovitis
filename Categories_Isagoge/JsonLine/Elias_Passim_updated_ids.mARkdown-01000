{"id": "Elias_Passim_4301", "series": "CAG", "text": "ζῴου γὰρ ἀναιρεθέντος ἐπιστήμη ἀνῄρηται, ἐπιστητὸν δὲ οὐκ ἀναιρεῖται·", "seq": 4301}
{"id": "Elias_Passim_4302", "series": "CAG", "text": "εἰσὶ γὰρ τὰ ἐξ ὧν τὸ ζῷον, τὰ ἁπλᾶ.", "seq": 4302}
{"id": "Elias_Passim_4303", "series": "CAG", "text": "καὶ λέγομεν ὅτι ὡς ἁπλᾶ εἰσίν, οὐ μὴν ὡς ἐπιστητά.", "seq": 4303}
{"id": "Elias_Passim_4304", "series": "CAG", "text": "οὕτως περὶ ἐπιστήμης καὶ ἐπιστητοῦ.", "seq": 4304}
{"id": "Elias_Passim_4305", "series": "CAG", "text": "ἀλλὰ καὶ ἐπὶ αἰσθήσεως καὶ αἰσθητοῦ δείκνυσιν ὅτι οὐχ ἅμα.", "seq": 4305}
{"id": "Elias_Passim_4306", "series": "CAG", "text": "καὶ προτάττει τὸ ἀπὸ τῆς φύσεως τοῦ ἀπὸ τοῦ χρόνου, λέγων οὕτως·", "seq": 4306}
{"id": "Elias_Passim_4307", "series": "CAG", "text": "αἰσθητοῦ ὄντος σῶμα ἔστι (τὸ γὰρ αἰσθητὸν ἢ σῶμα ἢ ἐν σώματι), σώματος δὲ ὄντος αἴσθησις ἔστι (δεῖται γὰρ ἡ αἴσθησις τοῦ σώματος, καὶ ἵνα ὑποστῇ καὶ ἵνα ἐνεργήσῃ), αἰσθητοῦ ἄρα ὄντος αἴσθησις ἔστι·", "seq": 4307}
{"id": "Elias_Passim_4308", "series": "CAG", "text": "πρότερον οὖν τὸ αἰσθητὸν φύσει.", "seq": 4308}
{"id": "Elias_Passim_4309", "series": "CAG", "text": "ἀλλὰ καὶ χρόνῳ·", "seq": 4309}
{"id": "Elias_Passim_4310", "series": "CAG", "text": "τὸ μὲν γὰρ αἰσθητὸν ἀναιρεθὲν συναναιρεῖ τὴν αἴσθησιν·", "seq": 4310}
{"id": "Elias_Passim_4311", "series": "CAG", "text": "αἰσθητοῦ γὰρ ἀναιρεθέντος ἀνῄρηται καὶ τὸ σῶμα (τῶν γὰρ αἰσθητῶν καὶ τὸ σῶμα), σώματος δὲ μὴ ὄντος καὶ αἴσθησις ἀναιρεῖται (ἐν αὐτῷ γὰρ καὶ περὶ αὐτὸ ἡ αἴσθησις)·", "seq": 4311}
{"id": "Elias_Passim_4312", "series": "CAG", "text": "αἰσθητοῦ ἄρα ἀναιρεθέντος ἀνῄρηται καὶ ἡ αἴσθησις.", "seq": 4312}
{"id": "Elias_Passim_4313", "series": "CAG", "text": "ἡ δὲ αἴσθησις τὸ αἰσθητὸν οὐ συναναιρεῖ·", "seq": 4313}
{"id": "Elias_Passim_4314", "series": "CAG", "text": "ζῴου γὰρ ἀναιρεθέντος αἴσθησις μὲν ἀναιρεῖται, τὸ δὲ αἰσθητὸν ἔσται, τοῦτ᾿ ἔστι τὰ στοιχεῖα ἐξ ὧν τὸ ζῷον.", "seq": 4314}
{"id": "Elias_Passim_4315", "series": "CAG", "text": "καὶ ὅτι αἴσθησις συνεισάγει τὸ σῶμα, τοῦτο δὲ τὸ αἰσθητόν, ἐπειδὴ ἡ μὲν αἴσθησις ἅμα τῷ αἰσθητικῷ, τοῦτ᾿ ἔστι τῷ ζῴῳ, τὸ δὲ αἰσθητὸν πρὸ τοῦ ζῴου·", "seq": 4315}
{"id": "Elias_Passim_4316", "series": "CAG", "text": "ἦν γὰρ πῦρ καὶ ἀὴρ καὶ ὕδωρ καὶ γῆ αἰσθητὰ πρὸ τοῦ τὸ ζῷον γενέσθαι.", "seq": 4316}
{"id": "Elias_Passim_4317", "series": "CAG", "text": "ἀλλὰ πρὸς τοῦτο ἔστιν εἰπεῖν ὅτι ὡς στοιχεῖα ἔστιν, οὐκ αἰσθητά.", "seq": 4317}
{"id": "Elias_Passim_4318", "series": "CAG", "text": "ταύτας δὲ τὰς ἀπορίας ἁπάσας ἐν τῆς Φυσικῇ ἐπιλύεται ὁ Ἀριστοτέλης ἑνὶ λόγῳ λέγων καὶ τὰς μὲν δυνάμεις τῶν δυνάμεων τὰς δὲ ἐνεργείας τῶν ἐνεργειῶν **, τοῦτ᾿ ἔστι τὸ δυνάμει πρὸς τὸ δυνάμει παραβλητέον καὶ τὸ ἐνεργείᾳ πρὸς τὸ ἐνεργείᾳ.", "seq": 4318}
{"id": "Elias_Passim_4319", "series": "CAG", "text": "ἐνταῦθα δὲ οὐκ ἐπὶ τοῦ αὐτοῦ λαμβάνει τὸ ἐπιστητὸν καὶ τὴν ἐπιστήμην·", "seq": 4319}
{"id": "Elias_Passim_4320", "series": "CAG", "text": "τοῦ γὰρ ἐπιστητοῦ διττοῦ ὄντος, τοῦ μὲν δυνάμει τοῦ δὲ ἐνεργείᾳ, ἔτι δὲ καὶ τῆς ἐπιστήμης διττῆς οὔσης, τῆς μὲν δυνάμει τῆς δὲ ἐνεργείᾳ, τὸ μὲν ἐπιστητὸν δυνάμει λαμβάνει, ὅπερ πρότερόν ἐστι τοῦ ἐνεργείᾳ, τὴν δὲ ἐπιστήμην ἐνεργείᾳ.", "seq": 4320}
{"id": "Elias_Passim_4321", "series": "CAG", "text": "διὸ καὶ δοκεῖ πρότερον εἶναι τὸ ἐπιστητὸν ὡς δυνάμει ὂν τῆς ἐπιστήμης ἐνεργείᾳ οὔσης.", "seq": 4321}
{"id": "Elias_Passim_4322", "series": "CAG", "text": "ἐὰν δὲ τὸ δυνάμει ἐπιστητὸν ** πρὸς τὴν ἐνεργείᾳ ἐπιστήμην παραβάλλωμεν, ἅμα τῇ φύσει εὑρεθήσονται.", "seq": 4322}
{"id": "Elias_Passim_4323", "series": "CAG", "text": "τὰ δὲ αὐτὰ νοείσθω καὶ ἐπὶ τοῦ αἰσθητοῦ καὶ τῆς αἰσθήσεως.", "seq": 4323}
{"id": "Elias_Passim_4324", "series": "CAG", "text": "ἀποροῦσι δέ τινες διὰ τί ἐν μὲν τῇ Φυσικῇ ἀκροάσει ὁ Ἀριστοτέλης ἐπιλύεται τὰς ἀπορίας ταύτας, ἐνταῦθα δὲ οὐκ ἐπιλύεται, καίτοι τὰς πρὸς τὸ ἀντιστρέφειν λύσας.", "seq": 4324}
{"id": "Elias_Passim_4325", "series": "CAG", "text": "καὶ λέγομεν ὅτι ἐπειδὴ τὸ δυνάμει ἐν ὕλῃ, φυσικῆς δὲ περὶ ὕλης ζητεῖν·", "seq": 4325}
{"id": "Elias_Passim_4326", "series": "CAG", "text": "καὶ ἡ ψυχὴ γὰρ τὸ δυνάμει ἐπιδέχεται ἐν ὕλῃ γενομένη.", "seq": 4326}
{"id": "Elias_Passim_4327", "series": "CAG", "text": "πάλιν ἀποροῦσιν ὅτι διὰ τί ἐπὶ μὲν ἐπιστήμης καὶ ἐπιστητοῦ τὸ ἀπὸ τοῦ χρόνου προέταξε τοῦ ἀπὸ τῆς φύσεως, ἐπὶ δὲ αἰσθήσεως καὶ αἰσθητοῦ τὸ ἀπὸ τῆς φύσεως προέταξε τοῦ ἀπὸ τοῦ χρόνου.", "seq": 4327}
{"id": "Elias_Passim_4328", "series": "CAG", "text": "καὶ λέγομεν ὅτι βούλεται ὁ Ἀριστοτέλης τὰς ἀρχὰς τῶν ἀποδείξεων σαφεστέρας εἶναι, καὶ ἐπὶ μὲν τῆς αἰσθήσεως σαφέστερον τὸ ἀπὸ τῆς φύσεως τοῦ ἀπὸ τοῦ χρόνου·", "seq": 4328}
{"id": "Elias_Passim_4329", "series": "CAG", "text": "πρότερον γὰρ ἡ αἴσθησις τῇ φύσει τῆς ἐπιστήμης·", "seq": 4329}
{"id": "Elias_Passim_4330", "series": "CAG", "text": "συντίκτεται γὰρ ἡ αἴσθησις τῷ ζῴῳ, ἡ δὲ ἐπιστήμη ἔσχατον ἐπιγίνεται.", "seq": 4330}
{"id": "Elias_Passim_4331", "series": "CAG", "text": "8a13 Ἔχει δὲ ἀπορίαν τινὰ ὁ λόγος, πότερον οὐδεμία οὐσία τῶν πρός τι <λέγεται, καθάπερ δοκεῖ>, ἢ τοῦτο μὲν ἐνδέχεται κατά τινας.", "seq": 4331}
{"id": "Elias_Passim_4332", "series": "CAG", "text": "Ἤδη μὲν διέσυρεν ὁ Ἀριστοτέλης τὴν Πλατωνικὴν ὑπογραφὴν τῶν πρός τι, τὴν λέγουσαν ὅτι πρός τί ἐστιν ὅσα αὐτὰ ἅπερ ἐστὶν ἑτέρων εἶναι λέγεται, διὰ τῶν ἀληθῶν δύο ἰδίων τῶν πρός τι, τοῦ τε πρὸς ἀντιστρέφοντα λέγεσθαι καὶ ἅμα τῇ φύσει εἶναι, ἐπὶ μὲν ζῴου καὶ κεφαλῆς, ὄρνιθος καὶ πτεροῦ, πλοίου καὶ πηδαλίου, ὡς πρός τι μὲν ὄντων μὴ ἀντιστρεφόντων δέ (καὶ τοῦτο ἰάσατο ποιήσας αὐτὰ ἐξισάζειν διὰ τῆς ὀνοματοποιίας, οὐ μὴν διωρθώσατο τὴν Πλατωνικὴν ὑπογραφήν), ἀλλὰ καὶ ἐπιστήμης καὶ ἐπιστητοῦ καὶ αἰσθήσεως καὶ αἰσθητοῦ, ὡς πρός τι μὲν ὄντων μὴ ὄντων δὲ ἅμα τῇ φύσει.", "seq": 4332}
{"id": "Elias_Passim_4333", "series": "CAG", "text": "ἀλλὰ τοῦτο μὲν ἐν τῇ Φυσικῇ ἐπιλύεται, τὴν μέντοι ὑπογραφὴν τοῦ Πλάτωνος <νῦν> διορθώσασθαι βούλεται·", "seq": 4333}
{"id": "Elias_Passim_4334", "series": "CAG", "text": "οὐ μόνον γάρ, φησίν, ὦ Πλάτων, κεφαλὴ καὶ ζῷον καὶ πηδάλιον καὶ πλοῖον καὶ πτερὸν καὶ ὄρνις οὐκ ἔστι τῶν πρός τι διὰ τὸ μὴ ἀντιστρέφειν, ἀλλ᾿ οὐδὲ εἰ ἀντιστρέψουσι, τῶν πρός τί εἰσι·", "seq": 4334}
{"id": "Elias_Passim_4335", "series": "CAG", "text": "τὰ γὰρ πρός τι συμβεβηκότα, ταῦτα δὲ οὐσίαι εἰσίν·", "seq": 4335}
{"id": "Elias_Passim_4336", "series": "CAG", "text": "οὐδέποτε δὲ συμβέβηκεν ἡ οὐσία κατὰ φύσιν.", "seq": 4336}
{"id": "Elias_Passim_4337", "series": "CAG", "text": "πρόκειται οὖν ἐνταῦθα τῷ Ἀριστοτέλει ἐκβαλεῖν τὴν Πλατωνικὴν ὑπογραφὴν καὶ εἶθ᾿ οὕτως εἰπεῖν τὴν αὐτῷ δοκοῦσαν.", "seq": 4337}
{"id": "Elias_Passim_4338", "series": "CAG", "text": "καὶ τεχνικῶς ἀμφότερα ποιεῖ δι᾿ ἑνὸς καὶ τοῦ αὐτοῦ λόγου·", "seq": 4338}
{"id": "Elias_Passim_4339", "series": "CAG", "text": "<διὰ μέσου γὰρ ἀπορίας τὴν Πλατωνικὴν ἐκβάλλει> καὶ λέγει τὴν αὐτῷ δοκοῦσαν·", "seq": 4339}
{"id": "Elias_Passim_4340", "series": "CAG", "text": "τίθησι γὰρ ἀπορίαν μεταξὺ τῆς Πλατωνικῆς ὑπογραφῆς καὶ τῆς αὐτῷ δοκούσης, ἑπομένην μὲν τῇ Πλατωνικῇ ὑπογραφῇ λυομένην δὲ ὑπὸ τῆς αὐτῷ δοκούσης·", "seq": 4340}
{"id": "Elias_Passim_4341", "series": "CAG", "text": "ᾧ δὲ ἄτοπα ἕπεται, ἐκεῖνο ἄτοπον, ᾧ δὲ οὐχ ἕπεται ἄτοπον, τοὐναντίον δὲ καὶ τὰ ἄλλοις ἑπόμενα ἄτοπα διαλύει, ἐκεῖνο ἀληθές.", "seq": 4341}
{"id": "Elias_Passim_4342", "series": "CAG", "text": "ἔστι δὲ ἡ ἀπορία τοιαύτη·", "seq": 4342}
{"id": "Elias_Passim_4343", "series": "CAG", "text": "τῆς οὐσίας τετραχῶς λεγομένης (ἡ γὰρ οὐσία ἢ πρώτη ἢ δευτέρα καὶ καθ᾿ ἕτερον ἢ ὅλη ἢ μέρος, πρώτη καὶ ὅλη Σωκράτης, πρώτη καὶ μέρος Σωκράτους κεφαλή, δευτέρα καὶ ὅλη ἄνθρωπος, δευτέρα καὶ μέρος ἀνθρώπου κεφαλή), τὰς μὲν τρεῖς οὐ ποιεῖ συμβεβηκότα ἡ Πλατωνικὴ ὑπογραφή, τὴν δὲ τετάρτην, τοῦτ᾿ ἔστι τὴν δευτέραν καὶ μέρος, συμβεβηκὸς ποιεῖ·", "seq": 4343}
{"id": "Elias_Passim_4344", "series": "CAG", "text": "ἡ γὰρ πρώτη καὶ ὅλη οὐκ ἔστι συμβεβηκὸς οὐδὲ πρός τι·", "seq": 4344}
{"id": "Elias_Passim_4345", "series": "CAG", "text": "αὕτη γὰρ ἢ μετὰ προσδιορισμοῦ λαμβάνεται ἢ χωρὶς προσδιορισμοῦ, μετὰ προσδιορισμοῦ τὶς ἄνθρωπος, χωρὶς προσδιορισμοῦ Σωκράτης·", "seq": 4345}
{"id": "Elias_Passim_4346", "series": "CAG", "text": "οὐδεμία δὲ τῶν πρός τι·", "seq": 4346}
{"id": "Elias_Passim_4347", "series": "CAG", "text": "οὐδὲ γὰρ λέγεται ὁ τὶς ἄνθρωπος τινὸς ἀνθρώπου τὶς ἄνθρωπος·", "seq": 4347}
{"id": "Elias_Passim_4348", "series": "CAG", "text": "τὸ γὰρ τὶς πρὸς τὸ πᾶς, οὐ πρὸς τὸ τίς, λέγεται.", "seq": 4348}
{"id": "Elias_Passim_4349", "series": "CAG", "text": "[οὐδὲ ἡ πρώτη καὶ μέρος τῶν πρός τι·", "seq": 4349}
{"id": "Elias_Passim_4350", "series": "CAG", "text": "οὐδὲ γὰρ λέγεται ἡ τὶς χεὶρ τινός τις χεὶρ οὐδὲ ἡ τὶς κεφαλὴ τινός τις κεφαλή·", "seq": 4350}
{"id": "Elias_Passim_4351", "series": "CAG", "text": "ἡ γὰρ τὶς κεφαλὴ πρὸς τὴν καθόλου κεφαλήν, οὐ πρὸς τὸ τὶ ζῷον].", "seq": 4351}
{"id": "Elias_Passim_4352", "series": "CAG", "text": "οὐδὲ ἡ ἀπροσδιόριστος πρώτη καὶ ὅλη τῶν πρός τί ἐστιν·", "seq": 4352}
{"id": "Elias_Passim_4353", "series": "CAG", "text": "ὁ γὰρ δοῦλος ἢ ἀγρὸς οὐ λέγεται ἀνθρώπου δοῦλος ἢ ἀγρός, ἀλλὰ ἀνθρώπου κτῆμα.", "seq": 4353}
{"id": "Elias_Passim_4354", "series": "CAG", "text": "οὐδὲ ἡ πρώτη καὶ μέρος τῶν πρός τι·", "seq": 4354}
{"id": "Elias_Passim_4355", "series": "CAG", "text": "ἡ κεφαλὴ γὰρ ἢ ἡ χεὶρ οὐ πάντως Σωκράτους ἢ Πλάτωνος·", "seq": 4355}
{"id": "Elias_Passim_4356", "series": "CAG", "text": "ἄδηλον γὰρ τίνος·", "seq": 4356}
{"id": "Elias_Passim_4357", "series": "CAG", "text": "οὐκοῦν οὐ πρός τι οὐδὲ αὕτη, κἂν ἀπροσδιόριστος ᾖ.", "seq": 4357}
{"id": "Elias_Passim_4358", "series": "CAG", "text": "ἀλλ᾿ οὐδὲ ἡ δευτέρα καὶ ὅλη τῶν πρός τι·", "seq": 4358}
{"id": "Elias_Passim_4359", "series": "CAG", "text": "οὐδὲ γὰρ λέγεται ὁ βοῦς ἀνθρώπου βοῦς, ἀλλὰ ἀνθρώπου κτῆμα.", "seq": 4359}
{"id": "Elias_Passim_4360", "series": "CAG", "text": "ἡ μέντοι τετάρτη, ἡ δευτέρα καὶ μέρος, δύναται τῶν πρός τι εἶναι·", "seq": 4360}
{"id": "Elias_Passim_4361", "series": "CAG", "text": "ἡ γὰρ κεφαλὴ πάντως ζῴου καὶ ἡ χεὶρ πάντως ἀνθρώπου καὶ ζῴου.", "seq": 4361}
{"id": "Elias_Passim_4362", "series": "CAG", "text": "δυοῖν οὖν θάτερον, ὦ Πλάτων, ἀνάγκη δέξασθαί σε, ἢ ὅτι κακῶς ἔχει ἡ ὑπογραφή, ἢ εἰπεῖν τὴν οὐσίαν συμβεβηκός.", "seq": 4362}
{"id": "Elias_Passim_4363", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ τὸ δεύτερον ἄτοπον, <τὸ> τὴν οὐσίαν ποιεῖν συμβεβηκός, αἱρεῖται τὸ πρῶτον, ὅτι κακῶς ἔχει ἡ ὑπογραφή.", "seq": 4363}
{"id": "Elias_Passim_4364", "series": "CAG", "text": "καὶ αὕτη μὲν ἡ ἀπορία ἡ ἑπομένη τῇ Πλατωνικῇ ὑπογραφῇ τῶν πρός τι.", "seq": 4364}
{"id": "Elias_Passim_4365", "series": "CAG", "text": "λύεται δὲ αὕτη διὰ τοῦ ἀνθορισμοῦ.", "seq": 4365}
{"id": "Elias_Passim_4366", "series": "CAG", "text": "ἐφ᾿ οἷς ἀνθορίζεται ὁ Ἀριστοτέλης.", "seq": 4366}
{"id": "Elias_Passim_4367", "series": "CAG", "text": "πῶς δὲ ποιεῖ τοῦτο, ἡ ἑξῆς θεωρία παραστήσει.", "seq": 4367}
{"id": "Elias_Passim_4368", "series": "CAG", "text": "8a28 Εἰ μὲν οὖν ἱκανῶς ἔχει ὁ τῶν πρός τι ὁρισμός, ἢ τῶν χαλεπῶν ἢ τῶν ἀδυνάτων λῦσαι τὴν ἀπορίαν.", "seq": 4368}
{"id": "Elias_Passim_4369", "series": "CAG", "text": "Καταψηφισάμενος ὁ Ἀριστοτέλης τῆς Πλατωνικῆς ὑπογραφῆς τῶν πρός τι, διότι τὸ ζῷον καὶ τὴν κεφαλήν, πλοῖον καὶ πηδάλιον, πτερὸν καὶ ὄρνιθα τῶν πρός τι ἐποίει, οὐσίας ὄντα, αὐτὸς νῦν ἀνθορίζεται λέγων ὅτι πρός τί ἐστιν οἷς τὸ εἶναι ταὐτόν ἐστι τῷ πρός τί πως ἔχειν, τοῦτ᾿ ἔστιν οἷς τὸ εἶναί ἐστιν <ἡ> πρὸς ἕτερον σχέσις.", "seq": 4369}
{"id": "Elias_Passim_4370", "series": "CAG", "text": "καὶ μὴ θαυμάσῃς εἰ τὸ ἕτερον διὰ τοῦ ἑτέρου ὑπογράφει·", "seq": 4370}
{"id": "Elias_Passim_4371", "series": "CAG", "text": "τὴν γὰρ σχέσιν διὰ τῶν ἐχόντων τὴν σχέσιν ὑπογράφει·", "seq": 4371}
{"id": "Elias_Passim_4372", "series": "CAG", "text": "μόνα γὰρ τὰ πρός τι δι᾿ ἀλλήλων ὑπογράφεται·", "seq": 4372}
{"id": "Elias_Passim_4373", "series": "CAG", "text": "ὁ γὰρ εἰδὼς ἓν τῶν πρός τι τὴν οὐσίαν αὐτοῦ οἶδεν, ὁ τὴν οὐσίαν αὐτοῦ εἰδὼς τὴν πρὸς ἕτερον αὐτοῦ σχέσιν οἶδεν·", "seq": 4373}
{"id": "Elias_Passim_4374", "series": "CAG", "text": "ὁ ἄρα ἓν τῶν πρός τι εἰδὼς τὴν πρὸς ἕτερον αὐτοῦ σχέσιν οἶδε.", "seq": 4374}
{"id": "Elias_Passim_4375", "series": "CAG", "text": "δεῖ δὲ εἰδέναι ταῦτα, ὅτι οὐχ ἕπεται τῇ ὑπογραφῇ τὴν οὐσίαν πρός τι ποιεῖν, ὡς τῇ Πλατωνικῇ εἵπετο τὴν κεφαλὴν καὶ τὸ ζῷον τῶν πρός τι λέγειν.", "seq": 4375}
{"id": "Elias_Passim_4376", "series": "CAG", "text": "τοῦτο οὐχ ἕπεται τῇ Ἀριστοτελικῇ ὑπογραφῇ·", "seq": 4376}
{"id": "Elias_Passim_4377", "series": "CAG", "text": "εἰ γὰρ πρός τί εἰσιν οἷς τὸ εἶναι ἡ πρὸς ἕτερον σχέσις, τὰ δὲ πράγματα τὸ εἶναι ἔχει ἐν τῷ καθ᾿ αὑτὸ καὶ οὐκ ἐν τῷ πρὸς ἕτερον λέγεσθαι, ἡ κεφαλὴ καὶ τὸ ζῷον οὐ πρός τι·", "seq": 4377}
{"id": "Elias_Passim_4378", "series": "CAG", "text": "ποιεῖ γὰρ ταύτην οὐ κεφαλὴν τὸ οὗ ἐστι κεφαλή (ἔστι γὰρ κεφαλὴ καὶ μὴ ὄντος τοῦ λοιποῦ σώματος), ἀλλὰ μέρος μόνον·", "seq": 4378}
{"id": "Elias_Passim_4379", "series": "CAG", "text": "τὸ γὰρ μέρος καὶ τὸ ὅλον τῶν πρός τι.", "seq": 4379}
{"id": "Elias_Passim_4380", "series": "CAG", "text": "συμβέβηκε δὲ τὸ μέρος ἐκεῖνο κεφαλὴν εἶναι τὸ δὲ ὅλον ζῷον.", "seq": 4380}
{"id": "Elias_Passim_4381", "series": "CAG", "text": "κατὰ συμβεβηκὸς οὖν ἡ κεφαλὴ καὶ τὸ ζῷον τῶν πρός τι·", "seq": 4381}
{"id": "Elias_Passim_4382", "series": "CAG", "text": "ὡς μέρος γὰρ καὶ ὅλον, καὶ οὐχ ὡς κεφαλὴ καὶ ζῷον.", "seq": 4382}
{"id": "Elias_Passim_4383", "series": "CAG", "text": "καὶ ταῦτα μὲν ἡμεῖς προληπτικώτερον.", "seq": 4383}
{"id": "Elias_Passim_4384", "series": "CAG", "text": "ὁ μέντοι Ἀριστοτέλης πορίσματα συνάγει ἐκ τῶν προαποδεδειγμένων·", "seq": 4384}
{"id": "Elias_Passim_4385", "series": "CAG", "text": "εἰ γὰρ πρός τι, φησίν, ἐστὶν οἷς τὸ εἶναί ἐστιν ἡ πρὸς ἕτερον σχέσις, τρία ταῦτα ἕπεται πορίσματα·", "seq": 4385}
{"id": "Elias_Passim_4386", "series": "CAG", "text": "οὐκ ἔστι γὰρ ἐπὶ τῶν πρός τι τὸ μὲν εἰδέναι τὸ δὲ ἀγνοεῖν·", "seq": 4386}
{"id": "Elias_Passim_4387", "series": "CAG", "text": "οἷον ἐὰν οἶδα τὸν πατέρα ὡς πατέρα, οἶδα καὶ τὸν υἱὸν ὡς υἱὸν καὶ τὸ ἀνάπαλιν·", "seq": 4387}
{"id": "Elias_Passim_4388", "series": "CAG", "text": "οὐ γὰρ δυνατὸν εἰδέναι μὲν τὸν πατέρα ὡς πατέρα τὸν δὲ υἱὸν <ὡς υἱὸν> ἀγνοεῖν·", "seq": 4388}
{"id": "Elias_Passim_4389", "series": "CAG", "text": "εἰ γὰρ τοῦτο δυνατόν, ἔξεστί μοι τὴν ὕλην τὴν χειρίστην πασῶν, ὡς τρύγα, καλλίονα εἰπεῖν, μὴ ἀπαιτουμένῳ εἰπεῖν τίνος ἐστὶ καλλίων.", "seq": 4389}
{"id": "Elias_Passim_4390", "series": "CAG", "text": "τοῦτο πρῶτον.", "seq": 4390}
{"id": "Elias_Passim_4391", "series": "CAG", "text": "δεύτερον δὲ ὅτι ἐπὶ τῶν πρός τι οὐκ ἔστι τὸ μὲν ἀκριβῶς εἰδέναι τὸ δὲ παχυμερῶς, μὴ ἵνα τὸν μὲν πατέρα οἶδέ τις ἀκριβῶς, τὸν δὲ υἱὸν παχυμερῶς.", "seq": 4391}
{"id": "Elias_Passim_4392", "series": "CAG", "text": "τρίτον οὐκ ἔστιν ἐπὶ τῶν πρός τι τὸ μὲν εἰδέναι κατὰ τὸν καθόλου λόγον τὸ δὲ κατὰ τὸν ἐπὶ μέρους, ἀλλ᾿ ἢ ἀμφότερα κατὰ τὸν καθόλου ἢ ἀμφότερα κατὰ τὸν ἐπὶ μέρους, ὡς ἐπὶ διπλασίου καὶ ἡμίσεος, μὴ ἵνα τὸ μὲν διπλάσιον οἶδας κατὰ τὸν καθόλου λόγον ὅτι διπλάσιόν ἐστι τὸ ἔχον ἥμισυ, οἷον ἐὰν ᾖ, τὸ δὲ ἥμισυ ἵνα οἶδας κατὰ τὸν ἐπὶ μέρους λόγον ὡς δεύτερον ἢ τέταρτον.", "seq": 4392}
{"id": "Elias_Passim_4393", "series": "CAG", "text": "τούτων οὕτως προληφθέντων ἡ κεφαλὴ καὶ τὸ ζῷον οὔκ εἰσι τῶν πρός τι·", "seq": 4393}
{"id": "Elias_Passim_4394", "series": "CAG", "text": "εἰ γὰρ οὐκ ἔστιν ἐπὶ τῶν πρός τι τὸ μὲν εἰδέναι τὸ δὲ ἀγνοεῖν, τὴν δὲ κεφαλὴν δύναμαι εἰδέναι ἀγνουμένου οὗ ἐστι κεφαλὴ διὰ τὸ ἐγκεκαλύφθαι τὸ λοιπὸν σῶμα, ὃ πέπονθεν Ἠλέκτρα ἐπὶ τοῦ Ὀρέστου **.", "seq": 4394}
{"id": "Elias_Passim_4395", "series": "CAG", "text": "καὶ τὸ αὐτὸ ἔστιν εἰπεῖν ἐπὶ τοῦ προτείνοντος τὴν χεῖρα ἐγκεκαλυμμένου δὲ τὸ λοιπὸν σῶμα.", "seq": 4395}
{"id": "Elias_Passim_4396", "series": "CAG", "text": "τινὲς πρὸς τοῦτό φασιν ὅτι εἰ μὴ οἶδα τίνος ἐστὶν ἡ κεφαλή, οὐδὲ εἰ κεφαλή ἐστιν οἶδα, κακῶς λέγοντες·", "seq": 4396}
{"id": "Elias_Passim_4397", "series": "CAG", "text": "τὴν γὰρ κεφαλὴν γινώσκομεν ἀπὸ μεγέθους, σχήματος, τριχῶν, κἂν μὴ ᾖ τὸ λοιπὸν σῶμα.", "seq": 4397}
{"id": "Elias_Passim_4398", "series": "CAG", "text": "ἄλλοι φασὶ ὅτι ναί, οἶδα καὶ τίνος ἐστὶ κεφαλή·", "seq": 4398}
{"id": "Elias_Passim_4399", "series": "CAG", "text": "οἶδα γὰρ ὅτι ἀνθρώπου.", "seq": 4399}
{"id": "Elias_Passim_4400", "series": "CAG", "text": "πρὸς οὕς φαμεν ὅτι τὸ λῆμμα οὐχ οὕτως ἔχει, ἵνα τὸ μὲν οἶδας ὡς μερικὸν τὸ δὲ ὡς καθόλου, τὸ δὲ λέγειν ὅτι ‘ἐὰν ἴδω κεφαλήν, οἶδα καὶ τίνος ἐστίν·", "seq": 4400}
{"id": "Elias_Passim_4401", "series": "CAG", "text": "ἀνθρώπου γάρ᾿ καθολικόν ἐστι καὶ μερικόν, διότι ἡ ὁρωμένη κεφαλὴ μερικὴ ὁ δὲ ἄνθρωπος καθόλου.", "seq": 4401}
{"id": "Elias_Passim_4402", "series": "CAG", "text": "Ἀπορεῖ δὲ ὁ Ἀλέξανδρος πρὸς ταῦτα ὅτι παρὰ θύρας προῆλθεν ἡ λύσις τῆς ἀπορίας·", "seq": 4402}
{"id": "Elias_Passim_4403", "series": "CAG", "text": "ἠπορήθη γὰρ ἐπὶ τῆς ἁπλῶς κεφαλῆς, λέλεκται δὲ ἐπὶ τῆς τινὸς κεφαλῆς·", "seq": 4403}
{"id": "Elias_Passim_4404", "series": "CAG", "text": "ἀνωτέρω γὰρ ἐλέγετο ὅτι ἡ κεφαλὴ ζῴου κεφαλή, νῦν δὲ ἐπὶ τῆς ὁρωμένης κεφαλῆς λέλυται, ἥτις ἐστὶν ἐπὶ μέρους·", "seq": 4404}
{"id": "Elias_Passim_4405", "series": "CAG", "text": "ἡ γὰρ καθόλου κεφαλὴ ἀόρατος.", "seq": 4405}
{"id": "Elias_Passim_4406", "series": "CAG", "text": "διὸ αὐτὸς λέγει λύσιν ἄλλην·", "seq": 4406}
{"id": "Elias_Passim_4407", "series": "CAG", "text": "φησὶ γὰρ ὅτι ‘συλλέλυταί μοι καὶ τὸ πρῶτον, ὃ ἐπὶ τῆς ὁρωμένης κεφαλῆς λέλυται, ἥτις ἐστὶν ἐπὶ μέρους·", "seq": 4407}
{"id": "Elias_Passim_4408", "series": "CAG", "text": "εἰ γὰρ ἡ τὶς κεφαλὴ μή ἐστι τῶν πρός τι, οὐδὲ ἡ ἁπλῶς κεφαλὴ τῶν πρός τι (ὅσα γὰρ τῶν ἐπάνω κατηγορεῖται, καὶ τῶν ὑποκάτω), καὶ εἰ ἡ ἁπλῶς κεφαλὴ οὐκ ἔστι τῶν πρός τι, οὐδὲ ἡ τὶς κεφαλὴ διὰ τὴν αὐτὴν αἰτίαν’.", "seq": 4408}
{"id": "Elias_Passim_4409", "series": "CAG", "text": "καί φαμεν ἡμεῖς πρὸς τὸν Ἀλέξανδρον ὅτι ὅσον ἀπὸ λύσεώς σου οὐκ ἔσται ἓν σημαινόμενον τῶν πρός τι τὸ διὰ τὴν πρὸς τὸ γένος ἀναφοράν, ὃ ἀνωτέρω ἡμῖν δέδεικται·", "seq": 4409}
{"id": "Elias_Passim_4410", "series": "CAG", "text": "δυνατὸν γὰρ τῷ μὲν μερικῷ μὴ ὑπάρχειν, τῷ δὲ καθόλου ὑπάρχειν, οἷον ἡ τὶς γραμματική, μὴ οὖσα τῶν πρός τι δι᾿ ἑαυτήν, διὰ τὸ γένος τῶν πρός τι λέγεται εἶναι.", "seq": 4410}
{"id": "Elias_Passim_4411", "series": "CAG", "text": "τί οὖν ἄτοπον τὴν τινὰ μὲν κεφαλὴν μὴ εἶναι τῶν πρός τι, τὴν δὲ καθόλου τῶν πρός τι εἶναι;", "seq": 4411}
{"id": "Elias_Passim_4412", "series": "CAG", "text": "οἱ περὶ Ἀμμώνιον δέ φασιν ὅτι οὐδὲ ἐπὶ τῆς ἁπλῶς δυνατὸν εἰπεῖν τίνος ἐστὶ κεφαλὴ ἐπὶ τῶν ὁμοίων ζῴων, λύκου καὶ κυνός, φάττης καὶ περιστερᾶς·", "seq": 4412}
{"id": "Elias_Passim_4413", "series": "CAG", "text": "ἄδηλον γὰρ τίνος διὰ τὴν πολλὴν ὁμοιότητα.", "seq": 4413}
{"id": "Elias_Passim_4414", "series": "CAG", "text": "καὶ ταῦτα μὲν ἐν τούτοις.", "seq": 4414}
{"id": "Elias_Passim_4415", "series": "CAG", "text": "Ὁ μέντοι κριτικώτατος Συριανός φησιν ὅτι οὐδὲν διαφέρει ἡ πρώτη ὑπογραφὴ δευτέρας, ἀλλ᾿ ἢ ἐξήγησίς ἐστιν ἑτέρα τῆς ἑτέρας·", "seq": 4415}
{"id": "Elias_Passim_4416", "series": "CAG", "text": "διὰ τί γὰρ τὰ πρός τι ὅσα αὐτὰ ἅπερ ἐστὶν ἑτέρων εἶναι λέγεται;", "seq": 4416}
{"id": "Elias_Passim_4417", "series": "CAG", "text": "ἐπειδὴ τὸ εἶναι ἔχει ἐν τῇ πρὸς ἕτερον σχέσει.", "seq": 4417}
{"id": "Elias_Passim_4418", "series": "CAG", "text": "καὶ διὰ τί ἃ τὸ εἶναι ἔχει ἐν τῇ πρὸς ἕτερον σχέσει;", "seq": 4418}
{"id": "Elias_Passim_4419", "series": "CAG", "text": "ἐπειδὴ αὐτὰ ἅπερ ἐστὶν ἑτέρων εἶναι λέγεται.", "seq": 4419}
{"id": "Elias_Passim_4420", "series": "CAG", "text": "ἀλλ᾿ εἰ ἄρα σαφεστέρα ἡ Πλατωνική, ἐπειδὴ πρόσκειται τὸ λέγεται, ἀσαφεστέρα δὲ ἡ Ἀριστοτελική.", "seq": 4420}
{"id": "Elias_Passim_4421", "series": "CAG", "text": "** ἐπ᾿ ἀμφοτέρων τῶν ὅρων ληπτέον τῆς Πλατωνικῆς καὶ τῆς Ἀριστοτελικῆς ἢ ἐπὶ ἑνὸς ὅρου τὸ λέγεται [ἐπὶ δὲ τῆς Ἀριστοτελικῆς οὐχ οὕτως]·", "seq": 4421}
{"id": "Elias_Passim_4422", "series": "CAG", "text": "οἷον πρός τί ἐστιν ὅσα αὐτὰ ἅπερ ἐστὶν ἑτέρων εἶναι λέγεται ἵνα λαμβάνῃς ἐπὶ ἑνὸς ὅρου, οἷον κεφαλῆς καὶ ζῴου, τὴν μὲν κεφαλὴν τυχὸν τινὸς λαμβάνεις, οὐκέτι δὲ καὶ τὸ πρὸς ὃ λέγεται ἀξιοῖς πρὸς τὴν κεφαλὴν λέγεσθαι.", "seq": 4422}
{"id": "Elias_Passim_4423", "series": "CAG", "text": "εἰ δὲ τὸ λέγεται ἐπὶ τῶν δύο ὅρων νοηθῇ ἔχουσα ἡ ὑπογραφὴ τοῦ Πλάτωνος, οὐχ ἕπεται αὐτῇ οὐδὲν ἄτοπον.", "seq": 4423}
{"id": "Elias_Passim_4424", "series": "CAG", "text": "ἀλλὰ καὶ τῇ Ἀριστοτελικῇ ἄτοπον ἕπεται ὑπογραφῇ, εἰ ἐπὶ ἑνὸς ὅρου ληφθείη μόνον ἡ ἀπόδοσις.", "seq": 4424}
{"id": "Elias_Passim_4425", "series": "CAG", "text": "οὐδὲν δέ φησιν ὁ Ἀριστοτέλης ὅτι φαύλη πάντῃ ἡ ὑπογραφὴ τοῦ Πλάτωνος·", "seq": 4425}
{"id": "Elias_Passim_4426", "series": "CAG", "text": "μέλλων γὰρ ἀνθορίζεσθαί φησιν οὕτως·", "seq": 4426}
{"id": "Elias_Passim_4427", "series": "CAG", "text": "εἰ μὲν οὖν ἱκανῶς ἔχει ὁ τῶν πρός τι ὁρισμός, ἢ χαλεπὸν ἢ ἀδύνατον λῦσαι τὴν ἀπορίαν·", "seq": 4427}
{"id": "Elias_Passim_4428", "series": "CAG", "text": "ἐὰν γὰρ καλῶς ἔχῃ, φησίν, ἡ Πλατωνικὴ ὑπογραφὴ καὶ καθ᾿ αὑτὴν γένηται ἡ ἀπόδοσις ὡς ἐπὶ ὅλου καὶ μέρους, χαλεπὴ μὲν ἡ λύσις, οὐκ ἀδύνατος δὲ διὰ τοὺς προσδιορισμοὺς δι᾿ αὑτοὺς χαλεπούς, τὸ καθ᾿ αὑτὸ καὶ οὐ καθ᾿ αὑτό, εἰ δὲ κατὰ συμβεβηκὸς γένηται ἡ ἀπόδοσις, ἵνα ἡ κεφαλὴ ὡς κεφαλὴ τοῦ ζῴου ὡς ζῴου εἴη κεφαλή, ἀδύνατον λῦσαι τὴν ἀπορίαν.", "seq": 4428}
{"id": "Elias_Passim_4429", "series": "CAG", "text": "διὸ καὶ εὐγνωμόνως ἐπάγει λέγων ὅτι οὐ δεῖ περὶ τῶν τοιούτων προπετῶς ἀποφαίνεσθαι καὶ κατατρέχειν τῶν παλαιῶν μὴ πολλὰ ἐπεσκεμμένον·", "seq": 4429}
{"id": "Elias_Passim_4430", "series": "CAG", "text": "ἄμεινον γὰρ τεχνικῶς ἀπορεῖν ἢ ψευδῶς λύειν·", "seq": 4430}
{"id": "Elias_Passim_4431", "series": "CAG", "text": "ἐνιαχοῦ γὰρ καὶ μέχρι τῆς ἀπορίας δεῖ ἵστασθαι καὶ μὴ βιάζεσθαι πάντως λέγειν λύσιν.", "seq": 4431}
{"id": "Elias_Passim_4432", "series": "CAG", "text": "ἀλλ᾿ ἵνα μή τις εἴπῃ ὅτι ματαιοπονοῦμεν ἀποροῦντες καὶ μὴ ἐπιλυόμενοι, οὐδὲ αὐτό φησι τὸ διαπορεῖν καθ᾿ αὑτὸ ἄχρηστον·", "seq": 4432}
{"id": "Elias_Passim_4433", "series": "CAG", "text": "ἡ γὰρ ἀπορία ὁδός ἐστιν εἰς εὐπορίαν, δριμυτέραν καὶ πλατυτέραν ποιοῦσα τὴν ψυχὴν πρὸς ὑποδοχὴν πλειόνων, ὡς ἐπὶ τῶν πυρεκβόλων λίθων τῶν διὰ τῆς παρατρίψεως φῶς ἀφιέντων·", "seq": 4433}
{"id": "Elias_Passim_4434", "series": "CAG", "text": "καὶ ἡ ψυχὴ γὰρ θλιβομένη διὰ τῶν ἐφ᾿ ἑκάτερα κινήσεων καὶ ἐπιχειρήσεων ἀπογεννᾷ τὸ τῆς ἀληθείας φῶς·", "seq": 4434}
{"id": "Elias_Passim_4435", "series": "CAG", "text": "τὸ γὰρ μηδὲ ὅλως ἀπορεῖν ἢ θεοῦ τοῦ πάντα εἰδότος ἢ λίθου τοῦ μηδὲν εἰδότος.", "seq": 4435}
{"id": "Elias_Passim_4436", "series": "CAG", "text": "ταῦτα περὶ τῶν πρός τι.", "seq": 4436}
{"id": "Elias_Passim_4437", "series": "CAG", "text": "ἐν οἷς καὶ ἡ παροῦσα πρᾶξις.", "seq": 4437}
{"id": "Elias_Passim_4438", "series": "CAG", "text": "Περὶ ποιοῦ χαὶ ποιότητος.", "seq": 4438}
{"id": "Elias_Passim_4439", "series": "CAG", "text": "8b25 Ποιότητα δὲ λέγω καθ᾿ ἣν ποιοί τινες λέγονται.", "seq": 4439}
{"id": "Elias_Passim_4440", "series": "CAG", "text": "Τέσσαρα δὲ κεφάλαια τῆς παρούσης κατηγορίας δεῖ προλαβεῖν, πρῶτον μὲν τὴν τάξιν τῆς ποιότητος τὴν πρὸς τὰς λοιπὰς κατηγορίας, δεύτερον τὴν αἰτίαν τῆς ἐπιγραφῆς, τρίτον τὴν διαίρεσιν αὐτῆς, τέταρτον τὴν τάξιν τῶν διαιρεθέντων εἰδῶν, ὧν ἡ παροῦσα <πρᾶξις> δύο τὰ πρῶτα παραδίδωσι, τὴν τάξιν καὶ τὴν ἐπιγραφήν.", "seq": 4440}
{"id": "Elias_Passim_4441", "series": "CAG", "text": "διὰ τί τοίνυν τετάρτην εἴληφε τάξιν μετὰ τὴν οὐσίαν καὶ τὸ ποσὸν καὶ τὰ πρός τι;", "seq": 4441}
{"id": "Elias_Passim_4442", "series": "CAG", "text": "καὶ λέγομεν τούτου πέντε αἰτίας.", "seq": 4442}
{"id": "Elias_Passim_4443", "series": "CAG", "text": "πρώτην μέν·", "seq": 4443}
{"id": "Elias_Passim_4444", "series": "CAG", "text": "αὕτη μόνη ἔλειπεν ἐν ταῖς ἁπλαῖς κατηγορίαις καὶ ἔδει περὶ ταύτης μετ᾿ ἐκείνας διαλαβεῖν.", "seq": 4444}
{"id": "Elias_Passim_4445", "series": "CAG", "text": "δευτέρα αἰτία·", "seq": 4445}
{"id": "Elias_Passim_4446", "series": "CAG", "text": "ὅτι ἐδεήθη τῶν πρός τι ἡ ποιότης ἐν οἰκείᾳ ἐπιγραφῇ αὐτῆς, προσεχῶς δὲ περὶ τῶν πρός τι διελεγόμεθα, εἰκότως μετὰ τὰ πρός τι περὶ αὐτῆς διαλέγεται·", "seq": 4446}
{"id": "Elias_Passim_4447", "series": "CAG", "text": "ἐπιγέγραπται γὰρ Περὶ ποιοῦ καὶ ποιότητος, ἅπερ εἰσὶ τῶν πρός τι·", "seq": 4447}
{"id": "Elias_Passim_4448", "series": "CAG", "text": "ἡ γὰρ ποιότης πεποιωμένου ποιότης καὶ τὸ πεποιωμένον ποιότητι πεποιωμένον.", "seq": 4448}
{"id": "Elias_Passim_4449", "series": "CAG", "text": "πῶς δὲ τῶν πρός τι ἡ ποιότης νοηθείη, ἐν τοῖς ἑξῆς ῥηθήσεται.", "seq": 4449}
{"id": "Elias_Passim_4450", "series": "CAG", "text": "διὸ καὶ νόμῳ τῶν πρός τι δι᾿ ἀλλήλων αὐτὰ ὑπογράφει, τὸ ποιὸν διὰ τῆς ποιότητος καὶ τὴν ποιότητα διὰ τοῦ ποιοῦ·", "seq": 4450}
{"id": "Elias_Passim_4451", "series": "CAG", "text": "μόνων γὰρ τῶν πρός τι ἴδιον τὸ δι᾿ ἀλλήλων ὑπογράφεσθαι.", "seq": 4451}
{"id": "Elias_Passim_4452", "series": "CAG", "text": "τρίτη αἰτία, ὅτι ἔδει λοιπὸν καὶ περὶ τῆς ποιότητος διαλαβεῖν μετὰ τρεῖς κατηγορίας διὰ τοὺς λέγοντας μὴ εἶναι φύσει τὰς ποιότητας, ἀλλὰ τῇ θέσει τῶν ἀτόμων ἕπεσθαι, κατὰ τοὺς λέγοντας ‘νόμῳ γλυκύ, νόμῳ πικρόν’.", "seq": 4452}
{"id": "Elias_Passim_4453", "series": "CAG", "text": "τετάρτη αἰτία, ὅτι ἔδει περὶ ποιότητος διαλαβεῖν ὡς ἐπειγούσης τῆς ζητήσεως διὰ τοὺς λέγοντας μὴ εἶναι καθ᾿ αὑτὰς τὰς ποιότητας, ἀλλ᾿ ἐν τῇ πρὸς ἕτερον σχέσει τὸ εἶναι ἔχειν·", "seq": 4453}
{"id": "Elias_Passim_4454", "series": "CAG", "text": "τὸ γὰρ μέλι οὐ καθ᾿ αὑτὸ γλυκύ, φασίν, ἀλλὰ πρὸς τὸν ὑγιαίνοντα (τῷ γὰρ ἰκτερικῷ πικρὸν φαίνεται), τὸ πῦρ οὐ καθ᾿ αὑτὸ θερμόν (οὐ γὰρ πᾶσι θερμόν·", "seq": 4454}
{"id": "Elias_Passim_4455", "series": "CAG", "text": "οὐ δήπου γὰρ καὶ τῇ σαλαμάνδρᾳ), οὐδὲ ὁ ἥλιος πᾶσι φωτεινός·", "seq": 4455}
{"id": "Elias_Passim_4456", "series": "CAG", "text": "ταῖς γὰρ νυκτερίσι σκοτεινὸς δοκεῖ εἶναι.", "seq": 4456}
{"id": "Elias_Passim_4457", "series": "CAG", "text": "πέμπτη αἰτία, ὅτι ἔδει καὶ περὶ τῆς ποιότητος συντόμως διαλαβεῖν δι᾿ Ἀντισθένην καὶ τοὺς περὶ αὐτὸν λέγοντας ‘ἄνθρωπον ὁρῶ, ἀνθρωπότητα δὲ οὐχ ὁρῶ’, ὡς ἀναιροῦντας τὴν ἁπλῶς ποιότητα.", "seq": 4457}
{"id": "Elias_Passim_4458", "series": "CAG", "text": "ἐν οἷς τὸ πρῶτον κεφάλαιον.", "seq": 4458}
{"id": "Elias_Passim_4459", "series": "CAG", "text": "Δεύτερον δὲ κεφάλαιον ἡ αἰτία τῆς ἐπιγραφῆς, διὰ τί Περὶ ποιοῦ καὶ ποιότητος ἐπέγραψεν ἐνταῦθα μόνον, ἐπὶ ἄλλων δὲ οὐχ οὕτως ἐπέγραψεν, οἷον Περὶ οὐσίας καὶ οὐσιότητος καὶ Περὶ ποσοῦ καὶ ποσότητος.", "seq": 4459}
{"id": "Elias_Passim_4460", "series": "CAG", "text": "καὶ λέγομεν ὅτι ἡ ποιότης δι᾿ ἑαυτὴν ἐπιγέγραπται οὕτως, αἱ δὲ ἄλλαι οὐ δι᾿ ἑαυτὰς ἀλλὰ διὰ τὴν ποιότητα·", "seq": 4460}
{"id": "Elias_Passim_4461", "series": "CAG", "text": "καὶ ἡ οὐσιότης γὰρ καὶ ἡ ποσότης ποιότης, ἐπειδὴ πᾶς χαρακτὴρ ποιότητος.", "seq": 4461}
{"id": "Elias_Passim_4462", "series": "CAG", "text": "δεῖ δὲ εἰδέναι ὅτι τρία σημαίνει τὸ ποιὸν παρὰ τῷ Ἀριστοτέλει, τὴν ποιότητα αὐτήν, τὴν κατηγορίαν, ὅτε λέγει ὅτι ὑπάρχει τῷ ποιῷ τὸ ἐπιδέχεσθαι τὸ μᾶλλον καὶ τὸ ἧττον καὶ τὰ ἐναντία, ἀλλὰ καὶ τὸ δεδεγμένον, τοῦτ᾿ ἔστι τὸ πεποιωμένον, ὅτε λέγει ποιότητα λέγω καθ᾿ ἣν ποιοί τινες λέγονται (τὸ γὰρ ποιὸν τὸ δεδεγμένον σημαίνει τὸν χαρακτῆρα·", "seq": 4462}
{"id": "Elias_Passim_4463", "series": "CAG", "text": "ἔστι γὰρ ἐν ἑκάστῃ κατηγορίᾳ χαρακτήρ, πᾶς δὲ χαρακτὴρ ποιότητος ἴδιον), ἢ τὸ συναμφότερον, ὅτε καὶ τῶν πρός τι·", "seq": 4463}
{"id": "Elias_Passim_4464", "series": "CAG", "text": "εἰ μὴ γὰρ τὰ ἀμφότερά τις νοήσει, τὸ δεδεγμένον, τοῦτ᾿ ἔστι τὸ πεποιωμένον, ἅμα τῇ ποιότητι, οὐ δύναται εἰπεῖν αὐτὰ τῶν πρός τι.", "seq": 4464}
{"id": "Elias_Passim_4465", "series": "CAG", "text": "ἐφ᾿ οἷς καὶ ἀποροῦσιν ὅτι διὰ τί ἐν τῇ ἐπιγραφῇ τὸ ποιὸν τῆς ποιότητος προέταξε.", "seq": 4465}
{"id": "Elias_Passim_4466", "series": "CAG", "text": "καὶ λέγομεν ὅτι ὡς σαφέστερον·", "seq": 4466}
{"id": "Elias_Passim_4467", "series": "CAG", "text": "σαφέστερον γὰρ τὸ δεδεγμένον αὐτῆς τῆς ποιότητος.", "seq": 4467}
{"id": "Elias_Passim_4468", "series": "CAG", "text": "πάλιν ἀποροῦσι διὰ τί ἐν ταῖς ὑπογραφαῖς προέταξε τὴν ὑπογραφὴν τῆς ποιότητος τῆς ὑπογραφῆς τοῦ ποιοῦ.", "seq": 4468}
{"id": "Elias_Passim_4469", "series": "CAG", "text": "καὶ λέγομεν ὅτι εὐλόγως·", "seq": 4469}
{"id": "Elias_Passim_4470", "series": "CAG", "text": "σαφεστέρα γὰρ ἡ ὑπογραφὴ τῆς ποιότητος ὡς ἐκ τοῦ πεποιωμένου γενομένη τῆς ὑπογραφῆς τοῦ ποιοῦ ἐκ τῆς ποιότητος γενομένης ἀσαφεστέρας οὔσης.", "seq": 4470}
{"id": "Elias_Passim_4471", "series": "CAG", "text": "ἔστι δὲ καὶ ἄλλη τις ἀπορία·", "seq": 4471}
{"id": "Elias_Passim_4472", "series": "CAG", "text": "ἐπειδὴ ἀνωτέρω ἐλέγομεν ἐπὶ τῶν πρός τι μὴ εἶναι μετέχον καὶ μετεχόμενον, ἐπειδὴ τὰ πρός τι ἀντίκειται ἀλλήλοις, πῶς λέγομεν ἐπὶ ποιότητος πρός τι, ἐπειδὴ ἡ ποιότης πεποιωμένου ποιότης καὶ τὸ ἀνάπαλιν;", "seq": 4472}
{"id": "Elias_Passim_4473", "series": "CAG", "text": "μετέχει γὰρ τὸ πεποιωμένον τῆς ποιότητος.", "seq": 4473}
{"id": "Elias_Passim_4474", "series": "CAG", "text": "ἔστι δὲ καὶ ἡ λύσις αὕτη·", "seq": 4474}
{"id": "Elias_Passim_4475", "series": "CAG", "text": "ὅτι οὔτε ἡ ποιότης ποτὲ κυρίως πρός τι (καθ᾿ αὑτὸ γάρ), οὔτε τὸ δεδεγμένον, ἀλλὰ κυρίως πρός τι ἐπὶ ποιότητος οἷον ἡ λεύκανσις, ἡ μέλανσις, ὡς σχέσις δύο πραγμάτων οὖσα·", "seq": 4475}
{"id": "Elias_Passim_4476", "series": "CAG", "text": "μία γὰρ ἡ σχέσις τῶν πρός τι, ὡς εἶναι τρία, λευκότητα, λελευκωμένον, λεύκανσιν.", "seq": 4476}
{"id": "Elias_Passim_4477", "series": "CAG", "text": "καὶ οὕτως ἐπὶ πάσης ποιότητος ἀναλόγως καὶ παντὸς πράγματος.", "seq": 4477}
{"id": "Elias_Passim_4478", "series": "CAG", "text": "καὶ ἄλλως λυτέον·", "seq": 4478}
{"id": "Elias_Passim_4479", "series": "CAG", "text": "ὅτι τὸ μέσον, ἡ λεύκανσις, ἡ θέρμανσις, αὐτὸ τὸ πρός τί ἐστι, τὸ ἐκφωνούμενον αὐτὸς ὁ χαρακτὴρ τοῦ πρός τι καὶ ἡ ποιότης (πᾶς γὰρ χαρακτὴρ ποιότητος), τὰ δὲ ἄκρα, οἷον τὸ θερμαῖνον καὶ τὸ θερμαινόμενον, τὰ πρός τί εἰσι τὰ πεπονθότα τὴν σχέσιν καὶ πληθυντικῶς ἐκφωνούμενα.", "seq": 4479}
{"id": "Elias_Passim_4480", "series": "CAG", "text": "οὐκ ἐπὶ πάντων δὲ κεῖνται τὰ ὀνόματα.", "seq": 4480}
{"id": "Elias_Passim_4481", "series": "CAG", "text": "ταῦτα ἔχει ἡ πρᾶξις.", "seq": 4481}
{"id": "Elias_Passim_4482", "series": "CAG", "text": "8b25 Ποιότητα δὲ λέγω καθ᾿ ἣν ποιοί τινες λέγονται.", "seq": 4482}
{"id": "Elias_Passim_4483", "series": "CAG", "text": "Τρίτον κεφάλαιον τῶν προτεθέντων εἰπεῖν τὴν διαίρεσιν τῆς ποιότητος.", "seq": 4483}
{"id": "Elias_Passim_4484", "series": "CAG", "text": "ἀλλ᾿ ἵνα γνῶμεν τὴν διαίρεσιν, τρία τινὰ αὐτῆς προλάβωμεν, τὴν ἀπαρίθμησιν τῶν εἰδῶν τὴν ψιλὴν καὶ τὴν ὑπογραφὴν αὐτῶν ἑκάστου καὶ τὴν διαφοράν.", "seq": 4484}
{"id": "Elias_Passim_4485", "series": "CAG", "text": "καὶ ἀρκτέον ἀπὸ τοῦ πρώτου.", "seq": 4485}
{"id": "Elias_Passim_4486", "series": "CAG", "text": "τέσσαρα τοίνυν εἴδη ποιότητος κατὰ συζυγίας προφερόμενα, ἕξις καὶ διάθεσις, δύναμις καὶ ἀδυναμία, παθητικὴ ποιότης καὶ πάθος, σχῆμα καὶ μορφή.", "seq": 4486}
{"id": "Elias_Passim_4487", "series": "CAG", "text": "τέσσαρα δὲ καὶ οὐχὶ ὀκτώ εἰσι τὰ εἴδη αὐτῆς, διότι κατὰ συζυγίας ταῦτα προφερόμενα τῷ μᾶλλον καὶ ἧττον διαφέρουσι, τὸ δὲ μᾶλλον καὶ ἧττον εἴδους ἐξαλλαγὴν οὐ ποιεῖ·", "seq": 4487}
{"id": "Elias_Passim_4488", "series": "CAG", "text": "ἕξις γὰρ καὶ διάθεσις τῷ μονιμωτέρῳ καὶ ὀλιγοχρονιωτέρῳ διαφέρουσι, δύναμις δὲ καὶ ἀδυναμία τῷ εὐκόλῳ καὶ δυσκόλῳ.", "seq": 4488}
{"id": "Elias_Passim_4489", "series": "CAG", "text": "παθητικὴ δὲ ποιότης καὶ πάθος διαφέρουσιν, ὅτι παγιούμενον τὸ πάθος εἰς παθητικὴν ποιότητα μεταβάλλει.", "seq": 4489}
{"id": "Elias_Passim_4490", "series": "CAG", "text": "ἀλλὰ καὶ σχῆμα καὶ μορφὴ τῷ μᾶλλον καὶ ἧττον διαφέρουσι·", "seq": 4490}
{"id": "Elias_Passim_4491", "series": "CAG", "text": "τὸ γὰρ σχῆμα περὶ τὰ κατ᾿ ἐπίνοιαν λαμβάνεται, οἷον τρίγωνον ἢ τετράγωνον, ἡ μορφὴ ἐπὶ τῶν φυσικῶν·", "seq": 4491}
{"id": "Elias_Passim_4492", "series": "CAG", "text": "εἰκόνες δὲ τὰ ἐπινοήματα τῶν φυσικῶν, καὶ διὰ τοῦτο ** ὑφειμέναι εἰσὶν αἱ εἰκόνες τῶν ὧν εἰσιν εἰκόνες.", "seq": 4492}
{"id": "Elias_Passim_4493", "series": "CAG", "text": "καὶ Ἀριστοτέλης δὲ τὴν μορφὴν ἐπὶ τῶν φυσικῶν οἶδε λέγων σχῆμά τε καὶ ἡ περὶ ἕκαστον ὑπάρχουσα μορφή, διὰ τοῦ ἕκαστον τὸ φυσικὸν αἰνιττόμενος.", "seq": 4493}
{"id": "Elias_Passim_4494", "series": "CAG", "text": "καὶ ταῦτα μὲν περὶ τούτων.", "seq": 4494}
{"id": "Elias_Passim_4495", "series": "CAG", "text": "Ἐφ᾿ οἷς τὰς ὑπογραφὰς αὐτῶν λεκτέον.", "seq": 4495}
{"id": "Elias_Passim_4496", "series": "CAG", "text": "ἕξις τοίνυν ἐστὶ ποιότης δυσαπόβλητος τελειωτικὴ ἢ κακωτικὴ τοῦ ὑποκειμένου, τελειωτικὴ μὲν ὡς ἐπιστήμη καὶ ἀρετὴ καὶ ἡ τῶν πεντάθλων ὑγίεια, κακωτικὴ δὲ ὡς λῃστρική, ἑκτικὸς πυρετός.", "seq": 4496}
{"id": "Elias_Passim_4497", "series": "CAG", "text": "διάθεσις δέ ἐστιν ἡ εἰς ἕξιν ὁδός.", "seq": 4497}
{"id": "Elias_Passim_4498", "series": "CAG", "text": "δύναμις δέ ἐστιν ἐπιτηδειότητος προκοπή, ἀδυναμία δὲ ἡ δυσκολία, καθώς φαμεν τὸν νωθῆ ἀδυνάτως ἔχειν πρὸς γεωμετρίας μάθησιν.", "seq": 4498}
{"id": "Elias_Passim_4499", "series": "CAG", "text": "καὶ αὕτη δὲ ἡ ἀδυναμία ἤγουν δυσκολία καὶ ἡ δύναμις ἤγουν ἡ εὐκολία, ἤτοι ἐπιτηδειότητος προκοπή, ὑπὸ τὴν ποιότητα ἀνάγονται ὡς κράσει ἑπόμεναι, ὅθεν καὶ ἐπιτηδειότητα προκοπῆς τὴν δύναμιν λέγουσιν ὡς τῆς κράσεως, εἴ τινι ἕπεται, ἐπὶ τὸ βέλτιον προκοψάσης·", "seq": 4499}
{"id": "Elias_Passim_4500", "series": "CAG", "text": "ἡ γὰρ ἁπλῶς δύναμις, ἤγουν τὸ δύνασθαι, καὶ ἡ ἀδυναμία ταῦτα παντὶ ἀνθρώπῳ ἕπεται, ἐπειδὴ πᾶς ἄνθρωπος πρὸς πᾶσαν τέχνην καὶ ἐπιστήμην ἐπιτηδείως ἔχει, ἀδυναμίαν δὲ πάλιν πᾶς ἄνθρωπος ἔχει τοῦ ἵπτασθαι.", "seq": 4500}
{"id": "Elias_Passim_4501", "series": "CAG", "text": "διὸ ταῦτα πᾶσιν ἁπλῶς ὑπάρχοντα ἀνθρώποις ὡς νοῦ καὶ ἐπιστήμης δεκτικοῖς οὖσιν οὐσίαι εἰσί·", "seq": 4501}
{"id": "Elias_Passim_4502", "series": "CAG", "text": "τὸ γὰρ νοῦ καὶ ἐπιστήμης δεκτικὸν οὐσία τοῦ ἀνθρώπου.", "seq": 4502}
{"id": "Elias_Passim_4503", "series": "CAG", "text": "τὸ δὲ ἄλλο σημαινόμενον τὸ τῆς δυνάμεως καὶ ἀδυναμίας, ὡς μὴ πᾶσιν ὑπάρχον (τοῖς μὲν γὰρ δυσκολία ὑπάρχει τοῖς δὲ εὐκολία), ὑπὸ τὴν ποιότητα ἀνάγεται ὡς κράσει ἑπόμενον.", "seq": 4503}
{"id": "Elias_Passim_4504", "series": "CAG", "text": "παθητικὴ δὲ ποιότης ἐστὶν ἡ πάθει τινὶ συνεζευγμένη.", "seq": 4504}
{"id": "Elias_Passim_4505", "series": "CAG", "text": "τριττὴ δὲ αὕτη·", "seq": 4505}
{"id": "Elias_Passim_4506", "series": "CAG", "text": "ἢ γὰρ πάθος ἐμποιεῖ ἐν ἡμῖν, ἀπὸ πάθους δὲ οὐκ ἐγένετο, ὡς ἡ θερμότης τοῦ πυρός (αὕτη γὰρ πάθος ἐμποιοῦσα ἐν ἡμῖν θερμαίνουσα ἡμᾶς ἀπὸ πάθους οὐκ ἐγένετο), ἢ ἀπὸ πάθους μὲν ἐγένετο, πάθος δὲ οὐ ποιεῖ, ὡς τὰ χρώματα·", "seq": 4506}
{"id": "Elias_Passim_4507", "series": "CAG", "text": "ταῦτα γὰρ ἀπὸ πάθους ὄντα, τῆς κράσεως, ἐν ἡμῖν πάθος οὐ ποιοῦσι παρώνυμον ἑαυτοῖς·", "seq": 4507}
{"id": "Elias_Passim_4508", "series": "CAG", "text": "οὐδὲ γὰρ λευκαίνουσιν ἡμᾶς ὁρώμενα τὰ λευκὰ χρώματα ἢ μελαίνουσι τὰ μέλαινα, ὡς θερμαίνουσι τὰ θερμὰ πάθος ἐμποιοῦντα παρώνυμον ἑαυτοῖς·", "seq": 4508}
{"id": "Elias_Passim_4509", "series": "CAG", "text": "εἰ γὰρ καὶ συγκρίνουσι μὲν τὰ μέλαινα τὴν ὁρῶσαν ὄψιν διακρίνουσι δὲ τὰ λευκά, ἀλλὰ παρώνυμον πάθος ἑαυτοῖς οὐ ποιοῦσιν, ὥσπερ ἐλέγομεν τὸ θερμὸν θερμαίνειν καὶ τὸ γλυκὺ γλυκαίνειν.", "seq": 4509}
{"id": "Elias_Passim_4510", "series": "CAG", "text": "ἄλλο τρίτον εἶδος τῆς παθητικῆς ποιότητος τὸ καὶ ἀπὸ πάθους γινόμενον καὶ πάθος ποιοῦν, ὡς ἡ τοῦ ζωμοῦ γλυκύτης·", "seq": 4510}
{"id": "Elias_Passim_4511", "series": "CAG", "text": "αὕτη γὰρ καὶ ἀπὸ πάθους ἐγένετο, τῆς καρυκείας, καὶ πάθος ἐμποιεῖ τῇ γεύσει.", "seq": 4511}
{"id": "Elias_Passim_4512", "series": "CAG", "text": "πάθος δέ ἐστιν ἡ εἰς παθητικὴν ποιότητα ὁδός.", "seq": 4512}
{"id": "Elias_Passim_4513", "series": "CAG", "text": "ἰστέον δὲ ὅτι παθητικὴν ποιότητα ἀπὸ πάθους γινομένην ἐκείνην βούλεται ὁ Ἀριστοτέλης εἶναι, ἥτις συμβαίνει τοῖς σώμασι καὶ πάλιν ἀποσυμβαίνει, τοῦ κατὰ τὴν οὐσίαν <λόγου> τοῦ προτέρου εἴδους αὐτοῦ τοῦ ὑποκειμένου σώματος τοῦ πάσχοντος ἀτρέπτου μένοντος καὶ φυλαττομένου, οἷον ὡς ἐπὶ λίθου λευκαινομένου ἢ μελαινομένου ἢ ἀνθρώπου αὐτὸ τοῦτο πάσχοντος·", "seq": 4513}
{"id": "Elias_Passim_4514", "series": "CAG", "text": "ἡ γὰρ τῶν τοιούτων λευκότης ἢ μελανία ἢ ἄλλο ὁποιονοῦν χρῶμα, οὕτω συμβαῖνον αὐτοῖς, οὐ ποιεῖ ἐν ἡμῖν ἢ ἐν ἄλλοις σώμασι παρώνυμον ἑαυτῷ πάθος·", "seq": 4514}
{"id": "Elias_Passim_4515", "series": "CAG", "text": "εἰ γὰρ ποιήσει, ὑπὸ ἄλλο εἶδος πεσεῖται τῆς ποιότητος, τὸ πρῶτον·", "seq": 4515}
{"id": "Elias_Passim_4516", "series": "CAG", "text": "οὐ γὰρ παθητικὴ ποιότης ἀπὸ πάθους γινομένη ἡ γλυκύτης τοῦ μέλιτος καὶ ἡ λευκότης τῆς χιόνος ἢ τοῦ ψιμυθίου·", "seq": 4516}
{"id": "Elias_Passim_4517", "series": "CAG", "text": "ταῦτα γὰρ οὐσίαι αὐτῶν εἰσι καὶ οὐκ ἐπιγίνονται ἄλλοις σώμασιν ἄτρεπτον φυλάξασι τὸ οἰκεῖον εἶδος, ὡς ἄνθρωπος λευκαινόμενος ἢ μελαινόμενος καὶ φυλάττων τὸ ἀνθρώπειον εἶδος·", "seq": 4517}
{"id": "Elias_Passim_4518", "series": "CAG", "text": "ἡ γὰρ γλυκύτης τοῦ μέλιτος καὶ ἡ λευκότης τῆς χιόνος εἴδη ὄντα οὐ γίνονται καὶ ἀπογίνονται χωρὶς φθορᾶς τοῦ ὑποκειμένου, ὡς ἡ λευκότης τοῦ κηροῦ.", "seq": 4518}
{"id": "Elias_Passim_4519", "series": "CAG", "text": "σχῆμα δὲ ἡ τοῦ παντὸς ὄγκου ἀποπεράτωσις, οἷον ῥινὸς ἢ ὠτὸς ἢ χείλους, μορφὴ δὲ ἡ τοῦ ὅλου εἴδους ἀποπεράτωσις, ὅλου, εἰ τύχοι, τοῦ προσώπου ἢ ὅλου ἀνθρώπου.", "seq": 4519}
{"id": "Elias_Passim_4520", "series": "CAG", "text": "αὗταί εἰσιν αὐτῶν αἱ ὑπογραφαί.", "seq": 4520}
{"id": "Elias_Passim_4521", "series": "CAG", "text": "Ἐφ᾿ οἷς εἴπωμεν καὶ τὰς διαφορὰς αὐτῶν.", "seq": 4521}
{"id": "Elias_Passim_4522", "series": "CAG", "text": "διαφέρει τοίνυν ἡ δύναμις καὶ ἀδυναμία τῶν λοιπῶν εἰδῶν, ὅτι ταῦτα μὲν δυνάμει ἐκεῖνα δὲ ἐνεργείᾳ.", "seq": 4522}
{"id": "Elias_Passim_4523", "series": "CAG", "text": "ἐν δὲ τοῖς ἐνεργείᾳ σχῆμα καὶ μορφὴ διαφέρει τῶν λοιπῶν δύο, ὅτι τὰ μὲν ἐπιπολῆς τὰ δὲ ἐν βάθει·", "seq": 4523}
{"id": "Elias_Passim_4524", "series": "CAG", "text": "διὰ βάθους γὰρ ἡ ἕξις καὶ ἡ παθητικὴ ποιότης.", "seq": 4524}
{"id": "Elias_Passim_4525", "series": "CAG", "text": "ἐν δὲ τοῖς διὰ βάθους διαφέρει παθητικῆς ποιότητος ἡ ἕξις, τῆς ἀπὸ πάθους μὲν γινομένης μὴ μέντοι πάθος ποιούσης, ὅτι καὶ αὕτη ἐπιπολῆς ἡ δὲ διὰ βάθους, ἡ ἕξις φημί, τῆς πάθος ἐμποιούσης οὐ μὴν ἀπὸ πάθους γεγενημένης διαφέρει, ὅτι ἡ μὲν πρὸς τὸ ἐν ᾧ ὑπάρχει ὑποκείμενον, τὴν ψυχήν, λέγεται, <ἡ> ἕξις, ἡ δὲ πρὸς τὸ περὶ ὃ ἐνεργεῖ·", "seq": 4525}
{"id": "Elias_Passim_4526", "series": "CAG", "text": "ἐν ἄλλῳ γὰρ ποιεῖ τὸ πάθος ἡ θερμότης ἐν ἄλλῳ αὐτὴ οὖσα ὑποκειμένῳ.", "seq": 4526}
{"id": "Elias_Passim_4527", "series": "CAG", "text": "τῆς δὲ ἀπὸ πάθους γεγενημένης καὶ πάθος ἐμποιούσης διαφέρει ἡ ἕξις, ὅτι ἡ μὲν μᾶλλον ἅπτεται τῆς οὐσίας, ἡ ἕξις, ἡ δὲ οὐχ οὕτως.", "seq": 4527}
{"id": "Elias_Passim_4528", "series": "CAG", "text": "αὗται αὐτῶν καὶ αἱ διαφοραί.", "seq": 4528}
{"id": "Elias_Passim_4529", "series": "CAG", "text": "Ἐφ᾿ οἷς εἴπωμεν καὶ τὴν διαίρεσιν τῆς ποιότητος (ἔστι δὲ καὶ ἄλλως διελεῖν τὴν ποιότητα, ὡς οἶμαι)·", "seq": 4529}
{"id": "Elias_Passim_4530", "series": "CAG", "text": "ἡ ποιότης ἢ δυνάμει καὶ ποιεῖ δύναμιν καὶ ἀδυναμίαν, ἢ ἐνεργείᾳ καὶ ἐπιπολῆς καὶ ποιεῖ σχῆμα καὶ μορφὴν καὶ τὰ περὶ τὴν ἐπιφάνειαν χρώματα, ἢ διὰ βάθους.", "seq": 4530}
{"id": "Elias_Passim_4531", "series": "CAG", "text": "καὶ εἰ διὰ βάθους, ἢ ἅπτεται τῆς οὐσίας ἢ οὐχ ἅπτεται.", "seq": 4531}
{"id": "Elias_Passim_4532", "series": "CAG", "text": "καὶ εἰ μὴ ἅπτεται, ποιεῖ τὴν παθητικὴν ποιότητα τὴν ἀπὸ πάθους γινομένην καὶ πάθος μὴ ποιοῦσαν.", "seq": 4532}
{"id": "Elias_Passim_4533", "series": "CAG", "text": "εἰ δὲ ἅπτεται τῆς οὐσίας, ἢ <πρὸς τὸ> περὶ ὃ ἐνεργεῖ καὶ ποιεῖ τὴν παθητικὴν ποιότητα τὴν ἀπὸ πάθους μὲν μὴ γινομένην πάθος δὲ ποιοῦσαν, ἢ πρὸς τὸ ἐν ᾧ ὑπάρχει ὑποκείμενον καὶ ποιεῖ τὴν ἕξιν.", "seq": 4533}
{"id": "Elias_Passim_4534", "series": "CAG", "text": "ἢ μᾶλλον ἅπτεται τῆς οὐσίας καὶ ποιεῖ πάλιν τὴν ἕξιν, ἢ ἧττον καὶ ποιεῖ τὴν παθητικὴν ποιότητα τὴν ἀπὸ πάθους γινομένην καὶ πάθος ἐμποιοῦσαν.", "seq": 4534}
{"id": "Elias_Passim_4535", "series": "CAG", "text": "καὶ ταῦτα μὲν περὶ τούτου.", "seq": 4535}
{"id": "Elias_Passim_4536", "series": "CAG", "text": "Ἐφ᾿ οἷς εἴπωμεν τὸ τέταρτον κεφάλαιον τὸ περὶ τῆς τάξεως αὐτῶν.", "seq": 4536}
{"id": "Elias_Passim_4537", "series": "CAG", "text": "δεῖ εἰδέναι ὅτι πρώτη ἡ ἕξις τῶν λοιπῶν ὡς ἐν ποιότητι οὐσία, δευτέρα δὲ ἡ δύναμις ὡς καὶ αὐτῆς τῆς ἕξεως ὀφείλουσα προηγεῖσθαι τῷ χρόνῳ, εἴ γε διὰ τοῦ δύνασθαί τινα εὐκόλως ἔχειν πρὸς γραμματικὴν ἐν ἕξει ταύτης γίνεται, εἰ μὴ ὅτι τὰ τέλεια τῶν ἀτελῶν ἔδει προηγεῖσθαι, τελειοτέρα δὲ ἡ ἕξις τῆς δυνάμεως.", "seq": 4537}
{"id": "Elias_Passim_4538", "series": "CAG", "text": "παθητικὴ δὲ ποιότης σχήματος καὶ μορφῆς προηγεῖται, ὅτι αὐτὴ μὲν ἅπτεται τῆς οὐσίας, σχῆμα δὲ καὶ μορφὴ οὐχ ἅπτεται τῆς οὐσίας.", "seq": 4538}
{"id": "Elias_Passim_4539", "series": "CAG", "text": "8b25 Ποιότητα δὲ λέγω καθ᾿ ἣν ποιοί τινες λέγονται.", "seq": 4539}
{"id": "Elias_Passim_4540", "series": "CAG", "text": "Ἐπιγράψας ὁ Ἀριστοτέλης Περὶ ποιοῦ καὶ ποιότητος τὴν παροῦσαν κατηγορίαν, ἑκάτερον ὑπογράφει καὶ δι᾿ ἀλλήλων αὐτὰ ὑπογράφει νόμῳ τῶν πρός τι.", "seq": 4540}
{"id": "Elias_Passim_4541", "series": "CAG", "text": "καὶ πρότερον ὑπογράφει τὴν ποιότητα διὰ δύο αἰτίας·", "seq": 4541}
{"id": "Elias_Passim_4542", "series": "CAG", "text": "ἢ ὅτι ἡ ποιότης ἡ κατηγορία, οὐ τὸ πεποιωμένον, ἢ ὅτι σαφεστέρα ἡ ὑπογραφὴ τῆς ποιότητος ἐκ τοῦ πεποιωμένου γενομένη σαφοῦς ὄντος ἤπερ ἡ ὑπογραφὴ τοῦ πεποιωμένου ἐκ τῆς ποιότητος γενομένη ἀσαφοῦς οὔσης.", "seq": 4542}
{"id": "Elias_Passim_4543", "series": "CAG", "text": "ἔχει δὲ ἡ ὑπογραφὴ οὕτως·", "seq": 4543}
{"id": "Elias_Passim_4544", "series": "CAG", "text": "ποιότητα δὲ λέγω καθ᾿ ἣν ποιοί τινες λέγονται.", "seq": 4544}
{"id": "Elias_Passim_4545", "series": "CAG", "text": "δεῖ δὲ προσυπακούεσθαι τὸ ἢ ὁπωσοῦν ἄλλως λεγόμενον μὲν ἐν τῇ τοῦ ποιοῦ ὑπογραφῇ ὑπὸ τοῦ Ἀριστοτέλους ὀφεῖλον δὲ κατὰ κοινοῦ προσυπακούεσθαι.", "seq": 4545}
{"id": "Elias_Passim_4546", "series": "CAG", "text": "πρόσκειται δὲ τὸ ἢ ὁπωσοῦν ἄλλως [ἐπειδὴ δὲ οὐδὲ πᾶσα ποιότης παρωνύμως κατηγορεῖται, οὐδὲ πᾶν τὸ παρωνύμως κατηγορούμενον ποιότης·", "seq": 4546}
{"id": "Elias_Passim_4547", "series": "CAG", "text": "ἰδοὺ γὰρ τὰ πατρωνυμικὰ παρώνυμα οὔκ εἰσι ποιότητες ἀλλ᾿ οὐσίαι], ἐπειδὴ ἡ ποιότης οὐ μόνον παρωνύμως κατηγορεῖται ἀλλὰ καὶ ἑτέρως·", "seq": 4547}
{"id": "Elias_Passim_4548", "series": "CAG", "text": "τετραχῶς γὰρ ἡ ποιότης κατηγορεῖται, παρωνύμως ὁμωνύμως ἑτερωνύμως ἀκατονομάστως.", "seq": 4548}
{"id": "Elias_Passim_4549", "series": "CAG", "text": "παρωνύμως μὲν ὡς ἀπὸ τῆς ποιότητος ποιοὶ ἀπὸ τῆς γραμματικῆς γραμματικός, ἀπὸ τῆς ἰατρικῆς ἰατρός, ὁμωνύμως δὲ δὲ ὡς ἀπὸ τῆς μουσικῆς μουσικὴ γυνή·", "seq": 4549}
{"id": "Elias_Passim_4550", "series": "CAG", "text": "μουσικὴ γὰρ ἡ ἐπιστήμη λέγεται.", "seq": 4550}
{"id": "Elias_Passim_4551", "series": "CAG", "text": "ἑτερωνύμως δὲ κατηγορεῖται ἡ ποιότης ὡς ἀρετὴ καὶ σπουδαῖος·", "seq": 4551}
{"id": "Elias_Passim_4552", "series": "CAG", "text": "ὁ γὰρ σπουδαῖος οὐχ ὡς ἀπὸ τῆς σπουδῆς·", "seq": 4552}
{"id": "Elias_Passim_4553", "series": "CAG", "text": "ἡ γὰρ σπουδὴ καὶ ἐπὶ κακῷ φέρεται.", "seq": 4553}
{"id": "Elias_Passim_4554", "series": "CAG", "text": "οὐδὲ ἀπὸ τῆς περὶ τὰ δέοντα σπουδῆς σπουδαῖος εἴρηται·", "seq": 4554}
{"id": "Elias_Passim_4555", "series": "CAG", "text": "τὰ γὰρ παρώνυμα ἀπὸ ὀνόματος καὶ οὐχὶ ἀπὸ λόγου·", "seq": 4555}
{"id": "Elias_Passim_4556", "series": "CAG", "text": "τοῦτο δὲ λόγος τὸ εἰπεῖν ἀπὸ τῆς περὶ τὰ δέοντα σπουδῆς.", "seq": 4556}
{"id": "Elias_Passim_4557", "series": "CAG", "text": "οὐδὲ ἀπὸ τῆς ἀρετῆς ἐνάρετος·", "seq": 4557}
{"id": "Elias_Passim_4558", "series": "CAG", "text": "οὐ γὰρ εὕρηται τοιαύτη χρῆσις·", "seq": 4558}
{"id": "Elias_Passim_4559", "series": "CAG", "text": "τὸ γὰρ παρὰ τῷ ποιητῇ", "seq": 4559}
{"id": "Elias_Passim_4560", "series": "CAG", "text": "οὐκ ἀρετὰ κακὰ ἔργα·", "seq": 4560}
{"id": "Elias_Passim_4561", "series": "CAG", "text": "κιχάνει τοι βραδὺς ὠκύν", "seq": 4561}
{"id": "Elias_Passim_4562", "series": "CAG", "text": "καὶ ποιητικὸν καὶ τῶν ἅπαξ εἰρημένων.", "seq": 4562}
{"id": "Elias_Passim_4563", "series": "CAG", "text": "τὸ δὲ ἐνάρετον τὸ μὲν διὰ τοῦ ε ψιλοῦ οὐχ εὕρηται, τὸ δὲ διὰ τῆς αι διφθόγγου καὶ ποιητικὸν καὶ ἐπὶ κακῷ εἴρηται.", "seq": 4563}
{"id": "Elias_Passim_4564", "series": "CAG", "text": "<ἀκατονομάστως δὲ> τὸ δεύτερον εἶδος τῆς ποιότητος, δύναμις καὶ ἀδυναμία·", "seq": 4564}
{"id": "Elias_Passim_4565", "series": "CAG", "text": "εἰ γὰρ ὠνομάσθη, πυκτικότης καὶ δρομικότης καὶ γραμματικότης ἂν ὠνομάσθη, ἅπερ οὐχ εὕρηται·", "seq": 4565}
{"id": "Elias_Passim_4566", "series": "CAG", "text": "τὸ γὰρ δρομικὸς ἀπὸ τῆς δρομικῆς, ἥτις τελεία ἐστὶν ἕξις, καὶ ἀπὸ τῆς ἰατρικῆς ἰατρικὸς <ὡς> ἀπὸ τῆς τελείας ἕξεως ὠνομάσθη.", "seq": 4566}
{"id": "Elias_Passim_4567", "series": "CAG", "text": "8b25 Ποιότητα δὲ λέγω.", "seq": 4567}
{"id": "Elias_Passim_4568", "series": "CAG", "text": "Τὸ λέγω εἶπεν, οὐχ ὅτι Ἀριστοτέλης τὸ ὄνομα τῆς ποιότητος ἔθηκεν (εἴρηται γὰρ καὶ Πλάτωνι), ἀλλ᾿ ὅτι Ἀριστοτέλης εἶπε τὴν <τῆς> παθητικῆς ποιότητος ἐξάπλωσιν·", "seq": 4568}
{"id": "Elias_Passim_4569", "series": "CAG", "text": "ὁ γὰρ Πλάτων οὐκ οἶδεν εἰ μὴ τὴν πάθος ποιοῦσαν περὶ τὴν αἴσθησιν·", "seq": 4569}
{"id": "Elias_Passim_4570", "series": "CAG", "text": "φησὶ γὰρ ἔν τινι διαλόγῳ οὕτως·", "seq": 4570}
{"id": "Elias_Passim_4571", "series": "CAG", "text": "‘ἡ γὰρ ποιότης ποιόν τι.", "seq": 4571}
{"id": "Elias_Passim_4572", "series": "CAG", "text": "καὶ ἴσως ἀλλόκοτον δόξει σοι τὸ τῆς ποιότητος ὄνομα καὶ οὐ μανθάνεις οὕτως ἀθρόως λεγόμενον·", "seq": 4572}
{"id": "Elias_Passim_4573", "series": "CAG", "text": "ἐὰν γὰρ εἴπωμεν οὕτως ποιότης, ἄδηλόν τι σημαίνει τὸ τῆς ποιότητος ὄνομα.", "seq": 4573}
{"id": "Elias_Passim_4574", "series": "CAG", "text": "εἰ δὲ εἴπωμεν ποιόν τι, εἰς ἔννοιαν ἐρχόμεθα ὅτι ποιότης εἴρηται ἀπὸ τοῦ ποιεῖν τι περὶ τὴν αἴσθησιν.’", "seq": 4574}
{"id": "Elias_Passim_4575", "series": "CAG", "text": "8b25 Καθ᾿ ἣν ποιοί τινες.", "seq": 4575}
{"id": "Elias_Passim_4576", "series": "CAG", "text": "Τὸ καθ᾿ ἣν πρόσκειται διὰ τὴν διὰ φόβον ὠχρίασιν καὶ τὸ ἔρευθος τὸ δι᾿ αἰδῶ·", "seq": 4576}
{"id": "Elias_Passim_4577", "series": "CAG", "text": "οὐ γὰρ λέγεται ἐρυθρίας ὁ δι᾿ αἰδῶ ἐρυθριάσας ἢ ὠχρίας ὁ διὰ φόβον ὠχριάσας (φθάνει γὰρ τὴν προσηγορίαν ἡ μεταβολή), ἀλλὰ μᾶλλον ταῦτα ὑπὸ τὸ πάσχειν ἀνάγεται.", "seq": 4577}
{"id": "Elias_Passim_4578", "series": "CAG", "text": "ἀποροῦσι δὲ διὰ τί τετραχῶς τῆς ποιότητος κατηγορουμένης τῶν παρωνύμων μόνων ἐμνήσθη.", "seq": 4578}
{"id": "Elias_Passim_4579", "series": "CAG", "text": "καὶ λέγομεν ὅτι τὸ πλεονάζον προέταξε·", "seq": 4579}
{"id": "Elias_Passim_4580", "series": "CAG", "text": "τὸ γὰρ ἀκατονομάστως καὶ ὁμωνύμως <καὶ ἑτερωνύμος> δύο μόνα εἴδη περιέχει τῆς ποιότητος, μόνη δὲ ἡ παρώνυμος κατηγορία δύο εἴδη περιέχει, ἴσως καὶ τρία·", "seq": 4580}
{"id": "Elias_Passim_4581", "series": "CAG", "text": "λέγεται γὰρ εὔσχημος καὶ εὔμορφος ἀπὸ σχήματος καὶ μορφῆς καὶ τὸ ἀνάπαλιν.", "seq": 4581}
{"id": "Elias_Passim_4582", "series": "CAG", "text": "λέγεται καὶ ἀπὸ ἕξεως καὶ διαθέσεως ἡ παρωνυμία, καὶ τὰ παραδείγματα δῆλα, γραμματικός, ἰατρικός.", "seq": 4582}
{"id": "Elias_Passim_4583", "series": "CAG", "text": "ἀλλὰ καὶ ἀπὸ παθητικῆς ποιότητος·", "seq": 4583}
{"id": "Elias_Passim_4584", "series": "CAG", "text": "αὕτη γὰρ παρώνυμον ἑαυτῇ ποιεῖ πάθος ἐν ἡμῖν, καὶ τὰ παραδείγματα εἴρηται.", "seq": 4584}
{"id": "Elias_Passim_4585", "series": "CAG", "text": "8b26 Ἓν μὲν οὖν εἶδος ποιότητος ἕξις καὶ διάθεσις.", "seq": 4585}
{"id": "Elias_Passim_4586", "series": "CAG", "text": "Ὑπογράψας ὁ Ἀριστοτέλης τὴν ποιότητα ἔρχεται καὶ ἐπὶ τὰ εἴδη τῆς ποιότητος.", "seq": 4586}
{"id": "Elias_Passim_4587", "series": "CAG", "text": "ἀλλὰ πρὸς τοῦτο ζητήσωμεν πῶς διαιρεῖται ἡ ποιότης·", "seq": 4587}
{"id": "Elias_Passim_4588", "series": "CAG", "text": "οἱ μὲν <γὰρ> ὡς γένος αὐτήν φασι διαιρεῖσθαι οἱ δὲ ὡς ὁμώνυμον φωνήν·", "seq": 4588}
{"id": "Elias_Passim_4589", "series": "CAG", "text": "οἱ μὲν γὰρ λέγοντες ὡς γένος εἰς εἴδη διαιρεῖσθαι ἔλεγον διὰ τριῶν ἐπιχειρημάτων.", "seq": 4589}
{"id": "Elias_Passim_4590", "series": "CAG", "text": "ἑνὸς μὲν τοῦ λέγοντος ἓν μὲν οὖν εἶδος τῆς ποιότητος (τὸ γὰρ εἶδος πάντως γένους), δευτέρου ὅτι πανταχοῦ δέκα ἀπαριθμεῖται τὰ γενικώτατα ὡς ἂν καὶ ποιότητος γένους οὔσης, τρίτου ἐπεὶ ποτὲ μὲν γένη καλεῖ αὐτὰ ποτὲ δὲ καὶ εἴδη ὡς ὑπάλληλα·", "seq": 4590}
{"id": "Elias_Passim_4591", "series": "CAG", "text": "τὰ γὰρ ὑπάλληλα ὑπὸ ἓν γένος τελοῦσιν.", "seq": 4591}
{"id": "Elias_Passim_4592", "series": "CAG", "text": "οἱ δὲ λέγοντες ὅτι ὡς ὁμώνυμος φωνὴ διαιρεῖται ἔλεγον οὕτως, ὅτι λέγει αὐτὸς ὁ Ἀριστοτέλης ἔστι δὲ ἡ ποιότης τῶν πλεοναχῶς λεγομένων·", "seq": 4592}
{"id": "Elias_Passim_4593", "series": "CAG", "text": "τὸ δὲ πλεοναχῶς λέγεσθαι ὁμωνύμου φωνῆς.", "seq": 4593}
{"id": "Elias_Passim_4594", "series": "CAG", "text": "ἀλλὰ καὶ τάξιν ἐπεδέξατο τὰ εἴδη·", "seq": 4594}
{"id": "Elias_Passim_4595", "series": "CAG", "text": "προτέτακται γὰρ ἡ ἕξις τῶν λοιπῶν·", "seq": 4595}
{"id": "Elias_Passim_4596", "series": "CAG", "text": "ἐν δὲ τοῖς ὡς γένος εἰς εἴδη διαιρουμένοις οὐκ ἔστι τάξιν εὑρεῖν.", "seq": 4596}
{"id": "Elias_Passim_4597", "series": "CAG", "text": "ταῦτα μὲν οὗτοι.", "seq": 4597}
{"id": "Elias_Passim_4598", "series": "CAG", "text": "ὁ δὲ Συριανὸς βουλόμενος ὡς τὰ ἀφ᾿ ἑνὸς καὶ πρὸς ἓν διαιρεῖσθαι τὴν ποιότητα εἰς τὰ εἴδη ἀμφότερα ἀποδέχεται τὰ ἐπιχειρήματα, καὶ τὰ ὡς ὁμώνυμον λέγοντα τὴν διαίρεσιν καὶ τὰ ὡς γένος λέγοντα διαιρεῖσθαι·", "seq": 4598}
{"id": "Elias_Passim_4599", "series": "CAG", "text": "μέσα γὰρ ὄντα τὰ ἀφ᾿ ἑνὸς καὶ πρὸς ἓν ὁμωνύμων καὶ γενῶν δύνανται, φησί, τοῖς τῶν ἄκρων ὀνόμασιν ὀνομάζεσθαι.", "seq": 4599}
{"id": "Elias_Passim_4600", "series": "CAG", "text": "ὁ δὲ Ἀλέξανδρος βουλόμενος τὴν ποιότητα ὡς γένος εἰς εἴδη διαιρεῖσθαι, ἀπαντᾷ πρὸς τὰ δύο ἐπιχειρήματα, πρὸς μὲν τὸ πλεοναχῶς ὅτι οὐκ ἐπὶ ὁμωνύμου φωνῆς ἀεὶ λαμβάνεται·", "seq": 4600}
{"id": "Elias_Passim_4601", "series": "CAG", "text": "νῦν γὰρ ἐπὶ τοῦ παρωνύμως ὁμωνύμως ἑτερωνύμως ἀκατονομάστως εἴληπται, καὶ κεῖται νῦν ἐπὶ συνωνύμου κατηγορίας.", "seq": 4601}
{"id": "Elias_Passim_4602", "series": "CAG", "text": "οὕτως μὲν πρὸς τὸ πρῶτον ἐπιχείρημα.", "seq": 4602}
{"id": "Elias_Passim_4603", "series": "CAG", "text": "πρὸς δὲ τὸ λέγον ὅτι τάξιν ἐπεδέξατο λέγει ὅτι τάξιν ἐπεδέξατο, οὐ τὴν κατὰ τὸ τῆς φύσεως κοινόν (ποιὰ γὰρ ὁμοίως), ἀλλ᾿ ἡ ἕξις τῶν λοιπῶν ὡς τιμιωτέρα προβέβληται, διότι μονιμωτέρα ἡ ἕξις τῶν λοιπῶν.", "seq": 4603}
{"id": "Elias_Passim_4604", "series": "CAG", "text": "** καὶ εἰδοποιός, καὶ εἴποις ἂν τὴν μὲν ἀπὸ ἰατρικοῦ εἰς ἰατρὸν μεταβολὴν γένεσίν τινα, τὴν ἀπὸ ἀτελοῦς εἰς τέλειον, καὶ τὴν ἀπὸ ῥητορικοῦ εἰς ῥήτορα, τὴν δὲ ἀπὸ ῥήτορος εἰς ῥητορικὸν καὶ ἀπὸ ἰατροῦ εἰς ἰατρικὸν μεταβολὴν φθοράν.", "seq": 4604}
{"id": "Elias_Passim_4605", "series": "CAG", "text": "ἔτι δὲ ἰατρικὸς μὲν καὶ ῥητορικὸς ὁ τοῖς μαθήμασι τέως ἐνδιατρίβων καὶ μήπω τέλειος ὢν περὶ τὴν τοιαύτην ἐπιστήμην, ἰατρὸς δὲ καὶ ῥήτωρ ὁ περὶ ταῦτα τέλειος·", "seq": 4605}
{"id": "Elias_Passim_4606", "series": "CAG", "text": "γίνονται γὰρ τοιαῦται μεταβολαὶ ἀπὸ τοῦ κρείττονος ἐπὶ τὸ χεῖρον δι᾿ ἀμελετησίαν ἢ μῆκος χρόνου ἢ λήθην ὑπὸ πάθους ληθάργου, περὶ ἧς φησιν ὁ Θουκυδίδης ὅτι πιεζόμενοι ὑπὸ τῆς νόσου σφῶν τε αὐτῶν ἐπελάθοντο καὶ τῶν ἐπιτηδείων.", "seq": 4606}
{"id": "Elias_Passim_4607", "series": "CAG", "text": "Δεῖ δὲ εἰδέναι ὅτι τελειοτέρα ἡ ἕξις τῆς διαθέσεως·", "seq": 4607}
{"id": "Elias_Passim_4608", "series": "CAG", "text": "διαφέρει γὰρ ἡ ἕξις τῆς διαθέσεως τῷ μονιμωτέρῳ·", "seq": 4608}
{"id": "Elias_Passim_4609", "series": "CAG", "text": "μονιμωτέρα γὰρ ἡ ἕξις τῆς διαθέσεως.", "seq": 4609}
{"id": "Elias_Passim_4610", "series": "CAG", "text": "καὶ τοῦτο πιστοῦται ἐκ τῆς λεκτικῆς συνηθείας·", "seq": 4610}
{"id": "Elias_Passim_4611", "series": "CAG", "text": "τοὺς γὰρ ἑτοίμως ἐν τοῖς αὐτοῖς νῦν εἰς τἀναντία περιτρεπομένους δίκην Εὐρίπου φασὶ μὴ ἔχειν ἕξιν, ὡς ἂν τῆς ἕξεως τῷ μονίμῳ χαρακτηριζομένης.", "seq": 4611}
{"id": "Elias_Passim_4612", "series": "CAG", "text": "διττὴ δὲ ἡ διάθεσις, ἡ μὲν τῆς ἕξεως κατηγορουμένη ἡ δὲ ἀντιδιαιρουμένη.", "seq": 4612}
{"id": "Elias_Passim_4613", "series": "CAG", "text": "διὸ καὶ πλέκεται σόφισμα τοιοῦτον·", "seq": 4613}
{"id": "Elias_Passim_4614", "series": "CAG", "text": "ἡ ἕξις διάθεσις, ἡ διάθεσις οὐχ ἕξις, ἡ ἕξις ἄρα οὐχ ἕξις.", "seq": 4614}
{"id": "Elias_Passim_4615", "series": "CAG", "text": "καὶ λέγομεν ὅτι ὁμώνυμος ὁ μέσος·", "seq": 4615}
{"id": "Elias_Passim_4616", "series": "CAG", "text": "ὅτε γὰρ λέγει τις ‘ἡ ἕξις διάθεσις’, καθολικωτέραν τὴν διάθεσιν ἐποίησεν, ὅτε δὲ λέγει ‘ἡ διάθεσις οὐχ ἕξις’, τὴν ἀντιδιαιρουμένην λαμβάνει.", "seq": 4616}
{"id": "Elias_Passim_4617", "series": "CAG", "text": "οὐ δεῖ δὲ ἐν συλλογισμῷ τὸν μέσον ὅρον εἶναι ὁμώνυμον.", "seq": 4617}
{"id": "Elias_Passim_4618", "series": "CAG", "text": "εἶτά φασιν ὅτι ἔστω καθολικὸς ὁ μέσος, λέγοντες οὕτως·", "seq": 4618}
{"id": "Elias_Passim_4619", "series": "CAG", "text": "ἡ ἕξις διάθεσις, ἡ διάθεσις οὐχ ἕξις, ἡ ἕξις ἄρα οὐχ ἕξις.", "seq": 4619}
{"id": "Elias_Passim_4620", "series": "CAG", "text": "πρὸς ὅ φαμεν ὅτι ὅτε λέγεις ‘ἡ διάθεσις οὐχ ἕξις’, τί λέγεις;", "seq": 4620}
{"id": "Elias_Passim_4621", "series": "CAG", "text": "ὅτι οὐδεμία διάθεσις ἕξις;", "seq": 4621}
{"id": "Elias_Passim_4622", "series": "CAG", "text": "ἡ γὰρ διάθεσις κατηγορεῖται ἕξεως.", "seq": 4622}
{"id": "Elias_Passim_4623", "series": "CAG", "text": "εἰ δὲ λέγεις ὅτι ‘τοῦτο λέγω, ὅτι τὶς διάθεσις ἕξις’, ἄτοπον συνάγεται·", "seq": 4623}
{"id": "Elias_Passim_4624", "series": "CAG", "text": "ἐν γὰρ τῷ πρώτῳ σχήματι εὑρίσκεται ἡ μείζων πρότασις μερική, ὅπερ ἄτοπον.", "seq": 4624}
{"id": "Elias_Passim_4625", "series": "CAG", "text": "πάλιν δὲ ἀποροῦσιν ὅτι εἰ τῷ μονίμῳ διαφέρει ἕξις διαθέσεως καὶ εὐμεταβλήτῳ καὶ παθητικὴ δὲ ποιότης καὶ πάθος τῷ αὐτῷ διαφέρει, τί οὖν διοίσουσι.", "seq": 4625}
{"id": "Elias_Passim_4626", "series": "CAG", "text": "καί φαμεν ὅτι οὐ τὰ τῷ αὐτῷ διαφέροντα εἴδη τὰ αὐτά·", "seq": 4626}
{"id": "Elias_Passim_4627", "series": "CAG", "text": "θερμὸν γὰρ καὶ λευκὸν καὶ ψυχρὸν καὶ μέλαν τῷ διακριτικῷ καὶ συγκριτικῷ διαφέρουσι, καὶ ὅμως πολέμιον τὸ λευκὸν τῷ θερμῷ (μέλανες γὰρ οἱ θερμοὶ ὡς ἐπίπαν), καὶ ψυχρὸν μέλανι πολέμιον·", "seq": 4627}
{"id": "Elias_Passim_4628", "series": "CAG", "text": "λευκοὶ γὰρ οἱ ψυχροὶ ὡς ἐπίπαν.", "seq": 4628}
{"id": "Elias_Passim_4629", "series": "CAG", "text": "εἰ δὲ καὶ τοῖς αὐτοῖς κέχρηται παραδείγμασιν ἐπ᾿ ἀμφοτέροις, οἷον νόσῳ καὶ ὑγείᾳ καὶ θερμότητι καὶ τοῖς τοιούτοις ἄλλοις ὡς δυσμεταβλήτοις οὖσι, ταῦτα τὰ παραδείγματα μόνον.", "seq": 4629}
{"id": "Elias_Passim_4630", "series": "CAG", "text": "9a14 Ἕτερον δὲ γένος ποιότητος καθ᾿ ὃ πυκτικοὺς ἢ δρομικούς.", "seq": 4630}
{"id": "Elias_Passim_4631", "series": "CAG", "text": "Ἕξ τινα δεῖ προλαβεῖν τοῦ δευτέρου εἴδους τῆς ποιότητος·", "seq": 4631}
{"id": "Elias_Passim_4632", "series": "CAG", "text": "πρῶτον μὲν τί ἐστι δύναμις καὶ ἀδυναμία αὐτὰ κατὰ τὸ δεύτερον εἶδος, δεύτερον ὅτι εἰ πεφοίτηκε τοῦτο τὸ εἶδος διὰ ψυχῆς, διὰ σώματος, διὰ τοῦ συναμφοτέρου, τρίτον πῶς ἓν πλέγμα γένοιτο ἐκ τῶν δύο εἰδῶν τῆς ποιότητος, πρώτου καὶ δευτέρου, τέταρτον ποσαχῶς δύναται λέγεσθαι τὰ εἴδη ταῦτα καὶ ποσαχῶς νῦν λέγεται ὑπὸ Ἀριστοτέλους, πέμπτον περὶ ὀνομάτων δυνάμεως καὶ ἀδυναμίας, ἕκτον καθόλου περὶ ὀνομάτων ἕξεως, διαθέσεως, ἐπιτηδειότητος καὶ τῶν μετεχόντων, ἑκτοῦ, διακειμένου, ἐπιτηδείου.", "seq": 4632}
{"id": "Elias_Passim_4633", "series": "CAG", "text": "ἀλλ᾿ ἡ παροῦσα θεωρία τρία κεφάλαια παραδίδωσι.", "seq": 4633}
{"id": "Elias_Passim_4634", "series": "CAG", "text": "πρῶτον τί δύναμις καὶ ἀδυναμία;", "seq": 4634}
{"id": "Elias_Passim_4635", "series": "CAG", "text": "ὅτι δύναμίς ἐστιν ἐπιτηδειότης προκόψασα, ἢ ὡς ἔστιν <ἓν> ἀνθ᾿ ἑνὸς εἰπεῖν, δύναμίς ἐστιν εὐκολία, ἀδυναμία δὲ ἡ δυσκολία·", "seq": 4635}
{"id": "Elias_Passim_4636", "series": "CAG", "text": "οὕτω γὰρ δύνασθαί φαμεν τὸν ὀξὺν πρὸς γεωμετρίαν, μὴ δύνασθαι δὲ τὸν νωθῆ.", "seq": 4636}
{"id": "Elias_Passim_4637", "series": "CAG", "text": "καὶ ἄλλως ἢ ὅτι οὐχ ἁπλῶς φαμεν ὅτι δύναται ποιεῖν, ἀλλ᾿ ὅτι ῥᾳδίως δύναται ποιεῖν, καὶ οὐ δύναμίν φαμεν ἁπλῶς ἀλλὰ δύναμιν φυσικήν·", "seq": 4637}
{"id": "Elias_Passim_4638", "series": "CAG", "text": "ὡς γὰρ κρᾶσιν ἔχουσαν συνεργὸν καὶ διὰ τοῦτο ἐπιτηδειότητα οὖσαν προκόψασαν.", "seq": 4638}
{"id": "Elias_Passim_4639", "series": "CAG", "text": "ταῦτα μὲν περὶ δυνάμεως ζητείσθω.", "seq": 4639}
{"id": "Elias_Passim_4640", "series": "CAG", "text": "ἐφ᾿ οἷς τὸ δεύτερον κεφάλαιον, ἐν ᾧ δείκνυται ὅτι καὶ διὰ ψυχῆς κεχώρηκε καὶ σώματος δύναμις καὶ ἀδυναμία καὶ τοῦ συναμφοτέρου.", "seq": 4640}
{"id": "Elias_Passim_4641", "series": "CAG", "text": "διὰ μὲν ψυχῆς, ὡς ἐπὶ τῶν φυσικῶν ἀρετῶν καὶ ἠθικῶν·", "seq": 4641}
{"id": "Elias_Passim_4642", "series": "CAG", "text": "αὗται γὰρ ὠδίνουσι τὰς πολιτικάς, καὶ ὁ ἔχων μίαν τούτων διὰ τῆς τοῦ λόγου προσθήκης εὐχερῶς κτᾶται τὰς πολιτικάς.", "seq": 4642}
{"id": "Elias_Passim_4643", "series": "CAG", "text": "περὶ ὧν εἴρηται, περὶ μὲν τῶν φυσικῶν ‘τὸ γὰρ φύσει ἀκράτητον’, περὶ δὲ τῶν ἠθικῶν ‘ἔχει γάρ τι καὶ τὸ τραφῆναι καλῶς’, καὶ ὅτι Πλάτων ἀνδραποδώδεις αὐτὰς εἶναι λέγει, Πλωτῖνος δὲ ἀτελεῖς.", "seq": 4643}
{"id": "Elias_Passim_4644", "series": "CAG", "text": "ἀλλὰ καὶ διὰ σώματος χωρεῖ δύναμις καὶ ἀδυναμία, καθό φαμεν ὅτι τὸ σκληρὸν δύναμιν ἔχει τοῦ ποιῆσαι ἀδυναμίαν δὲ τοῦ παθεῖν, καὶ τὸ μαλακὸν ἀδυναμίαν ἔχει τοῦ ποιῆσαι δύναμιν δὲ τοῦ παθεῖν.", "seq": 4644}
{"id": "Elias_Passim_4645", "series": "CAG", "text": "διὰ δὲ τοῦ συναμφοτέρου, ὡς ἐπὶ νόσου καὶ ὑγείας·", "seq": 4645}
{"id": "Elias_Passim_4646", "series": "CAG", "text": "ὁ γὰρ ὑγιαίνων ἀδυναμίαν ἔχει τοῦ παθεῖν ὑπὸ λοιμοῦ εὐχερῶς δύναμιν δὲ τοῦ ποιῆσαι, ὁ δὲ νοσῶν τοὔμπαλιν.", "seq": 4646}
{"id": "Elias_Passim_4647", "series": "CAG", "text": "ταῦτα καὶ περὶ τοῦ δευτέρου κεφαλαίου.", "seq": 4647}
{"id": "Elias_Passim_4648", "series": "CAG", "text": "τρίτον κεφάλαιον·", "seq": 4648}
{"id": "Elias_Passim_4649", "series": "CAG", "text": "ζητείσθω πῶς ἓν πλέγμα γένοιτο ὑπὸ τούτων, εἴ γε οἱ εἰς τοῦ γραμματικοῦ φοιτῶντες πρῶτον δυσκολαίνουσιν, ἔπειτα ἐπιτηδειότητα φέρουσιν, εἶτα ἀμυδρὰν γνῶσιν λαμβάνουσι, καὶ εἶθ᾿ οὕτως τὴν τελείαν ἕξιν.", "seq": 4649}
{"id": "Elias_Passim_4650", "series": "CAG", "text": "καὶ ἔστι μὲν ἡ δυσκολία ἡ ἀδυναμία, εὐκολία δὲ ἡ δύναμις, ἡ δὲ ἀμυδρὰ γνῶσις διάθεσις, ἡ δὲ τελεία γνῶσις ἡ ἕξις.", "seq": 4650}
{"id": "Elias_Passim_4651", "series": "CAG", "text": "ἐφ᾿ οἷς ἀποροῦσιν·", "seq": 4651}
{"id": "Elias_Passim_4652", "series": "CAG", "text": "εἰ τῷ μᾶλλον καὶ ἧττον διαφέρουσι ταῦτα ἀλλήλων, διὰ τί μὴ ἓν εἶδος ἀλλὰ δύο;", "seq": 4652}
{"id": "Elias_Passim_4653", "series": "CAG", "text": "καὶ λέγομεν πρὸς τοῦτο ὅτι οὐ μόνον τῷ μᾶλλον καὶ ἧττον διαφέρουσιν, ἀλλὰ καὶ τῷ εἴδει·", "seq": 4653}
{"id": "Elias_Passim_4654", "series": "CAG", "text": "ὅπου μὲν γὰρ πάρεστι τὸ εἶδος, ὡς ἐπὶ ἕξεως καὶ διαθέσεως, ὅπου δὲ ἄπεστιν, ὡς ἐπὶ δυνάμεως καὶ ἀδυναμίας, καὶ ὅπου πάρεστι, μᾶλλον πάρεστιν, ὡς ἐπὶ ἕξεως ἤπερ ἐπὶ διαθέσεως, ὅπου δὲ ἄπεστι, μᾶλλον ἐπὶ ἀδυναμίας ἄπεστιν ἧττον δὲ ἐπὶ δυνάμεως.", "seq": 4654}
{"id": "Elias_Passim_4655", "series": "CAG", "text": "9a14 Ἕτερον δὲ γένος ποιότητος καθ᾿ ὃ πυκτικοὺς ἢ δρομικούς.", "seq": 4655}
{"id": "Elias_Passim_4656", "series": "CAG", "text": "Ἐπὶ τὰ λοιπὰ τῶν κεφαλαίων ἔλθωμεν.", "seq": 4656}
{"id": "Elias_Passim_4657", "series": "CAG", "text": "τέταρτον κεφάλαιον τῶν προτεθέντων τὸ ζητῆσαι ποσαχῶς δύναται λέγεσθαι δύναμις καὶ ἀδυναμία, καὶ ποσαχῶς λέγεται ὑπὸ Ἀριστοτέλους.", "seq": 4657}
{"id": "Elias_Passim_4658", "series": "CAG", "text": "ἰστέον ὅτι τετραχῶς δύναται λέγεσθαι·", "seq": 4658}
{"id": "Elias_Passim_4659", "series": "CAG", "text": "τεσσάρων γὰρ ὄντων, ποιεῖν, μὴ ποιεῖν, πάσχειν, μὴ πάσχειν, ἑκάστῳ τούτων συμπλέκεται ἡ δύναμις καὶ ἡ ἀδυναμία.", "seq": 4659}
{"id": "Elias_Passim_4660", "series": "CAG", "text": "καὶ τὰ παραδείγματα τούτων ῥητέον, οἷον ἐπὶ τοῦ ποιεῖν ‘δύναται ποιεῖν’ ‘δύναται μὴ ποιεῖν’, καὶ ἐπὶ τοῦ πάσχειν ‘δύναται πάσχειν’ ‘δύναται μὴ πάσχειν’.", "seq": 4660}
{"id": "Elias_Passim_4661", "series": "CAG", "text": "τοσαυταχῶς οὖν δυναμένης λέγεσθαι τῆς δυνάμεως καὶ τῆς ἀδυναμίας ὁ Ἀριστοτέλης οἰκείοις οἰκεῖα ἀποδιδοὺς καὶ εὐφήμοις εὔφημα τῷ ποιεῖν τὴν δύναμιν προσῆψε, τῷ δὲ πάσχειν τὴν ἀδυναμίαν, οἷον ὡς ἐπὶ σκληροῦ καὶ μαλακοῦ·", "seq": 4661}
{"id": "Elias_Passim_4662", "series": "CAG", "text": "ἐπὶ μὲν σκληροῦ ὅτι δύναται ποιεῖν μόνον εἶπε, δυνάμενος εἰπεῖν καὶ ὅτι οὐ δύναται πάσχειν, ἐπὶ δὲ μαλακοῦ ὅτι οὐ δύναται ποιεῖν μόνον εἶπε, δυνάμενος εἰπεῖν ὅτι δύναται πάσχειν.", "seq": 4662}
{"id": "Elias_Passim_4663", "series": "CAG", "text": "ἐν οἷς καὶ τὸ τέταρτον κεφάλαιον.", "seq": 4663}
{"id": "Elias_Passim_4664", "series": "CAG", "text": "πέμπτον κεφάλαιον τὸ ζητῆσαι περὶ ὀνομάτων δυνάμεως καὶ ἀδυναμίας.", "seq": 4664}
{"id": "Elias_Passim_4665", "series": "CAG", "text": "ἰστέον ὅτι ὅλον τὸ δεύτερον εἶδος τῆς ποιότητος ἀκατονόμαστόν ἐστι·", "seq": 4665}
{"id": "Elias_Passim_4666", "series": "CAG", "text": "τὸ γὰρ πυκτικὸν παιδίον καὶ τὸ δρομικὸν οὐκ ἀπὸ τῆς πυκτικῆς ἢ δρομικῆς παρωνομάσθη·", "seq": 4666}
{"id": "Elias_Passim_4667", "series": "CAG", "text": "πυκτικὴ γὰρ καὶ δρομικὴ αἱ τέλειαι ἕξεις, ἀφ᾿ ὧν ὁ πύκτης καὶ ὁ δρομεὺς οἱ τὰς τελείας ἔχοντες ἕξεις·", "seq": 4667}
{"id": "Elias_Passim_4668", "series": "CAG", "text": "εἰ γὰρ ὠνομάσθησαν αἱ ποιότητες, ἀφ᾿ ὧν παρωνομάσθησαν τὸ πυκτικὸν παιδίον καὶ τὸ δρομικόν, πυκτικότης ἂν ὠνομάζετο καὶ δρομικότης, ὧν τὰ ὀνόματα ἡ συνήθεια οὐκ ἔχει, οὐδὲ εἴρηνται παρά τινι ὀνόματα ταῦτα.", "seq": 4668}
{"id": "Elias_Passim_4669", "series": "CAG", "text": "ἐν οἷς καὶ τὸ πέμπτον κεφάλαιον.", "seq": 4669}
{"id": "Elias_Passim_4670", "series": "CAG", "text": "ἕκτον κεφάλαιον ἦν τῶν προτεθέντων τὸ ζητῆσαι καθόλου περὶ ὀνομάτων ἕξεως, διαθέσεως, ἐπιτηδειότητος καὶ τῶν μετεχόντων, ἑκτοῦ, διακειμένου, ἐπιτηδείου.", "seq": 4670}
{"id": "Elias_Passim_4671", "series": "CAG", "text": "δεῖ εἰδέναι ὅτι τούτων τὰ ἓξ τὰ μὲν ἀεὶ ὀνομάζει ἡ συνήθεια, οἷον ἕξιν καὶ ἑκτόν (γραμματικὴν γὰρ ὀνομάζει καὶ γραμματικόν), τὰ δὲ οὐδέποτε ὀνομάζει (διάθεσιν γὰρ οὐδέποτε ὀνομάζει οὐδὲ ἐπιτηδειότητα), τὰ δὲ ποτὲ μὲν ὀνομάζει ποτὲ δὲ οὐκ ὀνομάζει·", "seq": 4671}
{"id": "Elias_Passim_4672", "series": "CAG", "text": "ποτὲ μὲν γὰρ τὸν διακείμενον ὀνομάζει τὸν ἐπιτήδειον μὴ ὀνομάζουσα, καὶ τὸ ἀνάπαλιν, ὡς ἰατρικὸν καὶ ῥητορικὸν τὸν διακείμενον ἤδη καὶ πράξαντά τι τῆς τέχνης, τὸν δὲ ἐπιτηδείως πρὸς ταῦτα διακείμενον μήπω δὲ πράξαντα οὐκ ὀνομάζει.", "seq": 4672}
{"id": "Elias_Passim_4673", "series": "CAG", "text": "ἐπὶ δὲ τοῦ πυκτικοῦ βρέφους τὸ ἐπιτήδειον οὕτως ὀνομάζει τὸ ἔχον μακρὰ κῶλα, τὸν μέντοι διακείμενον οὐκ ὀνομάζει οὕτως.", "seq": 4673}
{"id": "Elias_Passim_4674", "series": "CAG", "text": "9a28 Τρίτον δὲ γένος ποιότητος παθητικαὶ ποιότητες καὶ πάθη.", "seq": 4674}
{"id": "Elias_Passim_4675", "series": "CAG", "text": "Ἡ παροῦσα θεωρία δύο κεφάλαια ἡμῖν παραδίδωσι, διάκρισιν τῶν παθητικῶν ποιοτήτων ἀπ᾿ ἀλλήλων ἐν πρώτῳ κεφαλαίῳ, καὶ διάκρισιν τῶν παθῶν ἀπ᾿ ἀλλήλων ἐν δευτέρῳ κεφαλαίῳ, οὐ μὴν διάκρισιν τῶν παθῶν ἀπὸ τῶν παθητικῶν ποιοτήτων ὡς ἤδη εἰρημένην ἡμῖν ἐν τῷ περὶ ἕξεως καὶ διαθέσεως λόγῳ, ὅτι τῷ εὐμεταβόλῳ καὶ δυσμεταβόλῳ ταῦτα διαφέρει ἀλλήλων.", "seq": 4675}
{"id": "Elias_Passim_4676", "series": "CAG", "text": "ἀλλὰ πρῶτον τὴν διάκρισιν ἡμῖν παραδίδωσι τῶν παθητικῶν ποιοτήτων καί φησιν ὅτι διαφέρουσιν αὗται ἀλλήλων, ὅτι αἱ μὲν ἀπὸ πάθους ἐγένοντο οὐ ποιοῦσι δὲ πάθος περὶ τὴν αἴσθησιν, ὡς τὰ χρώματα, αἱ δὲ ἀπὸ πάθους μὲν οὐκ ἐγένοντο πάθος δὲ ποιοῦσι περὶ τὴν αἴσθησιν, ὡς ἡ ἐν πυρὶ θερμότης καὶ ἡ ἐν μέλιτι γλυκύτης.", "seq": 4676}
{"id": "Elias_Passim_4677", "series": "CAG", "text": "ἄπορα δὲ ταῦτα πάντα τὰ παραδείγματα·", "seq": 4677}
{"id": "Elias_Passim_4678", "series": "CAG", "text": "πῶς γὰρ παθητικὴ ποιότης ἡ ἐν πυρὶ θερμότης, ἡ ἐν μέλιτι γλυκύτης;", "seq": 4678}
{"id": "Elias_Passim_4679", "series": "CAG", "text": "τί γὰρ παθὸν τὸ πῦρ ἢ τὸ μέλι τὸ μὲν ἐγένετο θερμὸν τὸ δὲ γλυκύ;", "seq": 4679}
{"id": "Elias_Passim_4680", "series": "CAG", "text": "ἄπορον δὲ καὶ τὸ ἄλλο·", "seq": 4680}
{"id": "Elias_Passim_4681", "series": "CAG", "text": "πῶς γὰρ ποιότητες αἱ προκείμεναι, ἡ ἐν πυρὶ θερμότης καὶ ἡ ἐν μέλιτι γλυκύτης;", "seq": 4681}
{"id": "Elias_Passim_4682", "series": "CAG", "text": "κατ᾿ οὐσίαν γὰρ αὗται ὑπάρχουσιν αὐτοῖς, ἡμῖν δὲ πρόκεινται ποιότητες ὡς συμβεβηκὸς λαμβανόμεναι, οὐχ αἱ κατ᾿ οὐσίαν.", "seq": 4682}
{"id": "Elias_Passim_4683", "series": "CAG", "text": "λέγομεν δὲ πρὸς τὸ πρῶτον ὅτι παθητικαὶ ποιότητες αὗται λέγονται, ἡ θερμότης τοῦ πυρὸς καὶ ἡ γλυκύτης τοῦ μέλιτος, οὐχ ὅτι ἀπὸ πάθους ἐγένοντο, ἀλλ᾿ ὅτι πάθος ποιοῦσι περὶ τὴν αἴσθησιν ἡμῶν.", "seq": 4683}
{"id": "Elias_Passim_4684", "series": "CAG", "text": "καὶ τούτου μάρτυς καὶ Πλάτων καὶ Ἀριστοτέλης, ὁ μὲν Πλάτων λέγων ‘τὸ γὰρ ποιοῦν ποιόν τί ἐστιν’, Ἀριστοτέλης δὲ ποτὲ μὲν λέγων τὸ μέλι δεδέχθαι γλυκύτητα ποτὲ δὲ μὴ δέχεσθαι·", "seq": 4684}
{"id": "Elias_Passim_4685", "series": "CAG", "text": "οὐ δέδεκται γὰρ τὴν συνουσιωμένην γλυκύτητα τὸ μέλι, οὐδὲ τὸ πῦρ τὴν θερμότητα·", "seq": 4685}
{"id": "Elias_Passim_4686", "series": "CAG", "text": "ἑκάτερον γὰρ χωρὶς τῆς κατ᾿ οὐσίαν ποιότητος οὐδὲ ἐπινοηθῆναι δύναται.", "seq": 4686}
{"id": "Elias_Passim_4687", "series": "CAG", "text": "δέχεσθαι δὲ ἑκάτερον λέγεται τὸ μὲν πῦρ τὴν θερμότητα τὸ δὲ μέλι τὴν γλυκύτητα ὡς θερμαίνουσαν καὶ γλυκάζουσαν, αἵπερ συμβεβήκασιν αὐτοῖς.", "seq": 4687}
{"id": "Elias_Passim_4688", "series": "CAG", "text": "καὶ λύεται καὶ τὸ δεύτερον ἄπορον, ὅτι ποιότητες αἱ προκείμεναι, αἳ ὡς συμβεβηκὸς λαμβάνονται.", "seq": 4688}
{"id": "Elias_Passim_4689", "series": "CAG", "text": "ἀποροῦσι δὲ καὶ πρὸς τὰ χρώματα ὅτι πῶς ταῦτα λέγομεν ἀπὸ πάθους γενέσθαι πάθος δὲ μὴ ποιεῖν·", "seq": 4689}
{"id": "Elias_Passim_4690", "series": "CAG", "text": "διακρίνουσι γὰρ καὶ συγκρίνουσι.", "seq": 4690}
{"id": "Elias_Passim_4691", "series": "CAG", "text": "καὶ λέγομεν ὅτι δικαιότερον ἀφ᾿ ὧν ἐγένοντο ὀνομάζειν αὐτὰς παθητικὰς ποιότητας ἢ ἀφ᾿ ὧν ποιοῦσιν·", "seq": 4691}
{"id": "Elias_Passim_4692", "series": "CAG", "text": "οὐ γὰρ παρώνυμον ποιοῦσιν ἑαυτοῖς πάθος·", "seq": 4692}
{"id": "Elias_Passim_4693", "series": "CAG", "text": "οὐδὲ γὰρ λευκαίνεται ὁ λευκοῦ ἀντιλαμβανόμενος ἢ γλυκαίνεται ὁ γλυκέος ἀντιλαμβανόμενος.", "seq": 4693}
{"id": "Elias_Passim_4694", "series": "CAG", "text": "καὶ ταῦτα μὲν ἡμεῖς.", "seq": 4694}
{"id": "Elias_Passim_4695", "series": "CAG", "text": "ὁ μέντοι Ἀριστοτέλης ἀπορεῖ περὶ τῶν χρωμάτων·", "seq": 4695}
{"id": "Elias_Passim_4696", "series": "CAG", "text": "ὅτι ἐπὶ τούτων τῶν προσκαίρων χρωμάτων δυνατὸν κρᾶσιν λέγειν αἰτίαν αὐτῶν, ἐπὶ μέντοι τῶν ἐκ φύσεως ἢ ἐκ γενέσεως, εἰ καὶ ὅλῳ τῷ εἴδει ὑπάρχουσι, τί ἐροῦμεν, ὡς ἐπὶ τῆς τοῦ κύκνου λευκότητος καὶ τῆς τοῦ πράσου χλωρότητος;", "seq": 4696}
{"id": "Elias_Passim_4697", "series": "CAG", "text": "καὶ λύει τοῦτο λέγων ὅτι ἡ κρᾶσις ἡ ποιήσασα τὸ πρόσφατον χρῶμα καὶ τὸ ἐκ γενετῆς ἐποίησεν, οἷον ὡς ἐπὶ τοῦ δι᾿ αἰδῶ ἐρυθριάσαντος καὶ διὰ φόβον ὠχριάσαντος·", "seq": 4697}
{"id": "Elias_Passim_4698", "series": "CAG", "text": "ἐν γὰρ τῷ ἐρυθριᾶν ἡ φύσις τὸν φίλιον χυμὸν προβάλλεται δίκην τῶν τὰς χεῖρας τοῖς ὀφθαλμοῖς ἐπιτιθέντων, ἵνα μὴ θεάσωνται ἃ μὴ δεῖ, μονονουχὶ παρέχουσα λέγειν τὸ", "seq": 4698}
{"id": "Elias_Passim_4699", "series": "CAG", "text": "πάντων δὲ μάλιστ᾿ αἰσχύνεο σαυτόν.", "seq": 4699}
{"id": "Elias_Passim_4700", "series": "CAG", "text": "καὶ ἐπὶ τοῦ διὰ φόβον ὠχριάσαντος καταφεύγει τὸ αἷμα εἰς τὴν καρδίαν, ὡς εἰς ἀκρόπολίν τινα.", "seq": 4700}
{"id": "Elias_Passim_4701", "series": "CAG", "text": "διὸ καὶ πάντων ἐσχάτη φθείρεται ἡ καρδία·", "seq": 4701}
{"id": "Elias_Passim_4702", "series": "CAG", "text": "εἰ γὰρ καὶ καρδιουλκούμενα ζῇ, ἀλλὰ διὰ τὸ καθήκειν ἀρτηρίας εἰς ὅλον τὸ σῶμα ἀπὸ καρδίας **.", "seq": 4702}
{"id": "Elias_Passim_4703", "series": "CAG", "text": "λέγουσι δὲ καὶ ἄλλην διαφοράν, ὅτι ποὺ μὲν προηγήσατο ἡ φαντασία, ὡς ἐπὶ τοῦ αἰδεσθέντος καὶ ὠχριάσαντος, ἐπὶ δὲ τῶν ἐκ γενετῆς οὐ προηγήσατο.", "seq": 4703}
{"id": "Elias_Passim_4704", "series": "CAG", "text": "ψεῦδος δὲ καὶ τοῦτο·", "seq": 4704}
{"id": "Elias_Passim_4705", "series": "CAG", "text": "οἱ γὰρ ἐπιμελῶς τρέφοντες τὰς περιστερὰς θαλλοὺς περιπλέκουσι ποικίλα χρώματα ἔχοντας ἐν τοῖς περιστερεῶσιν, ἵνα οἷα βούλονται σχοῖεν τὰ τεχθησόμενα, καὶ οὐκ ἀποτυγχάνουσι τῆς ἐλπίδος.", "seq": 4705}
{"id": "Elias_Passim_4706", "series": "CAG", "text": "καί τις γυνὴ Αἰθίοπα ἔτεκε μήτε Αἰθίοπι συγγενομένη μήτε Αἰθίοψ οὖσα, ἀλλ᾿ ἐν τῷ καιρῷ τῆς συνουσίας Αἰθίοπα φαντασθεῖσα.", "seq": 4706}
{"id": "Elias_Passim_4707", "series": "CAG", "text": "προηγεῖται οὖν ἡ φαντασία καὶ τῶν ἐκ γενετῆς.", "seq": 4707}
{"id": "Elias_Passim_4708", "series": "CAG", "text": "καὶ ταῦτα μὲν περὶ τούτου.", "seq": 4708}
{"id": "Elias_Passim_4709", "series": "CAG", "text": "Ἐφ᾿ οἷς διακρίνει τὰ πάθη ἀπ᾿ ἀλλήλων, ὅτι τῷ μᾶλλον καὶ τῷ ἧττον διαφέρουσιν.", "seq": 4709}
{"id": "Elias_Passim_4710", "series": "CAG", "text": "εἰπὲ δὲ σὺ ὅτι καὶ ἄλλως διαφέρουσι τὰ πάθη·", "seq": 4710}
{"id": "Elias_Passim_4711", "series": "CAG", "text": "ὅτι τὸ μὲν ἐν τῷ γίνεσθαι ἔχει τὸ εἶναι, τὸ δὲ ἐν τῷ γεγονέναι·", "seq": 4711}
{"id": "Elias_Passim_4712", "series": "CAG", "text": "ἐν μὲν τῷ γίνεσθαι τὸ ὠχριᾶν καὶ ἐρυθριᾶν, ἃ καὶ ὑπὸ τὸ πάσχειν ἀνάγεται, ἐν τῷ γεγονέναι δέ, ὅταν μόνιμον τὸ πάθος ἐγγένηται, ὃ καὶ ὑπὸ τὴν ποιότητα ἀνάγεται.", "seq": 4712}
{"id": "Elias_Passim_4713", "series": "CAG", "text": "οὕτω καὶ ἐπὶ τῆς ψυχῆς οὐ λέγεται ὀργίλος ὁ διὰ περίστασιν ὀργισθείς, ἀλλ᾿ ὁ φύσει ὢν τοιοῦτος, περὶ οὗ εἴρηται τῷ βουκολιαστῇ", "seq": 4713}
{"id": "Elias_Passim_4714", "series": "CAG", "text": "καί οἱ ἀεὶ δριμεῖα χολὴ ποτὶ ῥινὶ κάθηται.", "seq": 4714}
{"id": "Elias_Passim_4715", "series": "CAG", "text": "9b11 Ὅτι μὲν οὖν γίνονται καὶ ἀπογίνονται διὰ πάθος πολλαὶ μεταβολαὶ χρωμάτων.", "seq": 4715}
{"id": "Elias_Passim_4716", "series": "CAG", "text": "Εἰπὼν τὰ χρώματα παθητικὰς ποιότητας εἶναι, τὸ ἀπὸ πάθους γενέσθαι αὐτὰ κατασκευάζει καὶ δείκνυσιν οὕτως ἔχοντα.", "seq": 4716}
{"id": "Elias_Passim_4717", "series": "CAG", "text": "9b19 Ὅσα μὲν οὖν τῶν τοιούτων συμπτωμάτων.", "seq": 4717}
{"id": "Elias_Passim_4718", "series": "CAG", "text": "Τὰ χρώματα συμπτώματα εἶπεν εἶναι διὰ τὸ ἄλλοις πάθεσιν ἐπισυμβαίνειν, ὡς τῇ μακρᾷ νόσῳ ἕπεται ἡ ὠχρίασις·", "seq": 4718}
{"id": "Elias_Passim_4719", "series": "CAG", "text": "ἔστι δέ τι καὶ χρῶμα οὐσιῶδες, ὡς τὸ λευκὸν τῷ ψιμυθίῳ ἢ τῇ κιόνι καὶ τὸ ἐρυθρὸν τῷ αἵματι καὶ τὸ μέλαν ἐν τῷ τῆς σηπίας χυμῷ.", "seq": 4719}
{"id": "Elias_Passim_4720", "series": "CAG", "text": "9b27 Ὁμοίως γὰρ ποιοὶ κατ᾿ αὐτὰς λεγόμεθα.", "seq": 4720}
{"id": "Elias_Passim_4721", "series": "CAG", "text": "Ποιότης ἐστὶ καθ᾿ ἣν ποιοί τινες λέγονται·", "seq": 4721}
{"id": "Elias_Passim_4722", "series": "CAG", "text": "εἰ οὖν λέγονται ποιοὶ ἀπὸ τῶν εὐαποβλήτων παθῶν, δῆλον ὅτι ποιότητες ταῦτα λέγονται.", "seq": 4722}
{"id": "Elias_Passim_4723", "series": "CAG", "text": "9b33 Ὁμοίως δὲ τούτοις καὶ κατὰ τὴν ψυχὴν παθητικαὶ ποιότητες καὶ πάθη λέγονται.", "seq": 4723}
{"id": "Elias_Passim_4724", "series": "CAG", "text": "Οὐ μόνον γὰρ περὶ τὸ σῶμα θεωροῦνται <αἱ> παθητικαὶ ποιότητες καὶ τὰ πάθη, ἀλλὰ καὶ περὶ τὴν ψυχήν.", "seq": 4724}
{"id": "Elias_Passim_4725", "series": "CAG", "text": "9b35 Ὅσα τε γὰρ ἐν τῇ γενέσει εὐθὺς ἀπό τινων παθῶν γεγένηνται, ποιότητες λέγονται.", "seq": 4725}
{"id": "Elias_Passim_4726", "series": "CAG", "text": "Ὥσπερ ἡ ἐν τῷ Αἰθίοπι μελανία ἐκ γενετῆς οὖσα παθητικὴ ποιότης λέγεται.", "seq": 4726}
{"id": "Elias_Passim_4727", "series": "CAG", "text": "10a2 Ὁμοίως δὲ καὶ ἄλλαι ἐκστάσεις μὴ φυσικαί, ἀλλ᾿ ἀπό τινων συμπτωμάτων γεγένηνται.", "seq": 4727}
{"id": "Elias_Passim_4728", "series": "CAG", "text": "Πάλιν ὡς ἡ ἀπὸ μακρᾶς νόσου γενομένη ἄχροια λέγεται παθητικὴ ποιότης, οὕτω καὶ ἡ ἀπό τινος συμπτώματος ἔκστασις ἢ ἄλλο τι τοιοῦτον παθητικὴ ποιότης λέγεται.", "seq": 4728}
{"id": "Elias_Passim_4729", "series": "CAG", "text": "10a11 Τέταρτον δὲ γένος ποιότητος σχῆμά τε καὶ ἡ περὶ ἕκαστον ἐνυπάρχουσα μορφή.", "seq": 4729}
{"id": "Elias_Passim_4730", "series": "CAG", "text": "Διαιρεῖ τὸ τέταρτον εἶδος τῆς ποιότητος εἰς σχῆμα καὶ μορφήν.", "seq": 4730}
{"id": "Elias_Passim_4731", "series": "CAG", "text": "διαφέρει δὲ τὸ σχῆμα τῆς μορφῆς, διότι τὸ μὲν σχῆμα ἐπὶ τῶν κατ᾿ ἐπίνοιαν λέγεται, ἡ δὲ μορφὴ ἐπὶ τῶν φυσικῶν.", "seq": 4731}
{"id": "Elias_Passim_4732", "series": "CAG", "text": "πάλιν τὸ σχῆμα καὶ ἐπὶ ἐμψύχων καὶ ἀψύχων λέγεται, ἡ δὲ μορφὴ ἐπὶ ἐμψύχων μόνον κυρίως λέγεται.", "seq": 4732}
{"id": "Elias_Passim_4733", "series": "CAG", "text": "καὶ τοῦτο δηλοῖ ὁ Ἀριστοτέλης, διὰ τοῦ περὶ ἕκαστον καὶ τοῦ ἐνυπάρχουσα τὸ φυσικὸν αἰνιττόμενος.", "seq": 4733}
{"id": "Elias_Passim_4734", "series": "CAG", "text": "καὶ ὅτι πολλὰ σχήματα συνερχόμενα μορφὴν ἀποτελοῦσιν.", "seq": 4734}
{"id": "Elias_Passim_4735", "series": "CAG", "text": "10a12 Ἔτι δὲ παρὰ ταῦτα εὐθύτης καὶ καμπυλότης.", "seq": 4735}
{"id": "Elias_Passim_4736", "series": "CAG", "text": "Καὶ ταῦτα ὑπὸ τὸ τέταρτον εἶδος ἀνάγει διὰ τρεῖς αἰτίας·", "seq": 4736}
{"id": "Elias_Passim_4737", "series": "CAG", "text": "ἢ ὅτι καὶ ταῦτα σχήματά πώς εἰσιν (ὥσπερ γὰρ τὰ μέρη τῶν οὐσιῶν οὐσίαι εἰσίν, οὕτω καὶ τὰ μέρη τῶν σχημάτων σχήματά εἰσιν), ἢ ὅτι κοινὰ ταῦτα σχήματος καὶ μορφῆς ὡς δι᾿ ἀμφοτέρων διήκοντα, ἢ ὅτι σχήματά πώς εἰσι τῆς γραμμῆς.", "seq": 4737}
{"id": "Elias_Passim_4738", "series": "CAG", "text": "10a13 Καὶ ὅσα ἄλλα τοιαῦτα.", "seq": 4738}
{"id": "Elias_Passim_4739", "series": "CAG", "text": "Τοῦτο προσέθηκε διὰ τὰ μέσα σχήματα τὰ ἑλικοειδῆ·", "seq": 4739}
{"id": "Elias_Passim_4740", "series": "CAG", "text": "ἡ γὰρ γραμμὴ ἢ ἄκρως ἐπιτέταται καὶ ποιεῖ τὴν εὐθεῖαν, ἢ ἄκρως κέκαμπται καὶ ποιεῖ τὴν περιφέρειαν, ἢ μέσως πως ἔχει καὶ ποιεῖ τὰ μεταξύ, τὰ ἑλικοειδῆ.", "seq": 4740}
{"id": "Elias_Passim_4741", "series": "CAG", "text": "καὶ ταῦτα μὲν περὶ τούτου.", "seq": 4741}
{"id": "Elias_Passim_4742", "series": "CAG", "text": "ἀπωθεῖται δὲ ὁ Ἀριστοτέλης τοῦ τετάρτου εἴδους τῆς ποιότητος λειότητα καὶ τραχύτητα·", "seq": 4742}
{"id": "Elias_Passim_4743", "series": "CAG", "text": "δοκοῦσι γὰρ σχήματά πως εἶναι, καὶ ταῦτα τῆς ἐπιφανείας·", "seq": 4743}
{"id": "Elias_Passim_4744", "series": "CAG", "text": "ἢ γὰρ ὅλα τὰ μόρια ἐν ἑνί εἰσιν ἐπιπέδῳ καὶ ποιοῦσι τὴν λειότητα, ἢ μεταξὺ ἀνισότητα ἔχει, καὶ τῶν μορίων τὰ μὲν ὑπερέχει τὰ δὲ εἰσέχει, καὶ ποιεῖ τὴν τραχύτητα.", "seq": 4744}
{"id": "Elias_Passim_4745", "series": "CAG", "text": "διττὸν δὲ τὸ τραχὺ καὶ τὸ λεῖον·", "seq": 4745}
{"id": "Elias_Passim_4746", "series": "CAG", "text": "ἢ γὰρ ἐν τῷ κατὰ παράθεσιν ὅλῳ θεωρεῖται, ὡς ἐν τοίχῳ τὸ λεῖον ἢ τὸ τραχὺ τὸ ἐν τῷ πρίονι, καὶ τότε ὑπὸ τὰ πρός τι ἀνάγεται (σχέσιν γὰρ δηλοῖ τῶν λίθων καὶ τῆς πηλοῦ τό τε λεῖον τὸ ἐν τῷ τοίχῳ ἢ τὸ τραχὺ τὸ ἐν τῷ πρίονι), ἢ ἐν συνεχεῖ ὅλῳ θεωρεῖται, ὡς ἐν μήτρᾳ φύσει τραχείᾳ οὔσῃ ἡ τραχύτης τῆς μήτρας καὶ ὡς ἐν μετώπῳ καὶ μήλῳ ἡ λειότης·", "seq": 4746}
{"id": "Elias_Passim_4747", "series": "CAG", "text": "ταῦτα γὰρ φύσει λεῖα καὶ τοῦ ὅλου ἕνα χαρακτῆρα δηλοῦσι, διὸ καὶ ὑπὸ τὴν ποιότητα ἀνάγονται.", "seq": 4747}
{"id": "Elias_Passim_4748", "series": "CAG", "text": "ἀπωθεῖται δὲ οὐ μόνον σχήματος καὶ μορφῆς, ἀλλ᾿ ὅλης τῆς ποιότητος πυκνότητα καὶ μανότητα πᾶσαν.", "seq": 4748}
{"id": "Elias_Passim_4749", "series": "CAG", "text": "διττὸν δὲ τὸ μανὸν καὶ τὸ πυκνόν, τὸ μὲν ἐν τοῖς κατὰ παράθεσιν μορίοις θεωρούμενον, ὡς κισσήρει καὶ σπόγγῳ, ὅτε καὶ ὑπὸ τὰ πρός τι ἀνάγονται, ἢ ἐν συνεχεῖ ὅλῳ θεωρούμενον, ὡς τὸ μανὸν τὸ ἐν πυρὶ καὶ ἀέρι·", "seq": 4749}
{"id": "Elias_Passim_4750", "series": "CAG", "text": "τότε γὰρ τοῦ ὅλου ἕνα χαρακτῆρα δηλοῦσι καὶ ὑπὸ τὴν ποιότητα ἀνάγονται·", "seq": 4750}
{"id": "Elias_Passim_4751", "series": "CAG", "text": "εἴωθε γὰρ Ἀριστοτέλης τὰ λεπτότερα τῶν στοιχείων μανὰ καλεῖν τὰ δὲ παχύτερα πυκνά.", "seq": 4751}
{"id": "Elias_Passim_4752", "series": "CAG", "text": "τὰ τοιαῦτα οὖν πυκνὰ καὶ μανὰ ἐπειδὴ τοῦ ὅλου ἕνα χαρακτῆρα δηλοῦσιν, ὑπὸ τὴν ποιότητα ἀνάγονται.", "seq": 4752}
{"id": "Elias_Passim_4753", "series": "CAG", "text": "ἔτι τὸ μανὸν καὶ πυκνὸν διττόν·", "seq": 4753}
{"id": "Elias_Passim_4754", "series": "CAG", "text": "ἢ γὰρ τεχνητόν ἐστιν, ὡς ἐπὶ ἱματίου, καθό φαμεν πυκνὸν τὸ ἔχον πλησίον τοὺς στήμονας καὶ τὴν κρόκην, μανὸν δὲ ἤτοι ἀραιὸν τὸ μὴ οὕτως ἔχον, ὅτε καὶ ὑπὸ τὸ κεῖσθαι ἀνάγεται ἑκάτερον (θέσιν γάρ τινα τῶν μορίων δηλοῦσιν), ἢ φυσικόν.", "seq": 4754}
{"id": "Elias_Passim_4755", "series": "CAG", "text": "καὶ ἢ ἐν ἑνὶ ὑποκειμένῳ ὡς ἐν ἀέρι καὶ ὕδατι τὸ μανὸν καὶ τὸ πυκνὸν λέγομεν, ὅτε καὶ ὑπὸ τὴν ποιότητα ἀνάγονται (ποιὸς γὰρ κατ᾿ αὐτὸ γίνεται ὁ ἀήρ, οὐ τῷ ἀφεστάναι ἀλλήλων τὰ μόρια αὐτοῦ, ἀλλὰ τῷ κοῦφος εἶναι καὶ εὐδιαίρετος), καὶ εἴη ἂν μανὸν οὐχ ᾧ τὸ πυκνόν, ἀλλ᾿ ᾧ τὸ στερεόν ἐστιν ἀντικείμενον, ὃ καὶ βαρύ ἐστι καὶ δυσδιαίρετον.", "seq": 4755}
{"id": "Elias_Passim_4756", "series": "CAG", "text": "ἢ οὐκ ἐν ἑνὶ ἀλλ᾿ ἐν πλείοσιν ὑποκειμένοις θεωρεῖται τὸ μανὸν καὶ τὸ πυκνόν, ὅτε κἂν φυσικὰ ὦσιν, οὐ λέγονται ποιότητες ἀλλὰ θέσεις, οἷον ἡ τῶν ὀδόντων πυκνότης ἢ μανότης·", "seq": 4756}
{"id": "Elias_Passim_4757", "series": "CAG", "text": "εἰ γὰρ καὶ ἐκ φύσεώς ἐστιν, ἀλλὰ τῷ μὴ ἐν ἑνὶ θεωρεῖσθαι ὑποκειμένῳ ἀλλ᾿ ἐν πλείοσι τοῖς ὀδοῦσιν οὐ λέγεται ποιότης.", "seq": 4757}
{"id": "Elias_Passim_4758", "series": "CAG", "text": "10a27 Ποιότητες μὲν αἱ εἰρημέναι, ποιὰ δὲ τὰ ἀπ᾿ αὐτῶν λεγόμενα.", "seq": 4758}
{"id": "Elias_Passim_4759", "series": "CAG", "text": "Μετὰ τὴν ὑπογραφὴν τῆς ποιότητος ὑπογράφει καὶ τὸ ποιόν.", "seq": 4759}
{"id": "Elias_Passim_4760", "series": "CAG", "text": "καὶ ἐν μὲν τῇ ἐπιγραφῇ προέταξε τὸ ποιόν, ἐν δὲ ταῖς ὑπογραφαῖς τὴν ὑπογραφὴν τῆς ποιότητος προέταξε, καὶ εἶθ᾿ οὕτως τὴν ὑπογραφὴν τοῦ ποιοῦ, ἐνδεικνύμενος ὅτι πρός τι τὸ ποιὸν καὶ ἡ ποιότης καὶ οὐ δύναται ταῦτα ὡς συνυπάρχοντα χωρὶς ἀλλήλων ὑποστῆναι.", "seq": 4760}
{"id": "Elias_Passim_4761", "series": "CAG", "text": "διὸ καὶ νόμῳ τῶν πρός τι ἴδιον τὸ δι᾿ ἀλλήλων ὑπογράφεσθαι.", "seq": 4761}
{"id": "Elias_Passim_4762", "series": "CAG", "text": "διὸ καὶ ἀποροῦσιν·", "seq": 4762}
{"id": "Elias_Passim_4763", "series": "CAG", "text": "ὅτι ἐπὶ τῶν πρός τι ὁ τὸ ἕτερον εἰδὼς καὶ τὸ λοιπὸν οἶδε, διὰ τί μὴ ἠρκέσθη τῇ ὑπογραφῇ τῆς ποιότητος, ὡς δι᾿ αὐτῆς καὶ τὴν ὑπογραφὴν τοῦ ποιοῦ ἔχων;", "seq": 4763}
{"id": "Elias_Passim_4764", "series": "CAG", "text": "καὶ λέγω τούτου λύσεις δύο·", "seq": 4764}
{"id": "Elias_Passim_4765", "series": "CAG", "text": "μίαν μέν, ὅτι διὰ τὸ προσθεῖναι τὸ ἢ ὁπωσοῦν ἄλλως καὶ ποιὸν ὑπογράφει λεγόμενον ἐνταῦθα, ὀφεῖλον δὲ κατὰ κοινοῦ καὶ ἐπὶ τῆς ποιότητος λέγεσθαι.", "seq": 4765}
{"id": "Elias_Passim_4766", "series": "CAG", "text": "καὶ δι᾿ ἄλλην δὲ αἰτίαν ὑπογράφει τὸ ποιόν·", "seq": 4766}
{"id": "Elias_Passim_4767", "series": "CAG", "text": "ὑπογράψας γὰρ τὴν ποιότητα καὶ παραδοὺς ἡμῖν αὐτῆς τὰ εἴδη, ὀφείλων λοιπὸν ἐλθεῖν ἐπὶ τὰ ἴδια, ἵνα ἀψοφητὶ ποιήσῃ ταύτην τὴν μετάβασιν, πρότερον ὑπογράφει τὸ ποιόν·", "seq": 4767}
{"id": "Elias_Passim_4768", "series": "CAG", "text": "καὶ ἡ ὑπογραφὴ γὰρ ἴδιόν πώς ἐστι τῷ ἐκ τῶν συμβεβηκότων λαμβάνεσθαι, ᾗ καὶ ἀντιστρέφει.", "seq": 4768}
{"id": "Elias_Passim_4769", "series": "CAG", "text": "ἔχει δὲ οὕτως ἡ ὑπογραφή·", "seq": 4769}
{"id": "Elias_Passim_4770", "series": "CAG", "text": "ποιόν ἐστι τὸ ἀπὸ τῆς ποιότητος παρωνύμως λεγόμενον ἢ ὁπωσοῦν ἄλλως, οἷον ἀπὸ τῆς θερμότητος θερμοί, ἀπὸ τῆς λευκότητος λευκοί, ἀπὸ τῆς ἀνδρείας ἀνδρεῖοι, ἀπὸ τῆς δικαιοσύνης δίκαιοι.", "seq": 4770}
{"id": "Elias_Passim_4771", "series": "CAG", "text": "τὸ δὲ ἢ ὁπωσοῦν ἄλλως πρόσκειται, ἐπειδὴ τῆς ποιότητος τετραχῶς ἡ κατηγορία, παρωνύμως ὁμωνύμως ἑτερωνύμως ἀκατονομάστως.", "seq": 4771}
{"id": "Elias_Passim_4772", "series": "CAG", "text": "διὸ καὶ ἀποροῦσιν·", "seq": 4772}
{"id": "Elias_Passim_4773", "series": "CAG", "text": "εἰ τετραχῶς ἡ ποιότης κατηγορεῖται, διὰ τί τῶν παρωνύμων ἐμνημόνευσε μόνων;", "seq": 4773}
{"id": "Elias_Passim_4774", "series": "CAG", "text": "καὶ λέγομεν ὅτι μᾶλλον παρωνύμως ἡ ποιότης κατηγορεῖται ἢ ἄλλως.", "seq": 4774}
{"id": "Elias_Passim_4775", "series": "CAG", "text": "λεκτέον δὲ οὕτως, ὅτι τεσσάρων ὄντων εἰδῶν τῆς ποιότητος τὰ μὲν δύο παρωνύμως κατηγοροῦνται, ἕξις καὶ διάθεσις καὶ παθητικὴ ποιότης καὶ πάθος, τὰ δὲ ἄλλα δύο τὰ μὲν ἀκατονομάστως, ὡς δύναμις καὶ ἀδυναμία, τὰ δὲ ὁμωνύμως, ὡς σχῆμα καὶ μορφή·", "seq": 4775}
{"id": "Elias_Passim_4776", "series": "CAG", "text": "τὸ γὰρ σχῆμα καὶ ἡ μορφὴ ὁμωνύμως κατηγοροῦνται·", "seq": 4776}
{"id": "Elias_Passim_4777", "series": "CAG", "text": "τρίγωνον γὰρ λέγεται καὶ τὸ σχῆμα καὶ τὸ σῶμα τὸ ἔχον τὸ τρίγωνον.", "seq": 4777}
{"id": "Elias_Passim_4778", "series": "CAG", "text": "ὁμοίως δὲ καὶ ἐπὶ τοῦ τετραγώνου καὶ τῶν ἄλλων σχημάτων νοητέον.", "seq": 4778}
{"id": "Elias_Passim_4779", "series": "CAG", "text": "μόνη δὲ ἀρετὴ καὶ σπουδαῖος ἑτερωνύμως.", "seq": 4779}
{"id": "Elias_Passim_4780", "series": "CAG", "text": "εἰ δὲ ἀπορήσει τις λέγων ‘οὐδὲν ἧττον μένει ἡ ἀπορία·", "seq": 4780}
{"id": "Elias_Passim_4781", "series": "CAG", "text": "δύο γὰρ παρωνύμως κατηγοροῦνται εἴδη καὶ δύο οὐ παρωνύμως’, πρὸς τοῦτό φαμεν ὅτι ἐφ᾿ ὧν κεῖνται ὀνόματα ἰδικά, μᾶλλον παρωνύμως κατηγορεῖται ἡ ποιότης ἢ ὁμωνύμως, ἐφ᾿ ὧν δὲ οὐ κεῖνται τὰ ὀνόματα, ἢ οὐδὲ ὅλως κεῖνται, ἀκατονομάστως, ὡς ἐπὶ δυνάμεως καὶ ἀδυναμίας, ἢ κεῖνται μὲν ἰδικὰ δὲ <οὐ> κεῖνται, ὡς ἐπὶ σχήματος καὶ μορφῆς·", "seq": 4781}
{"id": "Elias_Passim_4782", "series": "CAG", "text": "κοινὰ γὰρ αὐτῶν τὰ ὀνόματα πάντα ὁμωνύμως κατηγοροῦνται.", "seq": 4782}
{"id": "Elias_Passim_4783", "series": "CAG", "text": "ἓν δὲ μόνον ἑτερωνύμως κατηγορεῖται, ἀρετὴ καὶ σπουδαῖος.", "seq": 4783}
{"id": "Elias_Passim_4784", "series": "CAG", "text": "μᾶλλον οὖν παρωνύμως ἡ ποιότης κατηγορεῖται ἤπερ ἄλλως.", "seq": 4784}
{"id": "Elias_Passim_4785", "series": "CAG", "text": "10b12 Ἐπιδέχεται δὲ ἡ ποιότης καὶ τὰ ἐναντία.", "seq": 4785}
{"id": "Elias_Passim_4786", "series": "CAG", "text": "Μετὰ τὴν ὑπογραφὴν τοῦ ποιοῦ καὶ τῆς ποιότητος καὶ τὰ εἴδη αὐτῆς ἔρχεται καὶ ἐπὶ τὰ ἴδια ὁ φιλόσοφος.", "seq": 4786}
{"id": "Elias_Passim_4787", "series": "CAG", "text": "πρῶτον τοίνυν ἴδιον τῆς ποιότητος τὸ θεωρεῖσθαι ἐν σώματι ἐναντία, ὡς τὸ λευκὸν τὸ μέλαν, ψυχρὸν καὶ θερμόν, καὶ ἐν ψυχῇ ἐναντία (ἐναντία γὰρ ἡ δικαιοσύνη τῇ ἀδικίᾳ), καὶ ἐν τῷ συναμφοτέρῳ, ὡς νόσος καὶ ὑγίεια.", "seq": 4787}
{"id": "Elias_Passim_4788", "series": "CAG", "text": "πλὴν εἰ καὶ ἐν τοῖς τρισὶ τούτοις δύναται θεωρεῖσθαι, οὐ πάντως καὶ πάσῃ ποιότητι ὑπάρχει ἐναντιότης·", "seq": 4788}
{"id": "Elias_Passim_4789", "series": "CAG", "text": "τοῖς γὰρ μέσοις χρώμασιν οὐδὲν ἐναντίον, οἷον φαιῷ ἢ ξανθῷ οὐδέν ἐστιν ἐναντίον, οὐδὲ τῷ χλιαρῷ, ἐπειδὴ τὰ ἐναντία τῇ πλείστῃ διαστάσει κρίνεται, πλεῖστον δὲ διέστηκεν οὐ τὸ μέσον τοῦ ἄκρου, ἀλλὰ τὸ ἄκρον τοῦ ἄκρου, καὶ ἵνα μὴ ἑνὶ δύο ἐναντία ἀντιτάξῃ ἡ φύσις.", "seq": 4789}
{"id": "Elias_Passim_4790", "series": "CAG", "text": "πλὴν εἰ καὶ μὴ πάσῃ ποιότητι ὑπάρχει, ἀλλ᾿ οὖν μόνῃ ποιότητι ὑπάρχει·", "seq": 4790}
{"id": "Elias_Passim_4791", "series": "CAG", "text": "εἰ γὰρ καὶ τῷ ποιεῖν ὑπάρχει ἐναντιότης, ὡς τὸ θερμαίνειν τὸ ψύχειν, καὶ τῷ πάσχειν ὑπάρχει ἐναντιότης, ὡς τὸ θερμαίνεσθαι τὸ ψύχεσθαι, ἀλλ᾿ ὡς ποιότητος μετέχουσιν αὐτοῖς ὑπάρχει ἐναντιότης·", "seq": 4791}
{"id": "Elias_Passim_4792", "series": "CAG", "text": "ὑπάρχει γὰρ καὶ τοῖς πρός τι ἐναντιότης ὡς ποιότητος μετέχουσι καὶ τῇ οὐσίᾳ·", "seq": 4792}
{"id": "Elias_Passim_4793", "series": "CAG", "text": "πῦρ γὰρ οὐσία ὂν τῷ ὕδατι ἐναντίον οὐσίᾳ ὄντι διὰ τὰς ποιότητας, ὁπότε οὐδὲ ἐναντία ἡ ἐν πυρὶ θερμότης καὶ ἡ ἐν ὕδατι ψυχρότης, εἰ οὐσιώδεις ληφθεῖεν, ὡς ἀνωτέρω ἐδείχθη.", "seq": 4793}
{"id": "Elias_Passim_4794", "series": "CAG", "text": "ὁ δὲ Ἀρχύτας καθολικώτερον τὸ ἴδιον προάγων φησὶν ὅτι ὑπάρχει τῇ ποιότητι ἴδιον τὸ ἐπιδέχεσθαι τὰ ἐναντία ἢ στέρησιν.", "seq": 4794}
{"id": "Elias_Passim_4795", "series": "CAG", "text": "καὶ τούτοις συνᾴδει ὁ Ἀριστοτέλης·", "seq": 4795}
{"id": "Elias_Passim_4796", "series": "CAG", "text": "προϊὼν γὰρ ἀμφιβάλλει εἰ ἐναντία ἡ δικαιοσύνη τῇ ἀδικίᾳ·", "seq": 4796}
{"id": "Elias_Passim_4797", "series": "CAG", "text": "δόξουσι γὰρ ἐναντία εἶναι ὡς μεταβάλλοντα, δόξει καὶ στέρησις εἶναι ἡ ἀδικία·", "seq": 4797}
{"id": "Elias_Passim_4798", "series": "CAG", "text": "τὸ γὰρ α στερητικόν.", "seq": 4798}
{"id": "Elias_Passim_4799", "series": "CAG", "text": "ὅθεν καὶ ἀποροῦσιν ὅτι πῶς μάχεται ἡ στέρησις τῷ εἴδει, <οἷον> τίς ἂν γένοιτο ἐν τῷ ἀνθρώπῳ.", "seq": 4799}
{"id": "Elias_Passim_4800", "series": "CAG", "text": "πρὸς ὅ φαμεν·", "seq": 4800}
{"id": "Elias_Passim_4801", "series": "CAG", "text": "ἀλλ᾿ οὔτις ἂν γένοιτο ἐν τῷ ἀνθρώπῳ, ἀλλά τις ἐν τῇ ὕλῃ τοῦ ἀνθρώπου γένοιτο.", "seq": 4801}
{"id": "Elias_Passim_4802", "series": "CAG", "text": "καὶ ἐπειδὴ ὡς ἐν ὕλῃ συμβεβηκότα εἰσί (γίνονται γὰρ καὶ ἀπογίνονται), μάχεται ἡ στέρησις τῷ εἴδει ὡς συμβεβηκὸς συμβεβηκότι.", "seq": 4802}
{"id": "Elias_Passim_4803", "series": "CAG", "text": "10b17 Ἔτι ἐὰν τῶν ἐναντίων θάτερον ᾖ ποιόν, καὶ τὸ λοιπὸν ποιόν.", "seq": 4803}
{"id": "Elias_Passim_4804", "series": "CAG", "text": "Δεύτερον ἴδιον τῆς ποιότητος τὸ τῷ ποιῷ ἐναντίον ποιὸν εἶναι, καὶ καθόλου ἧς κατηγορίας τὸ ἕτερον, τῆς αὐτῆς εἶναι καὶ τὸ λοιπόν.", "seq": 4804}
{"id": "Elias_Passim_4805", "series": "CAG", "text": "οὐ λέγει δὲ νῦν τὸ προσεχὲς γένος ὁ Ἀριστοτέλης τοῦ ποιοῦ, ἀλλὰ τὸ πόρρω.", "seq": 4805}
{"id": "Elias_Passim_4806", "series": "CAG", "text": "καὶ μή τις νομίσῃ ὅτι πάντα τὰ ἐναντία ὑφ᾿ ἓν γένος ἀνάγονται·", "seq": 4806}
{"id": "Elias_Passim_4807", "series": "CAG", "text": "διορθοῦται γὰρ τοῦτο ὁ Ἀριστοτέλης ἐν τῷ περὶ ἀντικειμένων λόγῳ, ὅτι τὰ ἐναντία τριττά·", "seq": 4807}
{"id": "Elias_Passim_4808", "series": "CAG", "text": "ἢ γὰρ ὑπὸ ἓν γένος ἀνάγονται, ὡς τὸ λευκὸν καὶ τὸ μέλαν ὑπὸ τὸ χρῶμα, ἢ ὑπὸ ἀντιδιῃρημένα, ὡς δικαιοσύνη καὶ ἀδικία ὑπὸ ἀρετὴν καὶ κακίαν, ἢ οὐδὲ ὅλως ἀνάγονται ὑπὸ γένος τῷ αὐτὰ γένος εἶναι, ὡς τὸ ἀγαθὸν καὶ τὸ κακόν·", "seq": 4808}
{"id": "Elias_Passim_4809", "series": "CAG", "text": "διὰ γὰρ τῶν δέκα διήκουσι κατηγοριῶν.", "seq": 4809}
{"id": "Elias_Passim_4810", "series": "CAG", "text": "καὶ πιστοῦται τὰ νῦν λεγόμενα ὁ Ἀριστοτέλης ἐκ τῆς ἐπαγωγῆς·", "seq": 4810}
{"id": "Elias_Passim_4811", "series": "CAG", "text": "πολὺ γὰρ τὸ ἐπαγωγικὸν ἐν τῇ παρούσῃ πραγματείᾳ περὶ τῶν γενικωτάτων οὔσῃ, ἃ οὐδὲν ἔχει πρὸ αὐτῶν ἀλλὰ μετὰ ταῦτα·", "seq": 4811}
{"id": "Elias_Passim_4812", "series": "CAG", "text": "εἰ γὰρ τῷ ὀξεῖ τῷ ἐν χυμοῖς τὸ γλυκὺ τὸ ἐν χυμοῖς ἀντίκειται, ἐκεῖνο δὲ ὑπὸ τὴν ποιότητα, καὶ τοῦτο ὑπὸ τὴν ποιότητα ἀναχθήσεται.", "seq": 4812}
{"id": "Elias_Passim_4813", "series": "CAG", "text": "καὶ εἰ τὸ ὀξὺ τὸ ἐν γωνίαις ὑπὸ τὰ πρός τι (ὀξεῖα γὰρ ἡ ἐλάσσων ὀρθῆς), καὶ τὸ ἀμβλὺ τὸ ἐν γωνίαις ὑπὸ τὰ πρός τι·", "seq": 4813}
{"id": "Elias_Passim_4814", "series": "CAG", "text": "ἀμβλεῖα γὰρ ἡ μείζων ὀρθῆς, τὸ δὲ μεῖζον καὶ ἔλαττον τῶν πρός τι.", "seq": 4814}
{"id": "Elias_Passim_4815", "series": "CAG", "text": "καὶ εἰ τὸ ὀξὺ τὸ ἐν φωναῖς ὑπὸ τὸ ποιεῖν ἀναχθήσεται, καὶ τὸ ἀμβλὺ ὁμοίως.", "seq": 4815}
{"id": "Elias_Passim_4816", "series": "CAG", "text": "ἀλλ᾿ ὅσον ἐπὶ τούτῳ διάφοροι ἔσονται κατηγορίαι τῶν ἐναντίων, καὶ οὐκέτι ἐν ποιότητι μόνῃ ἡ ἐναντιότης.", "seq": 4816}
{"id": "Elias_Passim_4817", "series": "CAG", "text": "καὶ λέγομεν ὅτι οὐκ εἶπεν ὁ Ἀριστοτέλης ὅτι εἰ τὸ ἕτερον τῶν ἐναντίων ὑπὸ τήνδε τὴν κατηγορίαν ἀνάγεται, καὶ τὸ λοιπὸν ἀναχθήσεται, ἀλλὰ τὸ τῷ ποιῷ ἐναντίον ποιὸν εἶναι.", "seq": 4817}
{"id": "Elias_Passim_4818", "series": "CAG", "text": "διὸ καὶ ἀμφιβόλως τὸν λόγον προήγαγε λέγων·", "seq": 4818}
{"id": "Elias_Passim_4819", "series": "CAG", "text": "οἷον εἰ ἡ δικαιοσύνη ἐναντίον τῇ ἀδικίᾳ·", "seq": 4819}
{"id": "Elias_Passim_4820", "series": "CAG", "text": "δόξα γὰρ γέγονεν ὅτι ἡ ἀδικία οὐκ ἔστιν ἐναντία τῇ δικαιοσύνῃ·", "seq": 4820}
{"id": "Elias_Passim_4821", "series": "CAG", "text": "ἡ γὰρ ἀδικία στέρησις, τὸ δὲ ἀντικείμενον τῇ δικαιοσύνῃ ἀκατονόμαστόν ἐστι, καὶ οὐ δεῖ τὰς ἕξεις στερητικοῖς ὀνόμασιν ὀνομάζειν, ὥσπερ ἡ ἀδικία στερητικὸν ὄνομα ἔχει, ἕξις οὖσα.", "seq": 4821}
{"id": "Elias_Passim_4822", "series": "CAG", "text": "πλὴν οὐκ ἀληθὴς ὁ λόγος·", "seq": 4822}
{"id": "Elias_Passim_4823", "series": "CAG", "text": "οὐ γὰρ ἀεὶ αἱ στερήσεις στερητικοῖς ὀνόμασιν ὀνομάζονται·", "seq": 4823}
{"id": "Elias_Passim_4824", "series": "CAG", "text": "ἰδοὺ γὰρ ἡ τυφλότης καὶ κωφότης, στερητικὰ ὄντα, στερητικοῖς ὀνόμασιν οὐκ ὀνομάζονται, ὡς τὸ ἀσώματον, ἀθάνατον, ἀίδιον, ἀγέννητον.", "seq": 4824}
{"id": "Elias_Passim_4825", "series": "CAG", "text": "Τρίτον δὲ ἴδιον τῆς ποιότητος τὸ ἀπογεννώμενον ἐκ τοῦ πρώτου ἰδίου, τοῦ ἐπιδέχεσθαι τὰ ἐναντία, τὸ ἐπιδέχεσθαι τὸ μᾶλλον καὶ ἧττον·", "seq": 4825}
{"id": "Elias_Passim_4826", "series": "CAG", "text": "ἀεὶ γὰρ ταῦτα ἕπονται ἀλλήλοις·", "seq": 4826}
{"id": "Elias_Passim_4827", "series": "CAG", "text": "ὅπου τὰ ἐναντία, ἐκεῖ πάντως τὸ μᾶλλον καὶ ἧττον, καὶ ὅπου τὸ μᾶλλον καὶ ἧττον, ἐκεῖ καὶ τὰ ἐναντία, καὶ ὅπου οὐκ ἔστι τὸ ἕτερον, οὐδὲ τὸ λοιπόν.", "seq": 4827}
{"id": "Elias_Passim_4828", "series": "CAG", "text": "ταῦτα δὲ καὶ ἐν μόνῃ τῇ ποιότητι θεωροῦνται, πλὴν οὐκ ἐν πάσῃ·", "seq": 4828}
{"id": "Elias_Passim_4829", "series": "CAG", "text": "τῷ γὰρ σχήματι οὐδέν ἐστιν ἐναντίον, οὐδὲ τοῖς μέσοις τῶν χρωμάτων.", "seq": 4829}
{"id": "Elias_Passim_4830", "series": "CAG", "text": "ὅπου γε καὶ δόξα γέγονε μηδὲ αὐτὴν τὴν ποιότητα ἐπιδέχεσθαι τὰ ἐναντία, ἀλλὰ τὰ μετέχοντα μόνον·", "seq": 4830}
{"id": "Elias_Passim_4831", "series": "CAG", "text": "ὥσπερ γὰρ πυρκαϊᾶς μιᾶς καὶ τῆς αὐτῆς οὔσης οἱ μὲν μᾶλλον θερμαίνονται οἱ δὲ ἧττον τῷ μᾶλλον μετέχειν ἢ ἧττον, καὶ τῆς δικαιοσύνης μιᾶς καὶ τῆς αὐτῆς οὔσης οἱ μὲν μᾶλλον οἱ δὲ ἧττον μετέχουσι τῆς δικαιοσύνης, οὕτω καὶ ἐπὶ τῆς ποιότητος ἔχει.", "seq": 4831}
{"id": "Elias_Passim_4832", "series": "CAG", "text": "ἰστέον δὲ ὅτι οὐδὲ ἐν πᾶσι τοῖς μετέχουσι τῆς ποιότητος ἡ ἐναντιότης·", "seq": 4832}
{"id": "Elias_Passim_4833", "series": "CAG", "text": "τρίγωνον γὰρ τριγώνου <οὐ> λέγεται μᾶλλον τρίγωνον, ἢ τετράγωνον ἢ κύκλος·", "seq": 4833}
{"id": "Elias_Passim_4834", "series": "CAG", "text": "καθόλου γὰρ εἰπεῖν, τὸ μᾶλλον καὶ ἧττον καὶ τὰ ἐναντία οὐδὲ ἐν οἷς πάντῃ ὁ αὐτὸς ὁρισμός, ὡς ἐπὶ δύο τριγώνων, οὐδὲ ἐν οἷς πάντῃ διάφορος, ὡς ἐπὶ τριγώνου καὶ κύκλου, θεωροῦνται (οὐδὲν γὰρ τούτων πρὸς τὸ ἀνόμοιον λέγεται μᾶλλον ἢ ἧττον), ἀλλ᾿ ἐν οἷς πῇ μὲν ὁ αὐτὸς λόγος πῇ δὲ διάφορος, ὡς ἐπὶ δύο λευκῶν·", "seq": 4834}
{"id": "Elias_Passim_4835", "series": "CAG", "text": "ὁ γὰρ λόγος ὁ αὐτὸς ἐπὶ ἑκατέρου, ἀλλὰ καὶ διάφορος·", "seq": 4835}
{"id": "Elias_Passim_4836", "series": "CAG", "text": "λευκὸν γάρ ἐστι καὶ τὸ λελευκωμένον, λευκὸν δέ ἐστι καὶ αὐτὸ τὸ χρῶμα, ἀλλ᾿ ἔστι μᾶλλον διακρίνειν καὶ ἧττον.", "seq": 4836}
{"id": "Elias_Passim_4837", "series": "CAG", "text": "Τούτων δὲ τῶν δύο ἰδίων καὶ ἀνωτέρω ἐμνήσθημεν, ἀλλὰ ποὺ μὲν ὡς μὴ ὑπαρχόντων, οἷον ἐπὶ οὐσίας καὶ ποσοῦ, ποὺ δὲ ὡς ὑπαρχόντων, ὡς ἐπὶ τῶν πρός τι καὶ ποιότητος.", "seq": 4837}
{"id": "Elias_Passim_4838", "series": "CAG", "text": "ὥσπερ δὲ ἀνωτέρω τὰ ψευδῆ ἴδια τῶν ἀληθῶν προέταττεν, οὕτω κἀνταῦθα μετὰ τὰ ψευδῆ ἴδια ἔρχεται ἐπὶ τῶν κυρίως καί φησιν ὅτι τέταρτον ἴδιον τῆς ποιότητος ὥσπερ οὐσίας τὸ ταὐτὸν καὶ ἕτερον·", "seq": 4838}
{"id": "Elias_Passim_4839", "series": "CAG", "text": "οὐδὲν γάρ ἐστιν ὁμοιότης ἢ ποιοτήτων ταυτότης, ὥσπερ ἀνομοιότης ποιοτήτων διαφορά.", "seq": 4839}
{"id": "Elias_Passim_4840", "series": "CAG", "text": "τοῦτο δὲ καὶ ἐπὶ ψυχῆς ληπτέον, φημὶ τὸ ὅμοιον,", "seq": 4840}
{"id": "Elias_Passim_4841", "series": "CAG", "text": "ὡς αἰεὶ τὸν ὁμοῖον ἄγει θεὸς ὡς τὸν ὁμοῖον,", "seq": 4841}
{"id": "Elias_Passim_4842", "series": "CAG", "text": "καὶ ἐπὶ σώματος", "seq": 4842}
{"id": "Elias_Passim_4843", "series": "CAG", "text": "παῦροι γὰρ καὶ παῖδες ὁμοῖοι πατρὶ πέλονται,", "seq": 4843}
{"id": "Elias_Passim_4844", "series": "CAG", "text": "καὶ", "seq": 4844}
{"id": "Elias_Passim_4845", "series": "CAG", "text": "τίκτουσιν δὲ γυναῖκες ἐοικότα τέκνα γονεῦσι.", "seq": 4845}
{"id": "Elias_Passim_4846", "series": "CAG", "text": "Μετὰ τὰ τέσσαρα ἴδια τῆς ποιότητος ἀπορεῖ ὁ Ἀριστοτέλης ὅτι πῶς ἕξιν καὶ διάθεσιν ἤτοι ἐπιστήμην ὑπὸ δύο ἀνήγομεν κατηγορίας, ὑπὸ τὰ πρός τι καὶ τὴν ποιότητα·", "seq": 4846}
{"id": "Elias_Passim_4847", "series": "CAG", "text": "ἡ γὰρ ἕξις καὶ ἐπιστήμη παραδείγματα ἦσαν τῶν πρός τι·", "seq": 4847}
{"id": "Elias_Passim_4848", "series": "CAG", "text": "ἡ γὰρ ἐπιστήμη ἐπιστητοῦ ἐπιστήμη καὶ ἡ ἕξις ἑκτοῦ ἕξις.", "seq": 4848}
{"id": "Elias_Passim_4849", "series": "CAG", "text": "ἀλλὰ καὶ πρῶτον εἶδος τῆς ποιότητος ἦσαν ἕξις καὶ ἐπιστήμη ἤτοι διάθεσις.", "seq": 4849}
{"id": "Elias_Passim_4850", "series": "CAG", "text": "ἔσται οὖν τι κοινὸν τῶν γενικωτάτων καὶ οὐκέτι δέκα αἱ κατηγορίαι, ἐοικυῖαι τάγματι χιλίων ἀνδρῶν εἰς δέκα ἑκατοντάρχας διῃρημένων, ἐν οἷς τὸ ἕτερον οὐ τελεῖ ὑπὸ τὸ ἕτερον.", "seq": 4850}
{"id": "Elias_Passim_4851", "series": "CAG", "text": "καὶ λύει τοῦτο λέγων ὅτι ἡ καθόλου ἐπιστήμη πρός τι καὶ οὐ ποιότης, ἡ δὲ τὶς ἐπιστήμη, οἷον ἡ γραμματικὴ ἡ ἐν Ἀριστάρχῳ, ἡ ῥητορικὴ ἡ ἐν Δημοσθένει, ποιότητες καὶ οὐ πρός τι.", "seq": 4851}
{"id": "Elias_Passim_4852", "series": "CAG", "text": "καὶ τοῦτο κατασκευάζει ἐκ τῶν ὁρισμῶν ἑκατέρου, τῶν πρός τι καὶ τῆς ποιότητος·", "seq": 4852}
{"id": "Elias_Passim_4853", "series": "CAG", "text": "πρός τι γάρ ἐστιν ὅσα αὐτὰ ἅπερ ἐστὶν ἑτέρων εἶναι λέγεται·", "seq": 4853}
{"id": "Elias_Passim_4854", "series": "CAG", "text": "ἡ ἐπιστήμη οὖν τῶν πρός τι·", "seq": 4854}
{"id": "Elias_Passim_4855", "series": "CAG", "text": "ἡ γὰρ ἐπιστήμη ἐπιστητοῦ ἐπιστήμη.", "seq": 4855}
{"id": "Elias_Passim_4856", "series": "CAG", "text": "ποιότης δέ ἐστι καθ᾿ ἣν ποιοί τινες λέγονται εἶναι·", "seq": 4856}
{"id": "Elias_Passim_4857", "series": "CAG", "text": "λεγόμεθα δὲ γραμματικοὶ ἀπὸ τῆς γραμματικῆς·", "seq": 4857}
{"id": "Elias_Passim_4858", "series": "CAG", "text": "οὐδὲ γὰρ ἀπὸ τῆς καθόλου ἐπιστήμης λεγόμεθα ἐπιστήμονες τοῦδε τοῦ γράμματος (οὐδὲ γὰρ ἐνδέχεται ἄνθρωπον ἕνα πᾶσαν ἐπιστήμην ἔχειν, εἰ καὶ ὁ Πλάτων κέρματα ἀνθρώπου ἐκάλει τοὺς κατὰ μέρος ἀνθρώπους, ὡς μὴ δυναμένους πᾶσαν ἐπιστήμην ἔχειν), ἀλλὰ λεγόμεθα ἐπιστήμονες ἀπό τινος ἐπιστήμης·", "seq": 4858}
{"id": "Elias_Passim_4859", "series": "CAG", "text": "ἡ γὰρ γραμματικὴ οὐ λέγεται γραμματικὴ φωνῶν, ἀλλ᾿ ἐπιστήμη φωνῶν.", "seq": 4859}
{"id": "Elias_Passim_4860", "series": "CAG", "text": "καὶ ἰδοὺ οἶδε καὶ ὁ Ἀριστοτέλης τὸ σημαινόμενον τῶν πρός τι τὸ μὴ δι᾿ ἑαυτὸ πρός τι, ἀλλὰ διὰ τὴν πρὸς τὸ γένος ἀναφοράν, οἷον ἡ γραμματική.", "seq": 4860}
{"id": "Elias_Passim_4861", "series": "CAG", "text": "καὶ ἀποροῦσι πρὸς τὴν λύσιν ὅτι πῶς τοῦ γένους ὑπ᾿ ἄλλην ἀναγομένου τὰ εἴδη ὑπὸ ἑτέραν κατηγορίαν ἀνάγεται·", "seq": 4861}
{"id": "Elias_Passim_4862", "series": "CAG", "text": "ἰδοὺ γὰρ ἡ ἐπιστήμη ὑπὸ τὰ πρός τι, ἡ δὲ γραμματικὴ εἶδος οὖσα τῆς ἐπιστήμης καὶ διὰ τοῦτο τῶν πρός τι ὑπὸ τὴν ποιότητα·", "seq": 4862}
{"id": "Elias_Passim_4863", "series": "CAG", "text": "καὶ γὰρ ἐλέγετο ἀνωτέρω ὅτι ὅσα τῶν ἐπάνω κατηγορεῖται, καὶ τῶν ὑποκάτω·", "seq": 4863}
{"id": "Elias_Passim_4864", "series": "CAG", "text": "διὰ τί οὖν τὰ πρός τι τῆς ἐπιστήμης κατηγορούμενα τῆς γραμματικῆς οὐ κατηγορηθήσεται;", "seq": 4864}
{"id": "Elias_Passim_4865", "series": "CAG", "text": "καὶ λέγομεν πρὸς τοῦτο ὅτι ἡ ἐπιστήμη ὡς ποιότης κατηγορηθήσεται τῆς γραμματικῆς, οὐχ ὡς πρός τι, εἰ καὶ συμβέβηκεν αὐτῇ ἀμφότερα, καὶ πρός τι εἶναι καὶ ποιότητα κατ᾿ ἄλλο καὶ ἄλλο νοούμενον.", "seq": 4865}
{"id": "Elias_Passim_4866", "series": "CAG", "text": "καὶ ὡς ποιότης μὲν οὖσα κατὰ φύσιν, διεβίβασε τὸ κατηγορούμενον αὐτῆς κατὰ φύσιν εἰς τὰ εἴδη, τὸ δὲ πρός τι ὡς κατὰ δεύτερον λόγον αὐτῇ ὑπάρχον οὐ διεβίβασεν εἰς τὰ οἰκεῖα εἴδη.", "seq": 4866}
{"id": "Elias_Passim_4867", "series": "CAG", "text": "λέγει καὶ δευτέραν λύσιν ὁ Ἀριστοτέλης·", "seq": 4867}
{"id": "Elias_Passim_4868", "series": "CAG", "text": "ὅτι εἰ τὸ αὐτὸ ὑπὸ δύο κατηγορίας ἀνήγετο, ὧν οὐδὲ ἑτέρα πρός τι, ἀπορεῖν ἐχρῆν, <ἀλλ᾿ οὐκ ἀπορεῖν ἐχρῆν> ὅτι εἰ τὸ αὐτὸ δυνατὸν ὑπὸ δύο κατηγορίας ἀνάγεσθαι, ὧν ἡ ἑτέρα [οὐ] πρός τι.", "seq": 4868}
{"id": "Elias_Passim_4869", "series": "CAG", "text": "τοὐναντίον ἀπορεῖν ἐχρῆν ὅτι εἰ τὸ αὐτὸ μὴ καὶ ὑπὸ ἄλλην κατηγορίαν ἀνήγετο·", "seq": 4869}
{"id": "Elias_Passim_4870", "series": "CAG", "text": "οὐδὲν γὰρ τῶν ὄντων πρός τι μόνως, ἀλλ᾿ ἢ πρός τι καὶ οὐσία ἢ πρός τι καὶ ποσὸν ἢ πρός τι καὶ ποιόν.", "seq": 4870}
{"id": "Elias_Passim_4871", "series": "CAG", "text": "εἰπὲ καὶ ἄλλην σὺ λύσιν, ὅτι οὐδὲν ἄτοπον τὸ αὐτὸ ὑπὸ δύο κατηγορίας ἀνάγεσθαι κατ᾿ ἄλλο καὶ ἄλλο·", "seq": 4871}
{"id": "Elias_Passim_4872", "series": "CAG", "text": "οἷον ἡ γραμματικὴ ὡς ἐπιστήμη καὶ ὑπὸ τὰ πρός τι καὶ ὑπὸ τὴν ποιότητα·", "seq": 4872}
{"id": "Elias_Passim_4873", "series": "CAG", "text": "εἰ μὲν γὰρ ὡς πρὸς τὸ ἐν ᾧ ὑπόκειται, τὴν ψυχήν, ἀπίδῃ τις, ποιότης, εἰ δὲ πρὸς τὸ περὶ ὃ ἐνεργεῖ, φημὶ τὰς φωνάς, ἐπιστήμη.", "seq": 4873}
{"id": "Elias_Passim_4874", "series": "CAG", "text": "ἀλλὰ ποίαν συνέχειαν ἔχει τὰ νῦν λεγόμενα πρὸς τὸ τέταρτον ἴδιον τῆς ποιότητος;", "seq": 4874}
{"id": "Elias_Passim_4875", "series": "CAG", "text": "καὶ λέγομεν ὅτι ναί, εἴ γε κατέληξεν ὁ περὶ ποιότητος λόγος εἰς τὸ ὅμοιον καὶ ἀνόμοιον, ταῦτα δὲ καὶ πρός τι (τὸ γὰρ ὅμοιον ὁμοίῳ ὅμοιον καὶ τὸ ἀνόμοιον ἀνομοίῳ ἀνόμοιον) καὶ ποιότητες ἄμφω·", "seq": 4875}
{"id": "Elias_Passim_4876", "series": "CAG", "text": "ὁμοιότης γάρ ἐστι ποιοτήτων ταυτότης.", "seq": 4876}
{"id": "Elias_Passim_4877", "series": "CAG", "text": "ταῦτα ἔχει ἡ θεωρία.", "seq": 4877}
{"id": "Elias_Passim_4878", "series": "CAG", "text": "ἐν οἷς καὶ ὁ περὶ ποιότητος λόγος.", "seq": 4878}
{"id": "Elias_Passim_4879", "series": "CAG", "text": "Περὶ τοῦ ποιεῖν καὶ πάσχειν.", "seq": 4879}
{"id": "Elias_Passim_4880", "series": "CAG", "text": "Οὐχ αἱ μὲν τῶν κατηγοριῶν ἁπλαῖ αἱ δὲ συμπεπλεγμέναι·", "seq": 4880}
{"id": "Elias_Passim_4881", "series": "CAG", "text": "οὐ γὰρ συμπεπλεγμένον τὸ ποιεῖν καὶ πάσχειν, εἰ καὶ τὸ ποιοῦν καὶ τὸ πάσχον·", "seq": 4881}
{"id": "Elias_Passim_4882", "series": "CAG", "text": "ἐξ οὐσίας γὰρ καὶ ἐνεργείας τὸ ποιοῦν, ἀσθενείας δὲ καὶ πείσεως τὸ πάσχον.", "seq": 4882}
{"id": "Elias_Passim_4883", "series": "CAG", "text": "οὐδὲ τὸ ἐν τόπῳ εἶναι ἢ χρόνῳ σύνθετα, εἰ καὶ τὸ ἐν τόπῳ ὂν ἐξ οὐσίας καὶ τόπου καὶ τὸ ἐν χρόνῳ ὂν ἐξ οὐσίας καὶ χρόνου, καὶ διὰ τοῦτο σύνθετα.", "seq": 4883}
{"id": "Elias_Passim_4884", "series": "CAG", "text": "οὐδὲ τὸ κεῖσθαι καὶ τὸ ἔχειν σύνθετα, εἰ καὶ τὸ κείμενον καὶ τὸ ἔχον σύνθετα ἐξ οὐσίας καὶ θέσεως καὶ σχέσεως.", "seq": 4884}
{"id": "Elias_Passim_4885", "series": "CAG", "text": "ἀλλὰ πᾶσαι αἱ κατηγορίαι ἁπλαῖ·", "seq": 4885}
{"id": "Elias_Passim_4886", "series": "CAG", "text": "πᾶσα γὰρ κατηγορία ἁπλῆ ἐστι νοῆσαι καὶ γενικώτατον.", "seq": 4886}
{"id": "Elias_Passim_4887", "series": "CAG", "text": "εἰ δέ τις ἀπορεῖ ὅτι πῶς γενικώτατον τὸ ἐκ συμπλοκῆς ἄλλων γενόμενον (τὰ γὰρ ἁπλᾶ πρότερα τῶν συνθέτων), ἐροῦμεν λύσιν τοιαύτην·", "seq": 4887}
{"id": "Elias_Passim_4888", "series": "CAG", "text": "ὅτι ἀληθὲς τὸ προηγεῖσθαι τὰ ἁπλᾶ τῶν συνθέτων, καὶ προτέτακται ἡ οὐσία πάσης κατηγορίας, δεύτερον τὸ ποσόν, τρίτον τὸ πρός τι, τέταρτον τὸ ποιόν (οὐκοῦν καὶ ἐν συνθέσει φυλάττεται ἡ τάξις ἐν ταῖς κατηγορίαις·", "seq": 4888}
{"id": "Elias_Passim_4889", "series": "CAG", "text": "διὰ τοῦτο οὐδὲ τὸ ὂν συνωνύμως κατηγορηθήσεται τῶν δέκα κατηγοριῶν), ἀλλ᾿ ὅταν λέγωμεν ὅτι γενικώτατον τὸ ποιεῖν ἢ πάσχειν ἢ ἄλλην ὁποιανοῦν κατηγορίαν, οὔ φαμεν ὅτι οὐδέν ἐστι πρὸ αὐτῶν (εἰσὶ γὰρ πρὸ αὐτῶν τὰ ἐξ ὧν ἐγένοντο), ἀλλ᾿ ὅτι γένος οἰκεῖον οὐκ ἔχουσι πρὸ αὐτῶν συνωνύμως κατηγορηθῆναι ὀφεῖλον·", "seq": 4889}
{"id": "Elias_Passim_4890", "series": "CAG", "text": "εἰ γὰρ τοῦτο, οὐκ ἔστι γενικώτατον.", "seq": 4890}
{"id": "Elias_Passim_4891", "series": "CAG", "text": "γενικώτατα δέ εἰσι πᾶσαι αἱ κατηγορίαι ὡς ἁπλαῖ νοῆσαι, κἂν ἐκ συμπλοκῆς ἄλλων ἐγένοντο·", "seq": 4891}
{"id": "Elias_Passim_4892", "series": "CAG", "text": "μία γὰρ ἡ σχέσις τῶν δύο πραγμάτων, ὥσπερ μία ὁδὸς <ἀπὸ> Ἀθηνῶν εἰς Θήβας καὶ ἀπὸ Θηβῶν εἰς Ἀθήνας, αἱ δὲ πόλεις δύο.", "seq": 4892}
{"id": "Elias_Passim_4893", "series": "CAG", "text": "εἰ δέ τις εἴποι ὅτι ‘καὶ τὰ πρός τι δύο εἰσὶ πράγματα ἔχοντα μίαν σχέσιν καὶ τί διοίσουσι τούτων;’", "seq": 4893}
{"id": "Elias_Passim_4894", "series": "CAG", "text": ", φαμὲν πρὸς αὐτὸν ὅτι τὰ πρός τι πρὸς ἀντιστρέφοντα λέγεται ἀεί, κἂν μία ἡ σχέσις αὐτῶν·", "seq": 4894}
{"id": "Elias_Passim_4895", "series": "CAG", "text": "οὐ πάντως δὲ ὅπου συμπλοκὴ δύο πραγμάτων καὶ σχέσις εὐθύτητος, καὶ πρός τι εἴη καὶ πρὸς ἀντιστρέφοντα λέγοιντο·", "seq": 4895}
{"id": "Elias_Passim_4896", "series": "CAG", "text": "Ἀθῆναι γὰρ καὶ Θῆβαι οὐ πρός τι, κἂν μία ὁδὸς μεταξύ, οὐδὲ τὸ ‘Σωκράτης περιπατεῖ’ τῶν πρός τι, ὂν συμπεπλεγμένον, οὐδὲ τὸ ποιοῦν ἐξ οὐσίας ὂν καὶ ἐνεργείας πρός τι·", "seq": 4896}
{"id": "Elias_Passim_4897", "series": "CAG", "text": "οὐ γὰρ πρὸς τὸ πάσχον αὐτὸ παραβάλλοντες νῦν τὴν ποιεῖν κατηγορίαν νοοῦμεν, ἀλλ᾿ αὐτὸ τὸ ποιοῦν μόνον θεωροῦντες καθ᾿ αὑτὸ συμπεπλεγμένον ἐξ οὐσίας καὶ ἐνεργείας τὸ ποιεῖν τὸ ἁπλοῦν ἐπινοοῦμεν κατηγορίαν.", "seq": 4897}
{"id": "Elias_Passim_4898", "series": "CAG", "text": "τὰ αὐτὰ καὶ ἐπὶ τῶν λοιπῶν συμπεπλεγμένων κατηγοριῶν ἀκουστέον, ἤγουν συνθέτων.", "seq": 4898}
{"id": "Elias_Passim_4899", "series": "CAG", "text": "σύνθετοι δὲ λέγονται τῷ ἐκ συμπλοκῆς ἀλλήλων αὐτὰς γενέσθαι.", "seq": 4899}
{"id": "Elias_Passim_4900", "series": "CAG", "text": "διὸ καὶ ἀπαρεμφάτοις ῥήμασιν αὐτὰς ὀνομάζει ποιεῖν, πάσχειν, ἵνα μὴ τὸ ἐφέλκεσθαι πρόσωπον συνθέτους αὐτὰς ποιήσῃ, ἢ ἐπιρρήμασιν ὀνομάζει τινὰς ἐξ αὐτῶν ἰσοδυναμοῦσι ῥήμασιν ἀπαρεμφάτοις·", "seq": 4900}
{"id": "Elias_Passim_4901", "series": "CAG", "text": "τὸ γὰρ ποῦ ταὐτὸν τῷ ἐν τόπῳ εἶναι καὶ τὸ ποτέ τῷ ἐν χρόνῳ εἶναι, τὸ δὲ εἶναι ἀπαρέμφατον ῥῆμα.", "seq": 4901}
{"id": "Elias_Passim_4902", "series": "CAG", "text": "Μηκύνας οὖν ὁ Ἀριστοτέλης τὸν περὶ τῶν ἁπλῶν κατηγοριῶν λόγον ἔχει δι᾿ αὐτῶν καὶ τὰς συμπεπλεγμένας.", "seq": 4902}
{"id": "Elias_Passim_4903", "series": "CAG", "text": "προέταξε δὲ τῶν συμπεπλεγμένων τὸ ποιεῖν καὶ πάσχειν διὰ δύο αἰτίας·", "seq": 4903}
{"id": "Elias_Passim_4904", "series": "CAG", "text": "ἢ ὅτι περὶ ποιότητα τὸ ποιεῖν καὶ πάσχειν ἢ ὅτι ἐμνήσθη ἐν τῷ περὶ ποιότητος λόγῳ τοῦ ποιεῖν καὶ πάσχειν, ὅτε τὴν διὰ φόβον ὠχρίασιν καὶ τὸ δι᾿ αἰδῶ ἔρευθος ὑπὸ τὸ πάσχειν ἀνήγαγεν.", "seq": 4904}
{"id": "Elias_Passim_4905", "series": "CAG", "text": "ἐπέγραψε δὲ Περὶ τοῦ ποιεῖν καὶ πάσχειν, οὐ Περὶ ποιοῦντος καὶ πάσχοντος, διότι τὸ ποιοῦν καὶ πάσχον τῶν πρός τι, οὐ Περὶ ποιήσεως καὶ παθήσεως·", "seq": 4905}
{"id": "Elias_Passim_4906", "series": "CAG", "text": "ἡ γὰρ ποίησις διττή·", "seq": 4906}
{"id": "Elias_Passim_4907", "series": "CAG", "text": "λέγεται γὰρ ποίησις καὶ αὐτὴ ἡ ἐνέργεια καὶ τὸ ἀποτέλεσμα, οἷον ἀβάκιον, ἅπερ προδήλως ὑπὸ ἄλλην κατηγορίαν ἀνάγονται.", "seq": 4907}
{"id": "Elias_Passim_4908", "series": "CAG", "text": "οὕτω δὲ συγγενὲς τὸ ποιεῖν καὶ πάσχειν τῇ ποιότητι, ὅτι καὶ τὰ ἴδια τῆς ποιότητος ὑπάρχει τῷ ποιεῖν καὶ πάσχειν·", "seq": 4908}
{"id": "Elias_Passim_4909", "series": "CAG", "text": "ἐναντία γὰρ τὸ ποιεῖν καὶ ποιεῖν, οἷον τὸ θερμαίνειν τῷ ψύχειν ἐστὶν ἐναντίον.", "seq": 4909}
{"id": "Elias_Passim_4910", "series": "CAG", "text": "ἀλλὰ καὶ τὸ πάσχειν τῷ πάσχειν ἐναντίον·", "seq": 4910}
{"id": "Elias_Passim_4911", "series": "CAG", "text": "τὸ γὰρ θερμαίνεσθαι τῷ ψύχεσθαι ἐναντίον.", "seq": 4911}
{"id": "Elias_Passim_4912", "series": "CAG", "text": "ὑπάρχει δὲ τῷ ποιεῖν καὶ πάσχειν ὥσπερ τὰ ἐναντία οὕτω καὶ τὸ μᾶλλον καὶ ἧττον·", "seq": 4912}
{"id": "Elias_Passim_4913", "series": "CAG", "text": "ἔστι γὰρ μᾶλλον θερμαίνειν καὶ μᾶλλον ψύχειν καὶ ἧττον θερμαίνειν καὶ ἧττον ψύχειν, καὶ μᾶλλον θερμαίνεσθαι καὶ ψύχεσθαι καὶ ἧττον.", "seq": 4913}
{"id": "Elias_Passim_4914", "series": "CAG", "text": "Ἐπειδὴ δὲ αἱ κατηγορίαι πλήθει τῶν ὑφ᾿ ἑαυτὰς εἰδῶν χαρακτηρίζονται ὡς γενικώταται οὖσαι, εἴπωμεν τὰ εἴδη ἑκάστης τῶν ἓξ κατηγοριῶν.", "seq": 4914}
{"id": "Elias_Passim_4915", "series": "CAG", "text": "τὸ ποιεῖν τοίνυν διττόν·", "seq": 4915}
{"id": "Elias_Passim_4916", "series": "CAG", "text": "ἢ γὰρ εἰς ἑαυτὸ ἢ εἰς ἕτερον ποιεῖ τι, καὶ εἰς ἑαυτὸ μὲν ὡς ἡ ψυχὴ ζωοῦσα ἑαυτήν, εἰς ἕτερον δὲ ὥσπερ ἡ αἴσθησις ἐνεργοῦσα περὶ τὸ αἰσθητόν·", "seq": 4916}
{"id": "Elias_Passim_4917", "series": "CAG", "text": "ὅ τι μὲν γὰρ ὁρᾷ ἡ αἴσθησις οἶδε, διὰ τί δὲ ὁρᾷ οὐκ οἶδε.", "seq": 4917}
{"id": "Elias_Passim_4918", "series": "CAG", "text": "καὶ ἄλλως τὸ ποιεῖν διττόν·", "seq": 4918}
{"id": "Elias_Passim_4919", "series": "CAG", "text": "ἢ γὰρ καθ᾿ ὁρμὴν ὡς ἐπὶ τοῦ ὑλακτοῦντος κυνός, ἢ κατὰ φύσιν ὡς τῷ πυρὶ τὸ καίειν φυσικῶς.", "seq": 4919}
{"id": "Elias_Passim_4920", "series": "CAG", "text": "καὶ τὸ πάσχειν διττόν·", "seq": 4920}
{"id": "Elias_Passim_4921", "series": "CAG", "text": "ἢ γὰρ φθαρτικόν ἐστιν ὡς ἐπὶ τοῦ τέμνεσθαι καὶ καίεσθαι, ἢ τελειωτικὸν ὡς τὸ μανθάνειν, γινώσκειν.", "seq": 4921}
{"id": "Elias_Passim_4922", "series": "CAG", "text": "τὸ ποῦ ἑξαχῶς·", "seq": 4922}
{"id": "Elias_Passim_4923", "series": "CAG", "text": "τὸ γὰρ ποῦ ἐστι τὸ ἐν τόπῳ εἶναι, ὁ δὲ τόπος πέρας τοῦ περιέχοντος, τὸ δὲ περιεχόμενον σῶμα, παντὸς δὲ σώματος τρεῖς εἰσι διαστάσεις, ἐπειδὴ καὶ τρεῖς μόναι εὐθεῖαι πρὸς ὀρθὰς γωνίας δύνανται συμβάλλειν ἑαυταῖς καθ᾿ ἓν σημεῖον, πάσης δὲ διαμέτρου δύο εἰσὶ πέρατα, ὡς γίνεσθαι ἓξ διαστάσεις, ἄνω, κάτω, πρόσω, ὀπίσω, δεξιά, ἀριστερά.", "seq": 4923}
{"id": "Elias_Passim_4924", "series": "CAG", "text": "καὶ τὸ μὲν ἄνω καὶ κάτω ποιεῖ τὸ ὑπὲρ γῆν καὶ ὑπὸ γῆν ἡμισφαίριον, τὸ δὲ δεξιὰ καὶ ἀριστερὰ ποιεῖ ἀνατολικὸν καὶ δυτικόν, τὸ πρόσω καὶ ὀπίσω ποιεῖ νότιον καὶ βόρειον.", "seq": 4924}
