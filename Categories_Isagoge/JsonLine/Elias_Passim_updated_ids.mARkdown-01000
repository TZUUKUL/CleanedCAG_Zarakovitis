{"id": "Elias_Passim_0001", "series": "CAG", "text": "ΠΡΟΛΕΓΟΜΕΝΑ ΣΥΝ ΘΕΩΙ ΤΗΣ ΦΙΛΟΣΟΦΙΑΣ.", "seq": 1}
{"id": "Elias_Passim_0002", "series": "CAG", "text": "Πρᾶξις α΄.", "seq": 2}
{"id": "Elias_Passim_0003", "series": "CAG", "text": "Ἐπειδὴ πάντα τοῦ ἀγαθοῦ ἐφίεται καὶ κοινὸς πάντων ὅρμος ἐστὶ τὸ ἀγαθόν (ἀγαθὸν γὰρ εἴρηται διὰ τὸ ἄγαν θέειν ἐπ᾿ αὐτὸ πάντα·", "seq": 3}
{"id": "Elias_Passim_0004", "series": "CAG", "text": "τὸ δὲ ἀγαθὸν ἐπίτασιν δηλοῖ, ὅθεν καὶ γραμματικῶν παῖδες παραγγέλλουσι μὴ λέγειν ἀγαθώτερον καὶ ἀγαθώτατον διὰ τὸ μὴ ἐν μιᾷ λέξει δύο εἶναι ἐπιτατικώτερα, ἀλλὰ λέγειν μᾶλλον ἀγαθόν, δύο γὰρ λέξεις ἐνταῦθά εἰσι, καὶ μάλιστα ἀγαθόν, ὅπερ ἐπιτατικώτερον καὶ τοῦ μᾶλλόν ἐστι), τούτου χάριν τοῦ εἶναι μὲν καταφρονοῦμεν πολλάκις, τοῦ δὲ ἀγαθοῦ οὐ καταφρονοῦμεν·", "seq": 4}
{"id": "Elias_Passim_0005", "series": "CAG", "text": "καὶ αὐτοὶ γὰρ οἱ τὰ κακὰ διαπραττόμενοι οὐχ ᾗ κακὰ διαπράττονται, ἀλλ᾿ ᾗ ἀγαθά·", "seq": 5}
{"id": "Elias_Passim_0006", "series": "CAG", "text": "ὁ γοῦν ἰατρὸς ἑλκοῖ τὸ σῶμα φλεβοτομῶν, οὐχ ἑλκῶσαι προθέμενος ἀλλ᾿ ὑγιάσαι βουλόμενος, καὶ ὁ φονεὺς ἐγχειρεῖ τῷ φόνῳ οὐχ ὡς φόνου ὀρεγόμενος ἀλλὰ διὰ τὸ προσγινόμενον αὐτῷ ἐξ αὐτοῦ κέρδος, ὅπερ ἐκεῖνος ἀγαθὸν νομίζει.", "seq": 6}
{"id": "Elias_Passim_0007", "series": "CAG", "text": "πάντα οὖν τοῦ ἀγαθοῦ ἐφίεται, ἀλλ᾿ ἢ τοῦ ὄντως ἀγαθοῦ ἢ τοῦ νομιζομένου, οὐ πάντως δὲ ἀγαθοῦ.", "seq": 7}
{"id": "Elias_Passim_0008", "series": "CAG", "text": "Εἰ οὖν πάντα τοῦ ἀγαθοῦ ἐφίεται, ὃ ἂν δειχθῇ μᾶλλον ἀγαθόν, τούτου μᾶλλον ἐφίεται·", "seq": 8}
{"id": "Elias_Passim_0009", "series": "CAG", "text": "ὡς γὰρ τὸ μᾶλλον θερμὸν μᾶλλον θερμαίνει καὶ τὸ μᾶλλον ψυχρὸν μᾶλλον ψύχει, οὕτω καὶ τοῦ μᾶλλον ἀγαθοῦ μᾶλλον πάντα ἐφίεται.", "seq": 9}
{"id": "Elias_Passim_0010", "series": "CAG", "text": "καὶ ἡμεῖς οὖν διάπυροι καὶ ἐκμανεῖς ἐρασταὶ φιλοσοφίας γινόμεθα, εἰ τὸ παραγινόμενον ἡμῖν ἐξ αὐτῆς ἀγαθὸν γνῶμεν ὁποῖόν ἐστι·", "seq": 10}
{"id": "Elias_Passim_0011", "series": "CAG", "text": "μέγα γὰρ τὸ ἀγαθὸν τῆς φιλοσοφίας καὶ τοιοῦτον ὁποῖον ἐδήλωσεν ὁ Πλάτων περὶ αὐτοῦ εἰπὼν ὅτι ‘τοιοῦτον ἀγαθὸν εἰς ἀνθρώπους οὐδὲ ἦλθεν οὐδὲ ἥξει ποτὲ δωρηθὲν ἐκ θεοῦ.’", "seq": 11}
{"id": "Elias_Passim_0012", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ τὸ ἀγαθὸν τῆς φιλοσοφίας γνῶναι οὐ δυνατὸν τῆς φύσεως αὐτῆς ἀγνοουμένης, δεῖ τὴν φύσιν αὐτῆς εἰπεῖν ὁποία τυγχάνει·", "seq": 12}
{"id": "Elias_Passim_0013", "series": "CAG", "text": "τῆς γὰρ διαφόρου φύσεως διάφορον καὶ τὸ ἀγαθόν.", "seq": 13}
{"id": "Elias_Passim_0014", "series": "CAG", "text": "οὕτω γοῦν ἵππου ἀγαθὸν τὸ ἴτην εἶναι καὶ πορευτικὸν τοῖς ποσίν, ἀνθρώπου δὲ ἀγαθὸν τὸ ἀναθρεῖν ἃ ὄπωπεν·", "seq": 14}
{"id": "Elias_Passim_0015", "series": "CAG", "text": "μόνος γὰρ τῶν ζῴων ἄνθρωπος ἀναμιμνήσκεται τῶν ἀλόγων μνήμην ἐχόντων μόνον, ὡς δηλοῖ ὁ κύων τοῦ Ὀδυσσέως ὁ Ἄργος φυλάξας τὴν μνήμην εἰς εἴκοσιν ἔτη.", "seq": 15}
{"id": "Elias_Passim_0016", "series": "CAG", "text": "οὐ ταὐτὸν δὲ μνήμη καὶ ἀνάμνησις·", "seq": 16}
{"id": "Elias_Passim_0017", "series": "CAG", "text": "μνήμη μὲν γάρ ἐστι μονὴ νοῦ, ἀνάμνησις δὲ ἀπολομένης μνήμης ἀνανέωσις.", "seq": 17}
{"id": "Elias_Passim_0018", "series": "CAG", "text": "καὶ ἡμεῖς μὲν οὕτως.", "seq": 18}
{"id": "Elias_Passim_0019", "series": "CAG", "text": "ὁ δὲ φιλόσοφος Πρόκλος βούλεται ἐν τοῖς εἰς Φαίδωνα ὑπομνήμασιν ἔχειν καὶ τὰ ἄλογα ἀνάμνησιν·", "seq": 19}
{"id": "Elias_Passim_0020", "series": "CAG", "text": "ὑπερβαίνει γάρ, φησί, τὴν ἐκείνων ζωὴν τὸ ἀμετάπτωτον τῆς γνώσεως·", "seq": 20}
{"id": "Elias_Passim_0021", "series": "CAG", "text": "τὸ γὰρ διὰ παντὸς μεμνῆσθαι αὐτὰ καὶ μὴ ἐπιλανθάνεσθαι ὑπὲρ τὴν ἐκείνων φύσιν ἐστί·", "seq": 21}
{"id": "Elias_Passim_0022", "series": "CAG", "text": "τοῖς γὰρ ἀνθρώποις κρείττοσιν οὖσιν οὐχ ὑπάρχει τοῦτο.", "seq": 22}
{"id": "Elias_Passim_0023", "series": "CAG", "text": "ἐπιλανθάνεται δὲ καὶ τὰ ἄλογα·", "seq": 23}
{"id": "Elias_Passim_0024", "series": "CAG", "text": "δεινοῖς γάρ ποτε περιπεσόντα αὖθις τοῖς αὐτοῖς περιπίπτει καὶ τὰ πρότερον σαίνοντα μετὰ χρόνον ὑλακτεῖ καὶ ἀγριαίνει πρὸς τούς ποτε συνήθεις.", "seq": 24}
{"id": "Elias_Passim_0025", "series": "CAG", "text": "ὅθεν δῆλον ὅτι ἐπιλανθάνεται καὶ ἀναμιμνήσκεται.", "seq": 25}
{"id": "Elias_Passim_0026", "series": "CAG", "text": "ὅτι δὲ ἔχει ἀνάμνησιν, δῆλον κἀντεῦθεν ἐκ τοῦ μὴ ὁμοίως εἰς συνήθειαν ἄγεσθαι τῷ προοραθέντι καὶ τῷ πάντῃ ξένῳ·", "seq": 26}
{"id": "Elias_Passim_0027", "series": "CAG", "text": "θᾶττον γὰρ ἐν συνηθείᾳ γίνεται τοῦ προοραθέντος, ὡς φυλάξας δῆλον ὅτι τύπον τινὰ καὶ δι᾿ αὐτοῦ λαβὼν ἀφορμὴν ἀναμνήσεως.", "seq": 27}
{"id": "Elias_Passim_0028", "series": "CAG", "text": "πλὴν εἰ καὶ ἐπὶ ἀμφοτέρων ἐστὶν ἀνάμνησις, ἀλλ᾿ οὖν διαφορά τίς ἐστιν·", "seq": 28}
{"id": "Elias_Passim_0029", "series": "CAG", "text": "ἐπὶ μὲν γὰρ ἀνθρώπου σὺν τῇ ἀναμνήσει ἐστὶ καὶ τὸ συναισθάνεσθαι αὐτοὺς τῆς ἀναμνήσεως, ἐπὶ δὲ τῶν ἀλόγων οὐκ ἔστι τοῦτο·", "seq": 29}
{"id": "Elias_Passim_0030", "series": "CAG", "text": "οὐδὲ γὰρ συναισθάνεται ἐκεῖνα ὅτι ἀνεμνήσθη·", "seq": 30}
{"id": "Elias_Passim_0031", "series": "CAG", "text": "ὥσπερ γὰρ ἡ ὄψις ὁρᾷ μέν, οὐκ οἶδεν δὲ ὅτι ὁρᾷ, οὕτως καὶ ἐπ᾿ ἐκείνων ἐστίν.", "seq": 31}
{"id": "Elias_Passim_0032", "series": "CAG", "text": "Ἔδειξεν οὖν ὁ λόγος ὅτι τῆς διαφόρου φύσεως καὶ τὸ ἀγαθὸν διάφορον.", "seq": 32}
{"id": "Elias_Passim_0033", "series": "CAG", "text": "διὰ τοῦτο οὖν χρὴ καὶ τῆς φιλοσοφίας τὴν φύσιν εἰδέναι.", "seq": 33}
{"id": "Elias_Passim_0034", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ ταύτην χωρὶς ὁρισμοῦ γνῶναι ἀδύνατον (οἱ γὰρ ὁρισμοὶ ἀνατομαὶ καὶ ἀναπτύξεις εἰσὶ τῶν φύσεων), δεῖ ἐκ τοῦ ὁρισμοῦ ἄρξασθαι·", "seq": 34}
{"id": "Elias_Passim_0035", "series": "CAG", "text": "εἰς τοιαύτην γὰρ ἀνάγκην κατήντησεν ὁ λόγος.", "seq": 35}
{"id": "Elias_Passim_0036", "series": "CAG", "text": "τοῦ δὲ ὁρισμοῦ πρόσρημα τὸ τί ἐστιν·", "seq": 36}
{"id": "Elias_Passim_0037", "series": "CAG", "text": "ἐκ τούτου οὖν δεῖ ἄρξασθαι, ὡς ἔδειξεν ὁ λόγος.", "seq": 37}
{"id": "Elias_Passim_0038", "series": "CAG", "text": "τίς δὲ ὁ ὁρισμὸς τῆς φιλοσοφίας, ἐν ἑτέρᾳ θεωρίᾳ εὐμενείᾳ τοῦ κρείττοντος παραστήσομεν.", "seq": 38}
{"id": "Elias_Passim_0039", "series": "CAG", "text": "Πρᾶξις β΄.", "seq": 39}
{"id": "Elias_Passim_0040", "series": "CAG", "text": "Καὶ κατὰ δευτέραν δὲ αἰτίαν ὀφείλομεν ἀπὸ τοῦ τί ἐστιν ἄρξασθαι, τοῦτ᾿ ἔστι τοῦ ὁρισμοῦ, παρέντες τὸ εἰ ἔστιν·", "seq": 40}
{"id": "Elias_Passim_0041", "series": "CAG", "text": "ἔδει μὲν γὰρ ἡμᾶς ἀρχομένους τῆς φιλοσοφίας ἀπὸ τοῦ εἰ ἔστιν ἄρξασθαι, ἑπομένους νόμῳ διαλεκτικῷ τῷ λέγοντι δεῖν ἐπὶ πάσης τέχνης καὶ ἐπιστήμης τέσσαρα προβλήματα ζητεῖν, εἰ ἔστι, τί ἐστιν, ὁποῖόν τί ἐστι καὶ διὰ τί ἐστι.", "seq": 41}
{"id": "Elias_Passim_0042", "series": "CAG", "text": "καὶ εἰκότως καὶ τὸ μὲν εἰ ἔστι ζήτημα, ἐπειδὴ πολλὰ μὲν ὀνομάζονται, οὐχ ὑφεστήκασι δέ, οἷον τραγέλαφος, σκινδαψὸς καὶ τὰ τοιαῦτα.", "seq": 42}
{"id": "Elias_Passim_0043", "series": "CAG", "text": "ἕτερα δὲ ὀνομάζονται μέν, ἀμφιβαλλομένην δὲ ἔχουσι τὴν ὕπαρξιν, οἷον ἡ ἄναστρος σφαῖρα καὶ οἱ ἀντίποδες.", "seq": 43}
{"id": "Elias_Passim_0044", "series": "CAG", "text": "ἐπὶ τούτων πάντων ζητοῦμεν τὸ εἰ ἔστι.", "seq": 44}
{"id": "Elias_Passim_0045", "series": "CAG", "text": "τὸ δὲ τί ἐστι ζητοῦμεν ἐπὶ τῶν ὕπαρξιν ἐχόντων, θελόντων δὲ ἡμῶν γνῶναι τί εἰσιν, οἷον ἄνθρωπος καὶ ἵππος.", "seq": 45}
{"id": "Elias_Passim_0046", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ καὶ αὐτοὶ οἱ ἀναιροῦντες αὐτὴν ἄκοντες δεδώκασι τὸ εἶναι αὐτήν (ἀποδεῖξαι γὰρ βουλόμενοι ὅτι οὐκ ἔστιν εἰσάγουσιν αὐτήν·", "seq": 46}
{"id": "Elias_Passim_0047", "series": "CAG", "text": "ἡ γὰρ ἀπόδειξις μέρος φιλοσοφίας), τούτου χάριν ἀφέντες τὸ εἰ ἔστιν ἀπὸ τοῦ τί ἐστι τὴν ἀρχὴν ποιησώμεθα, χάριν ἐκείνοις τοῖς ἀναιρεῖν αὐτὴν ἐσπουδακόσιν ὁμολογοῦντες, ὅτι τοῦτο ἐπιτηδεύσαντες μᾶλλον ἡμῖν κατάδηλον αὐτὴν πεποιήκασι διὰ τῶν ἀποδείξεων, ἢ καὶ ὥς φησιν Ἀριστοτέλης ἐν τῷ Προτρεπτικῷ ἐπιγεγραμμένῳ, ἐν ᾧ προτρέπει τοὺς νέους πρὸς φιλοσοφίαν·", "seq": 47}
{"id": "Elias_Passim_0048", "series": "CAG", "text": "φησὶ γὰρ οὕτως·", "seq": 48}
{"id": "Elias_Passim_0049", "series": "CAG", "text": "“εἰ μὲν φιλοσοφητέον, φιλοσοφητέον, καὶ εἰ μὴ φιλοσοφητέον, φιλοσοφητέον·", "seq": 49}
{"id": "Elias_Passim_0050", "series": "CAG", "text": "πάντως ἄρα φιλοσοφητέον”·", "seq": 50}
{"id": "Elias_Passim_0051", "series": "CAG", "text": "εἰ μὲν γὰρ ἔστι, πάντως ὀφείλομεν φιλοσοφεῖν οὔσης αὐτῆς, εἰ δὲ μὴ ἔστι, καὶ οὕτως ὀφείλομεν ζητεῖν πῶς οὐκ ἔστιν ἡ φιλοσοφία·", "seq": 51}
{"id": "Elias_Passim_0052", "series": "CAG", "text": "ζητοῦντες δὲ φιλοσοφοῦμεν, ἐπειδὴ τὸ ζητεῖν αἰτία τῆς φιλοσοφίας ἐστί.", "seq": 52}
{"id": "Elias_Passim_0053", "series": "CAG", "text": "Καὶ κατὰ τρίτην δὲ αἰτίαν δεῖ ἀπὸ τοῦ τί ἐστιν ἄρξασθαι·", "seq": 53}
{"id": "Elias_Passim_0054", "series": "CAG", "text": "εἰ γὰρ αἱ προελθοῦσαι ἐκ τῆς φιλοσοφίας ῥητορικὴ καὶ γραμματικὴ καὶ ἰατρικὴ εὐθέως ὁρίζονται ἑαυτὰς καὶ ὑπογράφουσι, πολλῷ μᾶλλον ἡ φιλοσοφία τοῦτο πράξει εὑρέτις οὖσα τούτων καὶ τοῖς ἑαυτῆς χρήσεται εἰς ἑαυτήν·", "seq": 54}
{"id": "Elias_Passim_0055", "series": "CAG", "text": "ταύτης γὰρ εὕρημα ἡ ὁριστικὴ καὶ ἡ διαιρετική.", "seq": 55}
{"id": "Elias_Passim_0056", "series": "CAG", "text": "Δέδεικται γοῦν διὰ τριῶν αἰτιῶν ὅτι δεῖ ἡμᾶς ἀπὸ τοῦ ὁρισμοῦ ἄρξασθαι.", "seq": 56}
{"id": "Elias_Passim_0057", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ τὸν ὁρισμὸν τῆς φιλοσοφίας γνῶναι οὐ δυνατὸν τοῦ ἁπλῶς ὁρισμοῦ ἀγνοουμένου, ὥσπερ οὐδὲ γράφειν καλῶς δυνατὸν τὸν αὐτὸ τοῦτο ἁπλῶς γράφειν μὴ ἐπιστάμενον οὐδὲ ἀττικίζειν ἄνευ τοῦ ἁπλῶς διαλέγεσθαι, οὕτως οὐδὲ τὸν τινὰ ὁρισμὸν δυνατὸν γνῶναι τοῦ ἁπλῶς ὁρισμοῦ ἀγνοουμένου.", "seq": 57}
{"id": "Elias_Passim_0058", "series": "CAG", "text": "φέρε οὖν τρία τινὰ περὶ ὁρισμοῦ ζητήσωμεν·", "seq": 58}
{"id": "Elias_Passim_0059", "series": "CAG", "text": "πρῶτον μὲν τί ἐστιν ὁρισμός, δεύτερον πόθεν εἴρηται ὁρισμός, τρίτον πόθεν λαμβάνεται πᾶς ὁρισμός.", "seq": 59}
{"id": "Elias_Passim_0060", "series": "CAG", "text": "καὶ ἀρκτέον ἀπὸ τοῦ πρώτου.", "seq": 60}
{"id": "Elias_Passim_0061", "series": "CAG", "text": "Ὁρισμὸς τοίνυν ἐστὶ λόγος σύντομος τῆς ἑκάστου φύσεως δηλωτικός.", "seq": 61}
{"id": "Elias_Passim_0062", "series": "CAG", "text": "‘λόγος’ δὲ εἴρηται διὰ τὸ ὄνομα, ἐπειδὴ καὶ αὐτὸ δηλοῖ φύσιν (ἐὰν γὰρ εἴπω ἄνθρωπον, τῶν λοιπῶν ζῴων χωρίζω), ἀλλὰ μία λέξις τὸ ὄνομα, ὁ δὲ ὁρισμὸς σωρεία καὶ συναγωγή ἐστι πλειόνων λέξεων.", "seq": 62}
{"id": "Elias_Passim_0063", "series": "CAG", "text": "τὸ δὲ ‘σύντομος’ πρόσκειται διὰ τὰ ἀποτάδην λεγόμενα ῥητορικὰ καὶ ἰατρικὰ ἢ καὶ διὰ τὸ ὄνομα·", "seq": 63}
{"id": "Elias_Passim_0064", "series": "CAG", "text": "συντομωτάτη γὰρ ἡ διὰ τῶν ὀνομάτων δήλωσις, σύντομος δὲ καὶ ἡ διὰ τῶν ὁρισμῶν.", "seq": 64}
{"id": "Elias_Passim_0065", "series": "CAG", "text": "διὸ καὶ τὸν ὁρισμόν τινές φασιν ὄνομα ἐξηπλωμένον, τὸ δὲ ὄνομα ὁρισμὸν συνεσταλμένον.", "seq": 65}
{"id": "Elias_Passim_0066", "series": "CAG", "text": "πρόσκειται δὲ ‘τῆς ἑκάστου φύσεως δηλωτικός’ διὰ τὰς ὑπογραφάς·", "seq": 66}
{"id": "Elias_Passim_0067", "series": "CAG", "text": "αἱ γὰρ ὑπογραφαὶ οὐ τὴν ἑκάστου φύσιν δηλοῦσιν ἀλλὰ τὸ συμβαῖνον ἑκάστῳ, οἱ δὲ ὁρισμοὶ τὴν ἑκάστου φύσιν δηλοῦσι.", "seq": 67}
{"id": "Elias_Passim_0068", "series": "CAG", "text": "καὶ εἰκότως, ἐπειδὴ οἱ ὁρισμοὶ ἐκ τῶν κατ᾿ οὐσίαν λαμβάνονται (κατ᾿ οὐσίαν δὲ ἐκεῖνα λέγω ὧν χωρὶς οὐ δύναται ὑποστῆναι τὸ ὁριζόμενον, οἷον ἄνθρωπός ἐστι ζῷον λογικὸν θνητὸν νοῦ καὶ ἐπιστήμης δεκτικόν·", "seq": 68}
{"id": "Elias_Passim_0069", "series": "CAG", "text": "οὐδὲ γὰρ χωρὶς τοῦ ζῴου ἢ λογικοῦ ἢ θνητοῦ ἢ νοῦ καὶ ἐπιστήμης δεκτικοῦ ὑφίσταταί ποτε ὁ ἄνθρωπος ἢ ἐπινοεῖται, καὶ ἑνὸς δὲ τούτων ἀπόντος οὐχ ὑφίσταται), αἱ δὲ ὑπογραφαὶ ἐκ τῶν συμβεβηκότων λαμβανόνται, ἃ δύνανται χωρίζεσθαι χωρὶς φθορᾶς τοῦ ὑποκειμένου·", "seq": 69}
{"id": "Elias_Passim_0070", "series": "CAG", "text": "οἷον Σωκράτης ἐστὶν Ἀθηναῖος φαλακρὸς προγάστωρ σιμὸς μέλας·", "seq": 70}
{"id": "Elias_Passim_0071", "series": "CAG", "text": "τούτων χωρὶς δύναται ὑποστῆναι ὁ Σωκράτης.", "seq": 71}
{"id": "Elias_Passim_0072", "series": "CAG", "text": "εἰκότως οὖν τὸν ὁρισμὸν λέγομεν δηλωτικὸν τῆς φύσεως, ὡς τῶν ὑπογραφῶν οὐ τὴν φύσιν δηλουσῶν ἀλλὰ τὸ συμβαῖνον ἑκάστῳ·", "seq": 72}
{"id": "Elias_Passim_0073", "series": "CAG", "text": "ὅθεν καὶ ὑπογραφὴ εἴρηται οἱονεὶ ὑφειμένη γραφὴ οὖσα καὶ σκιαγραφία, ὡς τῶν ὁρισμῶν τῇ τελείᾳ γραφῇ ἀναλογούντων, λέγω δὴ τῇ διὰ τῶν χρωμάτων.", "seq": 73}
{"id": "Elias_Passim_0074", "series": "CAG", "text": "ἀποροῦσι δέ τινες ὅτι ‘εἰ τοῦ ὁρισμοῦ ὁρισμὸν εἶπας, εἰπὲ κἀκείνου ὁρισμὸν καὶ τοῦτο ἐπ᾿ ἄπειρον’.", "seq": 74}
{"id": "Elias_Passim_0075", "series": "CAG", "text": "πρὸς ὅ φαμεν ὅτι ὁ τὸν καθόλου ὁρισμὸν ὁρισάμενος λόγος καὶ ἑαυτὸν συμπεριέλαβεν, ὡς εἴ τις ἄνθρωπος ὁρίσαιτο τὸν καθόλου ἄνθρωπον·", "seq": 75}
{"id": "Elias_Passim_0076", "series": "CAG", "text": "ὁ γὰρ τοιοῦτος καὶ ἑαυτὸν συμπεριέλαβε·", "seq": 76}
{"id": "Elias_Passim_0077", "series": "CAG", "text": "καὶ ὁ ὁριζόμενος γὰρ ζῷον λογικὸν καὶ ὁ καθόλου ἄνθρωπος.", "seq": 77}
{"id": "Elias_Passim_0078", "series": "CAG", "text": "ἐν οἷς τὸ πρῶτον κεφάλαιον.", "seq": 78}
{"id": "Elias_Passim_0079", "series": "CAG", "text": "Πρᾶξις γ΄.", "seq": 79}
{"id": "Elias_Passim_0080", "series": "CAG", "text": "Δεύτερον ζητείσθω πόθεν εἴρηται ὁρισμός.", "seq": 80}
{"id": "Elias_Passim_0081", "series": "CAG", "text": "ὁρισμὸς τοίνυν εἴρηται ὡς ἐκ μεταφορᾶς τῶν ὁροθεσίων τῆς γῆς·", "seq": 81}
{"id": "Elias_Passim_0082", "series": "CAG", "text": "πάλαι γὰρ τοῦ Νείλου ἀνιόντος καὶ συγχέοντος τὰς ἀρούρας μετὰ τὴν ἀπόστασιν αὐτοῦ πόλεμοι ἐγίνοντο καὶ φόνοι περὶ τὴν διανομὴν τῆς γῆς.", "seq": 82}
{"id": "Elias_Passim_0083", "series": "CAG", "text": "ἐπενόησαν οὖν ὁροθέσιά τινα πρὸς δήλωσιν τῶν τόπων, καὶ ἐπαύσαντο τοῦ πολεμεῖν.", "seq": 83}
{"id": "Elias_Passim_0084", "series": "CAG", "text": "διὸ καὶ ἄκαινα μέτρον κέκληται παρ᾿ αὐτοῖς παρὰ τὴν στέρησιν τοῦ φόνου·", "seq": 84}
{"id": "Elias_Passim_0085", "series": "CAG", "text": "καίνω γὰρ τὸ φονεύω.", "seq": 85}
{"id": "Elias_Passim_0086", "series": "CAG", "text": "οὕτως οὖν καὶ οἱ ἐξηγηταὶ τῶν φύσεων ὁρισμοί, τοῦ δικαίου καὶ τῆς ἀντιστροφῆς στοχαζόμενοι, οὐδὲ ἐλλείπειν θέλουσιν οὐδὲ πλεονάζειν·", "seq": 86}
{"id": "Elias_Passim_0087", "series": "CAG", "text": "τότε γὰρ μόνον ἀντιστρέφουσιν, ἀντὶ τοῦ ἰσόστροφοί εἰσι τῷ πράγματι·", "seq": 87}
{"id": "Elias_Passim_0088", "series": "CAG", "text": "τὸ γὰρ ἀντί ἐπὶ τοῦ ἴσου λαμβάνεται, ὥσπερ ἀντίθεος καὶ ἀντιάνειρα καὶ τὰ τοιαῦτα.", "seq": 88}
{"id": "Elias_Passim_0089", "series": "CAG", "text": "καὶ θαυμαστὸς ὁ τῆς κακίας τῶν ὁρισμῶν τρόπος·", "seq": 89}
{"id": "Elias_Passim_0090", "series": "CAG", "text": "εἴ τε γὰρ ἐλλείψωσι τῇ λέξει, τῷ πράγματι πλεονάζουσιν, εἴ τε πλεονάσωσι τῇ λέξει, τῷ πράγματι, τῷ ὁριστῷ φημι, ἐλλείπουσιν·", "seq": 90}
{"id": "Elias_Passim_0091", "series": "CAG", "text": "οἷον ὡς ἵνα εἴπω ‘ὁ ἄνθρωπος ζῷον’, ἰδοὺ τῇ λέξει ἐνέλειπον, ἐπλεόνασα δὲ τῷ πράγματι συμπεριλαβὼν ἀγγέλους καὶ ἄλλα ζῷα.", "seq": 91}
{"id": "Elias_Passim_0092", "series": "CAG", "text": "εἰ δὲ πάλιν εἴπω ‘ὁ ἄνθρωπός ἐστι ζῷον λογικὸν θνητὸν νοῦ καὶ ἐπιστήμης δεκτικὸν μηχανικόν’, ἐπλεόνασα μὲν τῇ λέξει, τῷ δὲ πράγματι ἐνέλιπον, φημὶ τῷ ὁριστῷ, διότι οὐ πᾶς ἄνθρωπος μηχανικός·", "seq": 92}
{"id": "Elias_Passim_0093", "series": "CAG", "text": "εἴ τι μὲν γὰρ μηχανικόν, ἄνθρωπος, οὐκ εἴ τι δὲ ἄνθρωπος, μηχανικόν.", "seq": 93}
{"id": "Elias_Passim_0094", "series": "CAG", "text": "τότε οὖν ἀντιστρέφουσιν, ὅτε μήτε ἐλλείπωσι μήτε πλεονάζωσιν.", "seq": 94}
{"id": "Elias_Passim_0095", "series": "CAG", "text": "ἐν οἷς καὶ τὸ δεύτερον κεφάλαιον.", "seq": 95}
{"id": "Elias_Passim_0096", "series": "CAG", "text": "Τρίτον κεφάλαιον, ἐν ᾧ ζητητέον πόθεν λαμβάνεται πᾶς ὁρισμός.", "seq": 96}
{"id": "Elias_Passim_0097", "series": "CAG", "text": "καὶ λέγομεν ὅτι ἐκ τοῦ ὑποκειμένου ἢ ἐκ τοῦ τέλους ἢ ἐκ τοῦ συναμφοτέρου.", "seq": 97}
{"id": "Elias_Passim_0098", "series": "CAG", "text": "καὶ εἰκότως·", "seq": 98}
{"id": "Elias_Passim_0099", "series": "CAG", "text": "πᾶσα γὰρ τέχνη καὶ ἐπιστήμη καὶ ὑποκείμενον ἔχει καὶ τέλος, ὑποκείμενον μὲν περὶ ὃ καταγίνεται, τέλος δὲ ὃ προτίθεται ποιῆσαι.", "seq": 99}
{"id": "Elias_Passim_0100", "series": "CAG", "text": "τῇ ἰατρικῇ ὑπόκεινται τὰ ἀνθρώπεια σώματα, τέλος δὲ ἔχει τὴν ὑγίειαν, τῇ ῥητορικῇ ὑπόκεινται τὰ ἰδιωτικὰ καὶ πολιτικὰ πράγματα (ἰδιωτικὰ δὲ λέγω τοὺς ἐπιτροπικοὺς Δημοσθένους λόγους ἢ ὅταν ἑνί τινι συνηγορῇ, πολιτικὰ δὲ τὰ δημόσια πάντα, ὅταν συμβουλεύῃ τῇ πόλει Φιλίππῳ πολεμῆσαι), τέλος δὲ ταύτης τὸ πεῖσαι, τῇ γραμματικῇ ὑπόκεινται πᾶσαι αἱ Ἑλληνίδες φωναί, τέλος δὲ αὐτῆς μηδέποτε ἁμαρτεῖν περὶ αὐτὰς μήτε περὶ μίαν μήτε περὶ πολλάς·", "seq": 100}
{"id": "Elias_Passim_0101", "series": "CAG", "text": "ἡ μὲν γὰρ περὶ μίαν ἁμαρτὰς βαρβαρισμὸς εἴρηται ἡ δὲ περὶ πλείονας σολοικισμός·", "seq": 101}
{"id": "Elias_Passim_0102", "series": "CAG", "text": "σολοικισμὸς δὲ εἴρηται ὡς σώου λόγου αἰκισμός.", "seq": 102}
{"id": "Elias_Passim_0103", "series": "CAG", "text": "Εἰ οὖν πᾶσα τέχνη καὶ ὑποκείμενον ἔχει καὶ τέλος, εἰκότως οἱ ὁρισμοὶ ἢ ἐξ ἑνὸς τῶν δύο ἢ ἐκ τοῦ συναμφοτέρου λαμβάνονται.", "seq": 103}
{"id": "Elias_Passim_0104", "series": "CAG", "text": "ἐκ τοῦ ὑποκειμένου μέν, ὡς ἵνα εἴπω ‘ἰατρική ἐστι τέχνη περὶ τὰ ἀνθρώπεια σώματα καταγινομένη’, ἐκ τοῦ τέλους δὲ ‘ὑγείας περιποιητική’, ἐκ δὲ τοῦ συναμφοτέρου ‘τέχνη περὶ τὰ ἀνθρώπεια σώματα καταγινομένη ὑγείας περιποιητική’.", "seq": 104}
{"id": "Elias_Passim_0105", "series": "CAG", "text": "δεῖ δὲ εἰδέναι ὅτι ἐπὶ πασῶν τῶν ἄλλων τεχνῶν καὶ ἐπιστημῶν μόνος ὁ ἐκ τοῦ συναμφοτέρου τέλειος ὁρισμός, ἐπειδὴ τὰ ὑποκείμενα αὐταῖς καὶ ἄλλαις ὑπόκεινται τέχναις, οἷον τὰ ἀνθρώπεια σώματα ὑπόκεινται κουρεῖ, παιδοτρίβῃ.", "seq": 105}
{"id": "Elias_Passim_0106", "series": "CAG", "text": "ἀλλὰ καὶ τὰ πολιτικὰ ὑπόκεινται καὶ ἄλλαις ὁμοίως.", "seq": 106}
{"id": "Elias_Passim_0107", "series": "CAG", "text": "καὶ τὰ τέλη οὐχ ὑπὸ μόνων τῶν εἰρημένων γίνονται, ἀλλὰ καὶ ὑπὸ τύχης καὶ ὑπὸ ἄλλων τινῶν·", "seq": 107}
{"id": "Elias_Passim_0108", "series": "CAG", "text": "τὴν γὰρ ὑγείαν οὐ μόνος ἰατρὸς ποιεῖ, ἀλλὰ καὶ ἐκ τύχης γίνεται, ὡς εἴρηται ἐν τῷ Περὶ αἱρέσεων.", "seq": 108}
{"id": "Elias_Passim_0109", "series": "CAG", "text": "καὶ γραῦς ἐπᾴδουσα ὑγείαν ποιεῖ καὶ περίαπτον ὁμοίως.", "seq": 109}
{"id": "Elias_Passim_0110", "series": "CAG", "text": "καὶ ἡ πειθὼ οὐχ ὑπὸ μόνης ῥητορικῆς γίνεται, ἀλλὰ καὶ χρυσὸς πείθει καὶ κάλλος πείθει καὶ ἕτερα πολλά.", "seq": 110}
{"id": "Elias_Passim_0111", "series": "CAG", "text": "ὁ γοῦν Ὑπερείδης ὁ ῥήτωρ συνηγορῶν Φρύνῃ τῇ πόρνῃ, αἰσθόμενος ἐν τοῖς ἑαυτοῦ ἐπιλόγοις ὅτι οὐκ ἔπεισε τοὺς δικαστάς, ἐπέτρεψε τῇ πόρνῃ διαρρῆξαι τοὺς χιτῶνας, καὶ τότε διὰ τῆς τῶν μαζῶν θέας εἷλεν αὐτούς.", "seq": 111}
{"id": "Elias_Passim_0112", "series": "CAG", "text": "Κριτέον οὖν τὰς ἕξεις οὐκ ἐκ τοῦ τέλους ἀλλ᾿ ἐκ τῆς τοῦ τέλους παρασκευῆς·", "seq": 112}
{"id": "Elias_Passim_0113", "series": "CAG", "text": "ἴδιον γὰρ ἰατροῦ οὐ τὸ ὑγιάσαι ἀλλὰ τὸ μηδὲν παραλιπεῖν τῶν εἰς ὑγείαν ἀγόντων, καὶ ῥήτορος τέλος οὐ τὸ πεῖσαι ἀλλὰ τὸ μηδὲν παραλιπεῖν τῶν εἰς πειθὼ ἀγόντων.", "seq": 113}
{"id": "Elias_Passim_0114", "series": "CAG", "text": "εἰκότως οὖν ἐπὶ μὲν τῶν ἄλλων τεχνῶν καὶ ἐπιστημῶν μόνος ὁ ἐκ τοῦ συναμφοτέρου τέλειος ὁρισμός, ἐπὶ δὲ τῆς φιλοσοφίας καὶ ὁ ἐκ θατέρου τέλειος, διότι τὸ ὑποκείμενον τῇ φιλοσοφίᾳ ἄλλῃ τέχνῃ ἢ ἐπιστήμῃ οὐχ ὑπόκειται.", "seq": 114}
{"id": "Elias_Passim_0115", "series": "CAG", "text": "Πρᾶξις δ΄.", "seq": 115}
{"id": "Elias_Passim_0116", "series": "CAG", "text": "Μεμαθήκαμεν διὰ τῶν φθασάντων ὅτι οἱ ὁρισμοὶ ἐκ τριῶν λαμβάνονται, ἐκ τοῦ ὑποκειμένου, ἐκ τοῦ τέλους, ἐκ τοῦ συναμφοτέρου·", "seq": 116}
{"id": "Elias_Passim_0117", "series": "CAG", "text": "φέρε οὖν μάθωμεν τί ὑπόκειται τῇ φιλοσοφίᾳ καὶ τί τὸ τέλος αὐτῆς καὶ πῶς ἐκ τούτων ὁρίζεται.", "seq": 117}
{"id": "Elias_Passim_0118", "series": "CAG", "text": "δεῖ εἰδέναι ὅτι πάντα τὰ ὄντα ὑπόκεινται τῇ φιλοσοφίᾳ, διὸ καὶ γνῶσις τῶν ὄντων ἐστὶν ὡς μόνη πάντα γινώσκουσα·", "seq": 118}
{"id": "Elias_Passim_0119", "series": "CAG", "text": "αἱ μὲν γὰρ ἄλλαι τέχναι ἤγουν ἐπιστῆμαι περὶ ἓν καταγινόμεναι ἓν μέν τι γινώσκουσι, πολλὰ δὲ ἀγνοοῦσι, καὶ μᾶλλον ἄγνοιαί εἰσιν ἤπερ γνώσεις·", "seq": 119}
{"id": "Elias_Passim_0120", "series": "CAG", "text": "ἡ δὲ φιλοσοφία μᾶλλον γνῶσις ὡς πάντα τὰ ὄντα ἐπαγγελλομένη εἰδέναι.", "seq": 120}
{"id": "Elias_Passim_0121", "series": "CAG", "text": "τέλος δὲ τῆς φιλοσοφίας τὸ διὰ τῆς γνώσεως πάντων τῶν ὄντων θεὸν ἐπὶ γῆς δεῖξαι τὸν ἄνθρωπον καὶ τοιοῦτον οἷον τὸν Λυκοῦργον ἡ Πυθία προσεῖπεν·", "seq": 121}
{"id": "Elias_Passim_0122", "series": "CAG", "text": "ἤλυθες, ὦ Λυκόεργε, ἐμὸν ποτὶ πίονα νηόν·", "seq": 122}
{"id": "Elias_Passim_0123", "series": "CAG", "text": "δίζω εἴ σε θεὸν μαντεύσομαι ἠὲ καὶ ἄνδρα.", "seq": 123}
{"id": "Elias_Passim_0124", "series": "CAG", "text": "καὶ μὴ νομίσῃς, ἐπειδὴ εἶπε “δίζω,” ὅτι ἠγνόει [κατὰ τὰς Ἑλλήνων φημὶ ψευδεῖς δόξας] (ἦ γὰρ ἂν ἡ Πυθία ἑτέρας ἐδεῖτο Πυθίας), ἀλλ᾿ ἐπειδὴ φύσει ἀμφίβολον ἦν εἰ θεὸς ὁ Λυκοῦργος ἢ ἄνθρωπος.", "seq": 124}
{"id": "Elias_Passim_0125", "series": "CAG", "text": "τὰ δὲ ἀμφιβαλλόμενα ἄλλως οὐ γινώσκεται, εἰ μὴ μετὰ τοῦ ἀμφιβάλλειν·", "seq": 125}
{"id": "Elias_Passim_0126", "series": "CAG", "text": "ὥσπερ γὰρ τὸ χλιαρὸν μέσον ὂν ψυχροῦ καὶ θερμοῦ, ἐὰν εἴπωμεν αὐτὸ θερμόν, ψευδόμεθα, ὁμοίως καὶ ψυχρόν·", "seq": 126}
{"id": "Elias_Passim_0127", "series": "CAG", "text": "εἰ δὲ μετὰ ἀμφιβολίας εἴπωμεν ‘οὐκ οἶδα τί αὐτὸ καλέσω, θερμὸν ἢ ψυχρόν’, ἔννοιαν παρέχομεν τῷ ἀκούοντι, ὅτι μετέχει καὶ θερμότητος, μετέχει καὶ ψυχρότητος.", "seq": 127}
{"id": "Elias_Passim_0128", "series": "CAG", "text": "ὁμοίως καὶ τὸ φαιὸν μέσον ὂν λευκοῦ καὶ μέλανος, ἐὰν εἴπωμεν αὐτὸ λευκόν, ψευδόμεθα, ὁμοίως καὶ μέλαν·", "seq": 128}
{"id": "Elias_Passim_0129", "series": "CAG", "text": "εἰ δὲ μετὰ ἀμφιβολίας, δῆλον γίνεται τῷ ἀκούοντι, ὅτι μετέχει ἑκατέρου.", "seq": 129}
{"id": "Elias_Passim_0130", "series": "CAG", "text": "οὕτως καὶ ἡ Πυθία εἰ εἶπεν αὐτὸν θεόν, ἐψεύδετο, ἄνθρωπον ὄντα, καὶ εἰ ἄνθρωπον εἶπεν αὐτόν, ὁποῖοί εἰσιν οἱ πολλοὶ τῶν ἀγελαίων, ἐψεύδετο (οὐ γὰρ ἦν τοιοῦτος), ἀλλὰ ἔνθεον ἄνθρωπον αὐτὸν εἶπεν.", "seq": 130}
{"id": "Elias_Passim_0131", "series": "CAG", "text": "ὁμοίως καὶ ὁ Πλάτων ἐν τοῖς Νόμοις εἰσάγει τὸν Σωκράτη ἐρωτῶντα Κρῆτα καὶ Λάκωνα πολίτην περὶ Μίνωος καὶ Λυκούργου, οὓς ᾔδει νομοθέτας, Μίνω μὲν Κρητῶν, Λυκοῦργον δὲ Λακώνων·", "seq": 131}
{"id": "Elias_Passim_0132", "series": "CAG", "text": "‘θεὸς ὑμῖν, ὦ ξένοι, ἤ τις ἀνθρώπων τῆς αἰτίας τῶν νόμων γέγονεν αἴτιος;’", "seq": 132}
{"id": "Elias_Passim_0133", "series": "CAG", "text": "καὶ ἀπεκρίνατο ὁ Κρὴς ὡς τιμιώτερος·", "seq": 133}
{"id": "Elias_Passim_0134", "series": "CAG", "text": "‘θεός, ὦ ξένε, θεός’·", "seq": 134}
{"id": "Elias_Passim_0135", "series": "CAG", "text": "τιμιώτερος γὰρ ὁ Μίνως διὰ τὸν Δία·", "seq": 135}
{"id": "Elias_Passim_0136", "series": "CAG", "text": "λέγουσι γὰρ αὐτὸν Ἕλληνες ὑπὲρ ἐννέα ἔτη ἀνιέναι πρὸς τὸν Δία διορθώσεως τῶν νόμων χάριν, καὶ τοῦτο αἰνίττεται Ὅμηρος λέγων", "seq": 136}
{"id": "Elias_Passim_0137", "series": "CAG", "text": "ἐννέωρος βασίλευε Διὸς μεγάλου ὀαριστής.", "seq": 137}
{"id": "Elias_Passim_0138", "series": "CAG", "text": "τοιοῦτον οὖν ἡ φιλοσοφία θέλει δεῖξαι τὸν ἄνθρωπον ἐπὶ τῆς γῆς.", "seq": 138}
{"id": "Elias_Passim_0139", "series": "CAG", "text": "Ἐπεὶ οὖν ἔγνωμεν τί τὸ τέλος τῆς φιλοσοφίας καὶ τί τὸ ὑποκείμενον αὐτῇ, φέρε εἴπωμεν καὶ πῶς ἐκ τούτων ὁρίζεται.", "seq": 139}
{"id": "Elias_Passim_0140", "series": "CAG", "text": "δεῖ εἰδέναι ὅτι ἕξ εἰσιν ὁρισμοὶ τῆς φιλοσοφίας καὶ οὔτε πλείους οὔτε ἐλάττους, δύο ἐκ τοῦ ὑποκειμένου, δύο ἐκ τοῦ τέλους, εἷς ἐκ τῆς ὑπεροχῆς καὶ εἷς ἐκ τῆς ἐτυμολογίας.", "seq": 140}
{"id": "Elias_Passim_0141", "series": "CAG", "text": "ἡ δὲ τάξις αὐτῶν ἐστιν αὕτη·", "seq": 141}
{"id": "Elias_Passim_0142", "series": "CAG", "text": "ἔσχατος πάντων ὁ ἐκ τῆς ἐτυμολογίας, ὡς περὶ φωνὰς μόνας ἠσχολημένος καὶ οὐδὲν τοῦ πράγματος λέγων τῆς φιλοσοφίας περὶ τὰ ὄντα ἐπτοημένης.", "seq": 142}
{"id": "Elias_Passim_0143", "series": "CAG", "text": "μετ᾿ αὐτόν ἐστιν ὁ ἐκ τῆς ὑπεροχῆς, ἐπειδὴ τὰ κοινὰ προηγοῦνται τῶν ἰδικῶν καὶ κοινοὶ μὲν πάσης τέχνης καὶ ἐπιστήμης ὁρισμοὶ οἱ ἐκ τοῦ ὑποκειμένου καὶ ἐκ τοῦ τέλους λαμβανόμενοι, ὁ δὲ ἐκ τῆς ὑπεροχῆς ὁρισμὸς ἴδιος τῆς φιλοσοφίας·", "seq": 143}
{"id": "Elias_Passim_0144", "series": "CAG", "text": "μόνη γὰρ αὕτη ἐκ τῆς ὑπεροχῆς ὁρισμὸν ἔσχε τῶν ἄλλων, ὡς εἴρηται, ἐκ τοῦ συναμφοτέρου ὁριζομένων.", "seq": 144}
{"id": "Elias_Passim_0145", "series": "CAG", "text": "μετὰ δὲ τὸν ἐκ τῆς ὑπεροχῆς εἰσιν οἱ ἐκ τοῦ τέλους, καὶ μετὰ <τοὺς ἐκ> τοῦ τέλους εἰσὶν οἱ ἐκ τοῦ ὑποκειμένου·", "seq": 145}
{"id": "Elias_Passim_0146", "series": "CAG", "text": "ἀεὶ γὰρ τὸ ὑποκείμενον προηγεῖται τοῦ τέλους.", "seq": 146}
{"id": "Elias_Passim_0147", "series": "CAG", "text": "καὶ οὕτως μὲν ἀναλυτικῶς.", "seq": 147}
{"id": "Elias_Passim_0148", "series": "CAG", "text": "συνθετικῶς δὲ πάλιν οὕτως·", "seq": 148}
{"id": "Elias_Passim_0149", "series": "CAG", "text": "πρῶτος ὁ λέγων ‘γνῶσις τῶν ὄντων ᾗ ὄντα ἐστί’, δεύτερος ὁ λέγων ‘γνῶσις θείων τε καὶ ἀνθρωπίνων πραγμάτων’, μετ᾿ αὐτὸν ὁ λέγων ‘μελέτη θανάτου’, τέταρτος ὁ λέγων ‘ὁμοίωσις θεῷ κατὰ τὸ δυνατὸν ἀνθρώπῳ’, πέμπτος ὁ ἐκ τῆς ὑπεροχῆς ὁ λέγων ‘τέχνη τεχνῶν καὶ ἐπιστήμη ἐπιστημῶν’, ἕκτος ὁ ἐκ τῆς ἐτυμολογίας ὁ λέγων ‘φιλία σοφίας’.", "seq": 149}
{"id": "Elias_Passim_0150", "series": "CAG", "text": "αὕτη μὲν ἡ τάξις.", "seq": 150}
{"id": "Elias_Passim_0151", "series": "CAG", "text": "Ἐφ᾿ οἷς εἴπωμεν τίνες εὗρον τοὺς ὁρισμοὺς τῆς φιλοσοφίας.", "seq": 151}
{"id": "Elias_Passim_0152", "series": "CAG", "text": "δεῖ εἰδέναι ὅτι τὸν ἐκ τῆς ἐτυμολογίας τὸν ἕκτον καὶ τοὺς δύο τοὺς ἐκ τοῦ ὑποκειμένου ὁ Πυθαγόρας εἶπε, τοὺς δύο τοὺς ἐκ τοῦ τέλους ὁ Πλάτων, τὸν μὲν ἐν Θεαιτήτῳ τὸν λέγοντα ‘ὁμοίωσις θεῷ κατὰ τὸ δυνατὸν ἀνθρώπῳ’, τὸν δὲ ἐν Φαίδωνι τὸν λέγοντα ‘μελέτη θανάτου’, τὸν ἐκ τῆς ὑπεροχῆς Ἀριστοτέλης φησὶν ἐν τῇ Μετὰ τὰ φυσικά.", "seq": 152}
{"id": "Elias_Passim_0153", "series": "CAG", "text": "Ἐφ᾿ οἷς ἀποροῦσί τινες ὅτι ‘διὰ τί ἓξ ὁρισμοὶ τῆς φιλοσοφίας;’", "seq": 153}
{"id": "Elias_Passim_0154", "series": "CAG", "text": "καὶ λέγομεν τούτου αἰτίαν τοιαύτην·", "seq": 154}
{"id": "Elias_Passim_0155", "series": "CAG", "text": "ὅτι ἡ φιλοσοφία οὔτε πρᾶγμά ἐστιν ἀνώνυμον, οἷα πολλά εἰσιν (ἡ γὰρ πρὸς μουσικὴν ἐπιτηδειότης ὄνομα οὐκ ἔχει·", "seq": 155}
{"id": "Elias_Passim_0156", "series": "CAG", "text": "οὐδὲ γὰρ λέγεται μουσικότης), ἀλλ᾿ οὐδὲ φωνὴ ἄσημος·", "seq": 156}
{"id": "Elias_Passim_0157", "series": "CAG", "text": "ἐπεὶ οὖν καὶ ὀνομάζεται καὶ ὑφέστηκε, διότι μὲν ὀνομάζεται, ἔχει τὸν ἐκ τῆς ἐτυμολογίας, ᾗ δὲ ὑφέστηκε, τὸ εἶναι ἐν πρώτῃ ἔσχεν ἐπιστήμῃ, καὶ ᾗ μὲν ἐν πρώτῃ, τὸν ἐκ τῆς ὑπεροχῆς ἔσχε (τὸ γὰρ πρῶτον ὑπεροχή), ᾗ δὲ ἐπιστήμῃ, ἔσχε τοὺς δύο τοὺς ἐκ τοῦ ὑποκειμένου καὶ τοὺς δύο τοὺς ἐκ τοῦ τέλους.", "seq": 157}
{"id": "Elias_Passim_0158", "series": "CAG", "text": "ἐφ᾿ οἷς ἀποροῦσιν ὅτι ‘διὰ τί δύο ἐκ τοῦ ὑποκειμένου καὶ δύο ἐκ τοῦ τέλους;’", "seq": 158}
{"id": "Elias_Passim_0159", "series": "CAG", "text": "καί φαμεν πρὸς τοῦτο ὅτι τὸ ὑποκείμενον διττόν, ἢ καθόλου ἢ μερικόν, οἷον τῷ τέκτονι ὑπόκειται καὶ τόδε τὸ ξύλον, τὸ ἀκάνθινον φέρε εἰπεῖν ἢ δρύϊνον, καὶ πᾶν ξύλον.", "seq": 159}
{"id": "Elias_Passim_0160", "series": "CAG", "text": "διὰ μὲν οὖν τὸ καθόλου ἔσχε τὸν λέγοντα ‘γνῶσις τῶν ὄντων ᾗ ὄντα ἐστί’, διὰ δὲ τὸ μερικὸν ἔσχε τὸν λέγοντα ‘γνῶσις θείων τε καὶ ἀνθρωπίνων πραγμάτων’.", "seq": 160}
{"id": "Elias_Passim_0161", "series": "CAG", "text": "ὁμοίως τὸ τέλος διττόν, προσεχὲς ἢ πόρρω, οἷον προσεχὲς τέλος τῷ ἰατρῷ τήνδε τὴν διάθεσιν ὑγιάσαι, τὴν πυρεκτικὴν φέρε εἰπεῖν, πόρρω δὲ πᾶσαν διάθεσιν ὑγιάσαι.", "seq": 161}
{"id": "Elias_Passim_0162", "series": "CAG", "text": "διὰ μὲν οὖν τὸ προσεχὲς ἔσχε τὸν λέγοντα ‘μελέτη θανάτου’, διὰ δὲ τὸ πόρρω ἔσχε τὸν λέγοντα ‘ὁμοίωσις θεῷ κατὰ τὸ δυνατὸν ἀνθρώπῳ’·", "seq": 162}
{"id": "Elias_Passim_0163", "series": "CAG", "text": "προσεχέστερον γὰρ τὸ καθᾶραι τὴν ψυχὴν ἑαυτοῦ, εἶτα καθαρθεῖσαν ἐξομοιῶσαι θεῷ·", "seq": 163}
{"id": "Elias_Passim_0164", "series": "CAG", "text": "πρότερον γὰρ καθαίρει τις ἑαυτὸν καὶ εἶθ᾿ οὕτως ἐξομοιοῦται θεῷ·", "seq": 164}
{"id": "Elias_Passim_0165", "series": "CAG", "text": "μὴ καθαρὸν γὰρ καθαροῦ ἐφάπτεσθαι οὐχὶ θεμιτὸν κατὰ τὰς Πλάτωνος φωνάς.", "seq": 165}
{"id": "Elias_Passim_0166", "series": "CAG", "text": "Τινὲς δὲ προστιθέασι καὶ ἄλλον ὁρισμὸν ἕβδομον·", "seq": 166}
{"id": "Elias_Passim_0167", "series": "CAG", "text": "οἱ γὰρ ἰατροί, χάλκεα χρυσέων ἀμειψάμενοι, οὐκ ἔμπαλιν χρύσεα χαλκείων καθ᾿ Ὅμηρον, τοὺς ὁρισμοὺς ἤμειψαν καὶ τὴν ἰατρικὴν ὡρίσαντο φιλοσοφίαν σωμάτων, τὴν δὲ φιλοσοφίαν ἰατρικὴν ψυχῶν.", "seq": 167}
{"id": "Elias_Passim_0168", "series": "CAG", "text": "ἀλλ᾿, ὦ ἰατροί, διάλληλος ἡ τοιαύτη δεῖξις τὸ σαφὲς ἐκ τοῦ ἀσαφοῦς δεικνύουσα.", "seq": 168}
{"id": "Elias_Passim_0169", "series": "CAG", "text": "διάλληλος δέ ἐστι δεῖξις, ὅτε δύο τινῶν ἀμφιβαλλομένων πραγμάτων ἑκάτερον διὰ τοῦ λοιποῦ θελήσωμεν πιστώσασθαι, οἷον ἀγνοῶν ποῦ μένει Θέων καὶ ποῦ μένει Δίων, εἰ ἐρωτήσω ‘ποῦ μένει Θέων’ καὶ εἴπῃς ‘ὅπου Δίων’, εἰ ἐπανερωτήσω ‘καὶ ποῦ μένει Δίων’ καὶ εἴπῃς ‘ὅπου Θέων’.", "seq": 169}
{"id": "Elias_Passim_0170", "series": "CAG", "text": "ὁμοίως ‘ἡ δεῖνα τέτοκεν, ἐπειδὴ γάλα ἔχει, γάλα δὲ ἔχει, ἐπειδὴ τέτοκε’.", "seq": 170}
{"id": "Elias_Passim_0171", "series": "CAG", "text": "φευκτέα δὲ ἡ διάλληλος δεῖξις παρὰ φιλοσόφοις, ὡς τὰ αὐτὰ τῶν αὐτῶν πρότερα ποιοῦσα καὶ ὕστερα, σαφέστερα καὶ ἀσαφέστερα, αἴτια καὶ αἰτιατά·", "seq": 171}
{"id": "Elias_Passim_0172", "series": "CAG", "text": "ὅτε μὲν γὰρ διὰ τοῦ Δίωνος δείκνυται ποῦ μένει Θέων, ὁ Δίων σαφέστερός ἐστι, πρότερος, αἴτιος·", "seq": 172}
{"id": "Elias_Passim_0173", "series": "CAG", "text": "ὅτε δὲ ἔμπαλιν διὰ τοῦ Θέωνος γίνεται ἡ δεῖξις, ὁ Θέων σαφέστερός ἐστι καὶ πρότερος καὶ αἴτιος.", "seq": 173}
{"id": "Elias_Passim_0174", "series": "CAG", "text": "ἄλλως τε ἀδολεσχίαν εἰσάγει ὁ λόγος·", "seq": 174}
{"id": "Elias_Passim_0175", "series": "CAG", "text": "εἰ γὰρ Θέων μένει ὅπου Δίων, Δίων δὲ μένει ὅπου Θέων, Θέων ἄρα μένει ὅπου Θέων.", "seq": 175}
{"id": "Elias_Passim_0176", "series": "CAG", "text": "καὶ εἰ ἡ δεῖνα τέτοκεν ἐπειδὴ γάλα ἔχει, γάλα δὲ ἔχει ἐπειδὴ τέτοκε, τέτοκεν ἄρα ἐπειδὴ τέτοκεν, ὅπερ ἐστὶν ἀδολεσχῆσαι.", "seq": 176}
{"id": "Elias_Passim_0177", "series": "CAG", "text": "φευκτέον οὖν τὸ τοιοῦτον οὐ μόνον ἐπὶ τῶν ἀποδείξεων, ἀλλὰ καὶ ἐπὶ τῶν ὁρισμῶν ἀρχῶν ὄντων ἀποδείξεως.", "seq": 177}
{"id": "Elias_Passim_0178", "series": "CAG", "text": "καὶ οὗτος δὲ ὁ ὁρισμὸς ἀνάγεται ὑπὸ τὸν ἐκ τοῦ τέλους τὸν λέγοντα ‘μελέτη θανάτου’·", "seq": 178}
{"id": "Elias_Passim_0179", "series": "CAG", "text": "ὁ γὰρ θάνατος τῆς ἀκολάστου ζωῆς ἰατρεία ψυχῆς ἐστιν.", "seq": 179}
{"id": "Elias_Passim_0180", "series": "CAG", "text": "Ἄλλον ὄγδοον ὁρισμὸν ἀναφέρουσι τῷ Πλάτωνι εἰρημένον ἐν Φαίδωνι·", "seq": 180}
{"id": "Elias_Passim_0181", "series": "CAG", "text": "φησὶ γὰρ ἐκεῖ τὴν φιλοσοφίαν μεγίστην μουσικήν, μουσικὴν δὲ οὐ χορδὰς ἁρμόζουσαν (εὐτελὲς γὰρ τοῦτο), ἀλλὰ τὰ μόρια τῆς ψυχῆς, λόγον, θυμόν, ἐπιθυμίαν, ἵνα ὁ μὲν λόγος ἀεὶ ἄρχῃ, ὁ δὲ θυμὸς ἄρχηται ὑπὸ τοῦ λόγου καὶ ἄρχῃ τῆς ἐπιθυμίας, ἡ δὲ ἐπιθυμία ἄρχηται·", "seq": 181}
{"id": "Elias_Passim_0182", "series": "CAG", "text": "ὅταν γὰρ ταῦτα ἰδιοπραγῶσι, σώζεται ἡ ἁρμονία τῆς ψυχῆς·", "seq": 182}
{"id": "Elias_Passim_0183", "series": "CAG", "text": "εἰ δὲ τὰ χείρω τυραννήσει, ποιεῖ ἀναρμοστίαν, ἐὰν ἡ ἐπιθυμία κρατήσῃ, ὡς ἐπὶ τῆς Φαίδρας δι᾿ ἔρωτα ἀπαγξαμένης, ἢ ὅταν ὁ θυμὸς κρατῇ τοῦ λόγου, ὡς ἐπὶ τῆς Μηδείας φασκούσης", "seq": 183}
{"id": "Elias_Passim_0184", "series": "CAG", "text": "καὶ μανθάνω μὲν οἷα δρᾶν μέλλω κακά, θυμὸς δὲ κρείσσων τῶν ἐμῶν βουλευμάτων.", "seq": 184}
{"id": "Elias_Passim_0185", "series": "CAG", "text": "ἀλλὰ καὶ οὗτος ὁ ὁρισμὸς ἀνάγεται ὑπὸ τὸν ἐκ τῆς ὑπεροχῆς·", "seq": 185}
{"id": "Elias_Passim_0186", "series": "CAG", "text": "τὸ γὰρ μέγιστον ὑπεροχή ἐστιν.", "seq": 186}
{"id": "Elias_Passim_0187", "series": "CAG", "text": "Πρᾶξις ε΄.", "seq": 187}
{"id": "Elias_Passim_0188", "series": "CAG", "text": "Μετὰ τὸ πλῆθος τῶν ὁρισμῶν τῆς φιλοσοφίας καὶ τὴν τάξιν αὐτῶν καὶ τοὺς εὑρετὰς αὐτῶν καὶ τὴν αἰτίαν, δι᾿ ἥν εἰσιν ἕξ (ἐκ διαιρέσεως τοῦτο δέδεικται καὶ ἐκ τοῦ ἀνελεῖν ἡμᾶς τοὺς προστεθέντας δύο), φέρε ἔλθωμεν ἐπὶ τὴν ἐξήγησιν αὐτῶν.", "seq": 188}
{"id": "Elias_Passim_0189", "series": "CAG", "text": "πρῶτος τοίνυν ὁρισμός ἐστι τῆς φιλοσοφίας ἐκ τοῦ καθόλου ὑποκειμένου λαμβανόμενος καὶ εἰς Πυθαγόραν ἀναγόμενος ὁ λέγων ‘γνῶσις τῶν ὄντων ᾗ ὄντα ἐστί’.", "seq": 189}
{"id": "Elias_Passim_0190", "series": "CAG", "text": "καὶ οὐκ ἔχομεν εἰπεῖν ἐν ποίῳ συγγράμματι ὁ Πυθαγόρας εἶπεν αὐτόν·", "seq": 190}
{"id": "Elias_Passim_0191", "series": "CAG", "text": "οὐδὲ γὰρ κατέλιπε συγγράμματα, ἀλλ᾿ ὅπερ τοῖς ἄλλοις τὰ συγγράμματα, τοῦτο ἐκείνῳ οἱ μαθηταί·", "seq": 191}
{"id": "Elias_Passim_0192", "series": "CAG", "text": "οὐδὲ γὰρ ὡς ἐν ἀγγείῳ ἀψύχῳ ᾤετο δεῖν καταλιπεῖν τοὺς ἑαυτοῦ λόγους, διότι οὐδὲν πλέον ὑπὲρ ἑαυτῶν ἢ τῶν διδασκάλων δύνανται ἀπολογεῖσθαι.", "seq": 192}
{"id": "Elias_Passim_0193", "series": "CAG", "text": "καλῶς δὲ πρόσκειται ἐν τῷ ὁρισμῷ τὸ ‘ᾗ ὄντα’ ἀντὶ τοῦ ‘καθὸ ὄντα’, ἵνα ** οἶδε τὴν φύσιν τῶν ἀστέρων τὸ πόθεν εἰσὶ καὶ τὴν φύσιν τῶν ἀνθρώπων·", "seq": 193}
{"id": "Elias_Passim_0194", "series": "CAG", "text": "οὐδὲ γὰρ πόσοι οἱ ἀστέρες ἢ πόσοι οἱ ἄνθρωποι θέλει εἰδέναι, ἀλλὰ τὴν φύσιν αὐτῶν·", "seq": 194}
{"id": "Elias_Passim_0195", "series": "CAG", "text": "ὁ γὰρ τοὺς ἀνθρώπους ᾗ ἄνθρωποι ἐπιστάμενος οὗτος καὶ τοὺς γεγονότας καὶ τοὺς ὄντας καὶ τοὺς μέλλοντας εἴσεται, καὶ κατὰ τὸν ποιητὴν", "seq": 195}
{"id": "Elias_Passim_0196", "series": "CAG", "text": "μάντις ἄριστος,", "seq": 196}
{"id": "Elias_Passim_0197", "series": "CAG", "text": "ὅς κ’ εἰδῇ τά τ᾿ ἐόντα τά τ᾿ ἐσσόμενα πρό τ᾿ ἐόντα.", "seq": 197}
{"id": "Elias_Passim_0198", "series": "CAG", "text": "Ἀποροῦσι δέ τινες ὅτι ‘διὰ τί μὴ εἶπε πάντων τῶν ὄντων;’", "seq": 198}
{"id": "Elias_Passim_0199", "series": "CAG", "text": "καὶ λέγομεν ὅτι τῷ ‘ᾗ ὄντα’ συμπεριέχεται τὸ πάντων·", "seq": 199}
{"id": "Elias_Passim_0200", "series": "CAG", "text": "ὁ γὰρ τὸ ὂν ᾗ ὂν εἰδὼς καὶ πᾶν ὂν οἶδε, καὶ ὁ τὸν ἄνθρωπον ᾗ ἄνθρωπος εἰδὼς καὶ πάντα ἄνθρωπον οἶδεν.", "seq": 200}
{"id": "Elias_Passim_0201", "series": "CAG", "text": "ἢ καὶ ἄλλως·", "seq": 201}
{"id": "Elias_Passim_0202", "series": "CAG", "text": "ὅτι τὸ ‘τῶν’ ἄρθρον ἰσοδυναμεῖ τῷ πάντων·", "seq": 202}
{"id": "Elias_Passim_0203", "series": "CAG", "text": "τὰ γὰρ ἄρθρα τοῖς καθόλου προσδιορισμοῖς ἰσοδυναμεῖ, εἰ μὴ ἀναφορικὰ εἴη, οἷον ‘ὁ ἄνθρωπος ἦλθε’·", "seq": 203}
{"id": "Elias_Passim_0204", "series": "CAG", "text": "τοῦτο γὰρ ὡς ἐπὶ ἐγνωσμένου λέγεται ἀνθρώπου.", "seq": 204}
{"id": "Elias_Passim_0205", "series": "CAG", "text": "εἰ δὲ εἴπω ὅτι ὁ ἄνθρωπος ζῷον, ἰσοδυναμεῖ τὸ ‘ὁ ἄνθρωπος’ τῷ ‘πᾶς ἄνθρωπος’·", "seq": 205}
{"id": "Elias_Passim_0206", "series": "CAG", "text": "πᾶς γὰρ ἄνθρωπος ζῷον.", "seq": 206}
{"id": "Elias_Passim_0207", "series": "CAG", "text": "ἄλλη πάλιν ἀπορία·", "seq": 207}
{"id": "Elias_Passim_0208", "series": "CAG", "text": "εἰ πάντα τὰ ὄντα γινώσκει ἡ φιλοσοφία, περίεργοι αἱ ἄλλαι τέχναι·", "seq": 208}
{"id": "Elias_Passim_0209", "series": "CAG", "text": "οὐδὲν γὰρ εὑρίσκεται ὑποκείμενον αὐταῖς.", "seq": 209}
{"id": "Elias_Passim_0210", "series": "CAG", "text": "καὶ λέγομεν ὅτι τῇ φιλοσοφίᾳ ὑπόκεινται πάντα τὰ ὄντα πρὸς γνῶσιν καὶ θεωρίαν μόνον, ταῖς δὲ ἄλλαις τέχναις, ἵνα πράξωσί τι περὶ αὐτά·", "seq": 210}
{"id": "Elias_Passim_0211", "series": "CAG", "text": "οἷον ἡ φωνὴ ὑπόκειται τῷ φιλοσόφῳ, ἵνα γνῷ τὰ αἴτια αὐτῆς καὶ ὑπὸ ποίας δυνάμεως γίνεται, τῷ δὲ γραμματικῷ, ἵνα τι πράξῃ περὶ αὐτὴν καὶ γνῷ τὴν συνθήκην αὐτῆς.", "seq": 211}
{"id": "Elias_Passim_0212", "series": "CAG", "text": "τὰ ἀνθρώπινα σώματα ὑπόκεινται τῷ φιλοσόφῳ, ἵνα γνῷ τὴν φύσιν αὐτῶν μόνον καὶ τὰ στοιχεῖα, τῷ δὲ ἰατρῷ, ἵνα ἐργάσηται περὶ αὐτὰ ὑγείαν.", "seq": 212}
{"id": "Elias_Passim_0213", "series": "CAG", "text": "εἰ δὲ λέγεις ὅτι ‘τί οὖν;", "seq": 213}
{"id": "Elias_Passim_0214", "series": "CAG", "text": "οὐ προγινώσκει ὁ ἰατρός;’", "seq": 214}
{"id": "Elias_Passim_0215", "series": "CAG", "text": ", καὶ λέγομεν ὅτι προγινώσκει, ἵνα μὴ μόνον εἰδῇ αὐτὰ ὡς ὁ φιλόσοφος, ἀλλ᾿ ἵνα καὶ πράξῃ τι διὰ τῆς προγνώσεως.", "seq": 215}
{"id": "Elias_Passim_0216", "series": "CAG", "text": "ὁμοίως καὶ ὁ γραμματικὸς οἶδε τὰ ὀκτὼ μέρη τοῦ λόγου, οὐχ ἵνα εἰδῇ αὐτὸ τοῦτο, ἀλλ᾿ ἵνα ἐργάσηται Ἑλληνίδα φωνήν.", "seq": 216}
{"id": "Elias_Passim_0217", "series": "CAG", "text": "καὶ ἁπλῶς εἰπεῖν ὁ φιλόσοφος τὰς φύσεις αὐτῶν οἶδεν, αἱ δὲ ἄλλαι τέχναι τὰ συμβαίνοντα τοῖς οὖσιν.", "seq": 217}
{"id": "Elias_Passim_0218", "series": "CAG", "text": "Ἄλλος ὁρισμὸς τῆς φιλοσοφίας ἐκ τοῦ μερικοῦ ὑποκειμένου λαμβανόμενος καὶ αὐτὸς εἰς Πυθαγόραν ἀναγόμενος ὁ λέγων ‘γνῶσις θείων τε καὶ ἀνθρωπίνων πραγμάτων’.", "seq": 218}
{"id": "Elias_Passim_0219", "series": "CAG", "text": "τί φής, ὦ Πυθαγόρα, θεῖα καὶ ἀνθρώπινα μόνον οἶδεν ἡ φιλοσοφία, οὐκ οἶδεν ἵππου φύσιν καὶ βοὸς καὶ φυτοῦ καὶ τῶν ἄλλων ἁπάντων;", "seq": 219}
{"id": "Elias_Passim_0220", "series": "CAG", "text": "καὶ λέγομεν ὅτι πάντα περιέλαβε·", "seq": 220}
{"id": "Elias_Passim_0221", "series": "CAG", "text": "διττῶν γὰρ ὄντων πάντων, ἢ ἀιδίων ἢ φθαρτῶν, καὶ ἐν μὲν τοῖς ἀιδίοις προὔχοντος τοῦ θείου, ἐν δὲ τοῖς φθαρτοῖς τοῦ ἀνθρωπείου, ἀφ᾿ ἑκάστου τοῦ τιμιωτέρου μνησθεὶς καὶ τὰ λοιπὰ εἰσήγαγεν.", "seq": 221}
{"id": "Elias_Passim_0222", "series": "CAG", "text": "ἐφ᾿ οἷς ἀποροῦσιν ὅτι ‘διὰ τί κἀνταῦθα μὴ πρόσκειται τὸ ᾗ ὄντα ἐστί;’", "seq": 222}
{"id": "Elias_Passim_0223", "series": "CAG", "text": "καὶ λέγομεν ὅτι * * ὅλως ἔφη εἰς διαφορὰς ἐλθεῖν καὶ περιττὸν ἦν τὸ ᾗ ὄντα·", "seq": 223}
{"id": "Elias_Passim_0224", "series": "CAG", "text": "μνησθεὶς γὰρ θείων ᾗ θεῖα αὐτὰ οἶδε, καὶ ἀνθρωπείων μνησθεὶς ᾗ ἀνθρώπεια αὐτὰ οἶδεν.", "seq": 224}
{"id": "Elias_Passim_0225", "series": "CAG", "text": "πάλιν ἀποροῦσι ὅτι ‘εἰ λέγεις καὶ τὸν πρῶτον ὁρισμὸν πάντα περιλαβεῖν καὶ τοῦτον, τί διαφέρει οὗτος ἐκείνου, καὶ πῶς ἐκεῖνον μὲν καθολικόν, τοῦτον δὲ μερικόν φατε;’", "seq": 225}
{"id": "Elias_Passim_0226", "series": "CAG", "text": "πρὸς ὃ λεκτέον ὅτι αὐτὸ τοῦτο μερικὸν αὐτὸν ποιεῖ τὸ μνησθῆναι αὐτὸν ὀνομαστὶ θείων καὶ ἀνθρωπίνων.", "seq": 226}
{"id": "Elias_Passim_0227", "series": "CAG", "text": "δεῖ δὲ εἰδέναι ὅτι πλεονεκτεῖ ὁ πρῶτος ὁρισμὸς τὸν δεύτερον συντομίᾳ καὶ ἀκριβείᾳ, συντομίᾳ μὲν εἰπὼν ‘τῶν ὄντων’, ἀκριβείᾳ δὲ προσκειμένου τοῦ ‘ᾗ ὄντα’.", "seq": 227}
{"id": "Elias_Passim_0228", "series": "CAG", "text": "ὁ μέντοι δεύτερος πλεονεκτεῖ τὸν πρὸ αὐτοῦ σαφηνείᾳ·", "seq": 228}
{"id": "Elias_Passim_0229", "series": "CAG", "text": "ἃ γὰρ ἐκεῖνος ἔκρυψεν, οὗτος ἐσαφήνισεν εἰπὼν ‘θείων τε καὶ ἀνθρωπίνων πραγμάτων’·", "seq": 229}
{"id": "Elias_Passim_0230", "series": "CAG", "text": "τὰ γὰρ ὄντα ἢ θεῖά εἰσιν ἢ ἀνθρώπινα συνεπινοουμένων τῶν μέσων, ὡς εἴρηται·", "seq": 230}
{"id": "Elias_Passim_0231", "series": "CAG", "text": "οὕτως γὰρ ὁ Ζεὺς πατὴρ ἀνδρῶν τε θεῶν τε λέγεται, οὐχ ὅτι καὶ τῶν ἄλλων οὐκ ἔστι πατήρ [κατὰ τοὺς Ἑλλήνων ψευδεῖς μύθους], ἀλλὰ διὰ τούτων καὶ τὰ λοιπὰ εἰσάγεται.", "seq": 231}
{"id": "Elias_Passim_0232", "series": "CAG", "text": "Ἄλλος ὁρισμὸς τῆς φιλοσοφίας ἐκ τοῦ προσεχοῦς τέλους λαμβανόμενος ὁ λέγων αὐτὴν μελέτην θανάτου·", "seq": 232}
{"id": "Elias_Passim_0233", "series": "CAG", "text": "ἐν γὰρ τῷ Φαίδωνι τῷ διαλόγῳ οὕτως ὁ Πλάτων ὁρίζεται·", "seq": 233}
{"id": "Elias_Passim_0234", "series": "CAG", "text": "φησὶ γὰρ ὅτι ‘κινδυνεύουσιν οἱ φιλοσοφοῦντες λεληθέναι σφᾶς τε αὐτοὺς καὶ τοὺς ἄλλους μηδὲν ἕτερον μελετῶντες πλὴν ἀποθνήσκειν τε καὶ τεθνάναι’, τοῦτ᾿ ἔστιν ἢ καθαροὶ θέλουσι γίνεσθαι ἢ ἤδη κεκαθαρμένοι, ὧν τὸ μὲν θνήσκειν ἐνεστῶτος χρόνου ἐστὶ καὶ δηλοῖ τὸν καθαρτικὸν φιλόσοφον τὸ δὲ τεθνάναι παρῳχηκότος καὶ δηλοῖ τὸν κεκαθαρμένον·", "seq": 234}
{"id": "Elias_Passim_0235", "series": "CAG", "text": "ὡς συνάγεσθαι ὅτι οὐδὲν ἕτερον μελετῶσιν οἱ φιλόσοφοι ἢ καθαίρεσθαι ἢ κεκαθάρθαι, τοῦτ᾿ ἔστι φιλοσοφία ἐστὶ μελέτη θανάτου.", "seq": 235}
{"id": "Elias_Passim_0236", "series": "CAG", "text": "τὸ δὲ ‘κινδυνεύουσιν’ ἀντὶ τοῦ ‘δι᾿ ἀνάγκης καὶ ἀποδείξεως τοῦτο αὐτοῖς συνάγεται.’", "seq": 236}
{"id": "Elias_Passim_0237", "series": "CAG", "text": "ἐφ᾿ οἷς ἀποροῦσι λέγοντες·", "seq": 237}
{"id": "Elias_Passim_0238", "series": "CAG", "text": "τί φής, ὦ Πλάτων;", "seq": 238}
{"id": "Elias_Passim_0239", "series": "CAG", "text": "ὁ φιλόσοφος, ὃν ἔθου τῷ θεῷ ὅμοιον ἐπὶ γῆς, τυραννίδα μελετᾷ κατὰ τοῦ δημιουργοῦ καὶ ὃν ἔδησεν ἐκεῖνος δεσμόν, οὗτος ἐπιχειρεῖ λύειν δίκην τῶν τὰς εἱρκτὰς δραπετευόντων δούλων παρὰ γνώμην τῶν ἀρχόντων;", "seq": 239}
{"id": "Elias_Passim_0240", "series": "CAG", "text": "οὐκ αὐτὸς ἔφης ἐν τῷ αὐτῷ διαλόγῳ ἐναντίας φωνὰς ‘ὡς ἔν τινι δὴ φρουρᾷ ἐσμεν καὶ οὐ δεῖ ταύτην λύειν, ἄχρις οὗ λύσει ὁ δήσας’;", "seq": 240}
{"id": "Elias_Passim_0241", "series": "CAG", "text": "τί οὖν ποιητέον, ὦ Πλάτων;", "seq": 241}
{"id": "Elias_Passim_0242", "series": "CAG", "text": "μελετητέον θάνατον διὰ τὴν πρώτην σου ῥῆσιν;", "seq": 242}
{"id": "Elias_Passim_0243", "series": "CAG", "text": "οὐ μελετητέον θάνατον διὰ τὴν δευτέραν σου ῥῆσιν;", "seq": 243}
{"id": "Elias_Passim_0244", "series": "CAG", "text": "πρὸς ὅ φαμεν ὅτι οὐ διαφωνεῖ ὁ Πλάτων ἑαυτῷ οὔτε ὁ φιλόσοφος προεξανίσταται τοῦ δημιουργοῦ καὶ ὃν ἔδησεν ἐκεῖνος δεσμόν, οὗτος ἐπιχειρεῖ λύειν.", "seq": 244}
{"id": "Elias_Passim_0245", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ ὁ θάνατος διττός, μᾶλλον δὲ ἡ ζώη, ἵνα ἀπὸ τῶν σαφεστέρων ἄρξωμαι (σαφέστεραι γὰρ αἱ ἕξεις τῶν στερήσεων)·", "seq": 245}
{"id": "Elias_Passim_0246", "series": "CAG", "text": "ἔστι γὰρ φυσικὴ ζωὴ καὶ προαιρετικὴ ζωή, καὶ φυσικὴ μὲν ζωή ἐστι δεσμὸς ψυχῆς καὶ σώματος, ὅτε ἡ ψυχὴ χορηγεῖ αἴσθησιν καὶ κίνησιν τῷ σώματι, ἣν πάντες οἱ ἄνθρωποι ὑπομένομεν, προαιρετικὴ δὲ ζωή ἐστι δεσμὸς ψυχῆς καὶ σώματος, ὅταν ἡμεῖς ἐπιτρέψωμεν τῇ ψυχῇ ἕπεσθαι ταῖς ἡδυπαθείαις τοῦ σώματος·", "seq": 246}
{"id": "Elias_Passim_0247", "series": "CAG", "text": "φησὶ γὰρ οὕτως ὁ Πλάτων ὅτι ἑκάστη ἡδονὴ δίκην ἥλου προσπερονᾷ τὴν ψυχὴν τῷ σώματι·", "seq": 247}
{"id": "Elias_Passim_0248", "series": "CAG", "text": "ταύτην οὐ πᾶς ἄνθρωπος ζῇ, ἀλλ᾿ ὁ ἀκόλαστος μόνον·", "seq": 248}
{"id": "Elias_Passim_0249", "series": "CAG", "text": "εἰ οὖν διττὴ ἡ ζωή, καὶ ὁ θάνατος ἄρα διττός·", "seq": 249}
{"id": "Elias_Passim_0250", "series": "CAG", "text": "ὁσαχῶς γὰρ τὸ ἀντικείμενον, τοσαυταχῶς καὶ τὸ ἀντικείμενον, ὄντων αὐτῶν ἰσοσθενῶν, ἐπεὶ ἀεὶ τὸ ἰσχυρότερον κατακρατήσει καὶ ἔσται ἕν, οὐκέτι δύο.", "seq": 250}
{"id": "Elias_Passim_0251", "series": "CAG", "text": "φυσικὸς μὲν οὖν θάνατός ἐστι χωρισμὸς ψυχῆς ἀπὸ σώματος, ὃν πάντες ἄνθρωποι ὑπομένομεν, ἡνίκα μὴ χορηγεῖ ἡ ψυχὴ τῷ σώματι αἴσθησιν καὶ κίνησιν·", "seq": 251}
{"id": "Elias_Passim_0252", "series": "CAG", "text": "προαιρετικὸς δὲ θάνατός ἐστιν, ἡνίκα μὴ συγχωροῦμεν τῇ ψυχῇ ἕπεσθαι ταῖς ἡδυπαθείαις, ἀλλ᾿ ἐπιστατήσει λοιπὸν ἡ ψυχή, ὅτι αὐτὴ μὲν Ὀλυμπία γηγενὲς δὲ τὸ σῶμα, καὶ οὐ θέμις τὸ κρεῖττον ὑπὸ τοῦ χείρονος ἄρχεσθαι.", "seq": 252}
{"id": "Elias_Passim_0253", "series": "CAG", "text": "τοῦτον τὸν θάνατον οἱ φιλόσοφοι ὑπομένουσι μόνοι, περὶ ὧν φησιν ὁ ποιητὴς", "seq": 253}
{"id": "Elias_Passim_0254", "series": "CAG", "text": "δισθανέες, ὅτε τ᾿ ἄλλοι ἅπαξ θνήσκουσ᾿ ἄνθρωποι.", "seq": 254}
{"id": "Elias_Passim_0255", "series": "CAG", "text": "εἰ οὖν διττὸς ὁ θάνατος, οὐ διαφωνεῖ γε ἑαυτῷ ὁ Πλάτων, ποτὲ μὲν λέγων ὅτι δεῖ μελετᾶν τὸν θάνατον, ποτὲ δὲ λέγων μὴ λύειν, ἄχρις οὗ λύσει ὁ δήσας, ἀλλὰ τὸν μὲν φυσικὸν δεσμὸν ἐατέον τῇ φύσει λύειν, ὅτε φίλον αὐτῇ, τὸν δὲ προαιρετικὸν δεσμόν, <ὃν> ἡμεῖς ἐδήσαμεν, ἡμεῖς καὶ λύσωμεν, ἵνα πανταχοῦ τὰ τοῦ Πλάτωνος κρατῇ καὶ τὸ δῆσαν ἐκεῖνο καὶ τὴν λύσιν ἐπαγάγῃ.", "seq": 255}
{"id": "Elias_Passim_0256", "series": "CAG", "text": "λέγουσι δὲ καὶ τοιαύτην διαίρεσιν, ὅτι τέσσαρά τινα παράκεινται ἀλλήλοις, εἶναι, μὴ εἶναι, εὖ εἶναι, κακῶς εἶναι, καὶ εἶναι μὲν ποιεῖ ἡ φυσικὴ ζωή, μὴ εἶναι δὲ ὁ φυσικὸς θάνατος, εὖ εἶναι ὁ προαιρετικὸς θάνατος, κακῶς εἶναι ἡ προαιρετικὴ ζωή.", "seq": 256}
{"id": "Elias_Passim_0257", "series": "CAG", "text": "δύο δὲ οὐσῶν ἀντιθέσεων ἓξ γίνονται συμπλοκαί, ὧν αἱ μὲν τρεῖς συνίστανται, αἱ δὲ ἄλλαι τρεῖς ἀσύστατοί εἰσι, καθὼς τὸ διάγραμμα τοῦτο δηλοῖ·", "seq": 257}
{"id": "Elias_Passim_0258", "series": "CAG", "text": "φυσικὴ ζωή ἀσύστατον φυσικὸς θάνατος συνίσταται", "seq": 258}
{"id": "Elias_Passim_0259", "series": "CAG", "text": "συνίσταται συνίσταται", "seq": 259}
{"id": "Elias_Passim_0260", "series": "CAG", "text": "ἀσύστατον", "seq": 260}
{"id": "Elias_Passim_0261", "series": "CAG", "text": "προαιρετικὴ ζωή ἀσύστατον προαιρετικὸς θάνατος", "seq": 261}
{"id": "Elias_Passim_0262", "series": "CAG", "text": "Θάνατον οὖν μελετητέον, οὐ τὸν μὴ εἶναι ποιοῦντα, ἀλλὰ τὸν εὖ εἶναι.", "seq": 262}
{"id": "Elias_Passim_0263", "series": "CAG", "text": "ἔστι δὲ φυσικὴ μὲν ζωὴ καὶ προαιρετικὸς θάνατος, ὅταν τῆς ψυχῆς χορηγούσης τῷ σώματι αἴσθησιν καὶ κίνησιν μὴ συγχωρῶμεν αὐτῇ ἕπεσθαι ταῖς ἡδυπαθείαις τοῦ σώματος, ἀλλ᾿ ἄρχῃ τὸ κρεῖττον τοῦ χείρονος.", "seq": 263}
{"id": "Elias_Passim_0264", "series": "CAG", "text": "φυσικὸς δὲ θάνατός ἐστι καὶ προαιρετικὴ ζωή, ὅταν αἱ φιλοσώματοι ψυχαὶ μετὰ τὸν φυσικὸν θάνατον περιπολῶσιν εἰς τοὺς τάφους σκιοειδῆ ποιοῦσαι φαντάσματα.", "seq": 264}
{"id": "Elias_Passim_0265", "series": "CAG", "text": "καὶ τοῦτο αἰνίττεται Ὅμηρος, ἡνίκα φησὶν", "seq": 265}
{"id": "Elias_Passim_0266", "series": "CAG", "text": "ὃν πότμον γοόωσα, λιποῦσ᾿ ἀνδροτῆτα καὶ ἥβην.", "seq": 266}
{"id": "Elias_Passim_0267", "series": "CAG", "text": "φυσικὴ δὲ ζωὴ καὶ προαιρετικὴ ζωή ἐστιν, ὅταν τὴν κατὰ φύσιν ζωὴν ζῶντες ἀκολάστως τὸν βίον μετερχώμεθα.", "seq": 267}
{"id": "Elias_Passim_0268", "series": "CAG", "text": "ἐβουλόμην δὲ τούτων τῶν λόγων ἀκοῦσαι Κλεόμβροτον·", "seq": 268}
{"id": "Elias_Passim_0269", "series": "CAG", "text": "οὗτος γὰρ περινοήσας τὸ ἐν Φαίδωνι ῥητὸν **, ὡς δηλοῖ τὸ εἰς αὐτὸν ἐπίγραμμα τοῦ Καλλιμάχου οὕτω λέγον·", "seq": 269}
{"id": "Elias_Passim_0270", "series": "CAG", "text": "Εἴπας ‘Ἥλιε χαῖρε’ Κλεόμβροτος Ἀμβρακιώτης ἥλατ᾿ ἀφ᾿ ὑψηλοῦ τείχεος εἰς Ἀίδην, ἄξιον οὔτι παθὼν θανάτου κακόν, ἀλλὰ Πλάτωνος ἓν τὸ περὶ ψυχῆς γράμμ᾿ ἀναλεξάμενος.", "seq": 270}
{"id": "Elias_Passim_0271", "series": "CAG", "text": "ἐγὼ δὲ τἀναντία ἐκείνῳ φημὶ ἔπη οὕτως·", "seq": 271}
{"id": "Elias_Passim_0272", "series": "CAG", "text": "εἰ μὴ γράμμα Πλάτωνος ἐμὴν ἐπέδησεν ἐρωήν, ἤδη λυγρὸν ἔλυσα βίου πολυκηδέα δεσμόν,", "seq": 272}
{"id": "Elias_Passim_0273", "series": "CAG", "text": "τοῦτ᾿ ἔστιν εἰ μὴ ὠφελήθην ἐκ Πλάτωνος τρόπον εὐζωΐας, προέκρινον ἂν μὴ εἶναι ἢ κακῶς εἶναι.", "seq": 273}
{"id": "Elias_Passim_0274", "series": "CAG", "text": "ἔστιν οὖν τις θάνατος ζωῆς τινος κρείττων, ὃν ἡ φιλοσοφία μελετᾶν ἀεὶ ἐπαγγέλλεται.", "seq": 274}
{"id": "Elias_Passim_0275", "series": "CAG", "text": "Πρᾶξις ς΄.", "seq": 275}
{"id": "Elias_Passim_0276", "series": "CAG", "text": "Οὐ μόνος ὁ Κλεόμβροτος, ἀλλὰ καὶ οἱ Στωϊκοὶ φιλόσοφοι οἷον Κλεόμβροτοί τινες ὄντες τὴν φιλοσοφίαν ὑπέλαβον μελέτην εἶναι τοῦ φυσικοῦ θανάτου.", "seq": 276}
{"id": "Elias_Passim_0277", "series": "CAG", "text": "διὸ καὶ πέντε τρόπους εὐλόγου ἐξαγωγῆς ἔγραψαν·", "seq": 277}
{"id": "Elias_Passim_0278", "series": "CAG", "text": "ἔοικε γάρ, φασίν, ὁ βίος μακρῷ συμποσίῳ, ἐν ᾧ δοκεῖ εὐωχεῖσθαι ἡ ψυχή, καὶ παρ᾿ ὅσους τρόπους λύεται τὸ συμπόσιον, παρὰ τοσούτους τρόπους γίνονται καὶ αἱ εὔλογοι ἐξαγωγαί·", "seq": 278}
{"id": "Elias_Passim_0279", "series": "CAG", "text": "λύεται γὰρ τὸ συμπόσιον κατὰ πέντε τρόπους·", "seq": 279}
{"id": "Elias_Passim_0280", "series": "CAG", "text": "ἢ διὰ χρείαν μεγάλην ἄφνω καταλαβοῦσαν οἷον παρουσίαν φίλου διὰ χρόνου (ὑπὸ χαρᾶς γὰρ ἀνίστανται οἱ φίλοι καὶ λύεται τὸ συμπόσιον), ἢ διὰ τοὺς ἐπεισκωμάζοντας καὶ αἰσχρορρημονοῦντας λύεται ὁμοίως τὸ συμπόσιον, ἢ διὰ τὸ νεκρὰ καὶ νοσώδη εἶναι τὰ παρατιθέμενα ἢ διὰ σπάνιν ἐδεσμάτων ἢ διὰ μέθην λύεται τὸ συμπόσιον.", "seq": 280}
{"id": "Elias_Passim_0281", "series": "CAG", "text": "κατὰ τοὺς αὐτοὺς οὖν πέντε τρόπους γίνονται καὶ εὔλογοι ἐξαγωγαί·", "seq": 281}
{"id": "Elias_Passim_0282", "series": "CAG", "text": "ἢ διὰ χρείαν μεγάλην καταλαβοῦσαν, ὡς προσέταξεν ἡ Πυθία τινὶ ἀποσφάξαι ἑαυτὸν ὑπὲρ τῆς ἰδίας πόλεως, φθορᾶς τῇ πόλει ἐπικειμένης, ὅπερ πεποίηκεν ὁ Μενοικεὺς ἀποσφάξας ἑαυτὸν ὑπὲρ τῆς ἰδίας πατρίδος καὶ σώσας αὐτήν.", "seq": 282}
{"id": "Elias_Passim_0283", "series": "CAG", "text": "ἢ διὰ τοὺς ἐπεισκωμάζοντας τυράννους καὶ ἀναγκάζοντας ἡμᾶς ἢ πράττειν αἰσχρὰ ἢ λέγειν τὰ ἀπόρρητα·", "seq": 283}
{"id": "Elias_Passim_0284", "series": "CAG", "text": "οὕτω γοῦν Πυθαγόρειον γύναιον ὑπὸ τυράννου συσχεθὲν καὶ ἀναγκαζόμενον ἐξορχήσασθαι τὰ ἀπόρρητα, τοῦτ᾿ ἔστι τὴν αἰτίαν εἰπεῖν, δι᾿ ἣν οὐκ ἐσθίουσι κυάμους (ἦν γὰρ παρ᾿ αὐτοῖς τὸ", "seq": 284}
{"id": "Elias_Passim_0285", "series": "CAG", "text": "ἶσόν τοι κυάμους φαγέειν κεφαλάς τε τοκήων),", "seq": 285}
{"id": "Elias_Passim_0286", "series": "CAG", "text": "ἔφη ‘φάγοιμι ἂν ἢ εἴποιμι,’ τοῦ δὲ φαγεῖν ἀναγκάζοντος πάλιν εἶπεν ‘εἴποιμι ἂν ἢ φάγοιμι.’", "seq": 286}
{"id": "Elias_Passim_0287", "series": "CAG", "text": "τέλος οὖν ἀναγκαζομένη δυοῖν θάτερον πρᾶξαι, ἢ φαγεῖν ἢ εἰπεῖν, μασησαμένη τὴν ἑαυτῆς γλῶτταν ἀπέτεμεν ὡς ὄργανον διαλέκτου καὶ γεύσεως, καὶ ἐντεῦθεν αἰκιζομένη μετήλλαξε τὸν βίον.", "seq": 287}
{"id": "Elias_Passim_0288", "series": "CAG", "text": "ἢ διὰ μακρὰν νόσον κωλύουσαν ἐπὶ πολὺ ὀργάνῳ χρῆσθαι τὴν ψυχὴν τῷ σώματι εὐλόγως δεῖ ἐξάγειν αὑτήν·", "seq": 288}
{"id": "Elias_Passim_0289", "series": "CAG", "text": "διὸ καὶ ὁ Πλάτων οὐκ ἀποδέχεται τὸ διαιτητικὸν τῆς ἰατρικῆς ὡς παιδαγωγοῦν τὰ νοσήματα καὶ ποιοῦν ἐγχρονίζειν, ἀλλ᾿ ἀποδέχεται τὸ χειρουργικὸν καὶ φαρμακευτικόν, ᾧ ἐχρῆτο Ἀρχιγένης ὁ στρατόπεδον θεραπεύων.", "seq": 289}
{"id": "Elias_Passim_0290", "series": "CAG", "text": "φησὶ δὲ καὶ Σοφοκλῆς", "seq": 290}
{"id": "Elias_Passim_0291", "series": "CAG", "text": "οὐ πρὸς ἰατροῦ σοφοῦ θρηνεῖν ἐμπῳδὰς πρὸς τομῶντι τραύματι.", "seq": 291}
{"id": "Elias_Passim_0292", "series": "CAG", "text": "ἢ διὰ πενίαν·", "seq": 292}
{"id": "Elias_Passim_0293", "series": "CAG", "text": "καὶ καλῶς φησιν ὁ Θέογνις χρὴ πενίην φεύγοντα καὶ ἐς μεγακήτεα πόντον ῥιπτεῖν καὶ πετρῶν, Κύρνε, κατ᾿ ἠλιβάτων.", "seq": 293}
{"id": "Elias_Passim_0294", "series": "CAG", "text": "ἢ διὰ λῆρον·", "seq": 294}
{"id": "Elias_Passim_0295", "series": "CAG", "text": "ὥσπερ γὰρ ἐκεῖ ἡ μέθη ἔλυε τὸ συμπόσιον, οὕτως κἀνταῦθα εὐλόγως ἔστι τινὰ ἐξαγαγεῖν ἑαυτὸν διὰ λῆρον·", "seq": 295}
{"id": "Elias_Passim_0296", "series": "CAG", "text": "οὐδὲν γάρ ἐστι λῆρος, εἰ μὴ φυσικὴ μέθη, καὶ οὐδέν ἐστι μέθη, εἰ μὴ προαιρετικὸς λῆρος.", "seq": 296}
{"id": "Elias_Passim_0297", "series": "CAG", "text": "καὶ ταῦτα μὲν περὶ τούτου.", "seq": 297}
{"id": "Elias_Passim_0298", "series": "CAG", "text": "Ὁ μέντοι Πλωτῖνος περὶ εὐλόγου ἐξαγωγῆς γράφει μονόβιβλον καὶ οὐδένα τῶν πέντε τρόπων τούτων ἀποδέχεται·", "seq": 298}
{"id": "Elias_Passim_0299", "series": "CAG", "text": "φησὶ γὰρ ὅτι ὥσπερ ὁ θεὸς οὐκ ἀφίσταται ἡμῶν προνοούμενος, ἀλλ᾿ ἡμεῖς ἑαυτοὺς ποιοῦμεν ἀνεπιτηδείους καὶ νομίζομεν τὸν θεὸν πόρρω εἶναι ἀφ᾿ ἡμῶν ἀεὶ παρόντα πᾶσιν ἐπίσης, ὡς δηλοῦσιν οἱ καθαροὶ τὸν βίον, αὐτόπται τοῦ θείου καὶ συνομιληταὶ γινόμενοι·", "seq": 299}
{"id": "Elias_Passim_0300", "series": "CAG", "text": "ὥσπερ καὶ ὁ ἥλιος χορηγεῖ ἐπίσης τὸ φῶς, ἀλλ᾿ αἱ νυκτερίδες ἀνεπιτήδειοι οὖσαι ἀποφεύγουσιν αὐτὸν καὶ οὐ φωτίζονται ἐξ αὐτοῦ, ἀλλὰ σκότος αὐτὸν νομίζουσιν εἶναι πηγὴν φωτὸς ὑπάρχοντα·", "seq": 300}
{"id": "Elias_Passim_0301", "series": "CAG", "text": "οὕτως δεῖ καὶ τὸν φιλόσοφον μιμούμενον θεὸν καὶ ἥλιον μὴ ἀμελεῖν πάντῃ τοῦ σώματος δι᾿ ἐπιμέλειαν τῆς ψυχῆς, ἀλλὰ τὴν προσήκουσαν αὐτοῦ ποιεῖσθαι πρόνοιαν, ἕως οὗ ἐκεῖνο ἀνεπιτήδειον γενόμενον διαστήσοι ἑαυτὸ τῆς πρὸς τὸ σῶμα κοινωνίας·", "seq": 301}
{"id": "Elias_Passim_0302", "series": "CAG", "text": "ἄτοπον γὰρ τὸ πρὸ καιροῦ ἐξάγειν ἑαυτόν, πρὸ οὗ λύσῃ ὁ δήσας.", "seq": 302}
{"id": "Elias_Passim_0303", "series": "CAG", "text": "δηλοῦσι δὲ καὶ οἱ Ῥωμαίων νόμοι, μὴ πρότερον ταφῇ παραδιδόντες τὰ τῶν ἐξαγαγόντων ἑαυτοὺς σώματα, πρὶν ἂν αἰκίσωνται κατὰ τῶν ποδῶν, ἢ καὶ ἔστιν εἰπεῖν ἐπ᾿ αὐτῶν τὸ ῥηθὲν ὑπὸ τοῦ ποιητοῦ ἐπὶ τῷ σώματι τοῦ Ἕκτορος", "seq": 303}
{"id": "Elias_Passim_0304", "series": "CAG", "text": "κωφὴν γὰρ δὴ γαῖαν ἀεικίζει μενεαίνων.", "seq": 304}
{"id": "Elias_Passim_0305", "series": "CAG", "text": "καὶ ταῦτα μὲν περὶ τούτου.", "seq": 305}
{"id": "Elias_Passim_0306", "series": "CAG", "text": "Ἄλλος ὁρισμὸς τῆς φιλοσοφίας ἐκ τοῦ πόρρω αὐτῆς τέλους λαμβανόμενος ὁ λέγων αὐτὴν ‘ὁμοίωσιν θεῷ κατὰ τὸ δυνατὸν ἀνθρώπῳ’·", "seq": 306}
{"id": "Elias_Passim_0307", "series": "CAG", "text": "ἐν γὰρ τῷ Θεαιτήτῳ τῷ διαλόγῳ πρός τινα Θεόδωρον Κυρηναῖον γεωμέτρην εἰσάγει τὸν Σωκράτη τὸν ἑαυτοῦ διδάσκαλον ὁ Πλάτων διαλεγόμενον.", "seq": 307}
{"id": "Elias_Passim_0308", "series": "CAG", "text": "ἔχει δὲ ἡ ῥῆσις οὕτω·", "seq": 308}
{"id": "Elias_Passim_0309", "series": "CAG", "text": "‘ἀλλ᾿ ἐπεὶ τὰ κακά, ὦ Θεόδωρε, ἐνθάδε καὶ τόνδε τὸν βίον περιπολεῖ, φευκτέον ἐνθένδε.’", "seq": 309}
{"id": "Elias_Passim_0310", "series": "CAG", "text": "‘τίς δὲ φυγή;’", "seq": 310}
{"id": "Elias_Passim_0311", "series": "CAG", "text": "εἰπόντος τοῦ Θεοδώρου, τοῦ πρὸς ὃν ὁ λόγος, ἔφη ὁ Σωκράτης ‘ὁμοίωσις θεῷ κατὰ τὸ δυνατὸν ἀνθρώπῳ.’", "seq": 311}
{"id": "Elias_Passim_0312", "series": "CAG", "text": "‘καὶ τίς ὁ τρόπος τῆς ὁμοιώσεως;’", "seq": 312}
{"id": "Elias_Passim_0313", "series": "CAG", "text": "εἰπόντος ἔφη ‘δίκαιον γενέσθαι καὶ ὅσιον μετὰ φρονήσεως καὶ ταῦτα γινώσκειν.’", "seq": 313}
{"id": "Elias_Passim_0314", "series": "CAG", "text": "ταῦτα μὲν οὖν ὁ Πλάτων.", "seq": 314}
{"id": "Elias_Passim_0315", "series": "CAG", "text": "Ἀποροῦσι δέ τινες ὅτι ‘πῶς δύναται ὁ φιλόσοφος ὅμοιος τῷ θεῷ γενέσθαι;’", "seq": 315}
{"id": "Elias_Passim_0316", "series": "CAG", "text": "καὶ λέγομεν ὅτι ἐπειδὴ ἔχει τὰ χαρακτηρίζοντα τὸ θεῖον·", "seq": 316}
{"id": "Elias_Passim_0317", "series": "CAG", "text": "οἱ γὰρ ποιηταὶ τρισσῶς τὸ θεῖον χαρακτηρίζουσι, τῷ ἀγαθῷ, τῷ δυνατῷ, τῷ γνωστικῷ, ὡς δηλοῖ τὸ", "seq": 317}
{"id": "Elias_Passim_0318", "series": "CAG", "text": "θεοὶ δωτῆρες ἐάων, θεοὶ δέ τε πάντα δύνανται, θεοὶ δέ τε πάντα ἴσασιν.", "seq": 318}
{"id": "Elias_Passim_0319", "series": "CAG", "text": "οὐκ ἀσφαλῶς δὲ ἐνταῦθα εἴρηται τὸ θεῖον πάντα δύνασθαι διὰ τὸ ἀδυναμεῖν περὶ τὸ κακοποιεῖν ὑπερβολῇ ἀγαθότητος·", "seq": 319}
{"id": "Elias_Passim_0320", "series": "CAG", "text": "ὡς γὰρ τὸ πῦρ ψύχειν οὐ δύναται διὰ τὸ ἐν θερμότητι αὐτὸ οὐσιῶσθαι καὶ ἡ χιὼν θερμαίνειν οὐ δύναται διὰ τὸ ἐν ψυχρότητι αὐτὸ οὐσιῶσθαι, οὕτω καὶ τὸ θεῖον κακοποιεῖν οὐ δύναται διὰ τὸ ἐν ἀγαθότητι αὐτὸ οὐσιῶσθαι.", "seq": 320}
{"id": "Elias_Passim_0321", "series": "CAG", "text": "οὕτω γοῦν καὶ ἐπὶ τῶν ἀνθρώπων ἔστιν ἰδεῖν ὅτι τινὲς ὄντες φύσει ἀγαθοί, κἂν εἰ ἐπιτηδεύσωσι κακοὶ γενέσθαι, οὐ δύνανται.", "seq": 321}
{"id": "Elias_Passim_0322", "series": "CAG", "text": "δυνατὸν δὲ καὶ τὸ ὑπὸ τῶν ποιητῶν εἰρημένον εἶναι ἀληθές·", "seq": 322}
{"id": "Elias_Passim_0323", "series": "CAG", "text": "τὸ γὰρ κακοποιεῖν οὐκ ἔστι δύναμις ἀλλ᾿ ἀδυναμία ἀγαθότητος, ὥσπερ καὶ αἱ συμβαίνουσαι ἀρρωστίαι ἐξ ἀδυναμίας τοῦ ὑγιαίνειν γίνονται.", "seq": 323}
{"id": "Elias_Passim_0324", "series": "CAG", "text": "ἐπειδὴ δὲ ἄλλο τὸ ἐν τῷ θεῷ ἀγαθὸν καὶ δυνατὸν καὶ γνωστικὸν καὶ ἄλλο τὸ ἐν τῷ φιλοσόφῳ·", "seq": 324}
{"id": "Elias_Passim_0325", "series": "CAG", "text": "τὸ μὲν γὰρ ἐν τῷ θεῷ ἀγαθὸν οὐκ ἄλλο παρ᾿ αὐτόν ἐστιν, ἀλλ᾿ αὐτοαγαθότης ἐστὶ τὸ μεθεκτὸν ἀγαθόν, τὸ δὲ ἐν τῷ φιλοσόφῳ ἀγαθὸν μεθεκτὸν καὶ ἄλλο παρ᾿ αὐτόν, ὡς λελευκωμένον ξύλον ἕτερον ὂν παρὰ τὸ λευκόν.", "seq": 325}
{"id": "Elias_Passim_0326", "series": "CAG", "text": "ἀλλὰ καὶ τὸ δυνατὸν τοῦ θεοῦ ἕτερον·", "seq": 326}
{"id": "Elias_Passim_0327", "series": "CAG", "text": "ὁ γὰρ θεὸς πάντα, ὅσα βούλεται, δύναται, ὁ φιλόσοφος δὲ οὐ πάντα, ὅσα βούλεται, δύναται·", "seq": 327}
{"id": "Elias_Passim_0328", "series": "CAG", "text": "ἀληθὲς γὰρ", "seq": 328}
{"id": "Elias_Passim_0329", "series": "CAG", "text": "οὔποτε φῦλον ὁμοῖον ἀθανάτων τε θεῶν χαμαὶ ἐρχομένων τ᾿ ἀνθρώπων.", "seq": 329}
{"id": "Elias_Passim_0330", "series": "CAG", "text": "ἀλλ᾿ οὐδὲ τὸ γνωστικὸν τοῦ θεοῦ καὶ τοῦ φιλοσόφου ὅμοιον·", "seq": 330}
{"id": "Elias_Passim_0331", "series": "CAG", "text": "ὁ γὰρ θεὸς καὶ πάντα οἶδε καὶ ἅμα καὶ ἀεί, ὁ δὲ φιλόσοφος πάντα μὲν ἐπαγγέλλεται εἰδέναι, οὐχ ἅμα δέ, ἀλλ᾿ ἕκαστον ἰδίᾳ προχειρίζεται, καὶ οὐκ ἀεὶ αὐτὰ οἶδεν, ἀλλὰ ποτέ, ὡς δηλοῖ ὁ Πλάτων λέγων ὅτι ‘ἀγαπητὸν ὅτῳ κἂν ἐν γήρᾳ παρῇ σοφία καὶ φρόνησις’·", "seq": 331}
{"id": "Elias_Passim_0332", "series": "CAG", "text": "διὰ τοῦτο πρόσκειται ‘κατὰ τὸ δυνατὸν ἀνθρώπῳ,’ ὅτι ὡς ἐνδέχεται ἄνθρωπον θεῷ ὁμοιωθῆναι, ὁ φιλόσοφος ὁμοιοῦται·", "seq": 332}
{"id": "Elias_Passim_0333", "series": "CAG", "text": "δεῖ γὰρ αὐτὸν ἐν ἅπασι τὸν θεὸν μιμεῖσθαι, ἐν μὲν τῷ ἀγαθῷ, ἵνα προνοῇ καὶ αὐτὸς τῶν ἀτελεστέρων ψυχῶν (ὥσπερ ὁ Σωκράτης περιερχόμενος τὰ ἐργαστήρια καὶ ἐκλεγόμενος τὰς ἐπιτηδείας φύσεις πρὸς φιλοσοφίαν), ἐν δὲ τῷ δυνατῷ, ἵνα διὰ μηχανῆς τινος δυνηθῇ τὸ παντοδύναμον τοῦ θεοῦ πορίσασθαι, εἰ μόνα ἐκεῖνα βούλεται, ὅσα δύναται, καὶ μὴ ἀλλοκότων ὀρέγεται, οἷον ἵπτασθαι, ἐν δὲ τῷ γνωστικῷ, ἵνα πάντων ἐπίστηται τὰς αἰτίας.", "seq": 333}
{"id": "Elias_Passim_0334", "series": "CAG", "text": "Ἐφ᾿ οἷς καὶ ἀποροῦσιν ὅτι ‘εἰ τὸ ὅμοιον ὁμοίῳ ὅμοιον, ἔσται καὶ ὁ θεὸς τῷ φιλοσόφῳ ὅμοιος, εἰ ὁ φιλόσοφος τῷ θεῷ, καὶ οὐδὲν πλέον ἕξει ὁ θεὸς ἡλικίᾳ τοῦ φιλοσόφου’.", "seq": 334}
{"id": "Elias_Passim_0335", "series": "CAG", "text": "πρὸς ὃ λεκτέον ὅτι παραλογισμός ἐστι τὸ τοιοῦτο·", "seq": 335}
{"id": "Elias_Passim_0336", "series": "CAG", "text": "καθ᾿ ἃ μὲν γὰρ ἐοίκασιν ἀλλήλοις, οὐδὲν διαφέρουσιν, κατ᾿ ἄλλα δὲ πολλὰ διαφέρουσιν·", "seq": 336}
{"id": "Elias_Passim_0337", "series": "CAG", "text": "ὥσπερ ἡ εἰκὼν τοῦ Σωκράτους ὁμοία ἐστὶν αὐτῷ, διαφέρει δὲ ὁ Σωκράτης τῆς εἰκόνος, ὡς ἔμψυχον ἀψύχου, οὕτω καὶ ὁ θεὸς διαφέρει τοῦ φιλοσόφου ὡς ἔμψυχον ἀψύχου καὶ ὡς παράδειγμα ἀρχετύπου.", "seq": 337}
{"id": "Elias_Passim_0338", "series": "CAG", "text": "ἢ καὶ ἄλλως·", "seq": 338}
{"id": "Elias_Passim_0339", "series": "CAG", "text": "ὅτι ἡ μὲν εἰκὼν τῷ Σωκράτει λέγεται ὁμοία, ὁ δὲ Σωκράτης τῇ εἰκόνι οὐ λέγεται ὅμοιος ὡς ἀρχέτυπον, οὕτως καὶ ἐπὶ θεοῦ καὶ φιλοσόφου·", "seq": 339}
{"id": "Elias_Passim_0340", "series": "CAG", "text": "ὁ μὲν φιλόσοφος λέγεται τῷ θεῷ ὅμοιος ὡς εἰκὼν ἀρχετύπῳ, ὁ δὲ θεὸς ἐπειδὴ ἀρχέτυπον τῷ φιλοσόφῳ ὡς εἰκόνι ἰδίᾳ οὐκ ἔστιν ὅμοιος.", "seq": 340}
{"id": "Elias_Passim_0341", "series": "CAG", "text": "ἢ καὶ ἄλλως·", "seq": 341}
{"id": "Elias_Passim_0342", "series": "CAG", "text": "ὅτι ὁ μὲν φιλόσοφος μετέχει τοῦ θεοῦ τῷ ἀγαθῷ καὶ δυνατῷ καὶ γνωστικῷ, μετέχεται δὲ ὁ θεὸς ὁμοίως ὑπὸ τοῦ φιλοσόφου τοῖς αὐτοῖς καὶ κατὰ τοῦτο λέγεται ὅμοιος.", "seq": 342}
{"id": "Elias_Passim_0343", "series": "CAG", "text": "Πρᾶξις ζ᾿.", "seq": 343}
{"id": "Elias_Passim_0344", "series": "CAG", "text": "Ἐπειδὴ μὴ ἠρκέσθη ὁ Πλάτων εἰπεῖν τὴν φιλοσοφίαν ὁμοίωσιν θεῷ κατὰ τὸ δυνατὸν ἀνθρώπῳ, ἀλλὰ καὶ τὸν τρόπον τῆς ὁμοιώσεως προσέθηκεν εἰπὼν ‘ὁμοίωσις δέ ἐστι δίκαιον καὶ ὅσιον γενέσθαι μετὰ φρονήσεως καὶ ταῦτα γινώσκειν’, φέρε τρία τινὰ ζητήσωμεν·", "seq": 344}
{"id": "Elias_Passim_0345", "series": "CAG", "text": "πρῶτον μὲν διὰ τί προσέθηκε τῷ δικαίῳ τὸ ὅσιον, δεύτερον διὰ τί τεσσάρων οὐσῶν ἀρετῶν δύο μόνων ἐμνήσθη, δικαιοσύνης καὶ φρονήσεως, τρίτον διὰ τί εἶπε ‘καὶ ταῦτα γινώσκειν’.", "seq": 345}
{"id": "Elias_Passim_0346", "series": "CAG", "text": "καὶ πρὸς μὲν τὸ πρῶτον, ἐν ᾧ ἐζητήσαμεν διὰ τί προσέθηκε τῷ δικαίῳ τὸ ὅσιον (φαίνεται γάρ, φασίν, ἐκ τούτου ἀδολεσχῶν ὁ Πλάτων καὶ τὰ αὐτὰ λέγων, ἐπεὶ μηδὲν διαφέρει τοῦ δικαίου τὸ ὅσιον), λεκτέον ὅτι οὐκ ἀδολεσχεῖ ὁ Πλάτων·", "seq": 346}
{"id": "Elias_Passim_0347", "series": "CAG", "text": "πολὺ γὰρ τὸ διάφορον τούτων·", "seq": 347}
{"id": "Elias_Passim_0348", "series": "CAG", "text": "δίκαιον μὲν γάρ ἐστι τὸ πρὸς ἀνθρώπους τὰ καθήκοντα πράττειν, ὅσιον δὲ τὸ πρὸς τὸ θεῖον τὰ πρέποντα διαπράττεσθαι, ὅθεν τοὺς περὶ τὰ ἱερὰ ἠσχολημένους ὁσίους καλοῦμεν·", "seq": 348}
{"id": "Elias_Passim_0349", "series": "CAG", "text": "ἐπιτεταμένη γὰρ δικαιοσύνη ἡ ὁσιότης, διὸ καὶ ἡ ἐπιτεταμένη ἀδικία ἀνοσιότης λέγεται·", "seq": 349}
{"id": "Elias_Passim_0350", "series": "CAG", "text": "τὸ γὰρ δίκαιον πρὸς τὰ ὅμοια λέγεται, οἷον πρὸς ἀνθρώπους, τὸ δὲ ὅσιον πρὸς τὰ κρείττω.", "seq": 350}
{"id": "Elias_Passim_0351", "series": "CAG", "text": "τὸ οὖν δίκαιον ἢ πρὸς τὰ κρείττονα λέγεται καὶ ποιεῖ τὸ ὅσιον, ἢ πρὸς τὰ χείρω καὶ λέγεται κηδεμονικόν.", "seq": 351}
{"id": "Elias_Passim_0352", "series": "CAG", "text": "τὴν δὲ διαφορὰν τοῦ δικαίου καὶ τοῦ ὁσίου οὐδὲ ὁ Πλάτων ἠγνόησεν·", "seq": 352}
{"id": "Elias_Passim_0353", "series": "CAG", "text": "δύο γὰρ διαλόγους γράψας, Εὐθύφρονα καὶ Πολιτείαν, τὸν μὲν Εὐθύφρονα ἐπέγραψεν “Εὐθύφρων ἢ περὶ ὁσίου”, τὴν δὲ Πολιτείαν “Πολιτεία ἢ περὶ δικαίου”.", "seq": 353}
{"id": "Elias_Passim_0354", "series": "CAG", "text": "ἡ γὰρ πολιτεία ἀνθρώπων ἐστί.", "seq": 354}
{"id": "Elias_Passim_0355", "series": "CAG", "text": "καὶ καλῶς κλιμακηδὸν προῆλθεν ὁ λόγος·", "seq": 355}
{"id": "Elias_Passim_0356", "series": "CAG", "text": "πρότερον γὰρ τὸ δίκαιον τοῦ ὁσίου·", "seq": 356}
{"id": "Elias_Passim_0357", "series": "CAG", "text": "οὐδὲ γὰρ δυνατὸν εἶναί τινα ὅσιον μὴ γενόμενον δίκαιον, ὥσπερ οὐ δυνατὸν τὸν πρὸς ἀνθρώπους τὰ καθήκοντα μὴ πράττοντα πρὸς τὸ θεῖον ταῦτα ἐπιτηδεύειν.", "seq": 357}
{"id": "Elias_Passim_0358", "series": "CAG", "text": "ἐν τούτοις οὖν ἡ λύσις τῆς πρώτης ζητήσεως.", "seq": 358}
{"id": "Elias_Passim_0359", "series": "CAG", "text": "Δεύτερον κεφάλαιον.", "seq": 359}
{"id": "Elias_Passim_0360", "series": "CAG", "text": "χρὴ ζητῆσαι διὰ τί τεσσάρων οὐσῶν ἀρετῶν δύο μόνων ἐμνήσθη.", "seq": 360}
{"id": "Elias_Passim_0361", "series": "CAG", "text": "καὶ λέγομεν ὅτι τῶν δύο τῶν τιμιωτέρων μνησθεὶς καὶ τὰς ἄλλας περιέλαβε·", "seq": 361}
{"id": "Elias_Passim_0362", "series": "CAG", "text": "τιμιώτεραι γὰρ αὗται τῶν ἄλλων, ὡς δείξομεν·", "seq": 362}
{"id": "Elias_Passim_0363", "series": "CAG", "text": "τριῶν γὰρ ὄντων μορίων τῆς ψυχῆς, λογικοῦ, θυμικοῦ, ἐπιθυμητικοῦ, ἑκάστη τῶν ἄλλων ἑνὶ μορίῳ ἐποχεῖται (ἡ μὲν φρόνησις τῷ λόγῳ, ἡ δὲ ἀνδρία τῷ θυμῷ, καὶ ἡ σωφροσύνη τῇ ἐπιθυμίᾳ), ἡ δὲ δικαιοσύνη οὐκ ἠξίωσεν ἑνὶ μορίῳ ἐποχεῖσθαι τῆς ψυχῆς, ἀλλὰ διὰ τῆς τριμερείας πεφοίτηκεν·", "seq": 363}
{"id": "Elias_Passim_0364", "series": "CAG", "text": "δικαιοσύνης γὰρ τὸ τὸν κατ᾿ ἀξίαν κόσμον ἐπάγειν τῷ κοσμουμένῳ·", "seq": 364}
{"id": "Elias_Passim_0365", "series": "CAG", "text": "ὅταν γὰρ ἕκαστον ἰδιοπραγῇ κατὰ φύσιν ἔχον, οἷον ἵνα ὁ λόγος ἄρχῃ ὡς ὁ βασιλεύς, ὁ θυμὸς ἄρχῃ καὶ ἄρχηται (ἄρχῃ μὲν τῆς ἐπιθυμίας, ἄρχηται δὲ ὑπὸ τοῦ λόγου) ἀναλογῶν στρατιώταις, ἡ ἐπιθυμία ἄρχηται ἐοικυῖα δήμῳ, τότε ἐπιφαίνεται ἡ δικαιοσύνη ἁρμονία τις οὖσα τούτων.", "seq": 365}
{"id": "Elias_Passim_0366", "series": "CAG", "text": "ὅτι δὲ δι᾿ ὅλης τῆς ψυχῆς πεφοίτηκεν ἡ δικαιοσύνη, δηλοῦσιν οἱ ἀδικούμενοι νεκροὺς ἑαυτοὺς καλοῦντες καὶ ἀνοσίους, ὡς τῆς οὐσίας αὐτῶν ἐστερημένης τοῦ δικαίου οἷον συνέχοντος αὐτὴν καὶ ζωοῦντος.", "seq": 366}
{"id": "Elias_Passim_0367", "series": "CAG", "text": "διὸ καὶ ἀποροῦσί τινες ὅτι ‘εἰ ἡ δικαιοσύνη ἁρμονία ἐστὶ τῶν ἄλλων καὶ ἕπεται αὐταῖς, πῶς συναριθμεῖται αὐταῖς κοινὴ αὐτῶν οὖσα;’", "seq": 367}
{"id": "Elias_Passim_0368", "series": "CAG", "text": "καὶ λέγομεν ὅτι τὸ κοινὸν διττόν, ἢ ὡς γένος εἰς εἴδη διαιρούμενον οἷον τὸ ζῷον εἰς λογικὸν καὶ ἄλογον (τότε γὰρ οὐ συναριθμεῖται τὸ γένος τοῖς εἴδεσιν), ἢ ὡς κτῆμα, ὅτε καὶ συναριθμεῖται·", "seq": 368}
{"id": "Elias_Passim_0369", "series": "CAG", "text": "οἷον ὑποκείσθωσαν τρεῖς τινες ἔχοντες τρεῖς οἰκέτας, ἕκαστος ἕνα ἴδιον, ἐχέτωσαν δὲ καὶ ἕνα κοινόν, οὗτος συναριθμεῖται τοῖς ἄλλοις, ὡς εἶναι τέσσαρας.", "seq": 369}
{"id": "Elias_Passim_0370", "series": "CAG", "text": "οὕτως οὖν κἀνταῦθα ληπτέον·", "seq": 370}
{"id": "Elias_Passim_0371", "series": "CAG", "text": "αἱ γὰρ ἀρεταὶ κτῆμά εἰσι τῆς ψυχῆς, ἑκάστη ἑνὶ μορίῳ ἐποχουμένη, κοινὸν δὲ κτῆμα τῆς τριμερείας τῆς ψυχῆς ἡ δικαιοσύνη, διὸ καὶ συναριθμεῖται ταῖς ἄλλαις ἀρεταῖς, καί εἰσι τέσσαρες.", "seq": 371}
{"id": "Elias_Passim_0372", "series": "CAG", "text": "ἔδειξεν οὖν ὁ λόγος ὅτι τιμιωτέρα ἡ δικαιοσύνη ὡς διὰ τῆς τριμερείας τῆς ψυχῆς πεφοιτηκυῖα, μετ᾿ αὐτὴν ἡ φρόνησις ὡς ἐν τῷ τιμιωτέρῳ μορίῳ τῆς ψυχῆς τῷ λόγῳ ἐποχουμένη, μετ᾿ αὐτὴν ἡ ἀνδρία ὡς ἐν τῷ θυμοειδεῖ ἐποχουμένη, καὶ τετάρτη ἡ σωφροσύνη ὡς ἐν τῇ ἐπιθυμίᾳ τῇ χείρονι ἐποχουμένη.", "seq": 372}
{"id": "Elias_Passim_0373", "series": "CAG", "text": "ἔργον δὲ τῆς μὲν δικαιοσύνης τὸ τὸν κατ᾿ ἀξίαν κόσμον ἐπάγειν τῷ κοσμουμένῳ, τῆς δὲ φρονήσεως τὸ τὰ δέοντα ποιεῖν, τῆς ἀνδρίας τὸ νικᾶν τὸ ἀνθιστάμενον, τῆς σωφροσύνης τὸ μὴ εἴκειν τῷ χείρονι·", "seq": 373}
{"id": "Elias_Passim_0374", "series": "CAG", "text": "εἰ γάρ ἐστι καὶ ἀνδρίας τὸ μὴ τῷ χείρονι εἴκειν, ἀλλ᾿ οὖν κυρίως τὸ χεῖρον ἐπὶ τῆς ἡδονῆς λέγεται ἐγκατακεχωσμένης τῷ σώματι, ὁ δὲ θυμὸς περιχωριστὸν ἔχει τέλος ἀντιλυπῆσαι τὸν λυπήσαντα·", "seq": 374}
{"id": "Elias_Passim_0375", "series": "CAG", "text": "ὁ γὰρ λυπήσας ἐκτός.", "seq": 375}
{"id": "Elias_Passim_0376", "series": "CAG", "text": "εἰ οὖν ταῦτα οὕτως ἔχει, ὁ ἔχων μίαν ἀρετὴν καὶ τὰς λοιπὰς ἕξει, καὶ ἔσται ἑκάστη αὐτῶν δικαιοσύνη τὸν πρέποντα κόσμον ἐπάγουσα τῷ κοσμουμένῳ, ἑκάστη φρόνησις τὰ δέοντα ποιοῦσα, ἑκάστη ἀνδρία νικῶσα τὸ ἀνθιστάμενον, ἑκάστη σωφροσύνη μὴ εἴκουσα τῷ χείρονι.", "seq": 376}
{"id": "Elias_Passim_0377", "series": "CAG", "text": "καὶ ταῦτα μὲν περὶ τούτου.", "seq": 377}
{"id": "Elias_Passim_0378", "series": "CAG", "text": "Τρίτον ἐστὶ κεφάλαιον ζητῆσαι διὰ τί εἶπε τὸ ‘καὶ ταῦτα γινώσκειν’.", "seq": 378}
{"id": "Elias_Passim_0379", "series": "CAG", "text": "καὶ λέγομεν ὅτι εὐλόγως, ἵνα ἔχοιμεν ἀρετὰς τὰς μετὰ παιδείας καὶ πόνου παραγινομένας, καὶ μὴ τὰς φυσικὰς καὶ ἠθικάς·", "seq": 379}
{"id": "Elias_Passim_0380", "series": "CAG", "text": "αἱ μὲν γὰρ φυσικαὶ ἀρεταὶ ἐκ κράσεως παραγίνονται, οἷον οἱ ψυχροὶ σώφρονες ἀλλὰ δειλοί, οἱ θερμοὶ ἀνδρεῖοι ἀλλ᾿ ἀκόλαστοι.", "seq": 380}
{"id": "Elias_Passim_0381", "series": "CAG", "text": "αὗται μὲν οὖν φυσικαὶ ἀρεταί, αἵτινες καὶ ἀλόγοις ὑπάρχουσιν·", "seq": 381}
{"id": "Elias_Passim_0382", "series": "CAG", "text": "ὁ γοῦν πελαργὸς δίκαιος, φρόνιμος ἡ ἀλώπηξ, ἀνδρεῖος ὁ λέων, σώφρων ἡ τρυγών.", "seq": 382}
{"id": "Elias_Passim_0383", "series": "CAG", "text": "αἱ δὲ ἠθικαὶ ἀρεταὶ ἐκ συνηθείας τινὸς παραγίνονται, διὰ τὸ ἐσχηκέναι τινὰ ἢ γονεῖς τοιούτους ἢ διδασκάλους.", "seq": 383}
{"id": "Elias_Passim_0384", "series": "CAG", "text": "καὶ ἁπλῶς εἰπεῖν τῶν ἀρετῶν αἱ μὲν μετὰ λόγου, αἱ δὲ χωρὶς λόγου, καὶ αἱ μὲν πάντῃ χωρὶς λόγου ὡς αἱ φυσικαί, αἱ δὲ μετὰ λόγου μὲν ἀλλ᾿ ἢ τοῦ θύραθεν, τοῦτ᾿ ἔστι τοῦ διδάσκοντος, οἷαι αἱ ἠθικαί, ἢ τοῦ οἴκοθεν, οἷαί εἰσιν αἱ μετὰ παιδείας καὶ πόνου τινὶ προσγινόμεναι.", "seq": 384}
{"id": "Elias_Passim_0385", "series": "CAG", "text": "διὰ τοῦτο οὖν πρόσκειται τὸ ‘καὶ ταῦτα γινώσκειν’ ἀντὶ τοῦ ἵνα ἔχωμεν ἀρετὰς οὐκ ἀλόγους, ἀλλὰ τὰς μετὰ λόγου, τοῦ οἴκοθέν φημι, τὰς μετὰ πόνου τινὶ προσγινομένας·", "seq": 385}
{"id": "Elias_Passim_0386", "series": "CAG", "text": "ὁ γὰρ Πλάτων τὰς φυσικὰς ἀρετὰς ἀνδραποδώδεις καλεῖ ὡς καὶ ἀνδραπόδοις δυναμένας ὑπάρχειν, ὁ δὲ Πλωτῖνος ἀτελεῖς, διότι πρὸς τὸ μὴ ἀντιστρέφειν καὶ ἀντιπράττουσιν ἀλλήλαις·", "seq": 386}
{"id": "Elias_Passim_0387", "series": "CAG", "text": "ὡς γὰρ εἴπομεν, εἴ τις θερμὸς ὢν ἐπιτηδεύσει ἀνδρεῖος εἶναι, ὁ τοιοῦτος οὐ πάντως σώφρων (διὰ γὰρ τὴν θερμότητα ἀκόλαστος), καὶ εἴ τις πάλιν ψυχρὸς ὢν ἐπιτηδεύσει σώφρων εἶναι, ὁ τοιοῦτος οὐ πάντως ἀνδρεῖος ἀλλὰ δειλός.", "seq": 387}
{"id": "Elias_Passim_0388", "series": "CAG", "text": "αἱ δὲ μετὰ πόνου καὶ παιδείας ἀρεταὶ ἀντιστρέφουσι μὴ ἀντιπράττουσαι.", "seq": 388}
{"id": "Elias_Passim_0389", "series": "CAG", "text": "ταῦτα καὶ περὶ τοῦ τετάρτου ὁρισμοῦ τῆς φιλοσοφίας εἰπεῖν ἔχομεν.", "seq": 389}
{"id": "Elias_Passim_0390", "series": "CAG", "text": "Πρᾶξις η΄.", "seq": 390}
{"id": "Elias_Passim_0391", "series": "CAG", "text": "Πέμπτος ὁρισμὸς τῆς φιλοσοφίας εἰς Ἀριστοτέλην ἀναγόμενος ὁ λέγων αὐτὴν ‘τέχνην τεχνῶν καὶ ἐπιστήμην ἐπιστημῶν’·", "seq": 391}
{"id": "Elias_Passim_0392", "series": "CAG", "text": "ἐν γὰρ τῇ Μετὰ τὰ φυσικὰ πραγματείᾳ Θεολογικῇ ἐπιγεγραμμένῃ εἴρηται αὐτῷ ὁ ὁρισμὸς οὗτος.", "seq": 392}
{"id": "Elias_Passim_0393", "series": "CAG", "text": "καὶ εἰκότως ἐκ τῆς ὑπεροχῆς οὗτος λέγεται ὡς καὶ ἐν τῇ Θεολογικῇ πραγματείᾳ εἰρημένος.", "seq": 393}
{"id": "Elias_Passim_0394", "series": "CAG", "text": "διὸ καὶ ἀποροῦσιν ὅτι ‘διὰ τί τοιούτῳ ἐπαναδιπλασιασμῷ κέχρηται;’", "seq": 394}
{"id": "Elias_Passim_0395", "series": "CAG", "text": "καὶ λέγομεν τούτου αἰτίας πέντε.", "seq": 395}
{"id": "Elias_Passim_0396", "series": "CAG", "text": "Πρώτην, ὅτι θαυμάσαντές τινες τὸ ὕψος τῆς φιλοσοφίας τούτῳ ἐχρήσαντο τῷ ἐπαναδιπλασιασμῷ·", "seq": 396}
{"id": "Elias_Passim_0397", "series": "CAG", "text": "ὡς εἰ καί τις θεασάμενος λευκὸν εἴποι πολλάκις ‘λευκὸν λευκὸν καὶ πάντῃ μελανίας ἀνέμφατον’, καὶ γλυκέος τις γευσάμενος εἴποι ‘γλυκὺ γλυκὺ καὶ πάντῃ πικρίας ἄψαυστον’, οὕτως καὶ ἐπὶ τῆς φιλοσοφίας θαυμάσας τις τὸ ὑπερέχον τῆς γνώσεως εἴποι ‘γνῶσις γνῶσις’ πολλάκις ‘καὶ οὐδαμῶς ἄγνοια’·", "seq": 397}
{"id": "Elias_Passim_0398", "series": "CAG", "text": "μόνη γὰρ ἡ φιλοσοφία γνῶσις.", "seq": 398}
{"id": "Elias_Passim_0399", "series": "CAG", "text": "αὕτη πρώτη αἰτία.", "seq": 399}
{"id": "Elias_Passim_0400", "series": "CAG", "text": "Δευτέρα αἰτία, ὅτι ἔοικεν ἡ φιλοσοφία βασιλεῖ καὶ θεῷ.", "seq": 400}
{"id": "Elias_Passim_0401", "series": "CAG", "text": "καὶ ὥσπερ ὁ βασιλεὺς καθιστᾷ ἄρχοντας, δι᾿ ὧν ὁμιλεῖ πᾶσι, καὶ πάντας ὁρᾷ μηδένα ὁρῶν μηδὲ διαλεγόμενος (οὐδὲ γὰρ ῥυπαίνεται τῷ πολλῷ τῶν ἀνθρώπων ὁμίλῳ), καὶ ὥσπερ ὁ θεὸς κατέστησεν ἀρχαγγελικὰς δυνάμεις, δι᾿ ὧν φρουρεῖ τὸν κόσμον, οὕτως καὶ ἡ φιλοσοφία ἐν ἀκροπόλει τινὶ οὖσα διὰ τῶν κατὰ μέρος τεχνῶν καὶ ἐπιστημῶν γινώσκει τὰ κατὰ μέρος.", "seq": 401}
{"id": "Elias_Passim_0402", "series": "CAG", "text": "καὶ ὥσπερ ὁ βασιλεὺς ἄρχων ἐστὶν ἀρχόντων, οὕτως ἡ φιλοσοφία τέχνη τεχνῶν λέγεται.", "seq": 402}
{"id": "Elias_Passim_0403", "series": "CAG", "text": "καὶ ὥσπερ πάλιν ὁ θεὸς λέγεται βασιλεὺς βασιλέων, οὕτως καὶ ἡ φιλοσοφία ἐπιστήμη ἐπιστημῶν.", "seq": 403}
{"id": "Elias_Passim_0404", "series": "CAG", "text": "τοῦτο δεύτερον.", "seq": 404}
{"id": "Elias_Passim_0405", "series": "CAG", "text": "Τρίτη αἰτία, ὅτι ταῖς ἄλλαις τέχναις καὶ ἐπιστήμαις χορηγεῖ τὰς ἀρχὰς ἡ φιλοσοφία·", "seq": 405}
{"id": "Elias_Passim_0406", "series": "CAG", "text": "φησὶ γὰρ Ἀριστοτέλης ἐν Ἀποφθέγμασιν ὅτι ‘ὅσοι ταῖς ἄλλαις τέχναις καὶ ἐπιστήμαις σχολάζοντες τῆς φιλοσοφίας ἀμελοῦσιν, ἐοίκασι τοῖς μνηστῆρσι τῆς Πηνελόπης, οἵτινες αὐτῇ συγγενέσθαι μὴ δυνάμενοι ἠγάπων κἂν ταῖς θεραπαίναις αὐτῆς συγγίνεσθαι’.", "seq": 406}
{"id": "Elias_Passim_0407", "series": "CAG", "text": "τῆς γὰρ γραμματικῆς λεγούσης ‘τῶν φωνηέντων τὰ μέν ἐστι φύσει μακρά, τὰ δὲ φύσει βραχέα, τὰ δὲ ἐπαμφοτερίζει’, ἐρωτωμένη διὰ τί τὸ η καὶ τὸ ω φύσει μακρά, ἀγνοεῖν ὁμολογήσει, εἰς δὲ τὸν μουσικὸν φιλόσοφόν σε ἀποπέμψει.", "seq": 407}
{"id": "Elias_Passim_0408", "series": "CAG", "text": "ὁμοίως τῆς ἰατρικῆς λεγούσης τέσσαρας τοὺς χυμούς, ἐπειδὴ καὶ τέσσαρα τὰ στοιχεῖα, ἐρωτωμένη διὰ τί τέσσαρα καὶ οὐδὲ πλείονα οὐδὲ ἐλάττονα, ἀναπέμψει ἡμᾶς εἰς τὸν φυσικὸν φιλόσοφον·", "seq": 408}
{"id": "Elias_Passim_0409", "series": "CAG", "text": "τῷ δὲ Ἀριστοτέλει δέδεικται ἐν τῷ Περὶ γενέσεως καὶ φθορᾶς διὰ τί οὐδὲ πλείονα τῶν τεσσάρων τὰ στοιχεῖα οὐδὲ ἐλάττονα.", "seq": 409}
{"id": "Elias_Passim_0410", "series": "CAG", "text": "ὁμοίως τῆς ῥητορικῆς διελομένης ἑαυτὴν εἰς τρία, εἰς τὸ συμβουλευτικὸν καὶ δικανικὸν καὶ πανηγυρικόν, καὶ τέλος εἰπούσης εἶναι τοῦ μὲν συμβουλευτικοῦ τὸ συμφέρον, τοῦ δὲ δικανικοῦ τὸ δίκαιον, τοῦ πανηγυρικοῦ τὸ καλόν, καὶ ἐρωτωμένης τί τὸ ὄντως συμφέρον, τί τὸ ὄντως δίκαιον ἢ τί τὸ καλόν, αὐτὴ τοῦτο ἀγνοεῖν ὁμολογήσει, παραπέμψει δὲ ἡμᾶς τῷ πολιτικῷ φιλοσόφῳ.", "seq": 410}
{"id": "Elias_Passim_0411", "series": "CAG", "text": "οὐ μόνον δὲ ταῖς τοιαύταις τέχναις καὶ ἐπιστήμαις ἀρχὰς χορηγεῖ, ἀλλὰ καὶ ταῖς βαναύσοις τέχναις·", "seq": 411}
{"id": "Elias_Passim_0412", "series": "CAG", "text": "ἡ γοῦν τεκτονικὴ βουλομένη ποιῆσαι εὐθεῖαν ἀποτείνει τὴν στάθμην ὅτι μάλιστα, λαβοῦσα παρὰ γεωμετρίας ὅτι εὐθεῖά ἐστιν ἧς τὰ μέσα τοῖς ἄκροις ἐπιπροσθεῖ·", "seq": 412}
{"id": "Elias_Passim_0413", "series": "CAG", "text": "τότε γὰρ λέγομεν ἐπ᾿ εὐθείας τρεῖς ἑστάναι ἀνθρώπους, εἰ ἰσχύσει ὁ μέσος τοῖς ἄκροις ἐπιπροσθῆσαι, εἰ δὲ περιφέρειαν ποιοῦσιν, ἀλλήλους ὁρῶσιν·", "seq": 413}
{"id": "Elias_Passim_0414", "series": "CAG", "text": "διὰ τοῦτο γὰρ τὰ θέατρα κυκλοτερῆ διὰ τὸ ἀλλήλους βλέπειν, καὶ αἱ διατριβαὶ κυκλοτερεῖς, ἵνα ὁρῶσιν ἀλλήλους καὶ τὸν διδάσκαλον.", "seq": 414}
{"id": "Elias_Passim_0415", "series": "CAG", "text": "ἀλλὰ καὶ τῇ οἰκοδομικῇ δίδωσιν ἀρχάς·", "seq": 415}
{"id": "Elias_Passim_0416", "series": "CAG", "text": "βουλομένη γὰρ γνῶναι εἰ ὀρθὸς ὁ τοῖχος, κέχρηται βαρυλλίῳ, ἰδοῦσα ὅτι τὰ βαρέα πρὸς ὀρθὰς φέρεται τῷ ὁρίζοντι, οἷον μόλυβος ἤ τι τοιοῦτον, εἰ δὲ πτερὸν εἴη, οὐ κατ᾿ εὐθὺ φέρεται, ἀλλὰ περιφέρειαν ποιεῖ.", "seq": 416}
{"id": "Elias_Passim_0417", "series": "CAG", "text": "ταῦτα καὶ τὸ τρίτον.", "seq": 417}
{"id": "Elias_Passim_0418", "series": "CAG", "text": "Τετάρτη αἰτία, ὅτι τὰ σφάλματα διορθοῦται τῶν ἄλλων τεχνῶν·", "seq": 418}
{"id": "Elias_Passim_0419", "series": "CAG", "text": "τῆς γὰρ ῥητορικῆς θέσει λεγούσης τὸ δίκαιον, (κατὰ γὰρ τοὺς τεθέντας φησὶ νόμους, ἄλλους ὄντας παρ᾿ ἄλλοις, παρὰ μὲν Πέρσαις τὸ ταῖς μητράσιν ἑαυτῶν συγγίνεσθαι καὶ ἀδελφαῖς καὶ θυγατράσι, παρὰ δὲ Τριβαλλοῖς τὸ τοὺς πατέρας γηράσκοντας ἀποσφάττειν), ἡ φιλοσοφία ἐφίστησι λέγουσα ὅτι ὁ μὲν νόμος θέσει (ἄλλος γὰρ παρ᾿ ἄλλοις), τὸ δὲ δίκαιον φύσει πανταχοῦ ὂν τὸ αὐτό·", "seq": 419}
{"id": "Elias_Passim_0420", "series": "CAG", "text": "ἄδικον γὰρ τὸ τὰ αἴτια συγχεῖν τοῖς αἰτιατοῖς καὶ ποιεῖν τὸ αἴτιον αἰτιατὸν καὶ τὸ αἰτιατὸν αἴτιον ἢ τὰ ἄρχοντα ἀρχόμενα ποιεῖν, ὅπερ ἐστὶν ἐπὶ τῆς μητρογαμίας·", "seq": 420}
{"id": "Elias_Passim_0421", "series": "CAG", "text": "ἡ γὰρ πάλαι αἰτία καὶ ἄρχουσα ὡς μήτηρ αἰτιατὴ καὶ ἀρχομένη ὡς γυνὴ γίνεται.", "seq": 421}
{"id": "Elias_Passim_0422", "series": "CAG", "text": "ἄδικον δὲ παρὰ φιλοσοφίᾳ καὶ τὸ τοὺς πατέρας γηράσκοντας κατασφάττειν, ὡς λύοντας τὸν φυσικὸν δεσμὸν παρὰ γνώμην τοῦ δήσαντος.", "seq": 422}
{"id": "Elias_Passim_0423", "series": "CAG", "text": "πάλιν τῆς ῥητορικῆς ἀντιδιαιρούσης τὸ δίκαιον τῷ συμφέροντι, καὶ τὴν Ἀντιλόχου περὶ τὸν ἴδιον πατέρα τὸν Νέστορα πρᾶξιν δικαίαν μὲν οὖσαν ὡς ὑπὲρ πατρὸς οὐ συμφέρουσαν δὲ τῷ σώματι ὅτι ἐτρώθη, ἡ φιλοσοφία φησὶ ‘καὶ δίκαιον τὸ τοιοῦτο καὶ συμφέρον·", "seq": 423}
{"id": "Elias_Passim_0424", "series": "CAG", "text": "πᾶν γὰρ συμφέρον δίκαιον καὶ πᾶν μὴ συμφέρον οὐ δίκαιον·", "seq": 424}
{"id": "Elias_Passim_0425", "series": "CAG", "text": "τί γὰρ πρὸς ἡμᾶς τὰ τοῦ σώματος τραύματα;’", "seq": 425}
{"id": "Elias_Passim_0426", "series": "CAG", "text": ", ἡμᾶς τὴν ψυχὴν εἰποῦσα.", "seq": 426}
{"id": "Elias_Passim_0427", "series": "CAG", "text": "οὕτω τρωθείς τις ἐν πολέμῳ ὑπὲρ φίλου ἔφη", "seq": 427}
{"id": "Elias_Passim_0428", "series": "CAG", "text": "αὐτόν μ᾿ ἐξεσάωσα·", "seq": 428}
{"id": "Elias_Passim_0429", "series": "CAG", "text": "τί μοι μέλει ἀσπὶς ἐκείνη;", "seq": 429}
{"id": "Elias_Passim_0430", "series": "CAG", "text": "ἐρρέτω,", "seq": 430}
{"id": "Elias_Passim_0431", "series": "CAG", "text": "αὐτὸν μὲν τὴν ἰδίαν ψυχὴν εἰπών, ἀσπίδα δὲ τὸ ἴδιον σῶμα καλέσας.", "seq": 431}
{"id": "Elias_Passim_0432", "series": "CAG", "text": "καὶ ἄλλος διψήσας ἔφη ‘ἀπέρχομαι τὸν ὄνον μου ποτίσαι’, ὄνον τὸ σῶμα καλέσας, καὶ τὸ ‘πτίσσε, πτίσσε τὸν Ἀναξάρχου θύλακον, αὐτὸν γὰρ Ἀνάξαρχον οὐ μὴ πτίσῃς ποτέ’.", "seq": 432}
{"id": "Elias_Passim_0433", "series": "CAG", "text": "πάλιν τῆς ῥητορικῆς λεγούσης ὅτι κρεῖσσον τὸ ἀδικεῖν ἢ τὸ ἀδικεῖσθαι, ἡ φιλοσοφία τοὐναντίον φησὶν ὅτι ‘μακρῷ χεῖρον τὸ ἀδικεῖν τοῦ ἀδικεῖσθαι·", "seq": 433}
{"id": "Elias_Passim_0434", "series": "CAG", "text": "ὁ γὰρ ἀδικῶν εἰς ἑαυτὸν βλάπτεται καὶ εἰς ψυχήν, ὁ δὲ ἀδικούμενος ἢ εἰς τὸ πρῶτον κτῆμα ἀδικεῖται, τοῦτ᾿ ἔστιν εἰς τὸ σῶμα, ἢ εἰς τὸ δεύτερον κτῆμα, φημὶ τὰ ὑπάρχοντα·", "seq": 434}
{"id": "Elias_Passim_0435", "series": "CAG", "text": "μακρῷ δὲ χεῖρον τὴν ψυχὴν κακῶς ἔχειν ἢ τὸ σῶμα καὶ τὰ ἐκτός’, φησὶν ‘οὐδείς σε βλάψει, εἰ μὴ σὺ σαυτόν·", "seq": 435}
{"id": "Elias_Passim_0436", "series": "CAG", "text": "κατὰ τὴν ψυχὴν γὰρ οὐκ ἔστιν ὑφ᾿ ἑτέρου ἀδικηθῆναι’·", "seq": 436}
{"id": "Elias_Passim_0437", "series": "CAG", "text": "ὁ γὰρ Πλάτων οὐκ οἶδε τὸν ἄνθρωπον ψυχὴν καὶ σῶμα, ἀλλὰ ψυχὴν λογικὴν ὀργάνῳ χρωμένην τῷ σώματι·", "seq": 437}
{"id": "Elias_Passim_0438", "series": "CAG", "text": "τρισὶ γὰρ προσρήμασι προσαγορεύει τὸν ἄνθρωπον, ἐγώ, τὸ ἐμόν, τὰ τοῦ ἐμοῦ, ἐγὼ καλῶν τὴν ψυχήν, τὸ ἐμὸν τὸ σῶμα, τὰ τοῦ ἐμοῦ τὰ κτήματα.", "seq": 438}
{"id": "Elias_Passim_0439", "series": "CAG", "text": "ὅτι δὲ ταῦτα γινώσκει ἡ φιλοσοφία, Πλάτων φησὶν ὅτι ‘βουλοίμην μὲν οὐδέτερον, μήτε ἀδικεῖν μήτε ἀδικεῖσθαι·", "seq": 439}
{"id": "Elias_Passim_0440", "series": "CAG", "text": "αἱρέσεως δὲ οὔσης ἑλοίμην μᾶλλον ἀδικεῖσθαι ἢ ἀδικεῖν’.", "seq": 440}
{"id": "Elias_Passim_0441", "series": "CAG", "text": "ἐν οἷς καὶ τοῦτο.", "seq": 441}
{"id": "Elias_Passim_0442", "series": "CAG", "text": "Πέμπτη αἰτία, ὅτι ἡ φιλοσοφία κατεσκεύασεν ἑαυτῇ τὸν συλλογισμὸν καὶ κέχρηται αὐτῷ ὀργάνῳ, αἱ δὲ ἄλλαι τέχναι κέχρηνται μὲν συλλογισμῷ, ποιῆσαι δὲ οὐ δύνανται.", "seq": 442}
{"id": "Elias_Passim_0443", "series": "CAG", "text": "καὶ ἔοικεν ἡ μὲν φιλοσοφία σκυτοτόμῳ τῷ καὶ ποιοῦντι ὑποδήματα καὶ φοροῦντι, αἱ δὲ ἄλλαι τέχναι φοροῦντι μόνον, οὐ μὴν καὶ ποιοῦντι.", "seq": 443}
{"id": "Elias_Passim_0444", "series": "CAG", "text": "ἐν οἷς καὶ ἡ πέμπτη αἰτία.", "seq": 444}
{"id": "Elias_Passim_0445", "series": "CAG", "text": "Ἀποροῦσι δέ τινες ὅτι ‘εἰ τέχνη τεχνῶν ἡ φιλοσοφία, τέχνη ἔσται καὶ αὐτή’.", "seq": 445}
{"id": "Elias_Passim_0446", "series": "CAG", "text": "καὶ λέγομεν ὅτι τέχνη τεχνῶν οὖσα ὑπὲρ τέχνην ἐστίν, ἢ καὶ ὡς τεχνοῦσα τὰς ἄλλας τέχνας τέχνη λέγεται τεχνῶν.", "seq": 446}
{"id": "Elias_Passim_0447", "series": "CAG", "text": "ἢ καὶ ἄλλως·", "seq": 447}
{"id": "Elias_Passim_0448", "series": "CAG", "text": "οὐ τὰ ἅμα λεγόμενα καὶ ἰδίᾳ δύνανται λέγεσθαι·", "seq": 448}
{"id": "Elias_Passim_0449", "series": "CAG", "text": "νεκρὸς γὰρ ἄνθρωπος λέγεται μέν, ἄνθρωπος δὲ οὔ, καὶ λιθίνη ναῦς, ναῦς δὲ οὔ, καὶ κίβδηλος χρυσός, χρυσὸς δὲ οὔ·", "seq": 449}
{"id": "Elias_Passim_0450", "series": "CAG", "text": "ὁ γὰρ χρυσὸς ἐγγυητής ἐστιν ὧν βουλόμεθα ἔχειν, ὁ δὲ κίβδηλος τοῦτο οὐ ποιεῖ.", "seq": 450}
{"id": "Elias_Passim_0451", "series": "CAG", "text": "τὸ δὲ ἔμπαλιν οὐ τὰ ἰδίᾳ λεγόμενα καὶ ἅμα δύνανται λέγεσθαι, ὡς ἵνα εἴπω ‘ὁ κύων σός, ὁ κύων πατήρ᾿, ‘ὁ δὲ κύων σὸς πατήρ᾿ οὐ δύναται λέγεσθαι.", "seq": 451}
{"id": "Elias_Passim_0452", "series": "CAG", "text": "ἐν τούτοις καὶ ὁ πέμπτος ὁρισμὸς τῆς φιλοσοφίας.", "seq": 452}
{"id": "Elias_Passim_0453", "series": "CAG", "text": "Πρᾶξις θ΄.", "seq": 453}
{"id": "Elias_Passim_0454", "series": "CAG", "text": "Οὐ δεῖ περιφρονῆσαι τοῦ ἕκτου ὁρισμοῦ τῆς φιλοσοφίας ὡς περὶ μόνας φωνὰς ἠσχολημένου, τῶν ἄλλων περὶ τὸ πρᾶγμα ἐπτοημένων ἤτοι ἐσπουδακότων·", "seq": 454}
{"id": "Elias_Passim_0455", "series": "CAG", "text": "ἔχει γάρ τι πλέον ἐκείνων οὗτος·", "seq": 455}
{"id": "Elias_Passim_0456", "series": "CAG", "text": "ἐκεῖνοι μὲν γὰρ μόνον τὸ πρᾶγμα λέγουσιν, οὗτος δὲ καὶ τὸ ὄνομα καὶ τὸ πρᾶγμα.", "seq": 456}
{"id": "Elias_Passim_0457", "series": "CAG", "text": "ἕκτος τοίνυν ὁρισμὸς τῆς φιλοσοφίας εἰς Πυθαγόραν ἀναγόμενος ὁ λέγων αὐτὴν φιλίαν σοφίας.", "seq": 457}
{"id": "Elias_Passim_0458", "series": "CAG", "text": "καὶ εὖγε ὅτι ἀρχὴ καὶ πέρας τῶν ὁρισμῶν τῆς φιλοσοφίας γέγονεν ἡμῖν ὁ Πυθαγόρας ὁ ἀεὶ διὰ τῆς σιωπῆς πρὸς ἑαυτὸν ἐπιστρέφων.", "seq": 458}
{"id": "Elias_Passim_0459", "series": "CAG", "text": "ἀλλ᾿, ὦ Πυθαγόρα, οὐκ ἀντιστρέφει ὁ ὁρισμὸς οὗτος, ὅπερ ἦν ἀρετὴ ὅρου·", "seq": 459}
{"id": "Elias_Passim_0460", "series": "CAG", "text": "εἴ τι μὲν γὰρ φιλοσοφία, φιλία σοφίας, οὐκ εἴ τι δὲ ἔφεσις σοφίας, φιλοσοφία·", "seq": 460}
{"id": "Elias_Passim_0461", "series": "CAG", "text": "πᾶσα γὰρ τέχνη καὶ ἐπιστήμη ἐφίεται τοῦ οἰκείου ὑποκειμένου.", "seq": 461}
{"id": "Elias_Passim_0462", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ οὔτε Πυθαγόρας ἐρωτώμενος ἀποκρίνεται οὔτε οἱ μαθηταὶ αὐτοῦ ἄλλο τι ἀποκρίνονται ἢ ὅτι “αὐτὸς ἔφα”, τὴν ἀπόφασιν τοῦ διδασκάλου ὑπὲρ ἀπόδειξιν ἡγούμενοι, φέρε ἡμεῖς εἴπωμεν ὑπὲρ Πυθαγόρου, ἅπερ ἂν Πυθαγόρας εἶπεν, εἴπερ λέγειν ἠνέσχετο.", "seq": 462}
{"id": "Elias_Passim_0463", "series": "CAG", "text": "πάλαι μὲν τοίνυν καὶ μέχρι τῶν Ὁμήρου χρόνων ἠδικεῖτο καὶ ἐρυπαίνετο τὸ τῆς σοφίας ὄνομα, φερόμενον κατὰ παντὸς τοῦ ὁτιοῦν εἰδότος, ὥς φησι καὶ ὁ ποιητὴς", "seq": 463}
{"id": "Elias_Passim_0464", "series": "CAG", "text": "εὖ εἰδὼς σοφίης ὑποθημοσύνῃσιν Ἀθήνης,", "seq": 464}
{"id": "Elias_Passim_0465", "series": "CAG", "text": "καὶ", "seq": 465}
{"id": "Elias_Passim_0466", "series": "CAG", "text": "ἐπεὶ σοφὸς ἤραρε τέκτων.", "seq": 466}
{"id": "Elias_Passim_0467", "series": "CAG", "text": "ὁ γοῦν Πυθαγόρας ὀψέ ποτε ἐπιγενόμενος συνέστειλε τὸ τῆς σοφίας ὄνομα ἐπὶ μόνους τοὺς τὰ ἄυλα εἰδότας, τοῦτ᾿ ἔστι τοὺς φιλοσόφους·", "seq": 467}
{"id": "Elias_Passim_0468", "series": "CAG", "text": "σαφῆ γὰρ καὶ φανὰ τὰ θεῖα αὐτοῖς, εἰ καὶ ἡμῖν ἀσαφῆ διὰ τὴν ἡμῶν ἀνεπιτηδειότητα, ὡς καὶ ταῖς νυκτερίσιν ὁ ἥλιος.", "seq": 468}
{"id": "Elias_Passim_0469", "series": "CAG", "text": "παρὰ Πυθαγόρου οὖν λεγόμενος οὗτος ὁ ὁρισμὸς τέλειος·", "seq": 469}
{"id": "Elias_Passim_0470", "series": "CAG", "text": "πᾶσα γὰρ φιλοσοφία φιλία σοφίας, καὶ πᾶσα ἔφεσις σοφίας (σοφίαν ἀκουόντων ἡμῶν τὴν τῶν ἀύλων γνῶσιν) φιλοσοφία ἐστίν.", "seq": 470}
{"id": "Elias_Passim_0471", "series": "CAG", "text": "Ἀλλ᾿ ἐπειδὴ οὐ μόνης μάστιγος δεῖ τοῖς λόγοις ἀλλὰ καὶ χαλινοῦ (μάστιγος μέν, ἵνα χαρισώμεθα τῇ μαθήσει, χαλινοῦ δέ, ἵνα τῇ μνήμῃ χαρισώμεθα·", "seq": 471}
{"id": "Elias_Passim_0472", "series": "CAG", "text": "μεμνήμεθα γὰρ τῶν δι᾿ ὀλίγων λεχθέντων, μανθάνομεν δὲ τὰ διὰ πλειόνων λεγόμενα), φέρε μετὰ τὴν πλατικὴν διέξοδον τῶν ὁρισμῶν συνόψει αὐτοὺς περιλάβωμεν.", "seq": 472}
{"id": "Elias_Passim_0473", "series": "CAG", "text": "γνῶσις τοίνυν τῶν ὄντων ἡ φιλοσοφία ἢ γνῶσις θείων τε καὶ ἀνθρωπίνων πραγμάτων·", "seq": 473}
{"id": "Elias_Passim_0474", "series": "CAG", "text": "τὰ γὰρ ὄντα ἢ θεῖα ἢ ἀνθρώπεια·", "seq": 474}
{"id": "Elias_Passim_0475", "series": "CAG", "text": "συμμετρία γὰρ οὖσα καὶ ἀρετὴ οὔτε τῶν θείων ἠμέλησε διὰ τὴν ποικιλίαν τῶν ἀνθρωπείων οὔτε τῶν ἀνθρωπείων διὰ τὴν μεγαλειότητα τῶν θείων, ἀλλ᾿ ἑκατέρου πρόνοιαν ἐποιήσατο.", "seq": 475}
{"id": "Elias_Passim_0476", "series": "CAG", "text": "ἀλλὰ καὶ μελέτη θανάτου ἡ φιλοσοφία, εἴπερ οἱ αὐτόχειρες ἑαυτῶν γινόμενοι ὃν ἔδησεν ὁ δημιουργὸς λύουσι δεσμόν, οἱ δὲ φιλόσοφοι ὃν ἔδησαν δεσμὸν αὐτοὶ καὶ λύουσιν.", "seq": 476}
{"id": "Elias_Passim_0477", "series": "CAG", "text": "ἀλλὰ καὶ ὁμοίωσις θεῷ ἡ φιλοσοφία, διὰ τὸ εἰρημένον τῷ Λυκούργῳ φιλοσόφῳ ὄντι", "seq": 477}
{"id": "Elias_Passim_0478", "series": "CAG", "text": "δίζω εἰ σε θεὸν μαντεύσομαι ἠὲ καὶ ἄνδρα.", "seq": 478}
{"id": "Elias_Passim_0479", "series": "CAG", "text": "ἀλλὰ καὶ τέχνη τεχνῶν καὶ ἐπιστήμη ἐπιστημῶν ὡς τεχνοῦσα τὰς ἄλλας τέχνας.", "seq": 479}
{"id": "Elias_Passim_0480", "series": "CAG", "text": "ἀλλὰ καὶ φιλία σοφίας ὡς τὰ ἄυλα γινώσκουσα.", "seq": 480}
{"id": "Elias_Passim_0481", "series": "CAG", "text": "Θαυμάσαι δὲ ἔστιν καὶ τὸ πλῆθος τῶν ὁρισμῶν τῆς φιλοσοφίας·", "seq": 481}
{"id": "Elias_Passim_0482", "series": "CAG", "text": "ἓξ γάρ εἰσιν, ὁ δὲ ἓξ τέλειος, ὡς ἴσος τοῖς ἑαυτοῦ μέρεσι·", "seq": 482}
{"id": "Elias_Passim_0483", "series": "CAG", "text": "τὰ γὰρ μέρη αὐτοῦ συνερχόμενα οὔτε πλεονάζει οὔτε ἐλλείπει.", "seq": 483}
{"id": "Elias_Passim_0484", "series": "CAG", "text": "οὕτως ἥμισυ τῶν ἓξ τρία, τρίτον τῶν ἓξ δύο, ἕκτον ἡ μονάς, καὶ ἰδοὺ τέλειος·", "seq": 484}
{"id": "Elias_Passim_0485", "series": "CAG", "text": "τὰ γὰρ τρία καὶ τὰ δύο καὶ τὸ ἓν συντεθέντα ἓξ ἀποτελεῖ μόνον·", "seq": 485}
{"id": "Elias_Passim_0486", "series": "CAG", "text": "τῶν γὰρ ἀριθμῶν οἱ μέν εἰσι τέλειοι, οἱ δὲ ὑπερτελεῖς, οἱ δὲ ἐλλειπεῖς.", "seq": 486}
{"id": "Elias_Passim_0487", "series": "CAG", "text": "καὶ ἔοικεν ὁ μὲν τέλειος ἀριθμὸς ἀρετῇ, ὁ δὲ ὑπερτελὴς καὶ ἐλλειπὴς ταῖς ἀντικειμέναις τῇ ἀρετῇ κακίαις·", "seq": 487}
{"id": "Elias_Passim_0488", "series": "CAG", "text": "ἡ γὰρ ἀρετὴ συμμετρία οὖσα δύο κακίαις παρασπίζεται, οἷον ἡ δικαιοσύνη πλεονεξίᾳ καὶ μειονεξίᾳ, ἡ φρόνησις πανουργίᾳ καὶ ἀνοίᾳ, ἡ ἀνδρία δειλίᾳ καὶ θράσει, ἡ σωφροσύνη ἀκολασίᾳ καὶ ἠλιθιότητι.", "seq": 488}
{"id": "Elias_Passim_0489", "series": "CAG", "text": "οὕτως οὖν καὶ ὁ τέλειος ἀριθμὸς ἀρετῇ ἔοικε καὶ συμμετρίᾳ, οἱ δὲ λοιποὶ ἀμετρίαις ἤτοι κακίαις.", "seq": 489}
{"id": "Elias_Passim_0490", "series": "CAG", "text": "Τέλειοι μὲν οὖν ἀριθμοί εἰσιν οἱ ἴσοι τοῖς ἑαυτῶν μέρεσι ὡς οὗτος ὁ ἕξ, ὑπερτελεῖς δὲ ὡς ὁ δυοκαίδεκα·", "seq": 490}
{"id": "Elias_Passim_0491", "series": "CAG", "text": "τούτου γὰρ συντεθέντων τῶν μερῶν γίνονται δεκαὲξ οὕτως·", "seq": 491}
{"id": "Elias_Passim_0492", "series": "CAG", "text": "ἥμισυ τῶν δεκαδύο ἕξ, τρίτον τῶν δεκαδύο τέσσαρα, τέταρτον τῶν δεκαδύο τρία, ἕκτον τῶν δεκαδύο δύο, καὶ τὸ δωδέκατον ἡ μονάς, δεκαὲξ ἀποτελοῦσιν.", "seq": 492}
{"id": "Elias_Passim_0493", "series": "CAG", "text": "ἐλλειπεῖς δὲ ὡς ὁ ὀκτώ·", "seq": 493}
{"id": "Elias_Passim_0494", "series": "CAG", "text": "τὰ γὰρ μέρη αὐτοῦ συντεθέντα ἑπτὰ μόνον ποιοῦσιν οὕτως·", "seq": 494}
{"id": "Elias_Passim_0495", "series": "CAG", "text": "ἥμισυ τῶν ὀκτὼ τέσσαρα, τέταρτον τῶν ὀκτὼ δύο, καὶ τὸ ὄγδοον ἡ μονάς, ἑπτὰ ποιοῦσι.", "seq": 495}
{"id": "Elias_Passim_0496", "series": "CAG", "text": "καὶ πολλοὶ μὲν οἱ ὑπερτελεῖς καὶ οἱ ἐλλειπεῖς, οἱ δὲ τέλειοι τέσσαρες μόνον·", "seq": 496}
{"id": "Elias_Passim_0497", "series": "CAG", "text": "ἀπὸ γὰρ μονάδος ἕως δεκάδος εἷς τέλειος ὁ ἕξ, καὶ ἀπὸ δεκάδος ἕως ἑκατοντάδος ὁ εἰκοστὸς ὄγδοος, καὶ ἀπὸ ἑκατοντάδος ἕως χιλιάδος ὁ τετρακοσιοστὸς ἐνενηκοστὸς ἕκτος, καὶ ἀπὸ χιλιάδος ἕως μυριάδος ὁ ὀκτακισχιλιοστὸς ἑκατοστὸς εἰκοστὸς ὄγδοος.", "seq": 497}
{"id": "Elias_Passim_0498", "series": "CAG", "text": "Καὶ ἄλλως δὲ τέλειος ὁ ἀριθμὸς τῶν ὁρισμῶν τῆς φιλοσοφίας, διότι τέσσαρες ἦσαν αἱ ἀφορμαί, ἐξ ὧν ἐλαμβάνοντο οἱ ὁρισμοί·", "seq": 498}
{"id": "Elias_Passim_0499", "series": "CAG", "text": "ἢ γὰρ ἐκ τοῦ ὑποκειμένου ἢ ἐκ τοῦ τέλους ἢ ἐκ τῆς ὑπεροχῆς ἢ ἐκ τῆς ἐτυμολογίας.", "seq": 499}
{"id": "Elias_Passim_0500", "series": "CAG", "text": "ὁ δὲ τέσσαρα ἀριθμὸς δυνάμει δέκα·", "seq": 500}
{"id": "Elias_Passim_0501", "series": "CAG", "text": "συντεθεὶς γὰρ μετὰ τῶν πρὸ αὐτοῦ ἀριθμῶν ὁ τέσσαρα, τοῦτ᾿ ἔστι τοῦ τρία καὶ δύο καὶ ἑνός, τὸν δέκα ἀποτελεῖ.", "seq": 501}
{"id": "Elias_Passim_0502", "series": "CAG", "text": "ὁ δὲ δέκα τέλειος, οὐχ ὡς ἴσος τοῖς ἑαυτοῦ μέρεσιν, ἀλλ᾿ ὅτι πᾶς ἀριθμὸς καμπτῆρι αὐτῷ κέχρηται, καὶ ὅτι πάντα ἀριθμὸν δέχεται, διὸ καὶ δεχὰς εἴρηται.", "seq": 502}
{"id": "Elias_Passim_0503", "series": "CAG", "text": "ἔοικε δὲ τούτῳ καὶ ἡ φιλοσοφία ὡς πάντα τὰ ὄντα γινώσκουσα.", "seq": 503}
{"id": "Elias_Passim_0504", "series": "CAG", "text": "Πρᾶξις ι΄.", "seq": 504}
{"id": "Elias_Passim_0505", "series": "CAG", "text": "Μετὰ τὸ γνῶναι ἡμᾶς τὴν φιλοσοφίαν ὅλην ὡς ὅλην διὰ τῶν ἓξ ὁρισμῶν, φέρε καὶ ὡς μέρη ἔχουσαν αὐτὴν διὰ τῆς διαιρέσεως πολυπραγμονήσωμεν.", "seq": 505}
{"id": "Elias_Passim_0506", "series": "CAG", "text": "ἀλλ᾿ ὥσπερ ἐπὶ τῶν ὁρισμῶν τρία τινὰ ἐζητοῦμεν, τί ἐστιν ὁρισμός, πόθεν εἴρηται ὁρισμός, πόθεν λαμβάνεται ὁρισμός, οὕτω καὶ ἐπὶ τῆς διαιρέσεως τρία ζητήσωμεν, τί διαίρεσις καὶ ἐπιδιαίρεσις καὶ ὑποδιαίρεσις·", "seq": 506}
{"id": "Elias_Passim_0507", "series": "CAG", "text": "ποῦ γὰρ οἰκειότερον ταῦτα ζητήσωμεν ἢ τὴν φιλοσοφίαν διαιροῦντες, ἧς εὕρημα ὁρισμὸς καὶ διαίρεσις;", "seq": 507}
{"id": "Elias_Passim_0508", "series": "CAG", "text": "διαίρεσις μὲν οὖν ἐστιν ἡ πρώτη τομὴ τοῦ πράγματος, οἷον ὡς ἵνα διέλω τὸ ζῷον εἰς λογικὸν καὶ ἄλογον, ἐπιδιαίρεσις δέ ἐστιν ἡ τοῦ αὐτοῦ πράγματος δευτέρα τομή, οἷον ὡς ἵνα διέλω τὸ αὐτὸ ζῷον εἰς θνητὸν καὶ ἀθάνατον (οὐδὲν δὲ διαφέρει διαίρεσις ἐπιδιαιρέσεως·", "seq": 508}
{"id": "Elias_Passim_0509", "series": "CAG", "text": "ἣν γὰρ ἂν προτάξωμεν, ἐκείνη ἐστὶ διαίρεσις, καὶ ἣν ὑποτάξωμεν, ἐκείνη ἐστὶν ἐπιδιαίρεσις), ὑποδιαίρεσις δέ ἐστιν ἡ ἑνὸς τῶν διαιρεθέντων τομή, ὡς ἵνα διέλῃ τις τὸ λογικὸν εἰς θεῖα καὶ ἀνθρώπεια καὶ τὸ ἄλογον εἰς σαρκοφάγα ἢ ποηφάγα.", "seq": 509}
{"id": "Elias_Passim_0510", "series": "CAG", "text": "ὑποδιαίρεσις οὖν ἐστιν ἡ ἑνὸς τμήματος τῶν διαιρεθέντων τομή.", "seq": 510}
{"id": "Elias_Passim_0511", "series": "CAG", "text": "Τούτων οὕτως προληφθέντων εἴπωμεν τὴν διαίρεσιν τῆς φιλοσοφίας.", "seq": 511}
{"id": "Elias_Passim_0512", "series": "CAG", "text": "διαιρεῖται τοίνυν ἡ φιλοσοφία εἰς τὸ θεωρητικὸν καὶ πρακτικόν.", "seq": 512}
{"id": "Elias_Passim_0513", "series": "CAG", "text": "ταῦτα δὲ δὲ διαφέρουσιν ἀλλήλων καὶ τῷ ὑποκειμένῳ καὶ τῷ τέλει·", "seq": 513}
{"id": "Elias_Passim_0514", "series": "CAG", "text": "τῷ μὲν γὰρ θεωρητικῷ πάντα τὰ ὄντα ὑπόκειται εἰς γνῶσιν, τῷ δὲ πρακτικῷ οὐ πάντα ὑπόκειται εἰς κατακόσμησιν, εἰ μὴ μόναι αἱ ἀνθρώπειαι ψυχαί·", "seq": 514}
{"id": "Elias_Passim_0515", "series": "CAG", "text": "οὐδὲ γὰρ ἐπαγγέλλεται ὁ φιλόσοφος κοσμεῖν ἵππου ψυχὴν ἢ βοὸς ἤ τινος ἄλλου πλὴν ἀνθρώπου.", "seq": 515}
{"id": "Elias_Passim_0516", "series": "CAG", "text": "οὕτως μὲν τῷ ὑποκειμένῳ διαφέρουσιν.", "seq": 516}
{"id": "Elias_Passim_0517", "series": "CAG", "text": "ἀλλὰ καὶ τῷ τέλει·", "seq": 517}
{"id": "Elias_Passim_0518", "series": "CAG", "text": "ὁ μὲν γὰρ θεωρητικὸς περὶ τὴν ἀλήθειαν καὶ τὸ ψεῦδος καταγίνεται, τέλος δὲ ποιεῖται μόνον τὸ ἀληθές, ὁ δὲ πρακτικὸς περὶ τὸ ἀγαθὸν καὶ τὸ κακὸν καταγίνεται, τέλος δὲ ποιεῖται μόνον τὸ ἀγαθόν·", "seq": 518}
{"id": "Elias_Passim_0519", "series": "CAG", "text": "θέλει γὰρ γινώσκειν τὸ ἀγαθὸν καὶ κακὸν καὶ τὴν διαφορὰν εἰδέναι ἀγαθοῦ καὶ κακοῦ ὑπὲρ τοῦ τὰ μὲν ἑλεῖν τὰ δὲ φυγεῖν, τοῦτ᾿ ἔστιν ἵνα μήτε λέγῃ κακόν τι ὁ φιλόσοφος μήτε πράττῃ, ὥσπερ καὶ ὁ ἰατρὸς θέλει γινώσκειν τὰ δηλητήρια, οὐχ ἵνα χρήσηται αὐτοῖς, ἀλλ᾿ ἵνα διὰ τῆς γνώσεως παραιτήσηται αὐτά.", "seq": 519}
{"id": "Elias_Passim_0520", "series": "CAG", "text": "ἀποροῦσι δέ τινες ὅτι ‘εἰ τοῦ θεωρητικοῦ τέλος τὸ ἀληθές, τοῦ δὲ πρακτικοῦ τὸ ἀγαθόν, ταὐτὸν ἄρα τὸ θεωρητικὸν τῷ πρακτικῷ·", "seq": 520}
{"id": "Elias_Passim_0521", "series": "CAG", "text": "ὧν γὰρ τὰ τέλη ταὐτά, καὶ αὐτὰ ταὐτά’.", "seq": 521}
{"id": "Elias_Passim_0522", "series": "CAG", "text": "λεκτέον οὖν ὅτι πολλὴ ἡ ἐν τούτοις διαφορά·", "seq": 522}
{"id": "Elias_Passim_0523", "series": "CAG", "text": "πολλάκις γὰρ ψευδόμεθα ἐπ᾿ ἀγαθῷ καὶ ἀληθεύομεν ἐπὶ κακῷ·", "seq": 523}
{"id": "Elias_Passim_0524", "series": "CAG", "text": "οἷον ὑγιαίνων τις παρέθετο ξίφος τινί, ἄφνω δὲ μανεὶς αἰτεῖ τὴν παρακαταθήκην, ἵνα ἢ ἑαυτὸν ἢ ἕτερόν τινα σφάξῃ, ὁ δὲ ἀρνεῖται καὶ ψεύδεται μέν, ἐπ᾿ ἀγαθῷ δέ, ὡς εἴ γε ἠλήθευσεν, ἐπὶ κακῷ ἠλήθευεν.", "seq": 524}
{"id": "Elias_Passim_0525", "series": "CAG", "text": "δύναται δὲ μερικῶς καὶ ἀληθεύειν ὁ τοιοῦτος·", "seq": 525}
{"id": "Elias_Passim_0526", "series": "CAG", "text": "ἄλλος γὰρ ἦν ὑγιαίνων ὁ τὸ ξίφος παραθέμενος καὶ ἄλλος μαινόμενος.", "seq": 526}
{"id": "Elias_Passim_0527", "series": "CAG", "text": "Ἵνα δὲ μὴ λάθωμεν ἑαυτοὺς κακοῦ μαγείρου δίκην παρὰ ἄρθρα τὰς διαιρέσεις ποιούμενοι, ὅπου μὴ ἔστι διφυΐα, ὥσπερ οἱ πρίζοντες τὰ ξύλα ἡγεμόνι κέχρηνται τῇ μίλτῳ, οὕτως καὶ ἡμεῖς ἡγεμόνι χρησάμενοι τῷ λόγῳ, εἰς ὅσα καὶ οἷα ὑπαγορεύει, οὕτως ποιησόμεθα τὰς διαιρέσεις, ὅπου διφυΐα ἐστί ** πέφυκε διαιρεῖσθαι, τοῦτ᾿ ἔστι καθ᾿ ἑκάστην διαίρεσιν δεῖ ζητεῖν διὰ τί εἰς τοσαῦτα καὶ τοιαῦτα διαιρεῖται.", "seq": 527}
{"id": "Elias_Passim_0528", "series": "CAG", "text": "Διαιρεῖται τοίνυν ἡ φιλοσοφία εἰς δύο καὶ οὐχὶ εἰς τρία, ὡς οἱ τὸ λογικὸν αὐτῇ προσνέμοντες·", "seq": 528}
{"id": "Elias_Passim_0529", "series": "CAG", "text": "δειχθήσεται γὰρ σὺν θεῷ ἐν τοῖς Ἀναλυτικοῖς ὅτι ἡ λογικὴ οὐ μέρος τῆς φιλοσοφίας, ἀλλ᾿ ὄργανον, διότι τὸ μὲν μέρος συμφυές, τὸ δὲ ὄργανον ἐπείσακτον.", "seq": 529}
{"id": "Elias_Passim_0530", "series": "CAG", "text": "εἰς δύο δὲ διαιρεῖται ἡ φιλοσοφία, οὐχ ὥς φασιν αἱ ἐγκύκλιοι ἐξηγήσεις, ὅτι ἐπειδὴ ἡ φιλοσοφία γνῶσις θείων καὶ ἀνθρωπείων ἐστί, διὰ μὲν τὰ θεῖα τὸ θεωρητικὸν προεβάλλετο (θεωρητικὸν γάρ, φασίν, εἴρηται ὡς τέλος ἔχον τὰ θεῖα ὁρᾶν), διὰ δὲ τὰ ἀνθρώπινα προεβάλλετο τὸ πρακτικόν·", "seq": 530}
{"id": "Elias_Passim_0531", "series": "CAG", "text": "παραλογίζονται γὰρ ἐκ τῆς ὁμωνυμίας τοῦ ἀνθρωπείου·", "seq": 531}
{"id": "Elias_Passim_0532", "series": "CAG", "text": "ἄλλο γὰρ ἀνθρώπειον ἐν τῷ ὁρισμῷ ἐλαμβάνετο (τὸ γὰρ ἐκ τοῦ τιμιωτέρου κατὰ παντὸς φθαρτοῦ φερόμενον), ἄλλο δὲ ἀνθρώπειον ἐνταῦθα λαμβάνουσι, τὸ ἐπὶ τοῦ κυρίως ἀνθρώπου.", "seq": 532}
{"id": "Elias_Passim_0533", "series": "CAG", "text": "φέρε οὖν εἴπωμεν ἡμεῖς τούτου αἰτίας δύο·", "seq": 533}
{"id": "Elias_Passim_0534", "series": "CAG", "text": "πρώτην μὲν τοιαύτην, ὅτι ἡ φιλοσοφία ὁμοία ἐστὶ θεῷ κατὰ τὸ δυνατὸν ἀνθρώπῳ, καὶ ἐπειδὴ ὁ θεὸς καὶ πάντα τὰ ὄντα γινώσκει καὶ τῶν δευτέρων πρόνοιαν ποιεῖται, εἰκότως καὶ ἡ φιλοσοφία μιμουμένη θεὸν διὰ μὲν τὴν καθόλου γνῶσιν αὐτῆς τὸ θεωρητικὸν προεβάλλετο, διὰ δὲ καὶ <τὸ> τῶν δευτέρων προνοεῖν προεβάλλετο τὸ πρακτικόν.", "seq": 534}
{"id": "Elias_Passim_0535", "series": "CAG", "text": "αὕτη μὲν ἡ πρώτη αἰτία.", "seq": 535}
{"id": "Elias_Passim_0536", "series": "CAG", "text": "δευτέρα δὲ ὅτι ἡ φιλοσοφία ἰατρικὴ ψυχῶν ἐστιν·", "seq": 536}
{"id": "Elias_Passim_0537", "series": "CAG", "text": "ἡ δὲ ψυχὴ διττὰς ἔχει δυνάμεις, γνωστικὰς καὶ πρακτικάς, ἄμφω δὲ συνουσίωνται ἡμῖν, ὡς δηλοῖ τὸ ἐκ παίδων φιλομύθους ἡμᾶς εἶναι καὶ χαίρειν ἐν τῇ περιεργίᾳ, ὥς φησι Μένανδρος", "seq": 537}
{"id": "Elias_Passim_0538", "series": "CAG", "text": "φιλῶ σ᾿, Ὀνήσιμε, καὶ σὺ περίεργος εἶ,", "seq": 538}
{"id": "Elias_Passim_0539", "series": "CAG", "text": "καὶ πάλιν", "seq": 539}
{"id": "Elias_Passim_0540", "series": "CAG", "text": "οὐδὲν γὰρ γλυκύτερον ἢ πάντ᾿ εἰδέναι.", "seq": 540}
{"id": "Elias_Passim_0541", "series": "CAG", "text": "ὁμοίως δὲ καὶ Ἀριστοτέλης·", "seq": 541}
{"id": "Elias_Passim_0542", "series": "CAG", "text": "“πάντες ἄνθρωποι τοῦ εἰδέναι ὀρέγονται φύσει, σημεῖον δὲ ἡ τῶν αἰσθήσεων ἀγάπησις”.", "seq": 542}
{"id": "Elias_Passim_0543", "series": "CAG", "text": "ἀλλὰ καὶ τὸ πρακτικὸν συνουσίωται ἡμῖν, ὡς δηλοῖ τὸ ἐν ταῖς ἐρημίαις ἀσχάλλειν ἡμᾶς καὶ τρίχας τίλλειν ἢ δακτύλιον περιελίττειν ἢ κηρὸν μαλάττειν διὰ τὸ μὴ ἀνέχεσθαι ἡμᾶς παντελοῦς ἀργίας.", "seq": 543}
{"id": "Elias_Passim_0544", "series": "CAG", "text": "διὰ τὰς γνωστικὰς οὖν εἰκότως προεβάλετο τὸ θεωρητικόν, διὰ δὲ τὰς πρακτικὰς τὸ πρακτικόν.", "seq": 544}
{"id": "Elias_Passim_0545", "series": "CAG", "text": "Τούτων οὕτως ἐχόντων εἴπωμεν τὴν ὑποδιαίρεσιν τοῦ θεωρητικοῦ.", "seq": 545}
{"id": "Elias_Passim_0546", "series": "CAG", "text": "καὶ ἐνῆν μὲν προτάξαι θάτερον θατέρου, καὶ τὸ θεωρητικὸν τοῦ πρακτικοῦ, ὡς πάντα τὰ ὄντα γινῶσκον, τέλος δὲ ἔχον τὸ ἀληθές, καὶ τὸ πρακτικὸν τοῦ θεωρητικοῦ, ὅτι εἰ καὶ μὴ ὑπόκεινται αὐτῷ πάντα τὰ ὄντα εἰς κατακόσμησιν, ἀλλ᾿ ἔχει τέλος τὸ ἀγαθόν, ὅπερ, ὡς ἐδείχθη, ἐπέκεινά ἐστι τοῦ ἀληθοῦς·", "seq": 546}
{"id": "Elias_Passim_0547", "series": "CAG", "text": "τὸ γὰρ ἀγαθὸν πρὸς τῷ θεῷ.", "seq": 547}
{"id": "Elias_Passim_0548", "series": "CAG", "text": "διὸ καὶ πρόνοια καλεῖται τὸ ἀγαθὸν ὡς πρὸ τοῦ νοῦ ὄν, νοῦ δέ ἐστι τὸ ἀληθεύειν.", "seq": 548}
{"id": "Elias_Passim_0549", "series": "CAG", "text": "ἀλλ᾿ ὡς ἐν λογικῇ πραγματείᾳ τὰ καθόλου προτακτέον·", "seq": 549}
{"id": "Elias_Passim_0550", "series": "CAG", "text": "διὸ τὸ θεωρητικὸν δεῖ πρότερον ὑποδιελεῖν.", "seq": 550}
{"id": "Elias_Passim_0551", "series": "CAG", "text": "διαιρεῖται τοίνυν τοῦτο εἰς τρία, εἰς φυσικόν, μαθηματικόν, θεολογικόν.", "seq": 551}
{"id": "Elias_Passim_0552", "series": "CAG", "text": "καὶ εἰκότως·", "seq": 552}
{"id": "Elias_Passim_0553", "series": "CAG", "text": "ὁ γὰρ φιλόσοφος πάντα τὰ ὄντα θέλει γινώσκειν·", "seq": 553}
{"id": "Elias_Passim_0554", "series": "CAG", "text": "πάντα δὲ τὰ ὄντα τριττά, ἢ πάντῃ ἔνυλα, ὡς ὀστέα τρίχες ὄνυχες, περὶ ἃ καταγίνεται τὸ φυσικόν, ἢ πάντῃ ἄυλα, ὡς τὰ θεῖα, ἢ πῇ μὲν ἔνυλα, πῇ δὲ ἄυλα, ὡς τρίγωνα καὶ τετράγωνα σχήματα ἐν κηρῷ ἢ ἀβακίῳ χαραττόμενα, περὶ ἃ καταγίνεται τὸ μαθηματικόν·", "seq": 554}
{"id": "Elias_Passim_0555", "series": "CAG", "text": "ταῦτα γὰρ τὴν μὲν ὑπόστασιν ἐν ὕλῃ ἔχουσιν, ἐν ἀβακίῳ φέρε εἰπεῖν ἢ κηρῷ, δύνανται δὲ ἐπινοηθῆναι ὑπὸ τῆς φαντασίας καὶ χωρὶς τῆς ὕλης, δίκην κηροῦ ἀναματτομένου τὸ εἶδος τοῦ σφραγιστῆρος, καταλιμπάνοντος δὲ τὸν χαλκόν.", "seq": 555}
{"id": "Elias_Passim_0556", "series": "CAG", "text": "διὸ καὶ ὁ Πλάτων ἐκμαγεῖον καλεῖ τὴν φαντασίαν διὰ τὸ ἐκμάττεσθαι καὶ ἀποσυλᾶν τὰ εἴδη ἀπὸ τῆς ὕλης.", "seq": 556}
{"id": "Elias_Passim_0557", "series": "CAG", "text": "Ἀποροῦσι δέ τινες διὰ τί μὴ καὶ τὰ φυσικὰ λέγομεν μαθηματικά, εἴ γε δυνάμεθα καὶ τὸ τῆς σαρκὸς εἶδος ἐπινοῆσαι χωρὶς τῆς ὕλης.", "seq": 557}
{"id": "Elias_Passim_0558", "series": "CAG", "text": "πρὸς οὓς ἐροῦμεν ὅτι τὰ μὲν σχήματα ἐπινοῆσαι δυνάμεθα χωρὶς ὕλης, ἐπειδὴ μηδεμιᾶς κράσεως δέονται, σάρκα δὲ ἐπινοῆσαι ἄνευ κράσεως οὐ δυνάμεθα, ἐν ᾗ τὴν ὑπόστασιν ἔχει·", "seq": 558}
{"id": "Elias_Passim_0559", "series": "CAG", "text": "ἡ γὰρ κρᾶσις ὕλη ἐστί.", "seq": 559}
{"id": "Elias_Passim_0560", "series": "CAG", "text": "Δεῖ οὖν πρῶτον τὰ πάντῃ ἔνυλα καὶ φυσικὰ ἀναλέγεσθαι, μετ᾿ ἐκεῖνα τὰ μαθηματικὰ κλίμαξιν ἐοικότα ἢ γεφύραις·", "seq": 560}
{"id": "Elias_Passim_0561", "series": "CAG", "text": "οὐδὲ γὰρ ἀθρόον ἀπὸ τῶν πάντῃ ἐνύλων ἐπὶ τὰ ἄυλα μετιέναι δεῖ·", "seq": 561}
{"id": "Elias_Passim_0562", "series": "CAG", "text": "ταὐτὰ γὰρ πεισόμεθα τοῖς ἀπὸ ζοφώδους σπηλαίου τολμήσασιν ἀθρόον ἀντωπῆσαι ταῖς ἡλιακαῖς ἀκτῖσι·", "seq": 562}
{"id": "Elias_Passim_0563", "series": "CAG", "text": "δεῖ γὰρ τοὺς τοιούτους πρότερον ἐν οἰκίσκῳ ἔχοντι σύμμετρον φῶς προεθισθέντας οὕτως ἀντωπῆσαι ταῖς ἡλιακαῖς ἀκτῖσιν.", "seq": 563}
{"id": "Elias_Passim_0564", "series": "CAG", "text": "ὡσαύτως οὖν χρὴ καὶ ἀπὸ τῶν πάντῃ ἐνύλων ἀναλογούντων σπηλαίῳ εἰς τὰ μαθήματα ἐγγυμνασθῆναι ἀναλογοῦντα οἰκίσκῳ σύμμετρον ἔχοντι φῶς, καὶ εἶθ᾿ οὕτως χωρεῖν ἐπὶ τὰ ἄυλα ἀναλογοῦντα ταῖς τοῦ ἡλίου ἀκτῖσιν·", "seq": 564}
{"id": "Elias_Passim_0565", "series": "CAG", "text": "οὕτω γάρ φασι καὶ οἱ Πυθαγόρειοι “σχᾶμα καὶ βᾶμα” ἀντὶ τοῦ ‘καθ᾿ ἕκαστον σχῆμα βαθμὸν ἄνιμεν ἐπὶ θεολογίαν, κατὰ μέρος ἐν νῷ λαμβάνοντες τὰ πάντῃ ἄυλα.’", "seq": 565}
{"id": "Elias_Passim_0566", "series": "CAG", "text": "Ἀποροῦσι δέ τινες ὅτι εἰ πάντα μανθάνομεν καὶ τὰ ἄυλα καὶ τὰ ἔνυλα καὶ τὰ μέσα, διὰ τί μὴ πάντα καλεῖται μαθήματα, ἀλλὰ μόνα τὰ μέσα ἐσφετερίσατο τὸ κοινὸν ὄνομα.", "seq": 566}
{"id": "Elias_Passim_0567", "series": "CAG", "text": "καὶ λέγομεν τούτου αἰτίας δύο, μίαν μὲν ὅτι ἔχουσι τὰ μαθήματα τὸ ἀραρὸς τῶν ἀποδείξεων·", "seq": 567}
{"id": "Elias_Passim_0568", "series": "CAG", "text": "ταῦτα γὰρ μανθάνομεν ἀκριβῶς, τὰ δὲ ἄλλα εἰκάζομεν μᾶλλον ἢ μανθάνομεν, διὸ καὶ ὁ φιλόσοφος Μαρῖνος ἔφη “εἴθε πάντα μαθήματα ἦν”.", "seq": 568}
{"id": "Elias_Passim_0569", "series": "CAG", "text": "δευτέραν δὲ ὅτι ταῦτα ἡδέως μανθάνομεν πάσχοντες τὸ τῶν Λωτοφάγων·", "seq": 569}
{"id": "Elias_Passim_0570", "series": "CAG", "text": "γευσάμενοι γὰρ αὐτῶν οὐ θέλομεν αὐτῶν ἀποστῆναι, ἀλλ᾿ ἐχόμεθα αὐτῶν ὡς λωτοῦ.", "seq": 570}
{"id": "Elias_Passim_0571", "series": "CAG", "text": "ᾗ φησι καὶ Πλάτων οὕτως ‘ἃ γὰρ ἂν ἑκοῦσα ἡ ψυχὴ λάβῃ, δυσέκνιπτα καὶ ἀμετάστατα φιλεῖ γίνεσθαι’, ὥσπερ καὶ τοὐναντίον φησὶν ‘ψυχῆς βίαιον οὐδὲν ἔμμονον μάθημα’.", "seq": 571}
{"id": "Elias_Passim_0572", "series": "CAG", "text": "καὶ Ἀρχιμήδης δέ ποτε βαρβάρων ἐπιστάντων ταῖς Συρακούσαις οὐκ ἔφυγεν θεώρημά τι γεωμετρικὸν καταγράφων, ἀλλ᾿ ἔφη “τὰν κεφαλὰν καὶ μὴ τὰν γραμμάν”, τοῦτ᾿ ἔστι παρὰ τὴν κεφαλὴν καὶ μὴ παρὰ τὴν γραμμήν.", "seq": 572}
{"id": "Elias_Passim_0573", "series": "CAG", "text": "καὶ ταῦτα ἔχει ἡ παροῦσα πρᾶξις.", "seq": 573}
{"id": "Elias_Passim_0574", "series": "CAG", "text": "Πρᾶξις ια΄.", "seq": 574}
{"id": "Elias_Passim_0575", "series": "CAG", "text": "Τοῦ θεωρητικοῦ εἰς τρία διαιρεθέντος, εἰς φυσικόν, μαθηματικόν, θεολογικόν, μόνου τοῦ μαθηματικοῦ τὴν διαίρεσιν οἱ ἐξηγηταὶ νῦν παραδιδόασιν, ὡς ἂν τούτου συμμέτρως ἔχοντος πρὸς εἰσαγομένους.", "seq": 575}
{"id": "Elias_Passim_0576", "series": "CAG", "text": "ἐφ᾿ οἷς εἴπωμεν τὴν ὑποδιαίρεσιν τοῦ μαθηματικοῦ.", "seq": 576}
{"id": "Elias_Passim_0577", "series": "CAG", "text": "διαιρεῖται τοίνυν εἰς τέσσαρα, εἰς ἀριθμητικήν, μουσικήν, γεωμετρίαν, ἀστρονομίαν.", "seq": 577}
{"id": "Elias_Passim_0578", "series": "CAG", "text": "καὶ εἰκότως, ἐπειδὴ ἡ μαθηματικὴ περὶ ἀριθμὸν καταγίνεται καὶ μέγεθος, τοῦ δὲ ἀριθμοῦ τὸ μὲν καθ᾿ αὑτό, τὸ δὲ ἐν σχέσει, τοῦ δὲ μεγέθους τὸ μὲν ἀκίνητον, τὸ δὲ κινούμενον.", "seq": 578}
{"id": "Elias_Passim_0579", "series": "CAG", "text": "καὶ περὶ μὲν τὸν καθ᾿ αὑτὸ ἀριθμὸν καταγίνεται ἡ ἀριθμητική, ζητοῦσα τὰς φύσεις τῶν ἀριθμῶν καὶ τὰ πάθη, ὡς ὅταν λέγῃ ‘τῶν ἀριθμῶν οἱ μὲν ἄρτιοι, οἱ δὲ περιττοί’, καὶ τούτων τὰ εἴδη·", "seq": 579}
{"id": "Elias_Passim_0580", "series": "CAG", "text": "οὐδεμίαν γὰρ ἔμφασιν ἑτέρου ἀριθμοῦ παρέχει, εἰ δὲ εἴπῃ διπλάσιον, τριπλάσιον, ἔμφασιν καὶ ἑτέρου παρέχει, ποὺ μὲν ἡμίσεος, ποὺ δὲ τρίτου.", "seq": 580}
{"id": "Elias_Passim_0581", "series": "CAG", "text": "ἡ δὲ μουσικὴ περὶ τὸν ἐν σχέσει ἀριθμὸν καταγίνεται, ζητοῦσα ποῖον λόγον ἔχει ἡ ἀπήχησις τῆσδε τῆς χορδῆς πρὸς τήνδε, ἆρα διπλάσιον καὶ πολλαπλάσιον ἢ ἡμιόλιον.", "seq": 581}
{"id": "Elias_Passim_0582", "series": "CAG", "text": "διὸ καὶ ἀποροῦσιν ὅτι εἰ ἡ μουσικὴ περὶ συμμετρίαν φθόγγων καταγίνεται καὶ ἀσυμμετρίαν, πῶς περὶ τὰς σχέσεις τῶν ἀριθμῶν λέγουσιν αὐτὴν καταγίνεσθαι.", "seq": 582}
{"id": "Elias_Passim_0583", "series": "CAG", "text": "καὶ λέγομεν ὅτι μήποτε <περὶ> τῆς κατὰ Πυθαγόραν μουσικῆς ταῦτα εἴρηται ὡς ἀυλοτέρας οὔσης, ἥτις οὐ προσποιεῖται ὕλην ἢ φθόγγους, ἀλλ᾿ αὐτὰς τὰς σχέσεις τῶν ἀριθμῶν θεωρεῖ καταμόνας·", "seq": 583}
{"id": "Elias_Passim_0584", "series": "CAG", "text": "φασὶ γὰρ αὐτόν ποτε παριόντα διὰ χαλκείου ἀκοῦσαι μέλους τινὸς καὶ ἁρμονίας ἐκ τῶν πληγῶν τῶν σφυρῶν ἀποτελουμένου.", "seq": 584}
{"id": "Elias_Passim_0585", "series": "CAG", "text": "καὶ ἐπέτρεψεν αὐτοῖς ἀλλάξαι τοὺς ἄκμονας.", "seq": 585}
{"id": "Elias_Passim_0586", "series": "CAG", "text": "τοῦ δὲ μέλους οὐδὲν ἧττον τοῦ αὐτοῦ φυλαχθέντος ἐπέτρεψε πάλιν αὐτοῖς τὰς σφύρας ἀλλάξαι.", "seq": 586}
{"id": "Elias_Passim_0587", "series": "CAG", "text": "τοῦ δὲ μέλους ἐπὶ τούτοις παραφθαρέντος ἐστάθμησε καὶ τὰς πρώτας σφύρας καὶ τὰς δευτέρας, ποῖον λόγον ἔσχον πρὸς ἀλλήλας καὶ τὰ μέλη, καὶ ὡς ἁρμονικὸν λόγον ἀπεγράψατο τοὺς λόγους αὐτοὺς καθ᾿ αὑτοὺς συγκρίνας χωρὶς τῆς ὕλης, ὡς εἴ γε συνέβη τοιαύτην ἀναλογίαν ἀριθμῶν ἐν ὀξυβάφοις ἢ αὐλοῖς εἶναι, τὸ αὐτὸ ἂν μέλος ἀπετελεῖτο.", "seq": 587}
{"id": "Elias_Passim_0588", "series": "CAG", "text": "ἡ δὲ γεωμετρία περὶ ἀκίνητον μέγεθος καταγίνεται καὶ περὶ τὰ σχήματα τῆς γῆς, ἡ δὲ ἀστρονομία περὶ κινούμενον μέγεθος, οὐ μόνον δὲ κινούμενον ἀλλ᾿ ἀεικίνητον·", "seq": 588}
{"id": "Elias_Passim_0589", "series": "CAG", "text": "φαντασίας γὰρ μόνης ἐστὶν ἡ δοκοῦσα αὐτῶν εἶναι στάσις.", "seq": 589}
{"id": "Elias_Passim_0590", "series": "CAG", "text": "Εὗρον δὲ τὴν μὲν ἀριθμητικὴν Φοίνικες (ἐμπορικώτατοι γὰρ ὄντες ἐδεήθησαν ψήφων), τὴν δὲ μουσικὴν εὗρον οἱ Θρᾷκες ὡς ἄγαν πολεμικοὶ ὄντες·", "seq": 590}
{"id": "Elias_Passim_0591", "series": "CAG", "text": "ἡ γὰρ ψῦξις ἀποκλείουσα τὸ θερμὸν ἐν τῷ βάθει δριμύτερον αὐτὸ ποιεῖ.", "seq": 591}
{"id": "Elias_Passim_0592", "series": "CAG", "text": "ὅθεν καὶ θυμώδεις εἰσὶ καὶ πολεμικοὶ τῇ βίᾳ τοῦ θερμοῦ, καὶ ὀρχηστικοὶ δὲ διὰ τὰς ἑτοίμους ἀποφυγὰς τῶν βελῶν·", "seq": 592}
{"id": "Elias_Passim_0593", "series": "CAG", "text": "ἔστι γὰρ καὶ πυρρίχιος παρ᾿ αὐτοῖς ὄρχησις, ὅ ἐστιν ἔνοπλος κατὰ τὸ εἰρημένον τῷ ποιητῇ", "seq": 593}
{"id": "Elias_Passim_0594", "series": "CAG", "text": "Μηριόνη, τάχα κέν σε καὶ ὀρχηστήν περ ἐόντα.", "seq": 594}
{"id": "Elias_Passim_0595", "series": "CAG", "text": "ἀλλὰ καὶ ἐμβατήρια μέλη ἐστὶ παρ᾿ αὐτοῖς.", "seq": 595}
{"id": "Elias_Passim_0596", "series": "CAG", "text": "τὴν δὲ γεωμετρίαν εὗρον Αἰγύπτιοι, ὡς καὶ ἀνωτέρω εἴρηται, διὰ τὸ ἀνιόντα τὸν Νεῖλον συγχεῖν τὰ ὁροθέσια αὐτῶν.", "seq": 596}
{"id": "Elias_Passim_0597", "series": "CAG", "text": "τὴν δὲ ἀστρονομίαν εὗρον Χαλδαῖοι ὡς καθαρὸν οἰκοῦντες ἀέρα·", "seq": 597}
{"id": "Elias_Passim_0598", "series": "CAG", "text": "ἀνατολικοὶ γὰρ ὄντες τῇ θερμότητι τοῦ ἡλίου ἔχουσι λεπτυνομένην ἑτοίμως τὴν ἀτμίδα·", "seq": 598}
{"id": "Elias_Passim_0599", "series": "CAG", "text": "τρίτου γὰρ κλίματος Ἀλεξάνδρεια Ἀφρικὴ καὶ Περσίς.", "seq": 599}
{"id": "Elias_Passim_0600", "series": "CAG", "text": "ἐφ᾿ οἷς τούτων λεχθέντων εἴπωμεν τὴν τάξιν αὐτῶν.", "seq": 600}
{"id": "Elias_Passim_0601", "series": "CAG", "text": "Πρότεραι τοίνυν αἱ περὶ ἀριθμοὺς τῶν περὶ μέγεθος καταγινομένων εἰσίν·", "seq": 601}
{"id": "Elias_Passim_0602", "series": "CAG", "text": "ἀυλότερος γὰρ ὁ ἀριθμὸς τοῦ μεγέθους ὡς δυνάμενος διάφορα εἴδη σχημάτων δέξασθαι ἀσυγχύτως·", "seq": 602}
{"id": "Elias_Passim_0603", "series": "CAG", "text": "ὁ γὰρ αὐτὸς ἀριθμὸς δύναται κύκλος ἅμα καὶ τετράγωνος γενέσθαι.", "seq": 603}
{"id": "Elias_Passim_0604", "series": "CAG", "text": "κύκλος δέ ἐστιν ὁ νόμῳ κύκλου ἀπὸ τοῦ αὐτοῦ ἀρξάμενος καὶ εἰς τὸ αὐτὸ λήγων, οἷον ὁ τετράκις ἓξ εἴκοσι τέσσαρα.", "seq": 604}
{"id": "Elias_Passim_0605", "series": "CAG", "text": "τετράγωνος δὲ ὁ ἑαυτὸν πολυπλασιάζων, οἷον ὁ τετράκις τέσσαρα δεκαέξ·", "seq": 605}
{"id": "Elias_Passim_0606", "series": "CAG", "text": "ἐξ ἀριθμοῦ γὰρ ἑαυτὸν πολυπλασιάσαντος ἐγένετο.", "seq": 606}
{"id": "Elias_Passim_0607", "series": "CAG", "text": "κύκλος δὲ ἅμα καὶ τετράγωνος ὁ ἐξ ἀριθμοῦ ἑαυτὸν πολυπλασιάσαντος γενόμενος καὶ ἀπὸ τοῦ αὐτοῦ ἀρξάμενος καὶ εἰς τὸ αὐτὸ λήγων, οἷον ὁ ἑξάκις ἓξ τριάκοντα ἓξ καὶ ὁ πεντάκις πέντε εἴκοσι πέντε·", "seq": 607}
{"id": "Elias_Passim_0608", "series": "CAG", "text": "ἰδοὺ γὰρ ἀπὸ τοῦ αὐτοῦ ἄρχεται καὶ εἰς τὸ αὐτὸ λήγει, καὶ ἐξ ἀριθμοῦ πολυπλασιάσαντος ἑαυτὸν ἐγένετο.", "seq": 608}
{"id": "Elias_Passim_0609", "series": "CAG", "text": "καὶ πολλοὶ μὲν κύκλοι καὶ τετράγωνοι, κύκλος δὲ ἅμα καὶ τετράγωνος ὁ εἴκοσι πέντε καὶ ὁ τριάκοντα ἕξ, καὶ πλὴν τούτων τῶν δύο οὐκ ἔστιν ἄλλος.", "seq": 609}
{"id": "Elias_Passim_0610", "series": "CAG", "text": "ἐπὶ δὲ τῶν μεγεθῶν τοῦτο οὐκ ἔστι·", "seq": 610}
{"id": "Elias_Passim_0611", "series": "CAG", "text": "τὸ γὰρ φθάσαν μέγεθος σχηματισθῆναι οὐκ ἐπιδέχεται ἕτερον σχῆμα ἀσυγχύτως ὡς ἐνυλότερον.", "seq": 611}
{"id": "Elias_Passim_0612", "series": "CAG", "text": "οὕτως καὶ δεικνύουσιν οἱ φιλόσοφοι ὅτι ἡ φαντασία ἀσώματος ὡς πλείονας τύπους δεχομένη ἀσυγχύτως·", "seq": 612}
{"id": "Elias_Passim_0613", "series": "CAG", "text": "ἀύλου γὰρ τοῦτο.", "seq": 613}
{"id": "Elias_Passim_0614", "series": "CAG", "text": "προτέρα δὲ ἡ ἀριθμητικὴ τῆς μουσικῆς, ἐπειδὴ ἡ μὲν ἀριθμητικὴ περὶ τὸν καθ᾿ αὑτὸ ἀριθμὸν καταγίνεται, ἡ δὲ μουσικὴ περὶ τὸν ἐν σχέσει, προηγεῖται δὲ τὰ καθ᾿ αὑτὸ τῶν ἐν σχέσει, εἴ γε πρῶτον γίνεταί τις ἄνθρωπος, εἶθ᾿ οὕτως πατήρ.", "seq": 614}
{"id": "Elias_Passim_0615", "series": "CAG", "text": "ἐν δὲ ταῖς περὶ μέγεθος καταγινομέναις προτέρα ἡ γεωμετρία τῆς ἀστρονομίας, ὅτι ἡ μὲν γεωμετρία περὶ ἀκίνητον καὶ μένον ποσὸν καταγίνεται, ἡ δὲ ἀστρονομία περὶ κινούμενον·", "seq": 615}
{"id": "Elias_Passim_0616", "series": "CAG", "text": "οὐ δεῖται δὲ ἡ μονὴ τῆς κινήσεως, ἀλλ᾿ ἡ κίνησις τῆς μονῆς, διότι οὐ δυνατὸν κινεῖσθαί τι ἄνευ μονῆς, οὐδὲ βαδίζειν τις δύναται ἐν τοῖς ψαμμώδεσι τόποις μὴ ἔχοντος τοῦ ποδός που μένειν καὶ ἐπερείδεσθαι·", "seq": 616}
{"id": "Elias_Passim_0617", "series": "CAG", "text": "πᾶσα γὰρ κίνησις περί τι μένον καὶ ἀκίνητον καταγίνεται, καὶ τὸ οὐράνιόν φασι σῶμα περὶ μένον κινεῖσθαι, φημὶ δὴ τὴν γῆν, ἥτις τῇ οἰκείᾳ φύσει ἀκίνητός ἐστιν.", "seq": 617}
{"id": "Elias_Passim_0618", "series": "CAG", "text": "Ἀποροῦσι δέ τινες ὅτι εἰ πάντα τὰ μαθήματα δεῖται τῆς τῶν μουσῶν ἐπιπνοίας, διὰ τί μία μόνη λέγεται μουσική.", "seq": 618}
{"id": "Elias_Passim_0619", "series": "CAG", "text": "πρὸς ὅ φαμεν ὅτι ταύτης μόνης ἔργον πάθη ψυχῆς ἰᾶσθαι καὶ σώματος·", "seq": 619}
{"id": "Elias_Passim_0620", "series": "CAG", "text": "διὸ καὶ ἡ φιλοσοφία μεγίστη μουσικὴ ὡς πάθη ψυχῆς ἰωμένη, ὅθεν καὶ ἰατρικὴ ψυχῶν λέγεται.", "seq": 620}
{"id": "Elias_Passim_0621", "series": "CAG", "text": "ὅτι δὲ ἰᾶται ψυχῶν πάθη ἡ μουσική, φασί ποτε τὸν Πυθαγόραν θεασάμενον παιδάριον ἑπόμενον κόρῃ αὐλούσῃ ἐπιτρέψαι αὐτῇ στρέψαι τοὺς αὐλούς, καὶ τοῦ μέλους διαφθαρέντος ἔπαυσεν αὐτὸν τοῦ ἐρᾶν.", "seq": 621}
{"id": "Elias_Passim_0622", "series": "CAG", "text": "ἀλλὰ καὶ μέχρι τῆς σήμερον ἔχομεν ἐπᾴσματα μουσικά·", "seq": 622}
{"id": "Elias_Passim_0623", "series": "CAG", "text": "ἀκούσαντες γὰρ θεατρικῶν μελῶν ἐκνενευρισμένοι γινόμεθα καὶ ἔκλυτοι, πολεμικῶν δὲ τοὐναντίον.", "seq": 623}
{"id": "Elias_Passim_0624", "series": "CAG", "text": "καὶ τὰ βοσκήματα δὲ τῇ τοιᾷδε σύριγγι πείθεται εἰς νομὴν ἐξιόντα καὶ πάλιν εἰς τοὺς σηκοὺς ἐπιστρέφοντα.", "seq": 624}
{"id": "Elias_Passim_0625", "series": "CAG", "text": "καὶ σάλπιγξ ἐν πολέμῳ τοὺς ἵππους παρορμᾷ καὶ διεγείρει.", "seq": 625}
{"id": "Elias_Passim_0626", "series": "CAG", "text": "ἀλλὰ καὶ τὸν Ἀγαμέμνονά φασι μέλλοντα ἐπιστρατεύειν τῇ Τροίᾳ μὴ πρότερον ἐξορμῆσαι, πρὶν ἀοιδόν τινα καταλιπεῖν φύλακα τῆς σωφροσύνης τῆς ἰδίας γυναικὸς Κλυταιμνήστρας.", "seq": 626}
{"id": "Elias_Passim_0627", "series": "CAG", "text": "ὅθεν ὁ Αἴγισθος ἐθέλων ἐθελούσῃ οὐκ ἠδυνήθη αὐτῇ συγγενέσθαι, πρὶν τὸν ἀοιδὸν διέφθειρεν ἔν τινι νήσῳ ἐρήμῃ καλουμένῃ.", "seq": 627}
{"id": "Elias_Passim_0628", "series": "CAG", "text": "καὶ τότε αὐτὴν ἀνήγαγεν εἰς τὸν ἑαυτοῦ οἶκον, ὡς δηλοῖ τὰ Ὁμηρικὰ ἔπη.", "seq": 628}
{"id": "Elias_Passim_0629", "series": "CAG", "text": "καὶ Συνέσιος δὲ ὁ φιλόσοφος ὁ γενόμενος ὕστερον Κυρήνης ἐπίσκοπος βαρβάρων ἐπιστάντων τῇ Κυρήνῃ διά τινων μελῶν ἔτρεψε τούτους, καὶ φεύγοντες ἔκοπτον ἀλλήλους μηδενὸς διώκοντος.", "seq": 629}
{"id": "Elias_Passim_0630", "series": "CAG", "text": "Πρᾶξις ιβ΄.", "seq": 630}
{"id": "Elias_Passim_0631", "series": "CAG", "text": "Λεκτέον τὴν διαίρεσιν τοῦ πρακτικοῦ·", "seq": 631}
{"id": "Elias_Passim_0632", "series": "CAG", "text": "τοῦτο γὰρ μόνον λείπει τῇ διαιρέσει.", "seq": 632}
{"id": "Elias_Passim_0633", "series": "CAG", "text": "διαιρεῖ τοίνυν τοῦτο ὁ Ἀριστοτέλης εἰς τρία, εἰς ἠθικόν, οἰκονομικόν, πολιτικόν·", "seq": 633}
{"id": "Elias_Passim_0634", "series": "CAG", "text": "ὁ γὰρ πρακτικὸς φιλόσοφος ἀνθρωπείας ψυχὰς κοσμεῖν ἐπαγγελλόμενος ἢ ἀφ᾿ ἑαυτοῦ ἄρχεται τοῦ κόσμου καὶ λέγεται ἠθικός (γελοῖος γὰρ εἴη, εἰ ἄλλους ἐπαγγέλλοιτο κοσμεῖν αὐτὸς ἄκοσμος ὤν), ἢ ὀλίγους κοσμεῖ καὶ λέγεται οἰκονομικός, ἢ πολλοὺς καὶ λέγεται πολιτικός.", "seq": 634}
{"id": "Elias_Passim_0635", "series": "CAG", "text": "Ἐγκαλοῦσι δὲ οἱ Πλατωνικοὶ τῇ τοιαύτῃ διαιρέσει τέσσαρα ἐγκλήματα·", "seq": 635}
{"id": "Elias_Passim_0636", "series": "CAG", "text": "πρῶτον ὅτι ἐν οὐδεμιᾷ διαιρέσει τὸ γένος ἑνὶ εἴδει ἑαυτοῦ πάντῃ ταὐτόν ἐστιν·", "seq": 636}
{"id": "Elias_Passim_0637", "series": "CAG", "text": "οἷον τὸ ζῷον διαιρεῖται εἰς λογικὸν καὶ ἄλογον, καὶ οὐ πάντῃ ταὐτόν ἐστι τὸ ζῷον τῷ λογικῷ, ἐπεὶ πῶς ἑαυτὸ τῷ ἀλόγῳ παράσχοι;", "seq": 637}
{"id": "Elias_Passim_0638", "series": "CAG", "text": "ἐνταῦθα δὲ ταὐτὸν τὸ πρακτικὸν τῷ πολιτικῷ·", "seq": 638}
{"id": "Elias_Passim_0639", "series": "CAG", "text": "καὶ ὁ πρακτικὸς γὰρ ἢ ἕνα κοσμεῖ ἢ ὀλίγους ἢ πολλούς, καὶ ὁ πολιτικὸς ὁμοίως ἢ ἕνα ἢ ὀλίγους ἢ πολλοὺς κοσμεῖ.", "seq": 639}
{"id": "Elias_Passim_0640", "series": "CAG", "text": "δεύτερον ἔγκλημα, ὅτι ἐν οὐδεμιᾷ διαιρέσει τὰ εἴδη περιέχει ἄλληλα·", "seq": 640}
{"id": "Elias_Passim_0641", "series": "CAG", "text": "αἱ γὰρ διαιρέσεις διακρίσεως χάριν ἐπενοήθησαν·", "seq": 641}
{"id": "Elias_Passim_0642", "series": "CAG", "text": "ἐπὰν οὖν τὸ ἕτερον ὑπὸ τοῦ ἑτέρου περιέχηται, οὐκ ἔστι διαίρεσις·", "seq": 642}
{"id": "Elias_Passim_0643", "series": "CAG", "text": "οἷον οὐδεὶς διαιρεῖ τὸν Σωκράτην εἰς χεῖρας καὶ δακτύλους (περιέχει γὰρ ἡ χεὶρ τοὺς δακτύλους), πάλιν οὐδεὶς διαιρεῖ τὸ ζῷον εἰς ἄνθρωπον καὶ Σωκράτην (ὁ γὰρ ἄνθρωπος περιέχει τὸν Σωκράτην), ἀλλὰ διαιρεῖ τὸ ζῷον εἰς ἄνθρωπον καὶ βοῦν, καὶ τὸν ἄνθρωπον εἰς χεῖρας καὶ πόδας, ἃ οὐ περιέχουσιν ἄλληλα.", "seq": 643}
{"id": "Elias_Passim_0644", "series": "CAG", "text": "ἐνταῦθα δὲ περιέχουσιν ἄλληλα τὰ εἴδη·", "seq": 644}
{"id": "Elias_Passim_0645", "series": "CAG", "text": "τὸ γὰρ ἠθικὸν περιέχεται ὑπὸ τοῦ οἰκονομικοῦ καὶ τὸ οἰκονομικὸν ὑπὸ τοῦ πολιτικοῦ, ἐπειδὴ καὶ τὸ ἓν ὑπὸ τῶν ὀλίγων περιέχεται καὶ τὰ ὀλίγα ὑπὸ τῶν πολλῶν, καὶ εἴπερ πᾶσα ἡ πόλις κεκόσμηται, δῆλον ὅτι καὶ οἱ ἐν τῷ οἴκῳ, καὶ εἰ οἱ ἐν τῷ οἴκῳ, δῆλον ὅτι καὶ ὁ καθ᾿ ἕκαστον τῶν ἐν τῷ οἴκῳ.", "seq": 645}
{"id": "Elias_Passim_0646", "series": "CAG", "text": "τρίτον ἔγκλημα, ὅτι οὐκ ἀεὶ ὁ ὀλίγους κοσμῶν λέγεται οἰκονομικός, ὁ δὲ πολλοὺς πολιτικός·", "seq": 646}
{"id": "Elias_Passim_0647", "series": "CAG", "text": "τί γὰρ ποιεῖ <ὁ> ἐπὶ τῶν οἴκων τῶν ἐχόντων πλείονας ἀνθρώπους τινῶν πόλεων;", "seq": 647}
{"id": "Elias_Passim_0648", "series": "CAG", "text": "ἔσται γὰρ τότε τὸ οἰκονομικὸν πολιτικὸν καὶ τὸ πολιτικὸν οἰκονομικόν.", "seq": 648}
{"id": "Elias_Passim_0649", "series": "CAG", "text": "τέταρτον ἔγκλημα, ὅτι εἰ δῶμεν ἀπὸ τοῦ ποσοῦ τῶν ὠφελουμένων τὰς ἕξεις διαιρεῖσθαι τῷ ἢ ἕνα ὠφελεῖν ἢ ὀλίγους ἢ πολλούς, λήσομεν οὕτως πᾶσαν τέχνην καὶ ἐπιστήμην διαιροῦντες·", "seq": 649}
{"id": "Elias_Passim_0650", "series": "CAG", "text": "πᾶσα γὰρ τέχνη καὶ ἐπιστήμη σκοπὸν ἔχει ἢ ἕνα ὠφελεῖν ἢ ὀλίγους ἢ πολλούς.", "seq": 650}
{"id": "Elias_Passim_0651", "series": "CAG", "text": "Ταύτην τὴν διαίρεσιν ὡς κακῶς ἔχουσαν ἀποσεισάμενοι οἱ Πλατωνικοὶ λέγουσιν ἑτέραν διαίρεσιν.", "seq": 651}
{"id": "Elias_Passim_0652", "series": "CAG", "text": "διαιροῦσι τοίνυν τὸ πρακτικὸν εἰς δύο, εἰς νομοθετικὸν καὶ δικαστικόν, διότι ὁ πρακτικὸς φιλόσοφος ἠθῶν ὢν ἐπανορθωτὴς καὶ νόμους τίθησι, καθ᾿ οὓς δεῖ ζῆν τοὺς εὖ βιώσοντας, καὶ ἐπιτίμια ὁρίζει, οἷς δεῖ ὑποπίπτειν τοὺς μὴ ἐμμείναντας τοῖς προεκτεθεῖσι νόμοις.", "seq": 652}
{"id": "Elias_Passim_0653", "series": "CAG", "text": "Ἀλλὰ πόθεν ὅτι Ἀριστοτέλους ἡ εἰς τρία διαίρεσις, πόθεν δὲ ὅτι Πλάτωνος ἡ εἰς δύο, πόθεν δὲ ὅτι οὐ προσίεται ὁ Πλάτων τὴν εἰς τρία τοῦ Ἀριστοτέλους διαίρεσιν;", "seq": 653}
{"id": "Elias_Passim_0654", "series": "CAG", "text": "Ἀριστοτέλους τοίνυν ἡ εἰς τρία διαίρεσις διὰ τὰς γεγραμμένας αὐτῷ τοιαύτας πραγματείας·", "seq": 654}
{"id": "Elias_Passim_0655", "series": "CAG", "text": "διὰ μὲν γὰρ τὸ ἠθικὸν γεγραμμένα αὐτῷ εἰσι τὰ Ἠθικὰ πρὸς Εὔδημον μαθητὴν καὶ ἄλλα πρὸς Νικόμαχον τὸν πατέρα, τὰ Μεγάλα Νικομάχεια, καὶ πρὸς Νικόμαχον τὸν υἱόν, τὰ Μικρὰ Νικομάχεια.", "seq": 655}
{"id": "Elias_Passim_0656", "series": "CAG", "text": "διὰ δὲ τὸ οἰκονομικὸν γέγραπται αὐτῷ ὁ Οἰκονομικὸς τὸ σύνταγμα, ἐν ᾧ φησιν ἐκ τεσσάρων σχέσεων συγκεκροτῆσθαι τὸν οἶκον, πατρὸς πρὸς τέκνα, ἀνδρὸς πρὸς γυναῖκα, δεσπότου πρὸς δούλους, εἰσιόντων πρὸς ἐξιόντα, ἵνα μήτε πλείονα τὰ εἰσιόντα τῶν ἐξιόντων (φειδωλία γὰρ τοῦτο καὶ ἀνελευθερία) μήτε πλείονα τὰ ἐξιόντα τῶν εἰσιόντων (ἀσωτία γὰρ τοῦτο), ἀλλ᾿ ἐπίσης.", "seq": 656}
{"id": "Elias_Passim_0657", "series": "CAG", "text": "διὰ δὲ τὸ πολιτικὸν γέγραπται αὐτῷ ὁ Πολιτικός.", "seq": 657}
{"id": "Elias_Passim_0658", "series": "CAG", "text": "γεγραμμέναι δὲ αὐτῷ εἰσι καὶ Πολιτεῖαι, διακόσιαι πεντήκοντα τὸν ἀριθμόν, ἃς συνεγράψατο ἐκ τοῦ πολλὴν γῆν συμπεριελθεῖν Ἀλεξάνδρῳ τῷ βασιλεῖ.", "seq": 658}
{"id": "Elias_Passim_0659", "series": "CAG", "text": "Ἀλλὰ καὶ Πλάτωνος ἡ εἰς δύο διαίρεσις·", "seq": 659}
{"id": "Elias_Passim_0660", "series": "CAG", "text": "διὰ μὲν γὰρ τὸ νομοθετικὸν γεγραμμένοι εἰσὶν αὐτῷ Νόμοι ἐν δεκαδύο διαλόγοις, διὰ δὲ τὸ δικαστικὸν γεγραμμέναι εἰσὶν αὐτῷ τρεῖς νεκυΐαι, ἡ ἐν Γοργίᾳ (ἐκεῖ γὰρ διαλέγεται περὶ τῶν δικαστῶν, Μίνωος καὶ Ῥαδαμάνθυος καὶ Αἰακοῦ), καὶ ἡ ἐν Φαίδωνι (ἐκεῖ γὰρ λέγει περὶ τῶν δικαστικῶν τόπων, Κωκυτοῦ, Ταρτάρου, Πυριφλεγέθοντος καὶ Ἀχέροντος), καὶ ἡ ἐν τῷ δεκάτῳ τῆς Πολιτείας·", "seq": 660}
{"id": "Elias_Passim_0661", "series": "CAG", "text": "ἐκεῖ γὰρ διαλέγεται περὶ τῶν δικαζομένων ψυχῶν·", "seq": 661}
{"id": "Elias_Passim_0662", "series": "CAG", "text": "εἰσάγει γὰρ ἐκεῖ ἥρωά τινα πολλὰ πλημμελήσαντα καὶ δίκας διδόντα τῶν πραχθέντων αὐτῷ.", "seq": 662}
{"id": "Elias_Passim_0663", "series": "CAG", "text": "ἀλλὰ πόθεν ὅτι οὐ προσίεται ὁ Πλάτων τὴν εἰς τρία τοῦ Ἀριστοτέλους διαίρεσιν;", "seq": 663}
{"id": "Elias_Passim_0664", "series": "CAG", "text": "τοῦτο οὖν δείκνυμεν ἐκ διαφόρων·", "seq": 664}
{"id": "Elias_Passim_0665", "series": "CAG", "text": "ἐν μὲν γὰρ τῷ Γοργίᾳ λέγει ὅτι ‘ἥπερ πόλει, καὶ ἰδιώτῃ, αὐτῷ πρὸς ἑαυτὸν καὶ πρὸς ἑτέρους’ ἀντὶ τοῦ ‘μία ἕξις ἠθική, οἰκονομική, πολιτική’·", "seq": 665}
{"id": "Elias_Passim_0666", "series": "CAG", "text": "διὰ μὲν γὰρ τοῦ εἰπεῖν ‘ἥπερ πόλει’ τὸ πολιτικὸν ἐσήμανεν, διὰ δὲ τοῦ εἰπεῖν ‘αὐτῷ πρὸς ἑαυτόν’ τὸ ἠθικόν, διὰ δὲ τοῦ εἰπεῖν ‘καὶ πρὸς ἑτέρους’ τὸ οἰκονομικόν.", "seq": 666}
{"id": "Elias_Passim_0667", "series": "CAG", "text": "βούλεται οὖν δεῖξαι ὅτι ἐὰν ἡ πόλις πᾶσα κακῶς βιοῖ, τοῦτ᾿ ἔστι τὸ πολιτικόν, καὶ ὁ ἰδιώτης κακῶς βιώσει, τοῦτ᾿ ἔστι τὸ ἠθικόν, καὶ διὰ τοῦτο εἴρηκε τὸ ‘ἥπερ πόλει, καὶ ἰδιώτῃ’.", "seq": 667}
{"id": "Elias_Passim_0668", "series": "CAG", "text": "τὸ δὲ ‘αὐτῷ πρὸς ἑαυτὸν καὶ πρὸς ἑτέρους’ δηλοῖ τοὺς ὀλίγους, ταὐτὸν δὲ λέγειν τὸ οἰκονομικόν.", "seq": 668}
{"id": "Elias_Passim_0669", "series": "CAG", "text": "ἐν δὲ τῷ Ἀλκιβιάδῃ φησὶν ὅτι ‘ὁ ἕνα πείθων καὶ ὀλίγους καὶ πολλοὺς πείθει, καὶ τοῦ αὐτοῦ ἕνα πείθειν καὶ πολλούς’.", "seq": 669}
{"id": "Elias_Passim_0670", "series": "CAG", "text": "ἀλλ᾿ οὐκ ἀνάγκη, φησί τις, τὸν πείθοντα πολλοὺς καὶ ἕνα πείθειν, ἐὰν ᾖ ἰδιώτης ὁ εἷς.", "seq": 670}
{"id": "Elias_Passim_0671", "series": "CAG", "text": "καὶ λέγομεν ὅτι ἐὰν ᾖ τοιοῦτος οἷοι οἱ πολλοί, τότε πείθεται.", "seq": 671}
{"id": "Elias_Passim_0672", "series": "CAG", "text": "καὶ πάλιν ἐν ἄλλῳ διαλόγῳ φησὶν ὁ Πλάτων ὅτι ‘οὐδὲν διαφέρει ἡ ἐν μιᾷ πόλει δικαιοσύνη τῆς ἐν μιᾷ ψυχῇ, εἰ μὴ ὃ διαφέρει τὰ μικρὰ γράμματα τῶν μεγάλων’.", "seq": 672}
{"id": "Elias_Passim_0673", "series": "CAG", "text": "καὶ ταῦτα μὲν περὶ τούτων.", "seq": 673}
{"id": "Elias_Passim_0674", "series": "CAG", "text": "Φέρε δὲ ἡμεῖς εἴπωμεν ὑπὲρ Ἀριστοτέλους ὅτι κἂν συνεγράψατο ἠθικὰ ἢ πολιτικά, οὐ διαιρεῖ εἰς ταῦτα τὸ πρακτικόν, ἀλλ᾿ οἶδεν ὅτι τὸ νομοθετικὸν καὶ δικαστικὸν διήκει δι᾿ αὐτῶν, ἐπεὶ τοῖς αὐτοῖς ἀτόποις περιπεσοῦνται καὶ οἱ γραμματισταί·", "seq": 674}
{"id": "Elias_Passim_0675", "series": "CAG", "text": "ἐπειδὴ γὰρ διαλέγονται περὶ γραμμάτων, συλλαβῶν καὶ λέξεων, μὴ νομίσῃς ὅτι εἰς τρία τὸ ἐκφωνούμενον διαιροῦσιν, αὐτὸ τοῦτο τί ἐστι διαίρεσις μὴ ἐπιστάμενοι.", "seq": 675}
{"id": "Elias_Passim_0676", "series": "CAG", "text": "ἐπίσταται δὲ καὶ τὴν εἰς τὸ νομοθετικὸν καὶ δικαστικὸν διαίρεσιν ὁ Ἀριστοτέλης, εἴπερ ἔστι καὶ ἑαυτῷ νομοθετεῖν καὶ δικάζειν·", "seq": 676}
{"id": "Elias_Passim_0677", "series": "CAG", "text": "νομοθετεῖν μέν, ὡς ἡνίκα ἐπᾴδωμεν ἑαυτοῖς τὰ τῷ ὄντι χρυσᾶ ἔπη Πυθαγόρου, τὸ", "seq": 677}
{"id": "Elias_Passim_0678", "series": "CAG", "text": "πάντων δὲ μάλιστ᾿ αἰσχύνεο σαυτόν·", "seq": 678}
{"id": "Elias_Passim_0679", "series": "CAG", "text": "τοῦτο γὰρ νόμος καὶ κρηπὶς ἀσφαλὴς ἀρίστου βίου·", "seq": 679}
{"id": "Elias_Passim_0680", "series": "CAG", "text": "ὁ γὰρ διὰ τὴν πρὸς ἄλλον αἰδῶ τῶν ἀνηκέστων φειδόμενος λήσας ἐκεῖνον ἴσως μειζόνως ταῦτα διαπράξεται, ὁ δὲ διὰ τὴν πρὸς ἑαυτὸν αἰδῶ τούτων φειδόμενος οὐδέποτε πράξει κακὸν ἀναπόστατον ἑαυτὸν ἑαυτοῦ περιφέρων μάρτυρα.", "seq": 680}
{"id": "Elias_Passim_0681", "series": "CAG", "text": "καὶ δικάζειν δὲ ἔστιν ἑαυτῷ, ὡς ἡνίκα πάλιν ἐπᾴδωμεν ἑαυτοῖς τὰ αὐτὰ χρυσᾶ ἔπη·", "seq": 681}
{"id": "Elias_Passim_0682", "series": "CAG", "text": "μηδ᾿ ὕπνον μαλακοῖσιν ἐπ᾿ ὄμμασι προσδέξασθαι, πρὶν τῶν ἡμερινῶν ἔργων τρὶς ἕκαστον ἐπελθεῖν·", "seq": 682}
{"id": "Elias_Passim_0683", "series": "CAG", "text": "πῇ παρέβην;", "seq": 683}
{"id": "Elias_Passim_0684", "series": "CAG", "text": "τί δ᾿ ἔρεξα;", "seq": 684}
{"id": "Elias_Passim_0685", "series": "CAG", "text": "τί μοι δέον οὐκ ἐτελέσθη;", "seq": 685}
{"id": "Elias_Passim_0686", "series": "CAG", "text": "αἰσχρὰ μὲν ἐκπρήξας ἐπιπλήσσεο, ἐσθλὰ δὲ τέρπου.", "seq": 686}
{"id": "Elias_Passim_0687", "series": "CAG", "text": "ἀλλὰ καὶ οἴκῳ ἔστι νομοθετεῖν καὶ δικάζειν·", "seq": 687}
{"id": "Elias_Passim_0688", "series": "CAG", "text": "νομοθέτης γὰρ καὶ δικαστὴς ὁ κύριος τῆς οἰκίας τοὺς μὲν πειθομένους τοῖς αὑτοῦ λόγοις ἐκτρέφων, τοὺς δὲ μὴ πειθομένους ἐκβάλλων.", "seq": 688}
{"id": "Elias_Passim_0689", "series": "CAG", "text": "ἀλλὰ καὶ πόλει ἔστι νομοθετεῖν καὶ δικάζειν·", "seq": 689}
{"id": "Elias_Passim_0690", "series": "CAG", "text": "ποῦ γὰρ οἰκειότερον ταῦτα πραχθείη ἢ ἐν πόλει;", "seq": 690}
{"id": "Elias_Passim_0691", "series": "CAG", "text": "Προλεγόμενα τῆς Εἰσαγωγῆς Πορφυρίου.", "seq": 691}
{"id": "Elias_Passim_0692", "series": "CAG", "text": "Πρᾶξις ιγ΄.", "seq": 692}
{"id": "Elias_Passim_0693", "series": "CAG", "text": "Ἐπειδὴ ὅλην ὡς ὅλην ἔγνωμεν τὴν φιλοσοφίαν διὰ τῶν ἓξ ὁρισμῶν καὶ ὡς μέρη ἔχουσαν αὐτὴν διὰ τῶν διαιρέσεων, φέρε καὶ τοῦ παρόντος βιβλίου φροντίδα ποιησώμεθα τὰ εἰωθότα ὀκτὼ τὸν ἀριθμὸν ὄντα, τὸν σκοπόν, τὸ χρήσιμον, τὴν τάξιν, τὴν ἐπιγραφήν, τὸ γνήσιον, τὴν εἰς τὰ κεφάλαια τοῦ βιβλίου διαίρεσιν, τὸν τρόπον τὸν διδασκαλικόν, καὶ ὑπὸ ποῖον μέρος ἢ μόριον τῆς φιλοσοφίας ἀνάγεται τὸ βιβλίον, ἃ καὶ κεφάλαια εἴρηται ὡς ἐκ μεταφορᾶς τῆς ἐν τοῖς ζῴοις κεφαλῆς·", "seq": 693}
{"id": "Elias_Passim_0694", "series": "CAG", "text": "ὥσπερ γὰρ ἐκείνη ἐν βραχεῖ τὴν δύναμιν πᾶσαν τοῦ ζῴου περιέχει, οἰκητήριον οὖσα τῶν πέντε αἰσθήσεων, οὕτως καὶ ταῦτα ἐν βραχεῖ τὸ βούλημα παριστῶσι τῶν λεγομένων·", "seq": 694}
{"id": "Elias_Passim_0695", "series": "CAG", "text": "διὸ καὶ παρὰ τοῖς ῥήτορσι τὸ ‘ὡς ἐν κεφαλαίῳ’ εἴρηται ἀντὶ τοῦ ‘ἐν βραχεῖ πολλὰ περιλαβεῖν’.", "seq": 695}
{"id": "Elias_Passim_0696", "series": "CAG", "text": "Σκοπὸν τοίνυν ἔχει ὁ Πορφύριος ἐνταῦθα πάσας τὰς κατὰ φιλοσοφίαν φωνὰς ὑπὸ πέντε ἀρχὰς καὶ κοινότητας ἀναγαγεῖν, καὶ δεῖξαι ὅτι πᾶσα φιλόσοφος φωνὴ ἢ γένος ἐστὶν ἢ διαφορὰ ἢ εἶδος ἢ ἴδιον ἢ συμβεβηκός, καὶ ἕκτη παρὰ ταύτας οὐδὲ ἐπινοηθῆναι δύναται.", "seq": 696}
{"id": "Elias_Passim_0697", "series": "CAG", "text": "τοῦτο δὲ καὶ ἐκ διαιρέσεως δείκνυσιν, ἣν αἰνίττεται ἐν τῷ περὶ γένους λόγῳ.", "seq": 697}
{"id": "Elias_Passim_0698", "series": "CAG", "text": "ἔχει δὲ οὕτως·", "seq": 698}
{"id": "Elias_Passim_0699", "series": "CAG", "text": "ἡ φωνὴ ἢ σημαντική ἐστιν ἢ ἄσημος.", "seq": 699}
{"id": "Elias_Passim_0700", "series": "CAG", "text": "ἀλλ᾿ αἱ μὲν ἄσημοι χαιρέτωσαν·", "seq": 700}
{"id": "Elias_Passim_0701", "series": "CAG", "text": "γραμματικοῖς αὗται μελήσουσιν, παρ᾿ οἷς οὐδὲν διαφέρει τὸ Ὅμηρος τοῦ σκινδαψός [σκινδαψοῦ]·", "seq": 701}
{"id": "Elias_Passim_0702", "series": "CAG", "text": "φιλοσόφοις δέ, οἷς σημαινομένων καὶ μόνον ἐστὶ φροντίς, πολλὴν διαφορὰν εἰσάγει τὸ σημαίνειν ἢ μὴ σημαίνειν·", "seq": 702}
{"id": "Elias_Passim_0703", "series": "CAG", "text": "εἰ γὰρ μὴ σημαίνει, οὐδὲ διαλέγονται περὶ αὐτῶν·", "seq": 703}
{"id": "Elias_Passim_0704", "series": "CAG", "text": "εἰ γὰρ ἦν τὰ πράγματα διδάξαι χωρὶς φωνῶν, οὐκ ἄν ποτε φωναῖς ἐχρήσαντο.", "seq": 704}
{"id": "Elias_Passim_0705", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ τοῦτο ἀδύνατον (χωρὶς γὰρ φωνῶν οὐ διδάσκεται πρᾶγμα), ἐξ ἀνάγκης διαλέγονται καὶ περὶ φωνῶν.", "seq": 705}
{"id": "Elias_Passim_0706", "series": "CAG", "text": "τῶν δὲ σημαντικῶν αἱ μὲν καθόλου, αἱ δὲ μερικαί.", "seq": 706}
{"id": "Elias_Passim_0707", "series": "CAG", "text": "ἀλλὰ καὶ αἱ μερικαὶ μετὰ τῶν ἀσήμων ἐκβαλέσθωσαν·", "seq": 707}
{"id": "Elias_Passim_0708", "series": "CAG", "text": "ποιηταῖς γὰρ αὗται μελήσουσι καὶ ῥήτορσι, τοῖς μὲν διὰ τὰς ἱστορίας, τοῖς δὲ διὰ τὸν φεύγοντα καὶ τὸν διώκοντα.", "seq": 708}
{"id": "Elias_Passim_0709", "series": "CAG", "text": "Τῶν δὲ καθόλου αἱ μὲν οὐσιώδεις εἰσίν, αἱ δὲ ἐπεισοδιώδεις.", "seq": 709}
{"id": "Elias_Passim_0710", "series": "CAG", "text": "ἐκεῖνα δὲ λέγεται οὐσιώδη, ὅσα καὶ παρόντα σώζουσι καὶ ἀπόντα φθείρουσιν·", "seq": 710}
{"id": "Elias_Passim_0711", "series": "CAG", "text": "οἷον τὸ λογικὸν τῷ ἀνθρώπῳ οὐσιωδῶς ὑπάρχει (καὶ παρὸν γὰρ σώζει αὐτὸν καὶ ἀπὸν φθείρει), ὁμοίως καὶ ἡ θερμότης τῷ πυρὶ καὶ ἡ ψυχρότης τῇ χιόνι.", "seq": 711}
{"id": "Elias_Passim_0712", "series": "CAG", "text": "ἐπεισοδιώδη δὲ λέγεται ὅσα τοὐναντίον μήτε παρόντα σώζει μήτε ἀπόντα φθείρει·", "seq": 712}
{"id": "Elias_Passim_0713", "series": "CAG", "text": "τὸ γὰρ λευκὸν τῷ ἀνθρώπῳ ἐπεισοδιωδῶς ὑπάρχει·", "seq": 713}
{"id": "Elias_Passim_0714", "series": "CAG", "text": "οὔτε γὰρ παρὸν σώζει αὐτὸν οὔτε ἀπὸν φθείρει.", "seq": 714}
{"id": "Elias_Passim_0715", "series": "CAG", "text": "τὰ μὲν οὖν οὐσιώδη ἢ ὕπαρξιν δηλοῦσιν ἢ τρόπον ὑπάρξεως·", "seq": 715}
{"id": "Elias_Passim_0716", "series": "CAG", "text": "καὶ εἰ μὲν τρόπον ὑπάρξεως, ποιεῖ τὴν διαφορὰν οἷον τὸ λογικόν (τοῦτο γὰρ τοιόνδε ποιεῖ τὸ ζῷον), εἰ δὲ ὕπαρξιν δηλοῖ, ἢ εὐθέως εἰς τὰ ἄτομα διαιρεῖται, Σωκράτην φημὶ καὶ Πλάτωνα καὶ Ἀλκιβιάδην, καὶ λέγεται τὸ διαιρούμενον εἶδος, ἢ πρῶτον εἰς τὰ εἴδη διαιρεῖται, εἶτα διὰ τῶν εἰδῶν εἰς τὰ ἄτομα, καὶ λέγεται γένος τὸ διαιρούμενον.", "seq": 716}
{"id": "Elias_Passim_0717", "series": "CAG", "text": "τὰ δὲ ἐπεισοδιώδη ἢ μιᾷ μόνῃ φύσει ὑπάρχουσι καὶ λέγονται ἴδια, ὡς τὸ γελαστικὸν τῷ ἀνθρώπῳ, τὸ χρεμετιστικὸν τῷ ἵππῳ, τὸ ὑλακτικὸν τῷ κυνί, ἢ πολλαῖς καὶ λέγονται συμβεβηκότα, ὡς τὸ λευκὸν οὐ μόνον ἀνθρώπῳ ὑπάρχει ἀλλὰ καὶ ἵππῳ καὶ βοῒ καὶ ἀψύχοις.", "seq": 717}
{"id": "Elias_Passim_0718", "series": "CAG", "text": "ἢ καὶ ἄλλως·", "seq": 718}
{"id": "Elias_Passim_0719", "series": "CAG", "text": "πᾶσα φωνὴ ἢ σημαντικὴ ἢ ἄσημος·", "seq": 719}
{"id": "Elias_Passim_0720", "series": "CAG", "text": "καὶ εἰ μὲν σημαντική, ἢ καθόλου ἢ μερική.", "seq": 720}
{"id": "Elias_Passim_0721", "series": "CAG", "text": "τῆς δὲ καθόλου τὰ μὲν οὐσιώδη, τὰ δὲ ἐπεισοδιώδη.", "seq": 721}
{"id": "Elias_Passim_0722", "series": "CAG", "text": "τὰ μὲν οὖν οὐσιώδη ἢ κατὰ διαφερόντων τῷ εἴδει καὶ ἢ ἐν τῷ τί ἐστι κατηγορεῖται καὶ ποιεῖ τὸ γένος, ἢ ἐν τῷ ποῖόν τί ἐστι καὶ ποιεῖ τὴν διαφοράν, ἢ κατὰ διαφερόντων τῷ ἀριθμῷ ἐν τῷ τί ἐστι κατηγορεῖται καὶ ποιεῖ τὸ εἶδος.", "seq": 722}
{"id": "Elias_Passim_0723", "series": "CAG", "text": "τὰ δὲ ἐπεισοδιώδη ἢ ἀντιστρέφει καὶ ποιεῖ τὸ ἴδιον, ὡς τὸ γελαστικόν (πᾶν γὰρ γελαστικὸν ἄνθρωπος καὶ πᾶς ἄνθρωπος γελαστικόν), ἢ οὐκ ἀντιστρέφει καὶ ποιεῖ τὸ συμβεβηκός, οἷον τὸ λευκόν·", "seq": 723}
{"id": "Elias_Passim_0724", "series": "CAG", "text": "οὐδὲ γὰρ ἀντιστρέφει τὸ λευκὸν πρὸς τὸν ἄνθρωπον·", "seq": 724}
{"id": "Elias_Passim_0725", "series": "CAG", "text": "οὐδὲ γὰρ εἴ τι λευκόν, ἐκεῖνο καὶ ἄνθρωπος, οὐδὲ εἴ τι ἄνθρωπος, τοῦτο λευκόν·", "seq": 725}
{"id": "Elias_Passim_0726", "series": "CAG", "text": "ὁ γὰρ Αἰθίοψ ἄνθρωπός ἐστι καὶ οὐ λευκόν.", "seq": 726}
{"id": "Elias_Passim_0727", "series": "CAG", "text": "Πρᾶξις ιδ΄.", "seq": 727}
{"id": "Elias_Passim_0728", "series": "CAG", "text": "Μετὰ τὸ πρῶτον κεφάλαιον εἴπωμεν καὶ τὸ δεύτερον, φημὶ τὸ χρήσιμον.", "seq": 728}
{"id": "Elias_Passim_0729", "series": "CAG", "text": "χρησιμεύει τοίνυν τὸ παρὸν βιβλίον εἰς τὴν ἡμῶν αὐτῶν οὐσίαν, εἰς πᾶσαν φιλοσοφίαν, εἰς τὰς διαλεκτικὰς μεθόδους, εἰς τὰς Ἀριστοτέλους καὶ τῶν ἄλλων Κατηγορίας·", "seq": 729}
{"id": "Elias_Passim_0730", "series": "CAG", "text": "οὗτοι γὰρ κατὰ ζῆλον τοῦ οἰκείου διδασκάλου ὁμώνυμα συγγράμματα τούτῳ κατέλιπον.", "seq": 730}
{"id": "Elias_Passim_0731", "series": "CAG", "text": "χρησιμεύει οὖν ἡμῖν εἰς τὴν ἡμῶν αὐτῶν οὐσίαν, ἐπειδὴ κοινωνικὸν ζῷον ὁ ἄνθρωπος·", "seq": 731}
{"id": "Elias_Passim_0732", "series": "CAG", "text": "ἀμέλει καὶ ἐν ταῖς ἠρεμίαις ἀσχάλλομεν ὡς παρὰ φύσιν ζῶντες καὶ μὴ ἔχοντες ὅτῳ κοινωνήσομεν.", "seq": 732}
{"id": "Elias_Passim_0733", "series": "CAG", "text": "κοινωνοῦμεν δὲ ἀλλήλοις διὰ φωνῶν, ὅθεν καὶ φωνὴ εἴρηται ὡς εἰς φῶς ἄγουσα τὰ τοῦ νοῦ γεννήματα, διὸ καὶ φὼς μόνος ὁ ἄνθρωπος λέγεται ὡς πολὺ τὸ φωτιστικὸν ἔχων καὶ ἐξαγγελτικόν·", "seq": 733}
{"id": "Elias_Passim_0734", "series": "CAG", "text": "οὗτος γὰρ καὶ τὰ γνωστικὰ ἑαυτοῦ πάθη ἐξαγγέλλει διὰ τῆς φωνῆς τῆς ἐνάρθρου καὶ τὰ ζωτικὰ διὰ τῆς ἀνάρθρου, οἷον βηχὸς συρίγματος στεναγμοῦ, τὰ δὲ ἄλογα διὰ τῶν ἀνάρθρων μόνον τὰ ζωτικὰ ἡμῖν ἐμφαίνει.", "seq": 734}
{"id": "Elias_Passim_0735", "series": "CAG", "text": "εἰ οὖν περὶ φωνῶν διαλέγεται, πῶς οὐ χρησιμεύει ἡμῖν εἰς τὴν ἡμῶν αὐτῶν οὐσίαν;", "seq": 735}
{"id": "Elias_Passim_0736", "series": "CAG", "text": "ἀλλὰ καὶ εἰς πᾶσαν φιλοσοφίαν, εἴ γε πᾶσαν φιλόσοφον φωνὴν ἐνταῦθα διδασκόμεθα.", "seq": 736}
{"id": "Elias_Passim_0737", "series": "CAG", "text": "ἀλλὰ καὶ εἰς τὰς διαλεκτικὰς μεθόδους·", "seq": 737}
{"id": "Elias_Passim_0738", "series": "CAG", "text": "τέσσαρες γὰρ αὗται, διαιρετική, ὁριστική, ἀποδεικτική, ἀναλυτική, ἐπειδὴ καὶ τέσσαρα τὰ διαλεκτικὰ προβλήματα, εἰ ἔστι, τί ἐστιν, ὁποῖόν τί ἐστι καὶ διὰ τί ἐστι.", "seq": 738}
{"id": "Elias_Passim_0739", "series": "CAG", "text": "καὶ τὸ μὲν εἰ ἔστιν ἀναλογεῖ τῇ διαιρετικῇ (εἰ γὰρ ἔστι πάντως ὑπὸ τὴν διαίρεσιν πίπτει), τὸ δὲ τί ἐστι τῇ ὁριστικῇ *** (πᾶσαι γὰρ αἱ ἀποδείξεις τοῦ ὁποῖόν τί ἐστι·", "seq": 739}
{"id": "Elias_Passim_0740", "series": "CAG", "text": "σπανίως γὰρ ἀμφιβάλλεται τὸ εἴ ἐστι καὶ ὁρισμοῦ ἀπόδειξις οὐκ ἔστι), τὸ δὲ διὰ τί ἐστιν ἀναλογεῖ τῇ ἀναλυτικῇ·", "seq": 740}
{"id": "Elias_Passim_0741", "series": "CAG", "text": "ἑκατέρα γὰρ αὐτῶν αἰτίας εὕρεσίς ἐστι.", "seq": 741}
{"id": "Elias_Passim_0742", "series": "CAG", "text": "καὶ τοσαύτη ἐστὶν ἡ δύναμις τῆς ἀναλυτικῆς, ὡς ἰσχύειν πάσαις ἀντιτάσσεσθαι·", "seq": 742}
{"id": "Elias_Passim_0743", "series": "CAG", "text": "τῇ μὲν ὁριστικῇ, ὅτι ἐκείνης τὰ πολλὰ ἓν ποιούσης αὕτη τὸ ἓν πολλὰ ποιεῖ, τῇ δὲ διαιρετικῇ, ὅτι τῆς διαιρετικῆς τὸ ἓν πολλὰ ποιούσης καὶ αὕτη τὸ αὐτὸ ποιεῖ.", "seq": 743}
{"id": "Elias_Passim_0744", "series": "CAG", "text": "ἀλλὰ καὶ τῇ ἀποδεικτικῇ·", "seq": 744}
{"id": "Elias_Passim_0745", "series": "CAG", "text": "τῆς γὰρ ἀποδεικτικῆς ἀπὸ αἰτίων καὶ πρώτων ἀρχομένης αὕτη ἀπὸ τῶν αἰτιατῶν καὶ δευτέρων ἄρχεται·", "seq": 745}
{"id": "Elias_Passim_0746", "series": "CAG", "text": "οὐδὲν γάρ ἐστιν ἀνάλυσις, εἰ μὴ ἀπόδειξις ἀντεστραμμένη, ὅθεν καὶ ἀνάλυσις ὡς ἀνάπαλιν λύσις οὖσα τοῦ προκειμένου.", "seq": 746}
{"id": "Elias_Passim_0747", "series": "CAG", "text": "Ἴδιον δὲ τῆς μὲν διαιρετικῆς τὸ ἓν πολλὰ ποιεῖν, οἷον τὸ ζῷον διελεῖν εἰς λογικὸν καὶ ἄλογον, θνητὸν καὶ ἀθάνατον.", "seq": 747}
{"id": "Elias_Passim_0748", "series": "CAG", "text": "τῆς δὲ ὁριστικῆς τοὐναντίον τὰ πολλὰ ἓν ποιεῖν, τοῦτ᾿ ἔστι λαβεῖν τὸ ζῷον, τὸ λογικόν, τὸ θνητὸν καὶ ὁρίσασθαι τὸν ἄνθρωπον.", "seq": 748}
{"id": "Elias_Passim_0749", "series": "CAG", "text": "ἴδιον δὲ τῆς ἀποδεικτικῆς τὸ δεῖξαι ἄλλο ἄλλῳ ὑπάρχον δι᾿ ἄλλου μέσου·", "seq": 749}
{"id": "Elias_Passim_0750", "series": "CAG", "text": "οἷον θέλοντες δεῖξαι ὅτι τὸ ἔμψυχον ὑπάρχει τῷ ἀνθρώπῳ παραλαμβάνομεν μέσον τὸ ζῷον καὶ συλλογιζόμεθα οὕτως·", "seq": 750}
{"id": "Elias_Passim_0751", "series": "CAG", "text": "ἐὰν τὸ ἔμψυχον ὑπάρχῃ τῷ ζῴῳ, τὸ δὲ ζῷον τῷ ἀνθρώπῳ, πᾶσα ἀνάγκη καὶ τὸ ἔμψυχον ὑπάρχειν τῷ ἀνθρώπῳ.", "seq": 751}
{"id": "Elias_Passim_0752", "series": "CAG", "text": "ἢ καὶ ἄλλως·", "seq": 752}
{"id": "Elias_Passim_0753", "series": "CAG", "text": "ὁ ἄνθρωπος ζῷον, τὸ ζῷον οὐσία, ὁ ἄνθρωπος ἄρα οὐσία.", "seq": 753}
{"id": "Elias_Passim_0754", "series": "CAG", "text": "ἴδιον δὲ τῆς ἀναλυτικῆς τὸ λαβεῖν σύνθετόν τι πρᾶγμα καὶ ἀναλῦσαι εἰς τὰ ἁπλᾶ, ἐξ ὧν συντέθη, ὥσπερ ἀναλύεται ὁ λόγος εἰς λέξεις, αἱ λέξεις εἰς συλλαβὰς καὶ αἱ συλλαβαὶ εἰς στοιχεῖα.", "seq": 754}
{"id": "Elias_Passim_0755", "series": "CAG", "text": "πρώτη τοίνυν ἐστὶν ἡ διαιρετική, δευτέρα ἡ ὁριστική, τρίτη ἡ ἀποδεικτικὴ καὶ τετάρτη ἡ ἀναλυτική·", "seq": 755}
{"id": "Elias_Passim_0756", "series": "CAG", "text": "δεῖται γὰρ ἡ ὁριστικὴ τῆς διαιρετικῆς·", "seq": 756}
{"id": "Elias_Passim_0757", "series": "CAG", "text": "εἰ μὴ γὰρ προηγήσηται ἡ διαίρεσις, ὁ ὁρισμὸς οὐ γίνεται.", "seq": 757}
{"id": "Elias_Passim_0758", "series": "CAG", "text": "πάλιν δὲ εἰ μὴ προκατασκευασθῇ ὁ ὁρισμός, οὐ δύναται χρῆσθαι αὐτῷ ἡ ἀπόδειξις.", "seq": 758}
{"id": "Elias_Passim_0759", "series": "CAG", "text": "ἡ δέ γε ἀναλυτικὴ σκοπὸν ἔχει, ὡς εἴρηται, ἕν τι σύνθετον πρᾶγμα λαβεῖν καὶ τοῦτο ἀναλῦσαι εἰς τὰ ἁπλᾶ, ἐξ ὧν συνετέθη, οἷον λαμβάνει ὡς ὅλον τι σύνθετον πρᾶγμα τὸν Σωκράτην καὶ διαιρεῖ αὐτὸν εἰς χεῖρας καὶ πόδας καὶ τὰ λοιπὰ μέρη τοῦ σώματος χωροῦσα μέχρις αὐτῶν τῶν στοιχείων.", "seq": 759}
{"id": "Elias_Passim_0760", "series": "CAG", "text": "Τούτων οὕτως ἐχόντων συμβάλλεται ἡμῖν εἰς τὴν διαιρετικήν, ἐπειδὴ τρία τινὰ συγκροτεῖ τὴν διαίρεσιν, τὸ διαιρούμενον, τὸ διαιροῦν, τὰ διαιρεθέντα·", "seq": 760}
{"id": "Elias_Passim_0761", "series": "CAG", "text": "οἷον τὸ διαιρούμενον τὰ ξύλα, τὸ διαιροῦν ὁ πρίων, τὰ διαιρεθέντα αἱ σανίδες.", "seq": 761}
{"id": "Elias_Passim_0762", "series": "CAG", "text": "οὕτως κἀνταῦθα διαιρούμενον μὲν τὸ γένος, διαιροῦν δὲ ἡ διαφορά, τὰ διαιρεθέντα εἴδη·", "seq": 762}
{"id": "Elias_Passim_0763", "series": "CAG", "text": "γένη δὲ καὶ διαφορὰς καὶ εἴδη ἐνταῦθα διδασκόμεθα, πῶς οὐκ ἂν εἴη χρήσιμον;", "seq": 763}
{"id": "Elias_Passim_0764", "series": "CAG", "text": "καὶ εἰς τὴν ὁριστικὴν δὲ συμβάλλεται ἡμῖν τὸ παρὸν βιβλίον, εἴ γε ἐκ τῶν διαιρέσεων οἱ ὁρισμοί.", "seq": 764}
{"id": "Elias_Passim_0765", "series": "CAG", "text": "ἀλλὰ καὶ εἰς τὴν ἀποδεικτικήν, εἴ γε τῶν ἀποδείξεων ἀρχαὶ οἱ ὁρισμοί.", "seq": 765}
{"id": "Elias_Passim_0766", "series": "CAG", "text": "ἀλλὰ καὶ εἰς τὴν ἀναλυτικήν, εἴ γε ἡ ἀναλυτικὴ ἀπόδειξίς ἐστι ἀντεστραμμένη.", "seq": 766}
{"id": "Elias_Passim_0767", "series": "CAG", "text": "οὕτως μὲν εἰς τὰς τέσσαρας διαλεκτικὰς μεθόδους·", "seq": 767}
{"id": "Elias_Passim_0768", "series": "CAG", "text": "ἀλλὰ καὶ εἰς τὰς Ἀριστοτέλους καὶ τῶν ἄλλων Κατηγορίας·", "seq": 768}
{"id": "Elias_Passim_0769", "series": "CAG", "text": "αὗται γάρ, οὗτινος ἂν ὦσι γένη, γενικώτατά εἰσι·", "seq": 769}
{"id": "Elias_Passim_0770", "series": "CAG", "text": "γένη δὲ γενικώτατα γνῶναι οὐ δυνατὸν αὐτὸ τοῦτο τί ἐστι γένος ἀγνοοῦντας·", "seq": 770}
{"id": "Elias_Passim_0771", "series": "CAG", "text": "γένη δὲ ἐνταῦθα διδασκόμεθα, πῶς οὐκ ἂν εἴη χρήσιμον;", "seq": 771}
{"id": "Elias_Passim_0772", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ τὰ γένη εἰς εἴδη διαιρεῖται διὰ μέσου τῶν διαφορῶν, διαφορὰς δὲ καὶ εἴδη ἐνταῦθα διδασκόμεθα, πῶς οὐκ ἂν εἴη χρήσιμον τὸ παρὸν βιβλίον;", "seq": 772}
{"id": "Elias_Passim_0773", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ αἱ κατηγορίαι γένη γενικώτατα οὖσαι οὐχ ὁρίζονται, ἀγαπητὸν κἂν διὰ τῶν ἰδίων αὐτὰς ὑπογράψαι·", "seq": 773}
{"id": "Elias_Passim_0774", "series": "CAG", "text": "ἴδιον δὲ ἐνταῦθα διδασκόμεθα, πῶς οὐ χρήσιμον;", "seq": 774}
{"id": "Elias_Passim_0775", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ δέκα οὐσῶν κατηγοριῶν μία μόνη οὐσία, αἱ δὲ λοιπαὶ συμβεβηκότα, πῶς οὐ τὸ πολὺ μέρος εἰς τὸ συμβεβηκὸς συντελεῖ;", "seq": 775}
{"id": "Elias_Passim_0776", "series": "CAG", "text": "διαλέγεται γὰρ καὶ περὶ συμβεβηκότος.", "seq": 776}
{"id": "Elias_Passim_0777", "series": "CAG", "text": "ταῦτα ἔχει ἡ παροῦσα θεωρία.", "seq": 777}
{"id": "Elias_Passim_0778", "series": "CAG", "text": "Πρᾶξις ιε΄ .", "seq": 778}
{"id": "Elias_Passim_0779", "series": "CAG", "text": "Μετὰ τὸ εἰπεῖν ἡμᾶς τὸν σκοπὸν καὶ τὸ χρήσιμον, ἔλθωμεν καὶ ἐπὶ τὰ λοιπὰ τῶν κεφαλαίων καὶ εἴπωμεν τὸ τρίτον κεφάλαιον, τοῦτ᾿ ἔστι τὴν τάξιν.", "seq": 779}
{"id": "Elias_Passim_0780", "series": "CAG", "text": "δεῖ τὸ παρὸν βιβλίον πρὸ τῶν Κατηγοριῶν ἀναλέγεσθαι, εἴ γε ἐνταῦθα τὰς φωνὰς διδασκόμεθα, ἐκεῖ δὲ τὰ πράγματα, προηγεῖται δὲ ἀεὶ ἡ γνῶσις τῶν φωνῶν τῆς γνώσεως τῶν πραγμάτων.", "seq": 780}
{"id": "Elias_Passim_0781", "series": "CAG", "text": "αὕτη μὲν ἡ τάξις.", "seq": 781}
{"id": "Elias_Passim_0782", "series": "CAG", "text": "ἐφ᾿ οἷς λεγέσθω ἡ αἰτία τῆς ἐπιγραφῆς.", "seq": 782}
{"id": "Elias_Passim_0783", "series": "CAG", "text": "ἐπιγέγραπται τοίνυν Εἰσαγωγή, ἐπειδὴ ἡ γνῶσις τῶν φωνῶν εἰσαγωγή ἐστι τῆς γνώσεως τῶν πραγμάτων.", "seq": 783}
{"id": "Elias_Passim_0784", "series": "CAG", "text": "χρὴ δὲ ζητῆσαι τίνος χάριν φιλοσοφίας γράφων εἰσαγωγὴν ἀπροσδιορίστως ἐπέγραψε, μὴ δηλώσας τίνος ἐστὶν εἰσαγωγή.", "seq": 784}
{"id": "Elias_Passim_0785", "series": "CAG", "text": "καὶ λέγομεν τούτου δύο αἰτίας·", "seq": 785}
{"id": "Elias_Passim_0786", "series": "CAG", "text": "μίαν μέν, ὅτι πρέπει τοῖς ἐξέχουσι τῶν πραγμάτων τὸ ἀπροσδιόριστον·", "seq": 786}
{"id": "Elias_Passim_0787", "series": "CAG", "text": "οὕτω γοῦν ‘ὁ ποιητής’ ἀκούσαντες Ὁμήρου ἔννοιαν ἔχομεν ὡς προὔχοντος τῶν ἄλλων καὶ ‘ὁ ῥήτωρ᾿ ἀκούσαντες Δημοσθένους ἔννοιαν λαμβάνομεν.", "seq": 787}
{"id": "Elias_Passim_0788", "series": "CAG", "text": "δευτέραν δέ, ὅτι εἰσαγωγὴ οὖσα φιλοσοφίας ἡ παροῦσα πραγματεία, τῆς τεχνούσης τὰς ἄλλας τέχνας καὶ ἐπιστήμας, πάσης τέχνης καὶ ἐπιστήμης κοινῶς ἐστιν εἰσαγωγή.", "seq": 788}
{"id": "Elias_Passim_0789", "series": "CAG", "text": "αὕτη μὲν ἡ αἰτία τῆς ἐπιγραφῆς.", "seq": 789}
{"id": "Elias_Passim_0790", "series": "CAG", "text": "ἐφ᾿ οἷς εἴπωμεν τὸ γνήσιον.", "seq": 790}
{"id": "Elias_Passim_0791", "series": "CAG", "text": "γνήσιον τοίνυν πολυειδῶς ἐστι Πορφυρίου τὸ παρὸν βιβλίον, ἐκ τῶν ἐνθυμημάτων καὶ ἐκ τῆς πρὸς ἄλλας πραγματείας ὁμοιότητος·", "seq": 791}
{"id": "Elias_Passim_0792", "series": "CAG", "text": "οὐ γὰρ μόνον ἡ παροῦσα πραγματεία αὐτῷ γέγραπται πρὸς Χρυσαόριον, ἀλλὰ καὶ ἄλλαι, οἷον τὸ Περὶ διαστάσεως Πλάτωνος καὶ Ἀριστοτέλους·", "seq": 792}
{"id": "Elias_Passim_0793", "series": "CAG", "text": "παιδεύοντος γὰρ τοῦ Πορφυρίου ἐν Ῥώμῃ τὸν Χρυσαόριον τὰ μαθηματικὰ τὰ πρῶτα φέροντα τῆς ἐκεῖσε γερουσίας (ἀπόγονος γὰρ ἦν Συμμάχου ἐκείνου, εἰς ὃν εἴρηται", "seq": 793}
{"id": "Elias_Passim_0794", "series": "CAG", "text": "Σύμμαχε Συμμαχίδη, πολυσύμμαχε, σύμμαχε Ῥώμης),", "seq": 794}
{"id": "Elias_Passim_0795", "series": "CAG", "text": "καὶ ἀποδημήσαντος αὐτοῦ Πορφυρίου ἐν Σικελίᾳ διὰ τοὺς ἐν τῇ Αἴτνῃ τοῦ πυρὸς κρατῆρας, διότι δεῖ τὸν φιλόσοφον φιλοθεάμονα εἶναι τῶν τῆς φύσεως ἔργων, σχολάσας ὁ Χρυσαόριος ἀπὸ τῶν μαθημάτων ἐνέτυχε ταῖς Ἀριστοτέλους Κατηγορίαις καὶ μὴ δυνηθεὶς νοῆσαι αὐτὰς ἐπιστέλλει τῷ Πορφυρίῳ ἢ τὴν ταχίστην ἐπανελθεῖν καὶ ἐξηγήσασθαι αὐτῷ τὰς αὐτὰς Κατηγορίας ἢ γράψαι αὐτῷ ὑπόμνημα·", "seq": 795}
{"id": "Elias_Passim_0796", "series": "CAG", "text": "καὶ αἱρεῖται ὁ Πορφύριος τὸ δεύτερον καὶ γράφει αὐτῷ τὴν παροῦσαν πραγματείαν, οἷον ὑπόμνημα οὖσαν Κατηγοριῶν.", "seq": 796}
{"id": "Elias_Passim_0797", "series": "CAG", "text": "Ἐφ᾿ οἷς εἴπωμεν τὴν εἰς τὰ κεφάλαια τοῦ βιβλίου διαίρεσιν.", "seq": 797}
{"id": "Elias_Passim_0798", "series": "CAG", "text": "διαιρεῖται τοίνυν τὸ παρὸν βιβλίον εἰς τρία.", "seq": 798}
{"id": "Elias_Passim_0799", "series": "CAG", "text": "καὶ ἐν μὲν τῷ πρώτῳ τμήματι τὴν οὐσίαν τῶν πέντε φωνῶν ὑπογράφει, ἐν δὲ τῷ δευτέρῳ κοινῶς τὰς διαφορὰς αὐτῶν λέγει καὶ τὰς κοινωνίας, καὶ ἐν τῷ τρίτῳ ἰδίᾳ ἑκάστην συγκρίνει ταῖς λοιπαῖς, παραδιδοὺς τοῦ γένους καὶ τῆς διαφορᾶς τὰς κοινωνίας καὶ τὰς διαφοράς, εἶτα τοῦ γένους καὶ τοῦ εἴδους καὶ ἐπὶ τῶν ἑξῆς ὁμοίως.", "seq": 799}
{"id": "Elias_Passim_0800", "series": "CAG", "text": "μετὰ ταῦτα ὁ τρόπος λεγέσθω τῆς διαδασκαλίας.", "seq": 800}
{"id": "Elias_Passim_0801", "series": "CAG", "text": "παντὶ τοίνυν κέχρηται τρόπῳ, ὁριστικῷ μὲν ὑπογράφων τὰς φωνάς, διαιρετικῷ δὲ διαιρῶν αὐτὰς εἰς τὰ οἰκεῖα σημαινόμενα, ἀποδεικτικῷ ἡνίκα ἀποδείκνυσι τὰς διαφορὰς δυνάμει οὔσας ἐν τῷ γένει καὶ οὐκ ἐνεργείᾳ, ἀναλυτικῷ δὲ ὅτε τὰς διαφορὰς τῶν πέντε φωνῶν λέγει·", "seq": 801}
{"id": "Elias_Passim_0802", "series": "CAG", "text": "ἡ γὰρ διαφορὰ διάκρισίς ἐστι καὶ οἷον ἀνάλυσις.", "seq": 802}
{"id": "Elias_Passim_0803", "series": "CAG", "text": "ἀνάγεται δὲ ὑπ᾿ οὐδὲν μέρος τῆς φιλοσοφίας, ἀλλ᾿ ὑπὸ τὸ ὄργανον αὐτῆς, φημὶ τὴν λογικήν, ὡς δειχθήσεται σὺν θεῷ ἐν τῇ Ἀποδεικτικῇ.", "seq": 803}
{"id": "Elias_Passim_0804", "series": "CAG", "text": "<Πρᾶξις ις΄>.", "seq": 804}
{"id": "Elias_Passim_0805", "series": "CAG", "text": "Εἰσαγωγὴ Πορφυρίου.", "seq": 805}
{"id": "Elias_Passim_0806", "series": "CAG", "text": "1.", "seq": 806}
{"id": "Elias_Passim_0807", "series": "CAG", "text": "3 Ὄντος ἀναγκαίου, Χρυσαόριε, καὶ εἰς τήν.", "seq": 807}
{"id": "Elias_Passim_0808", "series": "CAG", "text": "Ἐπειδὴ μετὰ τὸ προτελεῖσθαι καὶ τοῦ τελεῖσθαι καιρός, καὶ προτελοῦσι μὲν τὰ ἡμέτερα, τελοῦσι δὲ αἱ τοῦ φιλοσόφου φωναί, φέρε τῶν μὲν ἡμετέρων ἅλις, ἐπ᾿ αὐτοὺς δὲ λοιπὸν τοὺς ἀγῶνας ἀποδυσώμεθα, τὴν ἐξήγησιν τῆς λέξεως.", "seq": 808}
{"id": "Elias_Passim_0809", "series": "CAG", "text": "τὸ τοίνυν προοίμιον αὐτῆς τρία διδάσκει, τὸν σκοπόν, τὸ χρήσιμον καὶ τὸν τρόπον τὸν διδασκαλικόν, μᾶλλον δὲ τὸ ἔμπαλιν τὸ χρήσιμον, τὸν σκοπὸν καὶ τὸν τρόπον τὸν διδασκαλικόν, εἴ γε τοῦ ἀγαθοῦ πάντα ἐφίεται, ἐν δὲ τῷ χρησίμῳ τὸ ἀγαθόν·", "seq": 809}
{"id": "Elias_Passim_0810", "series": "CAG", "text": "δύο γὰρ ὄντων κανόνων μαχομένων ἀλλήλοις καὶ τοῦ μὲν ἑνὸς λέγοντος ὅτι δεῖ τὸ χρήσιμον προηγεῖσθαι, διότι πάντα τοῦ ἀγαθοῦ ἐφίεται, ἐν τῷ χρησίμῳ δὲ τὸ ἀγαθόν, καὶ ὅτι δέλεαρ προτείνεται ἡ ἐξ αὐτοῦ ὠφέλεια τοῖς μανθάνουσι πρὸς ἐρωτικὴν διάθεσιν, καὶ κατὰ Πίνδαρον λέγοντα", "seq": 810}
{"id": "Elias_Passim_0811", "series": "CAG", "text": "παντὸς ἔργου πρόσωπον χρὴ θέμεναι τηλαυγές,", "seq": 811}
{"id": "Elias_Passim_0812", "series": "CAG", "text": "καὶ ὅτι θαυμάζομεν τὸ βιβλίον διὰ τὸ χρήσιμον αὐτοῦ, καθά φησι καὶ Ἀριστοτέλης ὅτι ‘θαυμάσαντες τὸ ὅτι ἐπὶ τὴν ζήτησιν τοῦ διότι ἐρχόμεθα’, τοῦτ᾿ ἔστι τὸ φιλοσοφεῖν.", "seq": 812}
{"id": "Elias_Passim_0813", "series": "CAG", "text": "καὶ παρὰ τοῖς ποιηταῖς ἡ Ἶρις Θαύμαντος λέγεται θυγάτηρ ὡς φιλοσοφία τις οὖσα καὶ ἀγγελὶς τῶν ὑπ᾿ αὐτῶν λεγομένων θεῶν, παρὰ τὸ ἐρεῖν ὀνομασθεῖσα Ἶρις.", "seq": 813}
{"id": "Elias_Passim_0814", "series": "CAG", "text": "θαυμαστὴ δὲ καὶ ἡ ὁμώνυμος αὐτῇ ἶρις ἐν ὑγρῷ καὶ ῥευστῷ ὑποκειμένῳ τῷ ἀέρι τοιοῦτον ἀποτετορνευμένον καὶ μαθηματικὸν φυλάξασα σχῆμα καὶ τὸ ἀσύγχυτον τῶν χρωμάτων.", "seq": 814}
{"id": "Elias_Passim_0815", "series": "CAG", "text": "καὶ οὕτως μὲν περὶ τοῦ χρησίμου.", "seq": 815}
{"id": "Elias_Passim_0816", "series": "CAG", "text": "τοῦ δὲ ἄλλου κανόνος φάσκοντος δεῖν τὸν σκοπὸν προτάττειν διὰ τὸ μὴ ἀγνοουμένου τοῦ πράγματος ἐπαίνους καταβάλλεσθαι (ἔπαινος δὲ τοῦ βιβλίου τὸ χρήσιμον) καὶ διὰ Πλάτωνα εἰρηκότα ‘ὦ παῖ, μία ἀρχὴ τοῦ καλῶς βουλεύεσθαι τὸ εἰδέναι περὶ ὅτου ἐστὶν ἡ σκέψις, ἐπεὶ τοῦ παντὸς ἁμαρτάνειν ἀνάγκη’.", "seq": 816}
{"id": "Elias_Passim_0817", "series": "CAG", "text": "τῶν δύο οὖν μαχομένων κανόνων θαυμαστῶς διῄτησεν ὁ εὐμήχανος φιλόσοφος κεράσας τὸ πρᾶγμα·", "seq": 817}
{"id": "Elias_Passim_0818", "series": "CAG", "text": "ἤρξατο μὲν γὰρ ἀπὸ τοῦ χρησίμου μηδὲν τοῦ ἀγαθοῦ νομίσας εἶναι ἐπέκεινα, εἶτα πολλῶν ὄντων τρόπων τοῦ χρησίμου ἑνὸς μνησθείς, πρὶν τοὺς ἄλλους εἴπῃ, ἐπάγει τὸν σκοπὸν καὶ λέγει πάλιν τὸ χρήσιμον, ἵνα δόξῃ θάτερον θατέρου προτάττειν καὶ τὸν σκοπὸν τοῦ χρησίμου καὶ τὸ χρήσιμον τοῦ σκοποῦ.", "seq": 818}
{"id": "Elias_Passim_0819", "series": "CAG", "text": "φέρε δὲ ἡμεῖς, ὡς εἰώθαμεν, διὰ τὸ σαφὲς ἀπὸ τοῦ σκοποῦ ἀρξώμεθα.", "seq": 819}
{"id": "Elias_Passim_0820", "series": "CAG", "text": "Σκοπὸν τοίνυν ἔχει ὁ Πορφύριος πᾶσαν φιλόσοφον φωνὴν διδάξαι ἡμᾶς καὶ ὑπὸ πέντε κοινότητας καὶ ἀρχὰς ἀναγαγεῖν, καὶ οὐχ, ὥς τινες ὑπολαμβάνουσιν, ὅτι σκοπὸν ἔχει περὶ πέντε τινῶν διαλαβεῖν, περί τε γένους καὶ τῶν λοιπῶν, ἵνα μὴ ἑνὸς ὄντος βιβλίου καὶ ταῦτα βραχυτάτου πλείονας ποιήσῃ σκοπούς, τοῦ Πλάτωνος λέγοντος παντὸς βιβλίου ὅσον ἂν ᾖ καὶ οἷον ἂν ᾖ ἕνα σκοπὸν ποιεῖσθαι.", "seq": 820}
{"id": "Elias_Passim_0821", "series": "CAG", "text": "ἄλλοι δὲ λέγουσιν ὅτι σκοπὸν ἔχει τὰ ἀσαφῶς ἐν ταῖς Κατηγορίαις εἰρημένα σαφηνίσαι·", "seq": 821}
{"id": "Elias_Passim_0822", "series": "CAG", "text": "ψεῦδος γὰρ καὶ τοῦτο, εἴ γε μέμνηται ἐν ταῖς Κατηγορίαις τοῦ δυνάμει ἀσαφεστάτου ὄντος, ὅπερ ἐνταῦθα οὐ σαφηνίζει.", "seq": 822}
{"id": "Elias_Passim_0823", "series": "CAG", "text": "καὶ οὕτως μὲν ὁ σκοπός.", "seq": 823}
{"id": "Elias_Passim_0824", "series": "CAG", "text": "ἐφ᾿ οἷς εἴπωμεν τὸ χρήσιμον.", "seq": 824}
{"id": "Elias_Passim_0825", "series": "CAG", "text": "τεσσάρων τοίνυν ὄντων τρόπων τοῦ χρησίμου, ὡς εἴρηται ἐν τοῖς προλαβοῦσι, τῶν δύο ἐνταῦθα μέμνηται, τοῦ εἰς τὰς Κατηγορίας χρησιμεύειν καὶ εἰς τὰς διαλεκτικὰς μεθόδους, ἢ τὰ κατεπείγοντα εἰς τὴν παροῦσαν πραγματείαν εἰπὼν ἢ καὶ τὰ λοιπὰ αἰνιξάμενος διὰ τοῦ καί συνδέσμου·", "seq": 825}
{"id": "Elias_Passim_0826", "series": "CAG", "text": "εἰπὼν γὰρ καὶ εἰς τὴν τῶν παρὰ Ἀριστοτέλει Κατηγοριῶν διὰ τοῦ καί συνδέσμου καὶ τὰ λοιπὰ ἐμφαίνει.", "seq": 826}
{"id": "Elias_Passim_0827", "series": "CAG", "text": "οὕτως καὶ τὸ χρήσιμον.", "seq": 827}
{"id": "Elias_Passim_0828", "series": "CAG", "text": "ἐφ᾿ οἷς ὁ τρόπος τῆς διδασκαλίας λεγέσθω.", "seq": 828}
{"id": "Elias_Passim_0829", "series": "CAG", "text": "δεῖ εἰδέναι ὅτι οὐδενὶ τῶν προειρημένων τρόπων κέχρηται τῆς διδασκαλίας, ἀλλὰ νῦν παραδίδωσι τρόπον διδασκαλίας καθαρόν, καθαρεύοντα παντὸς τρόπου ἀσαφείας·", "seq": 829}
{"id": "Elias_Passim_0830", "series": "CAG", "text": "τρεῖς γὰρ τρόποι εἰσὶν ἀσαφείας, δι᾿ οὓς ἀποκνοῦσιν οἱ νέοι τοῖς βιβλίοις ἐντυγχάνειν·", "seq": 830}
{"id": "Elias_Passim_0831", "series": "CAG", "text": "ἢ γὰρ διὰ τὸ σκοτεινὸν καὶ ὑποβρύχιον τῶν νοημάτων, ὡς τὰ Ἡρακλείτεια (διὸ καί τις τὰ Ἡρακλείτου ἔφη βαθέος δεῖσθαι κολυμβητοῦ), ἢ διὰ τὸ ἐξηπλωμένον τῆς φράσεως ὡς χαλινοῦ δεῖσθαι, οἷον τὰ Γαλήνεια καὶ τὰ Πρόκλεια, ἢ διὰ τὸ ἀπεστενωμένον τῆς φράσεως, ὡς τὰ Ἀριστοτελικὰ καὶ τὰ Ἱπποκράτεια.", "seq": 831}
{"id": "Elias_Passim_0832", "series": "CAG", "text": "πάντας οὖν τούτους ἐξέφυγε, τὸν μὲν ἐκ τῆς βαθύτητος τῶν νοημάτων εἰπὼν τῶν μὲν βαθυτέρων ἀπεχόμενος ζητημάτων, τῶν δ᾿ ἁπλουστέρων συμμέτρως στοχαζόμενος, τὸν δὲ ἐκ τῆς πολυλογίας εἰπὼν σύντομόν σοι παράδοσιν ποιούμενος πειράσομαι διὰ βραχέων, τὸν δὲ ἐκ τοῦ ἀπεστενωμένου τῆς φράσεως, ἡνίκα λέγει ὥσπερ ἐν εἰσαγωγῆς τρόπῳ.", "seq": 832}
{"id": "Elias_Passim_0833", "series": "CAG", "text": "ταῦτα ἔχει ἡ παροῦσα πρᾶξις.", "seq": 833}
{"id": "Elias_Passim_0834", "series": "CAG", "text": "<Πρᾶξις ιζ᾿>.", "seq": 834}
{"id": "Elias_Passim_0835", "series": "CAG", "text": "1.", "seq": 835}
{"id": "Elias_Passim_0836", "series": "CAG", "text": "3 Ὄντος ἀναγκαίου, Χρυσαόριε.", "seq": 836}
{"id": "Elias_Passim_0837", "series": "CAG", "text": "Διὰ τί τὸ ὂν προέταξε τοῦ ἀναγκαίου;", "seq": 837}
{"id": "Elias_Passim_0838", "series": "CAG", "text": "καὶ λέγομεν ὅτι ὡς καθολικώτερον·", "seq": 838}
{"id": "Elias_Passim_0839", "series": "CAG", "text": "τὸ γὰρ ὂν φέρεται καὶ κατὰ ἀναγκαίου, φέρεται καὶ κατὰ ἐνδεχομένου.", "seq": 839}
{"id": "Elias_Passim_0840", "series": "CAG", "text": "λέγεται δὲ ἀναγκαῖα μὲν τὰ ἀεὶ ὡσαύτως ἔχοντα, οἷον ἀναγκαίως τὸ πῦρ θερμαίνει, ὁ ἥλιος φωτίζει, ἐνδεχόμενα δὲ τὰ δυνάμενα καὶ ἄλλως ἔχειν, οἷον τὸ περιπατεῖν τὸν ἄνθρωπον (δύναται γὰρ καὶ μὴ περιπατεῖν), καὶ τὸ διαλέγεσθαι·", "seq": 840}
{"id": "Elias_Passim_0841", "series": "CAG", "text": "δύναται γὰρ καὶ μὴ διαλέγεσθαι.", "seq": 841}
{"id": "Elias_Passim_0842", "series": "CAG", "text": "ὡς οὖν κατὰ τῶν δύο φερόμενον τὸ ὄν, τοῦ τε ἀναγκαίου καὶ τοῦ ἐνδεχομένου, καθολικώτερόν ἐστι μόνου τοῦ ἀναγκαίου·", "seq": 842}
{"id": "Elias_Passim_0843", "series": "CAG", "text": "εἴ τι μὲν γὰρ ἀναγκαῖον, πάντως καὶ ὄν, οὐ μὴν εἴ τι ὄν, τοῦτο καὶ ἀναγκαῖον διὰ τό, ὡς εἴρηται, φέρεσθαι καὶ κατὰ ἐνδεχομένου.", "seq": 843}
{"id": "Elias_Passim_0844", "series": "CAG", "text": "καὶ πάλιν εἴ τι μὲν ἐνδεχόμενον, πάντως ὄν, οὐ μὴν εἴ τι ὄν, πάντως καὶ ἐνδεχόμενον διὰ τὸ φέρεσθαι καὶ κατὰ ἀναγκαίου.", "seq": 844}
{"id": "Elias_Passim_0845", "series": "CAG", "text": "τρία τινὰ παράκειται ἀλλήλοις, ἀγαθόν, ἀναγκαῖον καὶ χρήσιμον·", "seq": 845}
{"id": "Elias_Passim_0846", "series": "CAG", "text": "καὶ ἀγαθὸν μέν ἐστι τὸ δι᾿ ἑαυτὸ αἱρετὸν οἷον ὑγεία·", "seq": 846}
{"id": "Elias_Passim_0847", "series": "CAG", "text": "αὐτὴ γὰρ δι᾿ ἑαυτὴν αἱρετή ἐστι καὶ οὐ δι᾿ ἄλλο, εἴ γε θέλομεν ὑγιαίνειν, καὶ εἰ λήσεσθαι μέλλοιμεν πάντας ἀνθρώπους ὅτι ὑγιαίνομεν, καίτοι κάλλος μὴ θέλοντες ἔχειν μηδὲ πλοῦτον, εἰ μηδεὶς ἀνθρώπων οἶδεν ὅτι ταῦτα ἔχομεν.", "seq": 847}
{"id": "Elias_Passim_0848", "series": "CAG", "text": "ἀναγκαῖον δὲ καὶ χρήσιμόν ἐστι τὸ δι᾿ ἄλλο αἱρετόν·", "seq": 848}
{"id": "Elias_Passim_0849", "series": "CAG", "text": "ἀλλ᾿ εἰ μὲν ἀπαραίτητον ᾖ, λέγεται ἀναγκαῖον ὡς τὸ ἀναπνεῖν τοῖς πνεύμονα ἔχουσι ζῴοις, εἰ δὲ παραίτησιν ἐπιδέχεται, λέγεται χρήσιμον ὡς τὸ ὑποδεδέσθαι ἐν χειμῶνι·", "seq": 849}
{"id": "Elias_Passim_0850", "series": "CAG", "text": "δυνατὸν γὰρ καὶ μὴ ὑποδεδέσθαι.", "seq": 850}
{"id": "Elias_Passim_0851", "series": "CAG", "text": "τῶν οὖν τριῶν τούτων, ὡς εἴρηται, παρακειμένων ἀλλήλοις οὐκ εἶπεν ὁ Πορφύριος ‘ἀγαθοῦ ὄντος τοῦ γνῶναι τί γένος καὶ διαφορὰ ἢ χρησίμου ὄντος’, ἀλλ᾿ ἀναγκαίου ὄντος, ἐπειδὴ ἡ γνῶσις τῶν πέντε φωνῶν οὐδὲ ἀγαθόν ἐστιν (ἀγαθὸν γὰρ ἦν τὸ δι᾿ ἑαυτὸ αἱρετὸν ὄν, θέλομεν δὲ εἰδέναι τὰς φωνὰς οὐ δι᾿ ἑαυτὰς ἀλλὰ διὰ τὰ πράγματα), οὐδὲ χρήσιμος ἡ γνῶσις τῶν πέντε φωνῶν·", "seq": 851}
{"id": "Elias_Passim_0852", "series": "CAG", "text": "χρήσιμον γὰρ ἦν τὸ παραίτησιν ἐνδεχόμενον, οὐκ ἐνῆν δὲ ἡμᾶς παραιτήσασθαι τὰς πέντε φωνὰς θέλοντας εἰδέναι τὰ πράγματα.", "seq": 852}
{"id": "Elias_Passim_0853", "series": "CAG", "text": "τοῦ δὲ ἀναγκαίου διττοῦ ὄντος, ἢ δι᾿ ἑαυτὸ μὲν φευκτοῦ, δι᾿ ἄλλο δὲ αἱρετοῦ, ὡς τὸ φλεβοτόμον (τοῦτο γὰρ ὅσον μὲν ἐφ᾿ ἑαυτὸ φευκτόν ἐστιν ἑλκωτικὸν ὂν καὶ διαλύον τὸ συνεχές, δι᾿ ἄλλο δὲ αἱρετόν·", "seq": 853}
{"id": "Elias_Passim_0854", "series": "CAG", "text": "διὰ γὰρ τὴν κένωσιν τοῦ λυποῦντος χυμοῦ), ἢ καὶ δι᾿ αὑτὸ αἱρετοῦ καὶ δι᾿ ἄλλο, ὥσπερ καὶ ὑγεία (αὕτη γὰρ καὶ δι᾿ ἑαυτὴν αἱρετή ἐστιν ὡς συμμετρία καὶ δι᾿ ἄλλο, ἵνα ὑπουργῇ τὸ σῶμα ταῖς τῆς ψυχῆς ἐνεργείαις), τῷ δευτέρῳ τοίνυν σημαινομένῳ ἐχρήσατο ἐνταῦθα ὁ Πορφύριος·", "seq": 854}
{"id": "Elias_Passim_0855", "series": "CAG", "text": "ἡ γὰρ γνῶσις τῶν πέντε φωνῶν καὶ δι᾿ ἑαυτὴν αἱρετή ἐστιν ὡς γνῶσις (πᾶσα γὰρ γνῶσις καλή, καθά φησιν ὁ Ἀριστοτέλης, καὶ αὐτὴ ἡ τῶν κακῶν γνῶσις καλή, ἵνα μὴ δι᾿ ἄγνοιαν χρησώμεθα αὐτοῖς·", "seq": 855}
{"id": "Elias_Passim_0856", "series": "CAG", "text": "καὶ οἱ ἰατροὶ διδάσκουσι τὰ δηλητήρια, οὐχ ἵνα χρησώμεθα, ἀλλ᾿ ἵνα φύγωμεν), καὶ δι᾿ ἄλλο αἱρετή·", "seq": 856}
{"id": "Elias_Passim_0857", "series": "CAG", "text": "διὰ γὰρ τὴν γνῶσιν τῶν πραγμάτων.", "seq": 857}
{"id": "Elias_Passim_0858", "series": "CAG", "text": "1.", "seq": 858}
{"id": "Elias_Passim_0859", "series": "CAG", "text": "3 Καὶ εἰς τὴν τῶν παρὰ Ἀριστοτέλει Κατηγοριῶν διδασκαλίαν.", "seq": 859}
{"id": "Elias_Passim_0860", "series": "CAG", "text": "Τὸν ἕνα τρόπον τοῦ χρησίμου ἐνταῦθα διδάσκει.", "seq": 860}
{"id": "Elias_Passim_0861", "series": "CAG", "text": ".", "seq": 861}
{"id": "Elias_Passim_0862", "series": "CAG", "text": "1.", "seq": 862}
{"id": "Elias_Passim_0863", "series": "CAG", "text": "4 Τοῦ γνῶναι τί γένος καὶ τί διαφορά, καὶ τὰ ἑξῆς.", "seq": 863}
{"id": "Elias_Passim_0864", "series": "CAG", "text": "Ἐνταῦθα τὸν σκοπὸν λέγει, ὅτι σκοπὸν ἔχει περὶ γενικῶν φωνῶν διαλαβεῖν καὶ καθολικῶν.", "seq": 864}
{"id": "Elias_Passim_0865", "series": "CAG", "text": "1.", "seq": 865}
{"id": "Elias_Passim_0866", "series": "CAG", "text": "5 Εἴς τε τὴν τῶν ὁρισμῶν ἀπόδοσιν καὶ ὅλως εἰς τὰ περὶ διαιρέσεως.", "seq": 866}
{"id": "Elias_Passim_0867", "series": "CAG", "text": "Μετὰ τὸ εἰπεῖν τὸν ἕνα τρόπον τοῦ χρησίμου, εἶτα ἐπαγαγεῖν τὸν σκοπόν, πάλιν τὸν ἕτερον τρόπον τοῦ χρησίμου λέγει.", "seq": 867}
{"id": "Elias_Passim_0868", "series": "CAG", "text": "τινὲς δέ φασι διὰ τί προέταξεν τὴν ὁριστικὴν τῆς διαιρετικῆς, εἴ γε ἐκ τῶν διαιρέσεων οἱ ὁρισμοί·", "seq": 868}
{"id": "Elias_Passim_0869", "series": "CAG", "text": "τῆς γὰρ διαιρετικῆς τὸ ἓν πολλὰ ποιούσης, οἷον τὸ ζῷον διαιρούσης εἰς λογικὸν καὶ ἄλογον, θνητὸν καὶ ἀθάνατον, ἡ ὁριστικὴ τοὐναντίον τὰ πολλὰ ἓν ποιεῖ λαμβάνουσα θάτερον σκέλος τῶν ἀντιδιῃρημένων καὶ ποιοῦσα τὸν ἄνθρωπον ζῷον λογικὸν θνητὸν νοῦ καὶ ἐπιστήμης δεκτικόν.", "seq": 869}
{"id": "Elias_Passim_0870", "series": "CAG", "text": "καὶ λέγομεν ὅτι διὰ τὸ κατεπεῖγον·", "seq": 870}
{"id": "Elias_Passim_0871", "series": "CAG", "text": "βούλεται γὰρ ὁρίσασθαι ἑκάστην φωνὴν διὰ τὸν εἰσαγωγικὸν τρόπον.", "seq": 871}
{"id": "Elias_Passim_0872", "series": "CAG", "text": "1.", "seq": 872}
{"id": "Elias_Passim_0873", "series": "CAG", "text": "5 Καὶ ὅλως εἰς τὰ περὶ διαιρέσεως καὶ ἀποδείξεως.", "seq": 873}
{"id": "Elias_Passim_0874", "series": "CAG", "text": "Διὰ τί, φασί τινες, τῆς ἀναλυτικῆς οὐκ ἐμνήσθη;", "seq": 874}
{"id": "Elias_Passim_0875", "series": "CAG", "text": "καὶ λέγομεν ὅτι οὐδὲ ταύτην παρῆκεν·", "seq": 875}
{"id": "Elias_Passim_0876", "series": "CAG", "text": "τῇ γὰρ ἀποδείξει ἐμπεριέχεται, ὡς μεμαθήκαμεν·", "seq": 876}
{"id": "Elias_Passim_0877", "series": "CAG", "text": "ἀπόδειξις γάρ ἐστιν ἀντεστραμμένη ἀνάλυσις.", "seq": 877}
{"id": "Elias_Passim_0878", "series": "CAG", "text": "1.", "seq": 878}
{"id": "Elias_Passim_0879", "series": "CAG", "text": "6 Καὶ χρησίμης οὔσης τῆς τούτων θεωρίας.", "seq": 879}
{"id": "Elias_Passim_0880", "series": "CAG", "text": "Πῶς ἀνωτέρω μὲν εἶπεν ἀναγκαίαν τὴν γνῶσιν τῶν φωνῶν, νῦν δὲ χρήσιμον;", "seq": 880}
{"id": "Elias_Passim_0881", "series": "CAG", "text": "πρὸς ὃ λεκτέον ὅτι ἀναγκαία μὲν ἡ γνῶσις τῶν φωνῶν, ὡς εἴρηται, ἡ δὲ περὶ τῶν φωνῶν πραγματεία χρήσιμος καὶ οὐκ ἀναγκαία·", "seq": 881}
{"id": "Elias_Passim_0882", "series": "CAG", "text": "ἐνῆν γὰρ καὶ χωρὶς τοῦδε τοῦ βιβλίου νοῆσαι τὰς Κατηγορίας.", "seq": 882}
{"id": "Elias_Passim_0883", "series": "CAG", "text": "1.", "seq": 883}
{"id": "Elias_Passim_0884", "series": "CAG", "text": "7 Σύντομόν σοι παράδοσιν ποιούμενος.", "seq": 884}
{"id": "Elias_Passim_0885", "series": "CAG", "text": "Τὸν τρόπον τὸν διδασκαλικὸν λέγει.", "seq": 885}
{"id": "Elias_Passim_0886", "series": "CAG", "text": "1.", "seq": 886}
{"id": "Elias_Passim_0887", "series": "CAG", "text": "7 Πειράσομαι διὰ βραχέων ὡς ἐν εἰσαγωγῆς.", "seq": 887}
{"id": "Elias_Passim_0888", "series": "CAG", "text": "Τοῦτο μετριάζων ὁ φιλόσοφος εἶπεν·", "seq": 888}
{"id": "Elias_Passim_0889", "series": "CAG", "text": "δεῖ γὰρ ἄνθρωπον ὄντα καὶ τὸν εὐτυχοῦντα ἐν νῷ ἔχειν τὸ εἰρημένον", "seq": 889}
{"id": "Elias_Passim_0890", "series": "CAG", "text": "τὸ τῆς τύχης γὰρ ῥεῦμα μεταπίπτει ταχύ.", "seq": 890}
{"id": "Elias_Passim_0891", "series": "CAG", "text": "διὸ καὶ οἱ ζωγράφοι τὴν τύχην ἐπὶ τροχοῦ ἱστοροῦσι τὸ ἄστατον αὐτῆς αἰνιττόμενοι.", "seq": 891}
{"id": "Elias_Passim_0892", "series": "CAG", "text": "καὶ οὐ δεῖ μέγα φρονεῖν ἐπί τινι τῶν παρόντων, ἀλλὰ καὶ τὸν ἀποδεικνύντα τι δεῖ μὴ μέγα φρονεῖν·", "seq": 892}
{"id": "Elias_Passim_0893", "series": "CAG", "text": "εἰκὸς γὰρ ἄνθρωπον ὄντα ἀπατᾶσθαι περὶ τὴν ἀπόδειξιν, εἴ γε καὶ περὶ τὰ ἐναργῆ ἀπατώμεθα τὸν ἥλιον πηχυαῖον ὁρῶντες καὶ τὴν ἐν τῷ ὕδατι κώπην κεκλασμένην.", "seq": 893}
{"id": "Elias_Passim_0894", "series": "CAG", "text": "1.", "seq": 894}
{"id": "Elias_Passim_0895", "series": "CAG", "text": "8 Ta παρὰ τοῖς πρεσβυτέροις.", "seq": 895}
{"id": "Elias_Passim_0896", "series": "CAG", "text": "Ἄλλη ἐλπὶς σαφηνείας προτείνεται τοῖς νέοις·", "seq": 896}
{"id": "Elias_Passim_0897", "series": "CAG", "text": "ὅσῳ γὰρ κατημαξευμένα ἢ καὶ ἄλλοις εἰρημένα παλαιοῖς, σαφέστερα.", "seq": 897}
{"id": "Elias_Passim_0898", "series": "CAG", "text": "1.", "seq": 898}
{"id": "Elias_Passim_0899", "series": "CAG", "text": "8 Τῶν μὲν βαθυτέρων ἀπεχόμενος.", "seq": 899}
{"id": "Elias_Passim_0900", "series": "CAG", "text": "Ὅτε μὲν διδάσκειν ἐπαγγέλλεται, προτρεπτικῶς φησι τὸ πειράσομαι διὰ βραχέων, ὅτε δὲ παραιτεῖται, ἀποτρεπτικοῖς κέχρηται λόγοις φάσκων τὰ προειρημένα.", "seq": 900}
{"id": "Elias_Passim_0901", "series": "CAG", "text": "1.", "seq": 901}
{"id": "Elias_Passim_0902", "series": "CAG", "text": "9 Τῶν δὲ ἁπλουστέρων συμμέτρως στοχαζόμενος.", "seq": 902}
{"id": "Elias_Passim_0903", "series": "CAG", "text": "Οὐ πρέπει τῷ ἀποδεικτικῷ τὸ στοχάζεσθαι·", "seq": 903}
{"id": "Elias_Passim_0904", "series": "CAG", "text": "ἡ γὰρ ἀπόδειξις ἐπιστημονική.", "seq": 904}
{"id": "Elias_Passim_0905", "series": "CAG", "text": "καὶ λέγομεν πρὸς τοῦτο, ὅτι τὸ στοχαζόμενος οὐ πρὸς τὴν ἀπόδειξιν καὶ τὸν ἐπιστήμονα εἴρηται, ἀλλὰ πρὸς Χρυσαόριον, ἀκροατὴν εἰσαγόμενον.", "seq": 905}
{"id": "Elias_Passim_0906", "series": "CAG", "text": "1.", "seq": 906}
{"id": "Elias_Passim_0907", "series": "CAG", "text": "9 Αὐτίκα περὶ τῶν γενῶν τε καὶ εἰδῶν τὸ μὲν εἴτε ὑφέστηκεν καὶ τὰ ἑξῆς.", "seq": 907}
{"id": "Elias_Passim_0908", "series": "CAG", "text": "Εἰπὼν ὁ Πορφύριος ὅτι τῶν μὲν βαθυτέρων ἀπέχομαι ζητημάτων, τῶν δὲ ἁπλουστέρων συμμέτρως στοχάζομαι, ὥς τινος δῆθεν εἰπόντος πρὸς αὐτὸν ‘μάτην καλλωπίζῃ, ὦ Πορφύριε·", "seq": 908}
{"id": "Elias_Passim_0909", "series": "CAG", "text": "τί γὰρ καὶ εἰ ἠθέλησας ἀσαφές τι εἰπεῖν περὶ αὐτῶν, εἶχες φύσει σαφῶν ὄντων, ὥσπερ καὶ ἄλλα φύσει εἰσὶ σαφῆ ὡς τὸ δὶς δύο, ὅπερ οὐ δύναται ἀσαφές ποτε γενέσθαι;’", "seq": 909}
{"id": "Elias_Passim_0910", "series": "CAG", "text": ", κατάλογον ποιεῖται ὁ Πορφύριος πολλῶν ζητημάτων, ὅσα ἐνῆν ζητεῖν, εἰ μὴ φειδοῖ τῆς νεολαίας φιλάνθρωπον εἶδος μετῄει συγγραφῆς·", "seq": 910}
{"id": "Elias_Passim_0911", "series": "CAG", "text": "τῶν γὰρ ὄντων πάντων ἢ ὑφεστώτων ἢ ἐν ψιλαῖς ἐπινοίαις θεωρουμένων καὶ ὑφεστάναι μὲν ἐκείνων λεγομένων, ὅσα μήτε ἐπειδὴ γινώσκεται ἔστι μήτε ἐπειδὴ ἀγνοεῖται οὐκ ἔστι, ὡς θεός, νοῦς, ψυχή (ταῦτα γὰρ κἄν τε γινώσκηται ἐξ ἡμῶν κἄν τε ἀγνοῆται οὐδὲν ἧττον ἔστιν), ἐν ψιλαῖς δὲ ἐπινοίαις λεγομένων ὅσα ἐπειδὴ γινώσκεται ἔστι καὶ ἐπειδὴ ἀγνοεῖται οὐκ ἔστιν, ὡς εἶναι γένεσιν μὲν αὐτῶν τὴν ἡμετέραν γνῶσιν, ὄλεθρον δὲ τὴν ἡμῶν ἄγνοιαν, ὡς τραγέλαφος καὶ ἱπποκένταυρος (οὐδὲ γὰρ οἶδεν ἡ φύσις τοιαύτην κρᾶσιν, ἀλλ᾿ ἡ ἡμετέρα διάνοια ἐτυράννησεν ἐκ τῶν ἁπλῶν σύνθετόν τι ἐπινοήσασα·", "seq": 911}
{"id": "Elias_Passim_0912", "series": "CAG", "text": "λαβοῦσα γὰρ τράγον καὶ ἔλαφον ἐποίησε τραγέλαφον καὶ ἰδοῦσα ἵππον καὶ ἄνθρωπον ἐποίησεν ἱπποκένταυρον), τῶν οὖν ὄντων πάντων, καθὰ εἴρηται, ἢ ὑφεστώτων ἢ ἐν μόναις ψιλαῖς ἐπινοίαις θεωρουμένων, ἠδυνάμην, φησίν, ζητεῖν τὰ γένη καὶ τὰ εἴδη ποτέροις μετείη.", "seq": 912}
{"id": "Elias_Passim_0913", "series": "CAG", "text": "εὐλόγους δέ μοι τὰς ζητήσεις ἐποίει καὶ ἡ τῶν παλαιῶν περὶ ταῦτα διαφωνία·", "seq": 913}
{"id": "Elias_Passim_0914", "series": "CAG", "text": "οἱ μὲν γὰρ ἔλεγον ὑφεστάναι τὰ γένη καὶ τὰ εἴδη, ὡς Πλάτων καὶ Ἀριστοτέλης καὶ οἱ τοιοῦτοι, Ἀντισθένης δὲ ὁ Κυνικὸς ὁ τοῦ Διογένους διδάσκαλος ἔλεγεν μὴ εἶναι τὰ καθόλου οὕτως ἐπιχειρῶν·", "seq": 914}
{"id": "Elias_Passim_0915", "series": "CAG", "text": "‘ἄνθρωπον ὁρῶ, ἀνθρωπότητα δὲ οὐχ ὁρῶ, καὶ ἵππον ὁρῶ, ἱππότητα δὲ οὐχ ὁρῶ’.", "seq": 915}
{"id": "Elias_Passim_0916", "series": "CAG", "text": "‘ἀλλ᾿, ὦ Ἀντίσθενες’, φησὶ πρὸς αὐτὸν ὁ Πλάτων, ‘οἷς μὲν ὁρᾶται ἵππος καὶ ἄνθρωπος τὰ κατὰ μέρος ἔχεις, τοῦτ᾿ ἔστιν ὀφθαλμούς, οἷς δὲ ὁρᾶται ἀνθρωπότης καὶ ἱππότης τὰ καθόλου οὐκ ἔχεις·", "seq": 916}
{"id": "Elias_Passim_0917", "series": "CAG", "text": "νοῦν γὰρ οὐκ ἔχεις’·", "seq": 917}
{"id": "Elias_Passim_0918", "series": "CAG", "text": "ὅτι γάρ εἰσι τὰ καθόλου καὶ οὐκ ἐν ψιλαῖς ἐπινοίαις μόνον καθέστηκεν, δηλοῖ κατὰ τὴν ὁμοιοπάθειαν·", "seq": 918}
{"id": "Elias_Passim_0919", "series": "CAG", "text": "πόθεν γὰρ ὁρῶντες χασμωμένους τινὰς ἢ ἀποροῦντας παραχρῆμα ἀνάγκῃ τινὶ κινούμεθα πρὸς τὸ ὁμοιοπαθὲς ἐνεργεῖν, εἰ μὴ κοινόν τι καθόλου ὑπῆρχε πρὸς ἀλλήλους;", "seq": 919}
{"id": "Elias_Passim_0920", "series": "CAG", "text": "Ἀλλὰ καὶ τούτου δειχθέντος ὅτι ὑφεστήκασι τὰ γένη καὶ τὰ εἴδη, οὐ τοῦτο πέρας ἐποιούμην τῆς ζητήσεως, ἀλλ᾿ ἔτι ποικιλωτέρα μέ τις ζήτησις ἐξεδέχετο·", "seq": 920}
{"id": "Elias_Passim_0921", "series": "CAG", "text": "τῶν γὰρ ὑφεστώτων πάντων ἢ σωμάτων ὄντων ἢ ἀσωμάτων ἐνῆν ζητεῖν πότερον τὰ καθόλου, τοῦτ᾿ ἔστι τὰ γένη καὶ τὰ εἴδη, σώματα ἢ ἀσώματα.", "seq": 921}
{"id": "Elias_Passim_0922", "series": "CAG", "text": "εὐλόγους δέ μοι πάλιν τὰς ζητήσεις ἐποίει τῶν παλαιῶν ἡ περὶ ταῦτα διαφωνία·", "seq": 922}
{"id": "Elias_Passim_0923", "series": "CAG", "text": "οἱ γὰρ Στωϊκοὶ σώματα εἶναι ἔλεγον τὰ καθόλου, οὐ ταῦτα δὲ μόνον ἀλλὰ καὶ πάντα τὰ ὄντα καὶ τὸ θεῖον αὐτὸ σῶμα ἔχειν, ἀλλὰ λεπτομερές (τοῦτο δῆθεν τὸ ὅσιον αὐτῶν), ἵνα διὰ πάντων δῆθεν τῶν ὄντων διέλθῃ, ἄνθρωποι ταῖς ἀληθείαις σπαρτοὶ καὶ γηγενεῖς ἀπὸ δρυὸς ἢ ἀπὸ πέτρας τὴν φιλοσοφίαν ἐρανισάμενοι, οὐκ ἔκ τινος παραδόσεως, ἀλλότριοι ὄντες καὶ αὐτοῦ τοῦ φιλοσοφίας ὀνόματος, εἰ μὴ εἶχόν τινα χαρακτηρίζοντα τὸν φιλόσοφον, τὸ ὑψηλόν φημι τῆς ζωῆς, ὅπερ ἔργον ἐστὶ τοῦ πρακτικοῦ φιλοσόφου·", "seq": 923}
{"id": "Elias_Passim_0924", "series": "CAG", "text": "ἐκείνων γάρ εἰσιν αἱ μεγαληγορίαι αὗται·", "seq": 924}
{"id": "Elias_Passim_0925", "series": "CAG", "text": "μόνος ὁ σοφὸς πλούσιος ὡς μὴ τὸν ἐφήμερον πλοῦτον πλουτῶν ἀλλὰ τὸν ἀεὶ παραμένοντα (σοφία γὰρ μόνη τῶν κτημάτων ἀθάνατον), μόνος ὁ σοφὸς εὐτυχὴς ὡς τῶν ἐπ᾿ αὐτῷ ὀρεγόμενος καὶ διὰ τοῦτο μηδέποτε ἀποτυγχάνων, μόνος ὁ σοφὸς ἄρχων ὡς εἰδὼς πῶς δεῖ ἄρχειν καὶ διὰ τοῦτο ἀεὶ ἑαυτοῦ ἄρχων καὶ μὴ ἀρχόμενος.", "seq": 925}
{"id": "Elias_Passim_0926", "series": "CAG", "text": "διὰ ταύτας οὖν τὰς μεγαληγορίας ἠξιώθησαν τοῦ τῆς φιλοσοφίας ὀνόματος.", "seq": 926}
{"id": "Elias_Passim_0927", "series": "CAG", "text": "‘ἀλλ᾿, ὦ Στωϊκοί’, ἔστι πρὸς αὐτοὺς εἰπεῖν, ‘οὐ δύναται τὸ αὐτὸ σῶμα μικρῷ καὶ μεγάλῳ ὁμοίως ὑπάρχειν, ἐπεὶ διασπασθήσεται αὐτὸ ἑαυτοῦ, τὸ δὲ ἀσώματον οἷον τὸ καθόλου ζῷον ὁμοίως ὑπάρχει καὶ διπήχει καὶ τριπήχει·", "seq": 927}
{"id": "Elias_Passim_0928", "series": "CAG", "text": "ἀσώματον ἄρα τὸ καθόλου.", "seq": 928}
{"id": "Elias_Passim_0929", "series": "CAG", "text": "ἔτι οὐδέποτε τὸ αὐτὸ σῶμα ἐν διαφόροις κατὰ τὸν αὐτὸν χρόνον θεωρεῖται ἀδιασπάστως, τὰ δὲ γένη καὶ τὰ εἴδη ἀδιασπάστως ἐν διαφόροις θεωρεῖται·", "seq": 929}
{"id": "Elias_Passim_0930", "series": "CAG", "text": "οὐκ ἄρα εἰσὶ σώματα ἀλλ᾿ ἀσώματα’.", "seq": 930}
{"id": "Elias_Passim_0931", "series": "CAG", "text": "Ἀλλὰ καὶ τούτου ἀποδειχθέντος οὐδὲ τότε πέρας ἐποιούμην τῶν ζητήσεων, ἀλλὰ τότε ὁ κολοφών με τῶν ζητημάτων ἐξεδέχετο·", "seq": 931}
{"id": "Elias_Passim_0932", "series": "CAG", "text": "τοῦ γὰρ καθόλου τριττοῦ ὄντος, ἢ πρὸ τῶν πολλῶν ἢ ἐν τοῖς πολλοῖς ἢ ἐπὶ τοῖς πολλοῖς, ὑπὸ ποῖον τούτων τὸ γένος καὶ τὸ εἶδος τελεῖ;", "seq": 932}
{"id": "Elias_Passim_0933", "series": "CAG", "text": "οἷον ὡς ἐπὶ παραδείγματος ὑποκείσθω δακτύλιος ἔχων σφενδόνην καὶ ἐν αὐτῇ ἐκτύπωμα ἑνὸς τῶν ἀριστέων, Ἀχιλλέως ἢ Αἴαντος ἢ Ἕκτορος, καὶ διάφοροι κηροὶ ἀποματτόμενοι τὸ ἐκτύπωμα τοῦ δακτυλίου καί τις ἑστὼς καὶ θεώμενος τὰ ἐν τοῖς κηροῖς, ὃς καὶ ἀναχωρείτω λέγων ‘εἶδον πολλοὺς κηροὺς τὸ αὐτὸ ἐκτύπωμα ἔχοντας’·", "seq": 933}
{"id": "Elias_Passim_0934", "series": "CAG", "text": "ἔστιν οὖν τὸ ἐν τῷ δακτυλίῳ τὸ πρὸ τῶν πολλῶν, τὸ ἐν τοῖς κηροῖς τὸ ἐν τοῖς πολλοῖς, ὁ ἑστὼς καὶ θεασάμενος τοὺς τύπους τὸ ἐπὶ τοῖς πολλοῖς.", "seq": 934}
{"id": "Elias_Passim_0935", "series": "CAG", "text": "καὶ οὕτως μὲν ἐπὶ τοῦ παραδείγματος.", "seq": 935}
{"id": "Elias_Passim_0936", "series": "CAG", "text": "ἐπὶ δὲ τῶν πραγμάτων αὐτῶν τὰ πρὸ τῶν πολλῶν ἐστιν ἐν τῷ δημιουργῷ, τοῦτ᾿ ἔστιν οἱ λόγοι καθ᾿ οὓς τὰ ὄντα δημιουργεῖ (καὶ τούτους τοὺς δημιουργικοὺς λόγους ὁ Πλάτων ἰδέας καλεῖ), τὰ ἐν τοῖς πολλοῖς ἐν τῇ ὕλη, ἐπειδὴ ἀχώριστά εἰσι τῆς ὕλης (ἐν ταύτῃ γὰρ θεωροῦνται), καὶ τὸ εἶναι ἔχουσι τὰ ἐπὶ τοῖς πολλοῖς ἐν ταῖς ψυχαῖς τῶν ἐπιστημόνων·", "seq": 936}
{"id": "Elias_Passim_0937", "series": "CAG", "text": "ἐν γὰρ τῇ τούτων φαντασίᾳ τὸ εἶναι ἔχουσι τὰ γένη καὶ τὰ εἴδη ἤτοι τὰ καθόλου.", "seq": 937}
{"id": "Elias_Passim_0938", "series": "CAG", "text": "Ταῦτα πάντα δυνάμενος ζητῆσαι οὐ ζητήσω, ἀλλ᾿ ὥσπερ ἐπὶ εἰσαγωγικῇ διδασκαλίᾳ διαλεκτικώτερον τὰ περὶ αὐτῶν διδάξω, τοῦτ᾿ ἔστι τί τίνι ὑπόκειται καὶ τί τίνος κατηγορεῖται.", "seq": 938}
{"id": "Elias_Passim_0939", "series": "CAG", "text": "ὑποκείμενον τυχόν ἐστι τὸ περὶ οὗ ὁ λόγος, κατηγορούμενον δὲ τὸ περὶ ἐκείνου λεγόμενον·", "seq": 939}
{"id": "Elias_Passim_0940", "series": "CAG", "text": "οἷον ‘ἄνθρωπος νικᾷ’·", "seq": 940}
{"id": "Elias_Passim_0941", "series": "CAG", "text": "τὸ ἄνθρωπος ὑπόκειται, κατηγορεῖται δὲ τὸ νικᾷ.", "seq": 941}
{"id": "Elias_Passim_0942", "series": "CAG", "text": "ἢ καὶ ἄλλως·", "seq": 942}
{"id": "Elias_Passim_0943", "series": "CAG", "text": "ὑποκείμενόν ἐστι τὸ τῷ ἄρθρῳ συνταττόμενον, κατηγορούμενον δὲ τὸ μὴ συνταττόμενον ἄρθρῳ, οἷον ‘ὁ ἄνθρωπος περιπατεῖ’.", "seq": 943}
{"id": "Elias_Passim_0944", "series": "CAG", "text": "καὶ ἄλλως δέ, ὅτι τὸ μὲν κατηγορούμενον ἢ μεῖζόν ἐστι τοῦ ὑποκειμένου ἢ ἴσον αὐτῷ, ἔλαττον δὲ οὐδέποτε, τὸ δὲ ὑποκείμενον πᾶν τοὐναντίον ἢ ἴσον ἢ ἔλαττον, οὐδέποτε δὲ μεῖζον·", "seq": 944}
{"id": "Elias_Passim_0945", "series": "CAG", "text": "εἰ γὰρ εἴπω ‘ὁ ἄνθρωπος ζῷον’, τὸ ζῷον κατηγορεῖται τοῦ ἀνθρώπου καθολικώτερον αὐτοῦ ὄν, ἐὰν δὲ εἴπω ‘ὁ ἄνθρωπος γελαστικόν’, τὸ γελαστικὸν κατηγορεῖται ἴσον ὂν τῷ ἀνθρώπῳ·", "seq": 945}
{"id": "Elias_Passim_0946", "series": "CAG", "text": "εἴ τι γὰρ ἄνθρωπος, γελαστικόν, καὶ εἴ τι γελαστικόν, ἄνθρωπος.", "seq": 946}
{"id": "Elias_Passim_0947", "series": "CAG", "text": "τὸ δὲ ὑποκείμενον οἷον ὁ ἄνθρωπος ἢ ἴσον ἐστὶ τῷ κατηγορουμένῳ οἷον τῷ γελαστικῷ, ὡς εἴρηται, ἢ ἔλαττον τοῦ κατηγορουμένου οἷον τοῦ ζῴου, οὐδέποτε δὲ μεῖζον.", "seq": 947}
{"id": "Elias_Passim_0948", "series": "CAG", "text": "1.", "seq": 948}
{"id": "Elias_Passim_0949", "series": "CAG", "text": "9 Αὐτίκα περὶ τῶν γενῶν τε καὶ εἰδῶν.", "seq": 949}
{"id": "Elias_Passim_0950", "series": "CAG", "text": "Εἰπὼν ὅτι τῶν βαθυτέρων ἀπέχομαι ζητημάτων προσφόρως ἐπήγαγε τὸ αὐτίκα περὶ τῶν γενῶν τε καὶ εἰδῶν, ὅτι περὶ τούτων ἠδυνάμην πολλὰ ζητῆσαι.", "seq": 950}
{"id": "Elias_Passim_0951", "series": "CAG", "text": "1.", "seq": 951}
{"id": "Elias_Passim_0952", "series": "CAG", "text": "10 Τὸ μὲν εἴτε ὑφέστηκεν.", "seq": 952}
{"id": "Elias_Passim_0953", "series": "CAG", "text": "Διαφέρει ἐπίνοια ψιλῆς ἐπινοίας, ὅτι ἡ ἐπίνοια τὸ ὂν ἄλλως ποιεῖ νοεῖσθαι, οἷον ἐκ τοῦ χαλκοῦ τριγώνου χωρίζουσα τὸ σχῆμα καὶ αὐτὸ καθ᾿ αὑτὸ ἐπινοοῦσα τὸ τρίγωνον, ψιλὴ δὲ ἐπίνοια ἡ τὰ ἀδύνατα τῇ φύσει ἀναπλαττομένη ὡς τραγέλαφον καὶ τὰ τοιαῦτα.", "seq": 953}
{"id": "Elias_Passim_0954", "series": "CAG", "text": "1.", "seq": 954}
{"id": "Elias_Passim_0955", "series": "CAG", "text": "11 Καὶ πότερον χωριστά.", "seq": 955}
{"id": "Elias_Passim_0956", "series": "CAG", "text": "Χωριστὰ τὰ πρὸ τῶν πολλῶν νοητέον, ἐν τοῖς αἰσθητοῖς τὰ ἐν τοῖς πολλοῖς, περὶ ταῦτα ὑφεστῶτα τὰ ἐπὶ τοῖς πολλοῖς, ὡς καὶ ἀνωτέρω εἴρηται.", "seq": 956}
{"id": "Elias_Passim_0957", "series": "CAG", "text": "1.", "seq": 957}
{"id": "Elias_Passim_0958", "series": "CAG", "text": "12 ΠΠαραιτήσομαι λέγειν βαθυτάτης.", "seq": 958}
{"id": "Elias_Passim_0959", "series": "CAG", "text": "Μηδεὶς ἐγκαλείτω τῷ Πορφυρίῳ, ὃ καὶ τοῖς ῥήτορσιν ἐγκαλοῦσιν ὑπισχνουμένοις μὲν σιωπᾶν, λέγουσι δὲ τὰ ὀφείλοντα σιωπηθῆναι·", "seq": 959}
{"id": "Elias_Passim_0960", "series": "CAG", "text": "οὐδὲ γὰρ τοῦτο ἐποίησεν, ἀλλὰ λέγει μὲν τὰ προβλήματα, σιωπᾷ δὲ τὰ ἐπιχειρήματα.", "seq": 960}
{"id": "Elias_Passim_0961", "series": "CAG", "text": "1.", "seq": 961}
{"id": "Elias_Passim_0962", "series": "CAG", "text": "14 Τὸ δὲ ὅπως περὶ αὐτῶν καὶ τῶν προκειμένων.", "seq": 962}
{"id": "Elias_Passim_0963", "series": "CAG", "text": "Μηδεὶς νομίσῃ διττολογεῖν τὸν Πορφύριον εἰπόντα αὐτῶν καὶ τῶν προκειμένων·", "seq": 963}
{"id": "Elias_Passim_0964", "series": "CAG", "text": "αὐτῶν μὲν γὰρ νοητέον γενῶν τε καὶ εἰδῶν (τούτων γὰρ καὶ προσεχῶς ἐμνήσθη), τῶν δὲ προκειμένων ἀντὶ τοῦ ὑφὲν ὅλων ὁμοῦ τῶν πέντε φωνῶν.", "seq": 964}
{"id": "Elias_Passim_0965", "series": "CAG", "text": "<Πρᾶξις ιηʹ>.", "seq": 965}
{"id": "Elias_Passim_0966", "series": "CAG", "text": "Περὶ γένους.", "seq": 966}
{"id": "Elias_Passim_0967", "series": "CAG", "text": "1.", "seq": 967}
{"id": "Elias_Passim_0968", "series": "CAG", "text": "18 Ἔοικε δὲ μήτε τὸ γένος μήτε τὸ εἶδος.", "seq": 968}
{"id": "Elias_Passim_0969", "series": "CAG", "text": "Μετὰ τὰ προοίμια καὶ ἐπ᾿ αὐτοὺς ἰτέον τοὺς ἀγῶνας.", "seq": 969}
{"id": "Elias_Passim_0970", "series": "CAG", "text": "ἀρχὴ δὲ τῶν ἀγώνων ἡμῖν γενέσθω τὸ γένος ὡς καὶ οὐσιῶδες καὶ καθόλου·", "seq": 970}
{"id": "Elias_Passim_0971", "series": "CAG", "text": "ὡς μὲν γὰρ οὐσιῶδες προτέτακται ἰδίου καὶ συμβεβηκότος, ἐπουσιωδῶν ὄντων, καὶ νικᾷ ἐν τούτοις, ὡς δὲ καθόλου νικᾷ διαφορὰν καὶ εἶδος·", "seq": 971}
{"id": "Elias_Passim_0972", "series": "CAG", "text": "τριῶν γὰρ οὐσῶν οὐσιωδῶν φωνῶν καθολικώτατον μὲν τὸ γένος, μερικώτατον δὲ τὸ εἶδος, μέση τούτων ἡ διαφορά, τοῦ μὲν γένους μερικωτέρα, τοῦ δὲ εἴδους καθολικωτέρα.", "seq": 972}
{"id": "Elias_Passim_0973", "series": "CAG", "text": "ἀλλὰ καὶ δι᾿ ἄλλην αἰτίαν ἀπὸ τοῦ γένους ἀρκτέον, διότι τὸ μὲν γένος ῥίζῃ ἔοικε, πρέμνοις αἱ διαφοραί, κλάδοις τὰ εἴδη, παραφυάσι τὰ ἴδια καὶ τὰ συμβεβηκότα.", "seq": 973}
{"id": "Elias_Passim_0974", "series": "CAG", "text": "καὶ ὥσπερ αἱ παραφυάδες μὴ ἔχουσαι οἰκείαν ῥίζαν ἄλλοις παραφύονται καὶ παραπλέκονται, οὕτως καὶ τὰ ἴδια καὶ τὰ συμβεβηκότα μὴ ἔχοντα ἰδίαν ὑπόστασιν παρυφίστανται τοῖς αὐθυποστάτοις.", "seq": 974}
{"id": "Elias_Passim_0975", "series": "CAG", "text": "εἰκότως οὖν ἀπὸ τοῦ γένους ἀρκτέον.", "seq": 975}
{"id": "Elias_Passim_0976", "series": "CAG", "text": "καὶ δι᾿ ἄλλην αἰτίαν τὸ γένος προτακτέον·", "seq": 976}
{"id": "Elias_Passim_0977", "series": "CAG", "text": "γένους γὰρ ὄντος εἴδη εἰσὶ καὶ διαφοραὶ καὶ ἴδια καὶ συμβεβηκότα, τούτου δὲ μὴ ὄντος οὐδὲν τούτων ἔστι.", "seq": 977}
{"id": "Elias_Passim_0978", "series": "CAG", "text": "καὶ μὴ ἀντιστρέψῃς λέγων ὅτι τὸ εἶδος προτακτέον·", "seq": 978}
{"id": "Elias_Passim_0979", "series": "CAG", "text": "εἴδους γὰρ μὴ ὄντος οὐδὲ γένος οὐδὲ διαφορά, οὐκ ἴδιον οὐδὲ συμβεβηκός·", "seq": 979}
{"id": "Elias_Passim_0980", "series": "CAG", "text": "εἰ γὰρ καὶ τὸ γένος τῷ εἴδει αἴτιον καὶ τὸ εἶδος τῷ γένει, ἀλλ᾿ οὐχὶ τὰ αὐτὰ μέτρα·", "seq": 980}
{"id": "Elias_Passim_0981", "series": "CAG", "text": "ὥσπερ γὰρ ὁ πατὴρ παρήγαγε τὸν υἱὸν αἴτιος αὐτῷ γεγονὼς τοῦ εἶναι καὶ τῆς σχέσεως, τοῦτ᾿ ἔστι καὶ τοῦ ἄνθρωπον εἶναι καὶ υἱόν, ὁ δὲ υἱὸς αἴτιος τῷ πατρὶ τῆς σχέσεως μόνης, τοῦτ᾿ ἔστι τοῦ εἶναι αὐτὸν πατέρα, οὐ μὴν καὶ τοῦ ἄνθρωπον εἶναι (ἦν γὰρ ἄνθρωπος, καὶ πρὶν ἂν γένηται πατήρ)·", "seq": 981}
{"id": "Elias_Passim_0982", "series": "CAG", "text": "οὕτως καὶ τὸ γένος αἴτιον τῷ εἴδει καὶ τοῦ εἶναι καὶ τῆς σχέσεως, τὸ δὲ εἶδος αἴτιον τῷ γένει σχέσεως μόνης.", "seq": 982}
{"id": "Elias_Passim_0983", "series": "CAG", "text": "εὐλόγως οὖν ἀπὸ τοῦ γένους δεῖ ἄρξασθαι.", "seq": 983}
{"id": "Elias_Passim_0984", "series": "CAG", "text": "Ἀλλ᾿ ἐπεὶ τὸ γένος ὁμώνυμός ἐστι φωνή (ἐν γὰρ ταῖς δέκα κατηγορίαις θεωρεῖται, εἴ γε ἑκάστη γένος λέγεται, ἀρκεῖ δὲ πρὸς τὸ ποιῆσαι ὁμωνυμίαν τὸ ἐν δύο μόνοις πράγμασι θεωρεῖσθαι, οὔτι λέγω ἐν δέκα), φέρε διαστείλωμεν τὴν ὁμωνυμίαν·", "seq": 984}
{"id": "Elias_Passim_0985", "series": "CAG", "text": "εἰ γὰρ μὴ τοῦτο ποιήσωμεν, εὑρισκόμεθα ἀδιανόητα φθεγγόμενοι, τοῦ μὲν κατὰ ἄλλο σημαινόμενον ἐρωτῶντος, τοῦ δὲ κατὰ ἄλλο νοοῦντος.", "seq": 985}
{"id": "Elias_Passim_0986", "series": "CAG", "text": "ἀλλὰ καὶ ψευδόμεθα μὴ ψευδόμενοι, ὡς ὅταν εἴπωμεν ‘Αἴας ἐμονομάχησεν Ἕκτορι’·", "seq": 986}
{"id": "Elias_Passim_0987", "series": "CAG", "text": "τοῦτο γὰρ καὶ ἀληθὲς καὶ ψεῦδος διὰ τὸ διάφορον τῶν σημαινομένων.", "seq": 987}
{"id": "Elias_Passim_0988", "series": "CAG", "text": "ἀλλὰ καὶ τὸ θαυμαστὸν οἰχήσεται τὸ κοινωνικὸν τῶν ἀνθρώπων πρᾶγμα τῆς οὐσίας ἡμῶν παραστατικόν·", "seq": 988}
{"id": "Elias_Passim_0989", "series": "CAG", "text": "ὡς γὰρ οὐκ ἔστι Πέρσας Αἰγυπτίοις συμπολιτεύεσθαι διὰ τὸ ἀλλότριον τῆς διαλέκτου, οὕτως οὐδὲ οἱ τὰ ὁμώνυμα φθεγγόμενοι δύνανται πολιτεύεσθαι μετ᾿ ἀλλήλων.", "seq": 989}
{"id": "Elias_Passim_0990", "series": "CAG", "text": "ἐπεὶ οὖν ταῦτα οὕτως ἔχει, φέρε τοῖς διηγορευμένοις κανόσιν ὑπὸ Ἀριστοτέλους ἐν τῇ Τοπικῇ πραγματείᾳ περὶ τῆς διακρίσεως τῶν ὁμωνύμων χρησώμεθα·", "seq": 990}
{"id": "Elias_Passim_0991", "series": "CAG", "text": "φησὶ γὰρ ὅτι πράγματος προτεθέντος, οὗ ἡ σημαντικὴ φωνὴ οὐκ αὐτὸ μόνον σημαίνει ἀλλὰ πλείονα, δεῖ τρία τινὰ τότε ποιεῖν, ἀπαριθμεῖσθαι τὰ σημαινόμενα καὶ διορίσαι περὶ οὗ ὁ λόγος κἀκεῖνο ὑπογραφῆς ἢ ὁρισμοῦ ἀξιοῦν·", "seq": 991}
{"id": "Elias_Passim_0992", "series": "CAG", "text": "οὐ γὰρ ἀποδεκτέον τὸν ποιητὴν λέγοντα περὶ τοῦ κυνὸς", "seq": 992}
{"id": "Elias_Passim_0993", "series": "CAG", "text": "ὅς τε φέρει πολλὸν πυρετὸν δειλοῖσι βροτοῖσιν·", "seq": 993}
{"id": "Elias_Passim_0994", "series": "CAG", "text": "ἔδει γὰρ ἀπαριθμήσασθαι τὰ σημαινόμενα καὶ διορίσαι περὶ ποίου ὁ λόγος, ἆρα περὶ ἀστρῴου κυνός, περὶ χερσαίου, περὶ ἐνύδρου, καὶ οὕτως εἰπεῖν ὅπερ ἐβούλετο.", "seq": 994}
{"id": "Elias_Passim_0995", "series": "CAG", "text": "φέρε οὖν εἴπωμεν τὰ σημαινόμενα τοῦ γένους.", "seq": 995}
{"id": "Elias_Passim_0996", "series": "CAG", "text": "Δεῖ εἰδέναι ὅτι τὸ γένος τρία σημαίνει, καὶ ἔστιν ἓν αὐτοῦ σημαινόμενον πλῆθος ἀνθρώπων ἐκ μιᾶς ἀρχῆς προελθὸν μετὰ τῶν ἐξ ἐπιγαμβρίας αὐτοῖς κοινωνησάντων, οὓς ἀγχιστεῖς οἱ ποιηταὶ καλοῦσιν, οἷον οἱ Ἡρακλεῖδαι πλῆθος ὄντες ἀνθρώπων ἐκ μιᾶς ἀρχῆς προελθὸν τοῦ Ἡρακλέους.", "seq": 996}
{"id": "Elias_Passim_0997", "series": "CAG", "text": "ἐνταῦθα δὲ τρεῖς σχέσεις κεκρυμμέναι εἰσίν, ἑνὸς πρὸς πολλοὺς οἷον τοῦ Ἡρακλέους πρὸς τοὺς Ἡρακλείδας, εἴ γε λέγονται οἱ φύσαντες γόνοι καὶ πρόγονοι·", "seq": 997}
{"id": "Elias_Passim_0998", "series": "CAG", "text": "οὐ γάρ πώ τις ἑὸν γόνον αὐτὸς ἀνέγνω·", "seq": 998}
{"id": "Elias_Passim_0999", "series": "CAG", "text": "πολλῶν πρὸς ἕνα.", "seq": 999}
{"id": "Elias_Passim_1000", "series": "CAG", "text": "τῶν Ἡρακλειδῶν πρὸς τὸν Ἡρακλέα, εἴ γε λέγονται ἀπόγονοι καὶ ἔκγονοι καὶ μετέκγονοι καὶ γόνοι πάλιν·", "seq": 1000}
{"id": "Elias_Passim_1001", "series": "CAG", "text": "αἴθ᾿ ὄφελες ἄγονός τ᾿ ἔμεναι ἄγαμός τ᾿ ἀπολέσθαι·", "seq": 1001}
{"id": "Elias_Passim_1002", "series": "CAG", "text": "ἀλλὰ καὶ πολλῶν πρὸς πολλούς, τῶν Ἡρακλειδῶν πρὸς ἀλλήλους, εἴ γε οἱ τοιοῦτοι συγγενεῖς λέγονται.", "seq": 1002}
{"id": "Elias_Passim_1003", "series": "CAG", "text": "δεύτερον σημαινόμενον τοῦ γένους ἡ ἑκάστου τῆς γενέσεως ἀρχή.", "seq": 1003}
{"id": "Elias_Passim_1004", "series": "CAG", "text": "αὕτη δὲ ἢ ἔμψυχος ἢ ἄψυχος, καὶ ἔμψυχος μὲν ὁ πατὴρ ἄψυχος δὲ ἡ πατρίς.", "seq": 1004}
{"id": "Elias_Passim_1005", "series": "CAG", "text": "καὶ καθ᾿ ἑκάτερον ἢ προσεχὲς ἢ πόρρω, οἷον προσεχὲς ἔμψυχον ὁ πατὴρ πόρρω δὲ ὁ πάππος.", "seq": 1005}
{"id": "Elias_Passim_1006", "series": "CAG", "text": "ὁμοίως καὶ τὸ ἄψυχον ἢ προσεχὲς ἢ πόρρω, προσεχὲς μὲν ἡ πατρὶς πόρρω δὲ ἡ τῆς πατρίδος μητρόπολις ἤγουν ἡ ἐπαρχία.", "seq": 1006}
{"id": "Elias_Passim_1007", "series": "CAG", "text": "καὶ ὁ μὲν Πορφύριος ἐπὶ τεσσάρων παραδειγμάτων γυμνάζει τὸν τοιοῦτον λόγον, ἡμεῖς δὲ ἑνὶ καὶ τῷ αὐτῷ ἀρκεσθῶμεν παραδείγματι·", "seq": 1007}
{"id": "Elias_Passim_1008", "series": "CAG", "text": "ἰδοὺ γὰρ ὁ Ἀχιλλεὺς Πηλείδης μὲν διὰ τὸν προσεχῆ πατέρα τὸν Πηλέα, Αἰακίδης δὲ διὰ τὸν πόρρω τὸν Αἰακόν, καὶ Φθιώτης διὰ τὴν προσεχῆ πατρίδα τὴν Φθίαν, καὶ Θετταλὸς διὰ τὴν πόρρω πατρίδα τὴν Θετταλίαν·", "seq": 1008}
{"id": "Elias_Passim_1009", "series": "CAG", "text": "καὶ γὰρ καὶ ἡ πατρὶς ἀρχὴ γενέσεως ὡς ὑποδεξαμένη καὶ ἡμᾶς καὶ τοὺς φύσαντας καὶ ἰδιοτροπίαν ἠθῶν χαριζομένη, εἴ γε καὶ ἡμεῖς οὐκ ἐκ παντὸς ἔθνους βουλόμεθα ὠνεῖσθαι ἀνδράποδα διὰ τὸ καὶ τὴν πατρίδα, καθὰ εἴρηται, ὡς τοὺς γονεῖς ἰδιοτροπίαν ἠθῶν χαρίζεσθαι·", "seq": 1009}
{"id": "Elias_Passim_1010", "series": "CAG", "text": "διὸ καὶ πατρὶς εἴρηται ὡς ἀπὸ τοῦ τιμιωτέρου καὶ οὐχὶ μητρίς.", "seq": 1010}
{"id": "Elias_Passim_1011", "series": "CAG", "text": "ἔστι καὶ τρίτον σημαινόμενον τοῦ γένους, ᾧ ὑποτάσσεται τὸ εἶδος, περὶ οὗ καὶ τοῖς φιλοσόφοις ὁ λόγος.", "seq": 1011}
{"id": "Elias_Passim_1012", "series": "CAG", "text": "ἀλλ᾿ οὐ μέχρι τούτων τὰ σημαινόμενα τοῦ γένους, ὦ Πορφύριε·", "seq": 1012}
{"id": "Elias_Passim_1013", "series": "CAG", "text": "ποῦ γὰρ ταχθήσεται τὰ παρὰ τοῖς γραμματικοῖς τρία γένη, ἀρσενικόν, θηλυκόν, οὐδέτερον;", "seq": 1013}
{"id": "Elias_Passim_1014", "series": "CAG", "text": "ποῦ τὰ παρὰ Πλάτωνι ἐν τῇ θεολογίᾳ πέντε γένη τοῦ ὄντος, οὐσία, ταὐτόν, ἕτερον, κίνησις, στάσις;", "seq": 1014}
{"id": "Elias_Passim_1015", "series": "CAG", "text": "δεῖ γὰρ εἰδέναι ὅτι πάντα τὰ ὄντα, ᾗ μὲν ὄντα εἰσίν, οὐσία λέγονται, ᾗ δὲ κοινωνίαν ἔχουσι, ταὐτὸ καλοῦνται, ᾗ δὲ διαφέρουσιν ἀλλήλων, ἕτερα προσαγορεύονται, ᾗ δὲ κινοῦνται, κίνησις, ᾗ δὲ ἵστανται, στάσις·", "seq": 1015}
{"id": "Elias_Passim_1016", "series": "CAG", "text": "οὕτως γὰρ καὶ αὐτὰ ὁ Πλάτων ἐκάλεσε τὴν μὲν ἑκάστου ὕπαρξιν οὐσίαν, τὴν δὲ κοινωνίαν ταυτότητα, τὴν δὲ διαφορὰν ἑτερότητα, τὴν ἐνέργειαν κίνησιν, τὴν ἀνάπαυλαν αὐτῶν στάσιν.", "seq": 1016}
{"id": "Elias_Passim_1017", "series": "CAG", "text": "ποῦ τὰ παρὰ Ἀριστοτέλει ἐν τῇ Φυσικῇ;", "seq": 1017}
{"id": "Elias_Passim_1018", "series": "CAG", "text": "ἑκάστης γὰρ τέχνης τὸ ὑποκείμενον γένος καλεῖ ὁ Ἀριστοτέλης.", "seq": 1018}
{"id": "Elias_Passim_1019", "series": "CAG", "text": "λεκτέον οὖν ὅτι τὰ μὲν παρὰ γραμματικοῖς παρῆκεν ὡς μὴ συνᾴδοντα τῇ φύσει τῶν πραγμάτων·", "seq": 1019}
{"id": "Elias_Passim_1020", "series": "CAG", "text": "ποῦ γάρ ἐστιν, ὦ γραμματικοί, ἄψυχον ἀρσενικὸν ἢ θηλυκόν;", "seq": 1020}
{"id": "Elias_Passim_1021", "series": "CAG", "text": "καίτοι τὸν κίονα λέγετε ἀρσενικόν, τὴν δὲ θύραν θηλυκόν.", "seq": 1021}
{"id": "Elias_Passim_1022", "series": "CAG", "text": "ποῦ δέ ἐστιν ἔμψυχον, ὃ οὐδὲ ἀρσενικὸν οὐδὲ θηλυκόν;", "seq": 1022}
{"id": "Elias_Passim_1023", "series": "CAG", "text": "τὸ δὲ παιδίον οὐδέτερον λέγεται, <ἔστι> δὲ πάντως ἢ ἀρσενικὸν ἢ θηλυκόν.", "seq": 1023}
{"id": "Elias_Passim_1024", "series": "CAG", "text": "τὰ δὲ παρὰ Πλάτωνι, ἐπεὶ μὴ θεολογῆσαι καιρός, καὶ τὰ παρὰ Ἀριστοτέλει, ἐπεὶ μὴ φυσιολογῆσαι καιρός.", "seq": 1024}
{"id": "Elias_Passim_1025", "series": "CAG", "text": "τῶν οὖν τριῶν σημαινομένων τοῦ γένους μνησθεὶς ὁ φιλόσοφος διέστειλε καὶ διωρίσατο περὶ οὗ ὁ λόγος.", "seq": 1025}
{"id": "Elias_Passim_1026", "series": "CAG", "text": "Πρᾶξις <ιθ΄>.", "seq": 1026}
{"id": "Elias_Passim_1027", "series": "CAG", "text": "1.", "seq": 1027}
{"id": "Elias_Passim_1028", "series": "CAG", "text": "18 Ἔοικε δὲ μήτε τὸ γένος.", "seq": 1028}
{"id": "Elias_Passim_1029", "series": "CAG", "text": "Τὸ ἔοικε τρία σημαίνει·", "seq": 1029}
{"id": "Elias_Passim_1030", "series": "CAG", "text": "τὸ ὅμοιον, ᾗ φαμεν", "seq": 1030}
{"id": "Elias_Passim_1031", "series": "CAG", "text": "βασιλῆι γὰρ ἀνδρὶ ἔοικε,", "seq": 1031}
{"id": "Elias_Passim_1032", "series": "CAG", "text": "καὶ τὸ πρέπει, καθό φαμεν", "seq": 1032}
{"id": "Elias_Passim_1033", "series": "CAG", "text": "οὐκ ἔστ᾿ οὐδ᾿ ἐπέοικε τεὸν ἔπος ἀρνήσασθαι,", "seq": 1033}
{"id": "Elias_Passim_1034", "series": "CAG", "text": "καὶ τὸ φαίνεται, ᾗ φαμεν ‘οὑτοσὶ ὁ προσιὼν ἔοικε Σωκράτης εἶναι’.", "seq": 1034}
{"id": "Elias_Passim_1035", "series": "CAG", "text": "ἐνταῦθα οὖν τὸ ἔοικε τὸ φαίνεται δηλοῖ·", "seq": 1035}
{"id": "Elias_Passim_1036", "series": "CAG", "text": "φαίνεται γὰρ τὸ γένος καὶ τὸ εἶδος μὴ ἁπλῶς λεγόμενα.", "seq": 1036}
{"id": "Elias_Passim_1037", "series": "CAG", "text": "διὰ τί δέ, φασί, γένους μνησθεὶς καὶ εἴδους ἐμνημόνευσε;", "seq": 1037}
{"id": "Elias_Passim_1038", "series": "CAG", "text": "καὶ λέγομεν ὅτι ἐπειδὴ τῶν πρός τί εἰσι τὸ γένος καὶ τὸ εἶδος, τὰ δὲ πρός τι χωρὶς ἀλλήλων οὔτε ἔστιν οὔτε γινώσκεται.", "seq": 1038}
{"id": "Elias_Passim_1039", "series": "CAG", "text": "1.", "seq": 1039}
{"id": "Elias_Passim_1040", "series": "CAG", "text": "18 Ἁπλῶς λέγεσθαι.", "seq": 1040}
{"id": "Elias_Passim_1041", "series": "CAG", "text": "Τὸ ἁπλῶς τρία σημαίνει, κυρίως, καθόλου καὶ μοναχῶς·", "seq": 1041}
{"id": "Elias_Passim_1042", "series": "CAG", "text": "κυρίως μέν, ὡς ὅταν φαμὲν ὅτι ‘ἄνθρωπος ὁ γεγραμμένος, ἁπλῶς δὲ ἄνθρωπος ὁ Σωκράτης ὁ καὶ διαλεγόμενος’, τοῦτ᾿ ἔστιν οὗτός ἐστι κυρίως ἄνθρωπος.", "seq": 1042}
{"id": "Elias_Passim_1043", "series": "CAG", "text": "καθόλου δέ, ὡς ὅταν φαμὲν ὅτι ‘καὶ Σωκράτης ἄνθρωπος καὶ Ἀλκιβιάδης, ἁπλῶς δὲ ἄνθρωπος ζῷον λογικὸν θνητόν’ ἀντὶ τοῦ καθόλου.", "seq": 1043}
{"id": "Elias_Passim_1044", "series": "CAG", "text": "μοναχῶς δέ, ὡς ὅταν λέγηται", "seq": 1044}
{"id": "Elias_Passim_1045", "series": "CAG", "text": "ἁπλοῦς ὁ μῦθος τῆς ἀληθείας ἔφυ", "seq": 1045}
{"id": "Elias_Passim_1046", "series": "CAG", "text": "ἀντὶ τοῦ μοναχῶς.", "seq": 1046}
{"id": "Elias_Passim_1047", "series": "CAG", "text": "ἐνταῦθα οὖν τὸ ἁπλῶς μοναχῶς δηλοῖ, ὅτι οὐ μονοειδὴς ὁ τοῦ γένους λόγος, ἀλλ᾿ ὁμώνυμον τὸ γένος καὶ πολλὰ σημαίνει, ὡς ἤδη εἴρηται ἀνωτέρω.", "seq": 1047}
{"id": "Elias_Passim_1048", "series": "CAG", "text": "1.", "seq": 1048}
{"id": "Elias_Passim_1049", "series": "CAG", "text": "18 Γένος γὰρ λέγεται καὶ ἡ τινῶν ἐχόντων πως πρὸς ἕν τι καὶ ἡ πρὸς ἀλλήλους ἄθροισις, καθ᾿ ὃ σημαινόμενον τὸ Ἡρακλειδῶν λέγεται γένος ἐκ τῆς ἀφ᾿ ἑνὸς σχέσεως.", "seq": 1049}
{"id": "Elias_Passim_1050", "series": "CAG", "text": "Ἐνταῦθα τὰς σχέσεις δηλοῖ τοῦ πρώτου σημαινομένου·", "seq": 1050}
{"id": "Elias_Passim_1051", "series": "CAG", "text": "τὸ γὰρ ἡ τινῶν ἐχόντων πως πρὸς ἕν τι δηλοῖ τὴν τῶν πολλῶν πρὸς ἕνα σχέσιν, τὸ δὲ καὶ ἡ πρὸς ἀλλήλους ἄθροισις δηλοῖ τὴν τῶν πολλῶν πρὸς πολλούς, ἐπειδὴ οὐ πάντες οὗτοι ὁμοίως ἔχουσι πρὸς ἀλλήλους (οἱ μὲν γὰρ ἀδελφοί, οἱ δὲ ἀνεψιοί, οἱ δὲ ἐπιγαμβρεύσαντες), τὸ δὲ καθ᾿ ὃ σημαινόμενον τὸ Ἡρακλειδῶν λέγεται γένος δηλοῖ τὴν ἀφ᾿ ἑνὸς πρὸς πολλοὺς σχέσιν.", "seq": 1051}
{"id": "Elias_Passim_1052", "series": "CAG", "text": "1.", "seq": 1052}
{"id": "Elias_Passim_1053", "series": "CAG", "text": "22 Κατὰ ἀποτομὴν τῶν ἄλλων γενῶν.", "seq": 1053}
{"id": "Elias_Passim_1054", "series": "CAG", "text": "Ἀποτομὰς καλεῖ τὰ ὀνόματα οἷον Ἡρακλειδῶν, Πελοπιδῶν, Αἰακιδῶν, ἐπειδὴ τὰ ὀνόματα ἀποτέμνουσι καὶ ἀποχωρίζουσι τὰ διάφορα πράγματα ἀπ᾿ ἀλλήλων·", "seq": 1054}
{"id": "Elias_Passim_1055", "series": "CAG", "text": "τὸ γὰρ Ἡρακλειδῶν ὄνομα ἀποτέμνει ἀφ᾿ ἑαυτοῦ καὶ ἀποχωρίζει τοὺς Πελοπίδας καὶ Αἰακίδας καὶ Κεκροπίδας.", "seq": 1055}
{"id": "Elias_Passim_1056", "series": "CAG", "text": "2.", "seq": 1056}
{"id": "Elias_Passim_1057", "series": "CAG", "text": "5 Καὶ ἒοικε πρόχειρον.", "seq": 1057}
{"id": "Elias_Passim_1058", "series": "CAG", "text": "Πρὶν εἰπεῖν τὸ τρίτον σημαινόμενον τοῦ γένους συγκρίνει τὰ δύο πρῶτα καὶ ἕκαστον αὐτῶν πρῶτον λέγει.", "seq": 1058}
{"id": "Elias_Passim_1059", "series": "CAG", "text": "καὶ πῶς πρῶτον δευτέρου μὴ ὄντος λέγει;", "seq": 1059}
{"id": "Elias_Passim_1060", "series": "CAG", "text": "καὶ λέγομεν ὅτι ἐνδέχεται ἑκάτερον αὐτῶν πρῶτον εἶναι κατὰ ἄλλο καὶ ἄλλο·", "seq": 1060}
{"id": "Elias_Passim_1061", "series": "CAG", "text": "τὸ μὲν γὰρ τῇ συνηθείᾳ πρῶτον τὸ πλῆθος τῶν ἀνθρώπων·", "seq": 1061}
{"id": "Elias_Passim_1062", "series": "CAG", "text": "ἀκούσαντες γὰρ γένους εἰς ἔννοιαν πολλῶν ἀνθρώπων ἐρχόμεθα, διὸ καὶ πρόχειρον αὐτὸ εἶπεν, οὐχ ἁπλῶς πρῶτον·", "seq": 1062}
{"id": "Elias_Passim_1063", "series": "CAG", "text": "πρῶτον γάρ ἐστι τὸ τῇ φύσει πρῶτον, τοῦτ᾿ ἔστιν ἡ ἑκάστου τῆς γενέσεως ἀρχή, ὅ τε πατὴρ καὶ ἡ πατρίς·", "seq": 1063}
{"id": "Elias_Passim_1064", "series": "CAG", "text": "πρῶτον γὰρ γίνεται εἷς ἐξ ἑνός, καὶ εἶθ᾿ οὕτως πολλοὶ ἐξ ἑνός.", "seq": 1064}
{"id": "Elias_Passim_1065", "series": "CAG", "text": "καὶ θαυμαστὸν ὅτι τὰ τῇ φύσει πρῶτα δεύτερα ἡμῖν φαίνεται καὶ τὰ δεύτερα τῇ φύσει πρῶτα ἡμῖν φαίνεται, οἷον ὁ Σωκράτης ἡμῖν πρῶτός ἐστι, τῇ δὲ φύσει δεύτερος·", "seq": 1065}
{"id": "Elias_Passim_1066", "series": "CAG", "text": "σκοπὸν γὰρ ἔχει ἡ φύσις οὐ Σωκράτην ποιῆσαι ἀλλ᾿ ἁπλῶς ἄνθρωπον, οὗτος δὲ ἔκ τινος περιστάσεως γενόμενος φαλακρὸς ἢ προγάστωρ γέγονε Σωκράτης·", "seq": 1066}
{"id": "Elias_Passim_1067", "series": "CAG", "text": "ὁ δὲ καθόλου ἄνθρωπος ἔμπαλιν τῇ φύσει πρῶτος ὢν ἡμῖν δεύτερός ἐστι.", "seq": 1067}
{"id": "Elias_Passim_1068", "series": "CAG", "text": "καὶ οὐ μόνον ἡμεῖς ἀντιπεπόνθαμεν τῇ φύσει, ἀλλὰ καὶ ἡ θεωρία τῇ πράξει·", "seq": 1068}
{"id": "Elias_Passim_1069", "series": "CAG", "text": "τὸ γὰρ τέλος τῆς θεωρίας ἀρχὴ τῆς πράξεως γίνεται·", "seq": 1069}
{"id": "Elias_Passim_1070", "series": "CAG", "text": "οἷον βουλόμεθα σῶσαι τὸ ζῷον ἀπὸ θάλπους καὶ κρύους καὶ ὄμβρου καὶ ἀνέμων, οὐκοῦν δεῖ ποιῆσαι αὐτῷ ὀροφήν·", "seq": 1070}
{"id": "Elias_Passim_1071", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ αὕτη μένειν χωρὶς τοίχων οὐ δύναται, δεῖ ἀναστῆσαι τοίχους τοὺς συνέχοντας·", "seq": 1071}
{"id": "Elias_Passim_1072", "series": "CAG", "text": "ἐπεὶ δὲ οὗτοι στῆναι οὐ δύνανται μὴ θεμελίων καταβληθέντων, δεῖ καὶ θεμελίους καταβαλέσθαι, καὶ ἐπειδὴ οὗτοι γενέσθαι οὐ δύνανται μὴ ὀρυσσομένης τῆς γῆς, δεῖ ὀρύξαι τὴν γῆν·", "seq": 1072}
{"id": "Elias_Passim_1073", "series": "CAG", "text": "καὶ λήγει μὲν ἡ θεωρία εἰς τοῦτο, ἄρχεται δὲ ἡ πρᾶξις ἀπὸ τῆς ὀρύξεως τῆς γῆς.", "seq": 1073}
{"id": "Elias_Passim_1074", "series": "CAG", "text": "2.", "seq": 1074}
{"id": "Elias_Passim_1075", "series": "CAG", "text": "10 Ἄλλως δὲ πάλιν γένος λέγεται, ᾧ ὑποτάσσεται τὸ εἶδος, καθ᾿ ὁμοιότητα ἴσως τούτων εἰρημένον.", "seq": 1075}
{"id": "Elias_Passim_1076", "series": "CAG", "text": "Τὸ τρίτον σημαινόμενον τοῦ γένους, περὶ οὗ παρὰ τοῖς φιλοσόφοις ὁ λόγος, καθ᾿ ὁμοιότητα ἴσως τῶν πρώτων γενῶν εἴρηται·", "seq": 1076}
{"id": "Elias_Passim_1077", "series": "CAG", "text": "ὥσπερ γὰρ τὸ πρῶτον γένος πολλῶν περιεκτικόν ἐστιν, οὕτως καὶ τὸ εἰς εἴδη διαιρούμενον πολλῶν ἐστι περιεκτικόν, καὶ ὥσπερ τὸ δεύτερον γένος, τοῦτ᾿ ἔστιν ἡ ἑκάστου τῆς γενέσεως ἀρχή, ὁ πατὴρ καὶ ἡ πατρίς, ὅλα ἑαυτὰ παρέσχον τοῖς ἐξ αὑτῶν (οὐδὲ γάρ ἐστι μᾶλλον τοῦδε πατὴρ ἢ πατρὶς καὶ ἧττον τοῦδε), οὕτως καὶ τοῦτο τὸ γένος ὅλον ἑαυτὸ ἑκάστῳ τῷ εἴδει παρέσχεν·", "seq": 1077}
{"id": "Elias_Passim_1078", "series": "CAG", "text": "οὐδὲ γάρ ἐστι μᾶλλον ζῷον καὶ ἧττον ζῷον.", "seq": 1078}
{"id": "Elias_Passim_1079", "series": "CAG", "text": "<Πρᾶξις κ΄.", "seq": 1079}
{"id": "Elias_Passim_1080", "series": "CAG", "text": ">", "seq": 1080}
{"id": "Elias_Passim_1081", "series": "CAG", "text": "2.", "seq": 1081}
{"id": "Elias_Passim_1082", "series": "CAG", "text": "15 Ὃ καὶ ὑπογράφοντες ἀποδεδώκασι.", "seq": 1082}
{"id": "Elias_Passim_1083", "series": "CAG", "text": "Ἀπαριθμησάμενος τὰ σημαινόμενα τοῦ γένους ὁ Πορφύριος, ὅτι τρία, καὶ διορίσας περὶ ποίου ὁ λόγος, βούλεται τοῦτο ὑπογραφῆς ἢ ὁρισμοῦ ἀξιῶσαι.", "seq": 1083}
{"id": "Elias_Passim_1084", "series": "CAG", "text": "καὶ ἔδει μὲν αὐτὸν μέλλοντα τῶν περὶ τοιούτου γένους ἀπάρχεσθαι λόγων ἀπὸ τοῦ εἰ ἔστιν ἄρξασθαι, ἀλλ᾿ ἐπειδὴ τοῦτο ἔφθη παραιτησάμενος, ἡνίκα ἔλεγεν ‘τῶν μὲν βαθυτέρων ἀπέχομαι ζητημάτων καὶ εἴτε ὑφέστηκεν εἴτε μή’, ἐπὶ τὸ τί ἐστιν ἔρχεται.", "seq": 1084}
{"id": "Elias_Passim_1085", "series": "CAG", "text": "τὸ δὲ τί ἐστιν τοῦ ὁρισμοῦ πρόσρημα ἢ ὑπογραφῆς.", "seq": 1085}
{"id": "Elias_Passim_1086", "series": "CAG", "text": "διαφέρει δὲ ταῦτα ἀλλήλων, ὅτι ὁ μὲν ὁρισμὸς ἐκ τῶν κατ᾿ οὐσίαν λαμβάνεται, ἡ δὲ ὑπογραφὴ ἐκ τῶν κατὰ συμβεβηκός.", "seq": 1086}
{"id": "Elias_Passim_1087", "series": "CAG", "text": "χείρων δὲ ἡ ὑπογραφὴ τοῦ ὁρισμοῦ, ὅθεν καὶ ὑπογραφὴ λέγεται ὡς ὑπὸ τὴν γραφὴν τελοῦσα, τοῦ ὁρισμοῦ τῇ τελείᾳ μορφῇ τῆς γραφῆς ἀναλογοῦντος τῇ ἐν χρώμασι τῆς δὲ ὑπογραφῆς τῇ σκιαγραφίᾳ καὶ λευκογραφίᾳ.", "seq": 1087}
{"id": "Elias_Passim_1088", "series": "CAG", "text": "ἐνταῦθα οὖν τὸ τί ἐστιν ἐπὶ τῆς ὑπογραφῆς κεῖται·", "seq": 1088}
{"id": "Elias_Passim_1089", "series": "CAG", "text": "ὑπογράφει γὰρ τὸ γένος, οὐχ ὁρίζεται.", "seq": 1089}
{"id": "Elias_Passim_1090", "series": "CAG", "text": "καὶ εἰκότως, ἐπειδὴ οἱ ὁρισμοὶ ἐκ γένους καὶ διαφορῶν λαμβάνονται, τοῦ δὲ γένους οὐκ ἔστιν ὑπεραναβεβηκὸς γένος.", "seq": 1090}
{"id": "Elias_Passim_1091", "series": "CAG", "text": "διὰ τοῦτο οὐχ ὁρίζεται αὐτό, ἀλλ᾿ ὑπογράφει.", "seq": 1091}
{"id": "Elias_Passim_1092", "series": "CAG", "text": "ἀλλ᾿ ὅσον ἐπὶ τοῦτο ἔδει τὸ εἶδος ὁρίσασθαι (τοῦ γὰρ εἴδους ἔστι γένος), διὸ ῥητέον ἄλλην αἰτίαν, δι᾿ ἣν οὐδεμίαν τῶν πέντε φωνῶν ὁρίζεται.", "seq": 1092}
{"id": "Elias_Passim_1093", "series": "CAG", "text": "δεῖ εἰδέναι ὅτι αἱ πέντε φωναὶ ὁμώνυμοί εἰσιν ὡς διὰ πάσης χωροῦσαι κατηγορίας, τῶν δὲ ὁμωνύμων οὐκ ἔστιν ὁρισμός, εἴ γε οἱ ὁρισμοὶ κοινωνίαν πραγμάτων ζητοῦσιν, οὐχὶ ὀνομάτων (ὧν γὰρ οἱ ὅροι οἱ αὐτοί, τούτων καὶ τὰ πράγματα ταὐτά), τὰ δὲ ὁμώνυμα τοὐναντίον κοινωνίαν ὀνομάτων, οὐχὶ πραγμάτων.", "seq": 1093}
{"id": "Elias_Passim_1094", "series": "CAG", "text": "διὸ εὐλόγως ὑπογράφει τὸ γένος καὶ οὐχ ὁρίζεται.", "seq": 1094}
{"id": "Elias_Passim_1095", "series": "CAG", "text": "δεῖ εἰδέναι ὅτι ἕκαστον ὄν, καθὸ μὲν λέγεται ἕν, δηλοῦται δι᾿ ὀνόματος, καθὸ δὲ ἐκ πλειόνων σύγκειται, ταῦτα τὰ πλείονα ἢ οὐσιώδη ἐστὶν ἢ ἐπεισοδιώδη, καὶ εἰ μὲν οὐσιώδη, ποιεῖ τὸν ὁρισμόν, εἰ δὲ ἐπεισοδιώδη, ποιεῖ τὴν ὑπογραφήν.", "seq": 1095}
{"id": "Elias_Passim_1096", "series": "CAG", "text": "ἀποροῦσι δέ τινες ὅτι οἱ ὁρισμοὶ ἐκ γένους καὶ συστατικῶν διαφορῶν συνίστανται, καὶ τὸ μὲν γένος ἐν τῷ τί ἐστι κατηγορεῖται ἡ δὲ διαφορὰ ἐν τῷ ποῖόν τί ἐστι, καὶ τὸ μὲν γένος ἓν ἐν τοῖς ὁρισμοῖς, πολλαὶ δὲ αἱ διαφοραί·", "seq": 1096}
{"id": "Elias_Passim_1097", "series": "CAG", "text": "τί δήποτε;", "seq": 1097}
{"id": "Elias_Passim_1098", "series": "CAG", "text": "μὴ καὶ οἱ ὁρισμοὶ ἐν τῷ ποῖόν τί ἐστι κατηγοροῦνται ἀκολουθοῦντες οὐ τῷ γένει τῷ ἑνὶ ἀλλὰ ταῖς διαφοραῖς ταῖς πολλαῖς ταῖς καὶ τὸ κῦρος ἐν αὑταῖς ἐπεχούσαις, αἵτινες καὶ εἰδοποιοῦσι τὸν ὁρισμὸν τοῦ γένους ὕλῃ ἐοικότος ἀμόρφῳ;", "seq": 1098}
{"id": "Elias_Passim_1099", "series": "CAG", "text": "καὶ λέγομεν πρὸς τοῦτο ὅτι οὐκ ἔμειναν αἱ διαφοραὶ ἐν τοῖς ὁρισμοῖς διαφοραί, ἀλλ᾿ ὡς συλληφθεῖσαι τῷ γένει εἴδη ἐγένοντο, ζῷον λογικόν, ζῷον θνητόν, ζῷον νοῦ καὶ ἐπιστήμης δεκτικόν, ἅπερ ἐστὶν εἴδη, ὡς μαθησόμεθα·", "seq": 1099}
{"id": "Elias_Passim_1100", "series": "CAG", "text": "τὸ δὲ εἶδος ἐν τῷ τί ἐστι κατηγορεῖται, διὸ καὶ οἱ ὁρισμοὶ ἐν τῷ τί ἐστι κατηγοροῦνται.", "seq": 1100}
{"id": "Elias_Passim_1101", "series": "CAG", "text": "Ἐφ᾿ οἷς ὑπογράφει τὸ γένος οὕτως·", "seq": 1101}
{"id": "Elias_Passim_1102", "series": "CAG", "text": "γένος ἐστὶ τὸ κατὰ πλειόνων καὶ διαφερόντων τῷ εἴδει ἐν τῷ τί ἐστι κατηγορούμενον, οἷον τὸ ζῷον·", "seq": 1102}
{"id": "Elias_Passim_1103", "series": "CAG", "text": "τοῦτο γὰρ κατὰ πλειόνων καὶ διαφερόντων τῷ εἴδει κατηγορεῖται, οἷον ἵππου καὶ ἀνθρώπου, οἳ τῷ εἴδει διαφέρουσιν.", "seq": 1103}
{"id": "Elias_Passim_1104", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ ὃ πῦρ ἐν χρυσῷ, τοῦτο ὁρισμὸς ἐν ὁριστῷ καὶ ὑπογραφὴ ἐν ὑπογραφομένῳ·", "seq": 1104}
{"id": "Elias_Passim_1105", "series": "CAG", "text": "τὸ γὰρ πῦρ ἀποχωρίζει τὸν χρυσὸν ἀπὸ πάντων τῶν ἀλλοτρίων, καὶ πρῶτον μὲν τῶν ἀλλοτριωτάτων οἷον ῥύπου καὶ μολύβδου, εἶτα ἀπὸ τοῦ σύνεγγυς οἷον χαλκοῦ (συγγενὴς γὰρ ὁ χαλκὸς τῷ χρυσῷ διὰ τὸ ὁμόχροον)·", "seq": 1105}
{"id": "Elias_Passim_1106", "series": "CAG", "text": "οὕτως καὶ ὁ ὁρισμὸς ἀποχωρίζει τὸ ὁριστὸν ἀπὸ τῶν λοιπῶν·", "seq": 1106}
{"id": "Elias_Passim_1107", "series": "CAG", "text": "ἐὰν γὰρ εἴπω ζῷον, ἐχώρισα τῶν ἀψύχων, εἰ δὲ λογικόν, ἐχώρισα τῶν ἀλόγων, εἰ δὲ θνητόν, ἐχώρισα τῶν ἀθανάτων λογικῶν.", "seq": 1107}
{"id": "Elias_Passim_1108", "series": "CAG", "text": "ὁμοίως καὶ ἡ ὑπογραφή·", "seq": 1108}
{"id": "Elias_Passim_1109", "series": "CAG", "text": "ἐὰν γὰρ εἴπω ὅτι Σωκράτης Ἀθηναῖος, ἐχώρισα τῶν ξένων, υἱὸς Σωφρονίσκου, ἐχώρισα τῶν πολιτῶν, φιλόσοφος, ἐχώρισα τῶν ἀδελφῶν·", "seq": 1109}
{"id": "Elias_Passim_1110", "series": "CAG", "text": "φέρε οὖν καὶ τὴν παροῦσαν ὑπογραφὴν τοῦ γένους δείξωμεν τὰ πυρὸς καὶ ὁρισμοῦ ποιήσασαν·", "seq": 1110}
{"id": "Elias_Passim_1111", "series": "CAG", "text": "ἑπτὰ γὰρ οὐσῶν τῶν φωνῶν, οὔτι λέγω φιλοσόφων μόνον ἀλλὰ καὶ ἀφιλοσόφων, τοῦτ᾿ ἔστι μερικῶν <καὶ> ἀσήμων, καὶ τῶν παρὰ φιλοσόφοις πέντε, ἡ παροῦσα ὑπογραφὴ τῶν ἓξ ἐχώρισεν τὸ γένος·", "seq": 1111}
{"id": "Elias_Passim_1112", "series": "CAG", "text": "διὰ μὲν γὰρ τοῦ εἰπεῖν κατὰ πλειόνων ἐχώρισε τῶν καθ᾿ ἑνὸς μόνου κατηγορουμένων, τοῦτ᾿ ἔστι μερικῶν, διὰ δὲ τοῦ εἰπεῖν διαφερόντων τῷ εἴδει ἐχώρισεν αὐτὸ ἀπὸ τοῦ ἰδίου καὶ εἴδους (ταῦτα γὰρ κατὰ πλειόνων καὶ διαφερόντων τῷ ἀριθμῷ κατηγοροῦνται), διὰ δὲ τοῦ εἰπεῖν ἐν τῷ τί ἐστιν ἐχώρισεν αὐτὸ διαφορᾶς καὶ συμβεβηκότος (ταῦτα γὰρ ἐν τῷ ποῖόν τι κατηγοροῦνται·", "seq": 1112}
{"id": "Elias_Passim_1113", "series": "CAG", "text": "ἐρωτηθέντες γὰρ τί ἐστιν ἄνθρωπος, ζῷον ἀποκρινόμεθα, ἐρωτηθέντες δὲ ποῖόν τί ἐστιν ἄνθρωπος, λογικόν, καὶ ποῖόν τί ἐστι κόραξ, μέλαν ἀποκρινόμεθα)·", "seq": 1113}
{"id": "Elias_Passim_1114", "series": "CAG", "text": "διὰ δὲ τοῦ εἰπεῖν κατηγορούμενον ἐχώρισε τῶν ἀσήμων·", "seq": 1114}
{"id": "Elias_Passim_1115", "series": "CAG", "text": "αἱ γὰρ ἄσημοι ὕπαρξιν μὴ δηλοῦσαι ὅλως οὐδὲ κατηγοροῦνται.", "seq": 1115}
{"id": "Elias_Passim_1116", "series": "CAG", "text": "Ἀποροῦσι δέ τινες ὅτι ‘πόθεν λέγομεν τὸν ἀποδοθέντα τοῦ γένους λόγον, τὸν λέγοντα γένος ἐστὶ τὸ κατὰ πλειόνων καὶ διαφερόντων τῷ εἴδει ἐν τῷ τί ἐστι κατηγορούμενον, ὑπογραφὴν εἶναι καὶ οὐχὶ ὅρον;’", "seq": 1116}
{"id": "Elias_Passim_1117", "series": "CAG", "text": "λεκτέον οὖν τούτου αἰτίας τρεῖς·", "seq": 1117}
{"id": "Elias_Passim_1118", "series": "CAG", "text": "πρώτην μὲν ὅτι ἐκ τοῦ εἰπεῖν πλειόνων δῆλόν ἐστιν ὅτι ὑπογραφή ἐστι καὶ ἐκ τῶν κατὰ συμβεβηκὸς ἐνυπαρχόντων τῷ ὑποκειμένῳ τὸν λόγον ἐποιήσατο·", "seq": 1118}
{"id": "Elias_Passim_1119", "series": "CAG", "text": "οὐδὲ γὰρ τῷ ζῴῳ οὐσιωδῶς ὑπάρχει τὸ κατὰ πλειόνων κατηγορεῖσθαι·", "seq": 1119}
{"id": "Elias_Passim_1120", "series": "CAG", "text": "ἐνεδέχετο γὰρ αὐτὸ ὑφεστάναι ὡς εἰ καὶ μὴ πλειόνων κατηγορεῖτο τοσοῦτον, ὅτι ἐν τῷ οἰκείῳ ὁρισμῷ τὸ ζῷον οὐκ ἔχει τὸ κατὰ πλειόνων κατηγορεῖσθαι·", "seq": 1120}
{"id": "Elias_Passim_1121", "series": "CAG", "text": "ζῷον γάρ ἐστιν οὐσία ἔμψυχος αἰσθητική.", "seq": 1121}
{"id": "Elias_Passim_1122", "series": "CAG", "text": "τὸ οὖν κατὰ πλειόνων κατηγορεῖσθαι ἐπισυμβέβηκεν αὐτῷ καὶ οὐκ ἔστιν αὐτῷ οὐσιῶδες.", "seq": 1122}
{"id": "Elias_Passim_1123", "series": "CAG", "text": "εἰ οὖν οἱ ὁρισμοὶ ἐκ τῶν οὐσιωδῶς ἐνυπαρχόντων λαμβάνονται, αἱ δὲ ὑπογραφαὶ ἐκ τῶν ἐπεισοδιωδῶν, οὐκ ἔστι δὲ τὸ γένος οὐσιῶδες τῷ ζῴῳ, ἀλλ᾿ ἐπισυμβέβηκεν αὐτῷ καὶ ἐπεισοδιῶδες αὐτῷ ἐστι, καλῶς φαμεν ὅτι ὑπογραφή ἐστιν ὁ ἀποδοθεὶς λόγος, οἷα μὴ ἐκ τῶν οὐσιωδῶν λαμβανόμενος, καὶ οὐχ ὁρισμός.", "seq": 1123}
{"id": "Elias_Passim_1124", "series": "CAG", "text": "αὕτη πρώτη αἰτία.", "seq": 1124}
{"id": "Elias_Passim_1125", "series": "CAG", "text": "δευτέρα δὲ ὅτι ὁ ἀποδοθεὶς λόγος ὑπογραφὴ καὶ οὐχ ὁρισμός ἐστι·", "seq": 1125}
{"id": "Elias_Passim_1126", "series": "CAG", "text": "οὐδέποτε γὰρ ἐν ἀποδόσει ὁρισμοῦ κέχρηται τῇ ὑπαλλήλῳ ἤτοι διαλλήλῳ δείξει·", "seq": 1126}
{"id": "Elias_Passim_1127", "series": "CAG", "text": "εἰ οὖν κέχρηται ἐνταῦθα τῇ διαλλήλῳ δείξει, ὡς μικρὸν ὕστερον μαθησόμεθα, φάσκων ἐν μὲν τῷ λόγῳ τοῦ γένους ‘γένος ἐστὶ τὸ διαιρούμενον εἰς εἴδη’ ἐν δὲ τῷ λόγῳ τοῦ εἴδους ‘εἶδός ἐστι τὸ ὑποκείμενον τῷ γένει’, αὕτη δὲ διάλληλός ἐστι δεῖξις, οὐ δύναται ὁ ἀποδοθεὶς λόγος εἶναι ὁρισμός·", "seq": 1127}
{"id": "Elias_Passim_1128", "series": "CAG", "text": "οὐδὲ γάρ, ὡς εἴρηται, ἐν ὁρισμῷ εἰώθασιν οἱ φιλόσοφοι τῇ διαλλήλῳ δείξει κεχρῆσθαι.", "seq": 1128}
{"id": "Elias_Passim_1129", "series": "CAG", "text": "λείπεται οὖν τὸν ἀποδοθέντα τοῦ γένους λόγον ὑπογραφὴν εἶναι.", "seq": 1129}
{"id": "Elias_Passim_1130", "series": "CAG", "text": "τρίτη πάλιν ἐστὶν ἀπόδειξις αὕτη·", "seq": 1130}
{"id": "Elias_Passim_1131", "series": "CAG", "text": "αἱ ὑπογραφαὶ ἀεὶ ἐκ τῶν κάτω λαμβάνονται, οἱ δὲ ὁρισμοὶ ἐκ τῶν ἄνω·", "seq": 1131}
{"id": "Elias_Passim_1132", "series": "CAG", "text": "ὁριζόμενοι μὲν γὰρ τὸν ἄνθρωπόν φαμεν ‘ζῷον λογικὸν θνητὸν νοῦ καὶ ἐπιστήμης δεκτικόν’ ἀπὸ τῶν ἄνω κειμένων ἀρξάμενοι, λέγω δὴ τοῦ ζῴου, ὑπογραφόμενοι δὲ ἐκ τῶν κάτω·", "seq": 1132}
{"id": "Elias_Passim_1133", "series": "CAG", "text": "οὕτως καὶ αὐτὸ τὸ γένος ὑπογράφομεν καί φαμεν τὸ κατὰ πλειόνων ἐκ τῶν κάτω λαβόντες τὴν ὑπογραφήν·", "seq": 1133}
{"id": "Elias_Passim_1134", "series": "CAG", "text": "τὰ γὰρ πλείονα κάτω εἰσί.", "seq": 1134}
{"id": "Elias_Passim_1135", "series": "CAG", "text": "ζητοῦσιν οὖν τινες ὅτι ‘ἐὰν εὑρεθῇ ἐν τῷ ὁρισμῷ μία φωνὴ ἐπεισοδιώδης, πᾶσαι δὲ αἱ λοιπαὶ οὐσιώδεις ὦσι, τί δέον καλεῖν τοῦτον τὸν λόγον, ὁρισμὸν ἢ ὑπογραφήν;", "seq": 1135}
{"id": "Elias_Passim_1136", "series": "CAG", "text": "ὁρισμὸν μὲν γὰρ οὐ δυνατόν, ἐπειδὴ ὁ ὁρισμὸς ἐκ τῶν οὐσιωδῶν φωνῶν θέλει συνίστασθαι, ἀλλ᾿ οὐδὲ ὑπογραφήν, ἐπειδὴ ἡ ὑπογραφὴ οὐδεμίαν φωνὴν οὐσιώδη βούλεται ἔχειν’.", "seq": 1136}
{"id": "Elias_Passim_1137", "series": "CAG", "text": "πρὸς ὅ φαμεν ὅτι ἀνάγκη πᾶσα ὑπογραφὴν καλέσαι τοῦτον·", "seq": 1137}
{"id": "Elias_Passim_1138", "series": "CAG", "text": "ὥσπερ γὰρ ἐπὶ τῆς λύρας ὑγιῶς μὲν διακειμένων τῶν χορδῶν πασῶν ἁρμονία τις καὶ ῥυθμός ἐστι, μιᾶς δὲ δὲ ῥηγνυμένης καὶ οὐ πασῶν εὐθὺς ἀναρμοστία γίνεται, οὕτως καὶ ἐν τῷ ἀποδοθέντι λόγῳ ἐπειδὴ μὴ πᾶσαι αἱ φωναὶ οὐσιώδεις εἰσὶν ἀλλ᾿ εὑρέθη μία ἐπεισοδιώδης, ἔστιν εἰπεῖν ὅτι ἡ ἁρμονία τοῦ ὁρισμοῦ ἐλύθη καὶ τὴν ἀναρμοστίαν τῆς ὑπογραφῆς ἐδέξατο.", "seq": 1138}
{"id": "Elias_Passim_1139", "series": "CAG", "text": "2.", "seq": 1139}
{"id": "Elias_Passim_1140", "series": "CAG", "text": "15 Ὃ καὶ ὑπογράφοντες ἀποδεδώκασι.", "seq": 1140}
{"id": "Elias_Passim_1141", "series": "CAG", "text": "Καλῶς εἶπεν ἀποδεδώκασι·", "seq": 1141}
{"id": "Elias_Passim_1142", "series": "CAG", "text": "τῶν γὰρ πρὸ αὐτοῦ ἐστιν αὕτη ἡ ὑπογραφή·", "seq": 1142}
{"id": "Elias_Passim_1143", "series": "CAG", "text": "ἰστέον γὰρ ὅτι ἡ παροῦσα πραγματεία συναγωγή ἐστι τῶν ἐν τῇ Τοπικῇ πραγματείᾳ σποράδην εἰρημένων τῷ Ἀριστοτέλει.", "seq": 1143}
{"id": "Elias_Passim_1144", "series": "CAG", "text": "2.", "seq": 1144}
{"id": "Elias_Passim_1145", "series": "CAG", "text": "18 Οἷον Σωκράτης καὶ τὸ οὗτος καὶ τὸ τοῦτο.", "seq": 1145}
{"id": "Elias_Passim_1146", "series": "CAG", "text": "Ἵνα μὴ τοῖς κατὰ μέρος ἐνδιατρίβων μηκύνῃ τὸν λόγον, κέχρηται δεικτικαῖς ἀντωνυμίαις·", "seq": 1146}
{"id": "Elias_Passim_1147", "series": "CAG", "text": "τὸ γὰρ τοῖς κατὰ μέρος πᾶσιν ἐπεξιέναι ἀφιλόσοφον.", "seq": 1147}
{"id": "Elias_Passim_1148", "series": "CAG", "text": "2.", "seq": 1148}
{"id": "Elias_Passim_1149", "series": "CAG", "text": "11 Καὶ τὰ συμβεβηκότα κοινῶς ἀλλὰ μὴ ἰδίως.", "seq": 1149}
{"id": "Elias_Passim_1150", "series": "CAG", "text": "Καλῶς εἶπεν κοινῶς ἀλλὰ μὴ ἰδίως τινὶ τὸ συμβεβηκὸς κατὰ πλειόνων κατηγορεῖσθαι·", "seq": 1150}
{"id": "Elias_Passim_1151", "series": "CAG", "text": "μόνον γὰρ τὸ συμβεβηκὸς δύναται καθόλου εἶναι καὶ μερικόν, καθόλου μὲν ὡς τὸ λευκὸν κατὰ πλειόνων φερόμενον, μερικὸν δὲ ὡς ἡ οὐλὴ τοῦ Ὀδυσσέως, ἀφ᾿ ἧς ἐπέγνω αὐτὸν ἡ Εὐρύκλεια.", "seq": 1151}
{"id": "Elias_Passim_1152", "series": "CAG", "text": "2.", "seq": 1152}
{"id": "Elias_Passim_1153", "series": "CAG", "text": "21 Συμβεβηκὸς δὲ οἷον τὸ λευκόν, τὸ μέλαν, τὸ καθέζεσθαι.", "seq": 1153}
{"id": "Elias_Passim_1154", "series": "CAG", "text": "Διὰ τί ἐπὶ μόνου τοῦ συμβεβηκότος καὶ ὀνόμασι καὶ ῥήμασιν ἐχρήσατο εἰς παράδειγμα, ἐπὶ δὲ τῶν ἄλλων μόνοις ὀνόμασιν ἐχρήσατο;", "seq": 1154}
{"id": "Elias_Passim_1155", "series": "CAG", "text": "καὶ λέγομεν ὅτι εὐλόγως·", "seq": 1155}
{"id": "Elias_Passim_1156", "series": "CAG", "text": "τὰ γὰρ γένη καὶ τὰ εἴδη καὶ αἱ διαφοραὶ καὶ τὰ ἴδια ἀεὶ ὡσαύτως ἔχουσι μὴ μεταβάλλοντα τὰ δὲ συμβεβηκότα μεταβάλλουσί ποτε.", "seq": 1156}
{"id": "Elias_Passim_1157", "series": "CAG", "text": "εἰκότως οὖν ἐπὶ μὲν τῶν ἄλλων τὸ ὄνομα ἔλαβεν εἰς παράδειγμα ὡς ἐν ταῖς κλίσεσι κατὰ χρόνον μὴ μεταβάλλον, ἐπὶ δὲ τοῦ συμβεβηκότος ἐχρήσατο καὶ τῷ ῥήματι ὡς μεταβάλλοντι κατὰ χρόνον·", "seq": 1157}
{"id": "Elias_Passim_1158", "series": "CAG", "text": "ἁρμόδιον ἄρα ἦν τὸ μεταβάλλον κατὰ χρόνον τῷ μεταβάλλοντι κατὰ φύσιν εἰς τὸ ἐναντίον.", "seq": 1158}
{"id": "Elias_Passim_1159", "series": "CAG", "text": "2.", "seq": 1159}
{"id": "Elias_Passim_1160", "series": "CAG", "text": "28 Οἳ διαφέρουσι καὶ τῷ εἴδει ἀλλήλων ἀλλ᾿ οὐχί.", "seq": 1160}
{"id": "Elias_Passim_1161", "series": "CAG", "text": "Καλῶς εἶπε τῷ ἀριθμῷ μόνον·", "seq": 1161}
{"id": "Elias_Passim_1162", "series": "CAG", "text": "τὰ γὰρ τῷ εἴδει διαφέροντα καὶ τῷ ἀριθμῷ πάντως διαφέρουσιν, τὰ δὲ τῷ ἀριθμῷ διαφέροντα οὐ πάντως τῷ εἴδει διαφέρουσιν.", "seq": 1162}
{"id": "Elias_Passim_1163", "series": "CAG", "text": "3.", "seq": 1163}
{"id": "Elias_Passim_1164", "series": "CAG", "text": "18 Ἃ οὐκ ἐν τῷ τί ἐστι κατηγορεῖται.", "seq": 1164}
{"id": "Elias_Passim_1165", "series": "CAG", "text": "Ἡ μὲν διαφορὰ ἐν τῷ ποῖόν τί ἐστι κατηγορεῖται μόνον, τὸ δὲ συμβεβηκὸς ἢ ἐν τῷ ποῖόν τί ἐστιν ἢ ἐν τῷ πῶς ἔχον κατηγορεῖται.", "seq": 1165}
{"id": "Elias_Passim_1166", "series": "CAG", "text": "καὶ εὐλόγως, ὅτι ἡ μὲν διαφορὰ ἡ κυρίως οὐδέποτε μεταβάλλει ἢ χωρίζεται, τὸ δὲ συμβεβηκὸς διττόν, ἢ χωριστὸν ἢ ἀχώριστον, καὶ τῷ μὲν ἀχωρίστῳ οἰκεῖον τὸ ἐν τῷ ποῖόν τί ἐστι κατηγορηθῆναι, τῷ δὲ χωριστῷ οἰκεῖον τὸ ἐν τῷ πῶς ἔχον κατηγορεῖσθαι·", "seq": 1166}
{"id": "Elias_Passim_1167", "series": "CAG", "text": "οἷον πῶς ἔχει Σωκράτης;", "seq": 1167}
{"id": "Elias_Passim_1168", "series": "CAG", "text": "ὑγιαίνει ἢ νοσεῖ, ἅ ἐστι χωριστὰ συμβεβηκότα.", "seq": 1168}
{"id": "Elias_Passim_1169", "series": "CAG", "text": "<Πρᾶξις κα΄>", "seq": 1169}
{"id": "Elias_Passim_1170", "series": "CAG", "text": "Περὶ εἴδους.", "seq": 1170}
{"id": "Elias_Passim_1171", "series": "CAG", "text": "3.", "seq": 1171}
{"id": "Elias_Passim_1172", "series": "CAG", "text": "21 Τὸ δὲ εἶδος λέγεται μὲν καὶ ἐπὶ τῆς ἑκάστου μορφῆς, καθὸ εἴρηται.", "seq": 1172}
{"id": "Elias_Passim_1173", "series": "CAG", "text": "Οὔπω πέπαυται ὁ περὶ τοῦ γένους λόγος·", "seq": 1173}
{"id": "Elias_Passim_1174", "series": "CAG", "text": "ἐκκρεμὴς γάρ ἐστι καὶ κατὰ γνῶσιν καὶ καθ᾿ ὕπαρξιν, ἀναμένων τὸ εἶδος, καὶ ἵνα γνωσθῇ καὶ ἵνα ὑποστῇ.", "seq": 1174}
{"id": "Elias_Passim_1175", "series": "CAG", "text": "καὶ μὴ λεγέτωσαν οἱ ἐξηγηταὶ διὰ τί προέταξε τὸ εἶδος τῆς διαφορᾶς·", "seq": 1175}
{"id": "Elias_Passim_1176", "series": "CAG", "text": "οὐδὲν γὰρ ἕτερον ζητοῦσιν ἢ διὰ τί προέταξε τὸ γένος τῆς διαφορᾶς.", "seq": 1176}
{"id": "Elias_Passim_1177", "series": "CAG", "text": "τὸ δὲ ζητεῖν τοῦτο εὔηθες·", "seq": 1177}
{"id": "Elias_Passim_1178", "series": "CAG", "text": "τὸ γὰρ γένος ἐν ἑαυτῷ ἔχει τὸ εἶδος.", "seq": 1178}
{"id": "Elias_Passim_1179", "series": "CAG", "text": "καὶ πῶς, φασίν, ἀνωτέρω τὴν διαφορὰν προέταξε;", "seq": 1179}
{"id": "Elias_Passim_1180", "series": "CAG", "text": "καὶ λέγομεν ὅτι ὅπου ψιλῆς ἀπαριθμήσεως ἤγουν προόδου καιρὸς ἦν, τῆς γινομένης ἀπὸ τῶν καθολικωτέρων ἐπὶ τὰ μερικώτερα, προέταξε τὴν διαφορὰν τοῦ εἴδους ὡς καθολικωτέραν μερικωτέρου (καθολικωτέρα γὰρ ἡ διαφορὰ τοῦ εἴδους, εἴπερ τὸ λογικὸν οὐ μόνῳ ἀνθρώπῳ ἀλλὰ καὶ ἀγγέλῳ ὑπάρχει, τὸ δὲ εἶδος μερικώτερον, εἴπερ ἄνθρωπος εἶδος ὢν μερικώτερος τῆς τοῦ θνητοῦ διαφορᾶς), ὅπου δὲ ὑποστάσεως καὶ ὑπογραφῆς καιρὸς ἦν, προέταξε τὸ εἶδος·", "seq": 1180}
{"id": "Elias_Passim_1181", "series": "CAG", "text": "τὸ γὰρ γένος χωρὶς τοῦ εἴδους οὔτε ὑφίσταται οὔτε γινώσκεται, ἐπειδὴ πρός τι ταῦτα, τὰ δὲ πρός τι χωρὶς ἀλλήλων οὔτε ἔστιν οὔτε γινώσκεται.", "seq": 1181}
{"id": "Elias_Passim_1182", "series": "CAG", "text": "Ἀλλ᾿ ὥσπερ τὸ γένος ὁμώνυμον, οὕτως καὶ τὸ εἶδος ὁμώνυμον·", "seq": 1182}
{"id": "Elias_Passim_1183", "series": "CAG", "text": "φέρε οὖν κἀνταῦθα τῷ αὐτῷ κανόνι χρησώμεθα καὶ πρότερον διαστείλωμεν τὴν ὁμωνυμίαν καὶ οὕτως τὸ ἀφορισθὲν ὑπογραφῆς ἀξιώσωμεν.", "seq": 1183}
{"id": "Elias_Passim_1184", "series": "CAG", "text": "δύο τοίνυν σημαίνει τὸ εἶδος·", "seq": 1184}
{"id": "Elias_Passim_1185", "series": "CAG", "text": "λέγεται γὰρ εἶδος καὶ ἐπὶ τῆς ἑκάστου μορφῆς, καθό φαμεν τὸ", "seq": 1185}
{"id": "Elias_Passim_1186", "series": "CAG", "text": "πρῶτον μὲν εἶδος ἄξιον τυραννίδος·", "seq": 1186}
{"id": "Elias_Passim_1187", "series": "CAG", "text": "οὐκ ἂν γὰρ τὸ εὐειδὲς καὶ δυσειδὲς μορφῆς διάφορον ἐδήλου, εἰ μὴ τὸ εἶδος μορφὴν ἐδήλου.", "seq": 1187}
{"id": "Elias_Passim_1188", "series": "CAG", "text": "λέγεται δὲ εἶδος καὶ τὸ ὑπὸ τὸ ἀποδοθὲν γένος, περὶ οὗ διαλέγονται οἱ φιλόσοφοι·", "seq": 1188}
{"id": "Elias_Passim_1189", "series": "CAG", "text": "ὥσπερ γὰρ οὐ περὶ παντὸς γένους διελέγοντο ἀλλὰ περὶ τοῦ εἰς εἴδη διαιρουμένου, οὕτως οὐδὲ περὶ παντὸς εἴδους διαλέγονται ἀλλὰ περὶ τοῦ ἀναγομένου ὑπὸ τὸ γένος.", "seq": 1189}
{"id": "Elias_Passim_1190", "series": "CAG", "text": "ἀλλ᾿ οὐ μέχρι τούτων τὰ σημαινόμενα τοῦ εἴδους, ὦ Πορφύριε·", "seq": 1190}
{"id": "Elias_Passim_1191", "series": "CAG", "text": "ποῦ γὰρ τὸ παρὰ Ἀριστοτέλει ἐν τῇ Φυσικῇ ἔνυλον εἶδος, οὗ ἀποπεράτωσις ἡ μορφή;", "seq": 1191}
{"id": "Elias_Passim_1192", "series": "CAG", "text": "καὶ λέγομεν ὅτι τοῦτο παρῆκεν, ἐπεὶ μὴ φυσιολογῆσαι καιρός.", "seq": 1192}
{"id": "Elias_Passim_1193", "series": "CAG", "text": "τοῦ δὲ νῦν προκειμένου εἴδους λέγει ὑπογραφὰς τρεῖς·", "seq": 1193}
{"id": "Elias_Passim_1194", "series": "CAG", "text": "πρώτην μέν, ὅτι εἶδός ἐστι τὸ ἀναγόμενον ὑπὸ τὸ ἀποδοθὲν γένος, ταὐτὸν εἰπεῖν ὑπογραφέν, δευτέραν δὲ εἶδός ἐστιν οὗ τὸ γένος ἐν τῷ τί ἐστι κατηγορεῖται, καὶ τρίτην εἶδός ἐστι τὸ κατὰ πλειόνων καὶ διαφερόντων τῷ ἀριθμῷ ἐν τῷ τί ἐστι κατηγορούμενον.", "seq": 1194}
{"id": "Elias_Passim_1195", "series": "CAG", "text": "αἱ μὲν οὖν πρῶται δύο ὑπογραφαὶ τῇ σχέσει μόνῃ διαφέρουσιν ἀλλήλων καὶ ᾧ διαφέρει ἀνάβασις καταβάσεως καὶ κατάβασις ἀναβάσεως καὶ ἡ ἀπὸ Ἀθηνῶν εἰς Θήβας ὁδὸς καὶ ἀπὸ Θηβῶν εἰς Ἀθήνας (αὗται γὰρ τῇ σχέσει μόνῃ διαφέρουσι, τῷ ἢ ἔνθεν ἄρξασθαι ἢ ἔνθεν)·", "seq": 1195}
{"id": "Elias_Passim_1196", "series": "CAG", "text": "οὕτως καὶ αὗται αἱ ὑπογραφαὶ ἀνόδῳ ἐοίκασι καὶ καθόδῳ·", "seq": 1196}
{"id": "Elias_Passim_1197", "series": "CAG", "text": "ἡ γὰρ πρώτη ἡ λέγουσα τὸ ἀναγόμενον ὑπὸ τὸ ἀποδοθὲν γένος ἀνόδῳ ἔοικεν, ἡ λέγουσα οὗ τὸ γένος ἐν τῷ τί ἐστι κατηγορεῖται καθόδῳ ἔοικεν.", "seq": 1197}
{"id": "Elias_Passim_1198", "series": "CAG", "text": "αὗται δὲ αἱ δύο ὑπογραφαὶ παντὶ εἴδει ἁρμόζουσι (πᾶν γὰρ εἶδος ἔχει γένος), ἡ δὲ τρίτη οὐ παντὶ ἀλλὰ τῷ εἰδικωτάτῳ.", "seq": 1198}
{"id": "Elias_Passim_1199", "series": "CAG", "text": "δεῖ δὲ εἰδέναι ὅτι οὐ μόνον τὸ ἁπλῶς γένος πολλαχῶς λέγεται, ἀλλὰ καὶ τὸ περὶ οὗ οἱ φιλόσοφοι διαλέγονται πολλαχῶς λέγεται, ὁμοίως καὶ τὸ εἶδος·", "seq": 1199}
{"id": "Elias_Passim_1200", "series": "CAG", "text": "ἔστι γὰρ γένος περὶ οὗ οἱ φιλόσοφοι διαλέγονται, ὃ μόνον γένος εἶδος [δὲ] οὐδέποτε δυνάμενον γενέσθαι, ὅ ἐστι γενικώτατον ὡς λευκότατον καὶ μελάντατον.", "seq": 1200}
{"id": "Elias_Passim_1201", "series": "CAG", "text": "ὁμοίως ἔστι καὶ εἶδος, ὃ μόνον εἶδος γένος μὴ δυνάμενον γενέσθαι, ὃ καλεῖται εἰδικώτατον.", "seq": 1201}
{"id": "Elias_Passim_1202", "series": "CAG", "text": "μεταξὺ δὲ τούτων ἔστι γένος ἄλλο, ὃ γένος ἅμα καὶ εἶδος λέγεται καὶ ὑπάλληλον γένος ὑφειμένῃ φωνῇ, καὶ εἶδος πάλιν ἄλλο, ὃ εἶδος ἅμα καὶ γένος λέγεται, πανταχοῦ τὰ οἰκεῖα τῶν ἀλλοτρίων προταττόντων ἡμῶν καὶ τὸ πρὸς ὃ λέγεται ἕκαστον ποτὲ μὲν γένος ἅμα καὶ εἶδος ποτὲ δὲ εἶδος ἅμα καὶ γένος πρὸς τὴν διάφορον σχέσιν.", "seq": 1202}
{"id": "Elias_Passim_1203", "series": "CAG", "text": "ἀλλὰ λελήθαμεν ἑαυτούς, φασίν, τῇ διαλλήλῳ δείξει περιπεσόντες φευκτέᾳ οὔσῃ παρὰ φιλοσόφοις·", "seq": 1203}
{"id": "Elias_Passim_1204", "series": "CAG", "text": "καὶ τὸ γένος γὰρ ὑπογράφοντες τοῦ εἴδους ἐμνημονεύσαμεν καὶ τὸ εἶδος ὑπογράφοντες τοῦ γένους.", "seq": 1204}
{"id": "Elias_Passim_1205", "series": "CAG", "text": "καὶ λέγομεν ὅτι οὐκ ἀεὶ φευκτέα ἡ διάλληλος δεῖξις·", "seq": 1205}
{"id": "Elias_Passim_1206", "series": "CAG", "text": "εἰ μὲν γὰρ τὰ πράγματα τὰ περὶ ὧν οἱ λόγοι μηδὲν δέονται ἀλλήλων πρὸς ὑπόστασιν ὡς ἐπὶ βοὸς καὶ ἵππου καὶ τῶν τοιούτων, παντὶ σθένει φευκτέον τὴν διάλληλον δεῖξιν, εἰ δὲ τὰ πράγματα δέονται ἀλλήλων πρὸς ὕπαρξιν, οὐδὲ ἄλλως αὐτὰ ἔστι διδάξαι, εἰ μὴ διὰ τῆς διαλλήλου δείξεως·", "seq": 1206}
{"id": "Elias_Passim_1207", "series": "CAG", "text": "ὥσπερ γὰρ ἀδύνατον ἠρεμεῖν τὴν σκιὰν τοῦ ποιοῦντος τὴν σκιὰν μὴ ἠρεμοῦντος, οὕτως ἀδύνατον τοὺς λόγους μὴ δεῖσθαι ἀλλήλων τῶν πραγμάτων τῶν περὶ ὧν εἰσιν οἱ λόγοι δεομένων ἀλλήλων.", "seq": 1207}
{"id": "Elias_Passim_1208", "series": "CAG", "text": "ἀλλ᾿ εἰ ταῦτα οὕτως ἔχει, ἑτέρα ἡμᾶς ἀπορία διαδέχεται·", "seq": 1208}
{"id": "Elias_Passim_1209", "series": "CAG", "text": "διὰ τί γὰρ ἐν τῇ μιᾷ ὑπογραφῇ τοῦ εἴδους οὐκ ἐμνήσθη τοῦ γένους;", "seq": 1209}
{"id": "Elias_Passim_1210", "series": "CAG", "text": "καὶ εἰς τοὐναντίον μετέπεσεν ἡ τύχη τοῦ λόγου·", "seq": 1210}
{"id": "Elias_Passim_1211", "series": "CAG", "text": "πάλαι μὲν γὰρ ἐζητοῦμεν διὰ τί ἐχρησάμεθα τῇ διαλλήλῳ δείξει, νῦν δὲ ζητοῦμεν διὰ τί οὐκ ἐχρησάμεθα.", "seq": 1211}
{"id": "Elias_Passim_1212", "series": "CAG", "text": "λύσις δὲ τούτου πρόχειρος, ὅτι τοῦ εἴδους δύο σχέσεις ἔχοντος, μίαν τὴν πρὸς τὸ γένος καὶ μίαν τὴν πρὸς τὰ ἄτομα, ἐμερίσαντο αἱ τρεῖς ὑπογραφαὶ τὰς δύο αὐτοῦ σχέσεις, αἱ μὲν πρῶται δύο τὴν σχέσιν αὐτοῦ τὴν πρὸς τὸ γένος, ἡ δὲ μία ἡ ἐσχάτη τὴν πρὸς τὰ ἄτομα.", "seq": 1212}
{"id": "Elias_Passim_1213", "series": "CAG", "text": "<Πρᾶξις κβ'>", "seq": 1213}
{"id": "Elias_Passim_1214", "series": "CAG", "text": "3.", "seq": 1214}
{"id": "Elias_Passim_1215", "series": "CAG", "text": "22 Τὸ δὲ εἶδος λέγεται μὲν καὶ ἐπὶ τῆς ἑκάστου μορφῆς.", "seq": 1215}
{"id": "Elias_Passim_1216", "series": "CAG", "text": "Τῷ συνδέσμῳ τῷ καί ἐχρήσατο, ἢ ὅτι ἐμνήσθη τοῦ ἄλλου σημαινομένου τοῦ εἴδους ἐν τῷ γένει ἢ ὅτι ὁ καί σύνδεσμος εὕρηται καὶ ἐν ἀρχῇ τοῦ λόγου.", "seq": 1216}
{"id": "Elias_Passim_1217", "series": "CAG", "text": "4.", "seq": 1217}
{"id": "Elias_Passim_1218", "series": "CAG", "text": "15 Καθ᾿ ἑκάστην κατηγορίαν.", "seq": 1218}
{"id": "Elias_Passim_1219", "series": "CAG", "text": "Πῶς καθ᾿ ἑκάστην κατηγορίαν λέγεται γενικώτατα;", "seq": 1219}
{"id": "Elias_Passim_1220", "series": "CAG", "text": "ἐν γὰρ ἑκάστῃ κατηγορίᾳ ἕν ἐστι τὸ γενικώτατον.", "seq": 1220}
{"id": "Elias_Passim_1221", "series": "CAG", "text": "μήποτε οὖν τὸ καθ᾿ ἑκάστην ἀντὶ τοῦ ἐν πάσαις, ὡς καὶ ὁ ποιητὴς", "seq": 1221}
{"id": "Elias_Passim_1222", "series": "CAG", "text": "ὣς φάτο, οἱ δ᾿ ἄρ᾿ ἕκαστοι ἕλον δέπας ἀμφικύπελλον", "seq": 1222}
{"id": "Elias_Passim_1223", "series": "CAG", "text": "ἀντὶ τοῦ ‘πάντες’.", "seq": 1223}
{"id": "Elias_Passim_1224", "series": "CAG", "text": "4.", "seq": 1224}
{"id": "Elias_Passim_1225", "series": "CAG", "text": "21 Γινέσθω δὲ ἐπὶ μιᾶς κατηγορίας σαφὲς τὸ λεγόμενον.", "seq": 1225}
{"id": "Elias_Passim_1226", "series": "CAG", "text": "Ἐπειδὴ τὰ παραδείγματα φωστῆρές εἰσι τῶν λεγομένων (αἰσθήσεις γάρ εἰσι λογικαὶ δακτύλῳ ἡμῖν δεικνῦσαι τὰ πράγματα καὶ τοῦτό ἐστιν ὃ καθ᾿ Ὅμηρον μὲν ‘χρυσοῦς λύχνος’, κατὰ δὲ Ἀπολλώνιον τὸν τῶν Ἀργοναυτικῶν συγγραφέα ἡ Ἀνάφη νῆσος), βούλεται ὁ Πορφύριος διὰ πραγμάτων φωτίσαι τὰ λεγόμενα καὶ κέχρηται δυσὶ παραδείγμασιν, ἑνὶ μὲν ἀπὸ τῆς φιλοσοφίας, τοῦτ᾿ ἔστιν ἐκ τῶν κατηγοριῶν, ἑτέρῳ δὲ ἀπὸ τῶν γενεαλογιῶν, ἄμφω μὲν γένεσιν οὖσιν, ἀλλὰ τῷ μὲν ἀπὸ τῆς φιλοσοφίας τῷ δὲ ἀπὸ τῆς συνηθείας.", "seq": 1226}
{"id": "Elias_Passim_1227", "series": "CAG", "text": "πολλῶν δὲ οὐσῶν κατηγοριῶν μιᾷ κέχρηται, φημὶ τῇ οὐσίᾳ μόνῃ, ἐκ τῶν δέκα τῶν γενικωτάτων δι᾿ αὐτῆς καὶ τὰς λοιπὰς ἔχων κατηγορίας (ἐνδύματα γὰρ τῆς οὐσίας αἱ λοιπαὶ κατηγορίαι), καὶ πολλῶν οὐσῶν γενεαλογιῶν μιᾷ μόνῃ κέχρηται τῇ τοῦ Διὸς δι᾿ αὐτῆς καὶ τὰς λοιπὰς ἔχων διὰ τὸ", "seq": 1227}
{"id": "Elias_Passim_1228", "series": "CAG", "text": "πατὴρ ἀνδρῶν τε θεῶν τε.", "seq": 1228}
{"id": "Elias_Passim_1229", "series": "CAG", "text": "φέρε δὲ ἡμεῖς πρὸ τούτων σαφεστέρῳ χρησώμεθα παραδείγματι.", "seq": 1229}
{"id": "Elias_Passim_1230", "series": "CAG", "text": "ὑποκείσθωσαν τρεῖς τινες ἐπ᾿ εὐθείας ἑστῶτες·", "seq": 1230}
{"id": "Elias_Passim_1231", "series": "CAG", "text": "ἐν τούτοις ὁ μέν ἐστι δεξιός, ὃν εἴποις ἂν δεξιώτατον βιαζόμενος τὴν συνήθειαν, καὶ ἀναλογεῖ τῷ γενικωτάτῳ, ὁ δὲ ἀριστερός, ὃν εἴποις ἂν ἀριστερώτατον, καὶ ἀναλογεῖ τῷ εἰδικωτάτῳ, ὁ δὲ μέσος δεξιὸς ἅμα καὶ ἀριστερός, ὅτι τοῦ μὲν δεξιοῦ ἐστιν ἀριστερὸς τοῦ δὲ ἀριστεροῦ δεξιὸς ἀναλογῶν τῷ ὑπαλλήλῳ.", "seq": 1231}
{"id": "Elias_Passim_1232", "series": "CAG", "text": "τούτων οὕτως ἐχόντων πρόεισιν ἡ διαίρεσις τὸν τρόπον τοῦτον·", "seq": 1232}
{"id": "Elias_Passim_1233", "series": "CAG", "text": "ἡ οὐσία διαιρεῖται εἰς σῶμα καὶ ἀσώματον, τὸ σῶμα εἰς ἔμψυχον καὶ ἄψυχον, τὸ ἔμψυχον εἰς ζῷον, ζῳόφυτον καὶ φυτόν, τὸ ζῷον εἰς λογικὸν καὶ ἄλογον, τὸ λογικὸν εἰς θεόν, ἄγγελον καὶ ἄνθρωπον·", "seq": 1233}
{"id": "Elias_Passim_1234", "series": "CAG", "text": "ἐν τούτοις τὸ μὲν ὅθεν ἠρξάμην, φημὶ τὴν οὐσίαν, ἐστὶ γενικώτατον ὡς μὴ ἔχον ἕτερον πρὸ αὐτοῦ ὑπεραναβεβηκὸς γένος, τὸ δὲ εἰς ὃ κατέληξα, φημὶ τὸν ἄνθρωπον, ἐστὶν εἰδικώτατον ὡς μὴ ἔχον ἕτερον μετ᾿ αὐτὸ ὑποβεβηκὸς εἶδος (τὰ γὰρ ἄτομα εἰ καὶ ὑποβεβήκασιν, ἀλλ᾿ οὔκ εἰσιν εἴδη οὐ γὰρ κατηγοροῦνται καὶ αὐτὰ κατὰ πλειόνων καὶ διαφερόντων τῷ ἀριθμῷ ἀλλὰ τὰ εἴδη μόνον), τὰ δὲ μέσα τοῦ γενικωτάτου καὶ τοῦ εἰδικωτάτου, δι᾿ ὧν ὡδεύσαμεν, εἰσὶν ὑπάλληλα.", "seq": 1234}
{"id": "Elias_Passim_1235", "series": "CAG", "text": "Ἀποροῦσι δέ τινες ὅτι ‘πῶς διαιρεῖται ἡ οὐσία εἰς σῶμα καὶ ἀσώματον;", "seq": 1235}
{"id": "Elias_Passim_1236", "series": "CAG", "text": "τί οὖσα;", "seq": 1236}
{"id": "Elias_Passim_1237", "series": "CAG", "text": "εἰ μὲν γὰρ σῶμα, πῶς εἰς ἀσώματον;", "seq": 1237}
{"id": "Elias_Passim_1238", "series": "CAG", "text": "εἰ δὲ ἀσώματον, πῶς εἰς σῶμα;’", "seq": 1238}
{"id": "Elias_Passim_1239", "series": "CAG", "text": "καὶ λέγομεν ὅτι οὐδέτερον τούτων ἡ οὐσία, ἵνα εὐλόγως ἀμφότερα ᾖ, δίκην ἀδωροδοκήτου δικαστοῦ ἐξ ἴσου δικάζοντος διὰ τὸ μὴ προκατειλῆφθαι δώροις, δίκην τοῦ ἀέρος ἀχρωματίστου ὄντος, ἵνα πᾶν χρῶμα διακομίσῃ, δίκην λευκῶν ἐρίων ἅπερ ἐν χρώμασιν ἀχρωμάτιστά ἐστι καὶ διὰ τοῦτο πᾶσαν βαφὴν ἐπιδέχονται.", "seq": 1239}
{"id": "Elias_Passim_1240", "series": "CAG", "text": "αὕτη ἡ λύσις ἁρμόζει οὐ μόνῃ τῇ οὐσίᾳ, ἀλλὰ καὶ τοῖς ἄλλοις γένεσιν, οἷον τῷ ζῴῳ·", "seq": 1240}
{"id": "Elias_Passim_1241", "series": "CAG", "text": "εἴποι γὰρ ἄν τις ‘τί ὂν τὸ ζῷον διαιρεῖται εἰς λογικὸν καὶ ἄλογον;", "seq": 1241}
{"id": "Elias_Passim_1242", "series": "CAG", "text": "εἰ μὲν γὰρ λογικόν, πῶς εἰς ἄλογον;", "seq": 1242}
{"id": "Elias_Passim_1243", "series": "CAG", "text": "εἰ δὲ ἄλογον, πῶς εἰς λογικόν;’", "seq": 1243}
{"id": "Elias_Passim_1244", "series": "CAG", "text": "καὶ λέγομεν ὅτι οὐδέτερον τούτων, ἵνα ἀμφότερα ᾖ.", "seq": 1244}
{"id": "Elias_Passim_1245", "series": "CAG", "text": "ἑτέραν ἀπορίαν ἀποροῦσιν ὅτι ‘πῶς τὸ σῶμα εἰς τὸ ὅλον διαιρεῖς, εἰς ἔμψυχον καὶ ἄψυχον;", "seq": 1245}
{"id": "Elias_Passim_1246", "series": "CAG", "text": "τὸ γὰρ μέρος, τοῦτ᾿ ἔστι τὸ σῶμα, εἰς τὸ ὅλον διαιρεῖς, τοῦτ᾿ ἔστιν εἰς τὸ ἔμψυχον’.", "seq": 1246}
{"id": "Elias_Passim_1247", "series": "CAG", "text": "πρὸς ὅ φαμεν ὅτι οὐ τὸ μέρος εἰς τὸ ὅλον διαιροῦμεν, ἀλλὰ τὸ ὅλον εἰς τὰ μέρη αὐτοῦ διῃρέθη·", "seq": 1247}
{"id": "Elias_Passim_1248", "series": "CAG", "text": "τὸ γὰρ ἁπλῶς σῶμα εἰς τοιόνδε καὶ τοιόνδε διῃρέθη, τοῦτ᾿ ἔστιν εἰς τὸ πεφυκὸς δέχεσθαι ψυχὴν καὶ εἰς τὸ μὴ πεφυκός·", "seq": 1248}
{"id": "Elias_Passim_1249", "series": "CAG", "text": "οὐδὲ γὰρ ὅλου τοῦ ἐμψύχου κατηγορεῖται τὸ σῶμα, ἐπεὶ καὶ τὴν ψυχὴν εἴποις ἂν σῶμα, ὅπερ ἄτοπον.", "seq": 1249}
{"id": "Elias_Passim_1250", "series": "CAG", "text": "τούτων οὕτως ἐχόντων ἑτέραν ἀπορίαν ἀποροῦσι·", "seq": 1250}
{"id": "Elias_Passim_1251", "series": "CAG", "text": "τὸ γὰρ ἔμψυχον διείλομεν εἰς ζῷον, ζῳόφυτον καὶ φυτόν·", "seq": 1251}
{"id": "Elias_Passim_1252", "series": "CAG", "text": "ἐνταῦθα δὲ οὐχὶ κατὰ τάξιν ἡ διαίρεσις προῆλθεν * * εἰς δύο ἀντιδιῃρημένα, ἵνα ἄφυκτος ᾖ, ἀλλ᾿ εἰς τρία·", "seq": 1252}
{"id": "Elias_Passim_1253", "series": "CAG", "text": "εἰ δὲ ὅλως δοθῇ ἐξουσία εἰς τρία διαιρεῖν, τί ἄτοπον καὶ εἰς τέσσαρα καὶ εἰς πέντε τὰς διαιρέσεις ποιεῖσθαι, καὶ εἰς ὅσα δ᾿ ἄν τις θελήσοι;", "seq": 1253}
{"id": "Elias_Passim_1254", "series": "CAG", "text": "φασὶν οὖν πρὸς τοῦτο τὴν λύσιν τοιαύτην, ὅτι πᾶν ἔμψυχον τρεῖς ἔχει δυνάμεις, θρεπτικήν, αὐξητικήν, τοῦ ὁμοίου γεννητικήν·", "seq": 1254}
{"id": "Elias_Passim_1255", "series": "CAG", "text": "καὶ εἰ μὲν ταύτας ἔχοι μόνας, λέγεται φυτόν, διὸ καὶ ὁ φιλόσοφος Πλωτῖνος ἔλεγε περὶ τῶν ταῖς δυνάμεσι ταύταις σχολαζόντων οἷον τῷ ἐσθίειν καὶ συνουσιάζειν, καταφρονούντων δὲ λογικῆς θεωρίας, ὅτι κινδυνεύουσιν ἀποδενδρωθῆναι.", "seq": 1255}
{"id": "Elias_Passim_1256", "series": "CAG", "text": "εἰ δὲ πρὸς ταύταις ταῖς δυνάμεσι καὶ κίνησιν καὶ αἴσθησιν προσλάβοι, γίνεται ζῷον, εἰ δὲ αἴσθησιν μόνον προσλάβοι, κίνησιν δὲ μή, ποιεῖ τὸ ζῳόφυτον, ὡς ἐπὶ τοῦ ὀστρέου καὶ τῶν τοιούτων·", "seq": 1256}
{"id": "Elias_Passim_1257", "series": "CAG", "text": "ταῦτα γὰρ αἰσθάνεται μέν, οὐ κινεῖται δέ·", "seq": 1257}
{"id": "Elias_Passim_1258", "series": "CAG", "text": "κάρφους γὰρ προσφερομένου συστέλλεται, ἁπλοῦται δὲ ἐπὶ γλυκεῖ ὕδατι, ἀλλ᾿ οὐ κινεῖται, ἐπειδὴ ἐρρίζωται ἐν ταῖς πέτραις·", "seq": 1258}
{"id": "Elias_Passim_1259", "series": "CAG", "text": "ἡ γὰρ δοκοῦσα αὐτῶν εἶναι κίνησις, τὸ ἐκτείνεσθαι αὐτὰ καὶ συστέλλεσθαι, ἀπὸ μέρους ἐστίν.", "seq": 1259}
{"id": "Elias_Passim_1260", "series": "CAG", "text": "ὥσπερ δὲ τὸ ὄνομα τοῦ ζῳοφύτου σύνθετον, οὕτως καὶ τὸ πρᾶγμα·", "seq": 1260}
{"id": "Elias_Passim_1261", "series": "CAG", "text": "τοῦ μὲν γὰρ ζῴου ἔχουσι τὸ αἰσθάνεσθαι, τοῦ δὲ φυτοῦ τὸ ἀκίνητον.", "seq": 1261}
{"id": "Elias_Passim_1262", "series": "CAG", "text": "δεῖται δὲ προσδιορισμοῦ ὁ λόγος·", "seq": 1262}
{"id": "Elias_Passim_1263", "series": "CAG", "text": "τότε γὰρ πᾶν ἔμψυχον τρεῖς ἔχει δυνάμεις, ὅταν καὶ θνητὸν ᾖ καὶ ἐξ ὁμοίου ἑαυτῷ ἐγένετο, θνητὸν μὲν διὰ τὰ οὐράνια, ἐξ ὁμοίου δὲ ἑαυτῷ διὰ τὰ ἐκ σήψεως γενόμενα·", "seq": 1263}
{"id": "Elias_Passim_1264", "series": "CAG", "text": "ταῦτα γὰρ οὐ γεννᾶται πάντα ἐξ ὁμοίων.", "seq": 1264}
{"id": "Elias_Passim_1265", "series": "CAG", "text": "τούτων οὕτως ἐχόντων φέρε καὶ τὴν διαίρεσιν ἔντεχνον ποιήσωμεν καὶ διέλωμεν οὕτως·", "seq": 1265}
{"id": "Elias_Passim_1266", "series": "CAG", "text": "τὸ ἔμψυχον διαιρεῖται εἰς διωργανωμένον σῶμα καὶ ἀδιοργάνωτον, καὶ τὸ μὲν διωργανωμένον ποιεῖ τὸ ζῷον, τὸ δὲ ἀδιοργάνωτον εἰ μὲν μὴ ἔχει κίνησιν μηδὲ αἴσθησιν, ποιεῖ τὸ φυτόν, εἰ δὲ αἴσθησιν μὲν ἔχει κίνησιν δὲ μή, ποιεῖ τὸ ζῳόφυτον·", "seq": 1266}
{"id": "Elias_Passim_1267", "series": "CAG", "text": "δύο γὰρ ἐνταῦθά εἰσιν ἀντιθέσεις, αἰσθητικὸν ἀναίσθητον, κινούμενον ἀκίνητον·", "seq": 1267}
{"id": "Elias_Passim_1268", "series": "CAG", "text": "δύο δὲ οὐσῶν ἀντιθέσεων ἓξ γίνονται συμπλοκαί, καθὰ τὸ διάγραμμα τοῦτο δηλοῖ·", "seq": 1268}
{"id": "Elias_Passim_1269", "series": "CAG", "text": "αἰσθητικόν ἀσύστατον ἀναίσθητον συνίσταται ζῷον συνίσταται ζῳόφυτον ἀσύστατον φυτόν συνίσταται κινούμενον ἀσύστατον ἀκίνητον", "seq": 1269}
{"id": "Elias_Passim_1270", "series": "CAG", "text": "τούτων αἱ μὲν τρεῖς συνίστανται, αἰσθητικὸν καὶ κινούμενον, ἀναίσθητον καὶ ἀκίνητον καὶ αἰσθητικὸν καὶ ἀκίνητον, αἱ δὲ τρεῖς οὐ συνίστανται, αἰσθητικὸν ἀναίσθητον καὶ κινούμενον ἀκίνητον καὶ κινούμενον ἀναίσθητον, ὅπερ οὐκ ἂν εὕροις ποτέ, ἐπεὶ πρὸς κακὸν ἑαυτῷ κινηθήσεται μὴ αἰσθανόμενον·", "seq": 1270}
{"id": "Elias_Passim_1271", "series": "CAG", "text": "κατὰ κρημνοῦ γὰρ ἐνεχθήσεται.", "seq": 1271}
{"id": "Elias_Passim_1272", "series": "CAG", "text": "οὐδὲν δὲ μάτην ἡ φύσις ποιεῖ·", "seq": 1272}
{"id": "Elias_Passim_1273", "series": "CAG", "text": "τὸν γὰρ σκώληκα τυφλὸν ὄντα μαλακὸν ἡ φύσις εἰργάσατο, ἵνα κἂν κατὰ κρημνοῦ ἔλθῃ, ἀβλαβὴς μένῃ.", "seq": 1273}
{"id": "Elias_Passim_1274", "series": "CAG", "text": "καὶ ταῦτα μὲν περὶ τούτου.", "seq": 1274}
{"id": "Elias_Passim_1275", "series": "CAG", "text": "τὸ δὲ ζῷον διαιρεῖται εἰς λογικὸν καὶ ἄλογον.", "seq": 1275}
{"id": "Elias_Passim_1276", "series": "CAG", "text": "ἀποροῦσι καὶ πρὸς τοῦτο πῶς τὸ ζῷον διαιρεῖται εἰς λογικὸν καὶ ἄλογον καὶ τὸ λογικὸν εἰς θνητὸν καὶ ἀθάνατον·", "seq": 1276}
{"id": "Elias_Passim_1277", "series": "CAG", "text": "ἐνῆν γὰρ καὶ ἀνάπαλιν τὸ θνητὸν διελεῖν εἰς λογικὸν καὶ ἄλογον·", "seq": 1277}
{"id": "Elias_Passim_1278", "series": "CAG", "text": "ἐπειδὴ οὖν τὸ διαιρούμενον θέλει καθολικώτερον εἶναι τῶν εἰς ἃ διαιρεῖται, ἔσται καὶ τὸ λογικὸν τοῦ θνητοῦ καθολικώτερον καὶ τὸ θνητὸν τοῦ λογικοῦ, ὅπερ ἄτοπον.", "seq": 1278}
{"id": "Elias_Passim_1279", "series": "CAG", "text": "πρὸς τοῦτό φαμεν ὅτι οὐκ ἔστιν ὑποδιαίρεσις ἡ τοῦ θνητοῦ καὶ ἀθανάτου, ἀλλ᾿ ἐπιδιαίρεσις ἤτοι δευτέρα διαίρεσις τοῦ ζῴου, <ὡς> ἵνα εἴπωμεν τοῦ ζῴου τὸ μὲν λογικὸν τὸ δὲ ἄλογον, καὶ πάλιν τοῦ ζῴου τὸ μὲν θνητὸν τὸ δὲ ἀθάνατον, ὥσπερ καὶ εἰς ἄλλα δύναται διαιρεῖσθαι, οἷον τοῦ ζῴου τὸ μὲν πεζὸν τὸ δὲ πτηνὸν τὸ δὲ ἔνυδρον, ἢ τὸ μὲν ἄπουν ὥσπερ τὰ ἑρπετὰ τὸ δὲ ὑπόπουν ὡς τὰ ἄλλα ζῷα.", "seq": 1279}
{"id": "Elias_Passim_1280", "series": "CAG", "text": "τὸ λογικὸν διαιρεῖται εἰς θεὸν καὶ ἄνθρωπον.", "seq": 1280}
{"id": "Elias_Passim_1281", "series": "CAG", "text": "πάλιν ἀποροῦσιν ὅτι εἰ θεὸς ὑπὸ τὸ λογικόν, τὸ δὲ λογικὸν ὑπὸ τὸ ζῷον, τὸ ζῷον ὑπὸ τὸ ἔμψυχον, τὸ ἔμψυχον ὑπὸ τὸ σῶμα, εὑρεθήσεται ὁ θεὸς ὑπὸ τὸ σῶμα.", "seq": 1281}
{"id": "Elias_Passim_1282", "series": "CAG", "text": "καὶ λέγομεν ὅτι οὐκ ἄτοπον τὸν θεὸν σῶμα εἶναι·", "seq": 1282}
{"id": "Elias_Passim_1283", "series": "CAG", "text": "τὰ γὰρ οὐράνια κατὰ Ἀριστοτέλην θεοὶ διὰ τὸ θέειν ἀεὶ καὶ κινεῖσθαι.", "seq": 1283}
{"id": "Elias_Passim_1284", "series": "CAG", "text": "ἀλλ᾿ οὐδὲν ἧττον μένει ἡ ἀπορία·", "seq": 1284}
{"id": "Elias_Passim_1285", "series": "CAG", "text": "περὶ γὰρ τοῦ θεοῦ τί ἂν εἴποι τις τοῦ πρώτου αἰτίου;", "seq": 1285}
{"id": "Elias_Passim_1286", "series": "CAG", "text": "λογικὸν ἢ οὔ;", "seq": 1286}
{"id": "Elias_Passim_1287", "series": "CAG", "text": "καὶ λέγομεν ὅτι λογικὸς ὁ θεός, ἀλλὰ λογικὸν ἔχει οὐ τὸ ἀναγόμενον ὑπὸ τὸ ζῷον τὸ ἀτελὲς τὸ δεόμενον προτάσεων καὶ συμπερασμάτων καὶ διὰ τοῦτο σύνθετον, ἀλλὰ λογικὸν ὡς ὑπὲρ λόγον·", "seq": 1287}
{"id": "Elias_Passim_1288", "series": "CAG", "text": "οὕτως γὰρ καὶ ἐπὶ τῆς ψυχῆς λογικὸν λέγομεν οὐχὶ τὸ ὑπὸ τὸ ζῷον (εἰ γὰρ ὑπὸ τὸ ζῷον ἡ ψυχή, καὶ ὑπὸ τὸ ἔμψυχον, καὶ εὑρεθήσεται ἡ ψυχὴ ἔμψυχον), ἀλλ᾿ ὑπὲρ λόγον τὸ ἐν τῇ ψυχῇ λογικόν.", "seq": 1288}
{"id": "Elias_Passim_1289", "series": "CAG", "text": "<Πρᾶξις κγ'>.", "seq": 1289}
{"id": "Elias_Passim_1290", "series": "CAG", "text": "4.", "seq": 1290}
{"id": "Elias_Passim_1291", "series": "CAG", "text": "21 Ἡ οὐσία ἐστὶ μὲν καὶ αὐτὴ γένος, ὑπὸ δὲ ταύτην σῶμα καὶ ὑπὸ τὸ σῶμα.", "seq": 1291}
{"id": "Elias_Passim_1292", "series": "CAG", "text": "Διὰ τί, φασί, μὴ ὡς ἡμεῖς εἰς δύο διεῖλε τὴν οὐσίαν, εἰς σῶμα καὶ ἀσώματον, καὶ οὕτως ἐφεξῆς εἰς ἀντιδιῃρημένα;", "seq": 1292}
{"id": "Elias_Passim_1293", "series": "CAG", "text": "καὶ λέγομεν ὅτι τῆς κατὰ βάθος μόνον ἔχρηζε προόδου διὰ τὸ γενικώτατον καὶ εἰδικώτατον καὶ ὑπάλληλον.", "seq": 1293}
{"id": "Elias_Passim_1294", "series": "CAG", "text": "4.", "seq": 1294}
{"id": "Elias_Passim_1295", "series": "CAG", "text": "32 Καὶ πᾶν τὸ πρὸ τῶν ἀτόμων.", "seq": 1295}
{"id": "Elias_Passim_1296", "series": "CAG", "text": "Καλῶς εἶπε τὸ πρὸ τῶν ἀτόμων προσεχῶς, ἐπειδὴ καὶ τὰ ὑπάλληλα καὶ τὸ γενικώτατον πρὸ τῶν ἀτόμων, ἀλλ᾿ οὐ προσεχῆ.", "seq": 1296}
{"id": "Elias_Passim_1297", "series": "CAG", "text": "5.", "seq": 1297}
{"id": "Elias_Passim_1298", "series": "CAG", "text": "9 Τὰ δὲ ἄκρα μίαν ἔχει σχέσιν.", "seq": 1298}
{"id": "Elias_Passim_1299", "series": "CAG", "text": "Τὸ μὲν γενικώτατον τὴν πρὸς τὰ μετ᾿ αὐτὸ ἔχει μόνον σχέσιν (γένος γὰρ πρὸ αὐτοῦ οὐκ ἔχει·", "seq": 1299}
{"id": "Elias_Passim_1300", "series": "CAG", "text": "τὸ γὰρ ὂν πρὸ τοῦ γενικωτάτου, ἀλλ᾿ οὐ γένος), τὰ δὲ εἴδη καὶ πρὸς τὰ ἄτομα ἔχει σχέσιν ἀλλ᾿ οὐκ ἄλλην·", "seq": 1300}
{"id": "Elias_Passim_1301", "series": "CAG", "text": "καὶ τῶν ἀτόμων γὰρ εἶδος ὡς περιέχον αὐτὰ καὶ τῶν γενῶν εἶδος ὡς περιεχόμενον ἐξ αὐτῶν.", "seq": 1301}
{"id": "Elias_Passim_1302", "series": "CAG", "text": "5.", "seq": 1302}
{"id": "Elias_Passim_1303", "series": "CAG", "text": "23 Τὰ δὲ πρὸ τῶν εἰδικωτάτων ἄχρι τοῦ γενικωτάτου ἀνιόντα γένη τε λέγεται καὶ εἴδη καὶ ὑπάλληλα γένη, ὡς ὁ Ἀγαμέμνων Ἀτρείδης καὶ Πελοπίδης.", "seq": 1303}
{"id": "Elias_Passim_1304", "series": "CAG", "text": "Ὑποσχόμενος ὁ Πορφύριος δύο παραδείγμασιν ὑποβάλλειν τὰ γενικώτατα καὶ εἰδικώτατα καὶ ὑπάλληλα, ἑνὶ μὲν ἀπὸ τῶν κατηγοριῶν ἑτέρῳ δὲ ἀπὸ τῶν γενεαλογιῶν, ἤδη μὲν τῷ ἀπὸ τῶν κατηγοριῶν ἐχρήσατο.", "seq": 1304}
{"id": "Elias_Passim_1305", "series": "CAG", "text": "ἔρχεται δὲ καὶ ἐπὶ τὸ δεύτερον, φημὶ τὸ ἀπὸ τῶν γενεαλογιῶν, καὶ μιᾷ κέχρηται τῇ ἀπὸ τοῦ Διὸς διὰ ταύτης καὶ τὰς λοιπὰς ἔχων διὰ τὸ ἐνταῦθα οὖν ἐπὶ τῶν γενεαλογιῶν ὁ μὲν μόνως πατήρ, φέρε εἰπεῖν ὁ Ζεύς, ὁ δὲ μόνως υἱὸς ὡς Ὀρέστης, οἱ δὲ πατέρες ἅμα καὶ υἱεῖς ὡς Ἀτρεύς, Τάνταλος.", "seq": 1305}
{"id": "Elias_Passim_1306", "series": "CAG", "text": "καὶ ἀναλογεῖ ὁ μὲν μόνως πατὴρ τῷ γενικωτάτῳ, ὁ δὲ μόνως υἱὸς τῷ εἰδικωτάτῳ, οἱ δὲ πατέρες ἅμα καὶ υἱεῖς ὑπαλλήλοις.", "seq": 1306}
{"id": "Elias_Passim_1307", "series": "CAG", "text": "καὶ μὴ νομίσῃς, φησὶν ὁ Πορφύριος, ὅτι ἐπειδὴ παραδείγματι τῶν κατηγοριῶν ἐχρησάμην ταῖς γενεαλογίαις, ὅτι ὥσπερ ἐπὶ τῶν γενεαλογιῶν εἰς ἓν γένος τὸ ἀνωτάτω ἀνάγονται, εἰς τὸν Δία, οὕτως καὶ ἐπὶ τῶν κατηγοριῶν ἔχει·", "seq": 1307}
{"id": "Elias_Passim_1308", "series": "CAG", "text": "οὐδὲ γὰρ ἀνάγονται ὑπὸ ἓν γένος πᾶσαι, ἀλλὰ δέκα γενικώτατά εἰσι καὶ ἀρχαὶ δέκα πάντων τῶν ὄντων, καὶ ἔστιν ἐν ἑκάστῃ αὐτῶν καὶ γενικώτατον καὶ εἰδικώτατον καὶ ὑπάλληλον, καὶ οὐ τελεῖ τὸ ἕτερον ὑπὸ τὸ ἕτερον·", "seq": 1308}
{"id": "Elias_Passim_1309", "series": "CAG", "text": "οὐδὲ γὰρ τὸ ὂν γένος τῶν κατηγοριῶν·", "seq": 1309}
{"id": "Elias_Passim_1310", "series": "CAG", "text": "οὐδὲ γὰρ ὡς γένος εἰς εἴδη διαιρεῖται ἀλλ᾿ ὡς ὁμώνυμος φωνὴ εἰς διάφορα σημαινόμενα·", "seq": 1310}
{"id": "Elias_Passim_1311", "series": "CAG", "text": "ἑξαχῶς γὰρ γινομένης τῆς διαιρέσεως δειχθήσεται ὅτι κατ᾿ οὐδένα τῶν πέντε τρόπων δύναται διαιρεῖσθαι τὸ ὂν εἰς τὰς δέκα κατηγορίας·", "seq": 1311}
{"id": "Elias_Passim_1312", "series": "CAG", "text": "λείπεται οὖν κατὰ τὸν ἕκτον.", "seq": 1312}
{"id": "Elias_Passim_1313", "series": "CAG", "text": "ἑξαχῶς γὰρ διαιρεῖται τὰ διαιρούμενα, ἢ ὡς γένος εἰς εἴδη, ὡς τὸ ζῷον εἰς τὸ λογικὸν καὶ ἄλογον, ἢ ὡς ὅλον εἰς μέρη, καὶ τοῦτο διχῶς ἢ ὡς εἰς ὁμοιομερῆ ἢ ὡς εἰς ἀνομοιομερῆ (ὁμοιομερῆ λεγόντων ἡμῶν τὰ καὶ ὀνόματος καὶ πράγματος ἔχοντα κοινωνίαν καὶ πρὸς ἑαυτὰ καὶ πρὸς τὸ ὅλον, οὗπέρ εἰσι μέρη·", "seq": 1313}
{"id": "Elias_Passim_1314", "series": "CAG", "text": "τὸ γὰρ ὀστέον εἰς μέρη διῃρημένον καὶ ὀνόματος καὶ ὁρισμοῦ κοινωνίαν ἔχει, ὁμοίως καὶ νεῦρα καὶ φλέβες·", "seq": 1314}
{"id": "Elias_Passim_1315", "series": "CAG", "text": "ἀνομοιομερῆ δέ, ἃ οὔτε ὀνόματος οὔτε ὁρισμοῦ κοινωνίαν ἔχει πρὸς ἑαυτὰ καὶ πρὸς ὅλον, ὡς τὰ μέρη τοῦ προσώπου, ὀφθαλμοὶ ῥὶς χείλη, οὔτε λέγονται πρόσωπα οὔτε εἰσίν, οὔτε δὲ οἱ ὀφθαλμοὶ ῥὶς λέγονται ἢ εἰσὶν οὔτε ἡ ῥὶς ὀφθαλμοὶ ἢ τὰ χείλη ῥὶς ἢ ὀφθαλμοί), ἢ ὡς οὐσία εἰς συμβεβηκός, ὡς ἵνα εἴπω ‘τῶν ἀνθρώπων οἱ μὲν λευκοὶ οἱ δὲ μέλανες καὶ τοῦ ζῴου τὸ μὲν ἄρρεν τὸ δὲ θῆλυ’ (μεταβάλλει γὰρ κατὰ τοῦτο, ὡς ὁ Ἀριστοτέλης ἱστόρησεν ὅτι ἔστι ζῷον, ὃ πολλάκις τῆς ἡμέρας μεταβάλλει εἰς τὸ ἄρρεν καὶ τὸ θῆλυ, ὃ καὶ τροχὸς καλεῖται διὰ τὸ ἐπιτρέχειν τὰ εἴδη, καὶ ἡ ὕαινα δὲ τῶν μεταβαλλόντων ἐστὶν εἰς τὸ θῆλυ καὶ ἄρρεν, εἰ καὶ δι᾿ ἓξ μηνῶν τοῦτο πάσχει, καὶ ὁ λαγωὸς δὲ ὁμοίως τοῦτο πάσχει καὶ μεταβάλλει), ἢ ἀνάπαλιν ὡς συμβεβηκὸς εἰς οὐσίαν, ὡς ἡνίκα εἴπωμεν ὅτι τοῦ λευκοῦ τὸ μὲν κύκνος τὸ δὲ ψιμύθιον τὸ δὲ χιών, ἢ ὡς ὁμώνυμος φωνὴ εἰς διάφορα σημαινόμενα, ὡς ἡ κύων φωνὴ εἰς χερσαῖον θαλάττιον ἀστρῷον φιλόσοφον, ἢ ὡς εἶδος εἰς ἄτομα, ὡς ὁ καθόλου ἄνθρωπος εἰς τοὺς κατὰ μέρος.", "seq": 1315}
{"id": "Elias_Passim_1316", "series": "CAG", "text": "δείξωμεν οὖν ὅτι ὡς γένος εἰς εἴδη οὐ δύναται διαιρεῖσθαι·", "seq": 1316}
{"id": "Elias_Passim_1317", "series": "CAG", "text": "ἐπὶ γὰρ τῶν ἀπὸ τοῦ γένους διαιρεθέντων εἰδῶν οὐκ ἔστι τὸ πρότερον καὶ ὕστερον (τοῦ γὰρ λογικοῦ καὶ ἀλόγου, εἰδῶν ὄντων τοῦ ζῴου, οὐδὲν οὐδενὸς πρότερον), ἐπὶ δὲ τῶν κατηγοριῶν ἔστι τὸ πρῶτον καὶ ὕστερον·", "seq": 1317}
{"id": "Elias_Passim_1318", "series": "CAG", "text": "προτέρα γὰρ ἡ οὐσία τῶν ἄλλων τῇ φύσει·", "seq": 1318}
{"id": "Elias_Passim_1319", "series": "CAG", "text": "συναναιρεῖ γὰρ τὰ συμβεβηκότα καὶ οὐ συναναιρεῖται αὐτοῖς·", "seq": 1319}
{"id": "Elias_Passim_1320", "series": "CAG", "text": "τῆς γὰρ οὐσίας ἀναιρουμένης συναναιρεῖται αὐτῇ τὰ συμβεβηκότα (ἐν αὐτῇ γὰρ τὸ εἶναι ἔχουσι), τῶν δὲ συμβεβηκότων ἀναιρουμένων οὐ συναναιρεῖται ἡ οὐσία ὡς ἀνθυπόστατος.", "seq": 1320}
{"id": "Elias_Passim_1321", "series": "CAG", "text": "καὶ συνεισάγεται ἡ οὐσία τοῖς συμβεβηκόσιν, οὐ συνεισάγεται δὲ αὐτῇ τὰ συμβεβηκότα·", "seq": 1321}
{"id": "Elias_Passim_1322", "series": "CAG", "text": "ὄντων γὰρ τῶν συμβεβηκότων πάντως καὶ ἡ οὐσία ἔστιν (ἐν αὐτῇ γὰρ ὑφίσταται τὰ συμβεβηκότα), τῆς δὲ οὐσίας οὔσης οὐ πάντως εἰσὶ τὰ συμβεβηκότα·", "seq": 1322}
{"id": "Elias_Passim_1323", "series": "CAG", "text": "τῇ γὰρ θείᾳ οὐσίᾳ οὐδὲν συμβέβηκε.", "seq": 1323}
{"id": "Elias_Passim_1324", "series": "CAG", "text": "δεύτερον ἐπιχείρημα ἐν τοῖς ὡς γένος εἰς εἴδη διαιρουμένοις·", "seq": 1324}
{"id": "Elias_Passim_1325", "series": "CAG", "text": "οὐκ ἀνάγκη ἑνὸς εἴδους ἀναιρουμένου καὶ τὰ λοιπὰ ἀναιρεῖσθαι (οὐδὲ γὰρ τοῦ λογικοῦ ἀναιρεθέντος ἀναιρεῖται τὸ ἄλογον), ἐνταῦθα δὲ ἑνὸς εἴδους ἀναιρεθέντος καὶ τὰ λοιπὰ ἀναιρεῖται·", "seq": 1325}
{"id": "Elias_Passim_1326", "series": "CAG", "text": "τῆς γὰρ οὐσίας ἀναιρεθείσης πᾶσαι ἀναιροῦνται αἱ κατηγορίαι.", "seq": 1326}
{"id": "Elias_Passim_1327", "series": "CAG", "text": "τρίτον ἐπιχείρημα ἐν τοῖς ὡς γένος εἰς εἴδη διαιρουμένοις·", "seq": 1327}
{"id": "Elias_Passim_1328", "series": "CAG", "text": "* * ἢ πάντα καθ᾿ αὑτὸ ὡστὸ λογικὸν καὶ ἄλογον, ἢ πάντα ἐν σχέσει, ὡς τοῦ πολυπλασίου τὰ εἴδη τὸ τριπλάσιον τὸ τετραπλάσιον καὶ τὰ ἐφεξῆς·", "seq": 1328}
{"id": "Elias_Passim_1329", "series": "CAG", "text": "ἐπὶ δὲ τῶν κατηγοριῶν αἱ μὲν ἐννέα καθ᾿ αὑτό εἰσι, τὰ δὲ πρός τι ἐν σχέσει.", "seq": 1329}
{"id": "Elias_Passim_1330", "series": "CAG", "text": "οὕτως μὲν ὅτι οὐχ ὡς γένος εἰς εἴδη.", "seq": 1330}
{"id": "Elias_Passim_1331", "series": "CAG", "text": "ἀλλ᾿ οὐδὲ ὡς ὅλον εἰς μέρη ὁμοιομερῆ·", "seq": 1331}
{"id": "Elias_Passim_1332", "series": "CAG", "text": "εἰ γὰρ ὁμοιομερὲς τὸ καὶ ὀνόματος καὶ ὁρισμοῦ μετέχον κοινοῦ, αἱ κατηγορίαι ὁρισμὸν οὐκ ἔχουσι κοινόν.", "seq": 1332}
{"id": "Elias_Passim_1333", "series": "CAG", "text": "ἀλλ᾿ οὐδὲ εἰς ἀνομοιομερῆ, ἐπειδὴ ἀνομοιομερές ἐστι τὸ καὶ ὀνόματος καὶ πράγματος ἔχον διαφοράν, αἱ δὲ κατηγορίαι ὄνομα κοινὸν ἔχουσι·", "seq": 1333}
{"id": "Elias_Passim_1334", "series": "CAG", "text": "πᾶσαι γὰρ κατηγορίαι λέγονται.", "seq": 1334}
{"id": "Elias_Passim_1335", "series": "CAG", "text": "ἀλλ᾿ οὐδὲ ὡς οὐσία εἰς συμβεβηκός, ἐπειδὴ ἔδει πάσας συμβεβηκότα εἶναι.", "seq": 1335}
{"id": "Elias_Passim_1336", "series": "CAG", "text": "ἀλλ᾿ οὐδὲ ὡς συμβεβηκὸς εἰς οὐσίαν, ἐπεὶ ἔδει πάσας οὐσίας εἶναι.", "seq": 1336}
{"id": "Elias_Passim_1337", "series": "CAG", "text": "ἀλλ᾿ οὐδὲ ὡς εἶδος εἰς ἄτομα, ἐπειδὴ τὰ ἄτομα ἄπειρα καὶ ἀπεριόριστα καὶ μὴ ὑποπίπτοντα ἐπιστήμῃ, αἱ δὲ κατηγορίαι δέκα τὸν ἀριθμόν.", "seq": 1337}
{"id": "Elias_Passim_1338", "series": "CAG", "text": "λείπεται τοίνυν ὡς ὁμώνυμον φωνὴν εἰς διάφορα σημαινόμενα διαιρεῖσθαι τὸ ὂν εἰς τὰς δέκα κατηγορίας.", "seq": 1338}
{"id": "Elias_Passim_1339", "series": "CAG", "text": "6.", "seq": 1339}
{"id": "Elias_Passim_1340", "series": "CAG", "text": "3 Ἀλλ᾿ ἐπὶ μὲν τῶν γενεαλογιῶν εἰς ἕνα ἀναφέρουσι, φέρε εἰπεῖν τὸν Δία, <τὴν ἀρχὴν> ὡς ἐπὶ τὸ πλεῖστον.", "seq": 1340}
{"id": "Elias_Passim_1341", "series": "CAG", "text": "Καλῶς εἶπεν ὡς ἐπὶ τὸ πλεῖστον·", "seq": 1341}
