{"id": "Elias_Passim_5139", "series": "CAG", "text": "τοῦ μὲν γὰρ ἀρετὴ τοῦ δὲ κακία τὸ γένος.", "seq": 5139}
{"id": "Elias_Passim_5140", "series": "CAG", "text": "Ἰστέον ὅτι εἰ καὶ ὑπὸ τὰ ἐναντία τελεῖν γένη ἔφη τὰ ἐναντία, οὐ κατὰ τὸ γενικώτατον αὐτῶν γένος εἴρηκεν, ἀλλὰ κατὰ τὸ προσεχὲς καὶ ὑπάλληλον·", "seq": 5140}
{"id": "Elias_Passim_5141", "series": "CAG", "text": "ἀνάγκη γὰρ πάντα τὰ ἐναντία ὑπὸ τὸ αὐτὸ τελεῖν γένος·", "seq": 5141}
{"id": "Elias_Passim_5142", "series": "CAG", "text": "εἰ γὰρ καὶ ἡ ἀδικία ὑπὸ τὴν κακίαν τελεῖ καὶ ἡ δικαιοσύνη ὑπὸ τὴν ἀρετήν, ἀλλὰ καὶ ἡ ἀρετὴ καὶ ἡ κακία ὑφ᾿ ἕν τι τελοῦσι κοινὸν γένος, τὴν ἕξιν λέγω καὶ τὴν διάθεσιν, αὐτὰ δὲ ὑπὸ τὴν ποιότητα, ἥτις ἐστὶ γένος γενικώτατον πάντων ἐναντίων.", "seq": 5142}
{"id": "Elias_Passim_5143", "series": "CAG", "text": "καὶ εἰκότως ὑφ᾿ ἓν τὰ ἐναντία τελοῦσι γένη·", "seq": 5143}
{"id": "Elias_Passim_5144", "series": "CAG", "text": "ἐσπούδασε γὰρ ἡ φύσις τὸν πρὸς ἄλληλα αὐτῶν εἰδυῖα πόλεμον ἄνωθέν τε καὶ κάτωθεν αὐτὰ δῆσαι, ἄνωθεν μὲν τῷ κοινῷ γένει κάτωθεν δὲ τῷ κοινῷ ὑποκειμένῳ.", "seq": 5144}
{"id": "Elias_Passim_5145", "series": "CAG", "text": "ταῦτα καὶ περὶ ἀντικειμένων καὶ ἡ παροῦσα θεωρία.", "seq": 5145}
{"id": "Elias_Passim_5146", "series": "CAG", "text": "Περὶ προτέρου.", "seq": 5146}
{"id": "Elias_Passim_5147", "series": "CAG", "text": "14a26 Πρότερον δὲ ἕτερον ἑτέρου λέγεται τετραχῶς.", "seq": 5147}
{"id": "Elias_Passim_5148", "series": "CAG", "text": "Καὶ περὶ προτέρου διαλέγεται ὁ Ἀριστοτέλης·", "seq": 5148}
{"id": "Elias_Passim_5149", "series": "CAG", "text": "ἐδεήθη γὰρ καὶ τούτου οὐ μόνον ἐν τῷ τῶν κατηγοριῶν τμήματι, ὅτε τὴν οὐσίαν διῄρει εἰς πρῶτον καὶ δεύτερον καὶ ὅτε πρώτην ἔλεγε τὴν οὐσίαν τῶν ἄλλων κατηγοριῶν, δεύτερον δὲ τὸ ποσὸν, ἀλλὰ καὶ ἐν τοῖς πρός τι, ὅτε πρότερον τὸ αἰσθητὸν τῆς αἰσθήσεως καὶ τὸ ἐπιστητὸν τῆς ἐπιστήμης, καὶ ἐν τοῖς ἀντικειμένοις, ὅτε πρῶτα ἔλεγε τὰ πρός τι, δεύτερα τὰ ἐναντία, τρίτην τὴν ἕξιν καὶ τὴν στέρησιν, τετάρτην ἀπόφασιν καὶ κατάφασιν.", "seq": 5149}
{"id": "Elias_Passim_5150", "series": "CAG", "text": "ὃ οὖν ποιεῖ τὸ τρίτον τμῆμα πρὸς τὸ <δεύτερον> τῶν Κατηγοριῶν τμῆμα, τὰ χρήσιμα διδάσκον πρὸς ἐκεῖνο, τοῦτο ποιεῖ αὐτὸ πρὸς ἑαυτὸ καὶ τὰ χρήσιμα διδάσκει, ὧν ἐδεήθη ἐν τῷ περὶ τῶν ἀντικειμένων λόγῳ.", "seq": 5150}
{"id": "Elias_Passim_5151", "series": "CAG", "text": "πανταχοῦ τὰ πρός τινα διδασκαλίαν ἑτέρων παραλαμβανόμενα ὕστερον διδάσκει.", "seq": 5151}
{"id": "Elias_Passim_5152", "series": "CAG", "text": "τετραχῶς δὲ λέγων τὰ πρότερα, πέντε αὐτὰ ἀπαριθμεῖται, ὡς ἑνὸς μὴ ὄντος κυρίως προτέρου.", "seq": 5152}
{"id": "Elias_Passim_5153", "series": "CAG", "text": "καὶ ὁ στοιχειωτὴς λέγων αἰτήματα πέντε, ἓξ αὐτὰ ἀπαριθμεῖται, ὡς ἑνὸς μὴ ὄντος αἰτήματος.", "seq": 5153}
{"id": "Elias_Passim_5154", "series": "CAG", "text": "διὸ καὶ δυνάμενος ἕκαστον εἶδος τῶν ἅμα ἑκάστῳ εἴδει τοῦ προτέρου ἀντιθεῖναι τῷ ἑνὶ οὐκ ἀντέταξεν ὡς ἀλλοτρίῳ φιλοσοφίας.", "seq": 5154}
{"id": "Elias_Passim_5155", "series": "CAG", "text": "διαιρεῖται δὲ τὸ πρότερον εἰς ταῦτα οὐχ ὡς γένος εἰς εἴδη·", "seq": 5155}
{"id": "Elias_Passim_5156", "series": "CAG", "text": "ἐν γὰρ τοῖς ὡς γένος εἰς εἴδη οὐκ ἔστι τὸ μὲν κυρίως τὸ δὲ οὐ κυρίως.", "seq": 5156}
{"id": "Elias_Passim_5157", "series": "CAG", "text": "ἓν τοίνυν εἶδος τοῦ προτέρου τὸ κατὰ χρόνον, ὃ καὶ κυρίως πρότερον, οὐχ ὅτι καὶ τοῦ φύσει προτέρου πρότερον, ἀλλὰ τῇ συνηθείᾳ κυρίως τοῦτο πρῶτον ἔγνωσται, ὡς τὰ Τρωϊκὰ τῶν Μηδικῶν καὶ Πλάτωνος Σωκράτης.", "seq": 5157}
{"id": "Elias_Passim_5158", "series": "CAG", "text": "ἀλλ᾿ ἐπὶ μὲν ἐμψύχων καὶ παλαιότερον καὶ πρεσβύτερον λέγεται, ἐπὶ δὲ ἀψύχων παλαιότερον μόνον.", "seq": 5158}
{"id": "Elias_Passim_5159", "series": "CAG", "text": "δεύτερον εἶδος τοῦ προτέρου τὸ συναναιροῦν καὶ μὴ συναναιρούμενον, συνεισφερόμενον καὶ μὴ συνεισφέρον, ὡς τὸ ζῷον τοῦ ἀνθρώπου φύσει πρότερον καὶ ἡ μονὰς τῆς δυάδος.", "seq": 5159}
{"id": "Elias_Passim_5160", "series": "CAG", "text": "οὐ λέγω δὲ καὶ τὸ καθολικώτερον·", "seq": 5160}
{"id": "Elias_Passim_5161", "series": "CAG", "text": "ἡ γὰρ μονὰς τῆς δυάδος φύσει μὲν προτέρα, καθολικωτέρα δὲ οὐκ ἔστιν·", "seq": 5161}
{"id": "Elias_Passim_5162", "series": "CAG", "text": "οὐ γὰρ λέγεται ἡ δυὰς μονὰς τῷ τοῦ γένους ὀνόματι.", "seq": 5162}
{"id": "Elias_Passim_5163", "series": "CAG", "text": "τρίτον εἶδος τοῦ προτέρου τὸ τῇ τάξει πρῶτον, ὥσπερ αἱ συλλαβαὶ τῶν λέξεων τὰ δὲ γράμματα τῶν στοιχείων, ἐπειδὴ αἱ γραμμικαὶ δείξεις οὐ δέονται τῶν στοιχείων εὐθὺς διὰ τῆς καταγραφῆς δεικνύουσαι τὸ σχῆμα ἤγουν τὸ διάγραμμα γραμμικόν, καὶ πολλοὶ ἐροῦσι μακροὺς λόγους μήτε γράμματα μήτε συλλαβὰς εἰδότες.", "seq": 5163}
{"id": "Elias_Passim_5164", "series": "CAG", "text": "καὶ τὰ προοίμια καὶ αἱ διηγήσεις τῶν ἀγώνων τῇ τάξει πρότερα·", "seq": 5164}
{"id": "Elias_Passim_5165", "series": "CAG", "text": "ὁ γὰρ ἄτεχνος ῥήτωρ δύναται τοῖς προοιμίοις ἐπὶ τέλει χρήσασθαι, καὶ οἱ ἀρεοπαγῖται οὔτε ἐπιλόγων οὔτε προοιμίων ἠκροῶντο.", "seq": 5165}
{"id": "Elias_Passim_5166", "series": "CAG", "text": "ταῦτα τῇ τάξει πρότερα·", "seq": 5166}
{"id": "Elias_Passim_5167", "series": "CAG", "text": "ἔξεστι γὰρ προτάξαι ἡμᾶς ἃ βουλόμεθα.", "seq": 5167}
{"id": "Elias_Passim_5168", "series": "CAG", "text": "τέταρτον εἶδος τοῦ προτέρου τὸ ἀντιστρέφον καὶ ἐξισάζον, ὁπωσοῦν δὲ αἴτιον θάτερον θατέρῳ τοῦ εἶναι, ὡς πατὴρ καὶ υἱός.", "seq": 5168}
{"id": "Elias_Passim_5169", "series": "CAG", "text": "ταῦτα ἀντιστρέφει, ἀλλ᾿ ὁ μὲν πατὴρ καὶ τοῦ εἶναι τῷ υἱῷ ὡς ἀνθρώπῳ αἴτιος καὶ τῆς σχέσεως, ὁ δὲ υἱὸς τῆς σχέσεως μόνης τῷ πατρὶ αἴτιος.", "seq": 5169}
{"id": "Elias_Passim_5170", "series": "CAG", "text": "πέμπτον εἶδος τοῦ προτέρου τὸ κατὰ τὴν ἀξίαν, ὥσπερ λέγομεν πρωτεύοντας ἐν πόλει, ὅπερ ἀλλότριον τοῦ προκειμένου·", "seq": 5170}
{"id": "Elias_Passim_5171", "series": "CAG", "text": "οὐ γὰρ φιλοσοφίας τὸ λογίζεσθαι τύχας εἰδυίας", "seq": 5171}
{"id": "Elias_Passim_5172", "series": "CAG", "text": "τὸ τῆς τύχης <γὰρ> ῥεῦμα μεταπίπτει ταχύ", "seq": 5172}
{"id": "Elias_Passim_5173", "series": "CAG", "text": "καὶ τὸ", "seq": 5173}
{"id": "Elias_Passim_5174", "series": "CAG", "text": "ὦ μῆτερ, <ἥτις> ἐκ τυραννικῶν δόμων δούλειον ἦμαρ εἶδες.", "seq": 5174}
{"id": "Elias_Passim_5175", "series": "CAG", "text": "εἰσὶ δὲ πέντε τρόποι δι᾿ αἰτίαν τοιαύτην·", "seq": 5175}
{"id": "Elias_Passim_5176", "series": "CAG", "text": "τὸ πρῶτον ἢ ἐν λόγοις καὶ ποιεῖ τὸ τῇ τάξει πρῶτον, ἢ ἐν πράγμασι.", "seq": 5176}
{"id": "Elias_Passim_5177", "series": "CAG", "text": "καὶ τοῦτο διχῶς·", "seq": 5177}
{"id": "Elias_Passim_5178", "series": "CAG", "text": "ἢ γὰρ δι᾿ ἑαυτὸ ἢ δι᾿ ἄλλο, καὶ εἰ δι᾿ ἑαυτό, ἢ μεῖζον καὶ ποιεῖ τὸ τῇ φύσει πρῶτον (μεῖζον γὰρ τὸ ζῷον τοῦ ἀνθρώπου), ἢ ἴσον καὶ ποεῖ τὸ ἀντιστρέφον, ὡς ἐπὶ πατρὸς καὶ υἱοῦ.", "seq": 5178}
{"id": "Elias_Passim_5179", "series": "CAG", "text": "<εἰ> δι᾿ ἄλλο δέ, ἢ διὰ τὸν χρόνον καὶ ποιεῖ τὸ πρῶτον ἤγουν τὸ παλαιότερον, ἢ διὰ τὴν ἀξίαν καὶ ποιεῖ τὸ πέμπτον, ὅπερ ἀλλότριον ἐδείχθη τῆς φιλοσοφίας.", "seq": 5179}
{"id": "Elias_Passim_5180", "series": "CAG", "text": "Περὶ τῶν ἅμα.", "seq": 5180}
{"id": "Elias_Passim_5181", "series": "CAG", "text": "14b24 Ἅμα δὲ κυρίως λέγεται ὧν ἡ γένεσις ἐν τῷ αὐτῷ χρόνῳ.", "seq": 5181}
{"id": "Elias_Passim_5182", "series": "CAG", "text": "Καὶ περὶ τῶν ἅμα διαλέγεται ὁ Ἀριστοτέλης·", "seq": 5182}
{"id": "Elias_Passim_5183", "series": "CAG", "text": "ἐδεήθη γὰρ καὶ τούτων εἰς τὰς κατηγορίας, ὅτε ἔλεγε τὰ πρός τι ἅμα τῇ φύσει εἶναι, καὶ ὅτι οὐ μόνον τὰ ἐναντία ἄμεσα ἢ ἔμμεσα, ἀλλὰ καὶ τῶν πρός τι τὰ μὲν ἄμεσα τὰ δὲ ἔμμεσα (ἄμεσα πρός τι δεξιὸν καὶ ἀριστερόν, ἔμμεσα δὲ μεῖζον ἔλαττον·", "seq": 5183}
{"id": "Elias_Passim_5184", "series": "CAG", "text": "μέσον γὰρ τὸ ἴσον·", "seq": 5184}
