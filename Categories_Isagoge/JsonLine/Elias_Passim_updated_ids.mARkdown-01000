{"id": "Elias_Passim_2359", "series": "CAG", "text": "Ἔνατον κεφάλαιον ἦν τῶν προτεθέντων τὸ ζητῆσαι διὰ τί τὴν ἀσάφειαν ἐπετήδευσεν ὁ Ἀριστοτέλης·", "seq": 2359}
{"id": "Elias_Passim_2360", "series": "CAG", "text": "οὐ γὰρ φύσει ἦν ἀσαφὴς καί τι δι᾿ ἀσθένειαν ἀπαγγελτικὴν τοῦτο ἐποίει (πολλαχοῦ γὰρ σαφῶς ἀπαγγέλλει, οἷον ἐν τοῖς μερικοῖς πᾶσι καὶ ἐν τοῖς μεταξύ, καὶ τῶν καθόλου ἐν τοῖς διαλογικοῖς πᾶσι καὶ τῶν αὐτοπροσώπων ἔν τισιν, οἷον ἐν τοῖς Μετεώροις καὶ τοῖς Τόποις καὶ τοῖς Σοφιστικοῖς ἐλέγχοις), ἀλλὰ φύσει ὢν σαφὴς ἐπετήδευσε τὴν ἀσάφειαν.", "seq": 2360}
{"id": "Elias_Passim_2361", "series": "CAG", "text": "ἐπιτηδεύει δὲ αὐτὴν διὰ τρεῖς αἰτίας·", "seq": 2361}
{"id": "Elias_Passim_2362", "series": "CAG", "text": "ἢ γὰρ κρύψεως χάριν ἢ δοκιμασίας ἢ γυμνασίας·", "seq": 2362}
{"id": "Elias_Passim_2363", "series": "CAG", "text": "ὅπερ γὰρ τοῖς ποιηταῖς οἱ μῦθοι καὶ τοῖς ἱερεῦσι τὰ παραπετάσματα, τοῦτο τῷ Ἀριστοτέλει ἡ ἀσάφεια μονονουχὶ ἐπάγοντι τὸ Ὀρφικὸν ἐκεῖνο", "seq": 2363}
{"id": "Elias_Passim_2364", "series": "CAG", "text": "ἀείδω ξυνετοῖσι, θύρας δ᾿ ἐπίθεσθε βεβήλοις,", "seq": 2364}
{"id": "Elias_Passim_2365", "series": "CAG", "text": "καὶ τὸ ὅμοιον τούτῳ", "seq": 2365}
{"id": "Elias_Passim_2366", "series": "CAG", "text": "κακοφραδέων δὲ βεβήλων οὔατα λαχνήεντα περισκεπέτωσαν ἀράχναι,", "seq": 2366}
{"id": "Elias_Passim_2367", "series": "CAG", "text": "καὶ τὸ Καλλιμάχειον ἐκεῖνο", "seq": 2367}
{"id": "Elias_Passim_2368", "series": "CAG", "text": "τὸν κάλαθον κατιόντα χαμαὶ δέρκεσθε γυναῖκες, μηδ᾿ ἀπὸ τοῦ τέγεος μηδ᾿ ὑψόθεν αὐγάσσησθε,", "seq": 2368}
{"id": "Elias_Passim_2369", "series": "CAG", "text": "[καὶ Ἀριστοτέλης ἐγκαλούμενος ὑπὸ Ἀλεξάνδρου ἐπὶ τῇ ἐκδόσει τῶν αὑτοῦ συγγραμμάτων ‘καὶ ἐκδέδοται’ φησὶ ‘καὶ οὐκ ἐκδέδοται’, αἰνιττόμενος τὴν ἀσάφειαν, ὡς καί τις τῶν Πυθαγορείων ἐκδοὺς τὸ μονόβιβλον τὸ Περὶ τῶν ἀλόγων γραμμάτων ναυαγίῳ περιέπεσεν ὡς τὰ ἀπόρρητα ἐξορχησάμενος] καὶ ὅ φησιν ὁ Πλάτων διὰ τὴν ἀσάφειαν, ‘ἵν᾿ εἰ ἡ δέλτος τι πάθῃ ἢ ἐν γῇ ἢ ἐν θαλάσσῃ, ὁ ἀναγνοὺς μὴ γνῷ’, οὕτω μὲν κρύψεως χάριν.", "seq": 2369}
{"id": "Elias_Passim_2370", "series": "CAG", "text": "ἢ δοκιμάσεως τῶν ἐπιτηδείων καὶ ἀνεπιτηδείων, ἵνα οἱ μὲν ἀνεπιτήδειοι πρὸς φιλοσοφίαν κατανωτίσωνται, (πρὸς οὓς ἔστιν εἰπεῖν", "seq": 2370}
{"id": "Elias_Passim_2371", "series": "CAG", "text": "πῇ φεύγεις μετὰ νῶτα βαλὼν κακὸς ὣς ἐν ὁμίλῳ;)", "seq": 2371}
{"id": "Elias_Passim_2372", "series": "CAG", "text": ",", "seq": 2372}
{"id": "Elias_Passim_2373", "series": "CAG", "text": "οἱ δ᾿ ἐπιτήδειοι πρὸς φιλοσοφίαν ἑτοιμότεροι γένωνται, μανθάνοντες ὡς πλείονος ἐπιμελείας δέονται τὰ μαθήματα, πρὸς οὓς ἔστιν εἰπεῖν τὸ Πλατωνικὸν ἐν τῇ Ἐπινομίδι εἰρημένον οὕτως·", "seq": 2373}
{"id": "Elias_Passim_2374", "series": "CAG", "text": "‘εἴτε χαλεπὰ εἴτε ῥᾴδια, ταύτῃ ἰτέον, ταῦτα <τὰ> μαθήματα, αὕτη ἡ ὁδός·", "seq": 2374}
{"id": "Elias_Passim_2375", "series": "CAG", "text": "ἀμελεῖν δὲ οὐ δεῖ’.", "seq": 2375}
{"id": "Elias_Passim_2376", "series": "CAG", "text": "οὕτω γοῦν καὶ οἱ ἀετοὶ κρίνουσι τὴν γνησιότητα καὶ τὴν νοθείαν τῶν νεοττίων·", "seq": 2376}
{"id": "Elias_Passim_2377", "series": "CAG", "text": "ἱστῶντες γὰρ τὰ νεόττια ἀντικρὺ τοῦ ἡλίου, ὅσα μὲν ἀσκαρδαμυκτὶ δύνανται ἀντωπῆσαι πρὸς τὰς αὐγὰς τοῦ ἡλίου, ἐπανάγοντες εἰς τὴν καλιὰν ὡς γνήσια ἐκτρέφουσιν, ὅσα δὲ μὴ δυνηθῶσιν ἀντωπῆσαι πρὸς τὰς αὐγὰς τοῦ ἡλίου, ὡς νόθα ἀποβάλλονται·", "seq": 2377}
{"id": "Elias_Passim_2378", "series": "CAG", "text": "ὡς γὰρ δῖος καὶ βασιλικὸς ὁ ἀετὸς τὴν βασιλικωτέραν τῶν αἰσθήσεων ἠκριβωμένην ἔχει, φημὶ δὲ τὴν ὄψιν.", "seq": 2378}
{"id": "Elias_Passim_2379", "series": "CAG", "text": "ὅτι δὲ βασιλικὸς ὁ ἀετός, δηλοῖ τὸ μὴ θέλειν αὐτὸν θνησιμαῖον ἐσθίειν ποτέ.", "seq": 2379}
{"id": "Elias_Passim_2380", "series": "CAG", "text": "οὕτω καὶ οἱ Κελτοὶ τῷ Ῥήνῳ ποταμῷ κρίνουσι τὰ γνήσια τέκνα καὶ τὴν νοθείαν τῶν βρεφῶν·", "seq": 2380}
{"id": "Elias_Passim_2381", "series": "CAG", "text": "ἐμβάλλοντες γὰρ εἰς ἀσπίδα τὰ βρέφη ἀφιᾶσιν ἐν τοῖς ὕδασι, καὶ ὅσα μὲν αὐτῶν περισωθῶσιν ἐκ τοῦ ὕδατος, γνήσια νομίζοντες ἐκτρέφουσιν, ὅσα δὲ κατακλυσθῶσιν ἐκ τοῦ ῥεύματος τοῦ ποταμοῦ, ὡς νόθα ἡγοῦνται ἀπόλλυσθαι.", "seq": 2381}
{"id": "Elias_Passim_2382", "series": "CAG", "text": "οἱ δὲ Πυθαγόρειοι καὶ τοὺς ἐπιτηδείους καὶ τοὺς ἀνεπιτηδείους πρὸς τὴν αὑτῶν φιλοσοφίαν δι᾿ ὀνειράτων προεγίνωσκον·", "seq": 2382}
{"id": "Elias_Passim_2383", "series": "CAG", "text": "ἀνέκρινον γὰρ αὐτοὺς μετὰ τὸ πολλὰ εὔξασθαι ποῖα εἶδον ὀνείρατα, καὶ ὅσους μὲν ἐνόμισαν ἐπιτηδείους εἶναι, εἰσεδέχοντο ἐν τῇ σχολῇ ἤγουν ἐν τῷ ὁμακοΐῳ, τοὺς δὲ ἀνεπιτηδείους ἀπεβάλλοντο μετὰ πάσης τῆς περιουσίας, καὶ τοῦ λοιποῦ κενοτάφιον ποιήσαντες ὡς περὶ ἀποιχομένων ἤγουν τεθνεώτων διελέγοντο.", "seq": 2383}
{"id": "Elias_Passim_2384", "series": "CAG", "text": "ὅθεν καί τις τοῦτο παθὼν ἐξ αὐτῶν Χειλέων ὁ Λακεδαιμόνιος πῦρ ὑφῆψε τῇ σχολῇ καὶ πολλοὺς ἔφθειρεν.", "seq": 2384}
{"id": "Elias_Passim_2385", "series": "CAG", "text": "ὁ δὲ Πλάτων διὰ τῆς μέθης ἔκρινε τὴν γνησιότητα τῶν ἐπιτηδείων καὶ μή, ἄμεινον ποιῶν τοῦ Πυθαγόρου, διότι τοῖς ὀνείρασιν ἔστι πολλὰ προσθεῖναι καὶ ἀφελεῖν, μεθυσθέντες δὲ πάντα ἀτρεκῶς ἐξαγγέλλομεν, ἃ πρώην πολλοῖς ἐκρύπτομεν περιβολαίοις.", "seq": 2385}
{"id": "Elias_Passim_2386", "series": "CAG", "text": "οὕτω μὲν καὶ δοκιμασίας χάριν ἢ γυμνασίας·", "seq": 2386}
{"id": "Elias_Passim_2387", "series": "CAG", "text": "οὕτω γοῦν ὁ Πλάτων τὴν χαλεπότητα τῶν δογμάτων ἐπετήδευσε γυμνασίας χάριν.", "seq": 2387}
{"id": "Elias_Passim_2388", "series": "CAG", "text": "οὕτω καὶ ὁ Ἀπόλλων τὸ λοξὸν τῶν μαντευμάτων ἐπετήδευσε·", "seq": 2388}
{"id": "Elias_Passim_2389", "series": "CAG", "text": "πείρας γὰρ χάριν τῷ Κροίσῳ δέδωκεν ἀσαφῆ χρησμὸν", "seq": 2389}
{"id": "Elias_Passim_2390", "series": "CAG", "text": "Κροῖσος Ἅλυν διαβὰς μεγάλην ἀρχὴν καταλύσει·", "seq": 2390}
{"id": "Elias_Passim_2391", "series": "CAG", "text": "ἄδηλον γὰρ ἢ τὴν ἰδίαν ἢ τὴν τῶν ὑπεναντίων·", "seq": 2391}
{"id": "Elias_Passim_2392", "series": "CAG", "text": "διὸ ἀπατηθεὶς ἐπεστράτευσε καὶ κατόπιν ἔπραξε.", "seq": 2392}
{"id": "Elias_Passim_2393", "series": "CAG", "text": "καὶ τοῖς Ἀθηναίοις χρησμὸς ἐδόθη", "seq": 2393}
{"id": "Elias_Passim_2394", "series": "CAG", "text": "τεῖχος Τριτογενεῖ ξύλινον διδοῖ εὐρύοπα Ζεύς·", "seq": 2394}
{"id": "Elias_Passim_2395", "series": "CAG", "text": "ἐδήλου γὰρ ὡς διὰ τριήρων δεῖ αὐτοὺς ναυμαχῆσαι·", "seq": 2395}
{"id": "Elias_Passim_2396", "series": "CAG", "text": "τοῦτο ἐδήλου τὸ ξύλινον τεῖχος.", "seq": 2396}
{"id": "Elias_Passim_2397", "series": "CAG", "text": "τοῦτο δὲ ὑπέλαβε Θεμιστοκλῆς ὡς δεινότατος ξυνιέναι.", "seq": 2397}
{"id": "Elias_Passim_2398", "series": "CAG", "text": "καὶ τοῖς Σαλαμινίοις ἐδόθη χρησμὸς λέγων", "seq": 2398}
{"id": "Elias_Passim_2399", "series": "CAG", "text": "ὦ θεία Σαλαμίς, ἀπολεῖς δὲ σὺ τέκνα γυναικῶν·", "seq": 2399}
{"id": "Elias_Passim_2400", "series": "CAG", "text": "ἄδηλον δὲ ποίων γυναικῶν, τῶν ἰδίων ἢ τῶν ὑπεναντίων.", "seq": 2400}
{"id": "Elias_Passim_2401", "series": "CAG", "text": "καὶ συνελόντι φάναι, ὃ τοῖς ποιηταῖς οἱ μῦθοι καὶ τοῖς ἱερεῦσι τὰ παραπετάσματα, τοῦτο τῷ Ἀριστοτέλει ἡ κατὰ λέξιν ἀσάφεια, κρύψεως χάριν.", "seq": 2401}
{"id": "Elias_Passim_2402", "series": "CAG", "text": "πάλιν ὃ τοῖς ἀετοῖς ὁ ἥλιος καὶ τοῖς Κελτοῖς ὁ Ῥῆνος, τοῖς Πυθαγορείοις τὰ ὀνείρατα, τῷ Πλάτωνι ἡ χαλεπότης τῶν δογμάτων, ἡ μέθη, τοῦτο τῷ Ἀριστοτέλει ἡ κατὰ λέξιν ἀσάφεια, δοκιμασίας χάριν ***", "seq": 2402}
{"id": "Elias_Passim_2403", "series": "CAG", "text": "Δέκατον ἦν κεφάλαιον τῶν προτεθέντων τὸ ζητῆσαι πόσα καὶ τίνα κεφάλαια δεῖ προλαμβάνειν ἐπὶ παντὸς Ἀριστοτελικοῦ συγγράμματος.", "seq": 2403}
{"id": "Elias_Passim_2404", "series": "CAG", "text": "ἓξ τοίνυν κεφάλαια δεῖ προλαμβάνειν, τὸν σκοπὸν τὸ χρήσιμον καὶ τὰ ἑξῆς.", "seq": 2404}
{"id": "Elias_Passim_2405", "series": "CAG", "text": "ζητητέον δὲ τὸν σκοπὸν καὶ ὅτε κηρύττεται ὑπὸ τῆς ἐπιγραφῆς, ἐπειδὴ πάντα πρὸς τὸν σκοπὸν ἀφορᾷ, ὥς φησι καὶ ὁ Πλάτων ‘ὦ παῖ, μία ἐστὶν ἀρχὴ τοῦ καλῶς βουλεύεσθαι, τὸ εἰδέναι περὶ ὅτου ἐστὶν ἡ σκέψις, ἢ τοῦ παντὸς ἁμαρτάνειν ἀνάγκη’.", "seq": 2405}
{"id": "Elias_Passim_2406", "series": "CAG", "text": "κηρύττεται δὲ ὁ σκοπὸς ὑπὸ τῆς ἐπιγραφῆς, ὡς ἐν τῷ Περὶ ψυχῆς κἀν τῷ Περὶ οὐρανοῦ κἀν τῷ Περὶ γενέσεως καὶ φθορᾶς.", "seq": 2406}
{"id": "Elias_Passim_2407", "series": "CAG", "text": "μάλιστα δὲ ζητητέον τὸν σκοπόν, ὅτε μὴ ὑπὸ τῆς ἐπιγραφῆς κηρύττεται, ὅτε πάνυ ἀσαφής ἐστιν ἡ ἐπιγραφὴ καὶ ἀπεξενωμένη, ὡς αἱ Κατηγορίαι καὶ τὸ Περὶ ἑρμηνείας.", "seq": 2407}
{"id": "Elias_Passim_2408", "series": "CAG", "text": "τὸ δὲ χρήσιμον ζητητέον διὰ τὸ συντονωτέρους γενέσθαι τοὺς ἀκροατὰς οἷον δέλεαρ ὁρῶντας προσγινόμενον τὸ ἐξ αὐτοῦ κέρδος πρὸς ἐρωτικὴν διάθεσιν.", "seq": 2408}
{"id": "Elias_Passim_2409", "series": "CAG", "text": "μάλιστα δὲ τὸ χρήσιμον ζητητέον διὰ τὰ δοκοῦντα μάτην γεγράφθαι βιβλία, ὡς οἱ Τόποι τὰ αὐτὰ ἀνασκευάζοντες καὶ κατασκευάζοντες, ἢ ἐπὶ κακῷ, ὡς οἱ Σοφιστικοὶ ἔλεγχοι τρόπους ἀπάτης διδάσκοντες.", "seq": 2409}
{"id": "Elias_Passim_2410", "series": "CAG", "text": "ὑπὲρ ὧν ἔστιν εἰπεῖν ὅτι καὶ οἱ Τόποι ἐπὶ καλῷ ἐγράφησαν·", "seq": 2410}
{"id": "Elias_Passim_2411", "series": "CAG", "text": "γυμνασίας γὰρ χάριν, ἵνα θλιβομένη ἡ ψυχὴ ἐκ τῶν ἐφ᾿ ἑκάτερα ἐπιχειρημάτων ἀπογεννήσῃ τὸ τῆς ἀληθείας φῶς, δίκην τῶν πυρεκβόλων λίθων τῶν παρατριβομένων ἀλλήλοις καὶ πῦρ ἀφιέντων ἢ φῶς.", "seq": 2411}
{"id": "Elias_Passim_2412", "series": "CAG", "text": "ἀλλ᾿ οὐδὲ οἱ Σοφιστικοὶ ἔλεγχοι ἐπὶ κακῷ, εἰ καὶ τρόπους ἀπάτης διδάσκουσιν·", "seq": 2412}
{"id": "Elias_Passim_2413", "series": "CAG", "text": "οὐ γὰρ ἵν᾿ ἀπατήσωμεν ἀλλ᾿ ἵνα μὴ ἀπατηθῶμεν.", "seq": 2413}
{"id": "Elias_Passim_2414", "series": "CAG", "text": "οὕτω γὰρ οἱ ἰατροὶ διδάσκουσι τὰ δηλητήρια οὐ διὰ χρῆσιν ἀλλὰ διὰ φυγήν.", "seq": 2414}
{"id": "Elias_Passim_2415", "series": "CAG", "text": "τὴν δὲ αἰτίαν τῆς ἐπιγραφῆς ζητητέον, καὶ ὅτε κηρύττει τὸν σκοπόν, μάλιστα δὲ ζητητέον τὴν ἐπιγραφήν, ὅτε ἀσαφής ἐστιν, ὅτε ὀνοματοποιεῖ ὁ Ἀριστοτέλης, ὡς ἐν Κατηγορίαις καὶ ἐν τῷ Περὶ ἑρμηνείας·", "seq": 2415}
{"id": "Elias_Passim_2416", "series": "CAG", "text": "καὶ γὰρ ὅταν λέγῃ Κατηγορίας, οὐ τὰς ἐπ᾿ ἐγκλήμασι δίκας, ὡς ἔθος, φησίν, ἀλλὰ τὰ γενικώτατα ὡς ἔθος ἔχοντα ἀεὶ κατηγορεῖσθαι καὶ μηδέποτε ὑποκεῖσθαι, καὶ πάλιν περὶ τόπων, οὐ τὸ πέρας τοῦ περιέχοντος καθ᾿ ὃ περιέχεται τὸ περιεχόμενον, ὡς λέγομεν περιέχεσθαι τὸν οἶνον ὑπὸ τῆς τοῦ κεραμίου ἔνδοθεν ἐπιφανείας, ἀλλὰ κανόνα τὸν πολλῶν κανόνων περιεκτικόν.", "seq": 2416}
{"id": "Elias_Passim_2417", "series": "CAG", "text": "καὶ πάλιν τὸ Περὶ ἑρμηνείας λέγων οὐ τὴν κατὰ λέξιν ἑρμηνείαν λέγει, ἀλλὰ τὰς τῆς ψυχῆς ἐννοίας.", "seq": 2417}
{"id": "Elias_Passim_2418", "series": "CAG", "text": "Ἐφ᾿ οἷς ζητητέον καὶ τὸ γνήσιον διὰ τὰς γινομένας νοθείας·", "seq": 2418}
{"id": "Elias_Passim_2419", "series": "CAG", "text": "νοθεύονται γὰρ τὰ βιβλία πενταχῶς·", "seq": 2419}
{"id": "Elias_Passim_2420", "series": "CAG", "text": "ἢ γὰρ δι᾿ εὐγνωμοσύνην μαθητῶν τὰ οἰκεῖα συγγράμματα τοῖς οἰκείοις διδασκάλοις ἀνατιθέντων, ὡς τὰ Πυθαγόρου καὶ Σωκράτους ἐπιγραφόμενα βιβλία μὴ ὄντα Σωκράτους ἢ Πυθαγόρου ἀλλὰ Σωκρατικῶν καὶ Πυθαγορικῶν.", "seq": 2420}
{"id": "Elias_Passim_2421", "series": "CAG", "text": "ἢ διὰ φιλοτιμίαν βασιλικήν·", "seq": 2421}
{"id": "Elias_Passim_2422", "series": "CAG", "text": "Ἰοβάτους γὰρ τοῦ Λιβύων βασιλέως συναγαγόντος τὰ Πυθαγόρου καὶ Πτολεμαίου τὰ Ἀριστοτέλους, τινὲς καπηλείας χάριν τὰ τυχόντα συγγράμματα λαμβάνοντες ἐκέδρουν καὶ ἔσηπον διὰ παραθέσεως νέων πυρῶν, ἵνα σχοῖεν δῆθεν τὴν ἐκ τοῦ χρόνου ἀξιοπιστίαν.", "seq": 2422}
{"id": "Elias_Passim_2423", "series": "CAG", "text": "ἢ δι᾿ ὁμωνυμίαν συγγραφέων ἢ συγγραμμάτων ἢ ὑπομνημάτων·", "seq": 2423}
{"id": "Elias_Passim_2424", "series": "CAG", "text": "καὶ συγγραφέων μέν, ὅτι οὐ μόνος Ἀριστοτέλης ὁ Σταγειρίτης οὕτως ἐκαλεῖτο ἀλλὰ καὶ ἄλλοι Ἀριστοτέλεις ἐγένοντο ἐπὶ αὐτοῦ, ὡς ὁ παιδοτρίβης καὶ ἐπίκλην Μῦθος, καὶ μετὰ ταῦτα, ὡς ὁ διδάσκαλος Ἀλέξανδρος·", "seq": 2424}
{"id": "Elias_Passim_2425", "series": "CAG", "text": "ἔδει γὰρ αὐτὸν οἷον δεύτερον ὄντα Ἀριστοτέλην.", "seq": 2425}
{"id": "Elias_Passim_2426", "series": "CAG", "text": "πάντων οὖν τούτων συγγραψαμένων ** νομίζονται τοῦ Σταγειρίτου εἶναι.", "seq": 2426}
{"id": "Elias_Passim_2427", "series": "CAG", "text": "*** ἀλλὰ καὶ δι᾿ ὁμωνυμίαν ὑπομνημάτων γίνεται ἀπάτη, τοῦ Ἀλεξάνδρου μὴ μόνον τὰ Ἀριστοτέλους ὑπομνηματίσαντος βιβλία τοῦ Σταγειρίτου ἀλλὰ καὶ τῶν ἄλλων, καὶ νομίζονται πάντα τὰ τοιαῦτα ὑπομνήματα εἰς τὰ τοῦ Σταγειρίτου γεγράφθαι διὰ τὸ ἐπίσημον τοῦ ἀνδρός.", "seq": 2427}
{"id": "Elias_Passim_2428", "series": "CAG", "text": "[ἢ διὰ τὸ ἐκλογὰς εἶναι ἐνομίσθησαν τοῦ αὐτοῦ εἶναι τοῦ ποιήσαντος τὰς ἐκλογὰς καὶ οὐχὶ τῶν πρωτοτύπων συγγραφέων.", "seq": 2428}
{"id": "Elias_Passim_2429", "series": "CAG", "text": "ἢ δι᾿ ὀφρὺν κτήσεως ξενοπρεπῶν βιβλίων τινὲς ἄσημοι ὄντες συγγραφεῖς διὰ τὸ δόξαι ξενοπρεπεῖς εἶναι καὶ τοιαῦτα ἔχειν βιβλία ἐπέγραφον ὀνόματα συγγραφέως ἐνδόξου.]", "seq": 2429}
{"id": "Elias_Passim_2430", "series": "CAG", "text": "οὕτω μὲν τὸ γνήσιον.", "seq": 2430}
{"id": "Elias_Passim_2431", "series": "CAG", "text": "τὴν δὲ τάξιν ζητητέον οὐ πρὸς τὰ ἀνομοιοειδῆ, ἥτις εἴρηται ἡμῖν, ὅτε ἐλέγομεν ὅτι δεῖ τὴν λογικὴν προηγεῖσθαι καὶ μετὰ ταύτην τὴν ἠθικὴν καὶ οὕτως ἐφεξῆς, ὡς εἴρηται, ἀλλὰ πρὸς τὰ ὁμοιοειδῆ τάξιν ζητητέον, λογικοῦ ὄντος τοῦ βιβλίου, ποίαν τάξιν ἔχει πρὸς τὰ λογικά, ἢ πρὸς τὰ φυσικὰ τὸ φυσικόν.", "seq": 2431}
{"id": "Elias_Passim_2432", "series": "CAG", "text": "τὴν δὲ εἰς τὰ μόρια διαίρεσιν ζητητέον ὡς ἀνατομῆς τάξιν ἔχουσαν·", "seq": 2432}
{"id": "Elias_Passim_2433", "series": "CAG", "text": "ὥσπερ γὰρ ἡ ἀνατομὴ τῶν ἐν βάθει μορίων ἀνάπτυξιν ποιουμένη τὴν ἑκάστου χρείαν παρίστησιν, οὕτω καὶ ἡ εἰς τὰ μόρια διαίρεσις τῶν Ἀριστοτέλους συγγραμμάτων ἀρίστη.", "seq": 2433}
{"id": "Elias_Passim_2434", "series": "CAG", "text": "τὸ δὲ τίς ὁ τρόπος τῆς διδασκαλίας οὐ ζητοῦμεν, ὡς καὶ αὐτοῦ ἀνωτέρω εἰρημένου, ὅτε ἐζητοῦμεν τί τὸ εἶδος τῆς φράσεως τοῦ Ἀριστοτέλους.", "seq": 2434}
{"id": "Elias_Passim_2435", "series": "CAG", "text": "ταῦτα ἔχει καὶ ἡ παροῦσα πρᾶξις.", "seq": 2435}
{"id": "Elias_Passim_2436", "series": "CAG", "text": "Ἐπειδὴ κατὰ τὸν Παιανιέα πᾶς λόγος, ἂν ἀπῇ τὰ ἔργα, μάταιόν τι νομίζεται καὶ κενόν, φέρε ἔργῳ προλάβωμεν τοῦ βιβλίου τῶν Κατηγοριῶν τὰ εἰωθότα ζητεῖσθαι ἐπὶ ἑκάστου Ἀριστοτελικοῦ βιβλίου, τὸν σκοπόν, τὸ χρήσιμον καὶ τὰ ἑξῆς.", "seq": 2436}
{"id": "Elias_Passim_2437", "series": "CAG", "text": "οὐχ εἷς τοίνυν ἔδοξεν εἶναι ὁ σκοπὸς τῶν Κατηγοριῶν, ἀλλὰ πλείους·", "seq": 2437}
{"id": "Elias_Passim_2438", "series": "CAG", "text": "ὅσα γὰρ τὰ ὄντα, τοσοῦτοι φέρονται καὶ σκοποί.", "seq": 2438}
{"id": "Elias_Passim_2439", "series": "CAG", "text": "τριττὰ δὲ τὰ ὄντα, φωναί, νοήματα καὶ πράγματα.", "seq": 2439}
{"id": "Elias_Passim_2440", "series": "CAG", "text": "οἱ μὲν οὖν περὶ φωνῶν εἰρήκασι τὸν σκοπόν, ὡς Ἀλέξανδρος καὶ Εὐστάθιος, οἱ δὲ περὶ νοημάτων, ὡς Πορφύριος, οἱ δὲ περὶ πραγμάτων, ὡς Ἑρμῖνος·", "seq": 2440}
{"id": "Elias_Passim_2441", "series": "CAG", "text": "πάντες μὲν γὰρ συνεφώνησαν περὶ τῶν δέκα κατηγοριῶν εἶναι τὸν σκοπόν, ἀλλ᾿ οἱ μὲν ὡς ἐκφωνουμένων μόνον, οἱ δὲ ὡς ὑφεστωσῶν, οἱ δὲ ὡς νοουμένων.", "seq": 2441}
{"id": "Elias_Passim_2442", "series": "CAG", "text": "καὶ οὐκ ἔστιν εἰπεῖν ὅτι ὀνόματι μὲν τρεῖς οἱ σκοποί, ἔργῳ δὲ εἷς·", "seq": 2442}
{"id": "Elias_Passim_2443", "series": "CAG", "text": "οὐδὲ γὰρ ἀκολουθεῖ ταῦτα ἀλλήλοις·", "seq": 2443}
{"id": "Elias_Passim_2444", "series": "CAG", "text": "οὐ γὰρ ὅπου φωναί, καὶ νοήματα πάντως, διὰ τὰς ἀσήμους φωνάς, οὐδὲ ὅπου νοήματα, ἐκεῖ καὶ πράγματα, διὰ τὸν τραγέλαφον καὶ ἱπποκένταυρον νοήματα ὄντα ἀνύπαρκτα.", "seq": 2444}
{"id": "Elias_Passim_2445", "series": "CAG", "text": "ἀλλὰ καὶ κατὰ τὰς αἰτίας διαφέρουσι·", "seq": 2445}
{"id": "Elias_Passim_2446", "series": "CAG", "text": "νοῦ μὲν γὰρ τὰ νοήματα, θεοῦ δὲ τὸ παράγειν τὰ πράγματα, ψυχῆς δὲ τὰς φωνάς.", "seq": 2446}
{"id": "Elias_Passim_2447", "series": "CAG", "text": "οὐχ εἷς ἄρα κατ᾿ αὐτοὺς ὁ σκοπὸς ἀλλὰ πλείους, καὶ πάντοτε τούτοις ἕλκουσι καὶ ἀνθέλκουσι τὸν Ἀριστοτέλην πρὸς κατασκευὴν τῆς ἰδίας δόξης·", "seq": 2447}
{"id": "Elias_Passim_2448", "series": "CAG", "text": "οἱ μὲν γὰρ λέγοντες ὅτι περὶ φωνῶν μόνον, ἐκ τῆς ἐπιγραφῆς κατασκευάζουσιν, ὅτι Κατηγορίαι ἐπιγέγραπται τὸ βιβλίον, κατηγορία δέ ἐστι τὸ κατά τινος ἀγορεύεσθαι ἤγουν λέγεσθαι, τὸ δὲ λέγεσθαι φωνή ἐστι·", "seq": 2448}
{"id": "Elias_Passim_2449", "series": "CAG", "text": "περὶ φωνῶν ἄρα ὁ σκοπὸς τῶν Κατηγοριῶν.", "seq": 2449}
{"id": "Elias_Passim_2450", "series": "CAG", "text": "καὶ ὅτι κατακέχρηται τῷ λέγεται ‘ὁμώνυμα λέγεται’ ‘συνώνυμα δὲ λέγεται’ <λέγων>, τὸ δὲ λέγεται φωνή·", "seq": 2450}
{"id": "Elias_Passim_2451", "series": "CAG", "text": "περὶ φωνῶν ἄρα ὁ σκοπὸς τῶν Κατηγοριῶν.", "seq": 2451}
{"id": "Elias_Passim_2452", "series": "CAG", "text": "καὶ πάλιν ἐκ τοῦ διελεῖν αὐτὸν τὰ λεγόμενα εἰς δύο·", "seq": 2452}
{"id": "Elias_Passim_2453", "series": "CAG", "text": "φησὶ γὰρ ὅτι ‘τῶν λεγομένων τὰ μὲν κατὰ συμπλοκὴν λέγεται τὰ δὲ ἄνευ συμπλοκῆς’, καὶ τὰ μὲν ἄνευ συμπλοκῆς εἰς δέκα διεῖλε κατηγορίας·", "seq": 2453}
{"id": "Elias_Passim_2454", "series": "CAG", "text": "αἱ οὖν κατηγορίαι περὶ φωνῶν εἰσιν ὡς ἐκ τῶν λεγομένων ἔχουσαι τὸ εἶναι·", "seq": 2454}
{"id": "Elias_Passim_2455", "series": "CAG", "text": "τὸ γὰρ λέγεται φωνῆς πρόσρημα.", "seq": 2455}
{"id": "Elias_Passim_2456", "series": "CAG", "text": "οἱ δὲ λέγοντες ὅτι περὶ πραγμάτων ὁ σκοπὸς τῶν Κατηγοριῶν κατασκευάζουσιν οὕτως·", "seq": 2456}
{"id": "Elias_Passim_2457", "series": "CAG", "text": "ὅτι τοῖς ἑαυτῶν ἑάλωτε πτεροῖς κατὰ τὴν παροιμίαν·", "seq": 2457}
{"id": "Elias_Passim_2458", "series": "CAG", "text": "ἃ γὰρ λέγετε κατασκευάζοντες ὅτι περὶ φωνῶν, τὰ αὐτά φαμεν πρὸς κατασκευὴν ὅτι περὶ πραγμάτων·", "seq": 2458}
{"id": "Elias_Passim_2459", "series": "CAG", "text": "φατὲ ὅτι Κατηγορίαι ἐπιγέγραπται, τὸ δὲ κατηγορεῖσθαι καὶ λέγεσθαι κατά τινος φωνῆς ἴδιον σημαντικῆς πράγματος·", "seq": 2459}
{"id": "Elias_Passim_2460", "series": "CAG", "text": "περὶ πραγμάτων ἄρα ὁ σκοπός.", "seq": 2460}
{"id": "Elias_Passim_2461", "series": "CAG", "text": "εἰ δὲ λέγετε ὅτι κατακέχρηται τῷ λέγεται, καὶ τῷ τί ἐστιν ‘οὐσία ἐστί’ λέγων καὶ ‘δεύτεραι οὐσίαι εἰσι’ λέγων·", "seq": 2461}
{"id": "Elias_Passim_2462", "series": "CAG", "text": "περὶ πραγμάτων ἄρα ὁ σκοπός.", "seq": 2462}
{"id": "Elias_Passim_2463", "series": "CAG", "text": "εἰ δὲ πάλιν λέγετε ὅτι διαιρεῖ τὰ λεγόμενα εἰς τὰ συμπεπλεγμένα καὶ εἰς τὰ ἄνευ συμπλοκῆς καὶ ἐξ αὐτῶν κατάγει τὰς κατηγορίας, τοῦτο ἡμῖν συνᾴδει·", "seq": 2463}
{"id": "Elias_Passim_2464", "series": "CAG", "text": "τὰ λεγόμενα γὰρ διεῖλεν, οὐ τὰ λέγοντα·", "seq": 2464}
{"id": "Elias_Passim_2465", "series": "CAG", "text": "τὰ δὲ λεγόμενα πράγματά εἰσι·", "seq": 2465}
{"id": "Elias_Passim_2466", "series": "CAG", "text": "περὶ πραγμάτων ἄρα ὁ σκοπὸς τῶν Κατηγοριῶν.", "seq": 2466}
{"id": "Elias_Passim_2467", "series": "CAG", "text": "οἱ δὲ λέγοντες ὅτι περὶ νοημάτων φασὶ πρὸς τοὺς πρώτους ὅτι νικᾶσθε ἡμῖν ἀμφότεροι, καὶ οἱ λέγοντες περὶ πραγμάτων μόνων εἶναι τὸν σκοπὸν καὶ οἱ λέγοντες περὶ φωνῶν, ἵνα τὰ μέσα τούτων ἀναφανῇ τὰ νοήματα, ὡς καὶ ἐξαγγέλλοντα καὶ ἐξαγγελλόμενα·", "seq": 2467}
{"id": "Elias_Passim_2468", "series": "CAG", "text": "ἐξαγγέλλουσι γὰρ μόναι αἱ φωναί, ἐξαγγέλλονται δὲ μόνα τὰ πράγματα, τὰ δὲ νοήματα καὶ ἐξαγγέλλουσι καὶ ἐξαγγέλλονται.", "seq": 2468}
{"id": "Elias_Passim_2469", "series": "CAG", "text": "Τούτων οὕτω μαχομένων ὀψέ ποτε ἐπιγενόμενος ὁ Ἰάμβλιχος ἔλυσε τοὺς ἄνδρας τῆς τε πρὸς ἀλλήλους στάσεως καὶ τῆς πρὸς τὸν Ἀριστοτέλην, λέγων οὕτως·", "seq": 2469}
{"id": "Elias_Passim_2470", "series": "CAG", "text": "μάχεσθε, ὦ ἄνδρες, μὴ μαχόμενοι καὶ ἀληθεύετε μὴ ἀληθεύοντες καὶ ψεύδεσθε μὴ ψευδόμενοι·", "seq": 2470}
{"id": "Elias_Passim_2471", "series": "CAG", "text": "ὅμοιον γὰρ πάσχετε, ὥσπερ ἂν εἴ τινες ἄνδρες ἐθέλοιεν ὁρίσασθαι τὸν ἄνθρωπον καὶ ὁ μὲν εἴποι αὐτὸν ζῷον μόνον ὁ δὲ λογικὸν ὁ δὲ θνητὸν ὁ δὲ νοῦ καὶ ἐπιστήμης δεκτικόν, μηδεὶς δὲ τὸ ὅλον ἑνῶσαι δυνηθῇ ὅτι ζῷον λογικὸν θνητὸν νοῦ καὶ ἐπιστήμης δεκτικόν.", "seq": 2471}
{"id": "Elias_Passim_2472", "series": "CAG", "text": "οὕτως οὖν καὶ ὑμεῖς ὁ μὲν περὶ φωνῶν λέγει μόνον ὁ δὲ περὶ πραγμάτων ὁ δὲ περὶ νοημάτων, ἐνὸν πάντα μῖξαι καὶ εἰπεῖν ὅτι καὶ περὶ φωνῶν καὶ περὶ νοημάτων καὶ περὶ πραγμάτων·", "seq": 2472}
{"id": "Elias_Passim_2473", "series": "CAG", "text": "ἐρωτάσθωσαν γὰρ οἱ λέγοντες περὶ φωνῶν μόνον ὅτι ‘ποίων φωνῶν;", "seq": 2473}
{"id": "Elias_Passim_2474", "series": "CAG", "text": "ἆρα τῶν ἀσήμων;", "seq": 2474}
{"id": "Elias_Passim_2475", "series": "CAG", "text": "οὐ δήπου (γραμματικῶν γὰρ αὗται), ἀλλὰ τῶν σημαινουσῶν πράγματα·", "seq": 2475}
{"id": "Elias_Passim_2476", "series": "CAG", "text": "οὐκ ἄρα περὶ φωνῶν μόνον ἀλλὰ περὶ τῶν σημαινουσῶν πράγματα’.", "seq": 2476}
{"id": "Elias_Passim_2477", "series": "CAG", "text": "οἱ δὲ περὶ πραγμάτων μόνον λέγοντες ἐρωτάσθωσαν καὶ αὐτοί·", "seq": 2477}
{"id": "Elias_Passim_2478", "series": "CAG", "text": "‘πῶς διδάσκει ὁ φιλόσοφος τὰ πράγματα;", "seq": 2478}
{"id": "Elias_Passim_2479", "series": "CAG", "text": "δακτύλῳ χρώμενος;", "seq": 2479}
{"id": "Elias_Passim_2480", "series": "CAG", "text": "οὐ δήπου·", "seq": 2480}
{"id": "Elias_Passim_2481", "series": "CAG", "text": "μερικὸν γὰρ δήπου τοῦτο καὶ ἀφιλόσοφον·", "seq": 2481}
{"id": "Elias_Passim_2482", "series": "CAG", "text": "φιλοκαθόλου γὰρ οἱ φιλόσοφοι, τὰ δὲ καθόλου οὐκ ἐνδέχεται χωρὶς λόγου διδάξαι οὐδὲ τῷ δακτύλῳ·", "seq": 2482}
{"id": "Elias_Passim_2483", "series": "CAG", "text": "** ἄρα † χρήματα πράγματα διδάσκει ἐξ ἀνάγκης’.", "seq": 2483}
{"id": "Elias_Passim_2484", "series": "CAG", "text": "οἱ δὲ περὶ νοημάτων λέγοντες εἶναι τὸν σκοπὸν ἐρωτάσθωσαν·", "seq": 2484}
{"id": "Elias_Passim_2485", "series": "CAG", "text": "‘περὶ ποίων νοημάτων;", "seq": 2485}
{"id": "Elias_Passim_2486", "series": "CAG", "text": "τῶν διακένων καὶ μὴ ἐποχουμένων τοῖς πράγμασιν, ἢ τῶν ἐποχουμένων τοῖς πράγμασιν;", "seq": 2486}
{"id": "Elias_Passim_2487", "series": "CAG", "text": "οὐ δήπου περὶ τῶν μὴ ἐποχουμένων, ἐπεὶ οὐκέτι ἡ φιλοσοφία ἐστὶ γνῶσις τῶν ὄντων ἀλλὰ τῶν μὴ ὄντων, ἀλλὰ περὶ τῶν ἐποχουμένων·", "seq": 2487}
{"id": "Elias_Passim_2488", "series": "CAG", "text": "οὐκ ἄρα περὶ νοημάτων μόνον ἀλλὰ καὶ περὶ πραγμάτων’.", "seq": 2488}
{"id": "Elias_Passim_2489", "series": "CAG", "text": "εἰ δὲ περὶ πραγμάτων, ἐξ ἀνάγκης καὶ περὶ φωνῶν διαλέγεται·", "seq": 2489}
{"id": "Elias_Passim_2490", "series": "CAG", "text": "εἰ ἄρα περὶ νοημάτων καὶ πραγμάτων, ἐξ ἀνάγκης καὶ περὶ φωνῶν διαλέγεται·", "seq": 2490}
{"id": "Elias_Passim_2491", "series": "CAG", "text": "οὐκέτι οὖν περὶ φωνῶν μόνον ἢ περὶ πραγμάτων ἢ περὶ νοημάτων, ἀλλὰ περὶ φωνῶν καὶ περὶ πραγμάτων διὰ μέσων νοημάτων·", "seq": 2491}
{"id": "Elias_Passim_2492", "series": "CAG", "text": "ἑκάστῃ γὰρ μονάδι ἡ λοιπὴ δυὰς ἕπεται.", "seq": 2492}
{"id": "Elias_Passim_2493", "series": "CAG", "text": "ἀλλ᾿ ὅσον ἐκ τούτων τρεῖς δόξουσιν εἶναι οἱ σκοποί, ὅπερ οὐδ᾿ αὐτῷ Ἰαμβλίχῳ δοκεῖ·", "seq": 2493}
{"id": "Elias_Passim_2494", "series": "CAG", "text": "ἐν γὰρ τοῖς σκοποῖς τῶν Πλάτωνος διαλόγων παντὸς βιβλίου ἕνα βούλεται εἶναι τὸν σκοπόν.", "seq": 2494}
{"id": "Elias_Passim_2495", "series": "CAG", "text": "οὕτως οὖν εἴπωμεν·", "seq": 2495}
{"id": "Elias_Passim_2496", "series": "CAG", "text": "ὁ σκοπὸς τοῦ βιβλίου τῶν Κατηγοριῶν περὶ φωνῶν ἐστι σημαινουσῶν πράγματα διὰ μέσου νοημάτων.", "seq": 2496}
{"id": "Elias_Passim_2497", "series": "CAG", "text": "Ἀλλ᾿ ἐπειδὴ τὸ ‘Σωκράτης περιπατεῖ’ καὶ ἁπλῶς πᾶσα πρότασις φωνή ἐστι σημαντικὴ πράγματος διὰ μέσου νοήματος, περὶ δὲ τῶν προτάσεων ἐν τῷ Περὶ ἑρμηνείας διαλαμβάνει, εἴπωμεν ἄλλως τὸν σκοπόν·", "seq": 2497}
{"id": "Elias_Passim_2498", "series": "CAG", "text": "ὁ σκοπὸς τῶν Κατηγοριῶν περὶ ἁπλῶν φωνῶν σημαινουσῶν ἁπλᾶ πράγματα διὰ μέσου ἁπλῶν νοημάτων.", "seq": 2498}
{"id": "Elias_Passim_2499", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ καὶ τὸ ὄνομα καθ᾿ αὑτὸ καὶ τὸ ῥῆμα φωναί εἰσιν ἁπλαῖ ἁπλᾶ σημαίνουσαι πράγματα διὰ μέσου ἁπλῶν νοημάτων, περὶ δὲ ὀνόματος καὶ ῥήματος ἐνταῦθα οὐ ζητεῖ ἀλλ᾿ ἐν τῷ Περὶ ἑρμηνείας, εἴπωμεν ἄλλως τὸν σκοπόν·", "seq": 2499}
{"id": "Elias_Passim_2500", "series": "CAG", "text": "ὁ σκοπὸς τοῦ βιβλίου τῶν Κατηγοριῶν περὶ τῆς πρώτης θέσεως τῶν ἁπλῶν φωνῶν τῶν σημαινουσῶν ἁπλᾶ πράγματα διὰ μέσου ἁπλῶν νοημάτων·", "seq": 2500}
{"id": "Elias_Passim_2501", "series": "CAG", "text": "πάλαι γὰρ συνελθόντες οἱ ὀνοματοθέται ὠνόμασαν τὸ μὲν ἄνθρωπον τὸ δὲ τυχὸν ἵππον τὸ δὲ τρέχει τὸ δὲ νικᾷ, μὴ προσδιορισάμενοι ποῖα σημαίνει χρόνον καὶ ποῖα οὔ.", "seq": 2501}
{"id": "Elias_Passim_2502", "series": "CAG", "text": "καλοῦνται ταῦτα τῆς πρώτης θέσεως τῷ ἁπλῶς οὕτως ὀνομάσαι τὰ πράγματα.", "seq": 2502}
{"id": "Elias_Passim_2503", "series": "CAG", "text": "ὕστερον δὲ ἐπιγενόμενοι ἕτεροι ὅσα μὲν εὗρον προσσημαίνοντα χρόνον, ῥῆμα ἐκάλεσαν, ὅσα δὲ οὐ προσσημαίνοντα χρόνον, ὄνομα.", "seq": 2503}
{"id": "Elias_Passim_2504", "series": "CAG", "text": "αἱ Κατηγορίαι οὖν τὰ περὶ τῆς πρώτης θέσεως ζητοῦσιν, ὡς εἴρηται, καὶ οὐ περὶ τῶν τῆς δευτέρας θέσεως, τοῦτ᾿ ἔστιν ὀνομάτων καὶ ῥημάτων.", "seq": 2504}
{"id": "Elias_Passim_2505", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ καὶ τὰ ὀνόματα τῆς πρώτης θέσεως ἄπειρά εἰσι τὰ κατὰ μέρος, αἱ δὲ κατηγορίαι ὡρισμέναι εἰσί (δέκα γὰρ τὸν ἀριθμόν), εἴπωμεν οὕτως·", "seq": 2505}
{"id": "Elias_Passim_2506", "series": "CAG", "text": "ὅτι ὁ σκοπὸς τοῦ βιβλίου τῶν Κατηγοριῶν διαλαμβάνει περὶ τῆς πρώτης θέσεως τῶν ἁπλῶν φωνῶν τῶν σημαινουσῶν ἁπλᾶ πράγματα διὰ μέσου ἁπλῶν νοημάτων, καὶ τούτων οὐκ εἰδικωτάτων οὐκ ἀτόμων οὐ μερικῶν οὐχ ὑπαλλήλων, ἀλλὰ γενικωτάτων.", "seq": 2506}
{"id": "Elias_Passim_2507", "series": "CAG", "text": "ἐν οἷς σὺν θεῷ καὶ ἡ παροῦσα πρᾶξις.", "seq": 2507}
{"id": "Elias_Passim_2508", "series": "CAG", "text": "Δεύτερον οὖν κεφάλαιον τὸ χρήσιμον.", "seq": 2508}
{"id": "Elias_Passim_2509", "series": "CAG", "text": "οὐ χρήσιμος ἡ παροῦσα πραγματεία, τολμῶ λέγειν, πρὸς φιλοσοφίαν, ἀλλὰ χρήσιμος ὡς αὐτὴ ἡ φιλοσοφία·", "seq": 2509}
{"id": "Elias_Passim_2510", "series": "CAG", "text": "καὶ ἡ φιλοσοφία γὰρ γνῶσίς ἐστι πάντων τῶν ὄντων καὶ τὸ παρὸν βιβλίον πάντα τὰ ὄντα περιέχει·", "seq": 2510}
{"id": "Elias_Passim_2511", "series": "CAG", "text": "ὑπὸ γὰρ τὰς δέκα κατηγορίας πάντα τὰ ὄντα ἀνάγεται.", "seq": 2511}
{"id": "Elias_Passim_2512", "series": "CAG", "text": "καὶ δι᾿ ἀποφάσεως τὸ χρήσιμον ῥητέον τοῦ παρόντος βιβλίου οὕτως·", "seq": 2512}
{"id": "Elias_Passim_2513", "series": "CAG", "text": "εἰ μὴ ἦν ἡ πρώτη θέσις τῶν ἁπλῶν φωνῶν, ἡ δευτέρα οὐκ ἂν ἦν·", "seq": 2513}
{"id": "Elias_Passim_2514", "series": "CAG", "text": "εἰ μὴ ἦν ἡ δευτέρα θέσις, ὀνόματα καὶ ῥήματα οὐκ ἂν ἦσαν·", "seq": 2514}
{"id": "Elias_Passim_2515", "series": "CAG", "text": "τούτων δὲ μὴ ὄντων πρότασις οὐκ ἦν·", "seq": 2515}
{"id": "Elias_Passim_2516", "series": "CAG", "text": "προτάσεως δὲ μὴ οὔσης συλλογισμὸς οὐκ ἦν·", "seq": 2516}
{"id": "Elias_Passim_2517", "series": "CAG", "text": "συλλογισμοῦ μὴ ὄντος ἀπόδειξις οὐκ ἦν·", "seq": 2517}
{"id": "Elias_Passim_2518", "series": "CAG", "text": "ἀποδείξεως μὴ οὔσης ἀπέλειπον ἂν τὰ ὄργανα τὰ διακριτικά, ἐν μὲν θεωρίᾳ διάκρισις τῶν ἀληθῶν καὶ τῶν ψευδῶν καὶ ἡ ἐκλογὴ μὲν τῶν ἀληθῶν ἀπεκλογὴ δὲ τῶν ψευδῶν, ἐν δὲ πράξει διάκρισις ἀγαθοῦ ἀπὸ κακοῦ καὶ ἡ ἐκλογὴ μὲν τῶν ἀγαθῶν ἀπεκλογὴ δὲ τῶν κακῶν·", "seq": 2518}
{"id": "Elias_Passim_2519", "series": "CAG", "text": "εἰ μὴ ἦν τὸ θεωρητικὸν καὶ τὸ πρακτικόν, ἡ φιλοσοφία οὐκ ἦν·", "seq": 2519}
{"id": "Elias_Passim_2520", "series": "CAG", "text": "εἰ μὴ ἡ φιλοσοφία ἦν, τὸ εὐδαιμονεῖν οὐκ ἦν.", "seq": 2520}
{"id": "Elias_Passim_2521", "series": "CAG", "text": "καὶ ἔχεις διὰ τοῦ δι᾿ ἀποφάσεως χρησίμου καὶ τὴν τάξιν, ὅτι δεῖ προηγεῖσθαι τὸ παρὸν βιβλίον παντὸς ἄλλου λογικοῦ βιβλίου, ἐπειδὴ καὶ ἡ πρώτη θέσις τῶν ἁπλῶν φωνῶν πάντων προηγεῖται.", "seq": 2521}
{"id": "Elias_Passim_2522", "series": "CAG", "text": "Ἐφ᾿ οἷς εἴπωμεν καὶ τὴν αἰτίαν τῆς ἐπιγραφῆς.", "seq": 2522}
{"id": "Elias_Passim_2523", "series": "CAG", "text": "ἓξ τοίνυν ἐπιγραφαὶ φέρονται τοῦ παρόντος βιβλίου·", "seq": 2523}
{"id": "Elias_Passim_2524", "series": "CAG", "text": "οἱ μὲν γὰρ ἐπέγραψαν Κατηγορίαι, ὡς αὐτὸς ὁ Ἀριστοτέλης, οἱ δὲ Περὶ τῶν κατηγοριῶν, ὥς τινες ἑταῖροι τοῦ Ἀριστοτέλους, οἱ δὲ Περὶ <τῶν> δέκα γενῶν ** τοῦ ὄντος, ὡς Πλωτῖνος ἀντιλέγων ταῖς κατηγορίαις, οἱ δὲ Πρὸ τῶν τόπων, ὡς Ἀρχύτας ὁ Ταραντῖνος, οἱ δὲ Περὶ τῶν καθόλου λόγων, ὡς Ἄδραστος ὁ Ἀφροδισιεὺς ὁ Περιπατητικός.", "seq": 2524}
{"id": "Elias_Passim_2525", "series": "CAG", "text": "νικᾷ δὲ πάσας ἡ τοῦ Ἀριστοτέλους·", "seq": 2525}
{"id": "Elias_Passim_2526", "series": "CAG", "text": "ὁ γὰρ ἐπιγράφων ὅτι Κατηγορίαι ἐνδείκνυται ὅτι οἱ λόγοι δι᾿ οἰκείαν ἰσχὺν ἴσχυσαν γενέσθαι ὅπερ τὰ πράγματα.", "seq": 2526}
{"id": "Elias_Passim_2527", "series": "CAG", "text": "οὕτω καὶ Ἀριστείδης χάριν μαρτυρῶν τῶν Ὑπὲρ τῶν τεττάρων ἐπέγραψε τοὺς λόγους οὕτω·", "seq": 2527}
{"id": "Elias_Passim_2528", "series": "CAG", "text": "Κίμων, Μιλτιάδης, Περικλῆς, Θεμιστοκλῆς.", "seq": 2528}
{"id": "Elias_Passim_2529", "series": "CAG", "text": "καὶ ὁ Πλάτων δὲ ἐπιγράφει οὕτως·", "seq": 2529}
{"id": "Elias_Passim_2530", "series": "CAG", "text": "Γοργίας, Φαίδων, Φαῖδρος.", "seq": 2530}
{"id": "Elias_Passim_2531", "series": "CAG", "text": "οἱ δὲ ἐπιγράφοντες Περὶ τῶν κατηγοριῶν ἢ ** Περὶ τῶν γενῶν τοῦ ὄντος ἢ Περὶ τῶν καθόλου λόγων ἐνδείκνυνται ὅτι οἱ λόγοι δι᾿ οἰκείαν ἀσθένειαν κατόπιν ἐγένοντο τῶν πραγμάτων καὶ οὐκ ἴσχυσαν γενέσθαι ὡς αὐτὰ τὰ πράγματα.", "seq": 2531}
{"id": "Elias_Passim_2532", "series": "CAG", "text": "νικᾷ δὲ καὶ τὴν Πρὸ τῶν τόπων ἐπιγραφήν·", "seq": 2532}
{"id": "Elias_Passim_2533", "series": "CAG", "text": "εἰ γὰρ καὶ ἐξὸν τὴν τάξιν ἐπιγραφὴν ποιῆσαι, ὡς ἐν τῇ Μετὰ τὰ φυσικά, ἀλλ᾿ ἐκεῖ εὐλόγως·", "seq": 2533}
{"id": "Elias_Passim_2534", "series": "CAG", "text": "καὶ μόναις γὰρ ἕπεται ταῖς Φυσικαῖς καὶ μόνα, τὸ δὲ παρὸν βιβλίου οὐ μόνων προηγεῖται τῶν Τόπων ἀλλὰ καὶ ἄλλων.", "seq": 2534}
{"id": "Elias_Passim_2535", "series": "CAG", "text": "οἶδε δὲ πάσας τὰς ἐπιγραφὰς ὁ Ἀριστοτέλης ἐπιγράφειν, Κατηγορίαι, Τόποι, ἀλλὰ καὶ τὴν Περὶ οὐρανοῦ καὶ κόσμου.", "seq": 2535}
{"id": "Elias_Passim_2536", "series": "CAG", "text": "αὕτη καὶ ἡ αἰτία τῆς ἐπιγραφῆς.", "seq": 2536}
{"id": "Elias_Passim_2537", "series": "CAG", "text": "Ἐφ᾿ οἷς εἴπωμεν τὸ γνήσιον.", "seq": 2537}
{"id": "Elias_Passim_2538", "series": "CAG", "text": "γνήσιον τοίνυν ἐκ τοῦ παλαιοῦ τὸ παρὸν βιβλίον ἀπὸ τῆς φράσεως καὶ τῆς δεινότητος τῶν ἐνθυμημάτων καὶ ἐκ τοῦ ὀνομαστὶ μεμνῆσθαι αὐτὸν τοῦ παρόντος βιβλίου ἐν ἄλλοις αὑτοῦ βιβλίοις καὶ λέγειν ὅτι ‘ὡς εἴρηται ἐν Κατηγορίαις’, καὶ ἐκ τοῦ κατὰ ζῆλον αὐτοῦ γράψαι τοὺς ἑταίρους αὐτοῦ ὁμώνυμα βιβλία καὶ χρήσασθαι τῇ ‘περί’ προθέσει, καὶ ἐκ τοῦ εὐθύνας δεδωκέναι αὐτὸ τοῖς Ἀττικοῖς ἐξηγηταῖς·", "seq": 2538}
{"id": "Elias_Passim_2539", "series": "CAG", "text": "τεσσαράκοντα γὰρ βιβλίων εὑρεθέντων ἐν παλαιαῖς βιβλιοθήκαις τῶν Ἀναλυτικῶν καὶ δύο τῶν Κατηγοριῶν τέσσαρα μόνα τῶν Ἀναλυτικῶν ἐκκρίνουσι καὶ τῶν Κατηγοριῶν ἕν, καὶ εἰ μὴ γνήσιον ἦν τὸ παρὸν σύγγραμμα, ἀκέφαλος ἦν πᾶσα ἡ λογικὴ πραγματεία·", "seq": 2539}
{"id": "Elias_Passim_2540", "series": "CAG", "text": "Συριανὸς μὲν γὰρ ὁ φιλόσοφος ἐπέγραψε τῷ Φαίδωνι νοθευομένῳ ὑπό τινος Παναιτίου·", "seq": 2540}
{"id": "Elias_Passim_2541", "series": "CAG", "text": "εἴ με Πλάτων οὐ γράψε, δύω ἐγένοντο Πλάτωνες·", "seq": 2541}
{"id": "Elias_Passim_2542", "series": "CAG", "text": "Σωκρατικῶν ὀάρων ἄνθεα πάντα φέρω.", "seq": 2542}
{"id": "Elias_Passim_2543", "series": "CAG", "text": "ἀλλὰ νόθον μ᾿ ἐτέλεσσε Παναίτιος, ὅς ῥ᾿ ἐτάλασσε καὶ ψυχὴν θνητὴν καί με νόθον τελέσαι.", "seq": 2543}
{"id": "Elias_Passim_2544", "series": "CAG", "text": "ἐγὼ δέ, φησὶν ὁ ἡμέτερος διδάσκαλος, ἐπιγράφω ταῖς Κατηγορίαις", "seq": 2544}
{"id": "Elias_Passim_2545", "series": "CAG", "text": "εἰ μὴ Ἀριστοτέλους γενόμην, ἢ δίπλοος οὗτος, ἢ σοφίην ἀκάρηνον ἐδείματο νόσφιν ἐμεῖο.", "seq": 2545}
{"id": "Elias_Passim_2546", "series": "CAG", "text": "οὕτως καὶ τὸ γνήσιον.", "seq": 2546}
{"id": "Elias_Passim_2547", "series": "CAG", "text": "Ἐφ᾿ οἷς εἴπωμεν τὴν εἰς τὰ μόρια διαίρεσιν.", "seq": 2547}
{"id": "Elias_Passim_2548", "series": "CAG", "text": "εἰς τρία τοίνυν διαιρεῖται τὸ παρὸν βιβλίον, <εἰς τὰ πρὸ τῶν κατηγοριῶν>, εἰς τὰς κατηγορίας, τοῦτ᾿ ἔστιν εἰς αὐτοὺς τοὺς ἀγῶνας, καὶ εἰς τὰ χρήσιμα πρὸς τὰς κατηγορίας·", "seq": 2548}
{"id": "Elias_Passim_2549", "series": "CAG", "text": "τὸ πρῶτον γὰρ καὶ τὸ τελευταῖον τμῆμα χρήσιμα διδάσκει πρὸς τὰς κατηγορίας, πλὴν οὐ τὰ αὐτά·", "seq": 2549}
{"id": "Elias_Passim_2550", "series": "CAG", "text": "ἐν μὲν γὰρ τῷ πρώτῳ τμήματι ἐκεῖνα τὰ χρήσιμα διδάσκει, ὧν οὐδεμίαν ἔχομεν πρόσκλησιν ἐκ τῆς συνηθείας, περὶ ὁμωνύμων, περὶ ὑποκειμένου, περὶ κατηγορουμένου·", "seq": 2550}
{"id": "Elias_Passim_2551", "series": "CAG", "text": "ἐν δὲ τῷ τελευταίῳ τμήματι ἐκεῖνα τῶν χρησίμων διδάσκει, ἃ καὶ ἐκ τῆς συνηθείας γινώσκομεν, περὶ προτέρου, περὶ τοῦ ἅμα, περὶ τοῦ ἔχειν, περὶ κινήσεως.", "seq": 2551}
{"id": "Elias_Passim_2552", "series": "CAG", "text": "οὐκ ἠβουλήθη δὲ πάντα τὰ χρήσιμα ἐν ἑνὶ μέρει εἰπεῖν, ἵνα μὴ τὰ προτέλεια μείζονα ποιήσῃ τῶν ἀγώνων.", "seq": 2552}
{"id": "Elias_Passim_2553", "series": "CAG", "text": "καὶ ἡμεῖς οὖν ἵνα μὴ τὰ προοίμια μείζονα ποιήσωμεν, τῶν μὲν προοιμίων ἅλις, ἐπ᾿ αὐτοὺς δὲ τοὺς ἀγῶνας λοιπὸν χωρήσωμεν καὶ τὴν ἐξήγησιν τῆς λέξεως.", "seq": 2553}
{"id": "Elias_Passim_2554", "series": "CAG", "text": "ἐν οἷς καὶ τὰ προλεγόμενα τῶν Κατηγοριῶν.", "seq": 2554}
{"id": "Elias_Passim_2555", "series": "CAG", "text": "Ἀρχὴ σὺν θεῷ τοῦ κειμένου.", "seq": 2555}
{"id": "Elias_Passim_2556", "series": "CAG", "text": "1a1 <Ὁμώνυμα λέγεται ὧν ὄνομα μόνον κοινόν>.", "seq": 2556}
{"id": "Elias_Passim_2557", "series": "CAG", "text": "Ἐπειδὴ σκοπὸς αἱ κατηγορίαι, τὸ δὲ ὁμώνυμον κατηγορεῖται τῶν κατηγοριῶν, πᾶσα δὲ κατηγορία τῶν ὑπ᾿ αὐτὴν εἰδῶν συνωνύμως κατηγορεῖται ὡς γένος εἴδους, διὰ τοῦτο ὁ Ἀριστοτέλης προτάττει τὴν διδασκαλίαν τῶν ὁμωνύμων καὶ συνωνύμων, κἀν τούτοις προτάττει τὰ ὁμώνυμα τῶν συνωνύμων, ἐπειδὴ καὶ τὸ ἓν τῶν δύο προηγεῖται·", "seq": 2557}
{"id": "Elias_Passim_2558", "series": "CAG", "text": "ἐπὶ γὰρ τῶν ὁμωνύμων ἑνὸς μόνου χρεία·", "seq": 2558}
{"id": "Elias_Passim_2559", "series": "CAG", "text": "ὀνόματος γὰρ μόνου κοινωνίαν ποιεῖ τὰ ὁμώνυμα, τὰ δὲ συνώνυμα κοινωνίαν ὀνόματος καὶ κοινωνίαν πράγματος.", "seq": 2559}
{"id": "Elias_Passim_2560", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ Ἀριστοτέλης τί ἐστι μόνον λέγει ἕκαστον, τί ὁμώνυμα καὶ τί συνώνυμα, εἴπωμεν πρὸ τοῦ τί ἐστι τὸ εἰ ἔστιν.", "seq": 2560}
{"id": "Elias_Passim_2561", "series": "CAG", "text": "εἰκότως δὲ ζητοῦμεν τὸ εἰ ἔστιν, ἐπειδή τινες ἐπιχειροῦσιν ἀνελεῖν τὰ ὁμώνυμα, δεικνύντες ὅτι οὐκ εἰσὶ ταῦτα.", "seq": 2561}
{"id": "Elias_Passim_2562", "series": "CAG", "text": "φέρε οὖν ἡμεῖς δείξωμεν ὅτι εἰσὶ τὰ ὁμώνυμα.", "seq": 2562}
{"id": "Elias_Passim_2563", "series": "CAG", "text": "δείκνυμεν δὲ οὕτως, λῆμμα ὁμολογούμενον τοῦτο προλαμβάνοντες ὅτι τῶν στοιχείων πεπερασμένων καὶ αἱ συμπλοκαὶ πεπερασμέναι εἰσί·", "seq": 2563}
{"id": "Elias_Passim_2564", "series": "CAG", "text": "τὰ δὲ στοιχεῖα πεπερασμένα εἰσίν (εἴκοσι γὰρ καὶ τέσσαρά εἰσι τὸν ἀριθμόν)·", "seq": 2564}
{"id": "Elias_Passim_2565", "series": "CAG", "text": "τῶν δὲ στοιχείων συμπλοκαί εἰσιν αἱ συλλαβαί, πεπερασμέναι ἄρα εἰσὶ καὶ αἱ συλλαβαί·", "seq": 2565}
{"id": "Elias_Passim_2566", "series": "CAG", "text": "τῶν δὲ συλλαβῶν συμπλοκαί εἰσι τὰ ὀνόματα, πεπερασμένα ἄρα εἰσὶ τὰ ὀνόματα.", "seq": 2566}
{"id": "Elias_Passim_2567", "series": "CAG", "text": "τὰ δὲ πράγματα ἄπειρά εἰσι τῷ πολλάκις καὶ ἀεὶ γίνεσθαι.", "seq": 2567}
{"id": "Elias_Passim_2568", "series": "CAG", "text": "οὐδέποτε δὲ τὸ πεπερασμένον τῷ ἀπείρῳ ἐξισοῦται, εἰ μὴ πολλάκις ἀνακυκληθῇ·", "seq": 2568}
{"id": "Elias_Passim_2569", "series": "CAG", "text": "εἰσὶν ἄρα τὰ ὁμώνυμα·", "seq": 2569}
{"id": "Elias_Passim_2570", "series": "CAG", "text": "οὐδὲν γάρ ἐστιν ὁμώνυμον εἰ μὴ ἀνακύκλησις τοῦ αὐτοῦ ὀνόματος πολλάκις γινομένη.", "seq": 2570}
{"id": "Elias_Passim_2571", "series": "CAG", "text": "οὕτω τοῦ Ἀριστοτέλους δείξαντος ὅτι εἰσὶ τὰ ὁμώνυμα <ἐν> τοῖς Σοφιστικοῖς ἐλέγχοις καὶ ὅτι ἐξ ἀνάγκης εἰσί, πειρῶνται ἀνελεῖν ταῦτα λόγῳ τοιούτῳ χρώμενοι·", "seq": 2571}
{"id": "Elias_Passim_2572", "series": "CAG", "text": "φασὶν ὅτι τὸ ὁμώνυμον πρᾶγμα καὶ τὸ ὄνομα ἐπιδέχεται τοῦ ὁμωνύμου καὶ τὸν ὁρισμὸν αὐτοῦ, τὰ δὲ τὸ αὐτὸ ὄνομα καὶ τὸν αὐτὸν ὁρισμὸν ἐπιδεχόμενα συνώνυμά εἰσι·", "seq": 2572}
{"id": "Elias_Passim_2573", "series": "CAG", "text": "τὰ ὁμώνυμα ἄρα συνώνυμα.", "seq": 2573}
{"id": "Elias_Passim_2574", "series": "CAG", "text": "καὶ τί τῶν ἄλλων ἔσται τῶν ὁμωνύμων συνωνύμων ὄντων;", "seq": 2574}
{"id": "Elias_Passim_2575", "series": "CAG", "text": "πρὸς οὓς λέγομεν λύσεις δύο, μίαν μὲν τοιαύτην·", "seq": 2575}
{"id": "Elias_Passim_2576", "series": "CAG", "text": "ὅτι οὐδὲν ἄτοπον τὸ αὐτὸ πρᾶγμα καὶ ὁμώνυμον εἶναι καὶ συνώνυμον κατ᾿ ἄλλο καὶ ἄλλο ὄνομα·", "seq": 2576}
{"id": "Elias_Passim_2577", "series": "CAG", "text": "καθὸ μὲν γὰρ Αἴας καὶ Αἴας, ὁμώνυμά εἰσιν, ὑπογραφὰς δὲ διαφόρους ἔχει ἕκαστος αὐτῶν, καθὸ μέντοι τὸ Αἴας καὶ Αἴας ἄνθρωποι, συνώνυμά εἰσιν.", "seq": 2577}
{"id": "Elias_Passim_2578", "series": "CAG", "text": "οὐδὲν οὖν ἄτοπον καὶ ὁμώνυμον εἶναι καὶ συνώνυμον τὸ αὐτό, κατ᾿ ἄλλο δὲ καὶ ἄλλο.", "seq": 2578}
{"id": "Elias_Passim_2579", "series": "CAG", "text": "ἢ καὶ ἄλλως·", "seq": 2579}
{"id": "Elias_Passim_2580", "series": "CAG", "text": "ὅτι κατὰ τὸ αὐτὸ ὄνομα καὶ ὁμώνυμον καὶ συνώνυμον δύναται εἶναι·", "seq": 2580}
{"id": "Elias_Passim_2581", "series": "CAG", "text": "ὑποκείσθωσαν γὰρ δύο τινὲς Εὔβουλοι λεγόμενοι·", "seq": 2581}
{"id": "Elias_Passim_2582", "series": "CAG", "text": "ἐνταῦθα ὡς μὲν Εὔβουλος καὶ Εὔβουλος ἑκάτεροι ὁμώνυμοι, εἰ δὲ ἐκ τύχης τινὸς εἶεν καὶ συνετοί, συνώνυμοί εἰσιν·", "seq": 2582}
{"id": "Elias_Passim_2583", "series": "CAG", "text": "εὑρίσκονται γὰρ καὶ Εὔβουλοι λεγόμενοι καὶ εὔβουλοι ὄντες, ὡς καὶ τὸν ὁρισμὸν τοῦ εὐβούλου δεχόμενοι.", "seq": 2583}
{"id": "Elias_Passim_2584", "series": "CAG", "text": "αὕτη πρώτη λύσις διπλῆ.", "seq": 2584}
{"id": "Elias_Passim_2585", "series": "CAG", "text": "δευτέρα δὲ λύσις, ὅτι παραλογίζονται οἱ λέγοντες δεικνύναι τὰ ὁμώνυμα συνώνυμα·", "seq": 2585}
{"id": "Elias_Passim_2586", "series": "CAG", "text": "οὐδὲ γὰρ ἔδειξαν ὃ ἐπηγγείλαντο, ἐπειδὴ ἡ συνώνυμος κατηγορία καὶ κοινῇ μετέχεται ὑπὸ τοῦ μετέχοντος καὶ ἰδίᾳ, κἂν μὴ ᾖ τὸ λεῖπον·", "seq": 2586}
{"id": "Elias_Passim_2587", "series": "CAG", "text": "οἷον ἀνθρώπου μὴ ὄντος δύναται ζῷον καὶ λέγεσθαι καὶ εἶναι ὁ ἵππος, καὶ τὸ ἀνάπαλιν ὁ ἄνθρωπος καὶ ζῷον λέγεται καὶ ζῷόν ἐστι, κἂν μὴ ᾖ ὁ ἵππος·", "seq": 2587}
{"id": "Elias_Passim_2588", "series": "CAG", "text": "ἐπὶ δὲ τῶν ὁμωνύμων οὐκ ἔρρωται οὗτος ὁ κανών·", "seq": 2588}
{"id": "Elias_Passim_2589", "series": "CAG", "text": "οὐδὲ γὰρ εἷς Αἴας ἐν ὅλῳ τῷ κόσμῳ δύναται εἶναι ὁμώνυμος ἄλλου μὴ ὄντος Αἴαντος.", "seq": 2589}
{"id": "Elias_Passim_2590", "series": "CAG", "text": "τί οὖν συνήγαγεν ὁ λόγος;", "seq": 2590}
{"id": "Elias_Passim_2591", "series": "CAG", "text": "ὅτι δύναται τὸ αὐτὸ καὶ ὁμώνυμον εἶναι καὶ συνώνυμον κατ᾿ ἄλλο καὶ ἄλλο, ὁμώνυμα μὲν κατ᾿ αὐτὸ τὸ ὄνομα κατ᾿ ἄλλην δὲ καὶ ἄλλην σημασίαν συνώνυμα, ὡς ἐπὶ τοῦ Εὔβουλος.", "seq": 2591}
{"id": "Elias_Passim_2592", "series": "CAG", "text": "ἐν οἷς σὺν θεῷ καὶ ἡ παροῦσα πρᾶξις.", "seq": 2592}
{"id": "Elias_Passim_2593", "series": "CAG", "text": "1a1 Ὁμώνυμα λέγεται ὧν ὄνομα μόνον κοινόν.", "seq": 2593}
{"id": "Elias_Passim_2594", "series": "CAG", "text": "Μετὰ τὸ εἰ ἔστι τῶν ὁμωνύμων ἔλθωμεν καὶ ἐπὶ τὸ τί ἐστι, ταὐτὸν εἰπεῖν καὶ ἐπὶ τὴν ὑπογραφήν.", "seq": 2594}
{"id": "Elias_Passim_2595", "series": "CAG", "text": "ὁρίζεται τοίνυν τὰ ὁμώνυμα ὁ Ἀριστοτέλης οὕτως·", "seq": 2595}
{"id": "Elias_Passim_2596", "series": "CAG", "text": "ὁμώνυμα λέγεται ὧν ὄνομα μόνον κοινὸν ὁ δὲ κατὰ τοὔνομα λόγος τῆς οὐσίας ἕτερος, ὡς τὸ Αἴας καὶ Αἴας·", "seq": 2596}
{"id": "Elias_Passim_2597", "series": "CAG", "text": "οἱ γὰρ δύο Αἴαντες ὄνομα μόνον ἔχουσι κοινὸν ὑπογραφὰς δὲ διαφόρους.", "seq": 2597}
{"id": "Elias_Passim_2598", "series": "CAG", "text": "σαφηνίσωμεν οὖν ἑκάστην λέξιν οὖσαν ἐν τῇ ὑπογραφῇ.", "seq": 2598}
{"id": "Elias_Passim_2599", "series": "CAG", "text": "1a1 Ὁμώνυμα.", "seq": 2599}
{"id": "Elias_Passim_2600", "series": "CAG", "text": "Ἰδοὺ εὐθέως ἐκ θυρῶν ὁ Ἰαμβλίχειος σκοπὸς ἀναφαίνεται, ὅτι καὶ περὶ φωνῶν καὶ περὶ νοημάτων καὶ περὶ πραγμάτων ὁ σκοπὸς ταῖς Κατηγορίαις·", "seq": 2600}
{"id": "Elias_Passim_2601", "series": "CAG", "text": "τὰ γὰρ ὁμώνυμα οὐδὲ ἐν πράγμασι μόνοις ᾗ πράγματά εἰσι θεωροῦνται, ἐπεὶ ἔσται ἡ ὁμωνυμία ταυτότης πραγμάτων, ὅπερ ἄτοπον.", "seq": 2601}
{"id": "Elias_Passim_2602", "series": "CAG", "text": "ἀλλ᾿ ἐν πράγμασιν ἡ ὁμωνυμία πεπονθόσι τὴν ὁμωνυμίαν.", "seq": 2602}
{"id": "Elias_Passim_2603", "series": "CAG", "text": "εἰ οὖν ἐξ ἀνάγκης καὶ ἐν φωναῖς καὶ ἐν πράγμασι τὰ ὁμώνυμα, καὶ ἐν νοήμασιν ἐξ ἀνάγκης·", "seq": 2603}
{"id": "Elias_Passim_2604", "series": "CAG", "text": "ὅπου γὰρ φωναί, καὶ πράγματα πάντως, μέσα δὲ τούτων εἰσὶ τὰ νοήματα.", "seq": 2604}
{"id": "Elias_Passim_2605", "series": "CAG", "text": "1a1 Λέγεται.", "seq": 2605}
{"id": "Elias_Passim_2606", "series": "CAG", "text": "Μὴ ἐπειδὴ ἐχρήσατο τῷ λέγεσθαι, πάντως περὶ φωνῶν τὸν σκοπὸν νοήσωμεν·", "seq": 2606}
{"id": "Elias_Passim_2607", "series": "CAG", "text": "καὶ ἐπὶ φωνῶν γὰρ καὶ ἐπὶ νοημάτων καὶ ἐπὶ πραγμάτων τίθεται τὸ λέγεται·", "seq": 2607}
{"id": "Elias_Passim_2608", "series": "CAG", "text": "ὡς γὰρ τοῦ λέγειν τὰ τρία δυναμένου σημαίνειν, καὶ τὸν βαρβαρίζοντα κακῶς λέγειν φαμέν, ὅτι περὶ φωνάς ἐστι τὸ σφάλμα, καὶ τὸν ἀδιανόητα φθεγγόμενον ὡς περὶ τὰ νοήματα ἁμαρτάνοντα καὶ τὸν ψευδόμενον ὡς περὶ πράγματα σφαλλόμενον.", "seq": 2608}
{"id": "Elias_Passim_2609", "series": "CAG", "text": "[ἀδιανόητοι λέγονται οἱ ταῖς ἀσήμοις λέξεσι χρώμενοι, οἷον τῷ βλίτυρι σκινδαψός·", "seq": 2609}
{"id": "Elias_Passim_2610", "series": "CAG", "text": "οὐδὲν γὰρ τούτων σημαίνει τι·", "seq": 2610}
{"id": "Elias_Passim_2611", "series": "CAG", "text": "ἢ σημαίνουσι μὲν αἱ λέξεις καθ᾿ ἑαυτάς, εἰς ἀλλήλας δέ εἰσιν ἀνακόλουθοι·", "seq": 2611}
{"id": "Elias_Passim_2612", "series": "CAG", "text": "λέγων γὰρ οὕτως ‘ὁ ἄνθρωπος ζῷον, ἀλλὰ καὶ ὁ λίθος σῶμα, ἡ ψυχὴ ἄρα ἀθάνατος’, ταῦτα ἀδιανόητα ὡς ἀνακόλουθα.]", "seq": 2612}
{"id": "Elias_Passim_2613", "series": "CAG", "text": "1a1 Ὁμώνυμα λέγαται.", "seq": 2613}
{"id": "Elias_Passim_2614", "series": "CAG", "text": "Ἀποροῦσιν ὅτι διὰ τί πληθυντικὸν ἑνικῷ ἀποδέδωκεν·", "seq": 2614}
{"id": "Elias_Passim_2615", "series": "CAG", "text": "ὀφείλων γὰρ εἰπεῖν ‘λέγονται’, λέγεται εἶπε.", "seq": 2615}
{"id": "Elias_Passim_2616", "series": "CAG", "text": "πρὸς ὅ φαμεν ὅτι τοῦτο πεποίηκεν ὁ Ἀριστοτέλης οὐ κατὰ Ἀττικὴν σύνταξιν ἢ συνήθειαν (οὐδὲ γὰρ ἐφρόντιζε τούτου ὥσπερ καὶ οἱ ἄλλοι φιλόσοφοι, μόνον μὴ κατόπιν τῆς ἀληθείας γένωνται), ἀλλὰ τοῦτο πεποίηκεν ὁ Ἀριστοτέλης καὶ πληθυντικὸν ἑνικῷ συνέταξεν, ἐπειδὴ καὶ τὰ ὁμώνυμα πολλὰ πράγματα ὄντα ἑνὶ ὀνόματι ὀνομάζονται.", "seq": 2616}
{"id": "Elias_Passim_2617", "series": "CAG", "text": "1a1 Ὧν ὄνομα.", "seq": 2617}
{"id": "Elias_Passim_2618", "series": "CAG", "text": "Ἀποροῦσί τινες λέγοντες ὅτι καὶ ἐν ῥήμασίν ἐστιν ὁμωνυμία·", "seq": 2618}
{"id": "Elias_Passim_2619", "series": "CAG", "text": "τὸ γὰρ ἐρῶ ῥῆμα σημαίνει καὶ τὸ ἐπιθυμῶ καὶ τὸ λέξω·", "seq": 2619}
{"id": "Elias_Passim_2620", "series": "CAG", "text": "πῶς οὖν εἶπεν ὄνομα μόνον κοινόν, εἰ καὶ ἐν ῥήμασίν ἐστιν ὁμωνυμία;", "seq": 2620}
{"id": "Elias_Passim_2621", "series": "CAG", "text": "τί οὖν φαμεν;", "seq": 2621}
{"id": "Elias_Passim_2622", "series": "CAG", "text": "ὅτι τὸ ὄνομα διττόν, τὸ μὲν κατὰ παντὸς μέρους λόγου φερόμενον, καθ᾿ ὅ φαμεν τὸν Πλάτωνα καλοῖς ὀνόμασι χρήσασθαι, οὐχ ὅτι ῥήμασιν οὐκ ἐχρήσατο, τὸ δὲ ἀντιδιαστελλόμενον τοῖς ἄλλαις μέρεσι τοῦ λόγου τὸ κυρίως ὄνομα τὸ πτωτικόν.", "seq": 2622}
{"id": "Elias_Passim_2623", "series": "CAG", "text": "ἐνταῦθα οὖν ὄνομα ἀκουστέον τὸ κατὰ ῥημάτων φερόμενον καὶ τῶν ἄλλων μερῶν τοῦ λόγου.", "seq": 2623}
{"id": "Elias_Passim_2624", "series": "CAG", "text": "1a1 Μόνον.", "seq": 2624}
{"id": "Elias_Passim_2625", "series": "CAG", "text": "Τὸ μόνον δύο σημαίνει·", "seq": 2625}
{"id": "Elias_Passim_2626", "series": "CAG", "text": "ἢ γὰρ τὸ μοναδικόν, καθ᾿ ὅ φαμεν ἕνα μόνον θεόν, ἢ τὸ πρὸς ἀντιδιαστολὴν τοῦ ὁμοζύγου λεγόμενον, ὡς πολλάκις λέγεται ὅτι ἀπελείφθη τις ἐν πολέμῳ δόρυ μόνον ἔχων, οὐχ ὅτι χεῖρας ἢ πόδας οὐκ εἶχεν, ἀλλ᾿ ὅτι τὰ ὁμόζυγα τούτου οὐκ εἶχεν οἷον ἀσπίδα καὶ κνημῖδας, καὶ πάλιν ἀπελείφθη τις ἐν ἀρίστῳ ἄρτον μόνον ἔχων πρὸς ἀντιδιαστολὴν τῶν ὁμοζύγων ἐδεσμάτων.", "seq": 2626}
{"id": "Elias_Passim_2627", "series": "CAG", "text": "εἴρηται οὖν ἐνταῦθα μόνον τὸ πρὸς ἀντιδιαστολὴν τοῦ ὁμοζύγου·", "seq": 2627}
{"id": "Elias_Passim_2628", "series": "CAG", "text": "τὸ γὰρ ὄνομα ὁμόζυγον τοῦ ὁρισμοῦ, διὸ καὶ ἀνθορίζονται·", "seq": 2628}
{"id": "Elias_Passim_2629", "series": "CAG", "text": "ὄνομα γάρ ἐστιν ὁρισμὸς συνεσταλμένος, ὁρισμὸς δέ ἐστιν ὄνομα ἐξηπλωμένον.", "seq": 2629}
{"id": "Elias_Passim_2630", "series": "CAG", "text": "1a1 Κοινόν.", "seq": 2630}
{"id": "Elias_Passim_2631", "series": "CAG", "text": "Τὸ κοινὸν τετραχῶς·", "seq": 2631}
{"id": "Elias_Passim_2632", "series": "CAG", "text": "ἢ γὰρ τὸ ἀδιαίρετον ὡς ὁ αὐλὸς κοινὸς ἢ οἰκέτης, ἢ τὸ διαιρούμενον ὡς ἀγρὸς ἢ οἰκία, ἢ τὸ τοῦ προκαταλαμβάνοντος ἴδιον, ὡς ὁ τοῦ θεάτρου τόπος κοινὸς ὢν τοῦ προκαταλαμβάνοντος γίνεται ἴδιος, ἢ τὸ ἐπίσης μετεχόμενον ὡς ἡ τοῦ κήρυκος φωνή (αὕτη γὰρ ἐπίσης ὑπὸ πάντων μετέχεται) [καὶ ἡ ὕλη].", "seq": 2632}
{"id": "Elias_Passim_2633", "series": "CAG", "text": "κοινὸν οὖν ἐνταῦθα δεῖ λαβεῖν τὸ ἐπίσης μετεχόμενον·", "seq": 2633}
{"id": "Elias_Passim_2634", "series": "CAG", "text": "τῆς γὰρ Αἴας φωνῆς ἐπίσης μετέχουσιν οἱ δύο Αἴαντες.", "seq": 2634}
{"id": "Elias_Passim_2635", "series": "CAG", "text": "1a1 Ὁ δὲ κατὰ τοὔνομα λόγος οὐσίας ἕτερος.", "seq": 2635}
{"id": "Elias_Passim_2636", "series": "CAG", "text": "Κατὰ τοὔνομα τὸ εἰρημένον·", "seq": 2636}
{"id": "Elias_Passim_2637", "series": "CAG", "text": "τὰ γὰρ ἄρθρα ἀναφορικά εἰσιν.", "seq": 2637}
{"id": "Elias_Passim_2638", "series": "CAG", "text": "ἀποροῦσι δέ τινες πῶς φιλοσύντομος ὢν ὁ Ἀριστοτέλης περιττὰ νῦν λέγει·", "seq": 2638}
{"id": "Elias_Passim_2639", "series": "CAG", "text": "ἤρκει γὰρ εἰπεῖν ὅτι ὁμώνυμά εἰσιν ὧν ὄνομα κοινόν·", "seq": 2639}
{"id": "Elias_Passim_2640", "series": "CAG", "text": "εἰ γὰρ ἕν τι τούτων δοθῇ, τὸ ἄλλο ἕπεται ἐξ ἀνάγκης ** ὁ γὰρ ὁρισμὸς αὐτῶν διάφορος.", "seq": 2640}
{"id": "Elias_Passim_2641", "series": "CAG", "text": "καὶ εἰ εἴποις ὅτι ὁμώνυμά εἰσιν ὧν μόνος ὁ ὁρισμὸς διάφορος, τὸ ἄλλο εἵπετο ἐξ ἀνάγκης·", "seq": 2641}
{"id": "Elias_Passim_2642", "series": "CAG", "text": "τὸ γὰρ ὄνομα αὐτῶν μόνον εἶχεν εἶναι κοινόν.", "seq": 2642}
{"id": "Elias_Passim_2643", "series": "CAG", "text": "περιττῶς οὖν εἶπεν ὁ δὲ κατὰ τοὔνομα λόγος τῆς οὐσίας ἕτερος.", "seq": 2643}
{"id": "Elias_Passim_2644", "series": "CAG", "text": "πρὸς ὅ φαμεν ὅτι οὐ μάτην τοῦτο εἶπεν, ἀλλ᾿ ἵνα δείξῃ ποῖος ὁρισμὸς διάφορος·", "seq": 2644}
{"id": "Elias_Passim_2645", "series": "CAG", "text": "οὐδὲ γὰρ ὁ ὡς ἀνθρώπων ὁρισμὸς διάφορος (ὁ αὐτὸς γὰρ λόγος τῶν δύο Αἰάντων ὡς ἀνθρώπων), οὐδὲ κατὰ τὸ Αἴας καὶ Αἴας διαφέρουσιν (ὁ αὐτὸς γὰρ λόγος τῆς Αἴας φωνῆς, ὅτι δισύλλαβος βαρύτονος καθαρὸν τὸ α ἔχουσα), ἀλλ᾿ ὁρισμὸν διάφορον ἔχουσι τὰ ὁμώνυμα κατὰ τὸ σημαινόμενον ὑπὸ τῆς φωνῆς αὐτῆς·", "seq": 2645}
{"id": "Elias_Passim_2646", "series": "CAG", "text": "ἡ γὰρ Αἴας φωνὴ σημαίνει ἐπὶ μὲν τοῦ ἑνὸς Αἴαντος ὅτι ἐστὶ τοῦ Τελαμῶνος καὶ ἐκ τῆς Σαλαμῖνος, ἐπὶ δὲ τοῦ ἄλλου ὅτι ἐστὶ τοῦ Ὀιλέως καὶ Λοκρός·", "seq": 2646}
{"id": "Elias_Passim_2647", "series": "CAG", "text": "τούτων γὰρ τῶν ἰδιωμάτων τῶν ἐφ᾿ ἑκατέρῳ θεωρουμένων ὑπογραφὴ διάφορός ἐστι.", "seq": 2647}
{"id": "Elias_Passim_2648", "series": "CAG", "text": "1a2 Τῆς οὐσίας.", "seq": 2648}
{"id": "Elias_Passim_2649", "series": "CAG", "text": "Οὐσίαν ἐνταῦθα κοινότερον ἀκουστέον τὴν καὶ κατὰ τῆς ὑπάρξεως φερομένην·", "seq": 2649}
{"id": "Elias_Passim_2650", "series": "CAG", "text": "διττὴ γὰρ ἡ οὐσία, ἡ μὲν ἀντιδιαστελλομένη ταῖς ἐννέα κατηγορίαις ἡ κυρίως οὐσία, ἡ δὲ κατὰ συμβεβηκότων φερομένη, ἣν καὶ νῦν ἀκουστέον.", "seq": 2650}
{"id": "Elias_Passim_2651", "series": "CAG", "text": "1a2 Ἕτερος.", "seq": 2651}
{"id": "Elias_Passim_2652", "series": "CAG", "text": "Διὰ τί, φασί, δύο οὐσῶν ἀντιθέσεων, κοινοῦ—ἰδίου, ταὐτοῦ—θατέρου, μὴ εὐθὺς μνησθεὶς τοῦ κοινοῦ καὶ τοῦ ἀντικειμένου ἐμνήσθη, φημὶ δὴ τοῦ ἰδίου, καὶ ἑτέρου μνησθεὶς τοῦ ταὐτοῦ οὐκ ἐμνήσθη;", "seq": 2652}
{"id": "Elias_Passim_2653", "series": "CAG", "text": "καὶ λέγομεν ὅτι βουλόμενος τεχνῶσαι ἡμᾶς καὶ πλειόνων ἀντιθέσεων ἐντὸς ποιῆσαι, ἑνὸς σκέλους ἀφ᾿ ἑκατέρας ἀντιθέσεως ἐμνήσθη, κελεύων καὶ τοῦ ἄλλου ὑπακούειν·", "seq": 2653}
{"id": "Elias_Passim_2654", "series": "CAG", "text": "μνησθεὶς γὰρ κοινοῦ εἰς ἔννοιάν σε τίθησι τοῦ ἰδίου, καὶ μνησθεὶς ἑτέρου κελεύει σε νοεῖν τὸ ταὐτόν.", "seq": 2654}
{"id": "Elias_Passim_2655", "series": "CAG", "text": "ἐν οἷς καὶ ἡ παροῦσα πρᾶξις.", "seq": 2655}
{"id": "Elias_Passim_2656", "series": "CAG", "text": "Ὁρισάμενος ὁ Ἀριστοτέλης τὰ ὁμώνυμα ὧν ὄνομα μόνον κοινὸν ὁ δὲ κατὰ τοὔνομα λόγος τῆς οὐσίας ἕτερος, παραδείγματι κέχρηται πρὸς παράστασιν τῶν ὁμωνύμων τῷ τε ἀληθινῷ ἀνθρώπῳ καὶ τῷ γεγραμμένῳ·", "seq": 2656}
{"id": "Elias_Passim_2657", "series": "CAG", "text": "τούτων γὰρ ἑκάτερος ζῷον λέγεται (ὅτι δὲ ὁ γεγραμμένος ζῷον λέγεται, δῆλον ἐντεῦθεν, ὅτι ὁ δημιουργὸς αὐτοῦ ζωγράφος εἴρηται), ὁ δὲ ὁρισμὸς αὐτῶν διάφορος·", "seq": 2657}
{"id": "Elias_Passim_2658", "series": "CAG", "text": "ὁ γὰρ ἀληθὴς ἄνθρωπος οὐσία ἐμψυχὸς αἰσθητική, ὁ δὲ γεγραμμένος οὐκ οὐσία ἀλλὰ συμβεβηκός, οὐκ ἔμψυχος ἀλλ᾿ ἄψυχος, οὐκ αἰσθητικὸς ἀλλ᾿ ἀναίσθητος, ἀλλὰ ζῷον λέγεται ὡς εἰκὼν οὐσίας ἐμψύχου αἰσθητικῆς.", "seq": 2658}
{"id": "Elias_Passim_2659", "series": "CAG", "text": "να δὲ γνῶμεν ὑπὸ ποῖον τῶν ὁμωνύμων ἀνάγεται τὸ παράδειγμα, φέρε εἴπωμεν τὴν διαίρεσιν τῶν ὁμωνύμων.", "seq": 2659}
{"id": "Elias_Passim_2660", "series": "CAG", "text": "τούτων τὰ μέν εἰσιν ἀπὸ τύχης, ὡς ὅταν τινὲς ἐν διαφόροις τόποις ὄντες τῷ αὐτῷ ὀνόματι ὀνομάζωνται, μηδεμίαν ἔννοιαν ἐσχηκότος τοῦ ὀνομάσαντος τῶν ἐν ἄλλῳ τόπῳ οὕτως ὀνομαζομένων, ὥσπερ Ἀλέξανδρος ὁ Πάρις καὶ ὁ Μακεδών, τὰ δὲ ἀπὸ διανοίας, ὡς ὅταν βουλευσάμενός τις ὀνομάσῃ ὄνομα.", "seq": 2660}
{"id": "Elias_Passim_2661", "series": "CAG", "text": "καὶ τὰ μὲν ἀπὸ τύχης ἀδιαίρετα·", "seq": 2661}
{"id": "Elias_Passim_2662", "series": "CAG", "text": "αἱ γὰρ διαιρέσεις ὑπὸ τεχνῶν καὶ ἐπιστημῶν προβάλλονται, ὥς φησι καὶ ὁ Πλάτων, ὅτι ἐμπειρία μὲν ἡμῶν τὸν αἰῶνα ποιεῖ πορεύεσθαι κατὰ τέχνην, ἀπειρία δὲ κατὰ τύχην.", "seq": 2662}
{"id": "Elias_Passim_2663", "series": "CAG", "text": "τὰ δὲ ἀπὸ διανοίας ἃ μὲν κατὰ χρονικὴν ἔννοιαν ἃ δὲ οὐ κατὰ χρονικὴν ἔννοιαν, καὶ τῶν κατὰ χρονικὴν ἔννοιαν τὰ μὲν κατὰ μνήμην, ὡς εἴ τις τοῦ πατρὸς μνημονεύων τὸν υἱὸν τὸν ἴδιον τῷ ἐκείνου ὀνομάσῃ ὀνόματι, τὰ δὲ κατ᾿ ἐλπίδα, ὡς εἴ τις τὸν υἱὸν αὑτοῦ ὀνομάσῃ Πλάτωνα ἐλπίσας αὐτὸν γενήσεσθαι τοιοῦτον (οἶδε γὰρ καὶ ἀξιοπίστων ἀνδρῶν ὀνόματα ἐρεθίζειν ἡμᾶς πρὸς μίμησιν ἐκείνων ὧν εἰσι καὶ τὰ ὀνόματα), τὰ δὲ κατὰ τὸ συναμφότερον καὶ κατὰ μνήμην καὶ κατ᾿ ἐλπίδα.", "seq": 2663}
{"id": "Elias_Passim_2664", "series": "CAG", "text": "οὕτω μὲν τῶν κατὰ χρονικὴν ἔννοιαν.", "seq": 2664}
{"id": "Elias_Passim_2665", "series": "CAG", "text": "τῶν δὲ οὐ κατὰ χρονικὴν ἔννοιαν τὰ μὲν κατὰ μέθεξιν, ὡς ἀπὸ τῆς μουσικῆς μουσικὴ γυνή, τὰ δὲ κατὰ μεταφοράν.", "seq": 2665}
{"id": "Elias_Passim_2666", "series": "CAG", "text": "διαφέρει δὲ μεταφορὰ ἀναλογίας·", "seq": 2666}
{"id": "Elias_Passim_2667", "series": "CAG", "text": "μεταφορὰ γάρ ἐστι σύντομος ἀναλογία, ἀναλογία δέ ἐστιν ὡς ὅταν εἴπω ὅτι οἷον λόγον ἔχει τόδε πρὸς τόδε, τοῦτον ἔχει τόδε πρὸς τόδε.", "seq": 2667}
{"id": "Elias_Passim_2668", "series": "CAG", "text": "ἡ δὲ μεταφορὰ οὐ λόγῳ κέχρηται ἀλλ᾿ ὀνόματι·", "seq": 2668}
{"id": "Elias_Passim_2669", "series": "CAG", "text": "ὀφείλων γὰρ εἰπεῖν τις ‘ὁποῖον λόγον ἔχει ὁ ποιμὴν πρὸς τὰ πρόβατα, τοῦτον ὁ βασιλεὺς πρὸς τὸν λαόν’ καὶ χρήσασθαι οὕτω τῇ ἀναλογίᾳ, μὴ εἴποι οὕτως ἀλλὰ ποιμένα καλέσαι λαῶν τὸν βασιλέα μεταφορικῶς.", "seq": 2669}
{"id": "Elias_Passim_2670", "series": "CAG", "text": "οὕτω μὲν τὰ κατὰ μεταφοράν.", "seq": 2670}
{"id": "Elias_Passim_2671", "series": "CAG", "text": "πάλιν τὰ μὲν ἀφ᾿ ἑνὸς τὰ δὲ πρὸς ἕν·", "seq": 2671}
{"id": "Elias_Passim_2672", "series": "CAG", "text": "καὶ τὰ μὲν ἀφ᾿ ἑνὸς ἢ ὡς ἀπὸ ποιητικοῦ, ὡς ἀπὸ ἰατρικῆς ἰατρικὸν σμιλίον καὶ βιβλίον, ἢ ὡς ἀπὸ παραδειγματικοῦ, ὡς ἀπὸ ἀληθινοῦ ἀνθρώπου ὁ γεγραμμένος·", "seq": 2672}
{"id": "Elias_Passim_2673", "series": "CAG", "text": "εἰκὼν γὰρ ὁ γεγραμμένος τοῦ ἀληθινοῦ ἀνθρώπου.", "seq": 2673}
{"id": "Elias_Passim_2674", "series": "CAG", "text": "τὰ δὲ πρὸς ἓν οἷον τὰ πρὸς ἓν τέλος ἀφορῶντα, ὑγιεινὸν οὖρον ὑγιεινὸν σιτίον.", "seq": 2674}
{"id": "Elias_Passim_2675", "series": "CAG", "text": "τὸ παράδειγμα οὖν ἐλήφθη ἀπὸ τῶν ἀφ᾿ ἑνὸς καὶ τούτων ἀπὸ τοῦ παραδειγματικοῦ.", "seq": 2675}
{"id": "Elias_Passim_2676", "series": "CAG", "text": "καὶ ταῦτα μὲν περὶ τούτων.", "seq": 2676}
{"id": "Elias_Passim_2677", "series": "CAG", "text": "Δεῖ δὲ τὰ ὁμώνυμα μὴ κατὰ μόνην τὴν προφορὰν κοινωνεῖν, ἀλλὰ καὶ κατ᾿ ἄλλα περιστατικά, οἷον τόνον πτῶσιν πνεῦμα γένος ἀριθμὸν γραφὴν μέρος λόγου συνήθειαν·", "seq": 2677}
{"id": "Elias_Passim_2678", "series": "CAG", "text": "τὸ γὰρ ἄργος παροξυτόνως καὶ τὸ ἀργὸς ὀξυτόνως οὐχ ὁμώνυμα·", "seq": 2678}
{"id": "Elias_Passim_2679", "series": "CAG", "text": "τῷ γὰρ τόνῳ διαφέρει·", "seq": 2679}
{"id": "Elias_Passim_2680", "series": "CAG", "text": "καὶ ὅτε μὲν παροξύνεται, δηλοῖ τὸν Ἄργον τὸν φύλακα τῆς Ἰοῦς, ὃν ἀποκτείνας ὁ Ἑρμῆς Ἀργειφόντης ἐκλήθη (δηλοῖ δὲ καὶ ἄλλα ὀνόματα κύρια), ὅτε δὲ ὀξυτόνως, δηλοῖ τὸν μηδὲν ἐργαζόμενον καὶ τὸν ταχὺν καὶ τὸν λευκόν.", "seq": 2680}
{"id": "Elias_Passim_2681", "series": "CAG", "text": "πάλιν τὸ ἐλάτης οὐκ ἔστιν ὁμώνυμον·", "seq": 2681}
{"id": "Elias_Passim_2682", "series": "CAG", "text": "διάφορος γὰρ ἡ πτῶσις·", "seq": 2682}
{"id": "Elias_Passim_2683", "series": "CAG", "text": "ὅτε γὰρ τὸν ἐλάτην δηλοῖ, ἤγουν τὸν ἐλαύνοντα, εὐθεῖά ἐστιν, ὅτε δὲ τὸ δένδρον, θηλυκῆς ἐστι πτώσεως γενικῆς, οἷον ἡ ἐλάτη τῆς ἐλάτης.", "seq": 2683}
{"id": "Elias_Passim_2684", "series": "CAG", "text": "ἀλλ᾿ οὐδὲ τὸ ‘οιος’ ὁμώνυμον δύναται εἶναι·", "seq": 2684}
{"id": "Elias_Passim_2685", "series": "CAG", "text": "σημαίνει γὰρ καὶ τὸ μόνος καὶ τὸ ὁποῖος, ἀλλ᾿ ὅπου μὲν δασύνεται, τὸ ὁποῖος σημαίνει, ὅπου δὲ ψιλοῦται, τὸ μόνος·", "seq": 2685}
{"id": "Elias_Passim_2686", "series": "CAG", "text": "ἐπειδὴ γὰρ διαφέρει κατὰ τὸ πνεῦμα, οὐ δύναται εἶναι ὁμώνυμον.", "seq": 2686}
{"id": "Elias_Passim_2687", "series": "CAG", "text": "ὥσπερ οὐδὲ τὸ κενόν / καινόν·", "seq": 2687}
{"id": "Elias_Passim_2688", "series": "CAG", "text": "ἡ γὰρ γραφὴ διάφορος·", "seq": 2688}
{"id": "Elias_Passim_2689", "series": "CAG", "text": "ὅτε γὰρ δηλοῖ τὸ μάταιον καὶ τὸ κοῦφον, διὰ τοῦ ε ψιλοῦ γράφεται, ὅτε δὲ τὸ νέον, διὰ διφθόγγου.", "seq": 2689}
{"id": "Elias_Passim_2690", "series": "CAG", "text": "οὐδὲ τὸ εἶπον πάλιν δύναται ὁμώνυμον εἶναι·", "seq": 2690}
{"id": "Elias_Passim_2691", "series": "CAG", "text": "ὁ γὰρ ἀριθμὸς διάφορος·", "seq": 2691}
{"id": "Elias_Passim_2692", "series": "CAG", "text": "τὸ γὰρ ‘εἶπον ἐκεῖνοι’ πληθυντικοῦ ἐστιν ἀριθμοῦ, τὸ δὲ ‘εἶπον ἐγώ’ ἑνικοῦ.", "seq": 2692}
{"id": "Elias_Passim_2693", "series": "CAG", "text": "ἀλλ᾿ οὐδὲ τὸ φάρος ὁμώνυμον δύναται εἶναι·", "seq": 2693}
{"id": "Elias_Passim_2694", "series": "CAG", "text": "δηλοῖ γὰρ θηλυκῶς μὲν ἐκφωνούμενον τὴν πόλιν, ἀρσενικῶς δὲ τὸ κτίσμα, οὐδετέρως δὲ τὸ ἱμάτιον·", "seq": 2694}
{"id": "Elias_Passim_2695", "series": "CAG", "text": "ἐπειδὴ οὖν τὸ γένος διάφορον, ὁμώνυμον εἶναι οὐ δύναται.", "seq": 2695}
{"id": "Elias_Passim_2696", "series": "CAG", "text": "οὐδὲ πάλιν τὸ ἔχεις ὁμώνυμον, διάφορον ὂν μέρος λόγου·", "seq": 2696}
{"id": "Elias_Passim_2697", "series": "CAG", "text": "δηλοῖ γὰρ τὰς ἐχίδνας, οἷον οἱ ἔχεις τῶν ἔχεων, δηλοῖ δὲ καὶ τὴν καθεκτικὴν ἐνέργειαν, ἔχω ἔχεις.", "seq": 2697}
{"id": "Elias_Passim_2698", "series": "CAG", "text": "ἀλλ᾿ οὐδὲ τὸ ἅρμα ὁμώνυμον·", "seq": 2698}
{"id": "Elias_Passim_2699", "series": "CAG", "text": "δηλοῖ γὰρ τὸ ζεῦγος τῶν ἵππων καὶ τὰ ὅπλα, παρὰ μὲν Ῥωμαίοις τὰ ὅπλα, παρὰ δὲ Ἕλλησι τὸ ζεῦγος.", "seq": 2699}
{"id": "Elias_Passim_2700", "series": "CAG", "text": "ἐπειδὴ οὖν παρὰ τὴν διάφορον συνήθειαν διάφορα σημαίνει, ὁμώνυμον εἶναι οὐ δύναται.", "seq": 2700}
{"id": "Elias_Passim_2701", "series": "CAG", "text": "ταῦτα δὲ περὶ διαιρέσεων καὶ συστάσεων τῶν ὁμωνύμων.", "seq": 2701}
{"id": "Elias_Passim_2702", "series": "CAG", "text": "ἐν οἷς καὶ ἡ παροῦσα πρᾶξις.", "seq": 2702}
{"id": "Elias_Passim_2703", "series": "CAG", "text": "1a6 Συνώνυμα δὲ λέγεται ὧν τὸ ὄνομα κοινὸν καὶ ὁ λόγος τῆς οὐσίας ὁ αὐτός.", "seq": 2703}
{"id": "Elias_Passim_2704", "series": "CAG", "text": "Μετὰ τὰ ὁμώνυμα ἔρχεται ὁ Ἀριστοτέλης ἐπὶ τὰ συνώνυμα·", "seq": 2704}
{"id": "Elias_Passim_2705", "series": "CAG", "text": "δέεται γὰρ καὶ τούτων εἰς τὰς δέκα κατηγορίας, εἴ γε ἑκάστη κατηγορία τῶν οἰκείων εἰδῶν συνωνύμως κατηγορεῖται.", "seq": 2705}
{"id": "Elias_Passim_2706", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ κἀνταῦθα τί ἐστι τὰ συνώνυμα λέγει, προηγεῖται δὲ τὸ εἰ ἔστι τοῦ τί ἐστι, δείξωμεν ὅτι εἰσὶ τὰ συνώνυμα.", "seq": 2706}
{"id": "Elias_Passim_2707", "series": "CAG", "text": "εἰσὶ τοίνυν τὰ συνώνυμα διὰ τριῶν αἰτιῶν·", "seq": 2707}
{"id": "Elias_Passim_2708", "series": "CAG", "text": "πρῶτον μὲν αὐτὰ τὰ ὁμώνυμα συνώνυμα ἐδείχθη, δεύτερον ὅτι τεσσάρων τινῶν παρακειμένων ἀλλήλοις, ὁμωνύμων συνωνύμων πολυωνύμων ἑτερωνύμων, ἔστι δι᾿ ἑνὸς λόγου δεῖξαι ὅτι εἰσὶ τὰ τέσσαρα καὶ τί ἐστιν αὐτῶν ἕκαστον.", "seq": 2708}
{"id": "Elias_Passim_2709", "series": "CAG", "text": "δείκνυμεν δὲ ταῦτα ἐκ διαιρέσεως οὕτως·", "seq": 2709}
{"id": "Elias_Passim_2710", "series": "CAG", "text": "ἀεὶ δύο πραγμάτων λαμβανομένων, ἐχόντων ὄνομα καὶ ὁρισμόν, συμβαίνει ταῦτα ἢ κατ᾿ ἄμφω κοινωνεῖν, καὶ κατὰ τὸ ὄνομα καὶ κατὰ τὸν ὁρισμόν, καὶ γίνεται τὰ συνώνυμα, ἢ οὐδὲ κατὰ τὸ ὄνομα οὐδὲ κατὰ τὸν ὁρισμὸν κοινωνοῦσι καὶ γίνεται τὰ ἑτερώνυμα, ἢ πῇ μὲν κοινωνοῦσι πῇ δὲ διαφέρουσι·", "seq": 2710}
{"id": "Elias_Passim_2711", "series": "CAG", "text": "καὶ ἢ κατὰ τὸ ὄνομα μὲν κοινωνοῦσι τῷ δὲ πράγματι διαφέρουσι καὶ γίνονται τὰ ὁμώνυμα, ἢ τῷ μὲν πράγματι κοινωνοῦσι διαφέρουσι δὲ τῷ ὀνόματι καὶ γίνεται τὰ πολυώνυμα, οἷον ξίφος ἄορ μάχαιρα φάσγανον σπάθη.", "seq": 2711}
{"id": "Elias_Passim_2712", "series": "CAG", "text": "ἔδειξεν οὖν ὁ λόγος ὅτι καὶ εἰσὶ καὶ τί ἐστιν ἕκαστον αὐτῶν.", "seq": 2712}
{"id": "Elias_Passim_2713", "series": "CAG", "text": "τοῦτο δεύτερον.", "seq": 2713}
{"id": "Elias_Passim_2714", "series": "CAG", "text": "τρίτον εἰ ψευδὴς δείκνυται ὁ λόγος ὁ ἀναιρῶν τὰ συνώνυμα ὁ λέγων ὅτι τὰ συνώνυμα ἐν ταῖς δέκα κατηγορίαις θεωρεῖται, εἴ γε ἑκάστη τοῦ οἰκείου εἴδους συνωνύμως κατηγορεῖται, τὸ δὲ ὑπὸ δύο κατηγορίας ἀναγόμενον, οὔτι λέγω ὑπὸ τὰς δέκα, ὁμώνυμον, τὰ ἄρα συνώνυμα οὐκ εἰσίν, εἰ ὁμώνυμα δείκνυται.", "seq": 2714}
{"id": "Elias_Passim_2715", "series": "CAG", "text": "λύομεν δὲ τοῦτο οὕτως·", "seq": 2715}
{"id": "Elias_Passim_2716", "series": "CAG", "text": "ὅτι παραλογίζεσθε·", "seq": 2716}
{"id": "Elias_Passim_2717", "series": "CAG", "text": "τὸ γὰρ ἀναγόμενον ὑπὸ τὰς δέκα κατηγορίας διχῶς λέγεται ἀνάγεσθαι·", "seq": 2717}
{"id": "Elias_Passim_2718", "series": "CAG", "text": "ἢ γὰρ ὡς εἶδος αὐτῶν ἢ ὡς ὕλῃ χρώμενον αὐταῖς ταῖς κατηγορίαις.", "seq": 2718}
{"id": "Elias_Passim_2719", "series": "CAG", "text": "ὡς μὲν εἶδος οὕτως·", "seq": 2719}
{"id": "Elias_Passim_2720", "series": "CAG", "text": "τὸ λευκὸν ὑπὸ διαφόρους κατηγορίας ὡς εἶδος ἀνάγεται·", "seq": 2720}
{"id": "Elias_Passim_2721", "series": "CAG", "text": "εἰ γὰρ τὸ λελευκωμένον λάβῃ τις, ὑπὸ τὴν οὐσίαν ἀνάγεται, εἰ δὲ τὸ χρῶμα, ὑπὸ τὴν ποιότητα.", "seq": 2721}
{"id": "Elias_Passim_2722", "series": "CAG", "text": "οὕτω μὲν οὖν ὡς εἶδος.", "seq": 2722}
{"id": "Elias_Passim_2723", "series": "CAG", "text": "εἰ δὲ ὡς ὕλῃ χρώμενον ταῖς δέκα κατηγορίαις, ὡς τὰ πρός τι·", "seq": 2723}
{"id": "Elias_Passim_2724", "series": "CAG", "text": "ταῦτα γὰρ οἰκείαν ὕλην μὴ ἔχοντα ἐν ταῖς δέκα θεωροῦνται κατηγορίαις.", "seq": 2724}
{"id": "Elias_Passim_2725", "series": "CAG", "text": "οὕτως οὖν καὶ τὰ συνώνυμα οὐχ ὡς εἶδος ἀνάγονται ὑπὸ τὰς δέκα κατηγορίας, ἀλλ᾿ ὡς ὕλῃ χρώμενα ταῖς δέκα ὡς τὰ πρός τι.", "seq": 2725}
{"id": "Elias_Passim_2726", "series": "CAG", "text": "καὶ τὰ συνώνυμα δὲ τῶν πρὸς τί εἰσι·", "seq": 2726}
{"id": "Elias_Passim_2727", "series": "CAG", "text": "τὸ γὰρ συνώνυμον συνωνύμῳ ἐστὶ συνώνυμον.", "seq": 2727}
{"id": "Elias_Passim_2728", "series": "CAG", "text": "ταῦτα μὲν περὶ τῶν συνωνύμων.", "seq": 2728}
{"id": "Elias_Passim_2729", "series": "CAG", "text": "Ἐφ᾿ οἷς διαλαμβάνει καὶ περὶ τῶν παρωνύμων.", "seq": 2729}
{"id": "Elias_Passim_2730", "series": "CAG", "text": "τρίτα δὲ ἔταξε ταῦτα διὰ τρεῖς αἰτίας·", "seq": 2730}
{"id": "Elias_Passim_2731", "series": "CAG", "text": "ἢ ὅτι προηγεῖται τὸ ἓν τῶν δύο καὶ τὰ δύο τῶν τεσσάρων, καὶ ἐπὶ μὲν ὁμωνύμων ἑνὸς χρεία (ὀνόματος γὰρ κοινοῦ), ἐπὶ δὲ τῶν συνωνύμων δύο, ὀνόματος καὶ ὁρισμοῦ, ἐπὶ δὲ τῶν παρωνύμων τεσσάρων χρεία, κοινωνίας ὀνόματος καὶ διαφορᾶς, κοινωνίας πράγματος καὶ διαφορᾶς.", "seq": 2731}
{"id": "Elias_Passim_2732", "series": "CAG", "text": "αὕτη πρώτη αἰτία.", "seq": 2732}
{"id": "Elias_Passim_2733", "series": "CAG", "text": "δευτέρα αἰτία, ὅτι τῶν μὲν ὁμωνύμων καὶ συνωνύμων ἐν ὅλαις χρήζει ταῖς κατηγορίαις, τῶν δὲ παρωνύμων ἐν μόνῃ τῇ ποιότητι.", "seq": 2733}
{"id": "Elias_Passim_2734", "series": "CAG", "text": "αὕτη καὶ δευτέρα αἰτία.", "seq": 2734}
{"id": "Elias_Passim_2735", "series": "CAG", "text": "τρίτη δὲ αἰτία, ὅτι προηγοῦνται ἀεὶ τὰ γνήσια τῶν νόθων, καὶ ἐπὶ μὲν τῶν ὁμωνύμων καὶ συνωνύμων γνήσιαι καὶ αἱ κοινωνίαι καὶ αἱ διαφοραί, ἐπὶ δὲ τῶν παρωνύμων νόθοι.", "seq": 2735}
{"id": "Elias_Passim_2736", "series": "CAG", "text": "ταῦτα περὶ τῆς τάξεως αὐτῶν.", "seq": 2736}
{"id": "Elias_Passim_2737", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ καὶ τούτων τὸ τί ἐστι μόνον λέγει, οὐ μὴν καὶ τὸ εἰ ἔστι, δείξωμεν ὅτι εἰσὶ τὰ παρώνυμα.", "seq": 2737}
{"id": "Elias_Passim_2738", "series": "CAG", "text": "ἔστι τοίνυν τὰ παρώνυμα, πρῶτον μὲν ὅτι τὰ ὧν εἰσι μέσα ἐδείχθη ὅτι εἰσί, τὰ συνώνυμα καὶ ἑτερώνυμα, δεύτερον εἰ ψεύδεται ὁ λόγος ὁ λέγων αὐτὰ μὴ εἶναι καὶ λέγων οὕτως·", "seq": 2738}
{"id": "Elias_Passim_2739", "series": "CAG", "text": "ὅτι εἰ εἰσὶ τὰ παρώνυμα, ἔδει αὐτὰ ἐντὸς πεσεῖν τῆς ἀνωτέρω λεχθείσης διαιρέσεως (τὴν γὰρ διαιρετικὴν μέθοδον οὐδὲν καυχήσεται φυγόν), οὐ περιέλαβε δὲ αὐτὰ ἡ διαίρεσις, δῆλον ὅτι οὐκ εἰσὶ τὰ παρώνυμα.", "seq": 2739}
{"id": "Elias_Passim_2740", "series": "CAG", "text": "λέγομεν πρὸς ταῦτα οὕτως·", "seq": 2740}
{"id": "Elias_Passim_2741", "series": "CAG", "text": "ὅτι οὐκ ἠδύνατο ἐντὸς πεσεῖν τῆς διαιρέσεως τὰ παρώνυμα, διότι ἡ διαίρεσις κατὰ γνησίας κοινωνίας ** καὶ τὰς διαφοράς.", "seq": 2741}
{"id": "Elias_Passim_2742", "series": "CAG", "text": "ταῦτα καὶ περὶ τούτων.", "seq": 2742}
{"id": "Elias_Passim_2743", "series": "CAG", "text": "Δεῖ δὲ εἰδέναι ὅτι τεσσάρων χρεία, ἵνα γένωνται τὰ παρώνυμα, κοινωνίας ὀνόματος καὶ διαφορᾶς ὀνόματος, κοινωνίας πράγματος καὶ διαφορᾶς πράγματος.", "seq": 2743}
{"id": "Elias_Passim_2744", "series": "CAG", "text": "ὅθεν τὸ Ἕλενος καὶ Ἑλένη οὐκ ἔστι παρώνυμον·", "seq": 2744}
{"id": "Elias_Passim_2745", "series": "CAG", "text": "ἔχει γὰρ κοινωνίαν ὀνόματος, ἐπειδὴ αἱ πρῶται συλλαβαὶ πᾶσαι ἀμφοτέρων τῶν ὀνομάτων αἱ αὐταί εἰσιν, ἀλλὰ καὶ διαφορὰν ὀνόματος ἔχουσι κατὰ τὴν τελευταίαν συλλαβήν.", "seq": 2745}
{"id": "Elias_Passim_2746", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ ὡς Ἕλενος καὶ Ἑλένη οὐδεμίαν κοινωνίαν ἔχουσιν (ἕκαστος γὰρ οἰκείαν ὑπογραφὴν ἔχει), διὰ τοῦτο οὐκ ἔστι παρώνυμα.", "seq": 2746}
{"id": "Elias_Passim_2747", "series": "CAG", "text": "οὐδὲ παρθενική καὶ παρθένος παρώνυμα διὰ τὸ μὴ ἔχειν διαφορὰν πράγματος·", "seq": 2747}
{"id": "Elias_Passim_2748", "series": "CAG", "text": "τὸ αὐτὸ γὰρ αἱ δύο λέξεις δηλοῦσι, καὶ ἔστι πολυώνυμον.", "seq": 2748}
{"id": "Elias_Passim_2749", "series": "CAG", "text": "οὐδὲ τὸ ἀρετή καὶ σπουδαῖος διὰ τὸ μὴ εἶναι κοινωνίαν τοῦ ὀνόματος, κατὰ δὲ τὸ πρᾶγμα καὶ κοινωνίαν καὶ διαφορὰν ὡς μετέχοντος καὶ μετεχομένου.", "seq": 2749}
{"id": "Elias_Passim_2750", "series": "CAG", "text": "οὐδὲ μουσικὴ γυνή καὶ μουσικὴ ἐπιστήμη παρώνυμα διὰ τὸ μὴ ἔχειν διαφορὰν ὀνόματος.", "seq": 2750}
{"id": "Elias_Passim_2751", "series": "CAG", "text": "Τούτων οὕτω προληφθέντων ἴδωμεν πῶς ὁρίζεται τὰ παρώνυμα.", "seq": 2751}
{"id": "Elias_Passim_2752", "series": "CAG", "text": "ὁρίζεται δὲ αὐτὰ οὕτω λέγων παρώνυμά εἰσιν ὅσα ἀπό τινος διαφέροντα τῇ πτώσει τὴν κατὰ τοὔνομα προσηγορίαν ἔχει, διὰ τούτων τὰ τέσσαρα δηλώσας·", "seq": 2752}
{"id": "Elias_Passim_2753", "series": "CAG", "text": "διὰ μὲν γὰρ τοῦ εἰπεῖν ὅσα ἀπό τινος τὴν κοινωνίαν τοῦ πράγματος καὶ τὴν διαφοράν (τὰ γὰρ ἀπό τινος κοινωνεῖ αὐτοῦ πάντως καθὸ ἐξ αὐτοῦ, διαφέρει δέ, ἐπειδὴ <οὐ> πάντῃ ταὐτὸν τὸ μετέχον τῷ μετεχομένῳ).", "seq": 2753}
{"id": "Elias_Passim_2754", "series": "CAG", "text": "διὰ δὲ τοῦ εἰπεῖν διαφέροντα τῇ πτώσει τὴν διαφορὰν τοῦ ὀνόματος ἐδήλωσε (πτῶσις δὲ παρὰ Ἀριστοτέλει τὸ πέρας τῆς λέξεως), διὰ δὲ τοῦ εἰπεῖν τὴν κατὰ τοὔνομα προσηγορίαν ἔχει τὴν κοινωνίαν τοῦ ὀνόματος.", "seq": 2754}
{"id": "Elias_Passim_2755", "series": "CAG", "text": "Δεῖ δὲ τούτων προληφθέντων εἰδέναι ὅτι οὐκ ἀποδεκτέον τὸν ποιητὴν τὰ ὁμώνυμα συνώνυμα λέγοντα, ὡς ἐπὶ τοῦ", "seq": 2755}
{"id": "Elias_Passim_2756", "series": "CAG", "text": "ἶσον θυμὸν ἔχοντες·", "seq": 2756}
{"id": "Elias_Passim_2757", "series": "CAG", "text": "ὁμωνύμους γὰρ ὄντας συνωνύμους ἐκάλεσε διὰ τὸ ἴσον τοῦ θυμοῦ.", "seq": 2757}
{"id": "Elias_Passim_2758", "series": "CAG", "text": "οὐδὲ τοὺς λέγοντας τὰ πολυώνυμα συνώνυμα ἀποδεκτέον, ὡς τὸ ξίφος μάχαιρα σπάθη ἄορ.", "seq": 2758}
{"id": "Elias_Passim_2759", "series": "CAG", "text": "οὐδὲ γραμματικοὺς ἀποδεκτέον ἀντιδιαστέλλοντας τὰ παρώνυμα τοῖς ὀνοματικοῖς καὶ ῥηματικοῖς.", "seq": 2759}
{"id": "Elias_Passim_2760", "series": "CAG", "text": "εἰσὶ δὲ ὀνοματικὰ τὸ Τρύφων ἀπὸ τοῦ τρυφή καὶ τὸ Θέων ἀπὸ τοῦ θεός, ῥηματικὰ δὲ τὸ Φιλήμων νοήμων ἀπὸ τοῦ φιλῶ καὶ νοῶ.", "seq": 2760}
{"id": "Elias_Passim_2761", "series": "CAG", "text": "δέον πάντα παρώνυμα καλέσαι, τὰ μὲν ὀνοματικὰ καλοῦσι τὰ δὲ ῥηματικά.", "seq": 2761}
{"id": "Elias_Passim_2762", "series": "CAG", "text": "ἐφ᾿ οἷς τούτων ζητηθέντων <περὶ> τῆς διαφορᾶς τῶν παρωνύμων, ζητήσωμεν καὶ τῶν ἀφ᾿ ἑνὸς καὶ τῶν πρὸς ἓν τὴν διαφοράν.", "seq": 2762}
{"id": "Elias_Passim_2763", "series": "CAG", "text": "διαφέρουσι δὲ ταῦτα ἀλλήλων, ὅτι ἐπὶ μὲν τῶν παρωνύμων τεσσάρων χρεία, ὡς εἴρηται, ἐπὶ δὲ τῶν ἀφ᾿ ἑνὸς καὶ πρὸς ἓν δύο μόνων χρεία, κοινωνίας πράγματος καὶ διαφορᾶς ὀνόματος, ὡς ἐπὶ τοῦ ἰατρικὸν βιβλίον, ἰατρικὸν σμιλίον (οὐκ ἔχουσι γὰρ ὄνομα κοινόν), καὶ ὑγιεινὸν οὖρον καὶ ὑγιεινὸν σιτίον·", "seq": 2763}
{"id": "Elias_Passim_2764", "series": "CAG", "text": "ταῦτα γὰρ ὄνομα οὐκ ἔχει κοινὸν ἀλλὰ πρᾶγμα.", "seq": 2764}
{"id": "Elias_Passim_2765", "series": "CAG", "text": "ταῦτα μὲν ἐπὶ τοσοῦτον.", "seq": 2765}
{"id": "Elias_Passim_2766", "series": "CAG", "text": "χωρήσωμεν δὲ καὶ ἐπὶ τὴν κατὰ λέξιν ἐξήγησιν.", "seq": 2766}
{"id": "Elias_Passim_2767", "series": "CAG", "text": "1a6 Συνώνυμα λέγεται ὧν τὸ ὄνομα κοινὸν καὶ ὁ λόγος τῆς οὐσίας ὁ αὐτός, οἷον ζῷον ὅ τε ἄνθρωπος καὶ ὁ βοῦς.", "seq": 2767}
{"id": "Elias_Passim_2768", "series": "CAG", "text": "Τῷ αὐτῷ κέχρηται παραδείγματι ᾧ καὶ ἐπὶ ὁμωνύμων·", "seq": 2768}
{"id": "Elias_Passim_2769", "series": "CAG", "text": "κἀκεῖ γὰρ ἔλεγεν οἷον ζῷον ὅ τε ἄνθρωπος καὶ ὁ γεγραμμένος, ἐνταῦθα δὲ οἷον ὅ τε ἄνθρωπος καὶ ὁ βοῦς.", "seq": 2769}
{"id": "Elias_Passim_2770", "series": "CAG", "text": "τοῦτο δὲ πεποίηκεν, ἵνα δείξῃ ὅτι ἐνδέχεται τὸ αὐτὸ καὶ ὁμώνυμον εἶναι καὶ συνώνυμον·", "seq": 2770}
{"id": "Elias_Passim_2771", "series": "CAG", "text": "ἢ γὰρ τὸ αὐτὸ τῷ αὐτῷ κατὰ τὸ αὐτὸ ὁμώνυμόν ἐστι καὶ συνώνυμον, ὡς οἱ δύο Εὔβουλοι, ἢ τὸ αὐτὸ ἄλλῳ καὶ ἄλλῳ κατ᾿ ἄλλο καὶ ἄλλο ὁμώνυμόν ἐστι καὶ συνώνυμον, ὡς ὁ Σωκράτης τῇ μὲν οἰκείᾳ εἰκόνι ὁμώνυμος τῷ δὲ Πλάτωνι συνώνυμος ὡς ἄνθρωπος, ἢ τὸ αὐτὸ τῷ αὐτῷ κατ᾿ ἄλλο καὶ ἄλλο καὶ ὁμώνυμόν ἐστι καὶ συνώνυμον, ὡς οἱ δύο Αἴαντες (κατὰ γὰρ τὸ Αἴας ὁμώνυμοι, κατὰ δὲ τὸ ἄνθρωπος συνώνυμοι), ἢ τὸ αὐτὸ ἄλλῳ καὶ ἄλλῳ κατὰ τὸ αὐτό, ὡς τὸ παράδειγμα Ἀριστοτέλους·", "seq": 2771}
{"id": "Elias_Passim_2772", "series": "CAG", "text": "τὸ γὰρ ζῷον τὸ αὐτὸ ἄλλῳ καὶ ἄλλῳ καὶ ὁμώνυμον καὶ συνώνυμον, τῷ μὲν γεγραμμένῳ ζῴῳ ὁμώνυμον, τῷ δὲ ἵππῳ καὶ τῷ βοὶ ὡς ζῴοις συνώνυμον.", "seq": 2772}
{"id": "Elias_Passim_2773", "series": "CAG", "text": "1a10 Ἐὰν γὰρ ἀποδιδῷ τις τὸν ἑκάστου λόγον ** ζῴῳ ἐπὶ ἑκατέρου, τὸν αὐτὸν ἀποδώσει λόγον.", "seq": 2773}
{"id": "Elias_Passim_2774", "series": "CAG", "text": "Ἄλλο ἐστὶν εἰπεῖν ζῴῳ εἶναι καὶ ζῷον εἶναι καὶ ἀνθρώπῳ εἶναι καὶ ἄνθρωπον εἶναι·", "seq": 2774}
{"id": "Elias_Passim_2775", "series": "CAG", "text": "ἐπὶ μὲν γὰρ τῶν ἁπλῶν ταὐτόν ἐστιν, οἷον θεῷ εἶναι καὶ θεὸν εἶναι.", "seq": 2775}
{"id": "Elias_Passim_2776", "series": "CAG", "text": "ἐπὶ δὲ τῶν συνθέτων οὐ ταὐτόν·", "seq": 2776}
{"id": "Elias_Passim_2777", "series": "CAG", "text": "ἐὰν γὰρ εἴπω ‘ἄνθρωπον’, τὸ συναμφότερον σημαίνω, τὸ σῶμα καὶ τὴν ψυχήν, ἐὰν δὲ εἴπω ‘ἀνθρώπῳ εἶναι’ τὸ ἁπλοῦν δηλῶ, οἷον τὴν ψυχήν·", "seq": 2777}
{"id": "Elias_Passim_2778", "series": "CAG", "text": "αὕτη γὰρ ἡ λογικὴ ψυχὴ εἰδοποιεῖ τὸν ἄνθρωπον·", "seq": 2778}
{"id": "Elias_Passim_2779", "series": "CAG", "text": "τὰ γὰρ πράγματα εἴδει κρίνεται, οὐ τῇ ὕλῃ.", "seq": 2779}
{"id": "Elias_Passim_2780", "series": "CAG", "text": "ἐπειδὴ οὖν τὸ ζῷον ἁπλοῦν ἐστιν ὡς εἶδος, ἀδιαφόρως ὀνομάζειν ἐξῆν.", "seq": 2780}
{"id": "Elias_Passim_2781", "series": "CAG", "text": "αὐτὸς δὲ ὡς ἄδειαν ἔχων τὸ ζῴῳ εἶναι ἔθηκεν.", "seq": 2781}
{"id": "Elias_Passim_2782", "series": "CAG", "text": "ἐν οἷς σὺν θεῷ καὶ ἡ παροῦσα πρᾶξις.", "seq": 2782}
{"id": "Elias_Passim_2783", "series": "CAG", "text": "1a16 ΤΤῶν λεγομένων τὰ μὲν κατὰ συμπλοκὴν λέγεται, τὰ δὲ ἄνευ συμπλοκῆς.", "seq": 2783}
{"id": "Elias_Passim_2784", "series": "CAG", "text": "Μετὰ τὰ ὁμώνυμα καὶ συνώνυμα καὶ παρώνυμα, ὧν ἕκαστον ἐδήλου τὸν Ἰαμβλίχειον σκοπὸν περὶ φωνῶν ἁπλῶν ὄντα σημαινουσῶν ἁπλᾶ πράγματα διὰ μέσου ἁπλῶν νοημάτων, ἔρχεται ὁ Ἀριστοτέλης καὶ ἐπὶ αὐτὰς τὰς κατηγορίας.", "seq": 2784}
{"id": "Elias_Passim_2785", "series": "CAG", "text": "ἀλλὰ πρὸ τῆς τούτων διδασκαλίας διαιρεῖ τὰ λεγόμενα καὶ τὰ ὄντα, τὰ μὲν λεγόμενα εἰς τὰ μετὰ συμπλοκῆς καὶ ἄνευ συμπλοκῆς, τὰ δὲ ὄντα εἰς καθόλου οὐσίαν, καθόλου συμβεβηκός, μερικὴν οὐσίαν, μερικὸν συμβεβηκός.", "seq": 2785}
{"id": "Elias_Passim_2786", "series": "CAG", "text": "τοῦτο δὲ ποιεῖ, ἵνα δείξῃ ποῖα μὲν λεγόμενά εἰσιν αἱ κατηγορίαι, ὅτι ἄνευ συμπλοκῆς, ποῖα δὲ ὄντα, ὅτι καθόλου οὐσία <καὶ> καθόλου συμβεβηκός, ἀλλ᾿ οὐ μερικὴ οὐσία οὐδὲ μερικὸν συμβεβηκός.", "seq": 2786}
{"id": "Elias_Passim_2787", "series": "CAG", "text": "ἀμφότερα οὖν διαιρεῖ ὁ Ἀριστοτέλης, καὶ τὰ λεγόμενα καὶ τὰ ὄντα.", "seq": 2787}
{"id": "Elias_Passim_2788", "series": "CAG", "text": "πλὴν ἐν τούτοις προτάττει τὴν διαίρεσιν τῶν λεγομένων ὡς σύντομον, ἵνα μὴ πρότερον περὶ τῆς ἄλλης διαλεγόμενος τῷ ἐπὶ πολὺν χρόνον περὶ αὐτὴν διατρίβειν μὴ μεμνημένος τῆς ἑτέρας δόξῃ περὶ ἐκείνης μόνης διαλαμβάνειν, ὁπότε καὶ τοῦτο ποιήσαντος αὐτοῦ ἐνόμισαν οἱ μὲν ὅτι περὶ ἑνὸς μόνου διαλαμβάνει·", "seq": 2788}
{"id": "Elias_Passim_2789", "series": "CAG", "text": "οἱ μὲν γὰρ περὶ φωνῶν μόνων οἱ δὲ περὶ πραγμάτων, ὡς ἀνωτέρω εἴρηται.", "seq": 2789}
{"id": "Elias_Passim_2790", "series": "CAG", "text": "καὶ μιᾷ δὲ μόνῃ εἰ ἐχρήσατο διαιρέσει, ἢ τῶν λεγομένων μόνων ἢ τῶν ὄντων μόνων, εἶχε καὶ οὕτω τὸ ζητούμενον, διὰ μὲν τῶν λεγομένων τὰ πράγματα, εἰ λέγουσι μὲν αἱ φωναὶ λέγονται δὲ τὰ πράγματα, καὶ τὰ ὄντα μόνον εἰ διεῖλεν εἰς καθόλου οὐσίαν καὶ συμβεβηκός, μερικὴν οὐσίαν, μερικὸν συμβεβηκός, καὶ οὕτως εἶχε τὸ ζητούμενον·", "seq": 2790}
{"id": "Elias_Passim_2791", "series": "CAG", "text": "τὸ γὰρ καθόλου καὶ μερικὸν τῶν φωνῶν ἡ δὲ οὐσία καὶ τὸ συμβεβηκὸς τῶν πραγμάτων·", "seq": 2791}
{"id": "Elias_Passim_2792", "series": "CAG", "text": "τρισὶ δὲ διαιρέσεσι χρωμένου τοῦ Ἀριστοτέλους διακεκριμέναις ἀλλήλων, μιᾷ μὲν τῇ λεγούσῃ τὰ μὲν καθόλου οὐσίαν καὶ καθόλου συμβεβηκὸς καὶ μερικὴν οὐσίαν καὶ μερικὸν συμβεβηκός, ἄλλῃ δὲ διαιρέσει τῇ διαιρούσῃ καὶ τὰ μετὰ συμπλοκῆς καὶ τὰ ἄνευ συμπλοκῆς εἰς τὰς δέκα κατηγορίας, τινὲς τὰς διαιρέσεις ταύτας τρεῖς οὔσας μίαν συνεχῆ ἐνόμισαν λέγοντες οὕτως·", "seq": 2792}
{"id": "Elias_Passim_2793", "series": "CAG", "text": "τῶν λεγομένων τὰ μὲν μετὰ συμπλοκῆς τὰ δὲ ἄνευ συμπλοκῆς, καὶ τὰ ἄνευ συμπλοκῆς εἰς τὰς δέκα κατηγορίας, τὰ δὲ μετὰ συμπλοκῆς εἰς καθόλου οὐσίαν, καθόλου συμβεβηκός, μερικὴν οὐσίαν, μερικὸν συμβεβηκός.", "seq": 2793}
{"id": "Elias_Passim_2794", "series": "CAG", "text": "πρὸς οὓς λεκτέον ὅτι κακῶς ἀπατᾶσθε ἐκ τῆς προφορᾶς τῆς καθόλου οὐσίας καὶ μερικῆς οὐσίας, καθόλου συμβεβηκότος καὶ μερικοῦ συμβεβηκότος καὶ συμπεπλεγμένα αὐτὰ ἐνομίσατε·", "seq": 2794}
{"id": "Elias_Passim_2795", "series": "CAG", "text": "τὸ γὰρ συμπεπλεγμένον καὶ τὸ ἁπλοῦν παρὰ Ἀριστοτέλει οὐ τῇ προφορᾷ κρίνεται ἀλλὰ τῷ σημαινομένῳ, καὶ ἁπλῶς παρ᾿ αὐτῷ τὰ σύνθετα τῶν ὀνομάτων, Κόρακος πέτρα, Ἄρειος πάγος, Νεάπολις καὶ αὐτὸ τὸ ζῷον λογικὸν θνητὸν νοῦ καὶ ἐπιστήμης δεκτικόν, ὁ ὁρισμός, ἁπλᾶ πάντα ταῦτα παρὰ τῷ Ἀριστοτέλει, ἐπειδὴ ἓν σημαίνουσι πρᾶγμα.", "seq": 2795}
{"id": "Elias_Passim_2796", "series": "CAG", "text": "σύνθετα δὲ παρ᾿ αὐτῷ τὰ πολλὰ σημαίνοντα, οἷον τὰ ὁμώνυμα πάντα, ὡς τὸ κύων (τοῦτο γὰρ πολλὰ σημαίνει), καὶ αὐτὸ τὸ η μονοσύλλαβον συμπεπλεγμένον ὡς πολλὰ σημαῖνον·", "seq": 2796}
{"id": "Elias_Passim_2797", "series": "CAG", "text": "ἔστι γὰρ καὶ ἀριθμὸς καὶ ῥῆμα, ἀριθμὸς μὲν ὀκτώ, ῥῆμα δὲ ὡς παρὰ τῷ ποιητῇ", "seq": 2797}
{"id": "Elias_Passim_2798", "series": "CAG", "text": "ἦ καὶ κυανέῃσιν ἐπ᾿ ὀφρύσι νεῦσε Κρονίων,", "seq": 2798}
{"id": "Elias_Passim_2799", "series": "CAG", "text": "ἀντὶ τοῦ εἶπε, καὶ παρὰ Πλάτωνι ‘ἦ δ᾿ ὅς’ ἀντὶ τοῦ ‘εἶπεν οὗτος’.", "seq": 2799}
{"id": "Elias_Passim_2800", "series": "CAG", "text": "ἀλλ᾿ ὁ μὲν Ὅμηρος μετὰ τοὺς λόγους τίθησιν αὐτὸ ‘ἦ καὶ κυανέῃσιν’ ἀντὶ τοῦ εἶπε καὶ ἔοικε τοῦτο τῷ ‘ὣς ἔφατο’, παρὰ δὲ Πλάτωνι ἀεὶ πρὸ τῶν λόγων τίθεται ‘ἦ δ᾿ ὅς’ καὶ ἐπάγει τί εἶπε, καὶ ἔοικε τοῦτο τῷ", "seq": 2800}
{"id": "Elias_Passim_2801", "series": "CAG", "text": "τὸν δ᾿ ἀπαμειβόμενος.", "seq": 2801}
{"id": "Elias_Passim_2802", "series": "CAG", "text": "ἀποροῦσι δὲ πάλιν διὰ τί <τὰ> μετὰ συμπλοκῆς τῶν ἄνευ συμπλοκῆς προέταξε.", "seq": 2802}
{"id": "Elias_Passim_2803", "series": "CAG", "text": "καὶ λέγομεν ἢ ὡς σαφέστερα καὶ γνωριμώτερα (σαφέστερα γὰρ τὰ σύνθετα τῶν ἁπλῶν), καὶ ὅτι τὰ συμπεπλεγμένα θέσιν δηλοῦσι (προηγεῖται δὲ ἀεὶ ἡ θέσις τῆς ἄρσεως), ἢ ἵνα τὸ πέρας τῶν φθασάντων ἀρχὴ τῶν μελλόντων γένηται καὶ λήξῃ μὲν τὸ πρῶτον τμῆμα εἰς ἀπαρίθμησιν ψιλὴν τῶν κατηγοριῶν, ἄρξηται δὲ τὸ δεύτερον ἀπ᾿ αὐτῆς τῆς διδασκαλίας τῶν κατηγοριῶν.", "seq": 2803}
{"id": "Elias_Passim_2804", "series": "CAG", "text": "1a19 Οἷον ἄνθρωπος, βοῦς, τρέχει, νικᾷ.", "seq": 2804}
{"id": "Elias_Passim_2805", "series": "CAG", "text": "Καλῶς ἐχρήσατο τοῖς παραδείγμασι μεταξὺ τοῦ ὀνόματος καὶ τοῦ ῥήματος ἕτερον θεὶς ὄνομα, ἵνα μηδὲ ἄκοντες περὶ τὴν ἀνάγνωσιν σφαλῶμεν καὶ κατὰ συμπλοκὴν αὐτὰ ἀναγνῶμεν.", "seq": 2805}
{"id": "Elias_Passim_2806", "series": "CAG", "text": "μετὰ συμπλοκῆς γὰρ ἦν τὸ ‘ἄνθρωπος τρέχει’ ὅλον τοῦτο, ἀλλὰ καὶ χωρὶς συμπλοκῆς δυνατὸν αὐτὰ ἀναγνῶναι, ‘ἄνθρωπος’ ἰδίᾳ καὶ ‘τρέχει’ ἰδίᾳ.", "seq": 2806}
{"id": "Elias_Passim_2807", "series": "CAG", "text": "ἀλλ᾿ εἰ οὕτως αὐτὰ ἔθηκεν ‘ἄνθρωπος, τρέχει’, ἴσως ἐσφάλλετό τις περὶ τὴν ἀνάγνωσιν κατὰ συμπλοκὴν αὐτὰ νομίζων εἶναι.", "seq": 2807}
{"id": "Elias_Passim_2808", "series": "CAG", "text": "μεταξὺ δὲ κειμένου του ὀνόματος ἄνθρωπος, βοῦς, τρέχει, νικᾷ, οὐδὲ ἄκοντες ἁμαρτάνομεν περὶ τὴν ἀνάγνωσιν.", "seq": 2808}
{"id": "Elias_Passim_2809", "series": "CAG", "text": "ῥήμασι δὲ ἐχρήσατο τρίτου προσώπου καὶ οὐ πρώτου οὐδὲ δευτέρου, ἐπειδὴ ταῦτα ὡρισμένα εἰσὶ τὰ πρόσωπα·", "seq": 2809}
{"id": "Elias_Passim_2810", "series": "CAG", "text": "ἢ γὰρ ἀφ᾿ οὗ ὁ λόγος ἢ πρὸς ὃν ὁ λόγος.", "seq": 2810}
{"id": "Elias_Passim_2811", "series": "CAG", "text": "τὰ δὲ τοῦ τρίτου προσώπου ῥήματα κἂν πρόσωπον εἰσάγωσιν, ἀλλ᾿ ἀόριστον εἰσάγουσι πρόσωπον·", "seq": 2811}
{"id": "Elias_Passim_2812", "series": "CAG", "text": "πᾶν μὲν γὰρ ὁριστικὸν ῥῆμα πρόσωπον εἰσάγει καὶ ταύτῃ δοκεῖ συμπεπλεγμένον εἶναι, τὰ δὲ τοῦ τρίτου προσώπου ῥήματα κἂν πρόσωπον εἰσάγωσιν ἐξ ἀνάγκης, τῷ ἀόριστον εἰσάγειν πρόσωπον δοκοῦσι μὴ εἶναι συμπεπλεγμένα·", "seq": 2812}
{"id": "Elias_Passim_2813", "series": "CAG", "text": "καὶ ἐχρήσατό γε ἀπαρεμφάτοις ῥήμασιν, ἅτινα οὐδὲ ὅλως εἰσὶ συμπεπλεγμένα τῷ μὴ πρόσωπον εἰσάγειν ὅλως, εἰ μὴ ὅτι τὸ πρῶτον παράδειγμα ἀναλῦσαι ἐζήτει τῷ κατὰ συμπλοκὴν καὶ ἄνευ συμπλοκῆς αὐτὸ ποιῆσαι.", "seq": 2813}
{"id": "Elias_Passim_2814", "series": "CAG", "text": "1a20 Τῶν ὄντων τὰ μὲν καθ᾿ ὑποκειμένου τινὸς λέγεται, ἐν ὑποκειμένῳ δὲ οὐδενί ἐστιν.", "seq": 2814}
{"id": "Elias_Passim_2815", "series": "CAG", "text": "Μετὰ τὴν διαίρεσιν τῶν λεγομένων ἔρχεται καὶ ἐπὶ τὴν διαίρεσιν τῶν ὄντων.", "seq": 2815}
{"id": "Elias_Passim_2816", "series": "CAG", "text": "καὶ δύο λαμβάνει ἀντιθέσεις, μίαν ἐκ τῶν λεγομένων καὶ μίαν ἐκ τῶν ὄντων, ἐκ μὲν τῶν λεγομένων καθόλου καὶ μερικόν, ἐκ δὲ τῶν ὄντων οὐσίαν καὶ συμβεβηκός.", "seq": 2816}
{"id": "Elias_Passim_2817", "series": "CAG", "text": "καὶ τέσσαρας ποιεῖ συμπλοκάς, καθόλου οὐσίαν, καθόλου συμβεβηκός, μερικὴν οὐσίαν, μερικὸν συμβεβηκός.", "seq": 2817}
{"id": "Elias_Passim_2818", "series": "CAG", "text": "καὶ προτάττει ἐν τούτοις τὴν καθόλου οὐσίαν καὶ ὡς καθόλου καὶ ὡς οὐσίαν.", "seq": 2818}
{"id": "Elias_Passim_2819", "series": "CAG", "text": "δεύτερον δὲ τάττει τὸ μερικὸν συμβεβηκὸς ὡς πάντῃ ἀντικείμενον τῇ καθόλου οὐσίᾳ, ἐσχάτου ὀφείλοντος αὐτοῦ ταγῆναι ὡς ὄντος συλλογῆς τῶν χειρόνων καὶ ἑλκομένου ὑπὸ τῆς καθόλου οὐσίας·", "seq": 2819}
{"id": "Elias_Passim_2820", "series": "CAG", "text": "τῶν γὰρ ἀντικειμένων μία ἡ γνῶσις.", "seq": 2820}
{"id": "Elias_Passim_2821", "series": "CAG", "text": "τῶν δὲ λοιπῶν δύο δικαιολογουμένων καὶ τοῦ μὲν λέγοντος οὐσίας εἶναι τοῦ δὲ καθόλου εἶναι, τὸ κῦρος δίδωσι καὶ τὴν ψῆφον τῷ καθόλου συμβεβηκότι διὰ τέσσαρας αἰτίας·", "seq": 2821}
{"id": "Elias_Passim_2822", "series": "CAG", "text": "ἢ ὅτι τῷ καθόλου αἱ κατηγορίαι χαρακτηρίζονται καὶ οὐχὶ τῷ οὐσίαι εἶναι, ἢ ὅτι τὸ καθόλου ἐπιστήμονας ἡμᾶς ποιεῖ, οὐ τὸ μερικόν, ἢ ὅτι ταύτῃ προὔχομεν τῶν ἀλόγων τῷ γινώσκειν τὰ καθόλου, ἐπεὶ εἰς τὴν μερικὴν γνῶσιν προὔχουσιν ἡμῶν τὰ ἄλογα, ἔχοντά τινα αἴσθησιν ἡμῶν ἀκριβεστέραν, ἢ ἵνα ἀπὸ οὐσίας ἄρξηται καὶ εἰς οὐσίαν λήξῃ καὶ μέσα φυλάξῃ τὰ συμβεβηκότα ὡς ἀσθενῆ·", "seq": 2822}
{"id": "Elias_Passim_2823", "series": "CAG", "text": "πανταχοῦ γὰρ τὸ", "seq": 2823}
{"id": "Elias_Passim_2824", "series": "CAG", "text": "κακοὺς δ᾿ ἐς μέσσον ἔλασσεν·", "seq": 2824}
{"id": "Elias_Passim_2825", "series": "CAG", "text": "οὕτω γὰρ καὶ ἐπὶ τῶν οὐρανίων ἔχει καὶ ὑπὸ σελήνην·", "seq": 2825}
{"id": "Elias_Passim_2826", "series": "CAG", "text": "τὰ μὲν οὐράνια περιέχει, περιέχεται δὲ τὰ ὑπὸ σελήνην, κἀν τοῖς ὑπὸ σελήνην πράγμασι πάλιν τὰ ὑγρὰ καὶ διαρρέοντα, ὕδωρ καὶ ἀήρ, συσφίγγεται ὑπὸ τῶν ξηρῶν, πυρὸς καὶ γῆς.", "seq": 2826}
{"id": "Elias_Passim_2827", "series": "CAG", "text": "καὶ ταῦτα μὲν περὶ τούτων.", "seq": 2827}
{"id": "Elias_Passim_2828", "series": "CAG", "text": "Ἀλλ᾿ εἰ μὲν οὕτως ἦν ὀνομάσας αὐτὸς ὁ Ἀριστοτέλης ὡς ἡμεῖς, καθόλου οὐσίαν, καθόλου συμβεβηκός, μερικὴν οὐσίαν, μερικὸν συμβεβηκός, πραγμάτων ἂν ἦμεν ἀπηλλαγμένοι.", "seq": 2828}
{"id": "Elias_Passim_2829", "series": "CAG", "text": "ἐπειδὴ δὲ οὐχ οὕτως αὐτὰ ὀνομάζει, ἀλλ᾿ ἤμειψε τὰ ὀνόματα, ἄξιον ζητῆσαι διὰ τί ἤμειψε τὰ ὀνόματα.", "seq": 2829}
{"id": "Elias_Passim_2830", "series": "CAG", "text": "καὶ λέγομεν τούτου δύο αἰτίας·", "seq": 2830}
{"id": "Elias_Passim_2831", "series": "CAG", "text": "ἢ γὰρ διὰ τὸ ὑπογράψαι ἅμα καὶ ὑποστῆσαι τὰ πράγματα·", "seq": 2831}
{"id": "Elias_Passim_2832", "series": "CAG", "text": "ἐν γὰρ τῷ λέγειν καθ᾿ ὑποκειμένου καὶ ὑπέγραψεν αὐτὰ καὶ ὑπέστησεν·", "seq": 2832}
{"id": "Elias_Passim_2833", "series": "CAG", "text": "ἐν τῷ γὰρ καθ᾿ ὑποκειμένου τὸ κατά τινος δηλοῖ κατηγορεῖσθαι.", "seq": 2833}
{"id": "Elias_Passim_2834", "series": "CAG", "text": "τὰ αὐτὰ κἀπὶ τῶν ἄλλων ἂν εἴποις.", "seq": 2834}
{"id": "Elias_Passim_2835", "series": "CAG", "text": "ἢ ἵνα δείξῃ ὅτι οὐκ ἔστι τι τούτων τῶν τεσσάρων περαιτέρω·", "seq": 2835}
{"id": "Elias_Passim_2836", "series": "CAG", "text": "διὰ τοῦτο γὰρ καὶ ἀντιφατικῶς αὐτὰ προήγαγεν, ἵνα μηδὲ ἄκοντες σφαλῶμεν καὶ νομίσωμέν τι μέσον εἶναι τούτων·", "seq": 2836}
{"id": "Elias_Passim_2837", "series": "CAG", "text": "πάντως γὰρ δύο πραγμάτων καταφατικῶς προφερομένων καὶ ἀντικειμένων ἀλλήλοις νομίζεταί τι μέσον εἶναι διὰ τὸ ἄλλων ὁμοίως καταφατικῶς προφερομένων εὑρῆσθαί τι μέσον, οἷον ἀρτίου καὶ περισσοῦ, νόσου καὶ ὑγείας νομίζεταί τι μέσον εἶναι διὰ τὸ ἐπ᾿ ἄλλων εὑρῆσθαι ἀντικειμένων, οἷον λευκοῦ καὶ μέλανος τὸ φαιὸν καὶ θερμοῦ καὶ ψυχροῦ τὸ χλιαρόν.", "seq": 2837}
{"id": "Elias_Passim_2838", "series": "CAG", "text": "οὕτω καὶ ἐπὶ τούτων εἰ προήγαγεν αὐτὰ καταφατικῶς, ἵνα εἴπῃ καθόλου μερικὸν οὐσίαν συμβεβηκός, ἐνομίζετό τι εἶναι μέσον τούτων.", "seq": 2838}
{"id": "Elias_Passim_2839", "series": "CAG", "text": "ἐπειδὴ δὲ οὐδέν ἐστι μέσον τούτων, ἀντιφατικῶς αὐτὰ προήγαγε, τὸ μὲν καθόλου καλῶν καθ᾿ ὑποκειμένου τὸ δὲ μερικὸν οὐ καθ᾿ ὑποκειμένου, καὶ τὸ συμβεβηκὸς ἐν ὑποκειμένῳ τὴν δὲ οὐσίαν οὐκ ἐν ὑποκειμένῳ·", "seq": 2839}
{"id": "Elias_Passim_2840", "series": "CAG", "text": "τῶν γὰρ ἀντιφατικῶς προφερομένων οὐκ ἔστι τι μέσον εὑρεῖν.", "seq": 2840}
{"id": "Elias_Passim_2841", "series": "CAG", "text": "ἀντίφασις δέ ἐστι μάχη καταφάσεως καὶ ἀποφάσεως, οἷον ὡς ἐὰν εἴπῃς ‘λευκόν ἐστι —λευκὸν οὐκ ἔστι’·", "seq": 2841}
{"id": "Elias_Passim_2842", "series": "CAG", "text": "τούτου γὰρ οὐδέν ἐστι μέσον.", "seq": 2842}
{"id": "Elias_Passim_2843", "series": "CAG", "text": "καὶ ταῦτα ἐν τούτοις.", "seq": 2843}
{"id": "Elias_Passim_2844", "series": "CAG", "text": "Λοιπὸν δὲ ζητείσθω διὰ τί τεσσάρων ὄντων τὰ δύο μόνα ὑπογράφει, τὸ συμβεβηκὸς καὶ τὸ μερικόν.", "seq": 2844}
{"id": "Elias_Passim_2845", "series": "CAG", "text": "καὶ λέγομεν ὅτι ὡς μὲν σύντομος τὰ δύο μόνα ὑπογράφει, ὡς δὲ τεχνίτης δύο οὐ τὰ τυχόντα, ἀλλὰ μίαν ἀφ᾿ ἑκατέρας ἔλαβεν ἀντίθεσιν κελεύων ἡμᾶς τοῦ λοιποῦ ἔννοιαν ἔχειν·", "seq": 2845}
{"id": "Elias_Passim_2846", "series": "CAG", "text": "διὰ γὰρ τοῦ ἐν ὑποκειμένῳ ἐρχόμεθα εἰς ἔννοιαν τοῦ οὐκ ἐν ὑποκειμένῳ, διὰ δὲ τοῦ <οὐ καθ᾿> ὑποκειμένου ἐρχόμεθα εἰς ἔννοιαν τοῦ καθ᾿ ὑποκειμένου μὲν οὐκ ἐν ὑποκειμένῳ δέ.", "seq": 2846}
{"id": "Elias_Passim_2847", "series": "CAG", "text": "ὡς δὲ κηδεμὼν τῶν χειρόνων ταῦτα ὑπογράφει, ἵνα μὴ δι᾿ ἀμυδρότητα τοῦ εἶναι ὀλισθήσῃ πως καὶ δόξῃ μηδ᾿ ὅλως εἶναι.", "seq": 2847}
{"id": "Elias_Passim_2848", "series": "CAG", "text": "1a24 Ἐν ὑποκειμένῳ δὲ λέγω ὃ ἔν τινι μὴ ὡς μέρος ὑπάρχον ἀδύνατον χωρὶς εἶναι τοῦ ἐν ᾧ ἐστι.", "seq": 2848}
{"id": "Elias_Passim_2849", "series": "CAG", "text": "Τεσσάρων φωνῶν γνωστῶν ἡμῖν οὐσῶν, <τοῦ> ἐν ὑποκειμένῳ, οὐκ ἐν ὑποκειμένῳ, τοῦ καθ᾿ ὑποκειμένου, οὐ καθ᾿ ὑποκειμένου, δύο μόνας ἐκ τούτων ὑπογράφει ὁ φιλόσοφος καὶ ταύτας τὰς χείρονας, τὸ ἐν ὑποκειμένῳ <καὶ τὸ οὐ καθ᾿ ὑποκειμένου>, τοῦτ᾿ ἔστι τὸ συμβεβηκὸς καὶ τὸ μερικόν.", "seq": 2849}
{"id": "Elias_Passim_2850", "series": "CAG", "text": "καὶ προτάττει τὸ ἐν ὑποκειμένῳ τοῦ μερικοῦ, διότι τοῦτο δύναται καὶ καθόλου εἶναι καὶ αἱ κατηγορίαι δὲ τῷ καθόλου κρίνονται, οὐχὶ τῷ μερικὸν εἶναι, τὸ δὲ μερικὸν καθόλου οὐδέποτε δύναται εἶναι.", "seq": 2850}
{"id": "Elias_Passim_2851", "series": "CAG", "text": "ἰστέον μέντοι ὅτι τοῦ ἐν ὑποκειμένῳ ὁρισμὸς οὐκ ἔστιν ὡς ὁμωνύμου·", "seq": 2851}
{"id": "Elias_Passim_2852", "series": "CAG", "text": "ἐννέα γὰρ κατηγορίας περιέχει.", "seq": 2852}
{"id": "Elias_Passim_2853", "series": "CAG", "text": "καθόλου δὲ εἰπεῖν οὐδεμιᾶς ὁμωνύμου φωνῆς ἐστιν ὁρισμός, εἴ γε οἱ ὁρισμοὶ κοινωνίαν πράγματος ἐπιζητοῦσι, τὰ δὲ ὁμώνυμα κοινωνίαν ὀνόματος.", "seq": 2853}
{"id": "Elias_Passim_2854", "series": "CAG", "text": "πλὴν ἡ ὑπογραφὴ τοῦ ἐν ὑποκειμένῳ ἔχει τὸ ἀναλογοῦν ὁρισμῷ·", "seq": 2854}
{"id": "Elias_Passim_2855", "series": "CAG", "text": "αὐτὸ γὰρ τὸ ἔν τινι γένει ἀναλογεῖ, συστατικαῖς δὲ διαφοραῖς τὸ μὴ ὡς μέρος ὑπάρχον καὶ τὸ ἀδύνατον χωρὶς εἶναι τοῦ ἐν ᾧ ἐστι.", "seq": 2855}
{"id": "Elias_Passim_2856", "series": "CAG", "text": "τεσσάρων δὲ χρεία, ἵνα γένηται τὸ ἐν ὑποκειμένῳ·", "seq": 2856}
{"id": "Elias_Passim_2857", "series": "CAG", "text": "θέλει γὰρ εἶναι ἔν τινι πάντως (ἰδοὺ γὰρ ὁ νοῦς, ἤγουν ἡ λογικὴ ψυχή, οὐκ ἔστι συμβεβηκός, ἐπειδὴ οὐδὲ ἔν τινί ἐστι), θέλει μὴ ὡς μέρος ὑπάρχειν (ἰδοὺ γὰρ ἡ χεὶρ ἔν τινι οὖσα, τῷ σώματι, οὐκ ἔστι συμβεβηκός, ἐπειδὴ μέρος ἐστὶ τοῦ σώματος), θέλει τὸ μὴ δύνασθαι χωρὶς ὑποστῆναι (ἰδοὺ γὰρ ὁ Σωκράτης ἔν τινί ἐστι τόπῳ, ἐν Λυκείῳ, καὶ μὴ ὢν μέρος τοῦ τόπου οὐκ ἔστι συμβεβηκός, ἐπειδὴ δύναται χωρὶς τοῦ τόπου ἐκείνου εἶναι), θέλει καὶ ἐν αὐτῷ τὴν ὕπαρξιν ἔχειν·", "seq": 2857}
{"id": "Elias_Passim_2858", "series": "CAG", "text": "ἰδοὺ γὰρ ὁ Σωκράτης ἔν τινι χρόνῳ ὤν, ἐν τῷ Πελοποννησιακῷ, καὶ μὴ ὢν μέρος τῶν χρόνων καὶ μὴ δυνάμενος αὐτῶν χωρισθῆναι, οὐκ ἔστι συμβεβηκός, ἐπειδὴ μὴ τὸ εἶναι ἔσχεν ἐν τῷ χρόνῳ·", "seq": 2858}
{"id": "Elias_Passim_2859", "series": "CAG", "text": "οὐ γὰρ ἡ οὐσία ἐν χρόνῳ τὸ εἶναι ἔχει συμβεβηκότι ὄντι, ἀλλ᾿ ὁ χρόνος ἐν τῇ οὐσίᾳ ἔχει τὸ εἶναι ὡς συμβεβηκός.", "seq": 2859}
{"id": "Elias_Passim_2860", "series": "CAG", "text": "ἕνδεκα δὲ σημαινόμενά εἰσι τοῦ ἔν τινι·", "seq": 2860}
{"id": "Elias_Passim_2861", "series": "CAG", "text": "ἢ γὰρ ἐν χρόνῳ, ὡς ὁ Σωκράτης ἐν τοῖς Πελοποννησιακοῖς, ἢ ἐν τόπῳ, ὡς ἐν Λυκείῳ ὁ Σωκράτης, ἢ ἐν ἀγγείῳ, ὡς ὁ οἶνος ἐν τῷ ἀμφορεῖ καὶ οἱ πυροὶ ἐν τῷ μεδίμνῳ (καὶ εἴη ἂν ὁ μὲν τόπος ἀγγεῖον ἀκίνητον τὸ δὲ ἀγγεῖον τόπος κινούμενος), ἢ ὡς ὅλον ἐν μέρεσιν, ὡς ὁ δέκα ἐν τῷ ἑπτὰ καὶ τρία, ἢ ὡς μέρη ἐν ὅλῳ, ὡς ὁ ἑπτὰ καὶ τρία ἐν τῷ δέκα (καὶ ὅλως τὸ μὲν ὅλον ἑνικῶς λέγεται, τὰ δὲ μέρη πληθυντικῶς, ἐπειδὴ μία μὲν ἡ ὁλότης, πολλὰ δὲ τὰ μέρη), ἢ ὡς γένος ἐν εἴδει, ὡς τὸ ζῷον ἐν τῷ ἀνθρώπῳ, ἢ ὡς εἶδος ἐν γένει, ὡς ὁ ἄνθρωπος ἐν τῷ ζῴῳ (καὶ ἐνταῦθα μὲν εἰκότως ἑνικῶς ἐκφωνεῖται ἀμφότερα, γένος ἐν εἴδει καὶ εἶδος ἐν γένει, ἐπὶ δὲ ὅλου καὶ μερῶν τὸ μὲν ὅλον ἑνικῶς τὰ δὲ μέρη πληθυντικῶς, ἐπειδὴ τὸ μὲν ὅλον ἑνὶ μέρει ἑαυτὸ ὁλόκληρον οὐ δύναται παρασχεῖν, τὸ δὲ γένος ὅλον ἑαυτὸ ἑνὶ εἴδει παρέχει·", "seq": 2861}
{"id": "Elias_Passim_2862", "series": "CAG", "text": "ἰδοὺ γὰρ τοῦ ὁρισμοῦ ἐπίσης ἅπαντα μετέχει), ἢ ὡς εἶδος ἐν ὕλῃ, ὡς τὸ εἶδος τοῦ ἀνδριάντος ἐν τῷ χαλκῷ, ἢ ὡς ἐν ποιητικῷ, καθό φαμεν ὅτι οὐκ ἔστιν ἐν ἐμοὶ τὸ πρᾶγμα, ἀλλ᾿ ἐν τῇ φύσει τῇ δημιουργούσῃ τὸ ἔμβρυον ἢ ἐν τῷ ἄρχοντι, ἢ ὡς ἐν τελικῷ, καθό φαμεν ἐν φιλοσοφίᾳ ἔχειν τὰς ἐλπίδας, ἢ ὡς ἐν ὑποκειμένῳ, καθό φαμεν τὸ συμβεβηκὸς ἐν τῇ οὐσίᾳ.", "seq": 2862}
{"id": "Elias_Passim_2863", "series": "CAG", "text": "ταῦτα τὰ ἕνδεκα σημαινόμενα τοῦ ἔν τινι ὑπὸ τὴν ποῦ κατηγορίαν ἀνάγει ὁ Ἀριστοτέλης·", "seq": 2863}
{"id": "Elias_Passim_2864", "series": "CAG", "text": "ἕκαστον γὰρ τούτων δηλοῖ τόδε ἐν τῷδε κεῖσθαι, τὸ δὲ κεῖσθαι τῆς ποῦ κατηγορίας.", "seq": 2864}
{"id": "Elias_Passim_2865", "series": "CAG", "text": "ταῦτα δὲ τὰ ἕνδεκα τοῦ κατὰ φύσιν ἔν τινι σημαινόμενα·", "seq": 2865}
{"id": "Elias_Passim_2866", "series": "CAG", "text": "εἰσὶ γὰρ καὶ παρὰ φύσιν, ὡς ἡ φθορὰ ἐν τῷ φθειρομένῳ καὶ τὸ πῦρ ἐν τῷ ξύλῳ·", "seq": 2866}
{"id": "Elias_Passim_2867", "series": "CAG", "text": "καθόλου γὰρ ἡ φθορὰ ἐν τῷ φθειρομένῳ παρὰ φύσιν.", "seq": 2867}
{"id": "Elias_Passim_2868", "series": "CAG", "text": "Ἀποροῦσι δέ τινες τρεῖς ἀπορίας·", "seq": 2868}
{"id": "Elias_Passim_2869", "series": "CAG", "text": "πρώτην μὲν ὅτι κατὰ ποῖον σημαινόμενον τῶν ἕνδεκα τὸ σημεῖον ἐν τῇ γραμμῇ.", "seq": 2869}
{"id": "Elias_Passim_2870", "series": "CAG", "text": "καὶ λέγομεν ὅτι ὡς εἶδος ἐν ὕλῃ·", "seq": 2870}
{"id": "Elias_Passim_2871", "series": "CAG", "text": "εἰδοποιεῖ γὰρ τὴν πεπερασμένην γραμμὴν τὸ σημεῖον.", "seq": 2871}
{"id": "Elias_Passim_2872", "series": "CAG", "text": "δευτέρα ἀπορία ἡ λέγουσα, εἰ τὸ ὅλον ἐν τοῖς μέρεσιν, οὐδὲν δέ ἐστι τὸ ὅλον παρὰ τὰ μέρη, πῶς οὐκ αὐτὸ ἐν ἑαυτῷ εὑρίσκεται.", "seq": 2872}
{"id": "Elias_Passim_2873", "series": "CAG", "text": "πρὸς ὅ φαμεν ὅτι οὐκ ἀρκεῖ ἡ συνδρομὴ ὅλων τῶν μερῶν πρὸς τὸ γενέσθαι τὸ ὅλον, ἀλλὰ χρεία καὶ θέσεως καὶ σχήματος καὶ τοῦ ἐπιγινομένου εἴδους.", "seq": 2873}
{"id": "Elias_Passim_2874", "series": "CAG", "text": "τρίτη ἀπορία ἡ λέγουσα ὅτι πῶς τὸ ἐν ὑποκειμένῳ, συμβεβηκὸς ὄν, ἀντιδιέστειλε τῷ τόπῳ καὶ τῷ χρόνῳ συμβεβηκόσιν οὖσι καὶ αὐτοῖς.", "seq": 2874}
{"id": "Elias_Passim_2875", "series": "CAG", "text": "καὶ λέγομεν ὅτι οὐ τῷ τόπῳ καὶ τῷ χρόνῳ αὐτὸ ἀντιδιέστειλε, συμβεβηκόσιν οὖσιν, ἀλλὰ ταῖς ἐν τόπῳ καὶ χρόνῳ οὐσίαις οὖσιν.", "seq": 2875}
{"id": "Elias_Passim_2876", "series": "CAG", "text": "1a24 Ἐν ὑποκειμένῳ δὲ λέγω.", "seq": 2876}
{"id": "Elias_Passim_2877", "series": "CAG", "text": "Καλῶς εἶπε λέγω, ἐπειδὴ αὐτὸς οὕτως αὐτὰ ὠνόμασεν·", "seq": 2877}
{"id": "Elias_Passim_2878", "series": "CAG", "text": "ὅπου γὰρ ἄλλων εἰσὶν αἱ θέσεις, τὸ λέγεται τίθησιν, <οἷον> ὁμώνυμα δὲ λέγεται καὶ συνώνυμα λέγεται.", "seq": 2878}
{"id": "Elias_Passim_2879", "series": "CAG", "text": "ἐδείξαμεν δὲ τὴν παροῦσαν ὑπογραφὴν πῶς ἔχει τὸ ἀναλογοῦν γένει καὶ συστατικαῖς διαφοραῖς καὶ ὅτι αὕτη ἡ ὑπογραφὴ χωρίζει αὐτὸ ἀπὸ τῶν δέκα σημαινομένων τοῦ ἔν τινι·", "seq": 2879}
{"id": "Elias_Passim_2880", "series": "CAG", "text": "διὰ γὰρ τοῦ ἔν τινι ἐχώρισεν αὐτὸ ἀπὸ τοῦ ὡς ὅλον ἐν μέρεσι·", "seq": 2880}
{"id": "Elias_Passim_2881", "series": "CAG", "text": "τοῦτο γὰρ οὐχ ὡς ἄλλο ἐν ἄλλῳ, ἀλλ᾿ ὡς αὐτὸ ἐν ἑαυτῷ δοκεῖ εἶναι.", "seq": 2881}
{"id": "Elias_Passim_2882", "series": "CAG", "text": "διὰ δὲ τοῦ εἰπεῖν μὴ ὡς μέρος ἐχώρισεν ἀπὸ τοῦ ὡς μέρος ἐν ὅλῳ καὶ τοῦ ὡς γένος ἐν εἴδει καὶ ὡς εἶδος ἐν γένει·", "seq": 2882}
{"id": "Elias_Passim_2883", "series": "CAG", "text": "δοκεῖ γάρ πως, κἂν μὴ κυρίως, μέρος εἶναι τοῦ εἴδους τὸ γένος·", "seq": 2883}
{"id": "Elias_Passim_2884", "series": "CAG", "text": "προσλαβὸν γὰρ τὰς διαφορὰς ἀποτελέσαι τὸ εἶδος.", "seq": 2884}
{"id": "Elias_Passim_2885", "series": "CAG", "text": "καὶ τὸ εἶδος μέρος δοκεῖ εἶναι τοῦ γένους ὡς μερικώτερον αὐτοῦ·", "seq": 2885}
{"id": "Elias_Passim_2886", "series": "CAG", "text": "οὐδὲ γὰρ εἶπεν ‘ὃ ἔν τινι μέρος ὑπάρχον’, ἀλλὰ μὴ ὡς μέρος ὑπάρχον, ἐπειδὴ ταῦτα οὐ κυρίως μέρη.", "seq": 2886}
{"id": "Elias_Passim_2887", "series": "CAG", "text": "διὰ δὲ τοῦ εἰπεῖν <ἀδύνατον χωρὶς εἶναι> ἐν ᾧ ἐστι, καὶ ὃ λέγομεν ἐν αὐτῷ τὴν ὕπαρξιν ἔχειν, ἐχώρισεν αὐτὸ ἀπὸ τοῦ χρόνου, ἀπὸ τοῦ τόπου, ἀπὸ τοῦ ποιητικοῦ, ἀπὸ τοῦ τελικοῦ·", "seq": 2887}
{"id": "Elias_Passim_2888", "series": "CAG", "text": "οὐδὲ γὰρ ἐν τούτοις ἔχει τὸ εἶναι, ὡς ἐδείξαμεν.", "seq": 2888}
{"id": "Elias_Passim_2889", "series": "CAG", "text": "τοῦ γὰρ ὡς εἶδος ἐν ὕλῃ χωρίζει αὐτὸ τὰ χωρίζοντα ἀπὸ τοῦ ὡς γένος ἐν εἴδει.", "seq": 2889}
{"id": "Elias_Passim_2890", "series": "CAG", "text": "1a24 Ἐν ὑποκειμένῳ δὲ λέγω.", "seq": 2890}
{"id": "Elias_Passim_2891", "series": "CAG", "text": "Ἐπειδὴ ἔγνωμεν τὴν ὑπογραφὴν τοῦ ἐν ὑποκειμένῳ καὶ ἐδείξαμεν ὅτι ἔχει τὸ ἀναλογοῦν γένει καὶ συστατικαῖς διαφοραῖς, γένει τὸ ἔν τινι, συστατικαῖς δὲ διαφοραῖς τὰ λοιπά, φέρε πρὸς τὴν ὑπογραφὴν συστᾶσαν τὰς προσηκούσας ἀπορίας ἀπορήσωμεν.", "seq": 2891}
{"id": "Elias_Passim_2892", "series": "CAG", "text": "αὗται δέ εἰσιν αἱ πλεονεξίαν καὶ μειονεξίαν κατηγοροῦσαι.", "seq": 2892}
{"id": "Elias_Passim_2893", "series": "CAG", "text": "καὶ αἱ μὲν κατηγοροῦσαι πλεονεξίαν ἐπιχειροῦσιν οὕτως·", "seq": 2893}
{"id": "Elias_Passim_2894", "series": "CAG", "text": "ὅτι καὶ οὐσίαις ἁρμόζει αὕτη ἡ ὑπογραφή·", "seq": 2894}
{"id": "Elias_Passim_2895", "series": "CAG", "text": "ἰδοὺ γὰρ ὁ Σωκράτης ἔν τινί ἐστι τόπῳ καὶ οὐκ ἔστι μέρος τοῦ τόπου καὶ οὐ δύναται χωρισθῆναι τοῦ τόπου (πάντως γὰρ ἐν τόπῳ ἐστί), καὶ ὅμως οὐκ ἔστι συμβεβηκός.", "seq": 2895}
{"id": "Elias_Passim_2896", "series": "CAG", "text": "πρὸς ὅ φαμεν ὅτι ὁποῖον λαμβάνετε τόπον;", "seq": 2896}
{"id": "Elias_Passim_2897", "series": "CAG", "text": "εἰ μὲν τὸν καθ᾿ ἕκαστα, τούτου χωρίζεται, εἰ δὲ τὸν καθόλου, οὐδ᾿ ὅλως ἐστὶν ἐν αὐτῷ.", "seq": 2897}
{"id": "Elias_Passim_2898", "series": "CAG", "text": "εἰ δὲ στενούμενοι εἴπωσιν ὅτι οὔτε τὸν καθ᾿ ἕκαστα ὡρισμένον φαμὲν οὔτε τὸν καθόλου, ἀλλὰ τὸν μερικόν, ὅστις ἀόριστός ἐστι, πάντως δὲ ἔν τινι τόπῳ ὁ Σωκράτης, ἡμεῖς φαμεν ὅτι ἡ τελευταία διαφορὰ τῆς ὑπογραφῆς οὐχ ἁρμόζει αὐτῷ, τὸ μὴ δύνασθαι χωρὶς ὑποστῆναι·", "seq": 2898}
{"id": "Elias_Passim_2899", "series": "CAG", "text": "οὐδὲ γὰρ ὁ Σωκράτης οὐσία ὢν ἐν τόπῳ ἔχει τὸ εἶναι συμβεβηκότι ὄντι, ἀλλ᾿ εἰ ἄρα ὁ τόπος ἐν τῇ οὐσίᾳ ἔχει τὸ εἶναι.", "seq": 2899}
{"id": "Elias_Passim_2900", "series": "CAG", "text": "αὕτη πρώτη ἀπορία.", "seq": 2900}
{"id": "Elias_Passim_2901", "series": "CAG", "text": "δευτέρα ἀπορία·", "seq": 2901}
{"id": "Elias_Passim_2902", "series": "CAG", "text": "ὅτι ἰδοὺ τὸ ὅλον ἐν τοῖς μέρεσι καὶ οὐκ ἔστι τὸ ὅλον μέρος τῶν μερῶν καὶ οὐ δύναται τὸ ὅλον τῶν μερῶν χωρισθῆναι, καὶ ὅμως οὐκ ἔστι συμβεβηκός.", "seq": 2902}
{"id": "Elias_Passim_2903", "series": "CAG", "text": "πρὸς ὅ φαμεν ὅτι ἡ ὑπογραφὴ ἔν τινι εἶχεν, οὐκ ἔν τισι·", "seq": 2903}
{"id": "Elias_Passim_2904", "series": "CAG", "text": "τὸ δὲ ὅλον ἔν τισι λέγεται εἶναι, οὐκ ἔν τινι·", "seq": 2904}
{"id": "Elias_Passim_2905", "series": "CAG", "text": "τοὐλάχιστον γὰρ ἐν δύο μέρεσι τὸ ὅλον θεωρεῖται.", "seq": 2905}
{"id": "Elias_Passim_2906", "series": "CAG", "text": "διὸ καὶ ἐπαποροῦσιν ὅτι καὶ τὸ ὅλον ἔν τινι λέγεται·", "seq": 2906}
{"id": "Elias_Passim_2907", "series": "CAG", "text": "ἓν γὰρ τῶν ἕνδεκα σημαινομένων ἐλέγετο εἶναι τοῦ ἔν τινι τὸ ὡς ὅλον ἐν μέρεσι.", "seq": 2907}
{"id": "Elias_Passim_2908", "series": "CAG", "text": "καὶ λέγομεν ὅτι τοῦτο εἴρηται πρὸς ἔνδειξιν τοῦ μὴ δύνασθαι τὸ συμβεβηκὸς καθ᾿ αὑτὸ ὑπάρχειν, καὶ ὅτι ἑνικὴ μὲν ἡ ἐκφώνησις τοῦ ἔν τινι, πλῆθος δὲ σημαίνει·", "seq": 2908}
{"id": "Elias_Passim_2909", "series": "CAG", "text": "ἔν τινι γὰρ πλήθει τῶν μερῶν τὸ ὅλον ἢ ἔν τινι ποσότητι μερῶν θεωρεῖται.", "seq": 2909}
{"id": "Elias_Passim_2910", "series": "CAG", "text": "καὶ ἄλλως δὲ ταῦτα διακέκριται, ὅτι τὸ μὲν ὅλον δοκεῖ ἐν τοῖς μέρεσιν αὐτοῦ ὡς αὐτὸ ἐν ἑαυτῷ εἶναι, τὸ δὲ συμβεβηκὸς ἄλλο ἐν ἄλλῳ ἐστίν.", "seq": 2910}
{"id": "Elias_Passim_2911", "series": "CAG", "text": "ἄλλη ἀπορία ἡ λέγουσα ὅτι τὸ εἶδος ἐν τῇ ὕλῃ καὶ οὐκ ἔστι μέρος τῆς ὕλης καὶ οὐ χωρίζεται τῆς ὕλης (χωριζόμενον γὰρ φθείρεται), καὶ ὅμως οὐκ ἔστι συμβεβηκὸς ὡς εἶδος καὶ ὡς εἰδοποιὸν τὸ εἶδος αὐτό, ἀλλ᾿ οὐσία·", "seq": 2911}
{"id": "Elias_Passim_2912", "series": "CAG", "text": "τοῦ γὰρ εἰδοπεποιημένου οὐσία ἐστί.", "seq": 2912}
{"id": "Elias_Passim_2913", "series": "CAG", "text": "πρὸς ὅ φαμεν ὅτι συμβεβηκὸς τὸ εἶδος·", "seq": 2913}
{"id": "Elias_Passim_2914", "series": "CAG", "text": "τῇ γὰρ ὕλῃ συμβέβηκεν, ἐπειδὴ καὶ χωρίζεται αὐτῆς.", "seq": 2914}
{"id": "Elias_Passim_2915", "series": "CAG", "text": "τοῦ μέντοι συνθέτου οὐσία ἐστὶ τὸ εἶδος καὶ ἡ ὕλη, ὡς συμπληρωτικὰ αὐτοῦ.", "seq": 2915}
{"id": "Elias_Passim_2916", "series": "CAG", "text": "διὸ καὶ μέρη αὐτοῦ λέγεται, οὐκ ἀλλήλων μέρη·", "seq": 2916}
{"id": "Elias_Passim_2917", "series": "CAG", "text": "οὐδὲν γὰρ τοῦ λοιποῦ δύναται παρ᾿ ἑαυτὸ μέρος εἶναι·", "seq": 2917}
{"id": "Elias_Passim_2918", "series": "CAG", "text": "οὐδὲ γὰρ ὁ ἑπτὰ τοῦ τρία λοιποῦ ὄντος παρ᾿ ἑαυτὸν δύναται μέρος τοῦ δέκα εἶναι.", "seq": 2918}
{"id": "Elias_Passim_2919", "series": "CAG", "text": "αὗται αἱ ἀπορίαι τῶν πλεονασμὸν κατηγορούντων.", "seq": 2919}
{"id": "Elias_Passim_2920", "series": "CAG", "text": "οἱ δὲ ἔλλειψιν κατηγοροῦντες ἐπιχειροῦσι λέγοντες οὕτως·", "seq": 2920}
{"id": "Elias_Passim_2921", "series": "CAG", "text": "ὅτι οὐ παντὶ συμβεβηκότι ἁρμόζει αὕτη ἡ ὑπογραφή, εἰ μὴ τῷ ἀχωρίστῳ.", "seq": 2921}
{"id": "Elias_Passim_2922", "series": "CAG", "text": "πρὸς ὅ φαμεν ὅτι ὅσον μὲν ἐπὶ τὸ χωρίζεσθαι ἢ μὴ χωρίζεσθαι τοῦ συμβεβηκότος τὸ μὲν χωριστὸν τὸ δὲ ἀχώριστον, ὅσον δὲ ἐπὶ τὸ μὴ δύνασθαι χωρὶς ὑποστῆναι πᾶν συμβεβηκὸς χωριστὸν ἀχώριστον·", "seq": 2922}
{"id": "Elias_Passim_2923", "series": "CAG", "text": "οὐδὲ γὰρ εἶπεν ‘ὃ ἀδύνατον χωρισθῆναι’, ἀλλ᾿ ὃ ἀδύνατον χωρὶς ὑποστῆναι.", "seq": 2923}
{"id": "Elias_Passim_2924", "series": "CAG", "text": "εἶτά φασιν ὅτι δύναται χωρὶς ὑποστῆναι συμβεβηκός·", "seq": 2924}
{"id": "Elias_Passim_2925", "series": "CAG", "text": "ἰδοὺ γὰρ ἡ εὐωδία τοῦ μήλου, συμβεβηκὸς οὖσα, καταλείψασα τὸ μῆλον μένει ἐν τῷ αἰσθητηρίῳ ἢ τῷ κιβωτίῳ.", "seq": 2925}
{"id": "Elias_Passim_2926", "series": "CAG", "text": "λύουσι τοῦτο διάφοροι, ὁ μὲν Πλάτων ὅτι οὐκ ἐχωρίσθη τοῦ ὑποκειμένου·", "seq": 2926}
{"id": "Elias_Passim_2927", "series": "CAG", "text": "μετά τινων γὰρ λεπτῶν ἀπορροιῶν χωρεῖ πρὸς ἡμᾶς, ὡς δηλοῖ ἡ κατὰ μέσον αὐτοῦ ἴσχνανσις·", "seq": 2927}
{"id": "Elias_Passim_2928", "series": "CAG", "text": "ἐν γὰρ τῷ δένδρῳ οὐκ ἰσχναίνεται διὰ τὸ πλείονα εἶναι τὴν εἰσροὴν τῆς ἐκροῆς.", "seq": 2928}
{"id": "Elias_Passim_2929", "series": "CAG", "text": "ὁ δὲ Ἀριστοτέλης τὸ διακονικὸν αἰτιᾶται τοῦ ἀέρος, ὅτι ᾧ λόγῳ ἐστὶ διορατὸς καὶ διηχής, τούτῳ καὶ δίοσμος.", "seq": 2929}
{"id": "Elias_Passim_2930", "series": "CAG", "text": "ὁ δὲ Πλωτῖνος τὰ Ἀριστοτέλους καὶ Πλάτωνος συναγαγών φησιν ὅτι μεταβάλλεται μέρος τοῦ ἀέρος τῇ εὐωδίᾳ·", "seq": 2930}
{"id": "Elias_Passim_2931", "series": "CAG", "text": "ἡ γὰρ εὐωδία μείνασα ἐν τῷ μήλῳ γεννᾷ ὁμοίαν ἑαυτῇ ἑτέραν ποιότητα μεταβάλλουσαν μέρος τοῦ ἀέρος, ἧς αἰσθανόμεθα.", "seq": 2931}
{"id": "Elias_Passim_2932", "series": "CAG", "text": "οὐδεμία δὲ τῶν δοξῶν τούτων καθ᾿ αὑτὴν ἀληθής·", "seq": 2932}
{"id": "Elias_Passim_2933", "series": "CAG", "text": "οὐδὲ ἡ Πλάτωνος ἡ λέγουσα ἀπορροίας·", "seq": 2933}
{"id": "Elias_Passim_2934", "series": "CAG", "text": "ἡ γὰρ ἀπόρροια σῶμα, παντὸς δὲ σώματος μία ἡ κατὰ φύσιν κίνησις (ἢ γὰρ κοῦφον καὶ ἐπὶ τὰ ἄνω ῥέπει, ἢ βαρὺ καὶ κάτω), τῆς δὲ εὐωδίας τοῦ μήλου πάντες ὁμοτίμως αἰσθανόμεθα κατὰ κύκλον, δῆλον ὅτι οὐκ ἀρκεῖ ἀπορροίας μόνον εἰπεῖν.", "seq": 2934}
{"id": "Elias_Passim_2935", "series": "CAG", "text": "οὐδὲ ἡ Ἀριστοτέλους μόνη ἀληθής·", "seq": 2935}
{"id": "Elias_Passim_2936", "series": "CAG", "text": "ἰδοὺ γὰρ οἱ χοῖροι πλείονα ὀρύττουσι τὸν βόρβορον ἐπὶ τῷ πλέον αἰσθέσθαι τῶν ἀπορροιῶν, καὶ δυσώδη δὲ τόπον παριόντες ῥάκει φράξαντες τὰς ῥῖνας, καίπερ ἀναπνέοντες, τῆς δυσωδίας οὐκ αἰσθανόμεθα, ἅτε διυλισθεισῶν τῶν ἀπορροιῶν καὶ καθαροῦ τοῦ ἀέρος χωροῦντος πρὸς ἡμᾶς.", "seq": 2936}
{"id": "Elias_Passim_2937", "series": "CAG", "text": "οὐδὲ τὸ τοῦ Πλωτίνου μόνον ἀληθὲς τὸ ποιοῦσθαι ὅλον τὸν ἀέρα·", "seq": 2937}
{"id": "Elias_Passim_2938", "series": "CAG", "text": "πλασματῶδες γὰρ τὸ λέγειν ὅλον τὸν ἐν μέσῳ ἀέρα ποιοῦσθαι ἐπὶ τῶν γυπῶν τῶν αἰσθανομένων τῶν ἐν ἄλλαις πόλεσιν ἀτάφων σωμάτων.", "seq": 2938}
{"id": "Elias_Passim_2939", "series": "CAG", "text": "αἱ τρεῖς οὖν ἅμα ἀληθεῖς εἰσιν, ἀλλ᾿ ἐπὶ μὲν τῶν φαύλως ὀσμωμένων χρεία καὶ ἀπορροιῶν, ἐπὶ δὲ τῶν ἀκριβῶς ὀσμωμένωνἀρκεῖ καὶ τὸ δίοσμον τοῦ ἀέρος, ἐπὶ δὲ τῶν μέσως ἀρκεῖ καὶ ἡ μεταβολὴ τοῦ ἀέρος.", "seq": 2939}
{"id": "Elias_Passim_2940", "series": "CAG", "text": "κατ᾿ οὐδεμίαν δὲ τῶν δοξῶν αἱ ποιότητες ἀπὸ τοῦ ὑποκειμένου εἰς ὑποκείμενον μεταβαίνουσιν·", "seq": 2940}
{"id": "Elias_Passim_2941", "series": "CAG", "text": "ἢ γὰρ ἐν τῷ αὐτῷ νῦν εἰσι, κἂν τῷ ἐν ᾧ εἰσι κἂν τῷ ἐξ οὗ, καὶ διασπασθήσεται αὐτὴ ἑαυτῆς ἡ ποιότης, ἢ ἐν ἄλλῳ καὶ ἄλλῳ νῦν.", "seq": 2941}
{"id": "Elias_Passim_2942", "series": "CAG", "text": "ἐπεὶ δὲ πάντως μεταξὺ τῶν δύο νῦν ἐστι χρόνος μέσος, ἐν ἐκείνῳ τῷ χρόνῳ ἔσονται χωρὶς ὑποκειμένου.", "seq": 2942}
{"id": "Elias_Passim_2943", "series": "CAG", "text": "ἐνῆν δὲ καὶ ἁπλούστερον λῦσαι ταῦτα, ὅτι οὐκ εἶπεν ὁ Ἀριστοτέλης ‘ὃ δύναται χωρὶς εἶναι τοῦ ἐν ᾧ ἦν’, ἀλλὰ τοῦ ἐν ᾧ ἐστιν, ὅπου δ᾿ ἂν ᾖ ἡ ποιότης, ἐν ὑποκειμένῳ ἐστίν.", "seq": 2943}
{"id": "Elias_Passim_2944", "series": "CAG", "text": "1b10 Ὅταν ἕτερον καθ᾿ ἑτέρου κατηγορῆται ὡς καθ᾿ ὑποκειμένου, ὅσα κατὰ τοῦ κατηγορουμένου λέγεται, τοσαῦτα καὶ κατὰ τοῦ ὑποκειμένου λεχθήσεται.", "seq": 2944}
{"id": "Elias_Passim_2945", "series": "CAG", "text": "Ἐπειδὴ αἱ κατηγορίαι καὶ βάθος ἔχουσι καὶ πλάτος (βάθος μὲν τὴν εἰς τὰ μερικώτερα αὐτῶν πρόοδον, πλάτος δὲ τὴν εἰς τὰ πλάγια μετάστασιν, οἷον ἵνα βάθος μὲν λάβῃς οὕτως, τὴν οὐσίαν καὶ τὸ σῶμα καὶ τὸ ἔμψυχον καὶ τὸ ζῷον, καὶ οὕτως ἐφεξῆς), διὰ τοῦτο ὁ Ἀριστοτέλης κανόνα καὶ τοῦ πλάτους καὶ τοῦ βάθους ἡμῖν παραδίδωσι, καὶ νῦν μὲν τοῦ βάθους, ἐφεξῆς δὲ καὶ τοῦ πλάτους.", "seq": 2945}
{"id": "Elias_Passim_2946", "series": "CAG", "text": "ἔστι δὲ ὁ κανὼν οὕτως·", "seq": 2946}
{"id": "Elias_Passim_2947", "series": "CAG", "text": "ὅταν τὸ πρῶτον τοῦ δευτέρου κατηγορῆται ὡς καθ᾿ ὑποκειμένου καὶ τὸ δεύτερον τοῦ τρίτου, καὶ τὸ πρῶτον τοῦ τρίτου κατηγορηθήσεται ὡς καθ᾿ ὑποκειμένου·", "seq": 2947}
{"id": "Elias_Passim_2948", "series": "CAG", "text": "οἷον τὸ ἔμψυχον κατηγορεῖται τοῦ ζῴου καὶ τὸ ζῷον τοῦ ἀνθρώπου, καὶ τὸ ἔμψυχον τοῦ ἀνθρώπου κατηγορηθήσεται.", "seq": 2948}
{"id": "Elias_Passim_2949", "series": "CAG", "text": "καλῶς δὲ πρόσκειται ἐν τῷ κανόνι καθ᾿ ὑποκειμένου·", "seq": 2949}
{"id": "Elias_Passim_2950", "series": "CAG", "text": "εἰ γὰρ μέλλει ἀληθὴς εἶναι ὁ κανών, δεῖ ἑκατέραν τῶν προτάσεων καθ᾿ ὑποκειμένου εἶναι·", "seq": 2950}
{"id": "Elias_Passim_2951", "series": "CAG", "text": "εἴτε γὰρ αἱ δύο ὦσιν ἐν ὑποκειμένῳ, οὐδὲν συνάγεται ἀληθές, εἴτε ἡ μία καθ᾿ ὑποκειμένου ἡ δὲ λοιπὴ ἐν ὑποκειμένῳ, καὶ ἢ ἡ μία ἢ ἡ δευτέρα, οὐδὲ οὕτως ἀληθές τι συνάγεται.", "seq": 2951}
{"id": "Elias_Passim_2952", "series": "CAG", "text": "καὶ δὴ εἰλήφθωσαν αἱ δύο ἐν ὑποκειμένῳ, οἷον ‘ὁ ἄνθρωπος λευκός, τὸ λευκὸν δισύλλαβον, ὁ ἄνθρωπος ἄρα δισύλλαβον’·", "seq": 2952}
{"id": "Elias_Passim_2953", "series": "CAG", "text": "ἐὰν συμπερανθῇ οὕτως, ψεῦδος τὸ συναγόμενον.", "seq": 2953}
{"id": "Elias_Passim_2954", "series": "CAG", "text": "εἰλήφθω πάλιν ἡμῖν ἐν ὑποκειμένῳ ἡ μία καὶ ἡ δευτέρα καθ᾿ ὑποκειμένου, οἷον ‘ἡ ἄνθρωπος λευκός, τὸ λευκὸν χρῶμα, ὁ ἄνθρωπος ἄρα χρῶμα’, καὶ ἔστι ψεῦδος τὸ συναγόμενον.", "seq": 2954}
{"id": "Elias_Passim_2955", "series": "CAG", "text": "εἰλήφθω πάλιν ἡ μὲν μία καθ᾿ ὑποκειμένου οἷον ‘ὁ ἄνθρωπος ζῷον’, ἡ <δὲ> δευτέρα ἐν ὑποκειμένῳ, οἷον ‘τὸ ζῷον δισύλλαβον’, οὐδὲν ἀληθές τι συνάγεται.", "seq": 2955}
{"id": "Elias_Passim_2956", "series": "CAG", "text": "καὶ ἔχομεν διὰ τούτου τὸ ἀνάπαλιν τοῦ κανόνος·", "seq": 2956}
{"id": "Elias_Passim_2957", "series": "CAG", "text": "οὗτος γὰρ πάντα τὰ ὄντα ὑπὸ τὰς δέκα κατηγορίας ἀνάγει·", "seq": 2957}
{"id": "Elias_Passim_2958", "series": "CAG", "text": "ὥσπερ γὰρ ὁ κανὼν ἐδείκνυε τὸ πρῶτον τῷ δευτέρῳ ὑπάρχον καὶ τὸ δεύτερον τῷ τρίτῳ, οὕτω καὶ διὰ τοῦ ἀνάπαλιν ἔστι δεῖξαι τὰ ὕστερα καὶ δεύτερα ὑπὸ τὰ πρῶτα ἀναγόμενα, οἷον ὁ ἄνθρωπος ὑπὸ τὸ ζῷον τὸ δὲ ζῷον ὑπὸ τὸ ἔμψυχον καὶ τὸ σῶμα καὶ τὴν οὐσίαν, καὶ ὁ ἄνθρωπος ὑπὸ τὴν οὐσίαν ἀναχθήσεται.", "seq": 2958}
{"id": "Elias_Passim_2959", "series": "CAG", "text": "καὶ ἐπὶ τῶν ἄλλων κατηγοριῶν ὡσαύτως.", "seq": 2959}
{"id": "Elias_Passim_2960", "series": "CAG", "text": "Ἀποροῦσι δέ τινες λέγοντες ὅτι ὁρίζεται τὸ καθ᾿ ὑποκειμένου, ὅτε λέγει, <εἰ> τὸ πρῶτον τῷ δευτέρῳ ὑπάρχει καὶ τὸ δεύτερον τῷ τρίτῳ, ὅτι καὶ τὸ πρῶτον τῷ τρίτῳ ὑπάρχει, ἀλλὰ καὶ τὸ οὐκ ἐν ὑποκειμένῳ ὁρίζεται, φημὶ δὴ τὴν οὐσίαν [ἢ καὶ ὑποκείμενον], ὅτε καταλέγει τὰ ἴδια τῆς οὐσίας·", "seq": 2960}
{"id": "Elias_Passim_2961", "series": "CAG", "text": "αἱ γὰρ ὑπογραφαὶ ἐκ τῶν ἰδίων λαμβάνονται.", "seq": 2961}
{"id": "Elias_Passim_2962", "series": "CAG", "text": "αὕτη ἡ ἀπορία.", "seq": 2962}
{"id": "Elias_Passim_2963", "series": "CAG", "text": "λύομεν δὲ αὐτὴν οὕτως·", "seq": 2963}
