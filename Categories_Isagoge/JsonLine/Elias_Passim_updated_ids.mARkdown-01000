{"id": "Elias_Passim_3378", "series": "CAG", "text": "τὰ μέρη τῶν οὐσιῶν ἔν τινι, τὰ ἔν τινι συμβεβηκότα, τὰ μέρη τῶν οὐσιῶν ἄρα συμβεβηκότα·", "seq": 3378}
{"id": "Elias_Passim_3379", "series": "CAG", "text": "οὐδὲ γὰρ οὕτως ἐλέγομεν τὸ ἔν τινι τὸ ἐν ὑποκειμένῳ, ἀλλὰ τὸ ἔν τινι μὴ ὡς μέρος ὑπάρχον.", "seq": 3379}
{"id": "Elias_Passim_3380", "series": "CAG", "text": "νῦν δὲ τὸ ἔν τινι ὡς μέρος ἐν ὅλῳ ὑπόκειται, οἷον ἡ διαφορά.", "seq": 3380}
{"id": "Elias_Passim_3381", "series": "CAG", "text": "3a21 Οὐκ ἴδιον οὐσίας.", "seq": 3381}
{"id": "Elias_Passim_3382", "series": "CAG", "text": "Τοῦτο ὀφείλων εἰπεῖν ὅτι οὐ μόνῃ τῇ οὐσίᾳ ὑπάρχει, εἶπεν ὅτι οὐκ ἔστιν ἴδιον·", "seq": 3382}
{"id": "Elias_Passim_3383", "series": "CAG", "text": "καὶ τὸ ἴδιον γὰρ τῷ μόνῳ χαρακτηρίζεται καὶ οὐ τῷ παντί.", "seq": 3383}
{"id": "Elias_Passim_3384", "series": "CAG", "text": "3a33 Ὑπάρχει δὲ ταῖς οὐσίαις καὶ ταῖς διαφοραῖς τὸ πάντα συνωνύμως ἀπ᾿ αὐτῶν λέγεσθαι.", "seq": 3384}
{"id": "Elias_Passim_3385", "series": "CAG", "text": "Δεύτερον ἴδιον τῆς οὐσίας τὸ συνωνύμως κατηγορεῖσθαι.", "seq": 3385}
{"id": "Elias_Passim_3386", "series": "CAG", "text": "ἀλλὰ τοῦτο ὑπάρχει καὶ τοῖς συμβεβηκόσι·", "seq": 3386}
{"id": "Elias_Passim_3387", "series": "CAG", "text": "τὸ γὰρ χρῶμα τοῦ λευκοῦ τούτου συνωνύμως κατηγορεῖται.", "seq": 3387}
{"id": "Elias_Passim_3388", "series": "CAG", "text": "ἀλλ᾿ εἶπεν οὕτως·", "seq": 3388}
{"id": "Elias_Passim_3389", "series": "CAG", "text": "ὅτι δεύτερον ἴδιον τῆς οὐσίας τὸ συνωνύμως κατηγορεῖσθαι μόνον·", "seq": 3389}
{"id": "Elias_Passim_3390", "series": "CAG", "text": "τὰ γὰρ συμβεβηκότα καὶ ὁμωνύμως κατηγοροῦνται καὶ συνωνύμως καὶ παρωνύμως καὶ ἑτερωνύμως.", "seq": 3390}
{"id": "Elias_Passim_3391", "series": "CAG", "text": "καὶ τὰ παραδείγματα εἴρηται ἀνωτέρω.", "seq": 3391}
{"id": "Elias_Passim_3392", "series": "CAG", "text": "ἢ καὶ ἄλλως δεῖ εἰπεῖν·", "seq": 3392}
{"id": "Elias_Passim_3393", "series": "CAG", "text": "ὅτι τὸ δεύτερον ἴδιον τῆς οὐσίας τὸ συνωνύμως κατηγορεῖσθαι τῶν πρώτων οὐσιῶν·", "seq": 3393}
{"id": "Elias_Passim_3394", "series": "CAG", "text": "τὰ γὰρ συμβεβηκότα εἰ καὶ συνωνύμως κατηγοροῦνται, ἀλλ᾿ οὐ τῶν πρώτων οὐσιῶν, ἀλλὰ τῶν οἰκείων ἀτόμων.", "seq": 3394}
{"id": "Elias_Passim_3395", "series": "CAG", "text": "τοῦτο δὲ οὐδὲ πάσῃ ὑπάρχει τῇ οὐσίᾳ οὐδὲ μόνῃ·", "seq": 3395}
{"id": "Elias_Passim_3396", "series": "CAG", "text": "πάσῃ μὲν γὰρ οὐχ ὑπάρχει διὰ τὴν ἄτομον οὐσίαν ἀκατηγόρητον οὖσαν.", "seq": 3396}
{"id": "Elias_Passim_3397", "series": "CAG", "text": "ἀλλ᾿ οὐδὲ μόνῃ·", "seq": 3397}
{"id": "Elias_Passim_3398", "series": "CAG", "text": "καὶ αἱ διαφοραὶ γὰρ συνωνύμως κατηγοροῦνται.", "seq": 3398}
{"id": "Elias_Passim_3399", "series": "CAG", "text": "πῶς οὖν ἴδιον τὸ μηδαμῶς ἴδιον;", "seq": 3399}
{"id": "Elias_Passim_3400", "series": "CAG", "text": "εἰ γὰρ μηδὲ πάσῃ μηδὲ μόνῃ ὑπάρχει, οὐδὲ ὅλως δύναται ἴδιον εἶναι, τοῦ ἰδίου πάσῃ καὶ μόνῃ καὶ ἀεὶ ὑπάρχοντος.", "seq": 3400}
{"id": "Elias_Passim_3401", "series": "CAG", "text": "μήποτε οὖν ὡς ἕτερον κοινὸν ὑπάρχει τῆς οὐσίας καὶ τῆς διαφορᾶς, ὡς ὅτε ἔλεγεν ὅτι κοινωνεῖ ἡ οὐσία τῇ διαφορᾷ, καθὰ ἀμφότερα συνωνύμως κατηγοροῦνται.", "seq": 3401}
{"id": "Elias_Passim_3402", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ ὅσον ἀπὸ τοῦ λεχθέντος πέντε εὑρίσκονται τὰ ἴδια τῆς οὐσίας, τῶν ἐξηγητῶν ἓξ εἰωθότων λέγειν, εἰπὲ ὅτι κατεφρόνησε νῦν τῆς ἀντιδιαστολῆς τῆς οὐσίας πρὸς τὴν διαφορὰν καὶ ἀμφότερα ὡς οὐσίας ἔλαβε.", "seq": 3402}
{"id": "Elias_Passim_3403", "series": "CAG", "text": "καὶ μήποτε ἴδιον εὑρίσκεται τῆς οὐσίας καὶ μᾶλλον ἴδιον·", "seq": 3403}
{"id": "Elias_Passim_3404", "series": "CAG", "text": "τοῦ γὰρ πρώτου ἰδίου πάσῃ μὲν ὑπάρχοντος μὴ μόνῃ δέ, τοῦτο μόνῃ ὑπάρχει οὐ πάσῃ δέ·", "seq": 3404}
{"id": "Elias_Passim_3405", "series": "CAG", "text": "τὰ γὰρ ἴδια στενοχωρεῖσθαι θέλοντα τῷ μόνῳ χαρακτηρίζεται καὶ οὐ τῷ παντί.", "seq": 3405}
{"id": "Elias_Passim_3406", "series": "CAG", "text": "Ἐφ᾿ οἷς ἀποροῦσιν ὅτι πῶς λέγεται τὰς διαφορὰς συνωνύμως κατηγορεῖσθαι, εἴ γε αἱ διαφοραὶ τοῦ οἰκείου ὀνόματος οὐ μεταδιδόασιν·", "seq": 3406}
{"id": "Elias_Passim_3407", "series": "CAG", "text": "οὐδεὶς γὰρ λέγει ὅτι ἄνθρωπος λογικότης.", "seq": 3407}
{"id": "Elias_Passim_3408", "series": "CAG", "text": "πρὸς ὅ φαμεν·", "seq": 3408}
{"id": "Elias_Passim_3409", "series": "CAG", "text": "διττὸν τὸ συνώνυμον παρὰ τῷ Ἀριστοτέλει, ἢ τὸ μεταδιδοῦν ὀνόματος καὶ πράγματος ἢ τὸ συντελοῦν πρὸς ὕπαρξιν·", "seq": 3409}
{"id": "Elias_Passim_3410", "series": "CAG", "text": "οὕτω γὰρ αὐτὸς ἐν τῷ Περὶ τῆς ψυχῆς λόγῳ τὴν ψυχὴν συνωνύμως λέγει τοῦ ζῴου κατηγορεῖσθαι, ἐπειδὴ συντελεῖ πρὸς τὴν ὕπαρξιν αὐτοῦ, κἂν μὴ μεταδίδωσιν ὀνόματος καὶ πράγματος·", "seq": 3410}
{"id": "Elias_Passim_3411", "series": "CAG", "text": "οὐδεὶς γὰρ λέγει τὸ ζῷον ψυχήν, ἀλλ᾿ οὐδὲ τὸν ὁρισμὸν τῆς ψυχῆς ἐπιδέχεται τὸ ζῷον.", "seq": 3411}
{"id": "Elias_Passim_3412", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ ὁ Ἀριστοτέλης βούλεται καὶ τὴν διαφορὰν οὐ μόνον πράγματος ἀλλὰ καὶ ὀνόματος μεταδιδόναι, μήποτε μεταδίδωσί πως, εἰ καὶ παρωνύμως λέγεται ἀπὸ τῆς λογικότητος.", "seq": 3412}
{"id": "Elias_Passim_3413", "series": "CAG", "text": "ἢ καὶ ἄλλως·", "seq": 3413}
{"id": "Elias_Passim_3414", "series": "CAG", "text": "ὅτι ὥσπερ τὸ λευκὸν διττόν, τοῦτ᾿ ἔστι τὸ λελευκωμένον ξύλον καὶ αὐτὴ ἡ λευκότης, μήποτε δυνάμεθα λέγειν ὅτι καὶ τὸ λογικὸν διττόν, τοῦτ᾿ ἔστιν αὐτὴ ἡ λογικότης καὶ τὸ λογικὸν ζῷον.", "seq": 3414}
{"id": "Elias_Passim_3415", "series": "CAG", "text": "ἢ καὶ ἄλλως·", "seq": 3415}
{"id": "Elias_Passim_3416", "series": "CAG", "text": "ὅτι κἂν μὴ δυνάμεθα εἰπεῖν τὸν ἄνθρωπον λογικότητα, λέγομεν αὐτὸν λογικότητα ἔχειν.", "seq": 3416}
{"id": "Elias_Passim_3417", "series": "CAG", "text": "ἔδειξεν οὖν ὁ λόγος ὅτι ἡ διαφορὰ συνωνύμως κατηγορεῖται κυρίως.", "seq": 3417}
{"id": "Elias_Passim_3418", "series": "CAG", "text": "3b10 Πᾶσα δὲ οὐσία δοκεῖ τόδε τι σημαίνειν.", "seq": 3418}
{"id": "Elias_Passim_3419", "series": "CAG", "text": "Ἐπὶ μὲν τῶν πρώτων οὐσιῶν καταγνοὺς ὁ Ἀριστοτέλης τῶν πρώτων δύο ἰδίων τῆς οὐσίας, τοῦ μὲν ἑνὸς ὡς πάσῃ μὲν ὑπάρχοντος μὴ μόνῃ δέ, τοῦ δὲ δευτέρου ὡς μήτε πάσῃ μήτε μόνῃ ὑπάρχοντος, ἐφ᾿ ἕτερον ἴδιον κατάγει τὸν λόγον καί φησι τρίτον ἴδιον τῆς οὐσίας <τὸ> τόδε τι σημαίνειν.", "seq": 3419}
{"id": "Elias_Passim_3420", "series": "CAG", "text": "δηλοῖ τὸ μὲν τόδε τὸ ὑποκείμενον·", "seq": 3420}
{"id": "Elias_Passim_3421", "series": "CAG", "text": "οὕτω γοῦν αὐτὸς ἐν ταῖς Φυσικαῖς τὴν ὕλην ὑποκείμενον καλεῖ·", "seq": 3421}
{"id": "Elias_Passim_3422", "series": "CAG", "text": "ἄμφω γὰρ ὡρισμένα, καὶ τὸ τόδε ὡς δείξει ὑποπίπτον καὶ ἡ ὕλη <ὡς> ὡσαύτως μένουσα πάντων ἐν αὐτῇ τρεπομένων, εἴπερ ὁ λέβης δύναται μετασχηματισθῆναι καὶ γενέσθαι ἀνδριὰς καὶ ὁ ἀνδριὰς πάλιν μετασχηματιζόμενος ἕτερόν τι γενέσθαι οὐδὲν ἧττον μένοντος τοῦ χαλκοῦ, ὅπερ ἦν, πρὶν γένηται λέβης ἢ ἀνδριὰς ἤ τι τῶν τοιούτων.", "seq": 3422}
{"id": "Elias_Passim_3423", "series": "CAG", "text": "οὕτως ὁ Ἀριστοτέλης τὸ τόδε καὶ τὴν ὕλην ὑποκείμενα καλεῖ.", "seq": 3423}
{"id": "Elias_Passim_3424", "series": "CAG", "text": "τὸ δὲ τὶ τὸ μερικὸν δηλοῖ.", "seq": 3424}
{"id": "Elias_Passim_3425", "series": "CAG", "text": "ἄμφω δέ, τόδε καὶ τί, τὸ μερικὸν ὑποκείμενον δηλοῖ, φημὶ τὴν ἄτομον οὐσίαν.", "seq": 3425}
{"id": "Elias_Passim_3426", "series": "CAG", "text": "τοῦτο δὲ τὸ ἴδιον οὐδὲ τῇ ὕλῃ ἁρμόζει διὰ τὸ καθολικὸν ὑποκείμενον αὐτὴν εἶναι καὶ ὅτι οὐκ ἔχει συμβεβηκότα τῷ ἑαυτῆς λόγῳ, ἅπερ ποιοῦσι τὸ μερικόν (καὶ ἁπλῶς εἰπεῖν οὐδὲ τὸ καθόλου ἁρμόζει τῇ ὕλῃ οὐδὲ τὸ μερικόν·", "seq": 3426}
{"id": "Elias_Passim_3427", "series": "CAG", "text": "ταῦτα γὰρ εἰδοπεποιημένα ὀνόματα, ἡ δὲ ὕλη οὐκ ἔχει καθ᾿ ἕξιν τὰ εἴδη, ἀλλὰ κατ᾿ ἐπιτηδειότητα), οὐδὲ τῇ θείᾳ ἁρμόζει οὐσίᾳ μηδενὶ ὑποκείμενον οὔσῃ, οὐδὲ ταῖς δευτέραις·", "seq": 3427}
{"id": "Elias_Passim_3428", "series": "CAG", "text": "αὗται γὰρ εἰ καὶ τῷ ἑνιαίῳ τῆς προφορᾶς δοκοῦσι τόδε τι σημαίνειν, ὅταν εἴπω ‘ἄνθρωπος’ ἢ ‘ζῷον’, ἀλλ᾿ οὐ τόδε τι σημαίνουσιν ἀλλὰ τοιόνδε, τοῦτ᾿ ἔστιν ὁμοιότητα, καθ᾿ ἣν ἐοίκασιν οἱ ἄνθρωποι ἀλλήλοις, καθό εἰσιν ἄνθρωποι, καὶ τὰ ζῷα, καθὸ ζῷα.", "seq": 3428}
{"id": "Elias_Passim_3429", "series": "CAG", "text": "καὶ μὴ νομίσῃς, ἐπειδὴ εἶπον τοιόνδε αὐτὰ σημαίνειν, τὸ δὲ τοιόνδε ποιότης, ἡ δὲ ποιότης συμβεβηκός, ὅτι αἱ δεύτεραι οὐσίαι συμβεβηκότα·", "seq": 3429}
{"id": "Elias_Passim_3430", "series": "CAG", "text": "κἂν γὰρ ποιότητα σημαίνωσιν, ἀλλ᾿ οὐσιώδη ποιότητα.", "seq": 3430}
{"id": "Elias_Passim_3431", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ καὶ τὰ καθόλου συμβεβηκότα ὁμοιότητα σημαίνουσι τῶν κατὰ μέρος συμβεβηκότων, τίνι διαφέρουσι τῶν δευτέρων οὐσιῶν;", "seq": 3431}
{"id": "Elias_Passim_3432", "series": "CAG", "text": "καὶ λέγομεν ὅτι αἱ μὲν δεύτεραι οὐσίαι ὁμοιότητα οὐσιώδη σημαίνουσι τὰ δὲ συμβεβηκότα ἐπουσιώδη·", "seq": 3432}
{"id": "Elias_Passim_3433", "series": "CAG", "text": "διττὴ γὰρ ἡ ποιότης, ἡ μὲν οὐσιώδης ἡ δὲ ἐπουσιώδης.", "seq": 3433}
{"id": "Elias_Passim_3434", "series": "CAG", "text": "μήποτε οὖν τὸ παρὸν ἴδιον ἄλλο ἐστὶν ἐγκώμιον τῆς οὐσίας τῆς ἀτόμου·", "seq": 3434}
{"id": "Elias_Passim_3435", "series": "CAG", "text": "μόνη γὰρ ἡ ἄτομος οὐσία πρὸς τῷ πᾶσιν ὑποκεῖσθαι τοῖς παρ᾿ ἑαυτὴν ἑαυτῆς ἐστι μόνη, τὰ δὲ ἄλλα πάντα τῆς ἀτόμου οὐσίας εἶναι λέγεται.", "seq": 3435}
{"id": "Elias_Passim_3436", "series": "CAG", "text": "Ταῦτα ὁ Ἀριστοτέλης καὶ ἕτερον οὐδέν.", "seq": 3436}
{"id": "Elias_Passim_3437", "series": "CAG", "text": "πέντε δέ τισιν ἔχομεν ἐπιστῆσαι·", "seq": 3437}
{"id": "Elias_Passim_3438", "series": "CAG", "text": "πρῶτον μὲν ὅτι πῶς λέγομεν τὴν οὐσίαν σημαίνειν, εἰ πρᾶγμα ἡ οὐσία, τὰ δὲ πράγματα σημαίνονται καὶ οὐ σημαίνουσι.", "seq": 3438}
{"id": "Elias_Passim_3439", "series": "CAG", "text": "καὶ λέγομεν ὅτι ὁ σκοπὸς ταῖς Κατηγορίαις οὐ περὶ πραγμάτων ᾗ πράγματα διαλαβεῖν, ἀλλ᾿ ᾗ σημαίνονται ὑπὸ τοιῶνδε φωνῶν·", "seq": 3439}
{"id": "Elias_Passim_3440", "series": "CAG", "text": "ποτὲ μὲν γὰρ τὰ πράγματα ποιοῦσι τὰ τῶν φωνῶν, οὐχ ὡς πράγματα σημαίνοντα, ἀλλ᾿ ὡς τοιῶσδε ὀνομαζόμενα, οἷον Σωκράτης ἐν πλήθει θεωρούμενος τοῖς ἐπιζητοῦσιν αὐτόν (σημαίνουσι γάρ ποτε καὶ τὰ πράγματα φωνὰς ὡς ἐφελκόμενα τὰς οἰκείας προσηγορίας, σημαίνουσι δὲ καὶ τὰ πράγματα πράγματα, οἷον τὸ γάλα ὅτι τέτοκεν, ὁ καπνὸς ὅτι πῦρ), ποτὲ δὲ <καὶ> αἱ φωναὶ ποιοῦσι τὰ τοῦ πράγματος, οἷον Σωκράτης περιπατεῖ, οὐχ ὅτι τὸ Σωκράτης ὄνομα περιπατεῖ, ἀλλ᾿ ὅτι τὸ πρᾶγμα τὸ ἔχον τοιοῦτον ὄνομα ἐκεῖνο περιπατεῖ.", "seq": 3440}
{"id": "Elias_Passim_3441", "series": "CAG", "text": "δεύτερον ὅτι καὶ ἐκ τούτου φαίνεται τοῦ ἰδίου, τοῦ κατὰ τὴν ὁμοιότητα ἰδίου, οὐκ ἐκ τοῦ κατὰ τόδε τι, ὅτι οὐσίαι αἱ διαφοραί, οὐ μόνον ὅτι οὔκ εἰσιν ἐν ὑποκειμένῳ καὶ ὅτι συνωνύμως κατηγοροῦνται καὶ ὅτι μέρη οὐσιῶν εἰσιν, ἀλλ᾿ ὅτι καὶ ἀνομοιότητα οὐσιῶν σημαίνουσιν·", "seq": 3441}
{"id": "Elias_Passim_3442", "series": "CAG", "text": "ὡς γὰρ αἱ δεύτεραι οὐσίαι ὁμοιότητα σημαίνουσαι τῶν κατὰ μέρος οὐσιῶν οὐσίαι εἰσίν, οὕτω καὶ αἱ διαφοραὶ ἀνομοιότητα οὐσιῶν σημαίνουσαι οὐσίαι εἰσί·", "seq": 3442}
{"id": "Elias_Passim_3443", "series": "CAG", "text": "τῶν γὰρ ἀντιδιαιρουμένων μία ἡ ἐπιστήμη, τοῦτ᾿ ἔστιν ὁμοιότητος καὶ ἀνομοιότητος.", "seq": 3443}
{"id": "Elias_Passim_3444", "series": "CAG", "text": "τρίτον ἐπιστήσωμεν ὅτι πῶς ἀνωτέρω ἐλέγομεν τὰ γένη καὶ τὰ εἴδη ἐν τῷ τί ἐστι κατηγορεῖσθαι, νῦν δὲ ἐν τῷ ὁποῖόν τί ἐστι.", "seq": 3444}
{"id": "Elias_Passim_3445", "series": "CAG", "text": "καὶ λέγομεν ὅτι ἀμφότερα ἀληθῆ·", "seq": 3445}
{"id": "Elias_Passim_3446", "series": "CAG", "text": "εἰ μὲν γὰρ λάβῃς αὐτὸ τὸ ἐγκατατεταγμένον πρᾶγμα καὶ οὐ τὸ σχετικὸν ἐν τοῖς κατὰ μέρος ζῷον ἢ τὸν ἄνθρωπον, ἐν τῷ τί ἐστι κατηγορεῖται, εἰ δὲ τὸ ἐξῃρημένον, τοῦτ᾿ ἔστι τὸ πρὸ τῶν πολλῶν καὶ σχετικόν, ἐν τῷ ὁποῖόν τι ἐστι κατηγορεῖται·", "seq": 3446}
{"id": "Elias_Passim_3447", "series": "CAG", "text": "ὁμοιότητα γὰρ οὐσιῶν δηλοῖ·", "seq": 3447}
{"id": "Elias_Passim_3448", "series": "CAG", "text": "εἰ μὲν γὰρ αὐτὸ τὸ πρᾶγμα καθ᾿ αὑτὸ σκοποῦμεν ἀσχέτως καὶ τὴν φύσιν αὐτοῦ, τῷ τί ἐστι χρώμεθα (τοῦτο γὰρ ὁρισμοῦ πρόσρημα καὶ φύσεως καὶ τοῦ εἶναι δηλωτικόν), εἰ δὲ τὴν σχέσιν καὶ ὁμοιότητα ζητοῦμεν, ἣν ἔχει τὸ καθόλου πρὸς τὰ κατὰ μέρος, τῷ ὁποῖόν τί ἐστι χρώμεθα·", "seq": 3448}
{"id": "Elias_Passim_3449", "series": "CAG", "text": "ὁ γὰρ καθόλου ἄνθρωπος ἢ τὸ ζῷον, ὁμοιότητα δηλοῦντα τῶν οἰκείων μερῶν ἢ εἰδῶν, τοιόνδε τι σημαίνουσι καὶ ὁμοιότητα οὐσιώδη δηλοῦσι.", "seq": 3449}
{"id": "Elias_Passim_3450", "series": "CAG", "text": "τέταρτον ἐπιστήσωμεν ὅτι ὁ μὲν Ἀριστοτέλης τόδε τι καλεῖ τὴν ἄτομον οὐσίαν, τοιόνδε τὴν δευτέραν, ὁ δὲ Πλάτων ὑπεναντίως αὐτῷ.", "seq": 3450}
{"id": "Elias_Passim_3451", "series": "CAG", "text": "καὶ λέγομεν ὅτι ἀμφότερα ἀληθῆ·", "seq": 3451}
{"id": "Elias_Passim_3452", "series": "CAG", "text": "ἑκάτερος γὰρ τὸ μὲν ὡρισμένον τόδε καλεῖ, τὸ δὲ ἀόριστον τοιόνδε.", "seq": 3452}
{"id": "Elias_Passim_3453", "series": "CAG", "text": "ἔστι δὲ ἐν ἑκατέρῳ καὶ ὡρισμένον καὶ ἀόριστον·", "seq": 3453}
{"id": "Elias_Passim_3454", "series": "CAG", "text": "ἐν μὲν τῇ ἀτόμῳ οὐσίᾳ ὡρισμένον μὲν τὸ ἓν τῷ ἀριθμῷ, ἀόριστον δὲ τῷ μηδὲ τὴν περὶ αὐτῆς προσηγορίαν ἀναμένειν, οἷον Σωκράτης (ἐν ῥοῇ γὰρ καὶ ἀπορροῇ τὸ εἶναι ἔχει, ὥσπερ καὶ τὰ ἄλλα φυσικὰ ἐν παντὶ νῦν μεταβάλλει·", "seq": 3454}
{"id": "Elias_Passim_3455", "series": "CAG", "text": "ἐν γὰρ τῷ λέγειν ‘κάλεσον τὸν καθήμενον’ ἀνίσταται καὶ οὐκ ἀνέμεινε τὴν οἰκείαν προσηγορίαν), ἐπὶ δὲ τῆς δευτέρας οὐσίας ὡρισμένον τὸ ἀμετάβλητον οἷον τοῦ καθόλου ἀνθρώπου καὶ τοῦ ζῴου, ἀόριστον δὲ τῷ ἀλλάσσεσθαι τὸ καθόλου, ὅταν πολλῶν ἔχωμεν ἔννοιαν·", "seq": 3455}
{"id": "Elias_Passim_3456", "series": "CAG", "text": "εἰ γὰρ εἴπω ‘ἄνθρωπος’, περιέλαβον τὸν Σωκράτην.", "seq": 3456}
{"id": "Elias_Passim_3457", "series": "CAG", "text": "πέμπτον δὲ καὶ τελευταῖον δεῖ ἐπιστῆσαι ὅτι παρὰ τὴν ἄγνοιαν τούτου τοῦ σημαινομένου γίνονται οἱ οὔτιδες παραλογισμοὶ κατὰ τὸν παρ᾿ Ὁμήρῳ Ὀδυσσέα ἐν καιρῷ Οὖτιν αὑτὸν καλέσαντα.", "seq": 3457}
{"id": "Elias_Passim_3458", "series": "CAG", "text": "ἔχει δὲ ὁ παραλογισμὸς οὕτως·", "seq": 3458}
{"id": "Elias_Passim_3459", "series": "CAG", "text": "ὅστις ἐν Ἀθήναις, οὗτος οὐκ ἐν Μεγάροις, ἄνθρωπος δὲ ἐν Ἀθήναις, ἄνθρωπος ἄρα οὐκ ἐν Μεγάροις.", "seq": 3459}
{"id": "Elias_Passim_3460", "series": "CAG", "text": "καὶ λέγομεν ὅτι παραλογισμός ἐστιν ἐν τῷ τίς·", "seq": 3460}
{"id": "Elias_Passim_3461", "series": "CAG", "text": "τὸ γὰρ ὅστις ὁ μὲν ἐπὶ τοῦ καθόλου βιάζεται αὑτῷ εἶναι, ὅπερ ἐστὶ ψεῦδος, ὁ δὲ ἐπὶ τοῦ μερικοῦ αὐτὸ λαμβάνει.", "seq": 3461}
{"id": "Elias_Passim_3462", "series": "CAG", "text": "καὶ ἀληθής ἐστιν ὁ λόγος τότε, ἐὰν τὸ μερικὸν λαμβάνωμεν·", "seq": 3462}
{"id": "Elias_Passim_3463", "series": "CAG", "text": "ὁ γὰρ τὶς ἄνθρωπος, φέρε εἰπεῖν Σωκράτης ἢ ἄλλος τις τῶν κατὰ μέρος ἀνθρώπων, ὁ ὢν ἐν Ἀθήναις ἐν Μεγάροις οὐκ ἔστιν, ἵνα μὴ διασπασθῇ αὐτὸς ἑαυτοῦ.", "seq": 3463}
{"id": "Elias_Passim_3464", "series": "CAG", "text": "οὕτω δὲ δεῖ λέγειν·", "seq": 3464}
{"id": "Elias_Passim_3465", "series": "CAG", "text": "ὅστις ἐν Ἀθήναις, οὗτος οὐκ ἐν Μεγάροις·", "seq": 3465}
{"id": "Elias_Passim_3466", "series": "CAG", "text": "Σωκράτης ἐν Ἀθήναις, Σωκράτης ἄρα οὐκ ἐν Μεγάροις.", "seq": 3466}
{"id": "Elias_Passim_3467", "series": "CAG", "text": "ταῦτα ἔχει ἡ θεωρία.", "seq": 3467}
{"id": "Elias_Passim_3468", "series": "CAG", "text": "3b24 Ὑπάρχει δὲ ταῖς οὐσίαις καὶ τὸ μηδὲν ἐναντίον αὐταῖς εἶναι.", "seq": 3468}
{"id": "Elias_Passim_3469", "series": "CAG", "text": "Ἐπειδὴ τὸ τρίτον ἴδιον τῆς οὐσίας, τὸ τόδε τι σημαίνειν, καὶ μόνῃ τῇ οὐσίᾳ ὑπάρχειν καὶ διὰ τοῦτο μᾶλλον ἴδιον αὐτῆς δοκοῦν εἶναι, δοκεῖ οὐχ ὡς πράγματι αὐτῇ ὑπάρχειν ἀλλ᾿ ὡς φωνῇ σημαντικῇ (τὸ γὰρ σημαίνειν φωνῆς), οὐ πρότερον καταπαύει ὁ Ἀριστοτέλης τὸν περὶ τῶν ἰδίων λόγον, πρὶν ἂν εὕροι ἴδιον τῆς οὐσίας τὸ ὡς πράγματι αὐτῇ ὑπάρχον.", "seq": 3469}
{"id": "Elias_Passim_3470", "series": "CAG", "text": "καὶ ἐπειδὴ ὡς πράγματι ὑπάρχει τῇ οὐσίᾳ τὸ τῶν ἐναντίων αὐτὴν εἶναι δεκτικήν, τῷ δὲ τῶν ἐναντίων αὐτὴν εἶναι δεκτικὴν ἕπεται τὸ μηδὲν ἔχειν ἐναντίον, τούτῳ δὲ ἕπεται τὸ μὴ ἐπιδέχεσθαι τὸ μᾶλλον καὶ τὸ ἧττον, ταῦτα τὰ τρία ἴδια παραδοὺς τῆς οὐσίας καταπαύει τὸν περὶ τῆς οὐσίας λόγον καὶ τῶν ἰδίων αὐτῆς.", "seq": 3470}
{"id": "Elias_Passim_3471", "series": "CAG", "text": "καὶ ἕκτον μὲν καὶ κυρίως παραδίδωσι τελευταῖον ἴδιον τὸ τῶν ἐναντίων δεκτικὴν αὐτὴν εἶναι, τέταρτον δὲ ἴδιον τῆς οὐσίας τὸ μηδὲν ἔχειν ἐναντίον.", "seq": 3471}
{"id": "Elias_Passim_3472", "series": "CAG", "text": "καὶ τοῦτο πιστοῦται ἐκ τῆς ἐπαγωγῆς·", "seq": 3472}
{"id": "Elias_Passim_3473", "series": "CAG", "text": "οὔτε γὰρ τῇ πρώτῃ, φησίν, ἐστί τι ἐναντίον οὔτε τῇ δευτέρᾳ.", "seq": 3473}
{"id": "Elias_Passim_3474", "series": "CAG", "text": "καὶ ταῦτα δι᾿ ἑτέρας ἐπαγωγῆς πιστοῦται·", "seq": 3474}
{"id": "Elias_Passim_3475", "series": "CAG", "text": "τῇ γὰρ πρώτῃ, φησίν, οὐκ ἔστιν ἐναντίον, ἐπειδὴ Σωκράτει οὐδέν ἐστιν ἐναντίον, τῇ δευτέρᾳ οὐδέν ἐστιν ἐναντίον, ἐπειδὴ οὔτε ζῴῳ οὔτε ἀνθρώπῳ·", "seq": 3475}
{"id": "Elias_Passim_3476", "series": "CAG", "text": "πολὺ γὰρ τὸ ἐπαγωγικὸν ἐν τῇ παρούσῃ πραγματείᾳ περὶ γενικωτάτων οὔσῃ·", "seq": 3476}
{"id": "Elias_Passim_3477", "series": "CAG", "text": "τὰ γὰρ γενικώτατα πρὸ αὑτῶν οὐδὲν ἔχει, πάντα δὲ μετὰ ταῦτα.", "seq": 3477}
{"id": "Elias_Passim_3478", "series": "CAG", "text": "ἡ δὲ ἐπαγωγὴ ἐκ τῶν δευτέρων καὶ μερικῶν τὸ καθόλου πιστοῦται, ἡ δὲ ἀπόδειξις οὐχ οὕτως, ἀλλ᾿ ἐκ τῶν ἐπάνω τὰ κάτω.", "seq": 3478}
{"id": "Elias_Passim_3479", "series": "CAG", "text": "καὶ ἐπειδὴ παχυμερὴς ἡ ἐπαγωγὴ ὡς μὴ ἐπὶ πάντων ἀληθεύουσα, φέρε ἡμεῖς δι᾿ ἑτέρου ἀναγκαστικωτέρου τρόπου τοῦτο ἀποδείξωμεν.", "seq": 3479}
{"id": "Elias_Passim_3480", "series": "CAG", "text": "δεῖ εἰδέναι ὅτι ἐγήγερται τοῖς πράγμασι φυσικὸς καὶ ἀκήρυκτος καὶ ἄσπονδος πόλεμος, ὅταν δύο τινῶν μαχομένων ἀλλήλοις ἑκάτερος ἐγκρατὴς βούληται γενέσθαι τοῦ ὑποκειμένου, μὴ δύνηται δὲ τὸ ὑποκείμενον ἀμφότερα ἐν τῷ αὐτῷ νῦν δέξασθαι τὰ ἐναντία διὰ τὸ παρὰ μέρος αὐτὸ εἶναι τῶν ἐναντίων δεκτικόν.", "seq": 3480}
{"id": "Elias_Passim_3481", "series": "CAG", "text": "εἰ οὖν τὰ μαχόμενα περὶ ἓν ὑποκείμενον μάχονται, ὥς φησιν ὁ Πλωτῖνος (περὶ γὰρ τῶν τόπων ἡ μάχη) [δεῖ εἰδέναι ὅτι ὑποκείμενον νῦν λέγεται ὁ τόπος·", "seq": 3481}
{"id": "Elias_Passim_3482", "series": "CAG", "text": "ἕκαστον γὰρ ἐναντίον τόπον ἔχει ἴδιον, καὶ οὐδέποτε μάχονται τὰ ἐναντία πόρρω ἀφεστῶτα, ἀλλ᾿ ἁπτόμενα ἀλλήλων ἢ καὶ συμπλακέντα, καὶ ἐν ἑνὶ ὄντα τόπῳ μάχονται τί κρατήσει τοῦ τόπου·", "seq": 3482}
{"id": "Elias_Passim_3483", "series": "CAG", "text": "ἀδύνατον γὰρ ἀστασίαστα μένειν τἀναντία ἐν ἑνὶ ὄντα τόπῳ·", "seq": 3483}
{"id": "Elias_Passim_3484", "series": "CAG", "text": "ὑποκείμενον οὖν τὸν τόπον ἀκουστέον, ἐν ᾧ μάχονται τἀναντία, καὶ οὐ τὸ ἄποιον σῶμα], τὰ ἄρα μαχόμενα ἐν ὑποκειμένῳ·", "seq": 3484}
{"id": "Elias_Passim_3485", "series": "CAG", "text": "διὰ τὴν σὺν ἀντιθέσει <ἄρα> ἀντιστροφὴν ἐκ τοῦ ἑπομένου γενομένην τῷ μὴ ἐν ὑποκειμένῳ <ὅσα μὴ ἐν ὑποκειμένῳ ἐστίν, οὐκ ἔχει ἐναντίον ὡς τῆς ἀφορμῆς τοῦ μάχεσθαι ἀπηλλαγμένα·", "seq": 3485}
{"id": "Elias_Passim_3486", "series": "CAG", "text": "ἡ δὲ οὐσία οὐκ ἐν ὑποκειμένῳ>·", "seq": 3486}
{"id": "Elias_Passim_3487", "series": "CAG", "text": "οὐκοῦν τῇ οὐσίᾳ οὐκ ἔστιν ἐναντίον μαχόμενον.", "seq": 3487}
{"id": "Elias_Passim_3488", "series": "CAG", "text": "ἀλλὰ τοῦτο τὸ τέταρτον εἰρημένον ἴδιον πάσῃ μὲν ὑπάρχει τῇ οὐσίᾳ, οὐ μόνῃ δέ·", "seq": 3488}
{"id": "Elias_Passim_3489", "series": "CAG", "text": "οὐδὲ γὰρ ἀντιστρέφει ὁ λόγος·", "seq": 3489}
{"id": "Elias_Passim_3490", "series": "CAG", "text": "εἰ γὰρ καὶ πάντα τὰ μαχόμενα ἐν ὑποκειμένῳ, ἀλλ᾿ οὐ πάντα τὰ ἐν ὑποκειμένῳ μάχονται ἀλλήλοις·", "seq": 3490}
{"id": "Elias_Passim_3491", "series": "CAG", "text": "τῷ γὰρ σχήματι οὐδέν ἐστιν ἐναντίον (οὐ γάρ ἐστι τρίγωνον τριγώνῳ ἐναντίον οὐδὲ τετράγωνον τετραγώνῳ, ἐπεὶ μηδὲ τὸ μᾶλλον καὶ ἧττον δέχονται, εἴ γε τὸ τρίγωνον οὐ γίνεται ἑαυτοῦ μᾶλλον τρίγωνον ἢ ἧττον, ἀλλὰ μεῖζον μὲν λέγεται τρίγωνον τριγώνου, μᾶλλον δὲ τρίγωνον τριγώνου οὐκ ἔστιν εἰπεῖν, εἴ γε πᾶν τρίγωνον τὸν ὁρισμὸν τοῦ τριγώνου ἐπιδέχεται), οὐδὲ τοῖς μέσοις τῶν χρωμάτων, φαιῷ ἢ ξανθῷ·", "seq": 3491}
{"id": "Elias_Passim_3492", "series": "CAG", "text": "τὰ γὰρ ἐναντία τῇ πλείστῃ διαστάσει κρίνεται·", "seq": 3492}
{"id": "Elias_Passim_3493", "series": "CAG", "text": "πλεῖστον δὲ διέστηκεν οὐ τὸ μέσον τοῦ ἄκρου ἀλλὰ τὸ ἄκρον τοῦ ἄκρου.", "seq": 3493}
{"id": "Elias_Passim_3494", "series": "CAG", "text": "καὶ τῷ ὡρισμένῳ ποσῷ οὐδέν ἐστιν ἐναντίον, οἷον τῷ διπήχει ἢ τριπήχει.", "seq": 3494}
{"id": "Elias_Passim_3495", "series": "CAG", "text": "εἰ δὲ καὶ συγχωρήσομεν τῷ ἀορίστῳ ποσῷ εἶναι ἐναντίον, τὸ μικρὸν τῷ μεγάλῳ καὶ τὸ πολὺ τῷ ὀλίγῳ, δειχθήσεται ὅτι οὐδὲ τούτοις ἐστί τι ἐναντίον, διότι τὸ μέγα ἐκ μικρῶν πολλῶν συνέστηκε καὶ τὸ πολὺ ἐξ ὀλίγων πολλῶν·", "seq": 3495}
{"id": "Elias_Passim_3496", "series": "CAG", "text": "εἰ οὖν περιέχουσιν ἑαυτά, οὔκ εἰσιν ἐναντία συστατικὰ ὄντα ἑαυτῶν·", "seq": 3496}
{"id": "Elias_Passim_3497", "series": "CAG", "text": "τὰ δὲ ἐναντία ἀεὶ φθαρτικὰ ἀλλήλων καὶ οὐδέποτε συστατικά.", "seq": 3497}
{"id": "Elias_Passim_3498", "series": "CAG", "text": "ταῦτα ὁ Ἀριστοτέλης καὶ ἕτερον οὐδέν.", "seq": 3498}
{"id": "Elias_Passim_3499", "series": "CAG", "text": "Ἀποροῦσι δὲ τρία ἄπορα.", "seq": 3499}
{"id": "Elias_Passim_3500", "series": "CAG", "text": "πρῶτον μὲν πῶς λέγεται ἡ οὐσία μηδὲν ἔχειν ἐναντίον·", "seq": 3500}
{"id": "Elias_Passim_3501", "series": "CAG", "text": "ἐν γὰρ τῷ Περὶ γενέσεως καὶ φθορᾶς φησι τὰ στοιχεῖα μάχεσθαι ἀλλήλοις, τὸ πῦρ τῷ ὕδατι καὶ τὸν ἀέρα τῇ γῇ.", "seq": 3501}
{"id": "Elias_Passim_3502", "series": "CAG", "text": "καὶ λύει ὁ Ἀλέξανδρος λέγων ‘οὐ καθόλου ἑαυτοῖς μάχονται τὰ στοιχεῖα·", "seq": 3502}
{"id": "Elias_Passim_3503", "series": "CAG", "text": "οὐ δήπου γὰρ καὶ κατὰ τὸ σῶμα, ἀλλὰ ποιότης ποιότητι, θερμότης ψυχρότητι καὶ ὑγρότης ξηρότητι’.", "seq": 3503}
{"id": "Elias_Passim_3504", "series": "CAG", "text": "ὁ δὲ Συριανὸς ἐπικρίνας πλέον φησὶν ‘οὐδὲ κατὰ τὰς ποιότητας μάχονται, εἰ οὐσιώδεις ληφθεῖεν·", "seq": 3504}
{"id": "Elias_Passim_3505", "series": "CAG", "text": "οὐ γὰρ ἁμιλλᾶται ἡ θερμότης ψυχρότητί τινι, ἐὰν ἐν πυρὶ γένηται, ἢ ἐν ὕδατι ψυχρότης θερμότητι, ἐπεὶ ἦν ποτε εὑρεῖν καὶ πῦρ ψυχρόν.", "seq": 3505}
{"id": "Elias_Passim_3506", "series": "CAG", "text": "ἀλλὰ κἂν φθείρῃ ποιότης ποιότητα, ὡς ἐν ἀποίῳ σώματι δεῖ τότε αὐτὰς λαβεῖν·", "seq": 3506}
{"id": "Elias_Passim_3507", "series": "CAG", "text": "τότε γὰρ καὶ συμβεβηκότα εἰσὶ καὶ γίνονται καὶ ἀπογίνονται χωρὶς φθορᾶς τοῦ ὑποκειμένου.’", "seq": 3507}
{"id": "Elias_Passim_3508", "series": "CAG", "text": "δευτέρα ἀπορία·", "seq": 3508}
{"id": "Elias_Passim_3509", "series": "CAG", "text": "ὅτι εἰ τῇ οὐσίᾳ οὐδὲν ἐναντίον ἐστί, πῶς ὁ λόγος καὶ ὁ θυμὸς μάχονται ἀλλήλοις;", "seq": 3509}
{"id": "Elias_Passim_3510", "series": "CAG", "text": "οὐσίαι γὰρ ταῦτα·", "seq": 3510}
{"id": "Elias_Passim_3511", "series": "CAG", "text": "τρία γὰρ μέρη τῆς ψυχῆς, λόγος, θυμὸς καὶ ἐπιθυμία, καὶ μάχεται ὁ θυμὸς καὶ ὁ λόγος, ὥς φησιν ἡ Μήδεια", "seq": 3511}
{"id": "Elias_Passim_3512", "series": "CAG", "text": "θυμὸς δὲ κρείσσων τῶν ἐμῶν βουλευμάτων.", "seq": 3512}
{"id": "Elias_Passim_3513", "series": "CAG", "text": "καὶ λέγομεν ὅτι οὐ κατὰ τὰς οὐσίας ἡ μάχη, ἀλλὰ κατὰ τὰς ἐνεργείας·", "seq": 3513}
{"id": "Elias_Passim_3514", "series": "CAG", "text": "θυμὸς γὰρ καὶ λόγος οὐσίαι, τὸ δὲ θυμοῦσθαι καὶ λογίζεσθαι ἐνέργειαι (εἰ δὲ ἐπαπορεῖ τις λέγων ὅτι αἱ ἐναντίαι ἐνέργειαι ὑπὸ ἐναντίων δυνάμεων προβάλλονται, αἱ δὲ ἐναντίαι δυνάμεις ὑπ᾿ ἐναντίων οὐσιῶν, κακῶς λέγει·", "seq": 3514}
{"id": "Elias_Passim_3515", "series": "CAG", "text": "ἡ γὰρ αὐτὴ οὐσία ἐναντίας προβάλλεται ἐνεργείας, ὡς ἡ δόξα·", "seq": 3515}
{"id": "Elias_Passim_3516", "series": "CAG", "text": "αὐτὴ γὰρ τὸ ὅτι μόνον εἰδυῖα ποτὲ μὲν δοξάζει ὅτι ἡ ψυχὴ θνητή ἐστι, πεισθεῖσα δὲ ὑπὸ ἐπιστήμονος δοξάζει πάλιν τὸ ἀληθὲς ὅτι ἀθάνατος ἡ ψυχή)·", "seq": 3516}
{"id": "Elias_Passim_3517", "series": "CAG", "text": "καὶ ὅτι οὐδέποτε συσπένδονται τὰ ἐναντία·", "seq": 3517}
{"id": "Elias_Passim_3518", "series": "CAG", "text": "ὁ δὲ θυμὸς εἴκει ποτὲ τῷ λόγῳ, καθώς φησιν Ὀδυσσεὺς", "seq": 3518}
{"id": "Elias_Passim_3519", "series": "CAG", "text": "τέτλαθι δή, κραδίη·", "seq": 3519}
{"id": "Elias_Passim_3520", "series": "CAG", "text": "καὶ κύντερον ἄλλο ποτ᾿ ἔτλης.", "seq": 3520}
{"id": "Elias_Passim_3521", "series": "CAG", "text": "τρίτη ἀπορία·", "seq": 3521}
{"id": "Elias_Passim_3522", "series": "CAG", "text": "εἰ μή ἐστί τι ἐναντίον τῇ οὐσίᾳ, πῶς λέγομεν ἐχθροὺς τοὺς ἀνθρώπους, εἴ γε οἱ ἄνθρωποι οὐσίαι εἰσί;", "seq": 3522}
{"id": "Elias_Passim_3523", "series": "CAG", "text": "καὶ λέγομεν ὅτι οὐ καθὸ οὐσίαι μάχονται, ἀλλὰ συμβεβηκός τι ἐποίησεν αὐτοὺς ἐχθρούς, ἡ παροινία (αὕτη δὲ συμβαίνει, ἐπειδὴ καὶ ἡ γνῶσις αὐτὴ συμβαίνει), καὶ ὅτι οὐ συσπένδονταί ποτε τὰ ἐναντία, ὡς ἐπὶ πᾶν δὲ τὰς μεγίστας ἔχθρας μέγισται φιλίαι διαδέχονται, καὶ ὅτι ἑαυτοὺς ἐποίησαν συμβεβηκότα τῶν ἑαυτοῖς ὑπαρχόντων (ἔστι γὰρ αὐτῶν ἀκοῦσαι λεγόντων ὅτι ‘τὴν οὐσίαν μου ἥρπασας’), οὐσίαν καλοῦντες τὰ χρήματα καὶ ἑαυτοὺς συμβεβηκότα ποιοῦντες, καὶ οὐδὲ εὐτυχῆ συμβεβηκότα ἀλλὰ συμβεβηκότα συμβεβηκότων, τοῦτ᾿ ἔστι τῶν ἰδίων πραγμάτων.", "seq": 3523}
{"id": "Elias_Passim_3524", "series": "CAG", "text": "3b33 Δοκεῖ δὲ ἡ οὐσία οὐκ ἐπιδέχεσθαι τὸ μᾶλλον καὶ τὸ ἧττον.", "seq": 3524}
{"id": "Elias_Passim_3525", "series": "CAG", "text": "Τὸ τέταρτον ἴδιον τῆς οὐσίας, τὸ μηδὲν ἔχειν ἐναντίον, ἀπεκύει καὶ ἄλλο ἴδιον, τὸ μὴ ἐπιδέχεσθαι τὸ μᾶλλον καὶ τὸ ἧττον·", "seq": 3525}
{"id": "Elias_Passim_3526", "series": "CAG", "text": "τὰ γὰρ ἐναντία τέλη εἰσιν, <τὸ δὲ μᾶλλον καὶ ἧττον> ὁδὸς ἐπὶ τἀναντία.", "seq": 3526}
{"id": "Elias_Passim_3527", "series": "CAG", "text": "καὶ καλεῖ μὲν ἐναντία, φέρε εἰπεῖν, τὸ λευκὸν καὶ τὸ μέλαν, ἃ καὶ τέλη εἶναι λέγει, μᾶλλον δὲ καὶ ἧττον τὴν ἐκ τοῦ λευκοῦ εἰς τὸ μέλαν μεταβολὴν ἢ τοῦ μέλανος εἰς λευκόν, μὴ ἀθρόως γινομένην ἀλλ᾿ ὁδῷ τινι κεχρημένην, τῇ κατὰ πρόσβασιν ἐκ τοῦ λευκοῦ ἢ τοῦ μέλανος εἰς τὸ ἕτερον μεταποιήσει.", "seq": 3527}
{"id": "Elias_Passim_3528", "series": "CAG", "text": "ὅπου τοίνυν τὰ ἐναντία, ἐκεῖ καὶ τὸ μᾶλλον καὶ ἧττον, καὶ ὅπου τὸ μᾶλλον καὶ τὸ ἧττον, ἐκεῖ καὶ τἀναντία.", "seq": 3528}
{"id": "Elias_Passim_3529", "series": "CAG", "text": "καὶ πάλιν ὅπου τἀναντία οὐκ εἰσίν, οὐδὲ μᾶλλον οὐδὲ ἧττον, καὶ ὅπου οὐδὲ μᾶλλον οὐδὲ ἧττον, ἐκεῖ οὐδὲ ἐναντία εἰσίν·", "seq": 3529}
{"id": "Elias_Passim_3530", "series": "CAG", "text": "ἀεὶ γὰρ ταῦτα τὰ τέσσαρα συμβαίνει ἀλλήλοις τὰ εἰρημένα.", "seq": 3530}
{"id": "Elias_Passim_3531", "series": "CAG", "text": "ἀλλὰ ταῦτα ἀληθῆ καὶ κατὰ Πλάτωνα·", "seq": 3531}
{"id": "Elias_Passim_3532", "series": "CAG", "text": "<κατὰ γὰρ Πλάτωνα> πάντα ἔμμεσα λέγεται·", "seq": 3532}
{"id": "Elias_Passim_3533", "series": "CAG", "text": "οὐδὲν γὰρ ἀθρόως, φησί, μεταπηδᾷ ἀπὸ τοῦ ἐναντίου εἰς τὸ πάντως ἐναντίον, οἷον τὸ λευκὸν οὐκ ἀθρόως μεταπηδᾷ, ἀλλ᾿ ὁδῷ τινι κέχρηται καὶ γίνεται ἧττον λευκὸν καὶ ἔτι ἧττον καὶ ἧττον καὶ οὕτω μέλαν.", "seq": 3533}
{"id": "Elias_Passim_3534", "series": "CAG", "text": "κατὰ Ἀριστοτέλην δὲ οὐ πάντα ἔμμεσα τἀναντία, ἀλλ᾿ οἶδε καὶ ἄμεσα ἐναντία, εἰ καὶ δύο μόνα, ἄρτιον καὶ περιττὸν καὶ νόσον καὶ ὑγείαν.", "seq": 3534}
{"id": "Elias_Passim_3535", "series": "CAG", "text": "τινὲς δέ φασιν ὅτι καὶ τούτων εἰσὶ μέσα·", "seq": 3535}
{"id": "Elias_Passim_3536", "series": "CAG", "text": "τοῦ γὰρ ἀρτίου τοῦ δίχα διαιρουμένου μέσα τρία, ὁ ἀρτιάκις ἄρτιος, ὅστις ἕως μονάδος δίχα διαιρεῖται, ὡς ὁ τριάκοντα δύο εἰς δεκαὲξ καὶ ὀκτὼ καὶ τέσσαρα καὶ δύο καὶ μίαν, καὶ ὁ περισσάρτιος, ὅστις πολλὰς τομὰς ἀρτίας δεξάμενος εἰς περιττὸν ἀριθμὸν λήγει, ὡς ὁ τεσσαράκοντα ὀκτὼ εἰς εἴκοσι τέτταρα καὶ δώδεκα καὶ ἓξ καὶ εἰς περιττὸν λήγει τὸν τρία, καὶ ὁ ἀρτιοπέριττος, ὃς δίχα μὲν διαιρεῖται, εὐθέως δὲ τὰ τμήματα αὐτοῦ περιττά εἰσιν, ὡς ὁ ὀκτὼ καὶ δέκα εἰς ἐννέα καὶ ἐννέα διαιρούμενος.", "seq": 3536}
{"id": "Elias_Passim_3537", "series": "CAG", "text": "ἀλλὰ τούτων μὲν τῶν ἀριθμῶν, φημὶ ἀρτίου καὶ περιττοῦ, μέσοι, ὥς φασιν, οἱ εἰρημένοι, νόσου δὲ καὶ ὑγείας ἡ ἀνακομιδή.", "seq": 3537}
{"id": "Elias_Passim_3538", "series": "CAG", "text": "ὁ δὲ Ἀριστοτέλης εἰκότως φαίη ἂν πρὸς τούτους ὅτι ἁπλῶς ἀρτίου καὶ ἁπλῶς περιττοῦ οὐδείς ἐστι μέσος, ὑμεῖς δὲ τινὰ ἄρτιον ἐλάβετε·", "seq": 3538}
{"id": "Elias_Passim_3539", "series": "CAG", "text": "ὁ γὰρ ἀρτιάκις ἄρτιος τὶς ἄρτιός ἐστιν, οὐχ ἁπλῶς ἄρτιος.", "seq": 3539}
{"id": "Elias_Passim_3540", "series": "CAG", "text": "καὶ νόσου καὶ ὑγείας οὐδέν ἐστι μέσον·", "seq": 3540}
{"id": "Elias_Passim_3541", "series": "CAG", "text": "εἰ γὰρ καὶ νομίζεται εἶναι μέσον ἡ ἀνακόμισις κατὰ τοὺς ἰατρούς, οἳ τῷ πρὸς αἴσθησιν κατὰ φύσιν καὶ παρὰ φύσιν ἐξετάζοντες ὑγείαν καὶ νόσον λέγουσι μέσην τὴν ἀνακόμισιν, ἀλλ᾿ ὁ Ἀριστοτέλης τῷ ἀκριβεῖ κατὰ φύσιν καὶ παρὰ φύσιν κρίνων τὴν ὑγείαν καὶ τὴν νόσον οὐδὲν λέγει μέσον αὐτῶν εἶναι.", "seq": 3541}
{"id": "Elias_Passim_3542", "series": "CAG", "text": "ταῦτα ὁ Ἀριστοτέλης.", "seq": 3542}
{"id": "Elias_Passim_3543", "series": "CAG", "text": "Ἔξωθεν δὲ ἀποροῦσιν ὅτι ἀνωτέρω ἔλεγεν ὅτι ἡ οὐσία ἐπιδέχεται τὸ μᾶλλον καὶ τὸ ἧττον, νῦν δὲ λέγει ὅτι οὐκ ἐπιδέχεται.", "seq": 3543}
{"id": "Elias_Passim_3544", "series": "CAG", "text": "καὶ λύομεν τὴν ἀπορίαν οὕτως·", "seq": 3544}
{"id": "Elias_Passim_3545", "series": "CAG", "text": "ὅτι καὶ ἐπιδέχεται καὶ οὔ·", "seq": 3545}
{"id": "Elias_Passim_3546", "series": "CAG", "text": "αὐτὴ γὰρ πρὸς ἑαυτὴν παραβαλλομένη οὐ λέγεται μᾶλλον καὶ ἧττον (ἄνθρωπος γὰρ ἀνθρώπου οὐ λέγεται μᾶλλον ἄνθρωπος, οὐδὲ αὐτὸς ἑαυτοῦ), ἡ μέντοι ἄτομος οὐσία πρὸς τὰς γενικὰς καὶ εἰδικὰς παραβαλλομένη μᾶλλον οὐσία ἐστί.", "seq": 3546}
{"id": "Elias_Passim_3547", "series": "CAG", "text": "δευτέρα ἀπορία·", "seq": 3547}
{"id": "Elias_Passim_3548", "series": "CAG", "text": "ὅτι πῶς ὁ Ἀριστοτέλης ἀεὶ ἔθος ἔχων ἐν τῇ ἀποδόσει τῶν ἰδίων τῆς οὐσίας λέγειν εἴ τε μόνῃ ὑπάρχει ἢ οὐ μόνῃ καὶ εἰ πάσῃ ἢ οὐ πάσῃ, νῦν οὐδενὸς τούτων ἐμνήσθη;", "seq": 3548}
{"id": "Elias_Passim_3549", "series": "CAG", "text": "καὶ λέγομεν λύσιν τοιαύτην·", "seq": 3549}
{"id": "Elias_Passim_3550", "series": "CAG", "text": "ὅτι ὡς συνεπικριθὲν αὐτὸ ἔχομεν τῷ πρὸ τούτου ἰδίῳ, νῦν παρῆκεν αὐτό·", "seq": 3550}
{"id": "Elias_Passim_3551", "series": "CAG", "text": "εἰ γὰρ τῷ μηδὲν ἔχειν ἐναντίον, ὅπερ ἦν πρὸ τούτου ἴδιον, ἕπεται τὸ μὴ δέχεσθαι τὸ μᾶλλον καὶ τὸ ἧττον, ἐκεῖνο δὲ οὐ μόνῃ τῇ οὐσίᾳ ὑπῆρχεν, οὐδὲ τοῦτο μόνῃ τῇ οὐσίᾳ ὑπάρχει, ἀλλὰ καὶ τῷ ποσῷ·", "seq": 3551}
{"id": "Elias_Passim_3552", "series": "CAG", "text": "τὸ γὰρ τρίπηχυ ἢ τετράπηχυ οὐκ ἐπιδέχεται τὸ μᾶλλον καὶ τὸ ἧττον, οὐδὲ τὸ πέντε ἢ τὸ δέκα.", "seq": 3552}
{"id": "Elias_Passim_3553", "series": "CAG", "text": "τρίτη ἀπορία·", "seq": 3553}
{"id": "Elias_Passim_3554", "series": "CAG", "text": "εἰ τὸ μᾶλλον καὶ ἧττον οὐκ ἐπιδέχεται ἡ οὐσία, πῶς ὁ Ἀριστοτέλης ἐν τῷ Περὶ γενέσεως καὶ φθορᾶς λέγει τὸν ἀέρα ἧττον θερμὸν ὡς πρὸς πῦρ, οὐσίαι δὲ ταῦτα;", "seq": 3554}
{"id": "Elias_Passim_3555", "series": "CAG", "text": "καὶ λύει ὁ Ἀλέξανδρος λέγων ὅτι οὐ καθὸ οὐσίαι τὸ μᾶλλον καὶ τὸ ἧττον ἐπιδέχονται, ἀλλὰ κατὰ τὰς ποιότητας.", "seq": 3555}
{"id": "Elias_Passim_3556", "series": "CAG", "text": "ὁ δὲ Συριανὸς ὅτι οὐδὲ κατὰ τὰς ποιότητας τὸ μᾶλλον καὶ τὸ ἧττον ἐπιδέχονται, ἐὰν οὐσιώδεις ληφθῶσιν·", "seq": 3556}
{"id": "Elias_Passim_3557", "series": "CAG", "text": "ἑκάστη γὰρ πλείστη ἐστὶν ἐν τῷ οἰκείῳ ὑποκειμένῳ, καὶ οὐ τῷ μᾶλλον καὶ ἧττον διαφέρουσιν·", "seq": 3557}
{"id": "Elias_Passim_3558", "series": "CAG", "text": "εἰδοπεποίηνται γὰρ ταῦτα καὶ ὑφέσεις εἰδῶν εἰσιν.", "seq": 3558}
{"id": "Elias_Passim_3559", "series": "CAG", "text": "ἢ καὶ ἄλλως·", "seq": 3559}
{"id": "Elias_Passim_3560", "series": "CAG", "text": "ὅτι τὸ ἧττον ὅπερ τὸ μᾶλλον γινόμενον οὐκ ἐξέστη τοῦ οἰκείου εἴδους, ὁ δὲ ἀὴρ ἀμετρίαν πυρίας θερμότητος ἐπιδεξάμενος ἀπώλεσε τὸ ἀὴρ εἶναι.", "seq": 3560}
{"id": "Elias_Passim_3561", "series": "CAG", "text": "4a10 Μάλιστα δὲ ἴδιον τῆς οὐσίας δοκεῖ εἶναι τὸ ταὐτὸν καὶ ἓν ἀριθμῷ ὂν τῶν ἐναντίων εἶναι δεκτικόν.", "seq": 3561}
{"id": "Elias_Passim_3562", "series": "CAG", "text": "Ἕκτον ἴδιον τῆς οὐσίας τὸ μίαν καὶ τὴν αὐτὴν οὖσαν τῷ ἀριθμῷ δεκτικὴν εἶναι τῶν ἐναντίων παρὰ μέρος.", "seq": 3562}
{"id": "Elias_Passim_3563", "series": "CAG", "text": "καὶ καλῶς πρόσκειται τὸ παρὰ μέρος, ἐπειδὴ οὐχ ἅμα λευκαίνεται καὶ μελαίνεται ὁ Σωκράτης, οὐδὲ ἅμα νοσεῖ καὶ ὑγιαίνει.", "seq": 3563}
{"id": "Elias_Passim_3564", "series": "CAG", "text": "τὸ δὲ μίαν καὶ τὴν αὐτὴν τῷ ἀριθμῷ καλῶς πρόσκειται, ἐπειδὴ καὶ ὁ ἀριθμὸς δέχεται τἀναντία, ἄρτιον καὶ περιττόν, ἀλλ᾿ οὐχ εἷς τῷ ἀριθμῷ, ἀλλ᾿ εἷς τῷ εἴδει.", "seq": 3564}
{"id": "Elias_Passim_3565", "series": "CAG", "text": "ἄλλως τε δὲ οὐδὲ ὡς ἐν ἀριθμῷ συνίσταται τὸ ἄρτιον καὶ περιττόν, ἀλλ᾿ ὡς ἐν ὕλῃ τῇ δυναμένῃ καὶ εἰς ἄρτιον καὶ εἰς περιττὸν διαιρεῖσθαι·", "seq": 3565}
{"id": "Elias_Passim_3566", "series": "CAG", "text": "ὕλης γὰρ ἴδιον τὸ ἄλλοτε ἄλλο εἶδος δέχεσθαι καὶ εἰδοποιεῖσθαι.", "seq": 3566}
{"id": "Elias_Passim_3567", "series": "CAG", "text": "τὸ ἄρτιον τοίνυν καὶ τὸ περιττὸν εἴδη νοείσθωσαν.", "seq": 3567}
{"id": "Elias_Passim_3568", "series": "CAG", "text": "οὐκοῦν ὁ ἀριθμὸς ὕλῃ ἀναλογεῖ δεχόμενος τὰ εἴδη ταῦτα καὶ ποτὲ μὲν ἄρτιος ποτὲ δὲ περιττὸς γινόμενος.", "seq": 3568}
{"id": "Elias_Passim_3569", "series": "CAG", "text": "κἀπὶ τῶν λοιπῶν παραδειγμάτων ἀναλόγως νοητέον τὸ εἰρημένον·", "seq": 3569}
{"id": "Elias_Passim_3570", "series": "CAG", "text": "τὸ γὰρ πηχυαῖον ξύλον καὶ εἰς ἄρτιον διαιρεῖται καὶ εἰς περιττόν.", "seq": 3570}
{"id": "Elias_Passim_3571", "series": "CAG", "text": "καὶ οἱ ἄρτιοι δὲ ἵπποι δύνανται καὶ περιττοὶ γενέσθαι ἑτέρου προσθήκῃ.", "seq": 3571}
{"id": "Elias_Passim_3572", "series": "CAG", "text": "ἀλλὰ καὶ τὸ χρῶμα εἰ καὶ δέχεται τἀναντία, οἷον λευκὸν καὶ μέλαν, ἀλλ᾿ οὐχ ἓν τῷ ἀριθμῷ ὄν, ἀλλὰ τῷ εἴδει ἕν.", "seq": 3572}
{"id": "Elias_Passim_3573", "series": "CAG", "text": "τοῦτο δὲ τὸ ἴδιον μόνῃ τῇ οὐσίᾳ ὑπάρχει διὰ τοιοῦτον λόγον·", "seq": 3573}
{"id": "Elias_Passim_3574", "series": "CAG", "text": "τὸ τῶν ἐναντίων δεκτικὸν συμβεβηκότων ἐστὶ δεκτικόν (πάντα γὰρ τἀναντία συμβεβηκότα), τὸ συμβεβηκότων δεκτικὸν συμβεβηκόσιν ὑπόκειται, τὸ συμβεβηκόσιν ὑποκείμενον οὐσία ἐστί, μόνῃ ἄρα <τῇ> οὐσίᾳ ὑπάρχει τοῦτο.", "seq": 3574}
{"id": "Elias_Passim_3575", "series": "CAG", "text": "οὐ πάσῃ δέ·", "seq": 3575}
{"id": "Elias_Passim_3576", "series": "CAG", "text": "αἱ γὰρ δεύτεραι οὐσίαι ἄτρεπτοι οὖσαι οὐ δέχονται τἀναντία.", "seq": 3576}
{"id": "Elias_Passim_3577", "series": "CAG", "text": "ἀλλ᾿ οὐδὲ πάσαις ταῖς ἀτόμοις τοῦτο ὑπάρχει·", "seq": 3577}
{"id": "Elias_Passim_3578", "series": "CAG", "text": "τὰ γὰρ οὐράνια ἄτρεπτα ὄντα οὐ δέχονται τἀναντία.", "seq": 3578}
{"id": "Elias_Passim_3579", "series": "CAG", "text": "ἀλλ᾿ οὐδὲ πᾶσαι αἱ ἐνταῦθα ἄτομοι οὐσίαι ἐπιδέχονται τἀναντία, ὥς τινες ὑπέλαβον τὸν κύκνον, εἰ τύχοι, κατὰ τὸ λευκὸν μὴ μεταβάλλοντα.", "seq": 3579}
{"id": "Elias_Passim_3580", "series": "CAG", "text": "πρὸς οὓς ῥητέον ὅτι εἰ καὶ τὴν ἐναντιότητα ταύτην μὴ ἐπιδέχεται, ἀλλ᾿ οὖν ἑτέραν δέχεται, τὴν κατὰ τὸ θερμὸν καὶ ψυχρὸν καὶ ὑγρὸν καὶ ξηρόν.", "seq": 3580}
{"id": "Elias_Passim_3581", "series": "CAG", "text": "ταῦτα ἐν τούτοις.", "seq": 3581}
{"id": "Elias_Passim_3582", "series": "CAG", "text": "Ἀπορεῖ δὲ πρὸς ἑαυτὸν ὁ Ἀριστοτέλης ὅτι οὐ μόνῃ <τῇ> οὐσίᾳ ὑπάρχει τοῦτο·", "seq": 3582}
{"id": "Elias_Passim_3583", "series": "CAG", "text": "δοκεῖ γὰρ καὶ ὁ λόγος καὶ ἡ δόξα ἐπιδέχεσθαι τἀναντία, ὧν ὁ μὲν λόγος ποσὸν ἡ δὲ δόξα ποιόν, ἄμφω δὲ λόγοι, ἀλλ᾿ ὁ μὲν προφορικὸς ὁ δὲ ἐνδιάθετος·", "seq": 3583}
{"id": "Elias_Passim_3584", "series": "CAG", "text": "ὁ γὰρ λόγος ὁ εἰπὼν ὅτι ‘Σωκράτης κάθηται’ ἀληθεύει μὲν καθημένου, ψεύδεται δὲ ἀναστάντος.", "seq": 3584}
{"id": "Elias_Passim_3585", "series": "CAG", "text": "ὁμοίως καὶ ἐπὶ τῆς δόξης ἔχει.", "seq": 3585}
{"id": "Elias_Passim_3586", "series": "CAG", "text": "καὶ λύει αὐτὸς καὶ κατὰ ἔνστασιν καὶ κατὰ ἀντιπαράστασιν.", "seq": 3586}
{"id": "Elias_Passim_3587", "series": "CAG", "text": "καὶ ἄρχεται ἀπὸ τῆς ἀντιπαραστάσεως ὡς συμβαλλομένης πρὸς τὴν ἔνστασιν.", "seq": 3587}
{"id": "Elias_Passim_3588", "series": "CAG", "text": "ἔχει δὲ οὕτως·", "seq": 3588}
{"id": "Elias_Passim_3589", "series": "CAG", "text": "εἰ καὶ δῶμεν ὅτι καὶ ἡ δόξα καὶ ὁ λόγος ἐπιδέχεται τἀναντία, ἀλλ᾿ ὁ τρόπος τῆς ὑποδοχῆς διάφορος·", "seq": 3589}
{"id": "Elias_Passim_3590", "series": "CAG", "text": "ἡ μὲν γὰρ οὐσία κατὰ τὴν ἑαυτῆς μεταβολὴν δέχεται τἀναντία, ὁ δὲ λόγος καὶ ἡ δόξα αὐτὰ μὲν ἀκίνητα πάντῃ τε καὶ πάντως διαμένει, τοῦ δὲ πράγματος μεταβάλλοντος λέγεται αὐτὰ μεταβάλλειν δίκην τοῦ δεξιοῦ γενομένου ἀριστεροῦ τῇ τοῦ ἑτέρου μεταστάσει.", "seq": 3590}
{"id": "Elias_Passim_3591", "series": "CAG", "text": "δεῖται οὖν προσδιορισμοῦ ὁ λόγος·", "seq": 3591}
{"id": "Elias_Passim_3592", "series": "CAG", "text": "δεῖ γὰρ προσθεῖναι κατὰ τὴν οἰκείαν ἑαυτῆς μεταβολήν, ὡς εἶναι τὸν λόγον τοιοῦτον·", "seq": 3592}
{"id": "Elias_Passim_3593", "series": "CAG", "text": "ὅτι μία καὶ ἡ αὐτὴ οὖσα τῷ ἀριθμῷ ἡ οὐσία δεκτική ἐστι τῶν ἐναντίων παρὰ μέρος κατὰ τὴν οἰκείαν ἑαυτῆς μεταβολήν.", "seq": 3593}
{"id": "Elias_Passim_3594", "series": "CAG", "text": "ἔστι δὲ καὶ ἄλλως λῦσαι τὴν ἀπορίαν ταύτην, ὅτι οὐ διέμεινεν ὁ αὐτὸς λόγος·", "seq": 3594}
{"id": "Elias_Passim_3595", "series": "CAG", "text": "ἄλλος γάρ ἐστιν ὁ εἰπὼν ὅτι ‘Σωκράτης κάθηται’ καὶ ἄλλος ὁ εἰπὼν ὅτι ‘Σωκράτης οὐ κάθηται’ ἀναστάντος αὐτοῦ·", "seq": 3595}
{"id": "Elias_Passim_3596", "series": "CAG", "text": "ὁ γὰρ λόγος ἅμα ἐρρήθη καὶ οὐκ ἔστιν·", "seq": 3596}
{"id": "Elias_Passim_3597", "series": "CAG", "text": "οὐδὲ γὰρ ἀναμένει τὴν τοῦ πράγματος μεταβολήν, ἵνα ἀληθεύσῃ ἢ ψεύσηται.", "seq": 3597}
{"id": "Elias_Passim_3598", "series": "CAG", "text": "ὁμοίως δὲ καὶ ἡ δόξα ἄλλη ἐστὶν ἡ κατὰ προχείρισιν ἡ λέγουσα ‘Σωκράτης κάθηται’ καὶ ἄλλη πάλιν προχειρίζεται ἡ λέγουσα ὅτι ‘Σωκράτης’, ἀναστάντος αὐτοῦ, ‘οὐ κάθηται’.", "seq": 3598}
{"id": "Elias_Passim_3599", "series": "CAG", "text": "εἰ δὲ καὶ δῶμεν ὅτι ἡ δόξα ἐπιδέχεται ἀλήθειαν καὶ ψεῦδος, ἀλλ᾿ οὐχὶ ἡ δόξα καθ᾿ ἑαυτὴν ἀληθεύει ἢ ψεύδεται, ἀλλ᾿ ἡ ψυχὴ κατὰ τὴν δόξαν·", "seq": 3599}
{"id": "Elias_Passim_3600", "series": "CAG", "text": "οὐ γὰρ ἡ δόξα καθ᾿ ἑαυτὴν δοξάζει, ἀλλ᾿ ἡ ψυχὴ τῇ δόξῃ δοξάζει·", "seq": 3600}
{"id": "Elias_Passim_3601", "series": "CAG", "text": "ὥσπερ γὰρ οὐ λέγομεν τὴν χεῖρα ὑφαίνειν ἀλλὰ τὸν ἄνθρωπον τῇ χειρί, οὕτως οὐδὲ ἡ δόξα δοξάζει ἀλλ᾿ ἡ ψυχὴ τῇ δόξῃ δοξάζει.", "seq": 3601}
{"id": "Elias_Passim_3602", "series": "CAG", "text": "αὕτη ἡ ἀντιπαράστασις.", "seq": 3602}
{"id": "Elias_Passim_3603", "series": "CAG", "text": "ἡ δὲ ἔνστασις τῆς ἀντιπαραστάσεως λαβομένη τῆς λεγούσης ὅτι ὁ λόγος καὶ ἡ δόξα ἀκίνητα μένει, ἀλλὰ τῇ τοῦ πράγματος περὶ οὐσίαν μεταβολῇ δεκτικὰ γίνεται τῶν ἐναντίων, φησὶν ὅτι οὐ δέχονται τἀναντία·", "seq": 3603}
{"id": "Elias_Passim_3604", "series": "CAG", "text": "οὐδὲν γὰρ αὐτὸ μὴ μεταβάλλον δύναται τἀναντία δέξασθαι, ἐπεὶ τί κωλύει τἀναντία συνυπάρχειν ἀλλήλοις, οἷον λευκότητα καὶ μελανίαν ἐν ἑνὶ ὑποκειμένῳ;", "seq": 3604}
{"id": "Elias_Passim_3605", "series": "CAG", "text": "καὶ ἔστι τελεωτέρα ἡ ἔνστασις τῆς ἀντιπαραστάσεως, ὅτι προσδιορισμοῦ οὐκ ἐδεήθη.", "seq": 3605}
{"id": "Elias_Passim_3606", "series": "CAG", "text": "καὶ ταῦτα μὲν ἐν τούτοις.", "seq": 3606}
{"id": "Elias_Passim_3607", "series": "CAG", "text": "Εἰκότως δὲ ἀπορήσει τις πρὸς τὸν Ἀριστοτέλην ὅτι ‘τί φῄς, Ἀριστότελες;", "seq": 3607}
{"id": "Elias_Passim_3608", "series": "CAG", "text": "ὁ λόγος οὐκ ἐπιδέχεται ἀλήθειαν καὶ ψεῦδος;’", "seq": 3608}
{"id": "Elias_Passim_3609", "series": "CAG", "text": "καὶ φαίη ἂν ὁ Ἀριστοτέλης ὅτι οὐδὲ ὁ λόγος ἀληθεύει καὶ ψεύδεται ἅμα οὐδὲ τὸ πρᾶγμα μόνον, ἀλλ᾿ ἡ συμπλοκὴ τοῦ λόγου καὶ τοῦ πράγματος·", "seq": 3609}
{"id": "Elias_Passim_3610", "series": "CAG", "text": "ἡ γὰρ συμφωνία τῶν δύο ποιεῖ τἀληθές, ἡ δὲ ἀσυμφωνία τὸ ψεῦδος·", "seq": 3610}
{"id": "Elias_Passim_3611", "series": "CAG", "text": "ὡς γὰρ τὸ ὑποδεδέσθαι οὐκ ἐν τῷ ποδὶ μόνον οὐδὲ ἐν τῷ ὑποδήματι μόνον, ἀλλ᾿ ἐν τῇ ἐφαρμογῇ τοῦ ποδὸς πρὸς τὸ ὑπόδημα, οὕτω καὶ ἐπὶ λόγου καὶ πράγματος ἔχει.", "seq": 3611}
{"id": "Elias_Passim_3612", "series": "CAG", "text": "Ἀποροῦσι δέ τινες τέσσαρας ἀπορίας, πρώτην μὲν ὅτι ‘πῶς λέγεις, ὦ Ἀριστότελες, ὅτι ἡ οὐσία μόνη ἐπιδέχεται τἀναντία;", "seq": 3612}
{"id": "Elias_Passim_3613", "series": "CAG", "text": "ἰδοὺ γὰρ καὶ ἡ γραμμὴ ἐπιδέχεται εὐθύτητα καὶ καμπυλότητα’.", "seq": 3613}
{"id": "Elias_Passim_3614", "series": "CAG", "text": "πρὸς ὅ φαμεν ὅτι ποία γραμμή;", "seq": 3614}
{"id": "Elias_Passim_3615", "series": "CAG", "text": "εἰ μὲν ἡ μαθηματική, τοῦτ᾿ ἔστιν ἡ ἐπινοίᾳ λαμβανομένη, αὕτη ἄλλοτε ἄλλη ἐπινοεῖται.", "seq": 3615}
{"id": "Elias_Passim_3616", "series": "CAG", "text": "εἰ δὲ ἡ φυσική, ἡ ὕλη κατὰ τὴν γραμμὴν ἐδέξατο.", "seq": 3616}
{"id": "Elias_Passim_3617", "series": "CAG", "text": "ἔτι ἡ δευτέρα ἀπορία·", "seq": 3617}
{"id": "Elias_Passim_3618", "series": "CAG", "text": "ὅτι ‘ἰδοὺ ἡ αὐτὴ πρᾶξις, οἷον ἡ ἀκρατής, καὶ φαύλη ὡς πρὸς τὸν σπουδαῖον καὶ ἐπαινετὴ ὡς πρὸς τὸν ἀκόλαστον’.", "seq": 3618}
{"id": "Elias_Passim_3619", "series": "CAG", "text": "καὶ ἔστιν ἡ λύσις ὅτι αὕτη ὡς ἐν τῷ αὐτῷ νῦν ἀμφότερα ἔχουσα δεδεγμένη ἐστὶ τἀναντία, ἐκεῖ δὲ πρόσκειται τὸ δεκτική, καὶ ὅτι πρὸς ἄλλο καὶ ἄλλο παραβαλλομένη τἀναντία δοκεῖ ἔχειν, οὐ καθ᾿ αὑτήν, διὸ καὶ δυνάμει, οὐκ ἐνεργείᾳ.", "seq": 3619}
{"id": "Elias_Passim_3620", "series": "CAG", "text": "τρίτη ἀπορία·", "seq": 3620}
{"id": "Elias_Passim_3621", "series": "CAG", "text": "ὅτι ‘πῶς ἡ αὐτὴ κίνησις ἐπιδέχεται καὶ ταχυτῆτα καὶ βραδυτῆτα;’", "seq": 3621}
{"id": "Elias_Passim_3622", "series": "CAG", "text": "καὶ λέγομεν ὅτι οὐχ ἡ μία τῷ ἀριθμῷ·", "seq": 3622}
{"id": "Elias_Passim_3623", "series": "CAG", "text": "ἄλλη γὰρ ἡ ταχεῖα καὶ ἄλλη ἡ βραδεῖα.", "seq": 3623}
{"id": "Elias_Passim_3624", "series": "CAG", "text": "τετάρτη ἀπορία ‘πῶς ὁ χρόνος’, φησίν, ‘ἐπιδέχεται φῶς καὶ σκότος καὶ ἡμέραν καὶ νύκτα;’", "seq": 3624}
{"id": "Elias_Passim_3625", "series": "CAG", "text": "καὶ λέγομεν ὅτι οὐχ ὁ χρόνος ἀλλ᾿ ὁ ἀήρ ἐστιν ὁ ταῦτα ἐπιδεχόμενος.", "seq": 3625}
{"id": "Elias_Passim_3626", "series": "CAG", "text": "ὁ δὲ ἀὴρ οὐσία ἐστί.", "seq": 3626}
{"id": "Elias_Passim_3627", "series": "CAG", "text": "ταῦτα καὶ περὶ οὐσίας.", "seq": 3627}
{"id": "Elias_Passim_3628", "series": "CAG", "text": "ἐν οἷς σὺν θεῷ καὶ ἡ παροῦσα πρᾶξις.", "seq": 3628}
{"id": "Elias_Passim_3629", "series": "CAG", "text": "Περὶ ποσοῦ.", "seq": 3629}
{"id": "Elias_Passim_3630", "series": "CAG", "text": "4b20 Τοῦ δὲ ποσοῦ τὸ μέν ἐστι διωρισμένον τὸ δὲ συνεχές.", "seq": 3630}
{"id": "Elias_Passim_3631", "series": "CAG", "text": "Μετὰ τὴν οὐσίαν περὶ ποσοῦ διαλαμβάνει ὁ Ἀριστοτέλης.", "seq": 3631}
{"id": "Elias_Passim_3632", "series": "CAG", "text": "ἓξ δέ τινα δεῖ ζητῆσαι ἐπὶ τῆς παρούσης κατηγορίας, πρῶτον μὲν τὴν τάξιν αὐτοῦ τὴν πρὸς τὴν οὐσίαν, δεύτερον εἰ γένος τὸ ποσὸν συνεχοῦς καὶ διωρισμένου, τρίτον εἰ τούτων ἐστὶ μόνων γένος ἢ καὶ τῆς ῥοπῆς, ὥς φησι Πλάτων καὶ Ἀρχύτας καὶ Πτολεμαῖος ὁ ἀστρονόμος, τέταρτον τί ἐστι συνεχὲς καὶ τί διωρισμένον, πέμπτον εἰ ὑγιῶς ἔχει ἡ διαίρεσις τοῦ διωρισμένου, ἕκτον εἰ ὑγιῶς ἔχει ἡ διαίρεσις τοῦ συνεχοῦς.", "seq": 3632}
{"id": "Elias_Passim_3633", "series": "CAG", "text": "ὧν ἓξ ἡ παροῦσα θεωρία τὰ <πρῶτα> δύο ζητήσει, <πρῶτον> τίς ἡ τάξις, τοῦτ᾿ ἔστιν ὅτι διὰ τί μετὰ τὴν οὐσίαν περὶ ποσοῦ διαλαμβάνει.", "seq": 3633}
{"id": "Elias_Passim_3634", "series": "CAG", "text": "καὶ λέγομεν τούτου ἓξ αἰτίας, πρώτην ὅτι ἡ οὐσία δύο ἑαυτῆς ἰδίοις τῷ ποσῷ κοινωνοῦσα, τῷ μηδὲν ἔχειν ἐναντίον καὶ μὴ ἐπιδέχεσθαι τὸ μᾶλλον καὶ ἧττον, κατ᾿ ἄμφω ταῦτα τοῦ ποιοῦ διαφέρει·", "seq": 3634}
{"id": "Elias_Passim_3635", "series": "CAG", "text": "τῷ γὰρ ποιῷ οὐδὲν τούτων ὑπάρχει·", "seq": 3635}
{"id": "Elias_Passim_3636", "series": "CAG", "text": "εἰ οὖν κοινωνεῖ τὸ ποσὸν τῇ οὐσίᾳ, τὰ δὲ κοινωνοῦντα δεῖ πλησίον ἀλλήλων εἶναι, εἰκότως μετὰ τὴν οὐσίαν περὶ ποσοῦ διαλέγεται.", "seq": 3636}
{"id": "Elias_Passim_3637", "series": "CAG", "text": "δευτέρα αἰτία, ὅτι ἡ ὕλη ἀνείδεος οὖσα καὶ ἄποιος πρότερον ποσοῦται καὶ εἶθ᾿ οὕτως ποιοῦται.", "seq": 3637}
{"id": "Elias_Passim_3638", "series": "CAG", "text": "τρίτη, ὅτι ἡ ὕλη τὸ μὲν ποιὸν ἴσχυσε διαφυγεῖν (ἄποιος γάρ), τὸ δὲ ποσὸν οὐ διέφυγε·", "seq": 3638}
{"id": "Elias_Passim_3639", "series": "CAG", "text": "μία γὰρ τῷ ἀριθμῷ, τὸ δὲ μία καὶ τὸ ἓν κατὰ Ἀριστοτέλην ποσά.", "seq": 3639}
{"id": "Elias_Passim_3640", "series": "CAG", "text": "τετάρτη, ὅπερ δεύτερον δεῖ λεχθῆναι ἐν ταῖς αἰτίαις, ὅτι ἔδει πληρωθῆναι τὸν περὶ πολλοῦ καὶ ὀλίγου λόγον καὶ μικροῦ καὶ μεγάλου, παρέλκοντα μὲν ἐν τῷ περὶ τῆς οὐσίας λόγῳ (ἐκεῖ γὰρ μέμνηται αὐτῶν), νῦν δὲ κατεπείγοντα.", "seq": 3640}
{"id": "Elias_Passim_3641", "series": "CAG", "text": "εἰ δὲ ἀπορήσεις λέγων ὅτι ‘καὶ ποιότητος ἐμνήσθη ἐν τῇ οὐσίᾳ καὶ πρὸ τοῦ ποσοῦ, ὅτε ἔλεγεν ὅτι αἱ δεύτεραι οὐσίαι τοιόνδε τι καὶ ποιότητα σημαίνουσι, καὶ διὰ τί μὴ τὸ ποιὸν τοῦ ποσοῦ προέταξεν;’", "seq": 3641}
{"id": "Elias_Passim_3642", "series": "CAG", "text": ", ἐρῶ σοι κἀγὼ ὅτι ποιότητος ἐμνήσθη, οὐ τῆς νῦν προκειμένης τῆς ποιούσης μίαν κατηγορίαν τοῦ συμβεβηκότος, ἀλλὰ ποιότητος οὐσιώδους·", "seq": 3642}
{"id": "Elias_Passim_3643", "series": "CAG", "text": "περὶ γὰρ οὐσίαν τὸ ποιὸν ἀφορίζουσιν αἱ δεύτεραι οὐσίαι.", "seq": 3643}
{"id": "Elias_Passim_3644", "series": "CAG", "text": "πέμπτη αἰτία, ὅτι ἔδει περὶ ποσοῦ διαλαβεῖν μετὰ τὴν οὐσίαν, ἐπειδὴ καὶ ἡ οὐσία τὸ πρῶτον καὶ δεύτερον ἐπιδέχεται, τὸ δὲ πρῶτον καὶ δεύτερον τοῦ ποσοῦ.", "seq": 3644}
{"id": "Elias_Passim_3645", "series": "CAG", "text": "ἕκτη αἰτία, ὅτι καὶ αὐτὴ ἡ τάξις τοῦ ποσοῦ, ἐπειδὴ καὶ ὁ ἀριθμὸς ὁ ποιῶν τὴν τάξιν.", "seq": 3645}
{"id": "Elias_Passim_3646", "series": "CAG", "text": "ἐν οἷς τὸ πρῶτον κεφάλαιον.", "seq": 3646}
{"id": "Elias_Passim_3647", "series": "CAG", "text": "Δεύτερον κεφάλαιον, εἰ γένος τὸ ποσὸν συνεχοῦς καὶ διωρισμένου·", "seq": 3647}
{"id": "Elias_Passim_3648", "series": "CAG", "text": "δόξει γὰρ αὐτῶν μὴ εἶναι γένος, ἐπειδὴ ἐν τοῖς ὡς γένος εἰς εἴδη διαιρουμένοις τὰ εἴδη οὐ δέονται ἀλλήλων, οἷον τὸ λογικὸν οὐ δέεται τοῦ ἀλόγου οὐδὲ τὸ ἄλογον τοῦ λογικοῦ πρὸς ὕπαρξιν·", "seq": 3648}
{"id": "Elias_Passim_3649", "series": "CAG", "text": "ἀνθρώπου γὰρ ἀναιρεθέντος μένει ἵππος καὶ βοῦς καὶ τὰ τοιαῦτα, καὶ πάλιν τούτων ἀναιρεθέντων μένει ἄνθρωπος.", "seq": 3649}
{"id": "Elias_Passim_3650", "series": "CAG", "text": "τὸ δὲ συνεχὲς ποσὸν δεῖται τοῦ διωρισμένου, ἐπειδὴ παντὸς σώματος τρία εἰσι διαστάσεις, καὶ τὸ μὲν σῶμα τοῦ συνεχοῦς ποσοῦ τὸ δὲ τρία τοῦ διωρισμένου ποσοῦ.", "seq": 3650}
{"id": "Elias_Passim_3651", "series": "CAG", "text": "καὶ λέγομεν ὅτι τὸ σῶμα τριῶν ἐδεήθη διαστάσεων, οὐ τοῦ τρία ἀριθμοῦ·", "seq": 3651}
{"id": "Elias_Passim_3652", "series": "CAG", "text": "συνέβη γὰρ τηνάλλως τρεῖς αὐτὰς εἶναι, ἐπεὶ εἰ τὰ τρία ὡς τρία συνίστων τὸ σῶμα, ἔδει τὰ τυχόντα τρία συνιστᾶν τὸ σῶμα, οἷον λευκόν, μέλαν καὶ ξανθόν.", "seq": 3652}
{"id": "Elias_Passim_3653", "series": "CAG", "text": "δευτέρα ἔνστασις, ὅτι οὐ γένος τὸ ποσὸν συνεχοῦς καὶ διωρισμένου·", "seq": 3653}
{"id": "Elias_Passim_3654", "series": "CAG", "text": "ἐν γὰρ τοῖς ὡς γένος εἰς εἴδη διαιρουμένοις τὰ εἴδη τάξιν οὐκ ἐπιδέχονται, ὁ δὲ Ἀριστοτέλης τὸ διωρισμένον τοῦ συνεχοῦς προτάσσει.", "seq": 3654}
{"id": "Elias_Passim_3655", "series": "CAG", "text": "πρὸς ὅ φαμεν ὅτι οὐ κατὰ τὴν τοῦ κοινοῦ φύσιν ἐδέξαντο τάξιν·", "seq": 3655}
{"id": "Elias_Passim_3656", "series": "CAG", "text": "ὁμοίως γὰρ ποσὸν αὐτῶν ἑκάτερον·", "seq": 3656}
{"id": "Elias_Passim_3657", "series": "CAG", "text": "ὥσπερ γὰρ τὸ λογικὸν καὶ ἄλογον ὁμοίως ζῷον, προτέτακται δὲ τὸ λογικὸν διὰ τὴν ἀξίαν, οὕτω καὶ τὸ διωρισμένον προτέτακται τοῦ συνεχοῦς, ἐπειδὴ τὸ διωρισμένον ἑνὶ ἑαυτοῦ εἴδει, τῷ ἀριθμῷ, διὰ πάντων διήκει τῶν ὄντων·", "seq": 3657}
{"id": "Elias_Passim_3658", "series": "CAG", "text": "ἕκαστον γὰρ τῶν ὄντων ἢ ἕν ἐστιν ἢ πολλά.", "seq": 3658}
{"id": "Elias_Passim_3659", "series": "CAG", "text": "4b20 Τοῦ δὲ ποσοῦ τὸ μέν ἐστι συνεχὲς τὸ δὲ διωρισμένον.", "seq": 3659}
{"id": "Elias_Passim_3660", "series": "CAG", "text": "Τρίτον ἦν τῶν προτεθέντων τὸ ζητῆσαι εἰ τούτων μόνων γένος ἐστὶν ἢ καὶ ῥοπῆς, ὡς Πλάτων εἶπε.", "seq": 3660}
{"id": "Elias_Passim_3661", "series": "CAG", "text": "καὶ λέγομεν ὅτι οὐ δύναται ἡ ῥοπὴ τρίτον εἶδος εἶναι τοῦ ποσοῦ, ἐπειδὴ ἡ ῥοπὴ πάθος ἐστὶ τοῦ συνεχοῦς ποσοῦ·", "seq": 3661}
{"id": "Elias_Passim_3662", "series": "CAG", "text": "πᾶν γὰρ σῶμα ἢ κοῦφον ἢ βαρύ·", "seq": 3662}
{"id": "Elias_Passim_3663", "series": "CAG", "text": "ὥσπερ γὰρ ἡ θερμότης οὐσιώδης ποιότης ἐστὶν ἐν πυρὶ καὶ ἀρτιότης καὶ περιττόττης ** ποιότητές εἰσιν οὐσιώδεις ἐν σώματι διὰ τὸ πᾶν σῶμα ἢ κοῦφον εἶναι ἢ βαρύ.", "seq": 3663}
{"id": "Elias_Passim_3664", "series": "CAG", "text": "καὶ ἄλλως δὲ τοῦτο δεικτέον ὅτι οὔκ εἰσιν εἴδη τοῦ ποσοῦ ἡ κουφότης καὶ ἡ βαρύτης, ἀλλὰ πάθος, ἐπειδὴ τὸ διωρισμένον εὐθὺς ἐν τοῖς θείοις καὶ ἀύλοις καὶ νοητοῖς θεωρεῖται, ἐν οἷς οὐκ ἔστι ῥοπή.", "seq": 3664}
{"id": "Elias_Passim_3665", "series": "CAG", "text": "πρῶτον οὖν τὸ διωρισμένον εἶδος τοῦ ποσοῦ, δεύτερον δὲ τὸ ἀντικείμενον τῷ διωρισμένῳ, ὅ ἐστι συνεχές, τοῦτ᾿ ἔστι γραμμή, ἐπιφάνεια, σῶμα.", "seq": 3665}
{"id": "Elias_Passim_3666", "series": "CAG", "text": "οὐδὲν δὲ τοιοῦτον κοῦφόν ἐστιν ἢ βαρύ, οὐ γραμμή, οὐκ ἐπιφάνεια, οὐ τὸ μαθηματικὸν σῶμα, οὐ τὸ ἄποιον σῶμα, ἀλλὰ τὸ πεποιωμένον μόνον.", "seq": 3666}
{"id": "Elias_Passim_3667", "series": "CAG", "text": "πάθη οὖν καὶ οὐ ποσὰ ἁπλῶς αἱ ῥοπαί.", "seq": 3667}
{"id": "Elias_Passim_3668", "series": "CAG", "text": "Τέταρτον ἦν τὸ ζητῆσαι τί συνεχὲς καὶ τί διωρισμένον, καὶ εἰ ὑγιῶς ἔχουσιν αἱ τούτων ὑπογραφαί, ἑξῆς εἰπεῖν δέον.", "seq": 3668}
{"id": "Elias_Passim_3669", "series": "CAG", "text": "συνεχὲς τοίνυν ἔστιν εἰπεῖν οὗ τὰ μόρια πρὸς ἕνα κοινὸν ὅρον συνάπτει, τοῦτ᾿ ἔστι τὸ σημεῖον·", "seq": 3669}
{"id": "Elias_Passim_3670", "series": "CAG", "text": "ἐὰν γὰρ διέλῃς τὴν γραμμὴν εἰς ὁσαοῦν τμήματα, τὰ μόρια αὐτῆς κατὰ τὸ σημεῖον συνάπτει ἀλλήλοις.", "seq": 3670}
{"id": "Elias_Passim_3671", "series": "CAG", "text": "δεῖ δὲ τὰ μόρια τοῦ συνεχοῦς δυνάμει λαβεῖν καὶ οὐκ ἐνεργείᾳ, ἐπεὶ ἐὰν ἐνεργείᾳ λάβωμεν αὐτά, ποιοῦμεν τὸ συνεχὲς διωρισμένον, καὶ φθαρτικὸς ἔσται ὁ ὁρισμὸς τοῦ μεριστοῦ, ποιήσομεν δὲ καὶ τὰ οὐράνια, συνεχῆ ὄντα καὶ ἀπαθῆ, φθαρτικὰ καὶ μεριστά.", "seq": 3671}
{"id": "Elias_Passim_3672", "series": "CAG", "text": "οὐ μόνον δὲ τὰ μόρια τοῦ συνεχοῦς δυνάμει δεῖ λαβεῖν, ἀλλὰ καὶ τὰς στιγμάς, ἤτοι τὰ σημεῖα, δυνάμει δεῖ λαβεῖν, οὐκ ἐνεργείᾳ·", "seq": 3672}
{"id": "Elias_Passim_3673", "series": "CAG", "text": "εἰ γὰρ ἐνεργείᾳ λάβωμεν αὐτά, ποιήσομεν πάλιν τὸ συνεχὲς διωρισμένον·", "seq": 3673}
{"id": "Elias_Passim_3674", "series": "CAG", "text": "πέρατα γὰρ τῶν γραμμῶν τὰ σημεῖα, οὐκοῦν καὶ τῶν μερῶν τῶν γραμμῶν·", "seq": 3674}
{"id": "Elias_Passim_3675", "series": "CAG", "text": "γραμμαὶ γὰρ καὶ ταῦτα.", "seq": 3675}
{"id": "Elias_Passim_3676", "series": "CAG", "text": "καὶ ταῦτα μὲν περὶ τοῦ συνεχοῦς.", "seq": 3676}
{"id": "Elias_Passim_3677", "series": "CAG", "text": "διωρισμένον δέ ἐστιν οὗ τὰ μόρια οὐ συνάπτει πρὸς ἕνα κοινὸν ὅρον·", "seq": 3677}
{"id": "Elias_Passim_3678", "series": "CAG", "text": "τὰ γὰρ μόρια τοῦ πέντε καὶ τοῦ τρία οὐ συνάπτει πρὸς ἕνα κοινὸν ὅρον.", "seq": 3678}
{"id": "Elias_Passim_3679", "series": "CAG", "text": "δεῖ δὲ κἀνταῦθα μόρια ἐνεργείᾳ λαβεῖν καὶ οὐ δυνάμει·", "seq": 3679}
{"id": "Elias_Passim_3680", "series": "CAG", "text": "ἐὰν γὰρ λάβῃ τις μόρια δυνάμει, ποιήσει τὸ διωρισμένον συνεχές, καὶ ἔσται ὁ ὁρισμὸς αὐτοῦ φθαρτικός.", "seq": 3680}
{"id": "Elias_Passim_3681", "series": "CAG", "text": "Πέμπτον δεῖ ζητῆσαι εἰ ὑγιῶς ἔχει ἡ διαίρεσις τοῦ διωρισμένου·", "seq": 3681}
{"id": "Elias_Passim_3682", "series": "CAG", "text": "διαιρεῖται γὰρ τὸ διωρισμένον εἰς ἀριθμὸν καὶ λόγον·", "seq": 3682}
{"id": "Elias_Passim_3683", "series": "CAG", "text": "ἑκάτερον δὲ τούτων διωρισμένον, ὁ μὲν ἀριθμὸς ἐξ ἀνάγκης·", "seq": 3683}
{"id": "Elias_Passim_3684", "series": "CAG", "text": "εἰ γὰρ ἦν συνεχές, ἔδει εἶναι κοινὴν μονάδα τὴν ποτὲ μὲν μετὰ τοῦδε ποτὲ δὲ μετὰ τοῦδε λαμβανομένην, ὡς ἐπὶ τῶν μερῶν τοῦ ἐννέα, τοῦ τρία καὶ τοῦ ἕξ, ἔδει εἶναι μονάδα μέσην τὴν συνάπτουσαν, ἥτις μετὰ μὲν τοῦ ἓξ λαμβανομένη ἑπτὰ αὐτὸν ποιεῖ μετὰ δὲ τοῦ τρία τέσσαρα αὐτὸν ποιεῖ, καὶ εὑρίσκεται ὁ ἐννέα δέκα καὶ οὗτος ἕνδεκα, ὅπερ ἄτοπον·", "seq": 3684}
{"id": "Elias_Passim_3685", "series": "CAG", "text": "οὐδὲ γὰρ ὡς ἐπὶ τοῦ σημείου κἀνταῦθα ἡ αὐτὴ ἀναλογία σώζεται·", "seq": 3685}
{"id": "Elias_Passim_3686", "series": "CAG", "text": "τὸ γὰρ σημεῖον οὔτε προστεθὲν αὔξει οὔτε ἀφαιρούμενον μειοῖ τὸ ποσόν, ἤγουν τὸν ἀριθμόν.", "seq": 3686}
{"id": "Elias_Passim_3687", "series": "CAG", "text": "καὶ ὁ λόγος δὲ διωρισμένος ἐστίν, εἴ γε πάντως μεταξὺ δύο συλλαβῶν ἐστι σιωπή·", "seq": 3687}
{"id": "Elias_Passim_3688", "series": "CAG", "text": "ἐν γὰρ τῷ φίλος τῆς φι συλλαβῆς ἡ ἐκφώνησις ἄλλη ἐστὶ παρὰ τὴν λος ἐκφώνησιν τῆς συλλαβῆς.", "seq": 3688}
{"id": "Elias_Passim_3689", "series": "CAG", "text": "ἡ οὖν παῦλα τῆς ἐκφωνήσεως τῆς πρώτης συλλαβῆς σιωπὴ αὐτῆς ἐστι, καὶ τότε ἄρχεται ἐκφωνεῖσθαι ἡ δευτέρα συλλαβή.", "seq": 3689}
{"id": "Elias_Passim_3690", "series": "CAG", "text": "καὶ ταύτην νοητέον σιωπὴν μέσην δύο συλλαβῶν ἀνομοίως ἐκφερομένων διὰ τὴν τῶν συμφώνων ἀνομοιότητα·", "seq": 3690}
{"id": "Elias_Passim_3691", "series": "CAG", "text": "καὶ μεταξὺ γὰρ δύο ἐναντίων κινήσεών ἐστιν ἠρεμία, ὡς ἐν τῷ σφυγμῷ δείκνυται.", "seq": 3691}
{"id": "Elias_Passim_3692", "series": "CAG", "text": "εἰ δὲ καὶ μή ἐστι μέσον σύμφωνον μεταξύ, ὡς ἐν τῷ ‘ἀπὸ ὄρους’, ἀλλ᾿ ἵνα γένωνται δύο συλλαβαὶ καὶ δύο ἐκφωνήσεις, σιωπὴν ἀνάγκη γενέσθαι μέσον αὐτῶν τὴν διαιροῦσαν αὐτάς·", "seq": 3692}
{"id": "Elias_Passim_3693", "series": "CAG", "text": "οὐκ ἂν γὰρ ἐζήτουν οἱ γραμματικοὶ ἐπὶ τῶν μέσων φωνῶν, ποῖά εἰσιν ἀρκτικὰ καὶ ποῖα ληκτικά.", "seq": 3693}
{"id": "Elias_Passim_3694", "series": "CAG", "text": "Ἕκτον ἦν κεφάλαιον, εἰ ὑγιῶς ἔχει ἡ διαίρεσις τοῦ συνεχοῦς·", "seq": 3694}
{"id": "Elias_Passim_3695", "series": "CAG", "text": "διαιρεῖται γὰρ εἰς πέντε, εἰς γραμμὴν ἐπιφάνειαν σῶμα τόπον χρόνον.", "seq": 3695}
{"id": "Elias_Passim_3696", "series": "CAG", "text": "φασὶ δέ τινες ὅτι ἀτελής ἐστιν ἡ διαίρεσις αὐτοῦ καὶ πλεονάζουσα κατὰ ἄλλο καὶ ἄλλο·", "seq": 3696}
{"id": "Elias_Passim_3697", "series": "CAG", "text": "τῆς γὰρ κινήσεως οὐκ ἐμνήσθη ποσοῦ οὔσης καὶ τῆς ἐπιφανείας δὶς ἐμνήσθη, καὶ ὀνόματι καὶ διὰ τοῦ τόπου.", "seq": 3697}
{"id": "Elias_Passim_3698", "series": "CAG", "text": "πρὸς ὅ φαμεν ὅτι τὴν κίνησιν ὡς ἀτελῆ παρῆκεν (ἀεὶ γὰρ εἴς τι ὁρμᾷ ἡ κίνησις, αἱ δὲ κατηγορίαι ἐν τῷ γεγονέναι ἔχουσι τὸ εἶναι καὶ τέλειαί εἰσι), καὶ ὅτι τῶν ὁμωνύμων ἡ κίνησις·", "seq": 3698}
{"id": "Elias_Passim_3699", "series": "CAG", "text": "ἔστι γὰρ ἐν οὐσίᾳ καὶ ἐν ποσῷ καὶ ἐν ποιῷ (ἐν οὐσίᾳ μὲν ὡς γένεσις καὶ φθορά, ἐν ποσῷ δὲ ὡς αὔξησις καὶ φθίσις, ἐν ποιῷ ὡς ἀλλοίωσις ἡ κατὰ τὸ θερμὸν καὶ ψυχρὸν καὶ τὰς λοιπὰς ποιότητας), ἔστι δὲ καὶ κατὰ τόπον κίνησις.", "seq": 3699}
{"id": "Elias_Passim_3700", "series": "CAG", "text": "ἐπειδὴ οὖν ὁμώνυμος ἡ κίνησις καὶ ἐπὶ διαφόρους ἀνάγεται κατηγορίας, εἰκότως ταύτης οὐκ ἐμνήσθη νῦν οὐδὲ εἶπεν αὐτὴν τοῦ ποσοῦ εἶναι.", "seq": 3700}
{"id": "Elias_Passim_3701", "series": "CAG", "text": "ὕστερον δὲ μετὰ τὴν παράδοσιν τῶν κατηγοριῶν περὶ αὐτῆς διαλαμβάνει.", "seq": 3701}
{"id": "Elias_Passim_3702", "series": "CAG", "text": "ἀντιδιέστειλε δὲ καὶ τὸν τόπον τῇ ἐπιφανείᾳ, ὡς μήπω δείξας ὅτι ὁ τόπος ἐπιφάνειά ἐστιν, ὅπερ δείκνυσιν ἐν τῇ Φυσικῇ·", "seq": 3702}
{"id": "Elias_Passim_3703", "series": "CAG", "text": "ὁ γὰρ Πλάτων καὶ οἱ ἀπ᾿ αὐτοῦ τὸν τόπον σῶμα ἔλεγον εἶναι τριχῇ διαστατόν.", "seq": 3703}
{"id": "Elias_Passim_3704", "series": "CAG", "text": "4b20 Τοῦ δὲ ποσοῦ τὸ μέν ἐστι διωρισμένον τὸ δὲ συνεχές.", "seq": 3704}
{"id": "Elias_Passim_3705", "series": "CAG", "text": "Διελὼν ὁ Ἀριστοτέλης τὸ ποσὸν εἰς συνεχὲς καὶ διωρισμένον καὶ τὸ διωρισμένον εἰς ἀριθμὸν καὶ λόγον καὶ τὸ συνεχὲς εἰς πέντε, εἰς γραμμὴν ἐπιφάνειαν σῶμα τόπον καὶ χρόνον, ὥστε εἶναι ἑπτὰ πάντα τὰ εἴδη τοῦ ποσοῦ, δύο μὲν τοῦ διωρισμένου καὶ πέντε τοῦ συνεχοῦς, ὅτι τὰ δύο τοῦ διωρισμένου καὶ τὰ πέντε τοῦ συνεχοῦς, πιστοῦται ἐκ τοῦ ὁρισμοῦ ἑκατέρου.", "seq": 3705}
{"id": "Elias_Passim_3706", "series": "CAG", "text": "καὶ ὀφείλων ἐπὶ τοῦ ἀριθμοῦ καὶ τοῦ λόγου δεῖξαι ὅτι καὶ ποσὰ καὶ διωρισμένα, ἐπὶ μὲν τοῦ ἀριθμοῦ ὁμολογουμένως λαβὼν ὅτι ποσὸν ἐκ τοῦ πάντας ἐν τῇ συνηθείῃ θέλοντας γνῶναι τὸν ἀριθμὸν τῶν ἀνθρώπων ἢ ἵππων ἐρωτᾶν πόσοι εἰσὶν ὡς τοῦ ἀριθμοῦ ποσοῦ ὄντος, τὸ ἕτερον κατασκευάζει ὅτι διωρισμένον·", "seq": 3706}
{"id": "Elias_Passim_3707", "series": "CAG", "text": "εἰ γὰρ ἦν, φησίν, ὁ ἀριθμὸς συνεχής, ἔδει εἶναι κοινὴν μονάδα, οἷον ἐπὶ τῶν μερῶν τοῦ ἐννέα, λέγω δὲ τοῦ ἓξ καὶ τοῦ τρία, ἥτις μετὰ μὲν τοῦ ἓξ λαμβανομένη ἑπτὰ αὐτὸν ποιεῖ μετὰ δὲ τοῦ τρία τέσσαρα, καὶ εὑρίσκεται ὁ ἐννέα δέκα καὶ οὗτος ἕνδεκα, καὶ τοῦτο ἐπ᾿ ἄπειρον·", "seq": 3707}
{"id": "Elias_Passim_3708", "series": "CAG", "text": "οὐδὲ γὰρ ὡς ἐπὶ τοῦ σημείου κἀνταῦθα ἔχει τις εἰπεῖν·", "seq": 3708}
{"id": "Elias_Passim_3709", "series": "CAG", "text": "τὸ γὰρ σημεῖον ἀμερὲς ὂν μεριστῇ προστιθέμενον τῇ γραμμῇ οὐκ αὔξει αὐτὴν οὐδὲ ἀφαιρούμενον μειοῖ, καὶ ἡ γραμμὴ ἀπλατὴς οὖσα πλάτει προστιθεμένη πλάτος οὐ ποιεῖ, καὶ ἡ ἐπιφάνεια τῷ βάθος ἔχοντι προστιθεμένη ἀβαθὴς οὖσα βάθος οὐ ποιεῖ.", "seq": 3709}
{"id": "Elias_Passim_3710", "series": "CAG", "text": "καὶ ταῦτα μὲν ἐν τούτοις.", "seq": 3710}
{"id": "Elias_Passim_3711", "series": "CAG", "text": "πάλιν ὀφείλων ἐπὶ τοῦ λόγου δεῖξαι ὅτι καὶ ποσόν ἐστι καὶ διωρισμένον, ὡς ὁμολογούμενον λαμβάνει ὅτι ὁ λόγος διωρισμένος, εἴ γε πάντως μεταξὺ δύο συλλαβῶν ἐστι σιωπή, ὡς ἤδη εἴρηται, ὅτι δὲ ποσὸν ὁ λόγος δείκνυσι λέγων ὅτι ποσὸν ὁ λόγος, εἴ γε καταμετρεῖται μακρᾷ καὶ βραχείᾳ συλλαβῇ·", "seq": 3711}
{"id": "Elias_Passim_3712", "series": "CAG", "text": "εἴπερ δὲ τὸ μετρούμενον ποσόν, ὁ λόγος ἄρα ποσόν.", "seq": 3712}
{"id": "Elias_Passim_3713", "series": "CAG", "text": "διὸ ἀποροῦσιν ὅτι ἤρκει εἰπεῖν βραχείᾳ συλλαβῇ λόγος ὁ καταμετρούμενος <καταμετρεῖται>’·", "seq": 3713}
{"id": "Elias_Passim_3714", "series": "CAG", "text": "ἡ γὰρ βραχεῖα καὶ αὐτὴν καταμετρεῖ τὴν μακράν·", "seq": 3714}
{"id": "Elias_Passim_3715", "series": "CAG", "text": "* * ἔστι γὰρ μακρὰ παρὰ τοῖς μουσικοῖς τεσσάρων χρόνων, ἣν καὶ δίσημον καλοῦσιν ὡς διπλασίαν τῆς παρὰ τοῖς μετρικοῖς μακρᾶς, καὶ βραχεῖά ἐστι παρ᾿ αὐτοῖς τριῶν χρόνων ὡς τριπλασία οὖσα τῆς παρὰ τοῖς μετρικοῖς βραχείας·", "seq": 3715}
{"id": "Elias_Passim_3716", "series": "CAG", "text": "ἡ δὲ τοιαύτη βραχεῖα τὴν τοιαύτην μακρὰν οὐ καταμετρεῖ·", "seq": 3716}
{"id": "Elias_Passim_3717", "series": "CAG", "text": "οὐδὲ γὰρ ὁ τρία τὸν τέσσαρά ποτε μετρεῖ, ὡς μὴ ὢν αὐτοῦ μέρος·", "seq": 3717}
{"id": "Elias_Passim_3718", "series": "CAG", "text": "τὸ γὰρ μετρητικὸν μέρος τοῦ ἀριθμοῦ μέρος αὐτοῦ θέλει εἶναι, ἐπεὶ οὐ λέγεται μετρεῖν αὐτὸν κατὰ τοὺς ἀριθμητικούς·", "seq": 3718}
{"id": "Elias_Passim_3719", "series": "CAG", "text": "μέρος γὰρ αὐτοί φασιν αὐτοῦ οὐ τὸ τυχὸν αὐτοῦ, ἀλλ᾿ ὅπερ ἐστὶν ἥμισυ τρίτου, καὶ τὰ ὅμοια.", "seq": 3719}
{"id": "Elias_Passim_3720", "series": "CAG", "text": "διὸ καὶ ἑνικῶς λέγεται μέρος καὶ οὐ μέρη.", "seq": 3720}
{"id": "Elias_Passim_3721", "series": "CAG", "text": "αὐτὸ δὲ τοῦτο μέρος λέγεται, ἐπειδὴ ἐν πολλαπλασιασμῷ γεννᾷ ἀριθμὸν ἀπαρτίζοντα, ὡς μὴ λείπειν ἢ πλεονάζειν, οἷον τρὶς μία τρία, τρὶς δύο ἕξ·", "seq": 3721}
{"id": "Elias_Passim_3722", "series": "CAG", "text": "ἀπαρτίζειν γάρ ἐστι τὸ ἀναπληροῦν καὶ τελειοῦν, ὡς μὴ λείπειν ἢ πλεονάζειν·", "seq": 3722}
{"id": "Elias_Passim_3723", "series": "CAG", "text": "ἄρτιον γὰρ τὸ τέλειον καὶ ἀνελλιπὲς καὶ ἀπλεόναστον παρὰ τοῖς παλαιοῖς.", "seq": 3723}
{"id": "Elias_Passim_3724", "series": "CAG", "text": "οὔτε δὲ παρ᾿ αὐτοῖς τοῖς μετρικοῖς ἀεὶ ἡ μακρὰ δύο χρόνων, ἀλλ᾿ οἴδασι μακρὰν καὶ ἑνὸς ἥμισυ χρόνου, ὡς τὴν αι δίφθογγον καὶ τὴν οι·", "seq": 3724}
{"id": "Elias_Passim_3725", "series": "CAG", "text": "μακρᾶς γὰρ οὔσης τῆς τελευταίας συλλαβῆς οὐδέποτε πρὸ δύο συλλαβῶν πίπτει τόνος, ** ὡς μὴ οὐσῶν τελείων μακρῶν·", "seq": 3725}
{"id": "Elias_Passim_3726", "series": "CAG", "text": "Ὅμηροι γὰρ καὶ Μήδειαι πρὸ δύο ἔχουσι τὸν τόνον, ἐπειδὴ αὗται αἱ δίφθογγοι κοιναί εἰσιν.", "seq": 3726}
{"id": "Elias_Passim_3727", "series": "CAG", "text": "προστιθεμένου δὲ τοῦ σ ἐπὶ τῆς δοτικῆς τῶν πληθυντικῶν, ἐπειδὴ καὶ τοῦτο ἥμισυ ἔχει χρόνου, ἀναπληροῦται ἡ δίφθογγος καὶ τελεία μακρὰ γίνεται καὶ καταβιβάζει τὸν τόνον, Ὁμήροις καὶ Μηδείαις.", "seq": 3727}
{"id": "Elias_Passim_3728", "series": "CAG", "text": "ἡμῶν τοίνυν λεγόντων τοιαύτην μακράν, τὴν ἑνὸς ἥμισυ χρόνου ἡ ἑνὸς χρόνου βραχεῖα οὐδέποτε καταμετρεῖ·", "seq": 3728}
{"id": "Elias_Passim_3729", "series": "CAG", "text": "οὐ γὰρ μέρος τὸ ἓν τοῦ ἑνὸς ἥμισυ·", "seq": 3729}
{"id": "Elias_Passim_3730", "series": "CAG", "text": "οὐδὲ γὰρ ἥμισυ αὐτοῦ ἐστιν, οὐ τρίτον, οὐ τέταρτον, οὐκ ἄλλο οὐδὲν τῶν ἐφεξῆς τοιοῦτον·", "seq": 3730}
{"id": "Elias_Passim_3731", "series": "CAG", "text": "πᾶν γὰρ μέρος ἀριθμοῦ μετρητικὸν τούτων τῶν εἰρημένων ἓν θέλει εἶναι.", "seq": 3731}
{"id": "Elias_Passim_3732", "series": "CAG", "text": "διὸ οὐδὲ ὁ τρία ποτὲ μετρεῖ τὸν τέσσαρα·", "seq": 3732}
{"id": "Elias_Passim_3733", "series": "CAG", "text": "οὐ γὰρ μέρος αὐτοῦ, οὐχ ἥμισυ, οὐ τρίτον, οὐδὲ ἓν τῶν τοιούτων·", "seq": 3733}
{"id": "Elias_Passim_3734", "series": "CAG", "text": "οὐδὲ γὰρ ἀπαρτίζει αὐτὸν ἀνελλιπῶς καὶ ἀπλεονάστως, οἷον τρὶς μία τρία λείπει (πάλιν γὰρ ὁ αὐτός ἐστι), τρὶς δύο ἓξ πλεονάζει.", "seq": 3734}
{"id": "Elias_Passim_3735", "series": "CAG", "text": "ταῦτα μὲν περὶ τοῦ διωρισμένου.", "seq": 3735}
{"id": "Elias_Passim_3736", "series": "CAG", "text": "Τὸ δὲ συνεχὲς διαιρεῖ εἰς τὰ πέντε.", "seq": 3736}
{"id": "Elias_Passim_3737", "series": "CAG", "text": "καὶ ὅτι ἕκαστον τούτων συνεχές, δείκνυσιν ἐκ τῶν ὑπογραφῶν·", "seq": 3737}
{"id": "Elias_Passim_3738", "series": "CAG", "text": "ἡ γραμμὴ συνεχής, ὅτι τὰ μέρη αὐτῆς πρὸς ἕνα κοινὸν ὅρον συνάπτουσι, ** τὴν γραμμήν.", "seq": 3738}
{"id": "Elias_Passim_3739", "series": "CAG", "text": "τὸ σῶμα συνεχές, ὅτι τὰ μόρια αὐτοῦ πρὸς ἕνα κοινὸν ὅρον συνάπτουσι, τὴν ἐπιφάνειαν.", "seq": 3739}
{"id": "Elias_Passim_3740", "series": "CAG", "text": "ὁ χρόνος συνεχής, ὅτι τὰ μόρια αὐτοῦ πρὸς ἕνα κοινὸν ὅρον συνάπτει, τὸ νῦν·", "seq": 3740}
{"id": "Elias_Passim_3741", "series": "CAG", "text": "τὸ γὰρ νῦν ἀμερὲς ὂν συνάπτει τὸ παρεληλυθὸς τῷ μέλλοντι·", "seq": 3741}
{"id": "Elias_Passim_3742", "series": "CAG", "text": "ὃ γάρ ἐστι σημεῖον ἐν γραμμῇ, τοῦτο μονὰς ἐν τῷ ἀριθμῷ καὶ ἐπὶ χρόνου τὸ νῦν·", "seq": 3742}
{"id": "Elias_Passim_3743", "series": "CAG", "text": "ἀμερῆ γὰρ τὰ τρία.", "seq": 3743}
{"id": "Elias_Passim_3744", "series": "CAG", "text": "διαφέρουσι δὲ τὸ σημεῖον καὶ τὸ νῦν τῆς μονάδος, ὅτι ἡ μὲν μονὰς προστιθεμένη τῷ ἀριθμῷ αὔξει αὐτὸν ἀφαιρουμένη δὲ μειοῖ, τὸ δὲ σημεῖον τοῖς μεγέθεσι προστιθέμενον οὐ ποιεῖ αὐτὰ μείζονα οὔτε ἀφαιρούμενον ἐλάττονα.", "seq": 3744}
{"id": "Elias_Passim_3745", "series": "CAG", "text": "ὡσαύτως δὲ καὶ τὸ νῦν οὔτε προστιθέμενον τῷ χρόνῳ αὔξει αὐτὸν οὔτε ἀφαιρούμενον μειοῖ.", "seq": 3745}
{"id": "Elias_Passim_3746", "series": "CAG", "text": "ὁμοίως καὶ ὁ τόπος συνεχής·", "seq": 3746}
{"id": "Elias_Passim_3747", "series": "CAG", "text": "εἰ γὰρ τὸ ἐν τόπῳ συνεχές, ἤγουν τὸ σῶμα, καὶ ὁ τόπος συνεχής·", "seq": 3747}
{"id": "Elias_Passim_3748", "series": "CAG", "text": "εἰ γὰρ μὴ ὁ τόπος συνεχὴς τοῦ ἐν τόπῳ συνεχοῦς ὄντος, ἔσται μέρος τοῦ ἐν τόπῳ μὴ ὂν ἐν τόπῳ.", "seq": 3748}
{"id": "Elias_Passim_3749", "series": "CAG", "text": "καὶ εἰ ὁ τόπος συνεχὴς καὶ τὸ ἐν τόπῳ μὴ συνεχές, ἔσται μέρος τοῦ τόπου μὴ ὂν τόπος·", "seq": 3749}
{"id": "Elias_Passim_3750", "series": "CAG", "text": "οἷον ἵνα τόπον μὲν λάβωμεν τὸ κεράμιον, ἐν τόπῳ δὲ τὸν ἐν αὐτῷ οἶνον ἢ ὕδωρ ἢ τοιοῦτόν τι·", "seq": 3750}
{"id": "Elias_Passim_3751", "series": "CAG", "text": "ἐὰν οὖν ὁ τόπος, τοῦτ᾿ ἔστι τὸ κεράμιον, μὴ ᾖ συνεχές, ἀλλ᾿ οἷον κοσκινοειδές, ἔσται μέρος τοῦ ἐν αὐτῷ οἴνου μὴ ὂν ἐν τόπῳ.", "seq": 3751}
{"id": "Elias_Passim_3752", "series": "CAG", "text": "ταῦτα ἔχει ἡ θεωρία.", "seq": 3752}
{"id": "Elias_Passim_3753", "series": "CAG", "text": "4b20 Τοῦ δὲ ποσοῦ τὸ μέν ἐστι διωρισμένον τὸ δὲ συνεχές.", "seq": 3753}
{"id": "Elias_Passim_3754", "series": "CAG", "text": "Προτάττει τὸ διωρισμένον, οἷον ἀριθμὸν καὶ λόγον, τοῦ συνεχοῦς ποσοῦ·", "seq": 3754}
{"id": "Elias_Passim_3755", "series": "CAG", "text": "ἀυλότερος γὰρ ὁ ἀριθμὸς τοῦ μεγέθους ὡς δυνάμενος ἀσυγχύτως διάφορα σχήματα ἐπιδέξασθαι, ὅπερ ἀυλίας ἴδιον·", "seq": 3755}
{"id": "Elias_Passim_3756", "series": "CAG", "text": "ὁ γὰρ αὐτὸς ἀριθμὸς κύκλος ἅμα καὶ τετράγωνος δύναται εἶναι.", "seq": 3756}
{"id": "Elias_Passim_3757", "series": "CAG", "text": "ἔστι δὲ κύκλος μὲν ὁ ἀπὸ τοῦ αὐτοῦ ἀρχόμενος καὶ εἰς τὸ αὐτὸ λήγων νόμῳ κύκλου, ὡς ὁ τριακονταέξ (ἑξάκις γὰρ ἓξ τριακονταέξ·", "seq": 3757}
{"id": "Elias_Passim_3758", "series": "CAG", "text": "ἰδοὺ ἀπὸ τοῦ αὐτοῦ ἤρξατο καὶ εἰς τὸ αὐτὸ λήγει), καὶ ὁ εἰκοσιπέντε·", "seq": 3758}
{"id": "Elias_Passim_3759", "series": "CAG", "text": "πεντάκις <γὰρ> πέντε εἰκοσιπέντε.", "seq": 3759}
{"id": "Elias_Passim_3760", "series": "CAG", "text": "τετράγωνος δέ ἐστιν ὁ ἀπὸ ἀριθμοῦ ἑαυτὸν πολυπλασιάσαντος γενόμενος, ὡς ὁ ἐννέα·", "seq": 3760}
{"id": "Elias_Passim_3761", "series": "CAG", "text": "τρὶς γὰρ τρία ἐννέα.", "seq": 3761}
{"id": "Elias_Passim_3762", "series": "CAG", "text": "τὸ δὲ φθάσαν μέγεθος κυκλικῶς μετασχηματισθῆναι ἄλλο εἶδος οὐ δέχεται, εἰ μὴ πρότερον ἀφανισθῇ τὸ ἄλλο σχῆμα πρὸ αὐτοῦ.", "seq": 3762}
{"id": "Elias_Passim_3763", "series": "CAG", "text": "4b24 Ἔτι δὲ παρὰ ταῦτα τόπος καὶ χρόνος.", "seq": 3763}
{"id": "Elias_Passim_3764", "series": "CAG", "text": "Διὰ τί ὥσπερ τὴν γραμμὴν καὶ τὴν ἐπιφάνειαν καὶ τὸ σῶμα κατὰ συνέχειαν ἠρίθμησεν, μὴ καὶ τὸν τόπον καὶ τὸν χρόνον ἐφεξῆς αὐτοῖς κατὰ συνέχειαν ἠρίθμησεν, ἀλλ᾿ ἀντιδιέστειλε;", "seq": 3764}
{"id": "Elias_Passim_3765", "series": "CAG", "text": "καὶ λέγομεν δύο αἰτίας·", "seq": 3765}
{"id": "Elias_Passim_3766", "series": "CAG", "text": "ἢ ὅτι ἐν ἑνὶ τὰ τρία θεωροῦνται·", "seq": 3766}
{"id": "Elias_Passim_3767", "series": "CAG", "text": "ἐν γὰρ τῷ σώματι ἡμῶν γραμμὴ καὶ ἐπιφάνεια, ὁ δὲ τόπος καὶ ὁ χρόνος περὶ ἡμᾶς καὶ ἔξωθεν.", "seq": 3767}
{"id": "Elias_Passim_3768", "series": "CAG", "text": "ἢ καὶ ἄλλως·", "seq": 3768}
{"id": "Elias_Passim_3769", "series": "CAG", "text": "ὅτι τὰ μὲν τρία ταῦτα γεωμετρίας εἰδέναι, τόπον δὲ καὶ χρόνον φυσιολογίας·", "seq": 3769}
{"id": "Elias_Passim_3770", "series": "CAG", "text": "ἡ γὰρ φυσιολογία περὶ κίνησιν καταγίνεται (ἔστι γὰρ ἡ φύσις ἀρχὴ κινήσεως καὶ μεταβολῆς ἢ ἠρεμίας), ἡ δὲ γεωμετρία περὶ τὸ ἀκίνητον καὶ συνεχὲς καταγίνεται ποσόν.", "seq": 3770}
{"id": "Elias_Passim_3771", "series": "CAG", "text": "ἔτι δὲ καὶ ἡ ἀστρονομία·", "seq": 3771}
{"id": "Elias_Passim_3772", "series": "CAG", "text": "ἡ γὰρ ἀστρονομία τόπον εὑροῦσα χρόνον ζητεῖ, οἷον ἐν λέοντι πότε ἐστὶν ὁ ἥλιος.", "seq": 3772}
{"id": "Elias_Passim_3773", "series": "CAG", "text": "ποτὲ δὲ χρόνον εὑρὼν ὁ φυσικὸς τόπον ζητεῖ, οἷον μετὰ δέκα ἡμέρας ποῦ ἔσται ἡ σελήνη.", "seq": 3773}
{"id": "Elias_Passim_3774", "series": "CAG", "text": "4b34 Λέγω δὲ αὐτὸν τὸν μετὰ φωνῆς λόγον.", "seq": 3774}
{"id": "Elias_Passim_3775", "series": "CAG", "text": "Ὁ λόγος διάφορα σημαίνει·", "seq": 3775}
{"id": "Elias_Passim_3776", "series": "CAG", "text": "λέγεται γὰρ λόγος καὶ ὁ ἐνδιάθετος, καθὸ καὶ τοὺς ἀγγέλους φαμὲν λογικούς, καὶ ὁ προφορικός, περὶ οὗ ὁ λόγος ὁ προκείμενος.", "seq": 3776}
{"id": "Elias_Passim_3777", "series": "CAG", "text": "λέγεται καὶ ὁ ἀποτάδην λόγος, οἷον ὁ ῥητορικὸς καὶ ὁ ἰατρικός.", "seq": 3777}
{"id": "Elias_Passim_3778", "series": "CAG", "text": "λέγεται λόγος καὶ ἡ σχέσις τῶν μεγεθῶν, ὡς ὅταν λέγωμεν ὅτι ὃν λόγον ἔχει τόδε τὸ μέγεθος **, τοιόνδε πρὸς ἄλλο μέγεθος.", "seq": 3778}
{"id": "Elias_Passim_3779", "series": "CAG", "text": "λέγεται λόγος καὶ ἡ αἰτία, καθὸ καὶ ὁ Πλάτων φησὶ ‘τέχνην δὲ ἐγὼ οὐ καλῶ, ὃ ἂν ᾖ ἄλογον πρᾶγμα’.", "seq": 3779}
{"id": "Elias_Passim_3780", "series": "CAG", "text": "διὰ τοῦτο οὖν εἶπε λόγον τὸν μετὰ φωνῆς, τοῦτ᾿ ἔστι τὸν ἐκφωνούμενον, πρὸς ἀντιδιαστολὴν τῶν ἄλλων σημαινομένων, ἵνα δείξῃ ὅτι οὗτος ὁ λόγος ὁ μετὰ φωνῆς ὑπὸ διωρισμένον ποσὸν ἀνάγεται, οὐ μὴν καὶ τὰ ἄλλα σημαινόμενα τοῦ λόγου, τοῦτ᾿ ἔστιν ὁ ἐνδιάθετος καὶ ἡ σχέσις καὶ ἡ αἰτία.", "seq": 3780}
{"id": "Elias_Passim_3781", "series": "CAG", "text": "ἀποροῦσι δέ τινες λέγοντες πῶς ὁ Ἀριστοτέλης φησὶ τὸν λόγον τὸν μετὰ φωνῆς τοῦ ποσοῦ εἶναι·", "seq": 3781}
{"id": "Elias_Passim_3782", "series": "CAG", "text": "ὁ γὰρ λόγος διανοίας ἐστὶ σημαντικός, καὶ διὰ τοῦτο σύνθετός ἐστιν ὡς συγκείμενος ἐξ ὀνομάτων καὶ ῥημάτων·", "seq": 3782}
{"id": "Elias_Passim_3783", "series": "CAG", "text": "νῦν δὲ οὐ περὶ συνθέτων φωνῶν ἐστιν ὁ λόγος τῷ Ἀριστοτέλει, ἀλλὰ περὶ τῶν ἁπλῶν φωνῶν·", "seq": 3783}
{"id": "Elias_Passim_3784", "series": "CAG", "text": "αὐτὸς γὰρ ὁ Ἀριστοτέλης λέγει ὅτι τῶν κατὰ μηδεμίαν συμπλοκὴν λεγομένων τὸ μὲν οὐσίαν σημαίνει τὸ δὲ ποσὸν καὶ τὰ ἑξῆς·", "seq": 3784}
{"id": "Elias_Passim_3785", "series": "CAG", "text": "πῶς οὖν τὸν λόγον φησὶ τοῦ ποσοῦ εἶναι σύνθετον ὄντα καὶ κατὰ συμπλοκὴν ὀνομάτων καὶ ῥημάτων;", "seq": 3785}
{"id": "Elias_Passim_3786", "series": "CAG", "text": "καὶ λέγομεν ὅτι ἐνταῦθα μέμνηται τοῦ λόγου οὐχ ὡς συνθέτου, ἀλλ᾿ ὡς διωρισμένου ἁπλῶς καὶ συγκειμένου ἐκ συλλαβῶν, ὡς καὶ αὐτὸς ὁ Ἀριστοτέλης δηλοῖ λέγων ὅτι τὸ καταμετρεῖσθαι μακρᾷ καὶ βραχείᾳ συλλαβῇ τὸν μετὰ φωνῆς λόγον δείκνυσιν αὐτὸν τοῦ διωρισμένου ποσοῦ.", "seq": 3786}
{"id": "Elias_Passim_3787", "series": "CAG", "text": "καὶ δῆλον ὅτι λόγον ἐνταῦθά φησι καὶ τὸ ἓν ὄνομα καὶ τὸ ἓν ῥῆμα καὶ ἁπλῶς τὴν μίαν λέξιν καὶ τὴν ἄσημον φωνήν, εἴπερ καὶ ταῦτα καταμετρεῖται μακρᾷ καὶ βραχείᾳ συλλαβῇ.", "seq": 3787}
{"id": "Elias_Passim_3788", "series": "CAG", "text": "ἐν δὲ τῷ Περὶ ἑρμηνείας διαλαμβάνει τὸ σύνθετον καὶ σημαντικόν·", "seq": 3788}
{"id": "Elias_Passim_3789", "series": "CAG", "text": "ὁριζόμενος γάρ φησι ‘λόγος <ἐστὶ> φωνὴ σημαντική, ἧς τῶν μερῶν τι σημαντικόν ἐστι κεχωρισμένον’.", "seq": 3789}
{"id": "Elias_Passim_3790", "series": "CAG", "text": "4b26 Οἷον ὁ πέντε εἰ ἔστι τῶν δέκα μόριον, πρὸς οὐδένα κοινὸν ἔχει ὅρον.", "seq": 3790}
{"id": "Elias_Passim_3791", "series": "CAG", "text": "Εὐλόγως ὑποθετικῶς τὸν λόγον προήγαγεν ὁ πέντε εἰ ἔστι τῶν δέκα μόριον, διότι ὁ πέντε οὐ μόνον τοῦ δέκα δύναται μέρος εἶναι, ἀλλὰ καὶ τοῦ δεκαπέντε καὶ τοῦ εἴκοσι καὶ ἄλλων πολλῶν, καὶ ὅτι οὐκ ἔστιν ὡρισμένον μέρος ὁ πέντε·", "seq": 3791}
{"id": "Elias_Passim_3792", "series": "CAG", "text": "δυνατὸν γὰρ τοῦ δέκα μέρη λαβεῖν τὸν ἑπτὰ καὶ τρία καὶ τὸν ἓξ καὶ τέσσαρα.", "seq": 3792}
{"id": "Elias_Passim_3793", "series": "CAG", "text": "5a3 Τὰ γὰρ τοῦ ἐπιπέδου μόρια πρός τινα κοινὸν ὅρον συνάπτει, τὴν γραμμήν.", "seq": 3793}
{"id": "Elias_Passim_3794", "series": "CAG", "text": "Παρὰ μὲν τοῖς παλαιοῖς ταὐτὸν εἶναι δοκεῖ ἐπιφάνεια καὶ ἐπίπεδον·", "seq": 3794}
{"id": "Elias_Passim_3795", "series": "CAG", "text": "ἐπὶ τοῦ αὐτοῦ γὰρ καὶ τὸ τῆς ἐπιφανείας καὶ τὸ τοῦ ἐπιπέδου λαμβάνουσιν ὄνομα.", "seq": 3795}
{"id": "Elias_Passim_3796", "series": "CAG", "text": "παρὰ δὲ τοῖς νεωτέροις διακέκριται ἐπιφάνεια ἐπιπέδου·", "seq": 3796}
{"id": "Elias_Passim_3797", "series": "CAG", "text": "τὸ μὲν γὰρ ἐπίπεδον ἐπὶ μόνης τῆς ὁμαλῆς ἐπιφανείας λαμβάνουσι τῆς ἐξ ἴσου ταῖς ἑαυτῆς εὐθείαις κειμένης, τὴν δὲ ἐπιφάνειαν καὶ ἧς τὰ μέσα τοῖς ἄκροις ἐπιπροσθεῖ καὶ † τῆς ἐλαχίστης τῶν παθῶν τὰ αὐτὰ πέρατα ἐχουσῶν, κοίλων τυχὸν ἢ κυρτῶν.", "seq": 3797}
{"id": "Elias_Passim_3798", "series": "CAG", "text": "κοινοτέρα οὖν παρὰ τοῖς νέοις ἡ ἐπιφάνεια, φερομένη καὶ κατὰ τῆς ὁμαλῆς ἐπιφανείας, ἥτις ἐστὶν ἐπίπεδον, καὶ κατὰ τῆς κοίλης καὶ κυρτῆς.", "seq": 3798}
{"id": "Elias_Passim_3799", "series": "CAG", "text": "5a4 Ὡσαύτως δὲ καὶ ἐπὶ τοῦ σώματος ἔχοις ἂν λαβεῖν κοινὸν ὅρον, γραμμὴν <ἢ> ἐπιφάνειαν, πρὸς ὃν τὰ τοῦ σώματος μόρια συνάπτει.", "seq": 3799}
{"id": "Elias_Passim_3800", "series": "CAG", "text": "Τὰ δὲ μέρη τοῦ σώματος συνάπτει πρὸς κοινὸν ὅρον, τὴν ἐπιφάνειαν, διὰ ταύτην δὲ καὶ πρὸς γραμμήν.", "seq": 3800}
{"id": "Elias_Passim_3801", "series": "CAG", "text": "τῆς ἐπιφανείας κατὰ βάθος διαιρούσης τὰ σώματα, αὐτῆς δὲ παντελῶς ἀδιαστάτου οὔσης κατὰ βάθος, ἐξ ἀνάγκης καὶ τὰ μέρη τοῦ σώματος ἀδιαστάτως καὶ κατὰ βάθος συνάπτουσι πρὸς ἄλληλα κατὰ τὴν ἐπιφάνειαν, κἀνταῦθα πάλιν δυνάμει τῆς διαιρέσεως ἤτοι τῆς ἐπιφανείας λαμβανομένης, ἵν᾿ ᾖ τὸ σῶμα συνεχές.", "seq": 3801}
{"id": "Elias_Passim_3802", "series": "CAG", "text": "διὰ δὲ τὴν ἐπιφάνειαν καὶ πρὸς γραμμὴν συνάπτουσι τὰ τοῦ σώματος μόρια·", "seq": 3802}
{"id": "Elias_Passim_3803", "series": "CAG", "text": "ἐπειδὴ γὰρ κατὰ τοὺς γεωμέτρας ῥυεῖσα <ἡ> γραμμὴ ποιεῖ τὴν ἐπιφάνειαν, δεῖ τὸν διαιροῦντα τὸ σῶμα κατὰ τὴν ἐπιφάνειαν ἄρξασθαι ἀπὸ τῆς γραμμῆς καὶ ταύτην οἱονεὶ ἐπισύροντα ποιεῖν ἐπιφάνειαν καὶ δι᾿ αὐτῆς τέμνειν τὸ σῶμα.", "seq": 3803}
{"id": "Elias_Passim_3804", "series": "CAG", "text": "ἐπειδὴ οὖν καθ᾿ ὅλην ἑαυτὴν ἡ ἐπιφάνεια τέμνει τὸ σῶμα, ἀνάγκη καὶ κατὰ τὸ πέρας αὐτῆς, λέγω δὴ τὴν γραμμήν, συνάπτειν τὰ τοῦ σώματος ἄκρα.", "seq": 3804}
{"id": "Elias_Passim_3805", "series": "CAG", "text": "5a6 Ἔστι δὲ καὶ ὁ χρόνος καὶ ὁ τόπος τῶν τοιούτων.", "seq": 3805}
{"id": "Elias_Passim_3806", "series": "CAG", "text": "Νῦν δείκνυσιν ὅτι συνεχῆ ποσὰ ὁ τόπος καὶ ὁ χρόνος·", "seq": 3806}
{"id": "Elias_Passim_3807", "series": "CAG", "text": "καὶ τούτων γὰρ τὰ μέρη πρός τινα κοινὸν ὅρον συνάπτουσι·", "seq": 3807}
{"id": "Elias_Passim_3808", "series": "CAG", "text": "τοῦ μὲν χρόνου τὰ μέρη τὸ νῦν ἀδιάστατον ὑπάρχον παντελῶς συνάπτει δι᾿ ἑαυτοῦ, τὸν παρεληλυθότα καὶ τὸν μέλλοντα, τοῦ δὲ τόπου τὰ μέρη συνάπτει ἡ γραμμή, διότι ἐπιφάνειά τις εἶναι δοκεῖ ὁ τόπος, τῆς δὲ ἐπιφανείας τὰ μόρια κατὰ τὴν γραμμὴν συνάπτει.", "seq": 3808}
{"id": "Elias_Passim_3809", "series": "CAG", "text": "5a9 Τόπον γάρ τινα τὰ τοῦ σώματος μόρια κατέχει, ἃ πρός τινα κοινὸν ὅρον συνάπτει·", "seq": 3809}
{"id": "Elias_Passim_3810", "series": "CAG", "text": "οὐκοῦν καὶ τὰ τοῦ τόπου μόρια, <ἃ> κατέχει ἕκαστον τῶν τοῦ σώματος μορίων, καὶ πρὸς τὸν αὐτὸν ὅρον συνάπτει, πρὸς ὃν καὶ τὰ τοῦ σώματος μόρια.", "seq": 3810}
{"id": "Elias_Passim_3811", "series": "CAG", "text": "Κατασκευάζει ὅτι καὶ τὰ τοῦ τόπου μόρια ὡς συνεχοῦς ὄντος πρός τινα κοινὸν ὅρον συνάπτει ἀπὸ τῶν ἐν τόπῳ.", "seq": 3811}
{"id": "Elias_Passim_3812", "series": "CAG", "text": "τοῦ δὲ ἐν τόπῳ τὰ μέρη εἰ πρός τινα κοινὸν ὅρον συνάπτει, ἀνάγκη καὶ τὸν τόπον ἔχειν τὰ μόρια πρός τινα κοινὸν ὅρον συνάπτοντα·", "seq": 3812}
{"id": "Elias_Passim_3813", "series": "CAG", "text": "εἰ γὰρ τὸ μὲν ἐν τόπῳ συνεχὲς εἴη, ὁ δὲ τόπος μὴ εἴη συνεχής, ἀλλὰ διεσπασμένος, συμβήσεται μέρος τοῦ ἐν τόπῳ, ὃ οὐκ ἔστιν ἐν τόπῳ.", "seq": 3813}
{"id": "Elias_Passim_3814", "series": "CAG", "text": "εἰ οὖν ἕκαστον, φησί, τῶν τοῦ σώματος μορίων τινὰ τόπον κατέχει καὶ ταῦτα τὰ μόρια πρός τινα κοινὸν ὅρον συνάπτει, ἀνάγκη καὶ τὰ μόρια τοῦ τόπου πρός τινα κοινὸν ὅρον συνάπτειν.", "seq": 3814}
{"id": "Elias_Passim_3815", "series": "CAG", "text": "ὥστε συνεχὴς ἂν εἴη καὶ ὁ τόπος·", "seq": 3815}
{"id": "Elias_Passim_3816", "series": "CAG", "text": "πρὸς γὰρ ἕνα κοινὸν ὅρον αὐτοῦ τὰ μόρια συνάπτει·", "seq": 3816}
{"id": "Elias_Passim_3817", "series": "CAG", "text": "τῶν <γὰρ> συνεχῶν κοινὸς ὁρισμός ἐστι τὸ πρός τινα κοινὸν ὅρον αὐτῶν τὰ μόρια συνάπτειν·", "seq": 3817}
{"id": "Elias_Passim_3818", "series": "CAG", "text": "ἐφήρμοσε δὲ καὶ τῷ τόπῳ οὗτος ὁ ὁρισμός·", "seq": 3818}
{"id": "Elias_Passim_3819", "series": "CAG", "text": "ὁ ἄρα τόπος συνεχής ἐστιν.", "seq": 3819}
{"id": "Elias_Passim_3820", "series": "CAG", "text": "5a15 Ἔτι δὲ τὰ μὲν ἐκ θέσιν ἐχόντων πρὸς ἄλληλα τῶν ἐν αὑτοῖς μορίων συνέστηκε.", "seq": 3820}
{"id": "Elias_Passim_3821", "series": "CAG", "text": "Πρώην διελὼν ὁ Ἀριστοτέλης τὸ ποσὸν εἰς συνεχὲς καὶ διωρισμένον καὶ τὸ συνεχὲς εἰς πέντε, εἰς γραμμήν, ἐπιφάνειαν, σῶμα, τόπον καὶ χρόνον, καὶ τὸ διωρισμένον εἰς δύο, εἰς ἀριθμὸν καὶ λόγον, νῦν ἐπιδιαιρεῖ τὸ ποσὸν εἰς θετὸν καὶ ἄθετον, καὶ τὸ θετὸν εἰς γραμμήν, ἐπιφάνειαν, σῶμα, τόπον, οὐκέτι εἰς πέντε (ἀφεῖλε γὰρ τὸν χρόνον), τὸ δὲ ἄθετον εἰς τρία, εἰς ἀριθμὸν καὶ λόγον καὶ χρόνον.", "seq": 3821}
{"id": "Elias_Passim_3822", "series": "CAG", "text": "ἄξιον δὲ ἐπιζητῆσαι διὰ τί ἡ ἀφαίρεσις τοῦ χρόνου αἰτία γέγονε τῆς τοῦ ποσοῦ ἐπιδιαιρέσεως.", "seq": 3822}
{"id": "Elias_Passim_3823", "series": "CAG", "text": "καὶ λεκτέον ὅτι δύο ὄντων ἄκρων ἐναντίων ἀλλήλοις, συνεχοῦς καὶ διωρισμένου, καὶ ὡς οἱ παροιμιαζόμενοί φασιν ὅλῳ καὶ παντὶ λέγοντες διαφέρειν τὰ ἄγαν διεστῶτα, τοῦτ᾿ ἔστι τοῖς ἐναντίοις εἴδεσι τοῦ ποσοῦ τὸ μὲν ὅλον ἐπὶ τοῦ συνεχοῦς τάττοντες τὸ δὲ πᾶν ἐπὶ τοῦ διωρισμένου, καὶ τοῦ Πλάτωνος πάντα ἔμμεσα λέγοντος τὰ ἐναντία, ἵνα καὶ τὸ μᾶλλον καὶ τὸ ἧττον ἐπιδέχοιντο, ἔδει εἶναι μέσον τι τοῦ συνεχοῦς καὶ τοῦ διωρισμένου·", "seq": 3823}
{"id": "Elias_Passim_3824", "series": "CAG", "text": "μέσον δὲ συνεχοῦς καὶ διωρισμένου ὁ χρόνος·", "seq": 3824}
{"id": "Elias_Passim_3825", "series": "CAG", "text": "ὡς μὲν γὰρ κίνησις συνεχὴς ὁ χρόνος (πᾶσα γὰρ κίνησις συνεχής), ὡς δὲ ἀριθμηθεῖσα κίνησις τῷ πάλιν καὶ πάλιν ἀριθμεῖσθαι διωρισμένος ὁ χρόνος.", "seq": 3825}
{"id": "Elias_Passim_3826", "series": "CAG", "text": "τρισὶ δέ τισι χαρακτηρίζει τὸ θετὸν ὁ Ἀριστοτέλης, τῷ ὅλον ἅμα ὑφεστάναι καὶ δείξει ὑποπίπτειν καὶ τῷ ἐπιδέχεσθαι τὰ ἓξ θετικὰ ἐπιρρήματα.", "seq": 3826}
{"id": "Elias_Passim_3827", "series": "CAG", "text": "δείξωμεν <οὖν> τὰ τρία ἐπὶ ἑκάστου εἴδους τῶν συνεχῶν·", "seq": 3827}
{"id": "Elias_Passim_3828", "series": "CAG", "text": "ἡ γραμμὴ ὅλη ἅμα ὑφέστηκε σπιθαμιαία οὖσα ἢ πλεῖον ἢ ἔλαττον, καὶ ἡ ἐπιφάνεια ὁμοίως καὶ τὸ σῶμα.", "seq": 3828}
{"id": "Elias_Passim_3829", "series": "CAG", "text": "ἀλλὰ καὶ δείξει ὑποπίπτει ἡ γραμμὴ ὡς δακτύλῳ δεικνυμένη, καὶ ἡ ἐπιφάνεια καὶ τὸ σῶμα.", "seq": 3829}
{"id": "Elias_Passim_3830", "series": "CAG", "text": "καὶ τὰ ἓξ θετικὰ ἐπιρρήματα ἐπιδέχεται ἡ γραμμή·", "seq": 3830}
{"id": "Elias_Passim_3831", "series": "CAG", "text": "εἰπεῖν γὰρ ἔχομεν ὅτι τῆς γραμμῆς τὸ μὲν πρόσω τὸ δὲ ὀπίσω καὶ τὸ μὲν δεξιὰ τὸ δὲ ἀριστερὰ καὶ τὸ μὲν ἄνω τὸ δὲ κάτω, καὶ ἐπὶ τῆς ἐπιφανείας ὁμοίως καὶ τοῦ σώματος τὰ αὐτὰ ἐροῦμεν.", "seq": 3831}
{"id": "Elias_Passim_3832", "series": "CAG", "text": "τὸ δὲ ἄθετον ὅλον ἅμα οὐχ ὑφέστηκεν οὐδὲ δείξει ὑποπίπτει οὐδὲ τὰ ἓξ θετικὰ ἐπιρρήματα ἐπιδέχεται·", "seq": 3832}
{"id": "Elias_Passim_3833", "series": "CAG", "text": "ἰδοὺ γὰρ ὁ χρόνος ὅλος ἅμα οὐχ ὑφέστηκε·", "seq": 3833}
{"id": "Elias_Passim_3834", "series": "CAG", "text": "δεῖ γὰρ φθαρῆναι τὸ σήμερον, ἵνα γένηται τὸ αὔριον.", "seq": 3834}
{"id": "Elias_Passim_3835", "series": "CAG", "text": "οὐδὲ ὁ λόγος ἅμα ὑφέστηκε·", "seq": 3835}
