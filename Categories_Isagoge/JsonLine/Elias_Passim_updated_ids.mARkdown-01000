{"id": "Elias_Passim_3233", "series": "CAG", "text": "μεταβάλλει γὰρ κατὰ ταῦτα), κατὰ δεύτερον λόγον καὶ ἐν τοῖς καθόλου λέγονται εἶναι, ἐπινοητικῶς δέ.", "seq": 3233}
{"id": "Elias_Passim_3234", "series": "CAG", "text": "πρὸς δὲ τὸ δεύτερόν φαμεν ὅτι τὸ μερικὸν συμβεβηκός ἐστιν ἐν τῇ καθόλου οὐσίᾳ, οὐχ ὅτι κατὰ ἀλήθειαν ἐν αὐτῇ ὑφίσταται (κἂν γὰρ τὸ σῶμα εἴπῃς τὸ καθόλου, καὶ τοῦτο ἀσώματόν ἐστιν), ἀλλ᾿ ὅτι τοὺς λόγους ἔχει ἡ καθόλου οὐσία, ἤτοι τὸ καθόλου σῶμα, προαγωγοὺς τῶν συμβεβηκότων.", "seq": 3234}
{"id": "Elias_Passim_3235", "series": "CAG", "text": "2a27 Τῶν δὲ ἐν ὑποκειμένῳ ὄντων ἐπὶ τῶν πλείστων οὔτε τοὔνομα οὔτε ὁ λόγος κατηγορεῖται τοῦ ὑποκειμένου.", "seq": 3235}
{"id": "Elias_Passim_3236", "series": "CAG", "text": "Δεῖ δὲ εἰδέναι ὅτι ἐπί τινων συμβεβηκότων τινὰ ὁμωνύμως κατηγορεῖται τῆς οὐσίας, συνωνύμως δὲ οὐδέποτε·", "seq": 3236}
{"id": "Elias_Passim_3237", "series": "CAG", "text": "οἷον τὸ λευκὸν κατηγορεῖται τοῦ σώματος ὁμωνύμως, οὐ συνωνύμως·", "seq": 3237}
{"id": "Elias_Passim_3238", "series": "CAG", "text": "οὐδὲ γὰρ τὸν ὁρισμὸν τοῦ λευκοῦ ἐπιδέχεται τὸ σῶμα·", "seq": 3238}
{"id": "Elias_Passim_3239", "series": "CAG", "text": "οὐδεὶς γὰρ λέγει τὸ σῶμα λευκὸν χρῶμα διακριτικὸν ὄψεως.", "seq": 3239}
{"id": "Elias_Passim_3240", "series": "CAG", "text": "τινὰ δὲ οὔτε ὁμωνύμως οὔτε συνωνύμως, ὡς ἐπὶ τοῦ χρώματος·", "seq": 3240}
{"id": "Elias_Passim_3241", "series": "CAG", "text": "οὐδεὶς γὰρ λέγει τὸν ἄνθρωπον χρῶμα, ἀλλ᾿ οὐδὲ τὸν ὁρισμὸν τοῦ χρώματος ἐπιδέχεται·", "seq": 3241}
{"id": "Elias_Passim_3242", "series": "CAG", "text": "οὐδὲ γὰρ λέγει τὸν κύκνον χρῶμα ἢ ὅτι κύκνος ἐστὶ χρῶμα ἴδιον αἰσθητῆς ὄψεως.", "seq": 3242}
{"id": "Elias_Passim_3243", "series": "CAG", "text": "2b7 Τῶν δὲ δευτέρων οὐσιῶν μᾶλλον οὐσία τὸ εἶδος τοῦ γένους·", "seq": 3243}
{"id": "Elias_Passim_3244", "series": "CAG", "text": "ἔγγιον γὰρ τῇ πρώτῃ οὐσίᾳ ἐστίν.", "seq": 3244}
{"id": "Elias_Passim_3245", "series": "CAG", "text": "Ἔτι διὰ τούτων προτίθησι τὴν ἄτομον οὐσίαν ὁ Ἀριστοτέλης·", "seq": 3245}
{"id": "Elias_Passim_3246", "series": "CAG", "text": "ἐν γὰρ ταῖς δευτέραις οὐσίαις μᾶλλον οὐσία ἡ εἰδική ἐστι τῆς γενικῆς ὡς μᾶλλον πλησιάζουσα τῇ ἀτόμῳ οὐσίᾳ τῇ μάλιστα οὐσίᾳ δειχθείσῃ·", "seq": 3246}
{"id": "Elias_Passim_3247", "series": "CAG", "text": "ὡς γὰρ οἱ πλησιάζοντες τῷ πυρὶ μᾶλλον θερμαίνονται καὶ οἱ πλησίον τῆς μονάδος ἀριθμοὶ μᾶλλον ἑνιαῖοί εἰσιν, οὕτω καὶ ἡ εἰδικὴ οὐσία πλησιάζουσα τῇ ἀτόμῳ οὐσίᾳ μᾶλλον οὐσία ἐστί·", "seq": 3247}
{"id": "Elias_Passim_3248", "series": "CAG", "text": "πᾶν γὰρ οὗ ἔχει τοῖς πλησίον μᾶλλον μεταδίδωσιν.", "seq": 3248}
{"id": "Elias_Passim_3249", "series": "CAG", "text": "ὅτι δὲ μᾶλλον οὐσία ἡ εἰδικὴ τῆς γενικῆς, διχῶς κατασκευάζει, ἀπό τε τῆς ἐγγύτητος καὶ τῆς ἀναλογίας.", "seq": 3249}
{"id": "Elias_Passim_3250", "series": "CAG", "text": "καὶ ἀπὸ μὲν τῆς ἐγγύτητος οὕτως·", "seq": 3250}
{"id": "Elias_Passim_3251", "series": "CAG", "text": "ὅτι οἰκειότερόν ἐστι καὶ ἐγγύτερον τὸν Σωκράτην ἄνθρωπον εἰπεῖν ἢ ζῷον.", "seq": 3251}
{"id": "Elias_Passim_3252", "series": "CAG", "text": "ἀπὸ δὲ τῆς ἀναλογίας οὕτως·", "seq": 3252}
{"id": "Elias_Passim_3253", "series": "CAG", "text": "εἰ τὴν ἄτομον οὐσίαν οὐδὲν ἄλλο ἐχαρακτήριζε καὶ ἐποίει μᾶλλον οὐσίαν, εἰ μὴ τὸ ὑποκεῖσθαι πᾶσι τοῖς παρ᾿ ἑαυτήν, τοῦτο δὲ τὸ ὑποκεῖσθαι εἴδεσι μὲν πρὸς γένη ὑπάρχει, γένεσι δὲ πρὸς εἴδη οὐχ ὑπάρχει (οὐ γὰρ ὑπόκεινται τὰ γένη τοῖς εἴδεσι), διὰ τοῦτο μᾶλλον οὐσία ἡ εἰδικὴ τῆς γενικῆς ὡς ὑποκειμένη αὐτῇ.", "seq": 3253}
{"id": "Elias_Passim_3254", "series": "CAG", "text": "λέγεται δὲ ἐξ ἀναλογίας, ὅτι δύναται καὶ μετὰ ἀναλογίας πλακῆναι οὕτως·", "seq": 3254}
{"id": "Elias_Passim_3255", "series": "CAG", "text": "ὅτι ὃν λόγον ἔχει ἡ ἄτομος οὐσία πρὸς πάντα τὰ παρ᾿ αὐτὴν ὑποκειμένη αὐτοῖς καὶ διὰ τοῦτ᾿ οὖν μάλιστα οὐσία λεγομένη, τοῦτον τὸν λόγον ἔχει καὶ ἡ εἰδικὴ πρὸς τὴν γενικήν·", "seq": 3255}
{"id": "Elias_Passim_3256", "series": "CAG", "text": "ὑπόκειται γὰρ αὐτῇ καὶ διὰ τοῦτο μᾶλλόν ἐστιν οὐσία.", "seq": 3256}
{"id": "Elias_Passim_3257", "series": "CAG", "text": "καὶ ταῦτα μὲν ἐν τούτοις.", "seq": 3257}
{"id": "Elias_Passim_3258", "series": "CAG", "text": "Ἀποροῦσι δέ τινες ὅτι πῶς λέγει μᾶλλον οὐσίαν καὶ ἧττον οὐσίαν αὐτός, ὡς ὂν οὕτω ἓν ἴδιον καὶ τοῦτο, μέλλων καταλέγειν τὰ ἴδια τῆς οὐσίας καὶ ἓν ἴδιον καὶ τοῦτο λέγειν τὸ μὴ ἐπιδέχεσθαι τὸ μᾶλλον καὶ ἧττον.", "seq": 3258}
{"id": "Elias_Passim_3259", "series": "CAG", "text": "καὶ λέγομεν ὅτι καὶ ἐπιδέχεται τὸ μᾶλλον καὶ ἧττον καὶ οὐκ ἐπιδέχεται·", "seq": 3259}
{"id": "Elias_Passim_3260", "series": "CAG", "text": "οὐσία μὲν γὰρ οὐσίᾳ παραβαλλομένη, οἷον γενικὴ πρὸς εἰδικήν, ἐπιδέχεται τὸ μᾶλλον καὶ ἧττον, αὐτὴ δὲ πρὸς ἑαυτὴν παραβαλλομένη ἀνεπίτατός ἐστι καὶ ἀνάνετος·", "seq": 3260}
{"id": "Elias_Passim_3261", "series": "CAG", "text": "οὐδεὶς γὰρ λέγει μᾶλλον ἄνθρωπον Πλάτωνα καὶ ἧττον ἄνθρωπον Σωκράτην.", "seq": 3261}
{"id": "Elias_Passim_3262", "series": "CAG", "text": "Διὰ τί, φασίν, ὥσπερ τὴν ἄτομον οὐσίαν πρώτην ἐκάλεσεν οὐσίαν δι᾿ ἃς εἴπομεν αἰτίας, μὴ καὶ τὴν εἰδικὴν δευτέραν καὶ τὴν γενικὴν τρίτην ἐκάλεσεν, ἀλλ᾿ ἑνὶ ὀνόματι δευτέρας ἐκάλεσε τὰς εἰδικὰς καὶ γενικάς;", "seq": 3262}
{"id": "Elias_Passim_3263", "series": "CAG", "text": "καὶ λέγομεν ὅτι τούτου ἔτυχον τοῦ ὀνόματος, ἐπειδὴ μίαν καὶ τὴν αὐτὴν αὐταῖς χρείαν παρέχεται ἡ ἄτομος οὐσία πρὸς κατηγορίαν.", "seq": 3263}
{"id": "Elias_Passim_3264", "series": "CAG", "text": "2b9 Γνωριμώτερον καὶ οἰκειότερον ἀποδώσει τὸ εἶδος ἀποδιδοὺς ἢ τὸ γένος.", "seq": 3264}
{"id": "Elias_Passim_3265", "series": "CAG", "text": "Διὰ τί εἰπὼν γνωριμώτερον προσέθηκε τὸ οἰκειότερον;", "seq": 3265}
{"id": "Elias_Passim_3266", "series": "CAG", "text": "καὶ λέγομεν ὅτι τὸ γνωριμώτερον οὐ ποιεῖ μᾶλλον οὐσίαν τὴν ἄτομον, ἐπειδὴ καὶ τὰ συμβεβηκότα πολλάκις καὶ αὐτῆς τῆς ἀτόμου οὐσίας εἰσὶ γνωριμώτερα·", "seq": 3266}
{"id": "Elias_Passim_3267", "series": "CAG", "text": "οἷον ἀντὶ τοῦ εἰπεῖν ‘κάλεσον τὸν Σωκράτην’ λέγω ‘κάλεσον τὸν φιλόσοφον’.", "seq": 3267}
{"id": "Elias_Passim_3268", "series": "CAG", "text": "διὰ τοῦτο οὖν προσέθηκε τὸ οἰκειότερον·", "seq": 3268}
{"id": "Elias_Passim_3269", "series": "CAG", "text": "τὰ γὰρ γνωριμώτερα οὐ δηλοῦσι πάντως τὴν φύσιν τοῦ πράγματος, ὡς πολλὰ τῶν συμβεβηκότων, τὰ δὲ οἰκειότερα μᾶλλον δηλοῦσι.", "seq": 3269}
{"id": "Elias_Passim_3270", "series": "CAG", "text": "2b12 Τὸ μὲν γὰρ ἴδιον μᾶλλον τοῦ τινὸς ἀνθρώπου.", "seq": 3270}
{"id": "Elias_Passim_3271", "series": "CAG", "text": "Καὶ πῶς μᾶλλον ἴδιον τὸ μηδὲ ὅλως ἴδιον;", "seq": 3271}
{"id": "Elias_Passim_3272", "series": "CAG", "text": "καὶ λέγομεν, ὡς τὸ ἧττον βαρὺ μᾶλλον κοῦφον λέγομεν, οὕτω καὶ τὸ ἧττον κοινὸν μᾶλλον ἴδιόν φαμεν·", "seq": 3272}
{"id": "Elias_Passim_3273", "series": "CAG", "text": "ὁ γὰρ ἄνθρωπος ἧττον κοινὸν ὡς πρὸς τὸ ζῷον·", "seq": 3273}
{"id": "Elias_Passim_3274", "series": "CAG", "text": "τὰ μὲν γὰρ γένη κατὰ τῶν εἰδῶν κατηγορεῖται, τὰ δὲ εἴδη κατὰ τῶν γενῶν οὐκ ἀντιστρέφει, κατὰ φύσιν ἐχούσης τῆς κατηγορίας·", "seq": 3274}
{"id": "Elias_Passim_3275", "series": "CAG", "text": "ἡ <γὰρ> κατηγορία τριττή, ἢ κατὰ φύσιν ἢ παρὰ φύσιν ἢ κατὰ συμβεβηκός.", "seq": 3275}
{"id": "Elias_Passim_3276", "series": "CAG", "text": "κατὰ φύσιν, ὅταν τὰ γένη τῶν εἰδῶν κατηγορῆται, παρὰ φύσιν δέ, ὅταν τὰ εἴδη τῶν γενῶν, ὡς ἵνα εἴπῃ τις ὅτι τόδε τὸ προσερχόμενον ζῷον ἄνθρωπός ἐστιν (εὑρίσκεται γὰρ κατηγορῶν τὸν ἄνθρωπον τοῦ ζῴου), κατὰ συμβεβηκὸς δέ, ὡς ὅταν <τὰ> ἐν τῷ αὐτῷ ὑποκειμένῳ συμβεβηκότα ἀλλήλων κατηγορῆται, οἷον τοῦ Σωκράτους ὄντος φαλακροῦ καὶ φιλοσόφου λέγωμεν ὅτι ὁ φαλακρὸς φιλόσοφός ἐστιν.", "seq": 3276}
{"id": "Elias_Passim_3277", "series": "CAG", "text": "ἢ κατὰ συμβεβηκὸς ἡ κατηγορία, ὡς ὅταν ἡ οὐσία τοῦ συμβεβηκότος κατηγορῆται, οἷον ἵνα εἴπω ὅτι τὸ λευκὸν τὸ προσερχόμενον ζῷόν ἐστιν·", "seq": 3277}
{"id": "Elias_Passim_3278", "series": "CAG", "text": "εὑρίσκομαι γὰρ κατηγορῶν τοῦ συμβεβηκότος τὸ ζῷον.", "seq": 3278}
{"id": "Elias_Passim_3279", "series": "CAG", "text": "2b22 Αὐτῶν δὲ τῶν εἰδῶν ὅσα μή ἐστι γένη οὐδὲν μᾶλλον ἕτερον ἑτέρου οὐσία ἐστίν.", "seq": 3279}
{"id": "Elias_Passim_3280", "series": "CAG", "text": "Συγκρίνας ὁ Ἀριστοτέλης τὰς οὐσίας κατὰ βάθος, ὅτε τὴν ἄτομον πρὸς τὴν καθόλου παρέβαλε, δεικνὺς ὅτι μᾶλλον οὐσία, καὶ ὅτε τὴν καθόλου <πρὸς τὴν καθόλου> συνέκρινε, δεικνύων ὅτι μᾶλλον οὐσία ἡ εἰδικὴ τῆς γενικῆς, νῦν κατὰ πλάτος συγκρίνει αὐτάς, τάς τε ἀτόμους καὶ τὰς καθόλου, καί φησιν ὅτι αἱ ἄτομοι οὐσίαι ὁμοίως πᾶσι τοῖς παρ᾿ ἑαυτὰς μίαν <καὶ> τὴν αὐτὴν παρέχουσι χρείαν, ὥσπερ Σωκράτης καὶ Ἄργος ὁ κύων καὶ Ξάνθος ὁ ἵππος.", "seq": 3280}
{"id": "Elias_Passim_3281", "series": "CAG", "text": "εἰ δὲ αἱ ἄτομοι οὐσίαι, καὶ αἱ εἰδικαὶ οὐσίαι ὁμοίως οὐσίαι ὡς ἴσον ἀφεστηκυῖαι τῶν ἀτόμων οὐσιῶν.", "seq": 3281}
{"id": "Elias_Passim_3282", "series": "CAG", "text": "καὶ οὕτω μὲν ἡμεῖς.", "seq": 3282}
{"id": "Elias_Passim_3283", "series": "CAG", "text": "ὁ δὲ Ἀριστοτέλης ἄλλῃ τάξει ἐχρήσατο·", "seq": 3283}
{"id": "Elias_Passim_3284", "series": "CAG", "text": "πρῶτον γὰρ τὴν εἰδικὴν συγκρίνει καὶ τότε τὴν ἄτομον.", "seq": 3284}
{"id": "Elias_Passim_3285", "series": "CAG", "text": "καὶ ἄξιον ἀπορῆσαι διὰ τί μὴ πρῶτον τὰς ἀτόμους συνέκρινεν, ἵνα ὡς γνώμοσι ταύταις χρησάμενος οὕτω συνέκρινε τὰς εἰδικάς.", "seq": 3285}
{"id": "Elias_Passim_3286", "series": "CAG", "text": "καὶ λέγομεν ὅτι ὡς ὁμολογούμενον τοῦτο παρῆκεν·", "seq": 3286}
{"id": "Elias_Passim_3287", "series": "CAG", "text": "ἔγνωσται γὰρ τοῦτο συνήθως ὅτι ὁμοίως οὐσίαι <αἱ> ἄτομοι ἐκ τῆς ὑπογραφῆς, ὅτι ὑπερθετικαῖς φωναῖς ἐχρήσατο, τῷ κυριώτατα καὶ μάλιστα, τοῦ δὲ ὑπερθετικοῦ οὐκ ἔστιν ὑπερθετικώτερον.", "seq": 3287}
{"id": "Elias_Passim_3288", "series": "CAG", "text": "εἰ δὲ τοῦτο, οὐκ ἔστι μᾶλλον ἄτομος οὐσία ἀτόμου οὐσίας, κἂν ἀνομοιοειδὴς εἴη.", "seq": 3288}
{"id": "Elias_Passim_3289", "series": "CAG", "text": "πάλιν ἀποροῦσιν, εἰ ὁμοίως οὐσίαι αἱ ἄτομοι, ἔσται ὅδε ὁ μύρμηξ καὶ ὅδε ὁ ἥλιος ὁμοίως οὐσίαι.", "seq": 3289}
{"id": "Elias_Passim_3290", "series": "CAG", "text": "καὶ λέγομεν ὅτι κατὰ τὸν σκοπὸν τῶν Κατηγοριῶν ὁμοίως οὐσίαι·", "seq": 3290}
{"id": "Elias_Passim_3291", "series": "CAG", "text": "σκοπὸς γὰρ ταῖς Κατηγορίαις οὐ περὶ πραγμάτων ᾗ πράγματα διαλαβεῖν καὶ τὴν φύσιν αὐτῶν ζητῆσαι, ἀλλὰ καθὸ σημαίνονται ὑπὸ τοιῶνδε φωνῶν·", "seq": 3291}
{"id": "Elias_Passim_3292", "series": "CAG", "text": "τὸ γὰρ περὶ φωνῶν ζητεῖν μόνων γραμματικῶν, τὸ δὲ περὶ φύσεων τῶν ὄντων φυσιολογίας.", "seq": 3292}
{"id": "Elias_Passim_3293", "series": "CAG", "text": "καὶ ταῦτα ἐν τούτοις.", "seq": 3293}
{"id": "Elias_Passim_3294", "series": "CAG", "text": "Ὁ δὲ Ἀριστοτέλης ἀπορεῖ πρὸς ἑαυτὸν ὅτι ‘πῶς ἀνωτέρω δευτέρας οὐσίας εἶπον τὰ γένη καὶ τὰ εἴδη τῶν ἀτόμων οὐσιῶν, καὶ οὐχ ἁπλῶς τὰ γένη καὶ τὰ εἴδη;’", "seq": 3294}
{"id": "Elias_Passim_3295", "series": "CAG", "text": "καί φησιν, ἵνα μὴ τὰ συμβεβηκότα περιλάβωμεν·", "seq": 3295}
{"id": "Elias_Passim_3296", "series": "CAG", "text": "ἔστι γὰρ καὶ ἐν αὐτοῖς γένη καὶ εἴδη, ὡς τὸ χρῶμα καὶ τὸ λευκόν.", "seq": 3296}
{"id": "Elias_Passim_3297", "series": "CAG", "text": "δείκνυσιν οὖν ἐνταῦθα ὅτι τὰ γένη καὶ τὰ εἴδη τῶν πρώτων οὐσιῶν οὐσίαι εἰσί, τὰ δὲ γένη καὶ τὰ εἴδη τῶν ἀτόμων συμβεβηκότων οὔκ εἰσιν οὐσίαι.", "seq": 3297}
{"id": "Elias_Passim_3298", "series": "CAG", "text": "δείκνυσιν οὖν οὕτω λέγων·", "seq": 3298}
{"id": "Elias_Passim_3299", "series": "CAG", "text": "τὰ γένη καὶ τὰ εἴδη τῶν ἀτόμων οὐσιῶν οὐσίαν συμπληροῦσι, τὰ δὲ οὐσίαν συμπληροῦντα οὐσίαι εἰσί, τὰ γένη ἄρα καὶ τὰ εἴδη τῶν πρώτων οὐσιῶν οὐσίαι εἰσί.", "seq": 3299}
{"id": "Elias_Passim_3300", "series": "CAG", "text": "διὰ δὲ τὸ ἀνάπαλιν τοῦ κανόνος·", "seq": 3300}
{"id": "Elias_Passim_3301", "series": "CAG", "text": "ἐπειδὴ τὰ γένη καὶ τὰ εἴδη τῶν ἀτόμων συμβεβηκότων οὐσίαν οὐ συμπληροῦσι, τὰ δὲ οὐσίαν μὴ συμπληροῦντα οὐσίαι οὔκ εἰσι, τὰ γένη ἄρα καὶ τὰ εἴδη τῶν ἀτόμων συμβεβηκότων οὐσίαι οὔκ εἰσι.", "seq": 3301}
{"id": "Elias_Passim_3302", "series": "CAG", "text": "καὶ ἄλλως·", "seq": 3302}
{"id": "Elias_Passim_3303", "series": "CAG", "text": "τὰ γένη καὶ τὰ εἴδη τῶν πρώτων οὐσιῶν ὑπόκεινται τοῖς καθόλου συμβεβηκόσι, τὰ τοῖς καθόλου συμβεβηκόσιν ὑποκείμενα οὐσίαι εἰσί, τὰ γένη ἄρα καὶ τὰ εἴδη τῶν πρώτων οὐσιῶν οὐσίαι εἰσί.", "seq": 3303}
{"id": "Elias_Passim_3304", "series": "CAG", "text": "καὶ διὰ τὸ ἀνάπαλιν τοῦ κανόνος·", "seq": 3304}
{"id": "Elias_Passim_3305", "series": "CAG", "text": "ἐπειδὴ τὰ γένη καὶ τὰ εἴδη τῶν ἀτόμων συμβεβηκότων οὐχ ὑπόκεινται τοῖς καθόλου συμβεβηκόσι, τὰ τοῖς καθόλου συμβεβηκόσι μὴ ὑποκείμενα οὐσίαι οὔκ εἰσι, τὰ γένη ἄρα καὶ τὰ εἴδη τῶν ἀτόμων συμβεβηκότων οὐσίαι οὔκ εἰσιν.", "seq": 3305}
{"id": "Elias_Passim_3306", "series": "CAG", "text": "2b22 Αὐτῶν δὲ τῶν εἰδῶν ὅσα μή ἐστι γένη.", "seq": 3306}
{"id": "Elias_Passim_3307", "series": "CAG", "text": "Καλῶς εἶπεν ὅσα μή ἐστι γένη, ἵνα μὴ ὑπάλληλά τις λάβῃ·", "seq": 3307}
{"id": "Elias_Passim_3308", "series": "CAG", "text": "<ἐὰν γὰρ ὑπάλληλά τις λάβῃ>, οὐκέτι εἶδος εἴδει συγκρίνει, ἀλλ᾿ εἶδος γένει, ὅπερ νῦν ἡμῖν οὐ πρόκειται ζητεῖν.", "seq": 3308}
{"id": "Elias_Passim_3309", "series": "CAG", "text": "3a7 Κοινὸν δὲ κατὰ πάσης οὐσίας τὸ μὴ ἐν ὑποκειμένῳ εἶναι.", "seq": 3309}
{"id": "Elias_Passim_3310", "series": "CAG", "text": "Δείξας ὁ Ἀριστοτέλης τὰ οἷς ὑπάρχει ἡ οὐσία διὰ τῆς διαιρέσεως, ὅτε τὴν πρώτην πρὸς τὴν καθόλου παρέβαλλε, λέγων αὐτὴν μᾶλλον οὐσίαν, καὶ ὅτε τὴν καθόλου πρὸς τὴν καθόλον, λέγων τὴν εἰδικὴν τῆς γενικῆς μᾶλλον οὐσίαν, καὶ κατὰ πλάτος πάλιν συγκρίνας, ὅτε τὰς ἀτόμους ἔλεγεν ὅτι ὁμοίως οὐσίαι εἰσί, νῦν δείκνυσι καὶ τὰ ὑπάρχοντα τῇ οὐσίᾳ καὶ καταλέγει τὰ ἴδια τῆς οὐσίας.", "seq": 3310}
{"id": "Elias_Passim_3311", "series": "CAG", "text": "καὶ δέον ὁρισμὸν εἰπεῖν ἐπὶ τῆς οὐσίας τοῦτο οὐ ποιεῖ, ἐπειδὴ γένος γενικώτατον ἡ οὐσία, τοῦ δὲ γενικωτάτου γένους οὐκ ἔστι γένος οὔτε συστατικαὶ διαφοραί, ἐξ ὧν καὶ πᾶς ὁρισμὸς λαμβάνεται·", "seq": 3311}
{"id": "Elias_Passim_3312", "series": "CAG", "text": "ἐφ᾿ ὧν δὲ ὁρισμὸν ἀποδοῦναι οὐκ εὐποροῦμεν, ἀγαπῶμεν κἂν διὰ τῶν ἰδίων αὐτῶν ἀποδιδόναι.", "seq": 3312}
{"id": "Elias_Passim_3313", "series": "CAG", "text": "διὰ τοῦτο οὖν ὁ Ἀριστοτέλης μὴ δυνηθεὶς εἰπεῖν ὁρισμὸν τῆς οὐσίας, τὰ ἴδια αὐτῆς καταλέγει·", "seq": 3313}
{"id": "Elias_Passim_3314", "series": "CAG", "text": "ἔχει γὰρ ὁμοιότητα ὁ ὁρισμὸς καὶ τὸ ἴδιον τῷ ἑκάτερον ἀντιστρέφειν καὶ μόνῳ καὶ παντὶ καὶ ἀεὶ ὑπάρχειν.", "seq": 3314}
{"id": "Elias_Passim_3315", "series": "CAG", "text": "καταλέγει οὖν τὰ ἴδια τῆς οὐσίας καί φησιν ὅτι κοινὸν κατὰ πάσης οὐσίας τὸ μὴ ἐν ὑποκειμένῳ εἶναι.", "seq": 3315}
{"id": "Elias_Passim_3316", "series": "CAG", "text": "διὸ καὶ ἀποροῦσιν ὅτι τί δήποτε ἴδια προθέμενος εἰπεῖν κονοῦ ἐμνήσθη.", "seq": 3316}
{"id": "Elias_Passim_3317", "series": "CAG", "text": "καὶ λέγουσι πρὸς τοῦτό τινες ὅτι οὐκ ἄτοπον τὸ αὐτὸ καὶ κοινὸν εἶναι καὶ ἴδιον, ὡς τὸ γελαστικὸν πρὸς μὲν τὸ ὁμοιοειδὲς κοινόν, ἴδιον δὲ ὡς πρὸς τὰ ἀνομοιοειδῆ.", "seq": 3317}
{"id": "Elias_Passim_3318", "series": "CAG", "text": "ἀλλ᾿ εἰ τὸ αὐτὸ καὶ κοινὸν καὶ ἴδιον δύναται εἶναι, διὰ τί μὴ φύσει ἴδιον αὐτὸ ἐκάλεσε τῷ οἰκείῳ ὀνόματι;", "seq": 3318}
{"id": "Elias_Passim_3319", "series": "CAG", "text": "ἀλλὰ τούτου τὴν αἰτίαν ἐροῦμεν·", "seq": 3319}
{"id": "Elias_Passim_3320", "series": "CAG", "text": "καθ᾿ ἕκαστον γὰρ ἴδιον ἐφ᾿ ἑκάστης κατηγορίας δύο ζητεῖ ὁ φιλόσοφος, εἰ πάσῃ ὑπάρχει [τῇ οὐσίᾳ] ἢ οὐ πάσῃ καὶ εἰ μόνῃ ἢ οὐ μόνῃ·", "seq": 3320}
{"id": "Elias_Passim_3321", "series": "CAG", "text": "καὶ εἰ μὲν εὕρῃ ὅτι πάσῃ μὲν ὑπάρχει οὐ μόνη δέ, κοινὸν αὐτὸ καλεῖ, εἰ δὲ μόνῃ μὲν ὑπάρχει οὐ πάσῃ δέ, ἴδιον αὐτὸ καλεῖ·", "seq": 3321}
{"id": "Elias_Passim_3322", "series": "CAG", "text": "τὰ γὰρ ἴδια στενοχωρεῖσθαι θέλοντα τῷ μόνῳ χαρακτηρίζεται καὶ οὐ τῷ παντί, ὥσπερ τὰ κοινὰ τῷ παντὶ καὶ οὐ τῷ μόνῳ.", "seq": 3322}
{"id": "Elias_Passim_3323", "series": "CAG", "text": "καθ᾿ ἑκάστην δὲ κατηγορίαν προτάττει τὰ ψευδῆ ἴδια τῶν ἀληθῶν, ἵνα οἷον κεκαθαρμένοις ἡμῖν καθαρὰν προσαγάγῃ τὴν ἀλήθειαν, ὥς φησιν ὁ Πλάτων ‘μὴ καθαροῖς καθαροῦ ἐφάπτεσθαι μὴ θεμιτόν’.", "seq": 3323}
{"id": "Elias_Passim_3324", "series": "CAG", "text": "καὶ κυρίως μὲν ἴδιον τὸ μόνῳ καὶ παντὶ καὶ ἀεὶ ὑπάρχον.", "seq": 3324}
{"id": "Elias_Passim_3325", "series": "CAG", "text": "ἀλλὰ τοιοῦτον ἐπὶ τῆς οὐσίας οὐχ εὗρεν ὁ Ἀριστοτέλης ἀποδοῦναι, ἀλλὰ ψευδῆ καταλέγει, κἀν τούτοις ἧττον ἴδιον τὸ πάσῃ μὲν ὑπάρχον οὐ μόνῃ δέ, μᾶλλον δὲ ἴδιον τὸ μόνῃ μὲν ὑπάρχον οὐ πάσῃ δέ.", "seq": 3325}
{"id": "Elias_Passim_3326", "series": "CAG", "text": "εὐθὺς οὖν τὸ πρῶτον λεγόμενον ἧττόν ἐστιν ἴδιον, διὸ καὶ προέταξεν αὐτὸ λέγων ὅτι κοινὸν πάσης οὐσίας τὸ μὴ ἐν ὑποκειμένῳ εἶναι.", "seq": 3326}
{"id": "Elias_Passim_3327", "series": "CAG", "text": "καὶ ὅτι μὲν πάσῃ οὐσίᾳ ὑπάρχει νῦν δεικνύει, ὅτι δὲ οὐ μόνῃ ἐφεξῆς δείξει.", "seq": 3327}
{"id": "Elias_Passim_3328", "series": "CAG", "text": "ὅτι δὲ πάσῃ τῇ οὐσίᾳ ὑπάρχει τὸ μὴ εἶναι ἐν ὑποκειμένῳ, δείκνυσι δύο λήμματα βραχύτατα προλαμβάνων, τὴν διαίρεσιν τῆς οὐσίας, ὅτι ἡ οὐσία ἢ πρώτη ἢ δευτέρα, καὶ τὰς ὑπογραφὰς αὐτῶν, ὅτι ἡ μὲν πρώτη οὐσία οὔτε καθ᾿ ὑποκειμένου οὔτε ἐν ὑποκειμένῳ, ἡ δὲ δευτέρα καθ᾿ ὑποκειμένου μέν, οὐκ ἐν ὑποκειμένῳ δέ.", "seq": 3328}
{"id": "Elias_Passim_3329", "series": "CAG", "text": "εἰ δὲ ταῦτα οὕτως ἔχει, οὐδεμία οὐσία ἐστὶν ἐν ὑποκειμένῳ.", "seq": 3329}
{"id": "Elias_Passim_3330", "series": "CAG", "text": "δείκνυσι δὲ καὶ ἴδιον ὅτι οὔτε αἱ δεύτεραι οὐσίαι ἐν ὑποκειμένῳ λέγων οὕτως·", "seq": 3330}
{"id": "Elias_Passim_3331", "series": "CAG", "text": "αἱ δεύτεραι οὐσίαι συνωνύμως κατηγοροῦνται τῶν πρώτων οὐσιῶν, τὰ δὲ ἐν ὑποκειμένῳ ὄντα οὐδέποτε συνωνύμως κατηγοροῦνται τῶν πρώτων οὐσιῶν, ἀλλ᾿ ἢ ὁμωνύμως, ὡς τὸ λευκὸν τοῦ Σωκράτους, ἢ παρωνύμως, ὡς ἀπὸ τῆς γραμματικῆς ὁ γραμματικός, ἢ ἑτερωνύμως, ὡς ἀπὸ τῆς ἀρετῆς ὁ σπουδαῖος·", "seq": 3331}
{"id": "Elias_Passim_3332", "series": "CAG", "text": "αἱ δεύτεροι ἄρα οὐσίαι οὔκ εἰσιν ἐν ὑποκειμένῳ.", "seq": 3332}
{"id": "Elias_Passim_3333", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ αἱ δεύτεραι οὐσίαι τῷ καθ᾿ ὑποκειμένου λέγεσθαι φαντασίαν παρέχουσι τοῦ ἐν ὑποκειμένῳ εἶναι, δείκνυσιν ὅτι οὔκ εἰσιν ἐν ὑποκειμένῳ λέγων οὕτως·", "seq": 3333}
{"id": "Elias_Passim_3334", "series": "CAG", "text": "εἰ ἦσαν, φησίν, ἐν ὑποκειμένῳ, οὐ δήπου ὑποκειμένοις ἐχρῶντο τοῖς οἰκείοις ἀτόμοις πρὸς ὕπαρξιν, ὅπου γε καὶ αὐτὰ τὰ ὁμολογούμενα ἐν ὑποκειμένῳ εἶναι οὐ κέχρηνται ὑποκειμένοις τοῖς οἰκείοις ἀτόμοις πρὸς ὕπαρξιν, ἀλλὰ ταῖς πρώταις οὐσίαις.", "seq": 3334}
{"id": "Elias_Passim_3335", "series": "CAG", "text": "ἐὰν οὖν ἐν ὑποκειμένῳ αἱ δεύτεραι οὐσίαι <ὦσιν>, ἄτοπα πολλὰ ἔχει ὁ λόγος·", "seq": 3335}
{"id": "Elias_Passim_3336", "series": "CAG", "text": "εὑρεθήσονται γὰρ πρὸς τῷ ἐν ὑποκειμένῳ αὐτὰς εἶναι καὶ ἐν ὑποκειμένοις οὖσαι τοῖς οἰκείοις ἀτόμοις, καίτοι ἐδείχθη μηδὲν τῶν ἐν ὑποκειμένῳ τῷ οἰκείῳ ἀτόμῳ χρώμενον ὑποκειμένῳ πρὸς ὕπαρξιν.", "seq": 3336}
{"id": "Elias_Passim_3337", "series": "CAG", "text": "3a21 Οὐκ ἴδιον δὲ τοῦτο οὐσίας·", "seq": 3337}
{"id": "Elias_Passim_3338", "series": "CAG", "text": "ὑπάρχει γὰρ καὶ ταῖς διαφοραῖς.", "seq": 3338}
{"id": "Elias_Passim_3339", "series": "CAG", "text": "Δείξας ὁ Ἀριστοτέλης ὅτι πάσῃ τῇ οὐσίᾳ ὑπάρχει τὸ μὴ ἐν ὑποκειμένῳ εἶναι, νῦν δεικνύει ὅτι οὐ τῇ οὐσίᾳ μόνον ὑπάρχει, ἀλλὰ καὶ ταῖς διαφοραῖς.", "seq": 3339}
{"id": "Elias_Passim_3340", "series": "CAG", "text": "καὶ ὀφείλων ἐπιχειρῆσαι ἀπὸ τῆς ὕλης καὶ τοῦ θείου (δοκοῦσι γὰρ ταῦτα μὴ εἶναι οὐσίαι, τὸ μὲν θεῖον ὡς ὑπερούσιον καὶ ὑπὲρ φύσιν, ἡ δὲ ὕλη ὡς μηδὲν τῶν ὄντων οὖσα ἀλλὰ χείρων πάντων·", "seq": 3340}
{"id": "Elias_Passim_3341", "series": "CAG", "text": "τὰ γὰρ ἄκρα τῶν ὄντων ἐξ ἀποφάσεως ὁρίζονται, ὡς ἐμάθομεν ἀνωτέρω·", "seq": 3341}
{"id": "Elias_Passim_3342", "series": "CAG", "text": "οὐ γὰρ ἡ ὕλη ἐν ὑποκειμένῳ, ἵνα μὴ εἴπωμεν ὕλην ὕλης, οὐδὲ τὸ θεῖον ἐν ὑποκειμένῳ), ἐπειδὴ ταῦτα φυσιολογίας καὶ θεολογίας, ἐπιχειρεῖ ἀπὸ τῶν διαφορῶν, διαλεκτικοῦ ὀνόματος καὶ πράγματος·", "seq": 3342}
{"id": "Elias_Passim_3343", "series": "CAG", "text": "καὶ αἱ διαφοραὶ γάρ, φησίν, οὔκ εἰσιν ἐν ὑποκειμένῳ.", "seq": 3343}
{"id": "Elias_Passim_3344", "series": "CAG", "text": "τί φῄς, ὦ Ἀριστότελες;", "seq": 3344}
{"id": "Elias_Passim_3345", "series": "CAG", "text": "ἀντιδιέστειλας ταῖς οὐσίαις τὰς διαφορὰς ὡς τῶν διαφορῶν μὴ οὐσῶν οὐσιῶν;", "seq": 3345}
{"id": "Elias_Passim_3346", "series": "CAG", "text": "καὶ τί εἰσιν αἱ διαφοραί, ἐρησόμεθά σε, οὐσίαι ἢ συμβεβηκότα;", "seq": 3346}
{"id": "Elias_Passim_3347", "series": "CAG", "text": "καὶ εἰ μὲν οὐσίαι, διὰ τί ἀντιδιέστειλας;", "seq": 3347}
{"id": "Elias_Passim_3348", "series": "CAG", "text": "εἰ δὲ συμβεβηκότα, ἐπειδὴ ἐκ τῶν διαφορῶν οἱ ὁρισμοὶ εὑρεθήσονται, αἱ οὐσίαι ἐκ τῶν συμβεβηκότων καὶ τὰ μέρη τῶν οὐσιῶν συμβεβηκότα·", "seq": 3348}
{"id": "Elias_Passim_3349", "series": "CAG", "text": "καὶ πῶς αὐτὸς λέγεις ‘τὰ μέρη τῶν οὐσιῶν οὐσίαι εἰσί’;", "seq": 3349}
{"id": "Elias_Passim_3350", "series": "CAG", "text": "τούτοις τοῖς ἀπόροις ἐνσχεθεὶς ὁ Πορφύριος οὐκ ἐνάρκησε μέσην τινὰ φύσιν εἰπεῖν οὐσίας καὶ συμβεβηκότος καὶ ταύτῃ παραθέσθαι τὰς διαφοράς, ὥσπερ οἱ ἐνεχθέντες ταῖς περὶ τοῦ φωτὸς ἀπορίαις, τῶν μὲν σῶμα τὸ φῶς λεγόντων τῶν δὲ ἀσώματον, μέσην τινὰ φύσιν ἐπέθεντο εἰπεῖν τὸ φῶς ἀσωμάτου καὶ σώματος.", "seq": 3350}
{"id": "Elias_Passim_3351", "series": "CAG", "text": "ἐπεὶ δὲ τὸ ἀμφοτέρων τῶν ἄκρων μετέχον ἢ ἐξ ἴσου αὐτῶν μετέχει ἢ μᾶλλον τοῦδε ἧττον δὲ τοῦδε, καὶ τοῦτο διχῶς, τριττὰς ἔλεγεν εἶναι τὰς διαφοράς, ἢ μᾶλλον οὐσίας ἧττον δὲ συμβεβηκότα, ὡς τὸ λογικὸν καὶ τὸ ἄλογον·", "seq": 3351}
{"id": "Elias_Passim_3352", "series": "CAG", "text": "μᾶλλον γὰρ οὐσίαι ταῦτα ὡς συμπληροῦντα τὴν οὐσίαν κἀν τῷ ὁρισμῷ παραλαμβανόμενα, ὀλίγως δὲ συμβεβηκότα ὡς ἐν τῷ ὁποῖόν τι κατηγορούμενα·", "seq": 3352}
{"id": "Elias_Passim_3353", "series": "CAG", "text": "μία γὰρ τοῦ συμβεβηκότος κατηγορία ἡ ποιότης.", "seq": 3353}
{"id": "Elias_Passim_3354", "series": "CAG", "text": "ἐξ ἴσου δὲ οὐσίαι καὶ συμβεβηκότα, ὡς ἡ ἐν πυρὶ θερμότης καὶ ἡ ἐν χιόνι λευκότης·", "seq": 3354}
{"id": "Elias_Passim_3355", "series": "CAG", "text": "ὡς γὰρ ἐν πεποιωμένῳ σώματι οὐσίαι εἰσὶν ὡς συμπληροῦντα τὴν οὐσίαν αὐτῶν, ὡς δὲ ἐν ἀποίῳ σώματι συμβεβηκότα·", "seq": 3355}
{"id": "Elias_Passim_3356", "series": "CAG", "text": "τότε γὰρ καὶ γίνονται καὶ ἀπογίνονται χωρὶς φθορᾶς τοῦ ὑποκειμένου·", "seq": 3356}
{"id": "Elias_Passim_3357", "series": "CAG", "text": "ὅτε γὰρ ἐν τῷ πυρὶ ἡ θερμότης ἐστίν, οὐσία ἐστίν, ἐπειδὴ ἀδύνατον ἐπινοηθῆναι πῦρ δίχα θερμότητος, ὅταν δὲ ἐν σιδήρῳ γένηται, συμβεβηκός ἐστι.", "seq": 3357}
{"id": "Elias_Passim_3358", "series": "CAG", "text": "μᾶλλον δὲ συμβεβηκότα ἤπερ οὐσίαι, ὡς ἡ ἐν κύκνῳ λευκότης καὶ ἡ ἐν Αἰθίοπι μελανότης·", "seq": 3358}
{"id": "Elias_Passim_3359", "series": "CAG", "text": "γίνεται γὰρ καὶ ἀπογίνεται χωρὶς φθορᾶς τοῦ ὑποκειμένου, καθά φησιν ὁ Πορφύριος, ὅτι ‘δύναται’, φησίν, ‘ἐπινοηθῆναι καὶ κύκνος μέλας καὶ κόραξ λευκὸς καὶ Αἰθίοψ ἀποβαλὼν τὴν χροίαν χωρὶς φθορᾶς τοῦ ὑποκειμένου’.", "seq": 3359}
{"id": "Elias_Passim_3360", "series": "CAG", "text": "ὅλως δὲ δοκοῦσιν οὐσίαι εἶναι διὰ τὸ παντὸς κύκνου τὸ εἶδος τὴν λευκότητα εἶναι καὶ τοῦ κόρακος τὴν μελανίαν.", "seq": 3360}
{"id": "Elias_Passim_3361", "series": "CAG", "text": "τριτταὶ οὖν αἱ διαφοραὶ κατ᾿ αὐτὸν συνάγονται.", "seq": 3361}
{"id": "Elias_Passim_3362", "series": "CAG", "text": "ἀλλ᾿, ὦ Πορφύριε, ἀντίφασιν ποιοῦσιν ἡ οὐσία καὶ τὸ συμβεβηκός, τὸ ἐν ὑποκειμένῳ καὶ τὸ οὐκ ἐν ὑποκειμένῳ·", "seq": 3362}
{"id": "Elias_Passim_3363", "series": "CAG", "text": "τῆς δὲ ἀντιφάσεως οὐδέν ἐστι μέσον·", "seq": 3363}
{"id": "Elias_Passim_3364", "series": "CAG", "text": "ἔστι γὰρ ἀντίφασις ἀντίθεσις, ἧς οὐδέν ἐστι μεταξὺ καθ᾿ αὑτό, καλῶς προσκειμένου τοῦ καθ᾿ αὑτό·", "seq": 3364}
{"id": "Elias_Passim_3365", "series": "CAG", "text": "κατὰ συμβεβηκὸς γὰρ ἐνδέχεται εἶναί τι μέσον·", "seq": 3365}
{"id": "Elias_Passim_3366", "series": "CAG", "text": "λευκοῦ γὰρ καὶ οὐ λευκοῦ οὐδέν ἐστι μέσον, εἰ μή τι δἂν συμβῇ τὸ οὐ λευκὸν ἐπὶ τοῦ μέλανος νοηθῆναι·", "seq": 3366}
{"id": "Elias_Passim_3367", "series": "CAG", "text": "τότε γὰρ εὑρίσκεται μέσον τῆς ἀντιφάσεως, εἰ καὶ κατὰ συμβεβηκός.", "seq": 3367}
{"id": "Elias_Passim_3368", "series": "CAG", "text": "τί οὖν δεῖ εἰπεῖν;", "seq": 3368}
{"id": "Elias_Passim_3369", "series": "CAG", "text": "ὅτι οὐσίαι μὲν αἱ διαφοραί, οὐσίαι δὲ οὐχ αἱ νῦν προκείμεναι ἡμῖν εἰς ἐπίσκεψιν αἱ συνεγνωσμέναι τῷ πολλῷ ἀνθρώπῳ·", "seq": 3369}
{"id": "Elias_Passim_3370", "series": "CAG", "text": "ὁ γὰρ πολὺς ἄνθρωπος καὶ ζῷον λέγει καὶ ἄνθρωπον καὶ Σωκράτης.", "seq": 3370}
{"id": "Elias_Passim_3371", "series": "CAG", "text": "εἰ δὲ ἐρεῖς ‘τί οὖν οὐ λέγουσι λογικὸν καὶ ἄλογον, ἅπερ εἰσὶ διαφοραί;’", "seq": 3371}
{"id": "Elias_Passim_3372", "series": "CAG", "text": ", λέγομεν ὅτι τὸ λογικὸν καὶ ἄλογον συνθέτων πραγμάτων εἰσὶν ὀνόματα, λογικότητα δὲ καὶ ἀλογίαν ὁ πολὺς ἄνθρωπος οὐκ οἶδεν, ἅπερ εἰσὶ διαφοραί.", "seq": 3372}
{"id": "Elias_Passim_3373", "series": "CAG", "text": "διὰ τοῦτο οὖν ἀντιδιέστειλε τὰς διαφορὰς ταῖς οὐσίαις.", "seq": 3373}
{"id": "Elias_Passim_3374", "series": "CAG", "text": "καὶ ταῦτα μὲν ἐν τούτοις.", "seq": 3374}
{"id": "Elias_Passim_3375", "series": "CAG", "text": "Ἐπειδὴ δὲ ᾔσθετο ἑαυτοῦ ὁ Ἀριστοτέλης τὰς διαφορὰς συμβεβηκότα ποιήσαντος τῷ ἀντιδιελεῖν ταῖς οὐσίαις, ἐπάγει ὅτι τὰ μέρη τῶν οὐσιῶν οὐσίαι, αἱ διαφοραὶ δὲ μέρη τῶν ὁρισμῶν καὶ οὐσίαν συμπληροῦσιν, αἱ διαφοραὶ ἄρα οὐσίαι ὡς μέρη οὐσιῶν.", "seq": 3375}
{"id": "Elias_Passim_3376", "series": "CAG", "text": "μὴ ταραττέτω δὲ ἡμᾶς ὁ λόγος ὁ λέγων ὅτι τὰ μέρη τῶν οὐσιῶν συμβεβηκότα·", "seq": 3376}
