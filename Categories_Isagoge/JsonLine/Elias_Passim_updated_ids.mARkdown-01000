{"id": "Elias_Passim_4069", "series": "CAG", "text": "κατὰ μίαν γὰρ αἴσθησιν, ὡς μεμαθήκαμεν ἐν τοῖς προλαβοῦσι, προὔχει τῶν ἄλλων ζῴων ὁ ἄνθρωπος, λέγω δὴ τὴν ἁφήν (διὸ καὶ ἄτριχον τὸ θέναρ ἐδημιούργησεν ἡ φύσις, ἵνα μὴ ἐν ταῖς μαντείαις ἐμποδίζηται, λέγω δὴ τοῖς σφυγμοῖς)·", "seq": 4069}
{"id": "Elias_Passim_4070", "series": "CAG", "text": "κατὰ γὰρ τὰς ἄλλας αἰσθήσεις νικᾶται ὑπὸ τῶν ἄλλων ζῴων, κατὰ μὲν τὴν ὄψιν ὑπὸ τοῦ ἀετοῦ, κατὰ δὲ τὴν ἀκοὴν ὑπὸ τῶν χηνῶν, κατὰ δὲ τὴν γεῦσιν ὑπὸ γαλῆς.", "seq": 4070}
{"id": "Elias_Passim_4071", "series": "CAG", "text": "ἀλλ᾿ οὐδὲ ὡς ὁρᾶται τὰ πράγματα, οὕτω καὶ ἔστιν·", "seq": 4071}
{"id": "Elias_Passim_4072", "series": "CAG", "text": "ἰδοὺ γὰρ ὁ ἥλιος ποδιαῖος φαίνεται ὁ ἑκατοντάκις ἑβδομηκονταπλασίων τῆς γῆς ὤν, καὶ ἡ κώπη κεκλασμένη ὁρᾶται ἐν τῷ ὕδατι μὴ οὖσα κεκλασμένη.", "seq": 4072}
{"id": "Elias_Passim_4073", "series": "CAG", "text": "ἀλλ᾿ οὐδὲ τὸ δοκοῦν ἑκάστῳ ἀληθές ἐστι·", "seq": 4073}
{"id": "Elias_Passim_4074", "series": "CAG", "text": "τί γὰρ ποιήσομεν τοὺς παραφρονοῦντας, οἵτινες ὀστρακίνους ἑαυτοὺς νομίζουσι καὶ δοκοῦσιν ἀποφεύγειν, μὴ ὁ οὐρανὸς αὐτοῖς ἐπιπέσῃ τοῦ Ἄτλαντος αὐτὸν διὰ τὸν κάματον ἀποσεισαμένου;", "seq": 4074}
{"id": "Elias_Passim_4075", "series": "CAG", "text": "ἤδη δὲ καὶ Πλάτωνι εὐθύνας δέδωκεν αὕτη ἡ δόξα·", "seq": 4075}
{"id": "Elias_Passim_4076", "series": "CAG", "text": "φησὶ γὰρ πρὸς αὐτοὺς ὁ Πλάτων·", "seq": 4076}
{"id": "Elias_Passim_4077", "series": "CAG", "text": "‘ἡμεῖς, Πρωταγόρα, λέγοντές σε ψεύδεσθαι, ἀληθεύομεν ἢ ψευδόμεθα;", "seq": 4077}
{"id": "Elias_Passim_4078", "series": "CAG", "text": "εἰ μὲν γὰρ ἀληθεύομεν ἡμεῖς, ψεύδῃ καὶ ἔστι τὸ ψεῦδος, εἰ δὲ ψευδόμεθα, καὶ οὕτως ἔστι τὸ ψεῦδος’.", "seq": 4078}
{"id": "Elias_Passim_4079", "series": "CAG", "text": "διὸ καὶ ἐπάγει ὅτι Πρωταγόρας κἂν ἀληθεύῃ, ψεύδεται, κἂν ψεύδηται, ψεύδεται, πάντως ἄρα ψεύδεται.", "seq": 4079}
{"id": "Elias_Passim_4080", "series": "CAG", "text": "Ἄλλοι δέ φασιν ὅτι οὐδὲν τῶν ὄντων πρός τι·", "seq": 4080}
{"id": "Elias_Passim_4081", "series": "CAG", "text": "ἡ γὰρ φύσις πάντα καθ᾿ αὑτὰ ἐποίησε, τάξεως τῶν πρός τι μὴ φροντίσασα, ὥσπερ καὶ ὁ τέκτων ἐντίθησι τὰς δοκοὺς τῇ ὀροφῇ μὴ φροντίσας ποία δεξιὰ ἢ ποία ἀριστερά, ἀλλ᾿ ἡμεῖς ὕστερον τὴν μὲν δεξιάν φαμεν τὴν δὲ ἀριστεράν.", "seq": 4081}
{"id": "Elias_Passim_4082", "series": "CAG", "text": "πρὸς ὅ φαμεν ὅτι καὶ τάξεως ἐφρόντισεν ἡ φύσις·", "seq": 4082}
{"id": "Elias_Passim_4083", "series": "CAG", "text": "τὰ γὰρ ὑγρὰ στοιχεῖα ἐν μέσῳ τῶν ξηρῶν ἔταξεν, ἵνα συνέχηται καὶ συσχηματίζηται αὐτοῖς, καὶ τὸ ἧπαρ ἀεὶ ἐν τοῖς δεξιοῖς, καὶ τὰ οὐράνια περιέχει τὰ ὑποσέληνα, ἐπεὶ εἰ μηδὲν ἦν τῶν ὄντων πρός τι, ἀνῄρητο ἂν καὶ ἡ πρόνοια·", "seq": 4083}
{"id": "Elias_Passim_4084", "series": "CAG", "text": "ἡ γὰρ πρόνοια τοῦ προνοουμένου ἐστὶ πρόνοια καὶ ἡ γνῶσις γνωστοῦ ἐστι γνῶσις.", "seq": 4084}
{"id": "Elias_Passim_4085", "series": "CAG", "text": "ἄλλοι δὲ πάντα τὰ ὄντα πρός τι εἶπον, ἐπειδὴ τὰ πρός τι οἰκείαν ὕλην οὐκ ἔχει, ἀλλ᾿ ἐν ταῖς ἐννέα κατηγορίαις θεωρεῖται, καὶ οὐδὲν τῶν ὄντων πρός τι, ἐπειδὴ οὐδὲν μόνως πρός τι, ἀλλ᾿ ἢ πρός τι καὶ οὐσία ἢ πρός τι καὶ ποσὸν ἢ πρός τι καὶ ποιόν.", "seq": 4085}
{"id": "Elias_Passim_4086", "series": "CAG", "text": "Ἀριστοτέλης δὲ τῶν ὄντων τὰ μὲν πρός τι τὰ δὲ οὐ πρός τι·", "seq": 4086}
{"id": "Elias_Passim_4087", "series": "CAG", "text": "οὐσία γὰρ καὶ ποιὸν καὶ ποσὸν καθ᾿ αὑτό, τὰ δὲ ἐκ τῆς τούτων συμπλοκῆς ἀναφαίνονται.", "seq": 4087}
{"id": "Elias_Passim_4088", "series": "CAG", "text": "6a36 Πρός τι δὲ τὰ τοιαῦτα λέγεται.", "seq": 4088}
{"id": "Elias_Passim_4089", "series": "CAG", "text": "Τέταρτον ἦν κεφάλαιον τῶν προτεθέντων τὸ ζητῆσαι τίς ἡ διδασκαλία τῶν πρός τι.", "seq": 4089}
{"id": "Elias_Passim_4090", "series": "CAG", "text": "ἰστέον τοίνυν ὅτι τοιούτῳ κέχρηται τρόπῳ διδασκαλίας τῷ ῥηθησομένῳ·", "seq": 4090}
{"id": "Elias_Passim_4091", "series": "CAG", "text": "πρῶτον ὁρίζεται τὰ πρός τι, λέγων ὅτι πρός τί ἐστιν ὅσα αὐτὰ ἅπερ ἐστὶν ἑτέρων εἶναι λέγεται.", "seq": 4091}
{"id": "Elias_Passim_4092", "series": "CAG", "text": "αὕτη δέ ἐστιν ἡ ψευδὴς ὑπογραφὴ καὶ Πλατωνική, ἥντινα ἐλέγξει ἐν τοῖς κατὰ μέρος αὐτός.", "seq": 4092}
{"id": "Elias_Passim_4093", "series": "CAG", "text": "δεύτερον καταλέγει τὰ ἴδια τῶν πρός τι, τὰ ψευδῆ καὶ ἀληθῆ.", "seq": 4093}
{"id": "Elias_Passim_4094", "series": "CAG", "text": "τέσσαρα δὲ τῶν πρός τι ἴδια, τὸ μηδὲν ἔχειν ἐναντίον καὶ τὸ μὴ ἐπιδέχεσθαι τὸ μᾶλλον καὶ τὸ ἧττον καὶ τὸ πρὸς ἀντιστρέφοντα λέγεσθαι καὶ τὸ ἅμα τῇ φύσει εἶναι.", "seq": 4094}
{"id": "Elias_Passim_4095", "series": "CAG", "text": "ποῖα δὲ ἀληθῆ καὶ ποῖα ψευδῆ, προϊὼν διδάξει.", "seq": 4095}
{"id": "Elias_Passim_4096", "series": "CAG", "text": "τρίτον λέγει ἀνθορισμὸν αὐτῷ δοκοῦντα ὅτι πρός τί ἐστιν οἷς τὸ εἶναι ἡ πρὸς ἕτερον σχέσις.", "seq": 4096}
{"id": "Elias_Passim_4097", "series": "CAG", "text": "τέταρτον ἀπορίαν τινὰ τίθησι μεταξὺ τοῦ ὁρισμοῦ καὶ ἀνθορισμοῦ, ἑπομένην μὲν τῷ ὁρισμῷ λυομένην δὲ ὑπὸ τοῦ ἀνθορισμοῦ·", "seq": 4097}
{"id": "Elias_Passim_4098", "series": "CAG", "text": "ᾧ γὰρ ἄτοπον ἕπεται, ἐκεῖνο ἄτοπον, ᾧ δὲ μηδὲν ἄτοπον ἀκολουθεῖ, τοὐναντίον δὲ καὶ τὰ ἄλλοις ἑπόμενα ἄτοπα δύναται διαλύειν, ἐκεῖνο ἀληθές.", "seq": 4098}
{"id": "Elias_Passim_4099", "series": "CAG", "text": "οὗτος ὁ τρόπος τῆς διδασκαλίας τῶν πρός τι.", "seq": 4099}
{"id": "Elias_Passim_4100", "series": "CAG", "text": "ἐν οἷς τὸ τέταρτον.", "seq": 4100}
{"id": "Elias_Passim_4101", "series": "CAG", "text": "Πέμπτον ἦν κεφάλαιον ζητῆσαι πῶς δεῖ ἐπιγράφειν, Περὶ τοῦ πρός τι ἑνικῶς ἢ Περὶ τῶν πρός τι πληθυντικῶς.", "seq": 4101}
{"id": "Elias_Passim_4102", "series": "CAG", "text": "καὶ δεῖ εἰδέναι ὅτι ἑκατέρως δυνατόν, καὶ ἑνικῶς ἐπιγράφειν, ἐὰν πρὸς τὴν σχέσιν ἐπιβλέψωμεν (μία γὰρ ἡ σχέσις), εἰ δὲ πρὸς τὰ τὴν σχέσιν ἔχοντα, πληθυντικῶς·", "seq": 4102}
{"id": "Elias_Passim_4103", "series": "CAG", "text": "ταῦτα γὰρ τοὐλάχιστον δύο·", "seq": 4103}
{"id": "Elias_Passim_4104", "series": "CAG", "text": "ἓν γὰρ πρᾶγμα πρός τι οὐ δύναται εἶναι.", "seq": 4104}
{"id": "Elias_Passim_4105", "series": "CAG", "text": "καὶ ἀληθὴς ἡ ἑνικὴ ἐπιγραφή, ἐπειδὴ καὶ ἡ σχέσις μία·", "seq": 4105}
{"id": "Elias_Passim_4106", "series": "CAG", "text": "ὡς γὰρ μιᾶς οὔσης τῆς σχέσεως δέκα τὰς κατηγορίας φαμέν, ὡς τοῦ πρός τι ἑνικῶς λαμβανομένου.", "seq": 4106}
{"id": "Elias_Passim_4107", "series": "CAG", "text": "σαφὴς δὲ ἡ πληθυντικὴ ἐπιγραφή, ὡς καὶ Ἀριστοτέλης ἐπιγράφει τὰ πρός τι πανταχοῦ κἀν ταῖς ὑπογραφαῖς κἀν τοῖς ἰδίοις λέγων.", "seq": 4107}
{"id": "Elias_Passim_4108", "series": "CAG", "text": "οὕτως καὶ ἐπὶ τῆς ποιότητος Περὶ ποιοῦ καὶ ποιότητος ἐπιγράψας, ἵνα σαφῆ ποιήσῃ τὴν ἐπιγραφήν (ποιὸν δέ ἐστι τὸ δεδεγμένον τὴν ποιότητα), ** ἵνα ἐκ τούτου ὡς σαφεστέρου εἰς ἔννοιαν ἔλθωμεν τῶν ἀσαφῶν·", "seq": 4108}
{"id": "Elias_Passim_4109", "series": "CAG", "text": "ἀσαφῆ γὰρ τὰ μετεχόμενα καθ᾿ αὑτά.", "seq": 4109}
{"id": "Elias_Passim_4110", "series": "CAG", "text": "ἐν οἷς καὶ τὸ <πέμπτον> κεφάλαιον.", "seq": 4110}
{"id": "Elias_Passim_4111", "series": "CAG", "text": "Ἀποροῦσι δὲ λέγοντες, εἰ ἐξὸν ἐπὶ πάσης κατηγορίας τὰ πέντε ταῦτα ζητῆσαι κεφάλαια (ἑκάστη γὰρ λέγεται καὶ διδάσκεται καὶ ἔστι καὶ γένος ἐστὶ καὶ συνηρίθμηται ταῖς ἄλλαις), πῶς ἐνταῦθα ταῦτα μόνον ζητεῖται.", "seq": 4111}
{"id": "Elias_Passim_4112", "series": "CAG", "text": "καὶ λέγομεν ὅτι εὐλόγως ἐνταῦθα καὶ μόνον λόγου ἔτυχον ταῦτα·", "seq": 4112}
{"id": "Elias_Passim_4113", "series": "CAG", "text": "οὐδεμία γὰρ ἄλλη κατηγορία καὶ ἑνικῶς λέγεται καὶ πληθυντικῶς, εἰ μὴ τὰ πρός τί·", "seq": 4113}
{"id": "Elias_Passim_4114", "series": "CAG", "text": "εὐλόγως οὖν τὴν ἐπιγραφὴν ζητοῦμεν.", "seq": 4114}
{"id": "Elias_Passim_4115", "series": "CAG", "text": "ἐν οὐδεμιᾷ ἄλλῃ κατηγορίᾳ [καὶ ἑνικῶς λέγεται καὶ πληθυντικῶς] καὶ ὁρίζεται καὶ ἀνθορίζεται ὁ Ἀριστοτέλης, εἰ μὴ ἐνταῦθα·", "seq": 4115}
{"id": "Elias_Passim_4116", "series": "CAG", "text": "διὸ εὐλόγως ζητοῦμεν τίς ὁ τρόπος ὁ διδασκαλικός.", "seq": 4116}
{"id": "Elias_Passim_4117", "series": "CAG", "text": "οὐδεμία ἄλλη κατηγορία παρυφίσταται ταῖς λοιπαῖς κατηγορίαις, εἰ μὴ τὰ πρός τι·", "seq": 4117}
{"id": "Elias_Passim_4118", "series": "CAG", "text": "εἰκότως οὖν ζητοῦμεν τὸν τρόπον τῆς ὑπάρξεως.", "seq": 4118}
{"id": "Elias_Passim_4119", "series": "CAG", "text": "οὐδεμία ἄλλη κατηγορία δέκα εἴδη ἔχει, εἰ μὴ τὰ πρός τι·", "seq": 4119}
{"id": "Elias_Passim_4120", "series": "CAG", "text": "εὐλόγως ἄρα ζητοῦμεν τὴν ἀπαρίθμησιν τῶν σημαινομένων.", "seq": 4120}
{"id": "Elias_Passim_4121", "series": "CAG", "text": "ἐν οὐδεμιᾷ ἄλλῃ κατηγορίᾳ διεφώνησεν ἑαυτῷ ὁ Ἀριστοτέλης, εἰ μὴ ἐν τοῖς πρός τι, ποτὲ μὲν τέταρτα αὐτὰ τάσσων, ὡς ἐν τῇ ἀπαριθμήσει, ποτὲ δὲ τρίτα, ὡς ἐν τῇ διδασκαλίᾳ·", "seq": 4121}
{"id": "Elias_Passim_4122", "series": "CAG", "text": "διὸ ζητοῦμεν τὴν τάξιν αὐτῶν.", "seq": 4122}
{"id": "Elias_Passim_4123", "series": "CAG", "text": "6a36 Πρός τι δὲ τὰ τοιαῦτα λέγεται.", "seq": 4123}
{"id": "Elias_Passim_4124", "series": "CAG", "text": "Ἐπειδὴ τέσσαρά τινα συμπληροῖ τὴν διδασκαλίαν τῶν πρός τι, ἡ ψευδὴς αὐτῶν ὑπογραφὴ καὶ τὰ ἴδια καὶ ὁ ἀνθορισμὸς καὶ ἡ ἀπορία, ἡ παροῦσα θεωρία τὴν ψευδῆ ὑπογραφὴν τῶν πρός τι διδάσκει.", "seq": 4124}
{"id": "Elias_Passim_4125", "series": "CAG", "text": "ἔχει δὲ οὕτως·", "seq": 4125}
{"id": "Elias_Passim_4126", "series": "CAG", "text": "πρός τι δέ ἐστιν ὅσα αὐτὰ ἅπερ ἐστὶν ἑτέρων εἶναι λέγεται, ἢ ὁπωσοῦν ἄλλως.", "seq": 4126}
{"id": "Elias_Passim_4127", "series": "CAG", "text": "σαφηνίσωμεν δὲ ταύτην.", "seq": 4127}
{"id": "Elias_Passim_4128", "series": "CAG", "text": "τὸ ὅσα αὐτὰ ἅπερ ἐστί καλῶς πρόσκειται·", "seq": 4128}
{"id": "Elias_Passim_4129", "series": "CAG", "text": "τὰ γὰρ πρός τι αὐτὰ ἅπερ ἐστὶν ἑτέρων εἶναι λέγεται, ὡς πατήρ·", "seq": 4129}
{"id": "Elias_Passim_4130", "series": "CAG", "text": "καὶ αὐτὸ γὰρ τὸ πατὴρ τοῦ υἱοῦ λέγεται, ὁμοίως καὶ ὁ υἱὸς κατ᾿ αὐτὸ τὸ υἱὸς τοῦ πατρὸς λέγεται.", "seq": 4130}
{"id": "Elias_Passim_4131", "series": "CAG", "text": "καὶ τὰ πρός τι μὲν πάντως ἑτέρων εἶναι λέγεται, οὐ πάντως δὲ τὰ ἑτέρων λεγόμενα πρός τι·", "seq": 4131}
{"id": "Elias_Passim_4132", "series": "CAG", "text": "ἰδοὺ γὰρ τὸ λευκὸν λέγεται μέλανι ἐναντίον καὶ πρός τι οὐκ ἔστιν, ἐπειδὴ προῆλθε μὲν κατ᾿ ἄλλο, τὸ λευκόν, ἀποκρίνεται δὲ κατ᾿ ἄλλο·", "seq": 4132}
{"id": "Elias_Passim_4133", "series": "CAG", "text": "κατὰ γὰρ τὸ ἐναντίον.", "seq": 4133}
{"id": "Elias_Passim_4134", "series": "CAG", "text": "ἄλλο δὲ τὸ λευκὸν καὶ ἄλλο τὸ ἐναντίον·", "seq": 4134}
{"id": "Elias_Passim_4135", "series": "CAG", "text": "τὸ μὲν γὰρ λευκὸν καθ᾿ αὑτό, τὸ δὲ ἐναντίον πρός τι.", "seq": 4135}
{"id": "Elias_Passim_4136", "series": "CAG", "text": "καὶ τὰ μὲν πρός τι ἀπὸ τοῦ αὐτοῦ ἀρχόμενα καὶ εἰς τὸ αὐτὸ λήγοντα κύκλον μιμεῖται, οἷον ὁ πατὴρ υἱοῦ πατήρ, τὰ δὲ πρὸς ἄλλο λεγόμενα ἀρχόμενα μὲν ἀπὸ ἄλλου ἀποκρινόμενα δὲ κατ᾿ ἄλλο, οἷον λευκὸν μέλανι ἐναντίον, εὐθεῖαν μιμεῖται ἄλλην ἀρχὴν ἔχουσαν καὶ ἄλλο πέρας.", "seq": 4136}
{"id": "Elias_Passim_4137", "series": "CAG", "text": "καὶ ταῦτα ἐν τούτοις.", "seq": 4137}
{"id": "Elias_Passim_4138", "series": "CAG", "text": "τὸ δὲ ὁπωσοῦν ἄλλως πρόσκειται διὰ τέσσαρας αἰτίας, αἵτινες διὰ τὸ ἑτέρων λέγονται·", "seq": 4138}
{"id": "Elias_Passim_4139", "series": "CAG", "text": "πρῶτον ἵνα μὴ τοῦ ἑτέρων γενικῆς πτώσεως ὄντος νομίσωμεν πάντα πρὸς γενικὴν ἀποδίδοσθαι·", "seq": 4139}
{"id": "Elias_Passim_4140", "series": "CAG", "text": "τινὰ γὰρ καὶ πρὸς δοτικήν, ὡς ἂν εἴπω ‘φίλος φίλῳ φίλος’, καὶ πρὸς αἰτιατικήν·", "seq": 4140}
{"id": "Elias_Passim_4141", "series": "CAG", "text": "‘ὁ τύπτων τυπτόμενον τύπτει’.", "seq": 4141}
{"id": "Elias_Passim_4142", "series": "CAG", "text": "δεύτερον ἵνα μὴ τοῦ ἑτέρων πληθυντικοῦ ἀριθμοῦ ὄντος νομίσωμεν πάντα πρὸς πληθυντικὸν ἀριθμὸν ἀποδίδοσθαι·", "seq": 4142}
{"id": "Elias_Passim_4143", "series": "CAG", "text": "τινὰ γὰρ καὶ πρὸς ἑνικὸν λέγεται·", "seq": 4143}
{"id": "Elias_Passim_4144", "series": "CAG", "text": "‘τὸ μέρος ὅλου μέρος’.", "seq": 4144}
{"id": "Elias_Passim_4145", "series": "CAG", "text": "τρίτον ἵνα μὴ τοῦ ἑτέρων μοναχῶς λεχθέντος νομίσωμεν πάντα μοναχῶς ἀποδίδοσθαι·", "seq": 4145}
{"id": "Elias_Passim_4146", "series": "CAG", "text": "τινὰ γὰρ καὶ διχῶς ἀποδίδοται, οἷον τὸ ὑπερέχον ὑπερεχόμενον ὑπερέχει καὶ τὸ ὑπερέχον ὑπεροχῇ ὑπερέχει.", "seq": 4146}
{"id": "Elias_Passim_4147", "series": "CAG", "text": "τέταρτον ἵνα μὴ τοῦ ἑτέρων ἁπλοῦ ὄντος καὶ μὴ δεηθέντος προθέσεως νομίσωμεν πάντα τὰ πρός τι μὴ δεῖσθαι προθέσεως·", "seq": 4147}
{"id": "Elias_Passim_4148", "series": "CAG", "text": "τινὰ γὰρ δέονται, οἷον τὸ δωρούμενον παρὰ τοῦ δωρουμένου δωρεῖται καὶ ὁ τυπτόμενος ὑπὸ τοῦ τύπτοντος τύπτεται.", "seq": 4148}
{"id": "Elias_Passim_4149", "series": "CAG", "text": "ἐν οἷς ἡ πρᾶξις.", "seq": 4149}
{"id": "Elias_Passim_4150", "series": "CAG", "text": "6a37 Οἷον τὸ μεῖζον τοῦτο ὅπερ ἐστὶν ἑτέρου λέγεται·", "seq": 4150}
{"id": "Elias_Passim_4151", "series": "CAG", "text": "τινὸς γάρ.", "seq": 4151}
