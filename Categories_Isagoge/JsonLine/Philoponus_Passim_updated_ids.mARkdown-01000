{"id": "Philoponus_Passim_2446", "series": "CAG", "text": "οὐ γὰρ κατὰ πάθος ἐγγέγονε τῷ πυρὶ ἡ θερμότης·", "seq": 2446}
{"id": "Philoponus_Passim_2447", "series": "CAG", "text": "οὐσιωδῶς γὰρ ὑπάρχει αὐτῷ καὶ εἰδοποιὸς αὐτοῦ ἐστιν.", "seq": 2447}
{"id": "Philoponus_Passim_2448", "series": "CAG", "text": "ὁμοίως καὶ ἐπὶ τῆς τοῦ μέλιτος γλυκύτητος ἔχει ἢ τῆς ἐν χιόνι λευκότητος καὶ τῶν τοιούτων.", "seq": 2448}
{"id": "Philoponus_Passim_2449", "series": "CAG", "text": "ἡ μέντοι λευκὴ σὰρξ ἀπὸ πάθους τὴν λευκότητα ἔχει·", "seq": 2449}
{"id": "Philoponus_Passim_2450", "series": "CAG", "text": "συμβέβηκε γὰρ τὸ λευκὸν αὐτῇ καὶ οὐκ οὐσιωδῶς αὐτῇ ὑπάρχει οὐδὲ εἰδοποιὸν αὐτῇ ἐστιν.", "seq": 2450}
{"id": "Philoponus_Passim_2451", "series": "CAG", "text": "ὡσαύτως καὶ ἐπὶ τοῦ μέλανος ἐροῦμεν καὶ ἐπὶ τοῦ γλυκέος ζωμοῦ καὶ τῶν τοιούτων.", "seq": 2451}
{"id": "Philoponus_Passim_2452", "series": "CAG", "text": "πάσχει μὲν οὖν καὶ ἐπὶ τούτων ἡ αἴσθησις, ἀλλ᾿ ἐπειδὴ κυριώτερόν ἐστιν ἐπὶ τούτων τὸ ἀπὸ πάθους ἐγγενέσθαι αὐτοῖς λέγειν ἢ τὸ πάθος ἐμποιεῖν, διὰ τὸ προηγουμένως τοῦτο αὐτοῖς ὑπάρχειν δευτέρως δὲ καὶ τὸ πάθος ἐμποιεῖν, ἀπὸ τοῦ κυριωτέρου αὐτὰ ἐκαλέσαμεν·", "seq": 2452}
{"id": "Philoponus_Passim_2453", "series": "CAG", "text": "ἐφ᾿ ὧν γάρ ἐστιν ἄμφω, ἐπὶ τούτων ἄμεινόν ἐστιν ἴσως ἀπὸ τοῦ κυριωτέρου τὴν ἐπίκλησιν τῆς παθητικῆς ποιότητος γίνεσθαι.", "seq": 2453}
{"id": "Philoponus_Passim_2454", "series": "CAG", "text": "καὶ ἐπὶ τοῦ μέλιτος οὖν ἐπειδὴ ἡ γλυκύτης οὐκ ἀπὸ πάθους αὐτῷ γίνεται (χαρακτηριστικὴ γάρ ἐστιν αὐτοῦ), διὰ τοῦτο ἀπὸ τοῦ τῇ αἰσθήσει πάθος αὐτὴν ἐμποιεῖν παθητικὴ ποιότης λέγεται.", "seq": 2454}
{"id": "Philoponus_Passim_2455", "series": "CAG", "text": "9b11 Ὅτι μὲν οὖν γίνονται διὰ πάθος πολλαὶ μεταβολαὶ χρωμάτων, δῆλον.", "seq": 2455}
{"id": "Philoponus_Passim_2456", "series": "CAG", "text": "Εἰπὼν τὰ χρώματα παθητικὰς ποιότητας εἶναι τῷ ἀπὸ πάθους ἐγγίνεσθαι αὐτάς, κατασκευάζει καὶ δείκνυσιν οὕτως ἔχον.", "seq": 2456}
{"id": "Philoponus_Passim_2457", "series": "CAG", "text": "9b19 Ὅσα μὲν οὖν τῶν τοιούτων συμπτωμάτων.", "seq": 2457}
{"id": "Philoponus_Passim_2458", "series": "CAG", "text": "Τὰ χρώματα συμπτώματα εἶπεν εἶναι διὰ τὸ ἄλλοις πάθεσιν ἐπισυμβαίνειν, ὡς τῇ μακρᾷ νόσῳ ἕπεται ἡ ὠχρίασις.", "seq": 2458}
{"id": "Philoponus_Passim_2459", "series": "CAG", "text": "ἔστι δὲ καί τι χρῶμα οὐσιῶδες, ὡς τὸ λευκὸν τῷ ψιμμυθίῳ ἢ τῇ χιόνι καὶ τὸ ἐρυθρὸν τῷ αἵματι καὶ τὸ μέλαν ἐν τῷ τῆς σηπίας χυμῷ.", "seq": 2459}
{"id": "Philoponus_Passim_2460", "series": "CAG", "text": "9b27 Ὁμοίως γὰρ ποιοὶ κατὰ ταύτας λεγόμεθα.", "seq": 2460}
{"id": "Philoponus_Passim_2461", "series": "CAG", "text": "Ποιότης καθ᾿ ἣν ποιοί τινες εἶναι λέγονται·", "seq": 2461}
{"id": "Philoponus_Passim_2462", "series": "CAG", "text": "εἰ οὖν οὐ λέγονται ποιοὶ ἀπὸ τῶν εὐαποβλήτων παθῶν, δῆλον ὅτι οὐδὲ ποιότητες ταῦτα λέγονται.", "seq": 2462}
{"id": "Philoponus_Passim_2463", "series": "CAG", "text": "9b33 Ὁμοίως δὲ τούτοις καὶ κατὰ τὴν ψυχὴν παθητικαὶ ποιότητες καὶ πάθη λέγονται.", "seq": 2463}
{"id": "Philoponus_Passim_2464", "series": "CAG", "text": "Οὐ μόνον γὰρ περὶ τὸ σῶμα θεωροῦνται αἱ παθητικαὶ ποιότητες καὶ τὰ πάθη, ἀλλὰ καὶ περὶ τὴν ψυχήν.", "seq": 2464}
{"id": "Philoponus_Passim_2465", "series": "CAG", "text": "9b35 Ὅσα τε γὰρ ἐν τῇ γενέσει εὐθὺς ἀπό τινων παθῶν δυσκινήτων γεγένηται, ποιότητες λέγονται.", "seq": 2465}
{"id": "Philoponus_Passim_2466", "series": "CAG", "text": "Ὥσπερ γὰρ ἡ ἐν τῷ Αἰθίοπι μελανία ἐκ γενετῆς οὖσα παθητικὴ ποιότης λέγεται, οὕτως καὶ ἡ ἐκ γενετῆς ἔκστασις καὶ ἡ ὀργὴ παθητικὴ ποιότης λέγεται.", "seq": 2466}
{"id": "Philoponus_Passim_2467", "series": "CAG", "text": "10a2 Ὁμοίως δὲ καὶ ὅσαι ἄλλαι ἐκστάσεις μὴ φυσικαί, ἀλλ᾿ ἀπό τινων ἄλλων συμπτωμάτων γεγένηνται.", "seq": 2467}
{"id": "Philoponus_Passim_2468", "series": "CAG", "text": "Πάλιν ὥσπερ ἡ ἀπὸ μακρᾶς νόσου γενομένη ἄχροια λέγεται παθητικὴ ποιότης, οὕτως καὶ ἡ ἀπό τινος συμπτώματος ἔκστασις ἢ ἄλλο τι τοιοῦτον παθητικὴ ποιότης λέγεται.", "seq": 2468}
{"id": "Philoponus_Passim_2469", "series": "CAG", "text": "10a12 Τέταρτον δὲ γένος ποιότητος σχῆμά τε καὶ ἡ περὶ ἕκαστον ὑπάρχουσα μορφή.", "seq": 2469}
{"id": "Philoponus_Passim_2470", "series": "CAG", "text": "Τέταρτον τοῦτο εἶδος ποιότητος.", "seq": 2470}
{"id": "Philoponus_Passim_2471", "series": "CAG", "text": "γένος δὲ πάλιν φησὶν ἀντὶ τοῦ εἶδος.", "seq": 2471}
{"id": "Philoponus_Passim_2472", "series": "CAG", "text": "ἔστι δὲ σχῆμα καὶ μορφή.", "seq": 2472}
{"id": "Philoponus_Passim_2473", "series": "CAG", "text": "ἐπὶ πλέον δὲ τὸ σχῆμα τῆς μορφῆς·", "seq": 2473}
{"id": "Philoponus_Passim_2474", "series": "CAG", "text": "πᾶσα γὰρ μορφὴ καὶ σχῆμα καὶ μορφὴν ἔχει, οὐ πᾶν δὲ τὸ ἔχον σχῆμα καὶ μορφὴν ἔχει.", "seq": 2474}
{"id": "Philoponus_Passim_2475", "series": "CAG", "text": "διὰ τοῦτο γὰρ προέταξε τὸ σχῆμα τῆς μορφῆς, ἐπειδὴ κυριώτερον καὶ καθολικώτερον.", "seq": 2475}
{"id": "Philoponus_Passim_2476", "series": "CAG", "text": "ἐλέγετο δὲ καὶ πρώην ὅτι τὸ μὲν σχῆμα ἐπὶ ἀψύχων θεωρεῖται ἢ φανταστῶν, ἡ δὲ μορφὴ ἐπὶ ἐμψύχων ἤτοι φυσικῶν, καὶ ὅτι εἰ καὶ ἐπὶ ἀψύχων ποτὲ φέροιμεν τὸ τῆς μορφῆς ὄνομα, καταχρηστικώτερον τοῦτο ποιοῦμεν διὰ τὸ μιμήματα εἶναι τῶν ἐμψύχων.", "seq": 2476}
{"id": "Philoponus_Passim_2477", "series": "CAG", "text": "καὶ ταῦτα δὲ ποιότητες εἰκότως, ἐπειδὴ διάκεινταί πως κατὰ ταῦτα τὰ μετέχοντα καὶ ἀπ᾿ αὐτῶν ὀνομάζεται.", "seq": 2477}
{"id": "Philoponus_Passim_2478", "series": "CAG", "text": "10a12 Ἔτι δὲ πρὸς τούτοις εὐθύτης καὶ καμπυλότης, καὶ εἴ τι τούτοις ὅμοιόν ἐστι.", "seq": 2478}
{"id": "Philoponus_Passim_2479", "series": "CAG", "text": "Ἀπὸ γὰρ εὐθύτητος παρωνύμως εὐθεῖα γραμμὴ λέγεται, ἀπὸ δὲ τῆς καμπυλότητος ἡ καμπύλη, καὶ ἔστι πάθη τῆς γραμμῆς ἡ εὐθύτης καὶ ἡ καμπυλότης·", "seq": 2479}
{"id": "Philoponus_Passim_2480", "series": "CAG", "text": "ἰστέον γὰρ ὅτι τεσσάρων τούτων ὄντων ἐφεξῆς ἀλλήλοις, τοῦ τε σημείου καὶ τῆς γραμμῆς καὶ τῆς ἐπιφανείας καὶ τοῦ σώματος, τὸ μὲν σημεῖον ἅτε ἀμερὲς ὂν οὔτε πάθος ἀνεδέξατο οὔτε σχῆμα, πολλῷ δὲ πλέον οὐδὲ μορφήν, ἡ δὲ γραμμὴ μίαν ἔχουσα διάστασιν πάθος μόνον ἀνεδέξατο (ἢ γὰρ καμπύλη ἐστὶν ἢ εὐθεῖα ἢ εἴ τις ἄλλη λέγεται), ἡ δὲ ἐπιφάνεια δύο διαστάσεις ἔχουσα, τήν τε κατὰ μῆκος λέγω καὶ πλάτος, καὶ πάθος ἀνεδέξατο καὶ σχῆμα.", "seq": 2480}
{"id": "Philoponus_Passim_2481", "series": "CAG", "text": "πάθη μὲν οὖν ἐστι τῆς ἐπιφανείας τὸ στενόν τε καὶ τὸ πλατύ, σχήματα δὲ τρίγωνον ἢ τετράγωνον καὶ ὅσα τοιαῦτα·", "seq": 2481}
{"id": "Philoponus_Passim_2482", "series": "CAG", "text": "διότι γὰρ πᾶσα ἐπιφάνεια ὑπὸ γραμμῶν περιέχεται (ἐπιφανείας γάρ, φησὶν Εὐκλείδης, πέρατα γραμμαί), διὰ τοῦτο εἰκότως καὶ σχήματα ἀνεδέξατο·", "seq": 2482}
{"id": "Philoponus_Passim_2483", "series": "CAG", "text": "τὰ γὰρ σχήματα ἐκ γραμμῶν σύγκειται.", "seq": 2483}
{"id": "Philoponus_Passim_2484", "series": "CAG", "text": "τὸ μέντοι σῶμα τὰς τρεῖς ἔχον διαστάσεις, τήν τε κατὰ μῆκος καὶ βάθος καὶ πλάτος, καὶ πάθη ἀνεδέξατο καὶ σχήματα καὶ μορφάς·", "seq": 2484}
{"id": "Philoponus_Passim_2485", "series": "CAG", "text": "πάθη μὲν τὸ παχύ τε καὶ λεπτόν, σχήματα δὲ διότι ἢ κυβικόν ἐστιν ἢ κυλινδρικὸν ἤ τι τοιοῦτον.", "seq": 2485}
{"id": "Philoponus_Passim_2486", "series": "CAG", "text": "ἀλλὰ δὴ καὶ μορφὴν ἐπιδέχεται τὸ ἔμψυχον σῶμα.", "seq": 2486}
{"id": "Philoponus_Passim_2487", "series": "CAG", "text": "10a16 Τὸ δὲ μανὸν καὶ τὸ πυκνὸν καὶ τὸ τραχὺ καὶ τὸ λεῖον δόξειε μὲν ἂν ποιόν τι σημαίνειν, ἔοικε δὲ ἀλλότρια τὰ τοιαῦτα εἶναι τῆς περὶ τὸ ποιὸν διαιρέσεως·", "seq": 2487}
{"id": "Philoponus_Passim_2488", "series": "CAG", "text": "θέσιν γάρ τινα μᾶλλον φαίνεται τῶν μορίων ἑκάτερον δηλοῦν.", "seq": 2488}
{"id": "Philoponus_Passim_2489", "series": "CAG", "text": "Διότι γὰρ διάκειταί πως κατὰ τὴν μάνωσιν ἢ τὴν πύκνωσιν καὶ τὴν τραχύτητα καὶ τὴν λειότητα καὶ ἀπ᾿ αὐτῶν ὀνομάζεται τὰ μετέχοντα, δόξαν τινὰ ἔχουσι ποιοτήτων, οὐκ ἀληθὲς δὲ τοῦτο, ὑπὸ τὸ κεῖσθαι δὲ μᾶλλον ἀναχθήσεται·", "seq": 2489}
{"id": "Philoponus_Passim_2490", "series": "CAG", "text": "θέσιν γάρ τινα σημαίνουσι·", "seq": 2490}
{"id": "Philoponus_Passim_2491", "series": "CAG", "text": "πυκνὸν γάρ ἐστιν οὗ τὰ μόρια σύνεγγυς κεῖται ὡς μὴ δύνασθαι δέξασθαι ἑτερογενὲς σῶμα, μανὸν δὲ τὸ διεστηκότα ἔχον τὰ μόρια ὡς δύνασθαι δέξασθαι ἑτερογενὲς σῶμα.", "seq": 2491}
{"id": "Philoponus_Passim_2492", "series": "CAG", "text": "πάλιν λεῖον λέγομεν τὸ ἴσα ἀλλήλοις ἔχον τὰ μόρια καὶ ἴσως ἐξέχοντα, τραχὺ δὲ τὸ ἄνισα ἀλλήλοις κατὰ τὰς ἐξοχὰς ἔχον τὰ μόρια, οἷον λεῖον μὲν τὸ μῆλον (ὁμαλὴ γὰρ τούτου ἐστὶν ἡ ἐπιφάνεια), τραχὺ δὲ τὸ πρόσωπον, διότι ἐξ ἀνωμάλων καὶ ἀνίσων σύγκειται μορίων, στόματος καὶ ῥινὸς καὶ ὀφθαλμῶν καὶ τῶν λοιπῶν τῶν μὲν προπετῆ ἐχόντων τὴν θέσιν τῶν δὲ κοίλην·", "seq": 2492}
{"id": "Philoponus_Passim_2493", "series": "CAG", "text": "οὐκοῦν θέσιν τινὰ μᾶλλον φαίνεται τὰ μόρια αὐτῶν δηλοῦντα.", "seq": 2493}
{"id": "Philoponus_Passim_2494", "series": "CAG", "text": "καὶ τὸ μὲν τραχὺ καὶ τὸ λεῖον ὁμολογουμένως ὑπὸ τὸ κεῖσθαι ἀνάγονται διὰ τὰς εἰρημένας αἰτίας, μανὸν δὲ καὶ πυκνὸν ἐνταῦθα μόνον ἔλαβε τὸ ἐξ ἐπιτεχνήσεως·", "seq": 2494}
{"id": "Philoponus_Passim_2495", "series": "CAG", "text": "τοῦτο γάρ ἐστι τὸ ὑπὸ τὸ κεῖσθαι ἀναγόμενον, οἷον εἴ τις τὸν ἱμάντα ἐκτείνας μανὸν ποιήσει·", "seq": 2495}
{"id": "Philoponus_Passim_2496", "series": "CAG", "text": "οὐ γὰρ ὅλος δι᾿ ὅλου μανοῦται, ἀλλά τινων μορίων αὐτοῦ ἡ θέσις ἀμείβεται τῷ μᾶλλον ἀφεστηκέναι ἀλλήλων.", "seq": 2496}
{"id": "Philoponus_Passim_2497", "series": "CAG", "text": "πάλιν εἴ τις τὴν χεῖρα πληρώσειε καρύων, τὸ ἐκ πάντων σῶμα μανὸν λέγεται παρὰ τὸ μὴ ἓν εἶναι·", "seq": 2497}
{"id": "Philoponus_Passim_2498", "series": "CAG", "text": "μανὸν γὰρ λέγεται τὸ μὴ ἓν ὄν.", "seq": 2498}
{"id": "Philoponus_Passim_2499", "series": "CAG", "text": "ὁμοίως δὲ καὶ τὸ πυκνόν·", "seq": 2499}
{"id": "Philoponus_Passim_2500", "series": "CAG", "text": "ἐὰν γὰρ νοήσωμεν τὰ κάρυα συντεθρυμμένα, τὸ ἐκ πάντων σῶμα πυκνὸν ἔσται.", "seq": 2500}
{"id": "Philoponus_Passim_2501", "series": "CAG", "text": "καὶ πάλιν εἴ τις τὸν πόκον τῶν ἐρίων συνεσφιγμένον καὶ πεπυκνωμένον διαξαίνων ἀραιὸν ποιήσει, μανὸν λέγομεν.", "seq": 2501}
{"id": "Philoponus_Passim_2502", "series": "CAG", "text": "καὶ ταύτην μὲν τὴν τεχνικὴν μάνωσιν ἢ πύκνωσιν ὑπὸ τὸ κεῖσθαι εἰκότως ἐνταῦθα ἀνάγει ὡς πρὸς εἰσαγομένους διαλεγόμενος, διότι κατὰ τὴν τῶν μορίων θέσιν ἢ πυκνὰ ἢ ἀραιὰ ταῦτα λέγονται.", "seq": 2502}
{"id": "Philoponus_Passim_2503", "series": "CAG", "text": "οὐκ εἰσὶ δὲ ποιότητες, μήτε φυσικὴν ἔχοντα τὴν μάνωσιν ἢ πύκνωσιν μηδὲ ὅλα δι᾿ ὅλων ἢ πυκνὰ ὄντα ἢ μανά, ἀλλὰ κατὰ μόνην τὴν τῶν μορίων θέσιν, οὐχὶ δὲ καὶ αὐτῶν τῶν μορίων ἀναδεξαμένων τὴν ὁμοίαν τῷ ὅλῳ μάνωσιν.", "seq": 2503}
{"id": "Philoponus_Passim_2504", "series": "CAG", "text": "Ἐν δὲ τῇ Φυσικῇ ἀκροάσει ποιότητα εἶναι βούλεται τὴν φυσικὴν μάνωσιν ἢ πύκνωσιν τὴν περὶ ἓν καὶ τὸ αὐτὸ καταγινομένην ὑποκείμενον·", "seq": 2504}
{"id": "Philoponus_Passim_2505", "series": "CAG", "text": "οἷον τὸ ὕδωρ φυσικὴν ἔχον πυκνότητα καὶ ὅλον δι᾿ ὅλου ἑαυτοῦ πυκνὸν ὂν ἐὰν ταύτην ἀποβαλὸν ἀραιωθῇ, ἀὴρ γίνεται, διὸ τὸ ξεστιαῖον ὕδωρ ποιήσειε τυχὸν δεκαξεστιαῖον ἀέρα.", "seq": 2505}
{"id": "Philoponus_Passim_2506", "series": "CAG", "text": "καὶ τοῦτο γίνεται οὐκ εἰς μικρὰ μόρια τοῦ ὕδατος κατακερματιζομένου, ὥσπερ εἴ τις κονιορτοῦ τὴν χεῖρα πληρώσας ῥίψειεν ἐν ἀέρι καὶ πλεῖστον καταλάβοι τόπον ὁ κονιορτὸς τῷ ἐξηπλῶσθαι τὰ μόρια αὐτοῦ, ἐπεὶ εἰ τοῦτο ἦν, ἔδει καὶ ἡμᾶς εἰς μικρὰ διασκεδαννύντας τὸ ὕδωρ ἀέρα ποιεῖν.", "seq": 2506}
{"id": "Philoponus_Passim_2507", "series": "CAG", "text": "εἰ δέ τις εἴποι ‘ἀλλ᾿ οὐ δυνάμεθα ἡμεῖς εἰς λεπτότατα οὕτω κατακερματίζειν τὸ ὕδωρ᾿, ἀλλ᾿ εἰ καὶ μὴ ἔργῳ δυνάμεθα, οὐδ᾿ ἂν τῷ λόγῳ ὑποθώμεθα, οὐδὲ οὕτως τοῦτο δυνατόν ἐστι;", "seq": 2507}
{"id": "Philoponus_Passim_2508", "series": "CAG", "text": "τὰ γὰρ μόρια πάντως τοῦ ὕδατος ὑδάτιά ἐστι·", "seq": 2508}
{"id": "Philoponus_Passim_2509", "series": "CAG", "text": "τὰ γὰρ μέρη τῷ ὅλῳ εἰσὶν ὅμοια κατ᾿ οὐσίαν, καὶ ἐξ ὧν ἕκαστον σύγκειται, εἰς ταῦτα καὶ διαλύεται.", "seq": 2509}
{"id": "Philoponus_Passim_2510", "series": "CAG", "text": "εἰ οὖν τὸ ὕδωρ ἐκ τῶν ὁμοίων μερῶν σύγκειται ὑδάτων ὄντων (τὰ γὰρ μέρη, ὡς εἴπομεν, τῷ ὅλῳ ὅμοια), καὶ εἰς ταῦτα πάντως ἀναλυόμενον μερίζεται.", "seq": 2510}
{"id": "Philoponus_Passim_2511", "series": "CAG", "text": "ἔμελλε δὲ μηδὲ συνεχὴς εἶναι ὁ ἀήρ, ἀλλὰ κεναῖς χώραις μεταξὺ διαλαμβάνεσθαι·", "seq": 2511}
{"id": "Philoponus_Passim_2512", "series": "CAG", "text": "ἀνάγκη γὰρ ἢ συνεχῆ εἶναι τὰ μόρια τοῦ ὕδατος ἢ διῃρῆσθαι·", "seq": 2512}
{"id": "Philoponus_Passim_2513", "series": "CAG", "text": "ἅπτεσθαι γὰρ ἀδύνατον·", "seq": 2513}
{"id": "Philoponus_Passim_2514", "series": "CAG", "text": "ἁπτόμενα γὰρ εὐθὺς συνεχῆ γίνεται διὰ τὴν ὑγρότητα.", "seq": 2514}
{"id": "Philoponus_Passim_2515", "series": "CAG", "text": "εἰ μὲν οὖν διῄρηται, οὐ συνεχὴς ὁ ἀήρ, ὅπερ ἐστὶ ψεῦδος καὶ παρὰ τὴν ἐνάργειαν.", "seq": 2515}
{"id": "Philoponus_Passim_2516", "series": "CAG", "text": "εἰ δὲ συνῆπται, ὕδωρ ἔσται πάλιν τὸ ὅλον καὶ οὐκ ἀήρ.", "seq": 2516}
{"id": "Philoponus_Passim_2517", "series": "CAG", "text": "ὥστε οὐ κατακερματιζόμενον τὸ ὕδωρ ποιεῖ τὸν ἀέρα, ἀλλὰ πάντῃ τρεπόμενον καὶ ἀλλοιούμενον.", "seq": 2517}
{"id": "Philoponus_Passim_2518", "series": "CAG", "text": "ὅτι δὲ ποιότητές εἰσι ταῦτα, σαφῶς δείκνυσιν ὁ Ἀριστοτέλης ἐν τῇ Φυσικῇ·", "seq": 2518}
{"id": "Philoponus_Passim_2519", "series": "CAG", "text": "λέγει γὰρ ὅτι ὥσπερ τὸ σῶμα ποιοτήτων ὂν δεκτικὸν μεταβάλλει κατὰ ταύτας καθ᾿ ὅλον ἑαυτὸ ἐκ λευκοῦ μέλαν γινόμενον καὶ ἐκ μέλανος λευκόν, οὕτως ἐπειδὴ καὶ ἡ μανότης καὶ ἡ πυκνότης εἰσὶ ποιότητες, εἰκότως καὶ κατὰ ταύτας τὸ σῶμα μεταβάλλει, καὶ δεχόμενον μὲν πυκνότητα γίνεται ὕδωρ, ἔτι δὲ μᾶλλον πυκνούμενον γίνεται γῆ, μεταβάλλον δὲ ἐκ πυκνότητος εἰς μανότητα γίνεται ἀήρ, ἔτι δὲ μᾶλλον μανωθὲν γίνεται πῦρ.", "seq": 2519}
{"id": "Philoponus_Passim_2520", "series": "CAG", "text": "ἡ μὲν οὖν φυσικὴ μάνωσις ἢ πύκνωσις ἡ περὶ ἓν καταγινομένη ὑποκείμενον ποιότης ἐστίν, εἰ δὲ μὴ περὶ ἓν ἀλλὰ περὶ πλείονα σώματα καταγίνεται, κἂν φυσικὴ ᾖ, οὐ λέγεται ποιότης, ἀλλὰ θέσις, οἷον ἡ τῶν ὀδόντων πυκνότης ἢ μανότης·", "seq": 2520}
{"id": "Philoponus_Passim_2521", "series": "CAG", "text": "εἰ γὰρ καὶ ἐκ φύσεώς ἐστιν, ἀλλὰ τῷ μὴ περὶ ἓν γίνεσθαι ὑποκείμενον ἀλλὰ περὶ πλείονα τοὺς ὀδόντας, οὐ λέγεται ποιότης, θέσις δὲ μᾶλλον.", "seq": 2521}
{"id": "Philoponus_Passim_2522", "series": "CAG", "text": "ταῦτα μὲν ἐπὶ τοσοῦτον.", "seq": 2522}
{"id": "Philoponus_Passim_2523", "series": "CAG", "text": "Τοῦ δὲ Ἀριστοτέλους τὴν μὲν εὐθύτητα καὶ καμπυλότητα ποιότητας εἶναι λέγοντος, τραχύτητα δὲ καὶ λειότητα μηκέτι ποιότητας, θέσιν δὲ μόνην τῶν μορίων εἶναι τὸ τραχὺ καὶ τὸ λεῖον, ὡς ἔφθημεν εἰπόντες, ἀποροῦσί τινες ὅτι μήποτε καὶ τὸ εὐθὺ καὶ καμπύλον θέσιν μόνην τῶν μορίων δηλοῖ, εἴπερ εὐθεῖα γραμμή ἐστιν ἥτις ἐξ ἴσου τοῖς ἐφ᾿ ἑαυτῆς σημείοις κεῖται ἢ πάλιν ἧς τὰ μέσα τοῖς ἄκροις ἐπιπροσθεῖ·", "seq": 2523}
{"id": "Philoponus_Passim_2524", "series": "CAG", "text": "δῆλον γὰρ ὅτι κἀνταῦθα ἡ τοιάδε θέσις τῶν τῆς γραμμῆς μορίων ποιεῖ τὴν εὐθεῖαν, ὥστε μηδὲν αὐτῆς μόριον ἐκτὸς ἢ ἐντὸς νεύειν ἀλλ᾿ ἐπιπροσθεῖν διὰ τὴν ἰσότητα τὰ μέσα τοῖς ἄκροις.", "seq": 2524}
{"id": "Philoponus_Passim_2525", "series": "CAG", "text": "καὶ τὸ καμπύλον δὲ μόνῃ τῇ τῶν μορίων θέσει τῆς εὐθύτητος διαφέρει·", "seq": 2525}
{"id": "Philoponus_Passim_2526", "series": "CAG", "text": "τῶν γὰρ μορίων αὐτῆς ἐπικαμπτομένων καὶ τῶν μὲν ἐκτὸς τῶν δὲ ἐντὸς νευόντων συμβαίνει τὴν καμπυλότητα γενέσθαι.", "seq": 2526}
{"id": "Philoponus_Passim_2527", "series": "CAG", "text": "ἢ οὖν καὶ τὸ τραχὺ καὶ τὸ λεῖον ποιότητες, ἢ εἰ ταῦτα θέσιν μόνην τῶν μορίων σημαίνει, τὸ αὐτὸ ἂν σημαίνοι καὶ τὸ εὐθὺ καὶ τὸ καμπύλον.", "seq": 2527}
{"id": "Philoponus_Passim_2528", "series": "CAG", "text": "ἡ μὲν οὖν ἀπορία τοιαύτη.", "seq": 2528}
{"id": "Philoponus_Passim_2529", "series": "CAG", "text": "ἐπιλυόμεθα δὲ αὐτὴν τοῦτον τὸν τρόπον·", "seq": 2529}
{"id": "Philoponus_Passim_2530", "series": "CAG", "text": "οὐκ ἔστι ταὐτὸν καμπύλην εἰπεῖν γραμμὴν καὶ κεκλασμένην·", "seq": 2530}
{"id": "Philoponus_Passim_2531", "series": "CAG", "text": "ἡ μὲν γὰρ κεκλασμένη γραμμὴ οὐκ ἀμείβει τὸ τῆς εὐθείας εἶδος, ᾗ εὐθεῖα εἴη, ἀλλὰ μόνον ἡ μία δύο γίνεται καὶ γωνίαν ποιεῖ, ἡ δὲ καμπύλη ἄλλο τὸ εἶδος ἔχει παρὰ τὴν εὐθεῖαν·", "seq": 2531}
{"id": "Philoponus_Passim_2532", "series": "CAG", "text": "τὸ γὰρ καμπύλον τὸ περιφερὲς σημαίνει.", "seq": 2532}
{"id": "Philoponus_Passim_2533", "series": "CAG", "text": "ὅτι δὲ κατ᾿ εἶδος ἐξήλλακται ἡ περιφέρεια τῆς εὐθείας, πολλαχόθεν δῆλον.", "seq": 2533}
{"id": "Philoponus_Passim_2534", "series": "CAG", "text": "πρῶτον μὲν ὅτι τῆς περιφερείας πᾶν μόριον παντὶ μορίῳ ἐφαρμόζει, ὥσπερ καὶ τῆς εὐθείας πάλιν τὰ μόρια ἅπαντα ἀλλήλοις ἐφαρμόζουσιν·", "seq": 2534}
{"id": "Philoponus_Passim_2535", "series": "CAG", "text": "οὐδὲν δὲ μόριον εὐθείας οὐδενὶ μορίῳ περιφερείας ἐφαρμόζει.", "seq": 2535}
{"id": "Philoponus_Passim_2536", "series": "CAG", "text": "δεύτερον εἰ τὰ ἐξ εὐθειῶν συγκείμενα σχήματα κατ᾿ εἶδος διενήνοχε τῶν ἐκ περιφερείας συγκειμένων, καὶ ἡ εὐθεῖα ἄρα τῆς περιφερείας κατ᾿ εἶδος ἐξαλλάσσει.", "seq": 2536}
{"id": "Philoponus_Passim_2537", "series": "CAG", "text": "ἔτι εὐθεῖα μὲν γραμμὴ οὔτε μία σχῆμα ἀποτελεῖ οὔτε δύο, ἀλλὰ τοὐλάχιστον τρεῖς, ὅθεν πρῶτον τῶν εὐθυγράμμων σχημάτων καὶ ἁπλούστατον τὸ τρίγωνον ἐκ τριῶν εὐθειῶν περιεχόμενον·", "seq": 2537}
{"id": "Philoponus_Passim_2538", "series": "CAG", "text": "ἡ δὲ περιφερὴς μία οὖσα ποιεῖ τὸ τοῦ κύκλου σχῆμα·", "seq": 2538}
{"id": "Philoponus_Passim_2539", "series": "CAG", "text": "κύκλος γάρ ἐστι σχῆμα ἐπίπεδον ὑπὸ μιᾶς γραμμῆς περιεχόμενον καὶ τὰ ἑξῆς.", "seq": 2539}
{"id": "Philoponus_Passim_2540", "series": "CAG", "text": "εἰ τοίνυν ἰδέας διαφόρου ἡ εὐθεῖα τετύχηκε καὶ ἡ περιεφέρεια, οὐκ ἄρα τῇ θέσει μόνῃ τῶν μορίων διενηνόχασι.", "seq": 2540}
{"id": "Philoponus_Passim_2541", "series": "CAG", "text": "τὸ μέντοι τραχὺ καὶ τὸ λεῖον μόνῃ τῇ θέσει τῶν μορίων διαφέρει.", "seq": 2541}
{"id": "Philoponus_Passim_2542", "series": "CAG", "text": "ὅθεν οὐδὲ ἐξαλλάσσεται παρὰ ταῦτα κατ᾿ εἶδος τὸ ὑποκείμενον, ἀλλὰ τοῦ αὐτοῦ μένοντος εἴδους τῆς ἐπιφανείας ἡ αὐτὴ τραχεῖα καὶ λεῖα γίνεται·", "seq": 2542}
{"id": "Philoponus_Passim_2543", "series": "CAG", "text": "οἷον εἰ τετράγωνον εἴη χωρίον, εἶτα τὰ μέν τις ὀρύξας κοιλανεῖ, τὰ δὲ ἐπεγείρει, τραχὺ γίνεται μένον τετράγωνον.", "seq": 2543}
{"id": "Philoponus_Passim_2544", "series": "CAG", "text": "καὶ ἐὰν πάλιν τὰ τῶν μορίων ἐξέχοντα περιξέσας τὰς κοιλότητας ἀναπληρώσῃ, λεῖον γίνεται μὴ ἐξαλλάξαν τὸ τοῦ τετραγώνου εἶδος μηδὲ ποιότητά τινα προσλαβόν, ἀλλὰ μόνον τὴν τῶν μορίων ἐξαμεῖψαν θέσιν.", "seq": 2544}
{"id": "Philoponus_Passim_2545", "series": "CAG", "text": "ὥστε καλῶς τὴν μὲν εὐθύτητα καὶ καμπυλότητα, τοῦτ᾿ ἔστι περιφέρειαν, ποιότητας εἶπεν ὁ Ἀριστοτέλης, τὸ δὲ τραχὺ καὶ τὸ λεῖον κατὰ μόνην τὴν τῶν μορίων διαφέρειν θέσιν.", "seq": 2545}
{"id": "Philoponus_Passim_2546", "series": "CAG", "text": "10a25 Ἴσως μὲν οὖν καὶ ἄλλος ἄν τις φανείη τρόπος ποιότητος, ἀλλ᾿ οἵ γε μάλιστα λεγόμενοι σχεδὸν οὗτοί εἰσι.", "seq": 2546}
{"id": "Philoponus_Passim_2547", "series": "CAG", "text": "Παραδοὺς ἡμῖν τὰ τέσσαρα τῆς ποιότητος εἴδη ἐπάγει τὸ συμπέρασμα καί φησιν ὅτι οὗτοι οἱ τρόποι τῆς ποιότητος.", "seq": 2547}
{"id": "Philoponus_Passim_2548", "series": "CAG", "text": "βουλόμενος δὲ ἡμᾶς μὴ ἐπαναπαύεσθαι τοῖς παρ᾿ αὐτοῦ λεγομένοις μηδὲ ἀργοὺς μένειν καὶ ἑτεροκινήτους, ἀλλ᾿ ἔχειν τι αὐτοκίνητον καὶ ἡμᾶς αὐτοὺς καὶ ζητεῖν, φησὶν ὅτι ἴσως ἂν φανείη καὶ ἄλλος τρόπος ποιότητος.", "seq": 2548}
{"id": "Philoponus_Passim_2549", "series": "CAG", "text": "οὐκ ἔστι δὲ κατὰ ἀλήθειαν ἕτερος παρὰ τοὺς παραδεδομένους τρόπους, ὡς ἥ τε διαίρεσις ἔδειξε καὶ ἡ τῶν παλαιοτέρων καὶ ἐμφρόνων ἀνδρῶν ζήτησις.", "seq": 2549}
{"id": "Philoponus_Passim_2550", "series": "CAG", "text": "10a27 Ποιότητες μὲν οὖν εἰσιν αἱ εἰρημέναι, ποιὰ δὲ τὰ κατὰ ταύτας παρωνύμως λεγόμενα.", "seq": 2550}
{"id": "Philoponus_Passim_2551", "series": "CAG", "text": "Διαλεχθεὶς περὶ τῆς ποιότητος νῦν περὶ τοῦ ποιοῦ διαλέγεται·", "seq": 2551}
{"id": "Philoponus_Passim_2552", "series": "CAG", "text": "καὶ γὰρ περὶ ἀμφοτέρων τὴν ἐπιγραφὴν ἐποιήσατο.", "seq": 2552}
{"id": "Philoponus_Passim_2553", "series": "CAG", "text": "ποιότητες μὲν οὖν εἰσιν οἷον ἡ λευκότης ἡ μελανία καὶ τὰ τοιαῦτα, ποιὸν δὲ τὸ μετέχον τῶν ποιοτήτων, οἷον τὸ λευκὸν σῶμα καὶ τὰ τοιαῦτα.", "seq": 2553}
{"id": "Philoponus_Passim_2554", "series": "CAG", "text": "καὶ αἱ μὲν ποιότητες μετέχονται, τὰ δὲ ποιὰ μετέχει.", "seq": 2554}
{"id": "Philoponus_Passim_2555", "series": "CAG", "text": "παρωνύμως δὲ τὰ ποιὰ ἀπὸ τῶν ποιοτήτων λέγονται, ὡς πολλάκις εἴρηται.", "seq": 2555}
{"id": "Philoponus_Passim_2556", "series": "CAG", "text": "οὐ πάντα δὲ παρωνύμως ἀπ᾿ αὐτῶν λέγεται, ἀλλά τινα καὶ ὁμωνύμως, ἢ οὐδὲ ὅλως ἀπ᾿ αὐτῶν ὀνομάζεται·", "seq": 2556}
{"id": "Philoponus_Passim_2557", "series": "CAG", "text": "διὰ τοῦτο γὰρ καὶ εἶπεν ἢ ὁπωσοῦν.", "seq": 2557}
{"id": "Philoponus_Passim_2558", "series": "CAG", "text": "10a29 Ἐπὶ μὲν οὖν τῶν πλείστων καὶ σχεδὸν ἐπὶ πάντων παρωνύμως λέγεται.", "seq": 2558}
{"id": "Philoponus_Passim_2559", "series": "CAG", "text": "Ἐπειδὴ ἐν τῇ ἀρχῇ τοῦ λόγου τοῦ περὶ ποιότητος εἶπεν ἐκείνην εἶναι ποιότητα ἀφ᾿ ἧς παρωνύμως τὰ μετέχοντα ὀνομάζεται, ὁλοσχερέστερον ἀποφηνάμενος περὶ αὐτῆς καὶ οὐκ ἀκριβῶς (οὐ γὰρ πάσῃ παρακολουθεῖ τοῦτο ποιότητι), νῦν ἀναλαμβάνει τὸν λόγον καὶ ἀκριβέστερον ἀποφαίνεται ὅτι ἐπὶ μὲν τῶν πλείστων ἀληθὴς ὁ λόγος τὸ παρωνύμως ἀπὸ τῆς ποιότητος ὀνομάζεσθαι τὰ μετέχοντα (ἀπὸ γὰρ τῆς λευκότητος ὁ λευκὸς λέγεται καὶ ἀπὸ τῆς γραμματικῆς ὁ γραμματικός), ἐπ᾿ ἐνίων δὲ ποιοτήτων διὰ τὸ μὴ κεῖσθαι ὀνόματα ταῖς ποιότησιν οὐ λέγεται παρωνύμως ἀπ᾿ αὐτῶν τὰ μετέχοντα.", "seq": 2559}
{"id": "Philoponus_Passim_2560", "series": "CAG", "text": "τοῦτο δὲ συμβέβηκεν ἐπὶ τοῦ δευτέρου εἴδους τῆς ποιότητος, τοῦ κατὰ δύναμιν καὶ ἀδυναμίαν·", "seq": 2560}
{"id": "Philoponus_Passim_2561", "series": "CAG", "text": "οὔτε γὰρ ὁ δρομικὸς οὔτε ὁ πυκτικός, οἱ φυσικήν τινα ἐπιτηδειότητα ἐν τούτοις ἔχοντες, παρωνύμως ἀπὸ τούτων τῶν δυνάμεων λέγονται·", "seq": 2561}
{"id": "Philoponus_Passim_2562", "series": "CAG", "text": "οὐδὲ γὰρ κεῖται ὀνόματα ταῖς δυνάμεσι ταύταις διὰ τὸ τὴν συνήθειαν τοῖς τελείοις τῶν πραγμάτων καὶ κατ᾿ ἐνέργειαν οὖσιν ἐσπουδακέναι θεῖναι τὰ ὀνόματα·", "seq": 2562}
{"id": "Philoponus_Passim_2563", "series": "CAG", "text": "τὸ γὰρ πυκτικὸς ἢ δρομικὸς ἀπὸ τῶν κατ᾿ ἐνέργειαν ἐπιστημῶν, τῆς τε πυκτικῆς λέγω καὶ δρομικῆς, ὀνομάζονται.", "seq": 2563}
{"id": "Philoponus_Passim_2564", "series": "CAG", "text": "καὶ τί λέγω ἐπὶ τῶν δυνάμεων αἷς οὐ κεῖται ὀνόματα, ὅπου γε καὶ ἐπί τινων ποιοτήτων ἐχουσῶν ὀνόματα οὐ λέγεται ἀπ᾿ αὐτῶν παρωνύμως τὰ μετέχοντα;", "seq": 2564}
{"id": "Philoponus_Passim_2565", "series": "CAG", "text": "ἀπὸ γὰρ τῆς ἀρετῆς οὐ λέγεται ὁ μετέχων ἐνάρετος ἀλλὰ σπουδαῖος.", "seq": 2565}
{"id": "Philoponus_Passim_2566", "series": "CAG", "text": "ἐνίοτε δὲ καὶ ὁμωνύμως ἀπὸ τῶν ποιοτήτων λέγονται τὰ μετέχοντα, ὡς ἀπὸ τῆς γραμματικῆς ἡ γραμματικὴ γυνὴ καὶ ἀπὸ τῆς μουσικῆς ἡ μουσική.", "seq": 2566}
{"id": "Philoponus_Passim_2567", "series": "CAG", "text": "διό, ὡς εἶπον, ἀκριβέστερον ἡμῖν τὸν λόγον παραδιδοὺς ἐνταῦθα τῆς ποιότητος προσέθηκε τὸ ἢ ὁπωσοῦν ἄλλως ἀπ᾿ αὐτῶν.", "seq": 2567}
{"id": "Philoponus_Passim_2568", "series": "CAG", "text": "10b12 Ὑπάρχει δὲ καὶ ἐναντιότης κατὰ τὸ ποιόν, οἷον δικαιοσύνη ἀδικίᾳ ἐναντίον καὶ λευκότης μελανίᾳ.", "seq": 2568}
{"id": "Philoponus_Passim_2569", "series": "CAG", "text": "Ἐπὶ τὸ ἴδιον τῆς ποιότητος μέτεισι τῷ αὐτῷ κανόνι τῆς διδασκαλίας κεχρημένος ὥσπερ καὶ ἐπὶ τῶν ἄλλων κατηγοριῶν.", "seq": 2569}
{"id": "Philoponus_Passim_2570", "series": "CAG", "text": "φησὶν οὖν ἴδιον ποιότητος τὸ ἐπιδέχεσθαι ἐναντιότητα.", "seq": 2570}
{"id": "Philoponus_Passim_2571", "series": "CAG", "text": "εἰκότως·", "seq": 2571}
{"id": "Philoponus_Passim_2572", "series": "CAG", "text": "κυρίως γὰρ ἡ ἐναντιότης περὶ τὴν ποιότητα θεωρεῖται·", "seq": 2572}
{"id": "Philoponus_Passim_2573", "series": "CAG", "text": "καὶ γὰρ καὶ ἐπὶ τῶν ἄλλων κατηγοριῶν ἡ ἐναντιότης κατὰ τὴν ποιότητα ἐθεωρεῖτο·", "seq": 2573}
{"id": "Philoponus_Passim_2574", "series": "CAG", "text": "καὶ γὰρ ἡ οὐσία διὰ ταύτην τῶν ἐναντίων ἐστὶ δεκτικὴ καὶ τῶν πρός τι τὰ ἐπιδεχόμενα τὴν ἐναντίωσιν ἐκ τῆς τοῦ ποιοῦ ἐλαμβάνοντο κατηγορίας.", "seq": 2574}
{"id": "Philoponus_Passim_2575", "series": "CAG", "text": "κυρίως μὲν οὖν, ὡς ἔφθην εἰπών, ἡ ἐναντιότης περὶ τὴν ποιότητα θεωρεῖται.", "seq": 2575}
{"id": "Philoponus_Passim_2576", "series": "CAG", "text": "οὐκ ἐν πάσῃ δὲ τῇ ποιότητί ἐστιν ἐναντιότης·", "seq": 2576}
{"id": "Philoponus_Passim_2577", "series": "CAG", "text": "ταῖς γὰρ μεταξὺ τῶν ἐναντίων ποιοτήτων ποιότησιν οὐδέν ἐστιν ἐναντίον, οἷον τῷ πυρρῷ ἢ τῷ ὠχρῷ ἢ τοῖς τοιούτοις.", "seq": 2577}
{"id": "Philoponus_Passim_2578", "series": "CAG", "text": "ἀλλ᾿ οὐδὲ τοῖς σχήμασιν οὐδέν ἐστιν ἐναντίον, τῷ τριγώνῳ λέγω καὶ τῷ κύκλῳ καὶ τοῖς τοιούτοις.", "seq": 2578}
{"id": "Philoponus_Passim_2579", "series": "CAG", "text": "ὁμοίως δὲ καὶ τοῖς ποιοῖς ὑπάρχει ἐναντιότης·", "seq": 2579}
{"id": "Philoponus_Passim_2580", "series": "CAG", "text": "λέγεται γὰρ τὸ λευκὸν τῷ μέλανι ἐναντίον καὶ τὸ θερμὸν τῷ ψυχρῷ.", "seq": 2580}
{"id": "Philoponus_Passim_2581", "series": "CAG", "text": "10b17 Ἔτι ἐὰν τῶν ἐναντίων θάτερον ᾖ ποιόν, καὶ τὸ λοιπὸν ἔσται ποιόν.", "seq": 2581}
{"id": "Philoponus_Passim_2582", "series": "CAG", "text": "τοῦτο δὲ δῆλον ἐκ τῶν καθ᾿ ἕκαστα προχειριζομένῳ τὰς ἄλλας κατηγορίας.", "seq": 2582}
{"id": "Philoponus_Passim_2583", "series": "CAG", "text": "Δῆλον γὰρ ὅτι ὑφ᾿ ἣν κατηγορίαν ἀνάγεται ἕτερον τῶν ἐναντίων, ὑπὸ ταύτην καὶ τὸ ἕτερον ἀναχθήσεται ἐκ τοῦ μὴ δύνασθαι ἡμᾶς ὑπὸ ἄλλην κατηγορίαν αὐτὸ ἀναφέρειν·", "seq": 2583}
{"id": "Philoponus_Passim_2584", "series": "CAG", "text": "τῶν γὰρ ἐναντίων τὸ αὐτὸ γένος ἐστίν.", "seq": 2584}
{"id": "Philoponus_Passim_2585", "series": "CAG", "text": "10b26 Ἐπιδέχεται δὲ καὶ τὸ μᾶλλον καὶ τὸ ἧττον τὰ ποιά·", "seq": 2585}
{"id": "Philoponus_Passim_2586", "series": "CAG", "text": "λευκὸν γὰρ μᾶλλον καὶ ἧττον ἕτερον ἑτέρου λέγεται.", "seq": 2586}
{"id": "Philoponus_Passim_2587", "series": "CAG", "text": "Ἕτερον παρακολούθημα τοῦ ποιοῦ τὸ ἐπιδέχεσθαι τὸ μᾶλλον καὶ τὸ ἧττον·", "seq": 2587}
