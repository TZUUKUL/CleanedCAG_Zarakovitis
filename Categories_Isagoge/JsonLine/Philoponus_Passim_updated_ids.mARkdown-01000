{"id": "Philoponus_Passim_0115", "series": "CAG", "text": "ταῦτα γάρ, ὡς εἴρηται, δεῖ προλέγειν ἑκάστης Ἀριστοτελικῆς πραγματείας.", "seq": 115}
{"id": "Philoponus_Passim_0116", "series": "CAG", "text": "τινὲς οὖν περὶ τοῦ σκοποῦ τῶν Κατηγοριῶν διηνέχθησαν, καὶ οἱ μὲν εἰρήκασι περὶ φωνῶν μόνων εἶναι τὸν σκοπὸν οἱ δὲ περὶ πραγμάτων μόνων οἱ δὲ περὶ νοημάτων μόνων.", "seq": 116}
{"id": "Philoponus_Passim_0117", "series": "CAG", "text": "καὶ οἱ μὲν λέγοντες περὶ φωνῶν μόνων εἶναι τὸν σκοπόν, οἷος ἐγένετο ὁ Ἀλέξανδρος, ἐκ τῶν Ἀριστοτελικῶν ῥησειδίων ἐπλανήθησαν τῶν λεγόντων “τῶν λεγομένων τὰ μὲν κατὰ συμπλοκὴν λέγεται τὰ δὲ ἄνευ συμπλοκῆς”, εἰ δὲ τὰ λεγόμενα, φασί, φωναί, δῆλον ὅτι περὶ φωνῶν ἐστιν αὐτῷ ὁ σκοπός.", "seq": 117}
{"id": "Philoponus_Passim_0118", "series": "CAG", "text": "οἱ δὲ περὶ πραγμάτων μόνων οἰηθέντες εἶναι τὸν σκοπόν, οἷος ἐγένετο ὁ Εὐστάθιος, φασὶν ὅτι περὶ πραγμάτων ποιεῖται τὴν διαίρεσιν ὁ φιλόσοφος λέγων “τῶν ὄντων τὰ μὲν καθ᾿ ὑποκειμένου λέγεται”, εἰ δὲ τὰ ὄντα, φασί, πράγματά ἐστι, περὶ πραγμάτων ἄρα αὐτῷ ὁ σκοπός.", "seq": 118}
{"id": "Philoponus_Passim_0119", "series": "CAG", "text": "οἱ δὲ περὶ νοημάτων μόνων νομίσαντες διαλέγεσθαι τὸν φιλόσοφον, οἷος ἐγένετο ὁ Πορφύριος, φασὶν ὅτι περὶ τῶν δέκα γενῶν ἐστιν αὐτῷ ὁ λόγος·", "seq": 119}
{"id": "Philoponus_Passim_0120", "series": "CAG", "text": "ταῦτα δὲ ἐπὶ τοῖς πολλοῖς θεωροῦνται καί εἰσιν ὑστερογενῆ, ἅτινά ἐστιν ἐν τῇ ἡμετέρᾳ διανοίᾳ·", "seq": 120}
{"id": "Philoponus_Passim_0121", "series": "CAG", "text": "περὶ νοημάτων ἄρα ἐν τούτοις τῷ Ἀριστοτέλει ὁ λόγος.", "seq": 121}
{"id": "Philoponus_Passim_0122", "series": "CAG", "text": "ἐπλανήθη δὲ καὶ οὗτος ἐκ τῶν πρὸς τῷ τέλει λέξεων τοῦ Ἀριστοτέλους λέγοντος “ὑπὲρ μὲν οὖν τῶν προτεθέντων γενῶν ἱκανὰ τὰ εἰρημένα”·", "seq": 122}
{"id": "Philoponus_Passim_0123", "series": "CAG", "text": "γένη δὲ πανταχοῦ ὁ Ἀριστοτέλης τὰ ἐπὶ τοῖς πολλοῖς καὶ ἐννοηματικὰ λέγει.", "seq": 123}
{"id": "Philoponus_Passim_0124", "series": "CAG", "text": "οἱ δὲ ἀκριβέστερον λέγοντες, ὧν εἷς ἐστιν ὁ Ἰάμβλιχος, φασὶν ὡς οὔτε περὶ νοημάτων μόνων ἐστὶν αὐτῷ ὁ λόγος οὔτε περὶ φωνῶν μόνων οὔτε περὶ πραγμάτων μόνων, ἀλλ᾿ ἔστιν ὁ σκοπὸς τῶν Κατηγοριῶν περὶ φωνῶν σημαινουσῶν πράγματα διὰ μέσων νοημάτων.", "seq": 124}
{"id": "Philoponus_Passim_0125", "series": "CAG", "text": "ὅτι δὲ οὐ καλῶς οἱ πρότερον ὡρίσαντο, μάθοιμεν ἂν οὕτως·", "seq": 125}
{"id": "Philoponus_Passim_0126", "series": "CAG", "text": "λεγέτωσαν γὰρ οἱ περὶ πραγμάτων μόνων αὐτὸν λέγοντες διαλαμβάνειν, ἐπειδὴ τῶν πραγμάτων τὰ μὲν ἐν ψιλῇ ἐπινοίᾳ κεῖται, ὡς ἱπποκένταυρος καὶ τραγέλαφος, τὰ δὲ ὑφεστῶτα, περὶ ποίων αὐτῷ ὁ λόγος;", "seq": 126}
{"id": "Philoponus_Passim_0127", "series": "CAG", "text": "δῆλον ὅτι φήσουσι περὶ τῶν ὑφεστώτων.", "seq": 127}
{"id": "Philoponus_Passim_0128", "series": "CAG", "text": "πρότερον οὖν ἔννοιαν τούτων λαβὼν οὕτως ἡμᾶς διὰ τῶν φωνῶν διδάσκει περὶ τούτων;", "seq": 128}
{"id": "Philoponus_Passim_0129", "series": "CAG", "text": "πάντως δήπου συμφήσουσιν·", "seq": 129}
{"id": "Philoponus_Passim_0130", "series": "CAG", "text": "ἀδύνατον γὰρ σημᾶναι τὰ πράγματα ἄλλως ἢ ὑπὸ φωνῶν διὰ μέσων νοημάτων·", "seq": 130}
{"id": "Philoponus_Passim_0131", "series": "CAG", "text": "οὐκοῦν καὶ περὶ πάντων διαλέξεται.", "seq": 131}
{"id": "Philoponus_Passim_0132", "series": "CAG", "text": "λεγέτωσαν δὲ καὶ οἱ περὶ φωνῶν μόνων ἢ νοημάτων μόνων λέγοντες αὐτὸν διαλαμβάνειν, ἐπειδὴ αἱ φωναὶ καὶ τὰ νοήματα τὰ μέν εἰσι σημαντικά τινων τὰ δὲ μέχρι τῆς φωνῆς καὶ τῆς ἐπινοίας τὸ εἶναι ἔχει, περὶ ποίων αὐτὸν φήσετε διαλαμβάνειν;", "seq": 132}
{"id": "Philoponus_Passim_0133", "series": "CAG", "text": "ἐροῦσι δηλαδὴ περὶ τῶν σημαινουσῶν πράγματα·", "seq": 133}
{"id": "Philoponus_Passim_0134", "series": "CAG", "text": "περὶ γὰρ τῶν ἀσήμων ἢ φωνῶν ἢ νοημάτων οὐδὲ εἷς λόγος τοῖς φιλοσόφοις.", "seq": 134}
{"id": "Philoponus_Passim_0135", "series": "CAG", "text": "οὐκοῦν διαλαμβάνων περὶ φωνῶν σημαινουσῶν πράγματα καὶ αὐτῶν ἅπτεται τῶν πραγμάτων διὰ μέσων τῶν νοημάτων, καὶ περὶ νοημάτων ποιούμενος τὸν λόγον σημαινόντων πράγματα διαλέξεται περὶ αὐτῶν διὰ φωνῶν τῶν ἑρμηνευουσῶν τὰ νοήματα·", "seq": 135}
{"id": "Philoponus_Passim_0136", "series": "CAG", "text": "εἰ μὲν γὰρ γυμναὶ σωμάτων ἦσαν αἱ ψυχαί, γυμνοῖς ἂν προσέβαλλον τοῖς νοήμασι·", "seq": 136}
{"id": "Philoponus_Passim_0137", "series": "CAG", "text": "νῦν δὲ τοῖς σώμασιν ἐγκαθειργμέναι οὐκ ἄλλως ἢ διὰ τῶν φωνῶν δύνανται σημαίνειν ἀλλήλαις τὰ ἴδια νοήματα.", "seq": 137}
{"id": "Philoponus_Passim_0138", "series": "CAG", "text": "ἐπειδὴ δὲ τῶν πραγμάτων τὰ μέν ἐστιν ἁπλᾶ τὰ δὲ σύνθετα (ἁπλοῦν μὲν γὰρ πρᾶγμα Σωκράτης, σύνθετον δὲ Σωκράτης περιπατῶν), ὡσαύτως καὶ τῶν νοημάτων καὶ τῶν φωνῶν τὰ μέν ἐστιν ἁπλᾶ τὰ δὲ σύνθετα (ἁπλῆ μὲν γὰρ φωνὴ Σωκράτης ἁπλῶς καὶ νόημα τὸ περὶ Σωκράτους ἁπλοῦν, σύνθετος δὲ φωνὴ ἡ λέγουσα ‘Σωκράτης τρέχει’ καὶ νόημα σύνθετον περὶ Σωκράτους τρέχοντος), πότερον περὶ τῶν ἁπλῶν ἐνταῦθα διαλαμβάνει πραγμάτων καὶ φωνῶν ἢ περὶ τῶν συνθέτων;", "seq": 138}
{"id": "Philoponus_Passim_0139", "series": "CAG", "text": "λέγομεν ὅτι περὶ τῶν ἁπλῶν.", "seq": 139}
{"id": "Philoponus_Passim_0140", "series": "CAG", "text": "διὸ καὶ ἀκριβῶς τὸν τῶν Κατηγοριῶν σκοπὸν ὁρίζοντές φαμεν ὅτι διαλαμβάνει ἐνταῦθα περὶ ἁπλῶν φωνῶν σημαινουσῶν ἁπλᾶ πράγματα διὰ μέσων ἁπλῶν νοημάτων.", "seq": 140}
{"id": "Philoponus_Passim_0141", "series": "CAG", "text": "Ἵνα δὲ σαφέστερον γένηται τὸ λεγόμενον, προσλάβωμέν τινα συντελοῦντα ἡμῖν εἰς σαφῆ παράστασιν τῶν λεγομένων·", "seq": 141}
{"id": "Philoponus_Passim_0142", "series": "CAG", "text": "ἐπειδὴ γὰρ τῆς φιλοσοφίας, ὡς ἔφαμεν, τὸ μέν ἐστι θεωρητικὸν τὸ δὲ πρακτικόν, καὶ τοῦ μὲν θεωρητικοῦ τέλος ἐστὶ τῆς ἀληθείας ἡ γνῶσις τοῦ δὲ πρακτικοῦ ἡ τοῦ ἀγαθοῦ τεῦξις, ἀμφοτέροις δὲ παρυφίσταται τὰ ἐναντία, τῇ μὲν ἀληθείᾳ τὸ ψεῦδος τῷ δὲ ἀγαθῷ τὸ κακόν, ἡ δὲ ἡμετέρα ψυχὴ ἅτε δὴ ἀτελὴς οὖσα αἱρεῖται πολλάκις ἀντὶ μὲν ἀληθείας τὸ ψεῦδος οἰομένη αὐτὸ ἀληθὲς εἶναι, ἀντὶ δὲ ἀγαθοῦ τὸ κακὸν οἰομένη αὐτὸ ἀγαθὸν εἶναι, ἐδέησε τοῖς φιλοσόφοις ὀργάνου τινὸς διακρίνοντος τὴν μὲν ἀλήθειαν ἀπὸ τοῦ ψεύδους τὸ δὲ ἀγαθὸν ἀπὸ τοῦ κακοῦ.", "seq": 142}
{"id": "Philoponus_Passim_0143", "series": "CAG", "text": "τί δέ ἐστι τοῦτο;", "seq": 143}
{"id": "Philoponus_Passim_0144", "series": "CAG", "text": "ἡ ἀπόδειξις·", "seq": 144}
{"id": "Philoponus_Passim_0145", "series": "CAG", "text": "ὃ γὰρ ἂν ἀποδειχθείη ἀγαθόν, τοῦτο ἐξ ἀνάγκης ἀγαθόν ἐστι, καὶ ὃ ἂν ἀποδειχθείη κακόν, τοῦτο κακόν ἐστιν.", "seq": 145}
{"id": "Philoponus_Passim_0146", "series": "CAG", "text": "ὁμοίως καὶ τὸ ἀληθὲς καὶ τὸ ψευδές·", "seq": 146}
{"id": "Philoponus_Passim_0147", "series": "CAG", "text": "ὃν γὰρ τρόπον ὁ τέκτων τῷ κανόνι καὶ ὁ οἰκοδόμος τῇ καθέτῳ πρὸς διάκρισιν τῶν ὀρθῶν καὶ τῶν μὴ τοιούτων χρῶνται, οὕτω καὶ ὁ φιλόσοφος τῇ ἀποδείξει κέχρηται πρὸς διάκρισιν τῆς ἀληθείας καὶ τοῦ ψεύδους καὶ τοῦ ἀγαθοῦ καὶ τοῦ κακοῦ.", "seq": 147}
{"id": "Philoponus_Passim_0148", "series": "CAG", "text": "ἡ δὲ ἀπόδειξις συλλογισμός ἐστιν ἐπιστημονικός.", "seq": 148}
{"id": "Philoponus_Passim_0149", "series": "CAG", "text": "ἐπὶ πλέον δὲ τοῦ ἐπιστημονικοῦ συλλογισμοῦ ὁ ἁπλῶς συλλογισμός·", "seq": 149}
{"id": "Philoponus_Passim_0150", "series": "CAG", "text": "τῷ γὰρ ἁπλῶς συλλογισμῷ προσελθοῦσα ὕλη ἄπταιστός τε καὶ ἀραρυῖα ἀεὶ κατὰ τὰ αὐτὰ καὶ ὡσαύτως ἔχουσα τὸν ἀποδεικτικὸν ποιεῖ συλλογισμόν.", "seq": 150}
{"id": "Philoponus_Passim_0151", "series": "CAG", "text": "ἀλλ᾿ ἐπειδήπερ οὐκ ἠδύνατο διδάξαι περὶ ἀποδείξεως μὴ πρότερον διδάξας τί ἐστιν ὁ ἁπλῶς συλλογισμός, ὥσπερ οὐδὲ γράφειν δύναιτ᾿ ἄν τις τὸν ὀρθὸν ἢ τὸν κλιτὸν τύπον μὴ πρότερον ἁπλῶς γράφειν μαθών, τὸν δὲ ἁπλῶς συλλογισμὸν πάλιν ἄνευ τῶν προτάσεων ἀδύνατον ἦν παραδοῦναι (ἐκ τούτων γὰρ ὁ συλλογισμὸς σύγκειται, συλλογή τις ὢν πλειόνων λόγων, ὡς καὶ τὸ ὄνομα δηλοῖ), τὰς δὲ προτάσεις ἄνευ τῶν ὀνομάτων καὶ τῶν ῥημάτων (ἐκ τούτων γὰρ σύγκεινται), τὰ δὲ ὀνόματα καὶ τὰ ῥήματα ἄνευ τῶν ἁπλῶν φωνῶν (καὶ γὰρ καὶ τὸ ὄνομα καὶ τὸ ῥῆμα φωνή ἐστι σημαντική), εἰκότως πρότερον περὶ τῶν ἁπλῶν διαλέγεται φωνῶν·", "seq": 151}
{"id": "Philoponus_Passim_0152", "series": "CAG", "text": "καθόλου γὰρ τῆς μὲν θεωρίας τὸ τέλος ἀρχὴ τῆς πράξεως γίνεται, ἔμπαλιν δὲ τῆς πράξεως τὸ τέλος ἀρχὴ τῆς θεωρίας·", "seq": 152}
{"id": "Philoponus_Passim_0153", "series": "CAG", "text": "οἷον ὁ οἰκοδόμος ἐπιταγεὶς οἶκον ποιῆσαι λέγει καθ᾿ ἑαυτὸν ‘ἐπετάγην οἶκον ποιῆσαι, ὅπερ ἐστὶ σκέπασμα κωλυτικὸν ὄμβρου καὶ καύματος·", "seq": 153}
{"id": "Philoponus_Passim_0154", "series": "CAG", "text": "τοῦτο δὲ οὐκ ἂν γένοιτο μὴ γενομένης ὀροφῆς’.", "seq": 154}
{"id": "Philoponus_Passim_0155", "series": "CAG", "text": "ἐντεῦθεν οὖν ἄρχεται τῆς θεωρίας, προβαίνων δέ φησιν ‘ἀλλὰ τοῦτο οὐκ ἂν γένοιτο μὴ γενομένων τοίχων, οὗτοι δὲ οὐκ ἂν γένοιντο μὴ ὑποβληθέντων θεμελίων, οἱ δὲ θεμέλιοι οὐκ ἂν βληθεῖεν μὴ ὀρυχθείσης τῆς γῆς’·", "seq": 155}
{"id": "Philoponus_Passim_0156", "series": "CAG", "text": "ἐνταῦθα κατέληξεν ἡ θεωρία.", "seq": 156}
{"id": "Philoponus_Passim_0157", "series": "CAG", "text": "ἐντεῦθεν οὖν ἄρχεται ἡ πρᾶξις·", "seq": 157}
{"id": "Philoponus_Passim_0158", "series": "CAG", "text": "πρότερον γὰρ ὀρύττει τὴν γῆν, εἶθ᾿ οὕτως βάλλει θεμέλιον, εἶτα ἐγείρει τοίχους, καὶ ὕστερον ἐπιτίθησι τὴν ὀροφήν, ἥτις ἐστὶ τέλος τῆς πράξεως.", "seq": 158}
{"id": "Philoponus_Passim_0159", "series": "CAG", "text": "οὕτως οὖν ἡ ἀρχὴ τῆς θεωρίας τέλος γίνεται τῆς πράξεως, ἡ δὲ ἀρχὴ τῆς πράξεως τέλος τῆς θεωρίας.", "seq": 159}
{"id": "Philoponus_Passim_0160", "series": "CAG", "text": "οὕτως οὖν καὶ ὁ φιλόσοφος ποιεῖ·", "seq": 160}
{"id": "Philoponus_Passim_0161", "series": "CAG", "text": "βουλόμενος γὰρ ποιῆσαι ἀπόδειξίν φησι πρὸς ἑαυτὸν ‘βούλομαι περὶ ἀποδείξεως εἰπεῖν·", "seq": 161}
{"id": "Philoponus_Passim_0162", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ ἡ ἀπόδειξις συλλογισμός ἐστιν ἐπιστημονικός, ἀδύνατον εἰπεῖν τι περὶ αὐτοῦ τὸν μὴ πρότερον εἰπόντα τί ἐστιν ὁ ἁπλῶς συλλογισμός, τὸν δὲ ἁπλῶς συλλογισμὸν οὐκ ἂν μάθοιμεν μὴ μαθόντες τί ἐστι πρότασις·", "seq": 162}
{"id": "Philoponus_Passim_0163", "series": "CAG", "text": "λόγοι μὲν γάρ τινές εἰσιν αἱ προτάσεις, τῶν δὲ τοιούτων λόγων συλλογή ἐστιν ὁ συλλογισμός·", "seq": 163}
{"id": "Philoponus_Passim_0164", "series": "CAG", "text": "ὥστε ἄνευ τοῦ γνῶναι τὰς προτάσεις ἀδύνατον μαθεῖν τὸν συλλογισμόν (ἐκ γὰρ τούτων σύγκειται), ἀλλ᾿ οὐδὲ τὴν πρότασιν ἄνευ τῶν ὀνομάτων καὶ τῶν ῥημάτων, ἐξ ὧν συνέστηκε πᾶς λόγος, τὰ δὲ ὀνόματα καὶ τὰ ῥήματα ἄνευ τῶν ἁπλῶν φωνῶν (ἕκαστον γὰρ τούτων φωνή ἐστι σημαντική)·", "seq": 164}
{"id": "Philoponus_Passim_0165", "series": "CAG", "text": "δεῖ οὖν πρότερον περὶ τῶν ἁπλῶν φωνῶν εἰπεῖν’.", "seq": 165}
{"id": "Philoponus_Passim_0166", "series": "CAG", "text": "ἐνταῦθα οὖν ἡ θεωρία κατέληξε, καὶ γίνεται τοῦτο τῆς πράξεως ἀρχή·", "seq": 166}
{"id": "Philoponus_Passim_0167", "series": "CAG", "text": "πρότερον γὰρ διαλέγεται περὶ τῶν ἁπλῶν φωνῶν ἐν ταῖς Κατηγορίαις, εἶθ᾿ οὕτως περὶ ὀνομάτων καὶ ῥημάτων καὶ περὶ προτάσεων ἐν τῷ Περὶ ἑρμηνείας, εἶτα περὶ τοῦ ἁπλῶς συλλογισμοῦ ἐν τοῖς Προτέροις ἀναλυτικοῖς, εἶθ᾿ οὕτως περὶ ἀποδείξεως ἐν τοῖς Ὑστέροις ἀναλυτικοῖς·", "seq": 167}
{"id": "Philoponus_Passim_0168", "series": "CAG", "text": "ἐνταῦθα οὖν τὸ τέλος τῆς πράξεως, ὅπερ ἦν ἀρχὴ τῆς θεωρίας.", "seq": 168}
{"id": "Philoponus_Passim_0169", "series": "CAG", "text": "εἰκότως τοίνυν ἐνταῦθα πρῶτον περὶ τῶν ἁπλῶν φωνῶν διαλαμβάνει·", "seq": 169}
{"id": "Philoponus_Passim_0170", "series": "CAG", "text": "οἱ γὰρ ἄνθρωποι κοινῇ συνελθόντες ἔθεντο πρὸς ἀλλήλους ἑκάστῳ πράγματι οἰκεῖον ὄνομα, τούτου μόνου φροντίσαντες τοῦ διὰ τῶν φωνῶν σημαίνειν ἀλλήλοις τὰ πράγματα, μὴ μέντοι γε εἰπεῖν τί μέν ἐστιν ὄνομα τί δὲ ῥῆμα.", "seq": 170}
{"id": "Philoponus_Passim_0171", "series": "CAG", "text": "περὶ τούτων οὖν διαλέγεται ἐν ταῖς Κατηγορίαις.", "seq": 171}
{"id": "Philoponus_Passim_0172", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ οὐ περὶ ἀσήμων φωνῶν διαλέγεται (οὐδεὶς γὰρ τούτων λόγος τοῖς φιλοσόφοις), δῆλον ὅτι περὶ φωνῶν σημαινουσῶν νοήματα·", "seq": 172}
{"id": "Philoponus_Passim_0173", "series": "CAG", "text": "ἀνάγκη γὰρ ὄντος τοῦ πράγματος εἶναι καὶ τούτου τὸ ὄνομα, καὶ πρὸ τούτου τὴν ἔννοιαν, ἣν ἔχομεν τοῦ πράγματος·", "seq": 173}
{"id": "Philoponus_Passim_0174", "series": "CAG", "text": "οἷον τοῦ Σωκράτους ἔστιν ὄνομα ἡ Σωκράτης φωνή, τὸ δὲ πρᾶγμα αὐτὸς ὁ Σωκράτης, ἡ δὲ ἔννοια, ἣν ἔχομεν ἐν τῇ ψυχῇ, ἡ περὶ τοῦ Σωκράτους γνῶσις.", "seq": 174}
{"id": "Philoponus_Passim_0175", "series": "CAG", "text": "σκοπὸς οὖν τῷ Ἀριστοτέλει εἰπεῖν περὶ ἁπλῶν φωνῶν σημαινουσῶν ἁπλᾶ πράγματα διὰ μέσων ἁπλῶν νοημάτων.", "seq": 175}
{"id": "Philoponus_Passim_0176", "series": "CAG", "text": "καὶ ταῦτα μὲν περὶ τοῦ σκοποῦ.", "seq": 176}
{"id": "Philoponus_Passim_0177", "series": "CAG", "text": "Ὅτι δὲ χρήσιμόν ἐστι τὸ βιβλίον εἴς τε τὸ θεωρητικὸν τῆς φιλοσοφίας μέρος καὶ τὸ πρακτικόν, ἐκ τῶν προειρημένων δῆλον, εἴπερ καὶ τὴν ἀπόδειξιν, ὡς ἐδείξαμεν, ἄνευ τῶν ἁπλῶν φωνῶν οὐκ ἔστι γνῶναι, καὶ ὅτι περὶ τῶν κοινοτήτων διαλαμβάνει, εἰς ἃς τὰ ὄντα πάντα διαιρεῖται.", "seq": 177}
{"id": "Philoponus_Passim_0178", "series": "CAG", "text": "Ἡ δὲ αἰτία τῆς ἐπιγραφῆς ἐστι τοιαύτη·", "seq": 178}
{"id": "Philoponus_Passim_0179", "series": "CAG", "text": "Κατηγορίαι ἐπιγέγραπται τὸ βιβλίον, οὐχ ὅτι περὶ τῶν κατηγοριῶν τῶν ἐν δικαστηρίοις διαλαμβάνει (οὐ γὰρ πρόκειται αὐτῷ ῥητορεύειν), ἀλλ᾿ ὥσπερ καὶ ἐν ταῖς Εἰσαγωγαῖς ἐμάθομεν, διττὴ τῶν γενῶν ἐστι διαφορά·", "seq": 179}
{"id": "Philoponus_Passim_0180", "series": "CAG", "text": "τὰ μὲν γάρ ἐστι γενικώτατα καὶ μόνως γένη, τὰ δὲ ὑπάλληλα, ἃ καὶ γένη καὶ εἴδη λέγεται, εἴδη μὲν τῶν πρὸ αὐτῶν γένη δὲ τῶν μετ᾿ αὐτά·", "seq": 180}
{"id": "Philoponus_Passim_0181", "series": "CAG", "text": "καὶ τὰ μὲν γενικώτατα μόνως κατηγοροῦνται, τὰ δὲ ὑπάλληλα ὑπόκεινται μὲν τοῖς πρὸ αὐτῶν κατηγοροῦνται δὲ τῶν μετ᾿ αὐτά.", "seq": 181}
{"id": "Philoponus_Passim_0182", "series": "CAG", "text": "διαλέγεται δὲ ἐνταῦθα περὶ τῶν δέκα γενικωτάτων γενῶν, ἃ μόνως κατηγοροῦνται, οὐδέποτε δὲ ὑπόκεινται.", "seq": 182}
{"id": "Philoponus_Passim_0183", "series": "CAG", "text": "διὰ τοῦτο οὖν ἐπέγραψε τὸ βιβλίον Κατηγορίαι, ὡς ἂν εἰ ἔλεγε Περὶ τῶν γενῶν τῶν μόνως κατηγορουμένων.", "seq": 183}
{"id": "Philoponus_Passim_0184", "series": "CAG", "text": "Ἡ δὲ τάξις τῆς ἀναγνώσεως δήλη ἐκ τοῦ σκοποῦ·", "seq": 184}
{"id": "Philoponus_Passim_0185", "series": "CAG", "text": "ἐπειδὴ γάρ, ὡς ἔφαμεν, εἰς τοῦτο κατέληξεν ἡ θεωρία, ἐντεῦθεν ἀρκτέον τῆς πράξεως, καὶ ὅτι δεῖ τὰ ἁπλούστερα προηγεῖσθαι τῶν συνθέτων·", "seq": 185}
{"id": "Philoponus_Passim_0186", "series": "CAG", "text": "ἁπλουστέρα δὲ ἡ περὶ τῶν δέκα κατηγοριῶν διδασκαλία, εἴπερ, ὡς εἴρηται, διαλαμβάνει περὶ ἁπλῶν φωνῶν σημαινουσῶν ἁπλᾶ πράγματα διὰ μέσων ἁπλῶν νοημάτων.", "seq": 186}
{"id": "Philoponus_Passim_0187", "series": "CAG", "text": "Ὅτι δὲ γνήσιον τοῦ φιλοσόφου τὸ βιβλίον, πάντες μαρτυροῦσι.", "seq": 187}
{"id": "Philoponus_Passim_0188", "series": "CAG", "text": "δηλοῖ δὲ καὶ ἡ φράσις καὶ τὸ τὸν φιλόσοφον ἐν ἄλλαις πραγματείαις μεμνῆσθαι τοῦ συγγράμματος τούτου.", "seq": 188}
{"id": "Philoponus_Passim_0189", "series": "CAG", "text": "δύο δέ, ὡς εἴρηται, βιβλίων Κατηγοριῶν εὑρεθέντων, σχεδὸν παραπλησίων κατὰ πάντα καὶ κατ᾿ αὐτὸ τὸ προοίμιον (ἔστι γὰρ τοῦ ἑτέρου ἡ ἀρχὴ “Τῶν ὄντων τὰ μὲν ὁμώνυμά ἐστι, τὰ δὲ συνώνυμα”, ἥτις σχεδὸν ἡ αὐτή ἐστι τῷ προκειμένῳ βιβλίῳ), ἐκρίθη τοῦτο γνήσιον εἶναι τὸ βιβλίον ὑπὸ πάντων ἐξηγητῶν.", "seq": 189}
{"id": "Philoponus_Passim_0190", "series": "CAG", "text": "Ἡ δὲ εἰς τὰ κεφάλαια διαίρεσις τριχῇ·", "seq": 190}
{"id": "Philoponus_Passim_0191", "series": "CAG", "text": "διαιρεῖται γὰρ εἰς τὰ πρὸ τῶν κατηγοριῶν εἰς τὰς κατηγορίας αὐτὰς καὶ εἰς τὰ μετὰ τὰς κατηγορίας.", "seq": 191}
{"id": "Philoponus_Passim_0192", "series": "CAG", "text": "καὶ ἐν μὲν τῷ πρώτῳ τμήματι διδάσκει τὰ χρήσιμα πρὸς τὴν διδασκαλίαν τῶν κατηγοριῶν·", "seq": 192}
{"id": "Philoponus_Passim_0193", "series": "CAG", "text": "ὥσπερ γὰρ εἰώθασιν οἱ γεωμέτραι τὰ χρήσιμα πρὸς τὴν τῶν θεωρημάτων διδασκαλίαν προδιδάσκειν, τί ἐστι σημεῖον, τί ἐστι γραμμή, τί ἐστι κύκλος, ἵνα μὴ ἀναγκάζωνται μεταξὺ τῆς διδασκαλίας ἢ ξένοις ὀνόμασι κεχρῆσθαι ἢ διδάσκοντές τι περὶ αὐτῶν ἐκτρέπεσθαι καὶ διακόπτειν τὴν συνέχειαν τῶν προκειμένων·", "seq": 193}
{"id": "Philoponus_Passim_0194", "series": "CAG", "text": "οὕτως καὶ ὁ φιλόσοφος ἐνταῦθα ἐπειδὴ ἔμελλεν ἐν τῇ τῶν κατηγοριῶν διδασκαλίᾳ μνημονεύειν λέξεών τινων καὶ φωνῶν ἡμῖν ἀγνώστων, διὰ τοῦτο περὶ αὐτῶν προδιδάσκει, ἵνα μὴ δόξῃ τὸν λόγον ταράττειν.", "seq": 194}
{"id": "Philoponus_Passim_0195", "series": "CAG", "text": "ἐν δὲ τῷ δευτέρῳ τμήματι περὶ αὐτῶν τῶν κατηγοριῶν διδάσκει.", "seq": 195}
{"id": "Philoponus_Passim_0196", "series": "CAG", "text": "ἐν δὲ τῷ τρίτῳ πάλιν περί τινων διαλαμβάνει φωνῶν, ὧν ἐμνήσθη ἐν τῇ τῶν κατηγοριῶν διδασκαλίᾳ, οἷον τοῦ ἅμα τοῦ προτέρου τοῦ ἔχειν.", "seq": 196}
{"id": "Philoponus_Passim_0197", "series": "CAG", "text": "καὶ διὰ ποίαν αἰτίαν οὐχ ἅμα πάντα πρὸ τῶν κατηγοριῶν ἐδίδαξε;", "seq": 197}
{"id": "Philoponus_Passim_0198", "series": "CAG", "text": "φαμὲν ὅτι τῶν φωνῶν τούτων αἱ μέν εἰσι πᾶσιν ἄγνωστοι, οἷον τὸ ὁμώνυμον, τὸ συνώνυμον (οὐδεμίαν γὰρ τούτων ἔννοιαν ἔχει ὁ πολὺς ἄνθρωπος), τὰ δὲ γνώριμα μὲν ἐκ τῆς συνηθείας, ἀλλ᾿ ὅμως τινὸς δεόμενα διαρθρώσεως, οἷον τὸ ἅμα καὶ τὸ πρότερον.", "seq": 198}
{"id": "Philoponus_Passim_0199", "series": "CAG", "text": "τὰ οὖν παντάπασιν ἄγνωστα πρὸ τῆς τῶν κατηγοριῶν διδασκαλίας ἀναγκαίως προέταξεν, ἐπειδὴ ἐκείνων ἀγνοουμένων ἐφιστάνειν οὐκ ἐμέλλομεν τοῖς λεγομένοις περὶ τῶν κατηγοριῶν (χρῆται γὰρ αὐτοῖς εἰς τὴν τῶν κατηγοριῶν διδασκαλίαν), τὰ δὲ λοιπά, λέγω δὴ τὰ ἀδιαρθρώτως ἡμῖν ἐγνωσμένα, μετὰ τὰς κατηγορίας διδάσκει, ἵνα μὴ μακρὸν ποιήσῃ τὸ προοίμιον καὶ τὸ πάρεργον τοῦ ἔργου μακρότερον.", "seq": 199}
{"id": "Philoponus_Passim_0200", "series": "CAG", "text": "ἐφευρέθη δὲ ἡ κατὰ τὰ μόρια διαίρεσις πρὸς σαφήνειαν τοῦ συγγράμματος·", "seq": 200}
{"id": "Philoponus_Passim_0201", "series": "CAG", "text": "μαθόντες γὰρ πόσα ἐστὶ τὰ τοῦ βιβλίου κεφάλαια καὶ περὶ τίνων διαλέγεται, ῥᾷστα τοῖς λεγομένοις παρακολουθήσομεν, καὶ οὐ συγκεχυμένως καὶ ἀδιαρθρώτως ταῦτα δεξόμεθα.", "seq": 201}
{"id": "Philoponus_Passim_0202", "series": "CAG", "text": "1a1 Ὁμώνυμα λέγεται.", "seq": 202}
{"id": "Philoponus_Passim_0203", "series": "CAG", "text": "Αἱ ψυχαὶ αἱ ἡμέτεραι γυμναὶ μὲν οὖσαι τῶν σωμάτων ἠδύναντο διὰ τῶν νοημάτων σημαίνειν ἀλλήλαις τὰ πράγματα·", "seq": 203}
{"id": "Philoponus_Passim_0204", "series": "CAG", "text": "ἐπειδὴ δὲ σώμασι συνδέδενται δίκην νέφους περικαλύπτουσιν αὐτῶν τὸ νοερόν, ἐδεήθησαν τῶν ὀνομάτων, δι᾿ ὧν σημαίνουσιν ἀλλήλαις τὰ πράγματα.", "seq": 204}
{"id": "Philoponus_Passim_0205", "series": "CAG", "text": "ἰστέον τοίνυν ὅτι σημαίνομεν ἀλλήλοις τὰ πράγματα ἢ διὰ τῶν ὀνομάτων ἢ διὰ τῶν ὁρισμῶν, οἷον τὸν ἄνθρωπον σημαίνομεν καὶ διὰ τῆς ἄνθρωπος φωνῆς καὶ διὰ τοῦ ὁρισμοῦ τοῦ λέγοντος ‘ζῷον λογικὸν θνητόν’.", "seq": 205}
{"id": "Philoponus_Passim_0206", "series": "CAG", "text": "ἀλλ᾿ ὅταν μὲν διὰ τῆς ἄνθρωπος φωνῆς σημαίνωμεν τὸν ἄνθρωπον, ἀθρόαν αὐτοῦ τὴν φύσιν ἐδηλώσαμεν, ὅταν δὲ διὰ τοῦ ὁρισμοῦ, τὰ κατὰ μέρος προσόντα τῷ ἀνθρώπῳ θεωροῦμεν.", "seq": 206}
{"id": "Philoponus_Passim_0207", "series": "CAG", "text": "τῶν οὖν πραγμάτων τὰ μὲν κοινωνεῖ ἀλλήλοις κατὰ τὸ ὄνομα διαφέρει δὲ κατὰ τὸν ὁρισμὸν καὶ καλεῖται ὁμώνυμα, τὰ δὲ κοινωνεῖ μὲν κατὰ τὸν ὁρισμὸν διαφέρει δὲ κατὰ τὸ ὄνομα καὶ καλεῖται πολυώνυμα, τὰ δὲ κατά τε τὸ ὄνομα καὶ τὸν ὁρισμὸν κοινωνεῖ καὶ καλεῖται συνώνυμα, τὰ δὲ κατὰ τὸ ὄνομα καὶ κατὰ τὸν ὁρισμὸν διαφέρει, ἃ καλεῖται ἑτερώνυμα.", "seq": 207}
{"id": "Philoponus_Passim_0208", "series": "CAG", "text": "Εἰδέναι δὲ χρὴ ὅτι ἄλλο ἐστὶν ἕτερον καὶ ἄλλο ἑτερώνυμον·", "seq": 208}
{"id": "Philoponus_Passim_0209", "series": "CAG", "text": "ἑτερώνυμα μέν εἰσι τὰ περὶ ἓν καὶ τὸ αὐτὸ ὑποκείμενον θεωρούμενα πράγματα διαφόρου δὲ μετέχοντα ὀνόματος·", "seq": 209}
{"id": "Philoponus_Passim_0210", "series": "CAG", "text": "οἷον ἐπὶ τῆς κλίμακος καὶ ἡ ἀνάβασις καὶ ἡ κατάβασις, καὶ ἄλλως μὲν ὁρίζεται ἡ ἀνάβασις ἄλλως δὲ ἡ κατάβασις, καὶ τὰ ὀνόματα δὲ διάφορα·", "seq": 210}
{"id": "Philoponus_Passim_0211", "series": "CAG", "text": "ἀνάβασις γὰρ καὶ κατάβασις.", "seq": 211}
{"id": "Philoponus_Passim_0212", "series": "CAG", "text": "ταῦτα οὖν ἰδίως ἑτερώνυμα καλοῦσιν.", "seq": 212}
{"id": "Philoponus_Passim_0213", "series": "CAG", "text": "ἕτερα δὲ τὰ κατὰ πάντα ἄλλα, καὶ κατὰ τὸ ὑποκείμενον καὶ κατὰ τὸ ὄνομα, οἷον ἄνθρωπος καὶ ἵππος.", "seq": 213}
{"id": "Philoponus_Passim_0214", "series": "CAG", "text": "Περὶ τῶν ὁμωνύμων δὲ μόνων καὶ συνωνύμων ποιεῖται τὴν διδασκαλίαν, διότι αὐτῶν μόνων ἐν τῇ τῶν κατηγοριῶν διδασκαλίᾳ χρῄζει, ζηλῶν κἀν τούτῳ τὴν γεωμετρικὴν διδασκαλίαν·", "seq": 214}
{"id": "Philoponus_Passim_0215", "series": "CAG", "text": "εἰώθασι γὰρ κἀκεῖνοι περὶ μόνων προλαμβάνειν τῶν συμβαλλομένων αὐτοῖς ἐν τῷ προκειμένῳ βιβλίῳ ἢ θεωρήματι.", "seq": 215}
{"id": "Philoponus_Passim_0216", "series": "CAG", "text": "ἢ καὶ ἄλλως συντομίας ἀεὶ ἐρῶν διὰ τούτων καὶ περὶ τῶν λοιπῶν ἡμᾶς δυνάμει διδάσκει·", "seq": 216}
{"id": "Philoponus_Passim_0217", "series": "CAG", "text": "τούτων γὰρ γνωσθέντων γνώριμα ἔσται καὶ τὰ λοιπὰ ὡς ἀντικείμενα·", "seq": 217}
{"id": "Philoponus_Passim_0218", "series": "CAG", "text": "τῶν γὰρ ἀντικειμένων ἡ αὐτή ἐστιν ἐπιστήμη·", "seq": 218}
{"id": "Philoponus_Passim_0219", "series": "CAG", "text": "ὁ γὰρ εἰδὼς τί ἐστιν ὁμώνυμον εἴσεται καὶ τὸ τούτῳ ἀντικείμενον, λέγω δὴ τὸ πολυώνυμον·", "seq": 219}
{"id": "Philoponus_Passim_0220", "series": "CAG", "text": "εἰ γὰρ ὁμώνυμόν ἐστι τὸ κοινωνοῦν μὲν τῷ ὀνόματι τῷ δὲ πράγματι διαφέρον, ὡς μῦς ὅ τε θαλάσσιος καὶ ὁ γηγενής, πολυώνυμον ἄρα ἐστὶ τὸ τούτῳ ἀντικείμενον, τὸ τῷ πράγματι μὲν ταὐτὸν διαφέρον δὲ τῷ ὀνόματι, ὡς ἄορ ξίφος σπάθη.", "seq": 220}
{"id": "Philoponus_Passim_0221", "series": "CAG", "text": "ὁμοίως δὲ καὶ ὁ εἰδὼς τί ἐστι συνώνυμον, ὅτι τὸ καὶ τῷ ὁρισμῷ καὶ τῷ ὀνόματι κοινωνοῦν, ὡς ἄνθρωπος Σωκράτης τε καὶ Πλάτων, οὗτος καὶ τί ἐστιν ἑτερώνυμον εἴσεται, ὅτι τὸ καὶ τῷ ὀνόματι καὶ τῷ πράγματι διαφέρον, ὡς ἡ ἀνάβασις καὶ ἡ κατάβασις·", "seq": 221}
{"id": "Philoponus_Passim_0222", "series": "CAG", "text": "καὶ γὰρ καὶ ὀνόματι καὶ πράγματι διαφέρουσιν, εἰ καὶ τὸ ὑποκείμενον ἀμφοτέροις τοῖς πράγμασι τὸ αὐτό ἐστιν·", "seq": 222}
{"id": "Philoponus_Passim_0223", "series": "CAG", "text": "ὡς γὰρ ἄλλο τί ἐστι τὸ εἶναι σίτῳ καὶ ἄλλο τὸ εἶναι σπέρματι ἢ καρπῷ, οὕτως ἄλλο τί ἐστι τὸ εἶναι κλίμακι καὶ ἄλλο τὸ ἀναβάσει εἶναι ἢ καταβάσει·", "seq": 223}
{"id": "Philoponus_Passim_0224", "series": "CAG", "text": "ποιᾶς γὰρ σχέσεως τῆς περὶ τὴν κλίμακα ἐνεργείας ταῦτά ἐστιν ὀνόματα δηλωτικά.", "seq": 224}
{"id": "Philoponus_Passim_0225", "series": "CAG", "text": "Προέταξε δὲ ὁ Ἀριστοτέλης ἐν τῇ διδασκαλίᾳ τὰ ὁμώνυμα, ἐπειδήπερ ἁπλούστερά εἰσι καθ᾿ ἓν μόνον κοινωνοῦντα, τὸ ὄνομα, καὶ ὅτι φύσει πρότερά ἐστι τὰ ὁμώνυμα τῶν συνωνύμων·", "seq": 225}
{"id": "Philoponus_Passim_0226", "series": "CAG", "text": "τὸ γὰρ ὂν τῶν κατηγοριῶν ὁμωνύμως κατηγορεῖται καὶ οὐ συνωνύμως.", "seq": 226}
{"id": "Philoponus_Passim_0227", "series": "CAG", "text": "οὐκ ἂν δὲ γένοιτο ὁμώνυμον, εἰ μὴ πάντα ταῦτα συνέλθωσι·", "seq": 227}
{"id": "Philoponus_Passim_0228", "series": "CAG", "text": "ταυτότης ὀνόματος, ταυτότης τόνου, ταυτότης γένους, ταυτότης πτώσεως, ταυτότης πνεύματος, ταυτότης καταλήξεως·", "seq": 228}
{"id": "Philoponus_Passim_0229", "series": "CAG", "text": "ἐὰν γὰρ ἄλλο καὶ ἄλλο ὄνομα ᾖ, δῆλον ὅτι οὐκ ἔστιν ὁμώνυμον.", "seq": 229}
{"id": "Philoponus_Passim_0230", "series": "CAG", "text": "εἰ δὲ τὸ αὐτὸ μὲν ὄνομα ᾖ, τόνος δὲ διάφορος, οὐδὲ τοῦτο ὁμώνυμον, οἷον ἄργος καὶ ἀργός·", "seq": 230}
{"id": "Philoponus_Passim_0231", "series": "CAG", "text": "τὸ μὲν γὰρ παροξύτονόν ἐστι καὶ σημαίνει κύνα, τὸ δὲ ὀξύτονον καὶ σημαίνει τὸν ἀμελῆ.", "seq": 231}
{"id": "Philoponus_Passim_0232", "series": "CAG", "text": "καὶ εἰ μὲν ἀρσενικὸν εἴη, σημαίνει, ὡς εἶπον, τὸν κύνα τοῦ Ὀδυσσέως ἢ ὄνομα ἥρωος, εἰ δὲ οὐδέτερον, σημαίνει ὄνομα πόλεως.", "seq": 232}
{"id": "Philoponus_Passim_0233", "series": "CAG", "text": "ὁμοίως βίος καὶ βιός·", "seq": 233}
{"id": "Philoponus_Passim_0234", "series": "CAG", "text": "βίος μὲν γὰρ βαρυτόνως ἡ ζωή, βιός δὲ ὀξυτόνως τὸ τόξον.", "seq": 234}
{"id": "Philoponus_Passim_0235", "series": "CAG", "text": "καὶ πάλιν ἐὰν ταῦτα μὲν ᾖ, πτῶσις δὲ μὴ ᾖ ἡ αὐτή, οὐ ποιεῖ ὁμώνυμον, οἷον ὁ ἐλάτης καὶ τῆς ἐλάτης·", "seq": 235}
{"id": "Philoponus_Passim_0236", "series": "CAG", "text": "τὸ μὲν γὰρ εὐθείας ἐστὶ καὶ σημαίνει ἡνίοχον ἢ ἄλλον τινὰ ἐλαύνοντα ἀρσενικοῦ γένους ὄν, τὸ δὲ καὶ θηλυκοῦ γένους καὶ γενικῆς πτώσεως (ἡ ἐλάτη γὰρ τῆς ἐλάτης) καὶ δένδρου ὄνομα.", "seq": 236}
{"id": "Philoponus_Passim_0237", "series": "CAG", "text": "δέον δὲ καὶ πνεῦμα τὸ αὐτὸ ἔχειν·", "seq": 237}
{"id": "Philoponus_Passim_0238", "series": "CAG", "text": "εἰ γὰρ διάφορον εἴη τὸ πνεῦμα, οὐκ ἔσται ὁμώνυμον, οἷον ἐπὶ τοῦ ‘οιος’·", "seq": 238}
{"id": "Philoponus_Passim_0239", "series": "CAG", "text": "σημαίνει γὰρ καὶ τὸ μόνος, σημαίνει καὶ τὸ ὁποῖος, καὶ τὸ μὲν δασύνεται τὸ ὁποῖος, τὸ δὲ ψιλοῦται τὸ μόνος.", "seq": 239}
{"id": "Philoponus_Passim_0240", "series": "CAG", "text": "χρεία δὲ καὶ τῆς αὐτῆς καταλήξεως.", "seq": 240}
{"id": "Philoponus_Passim_0241", "series": "CAG", "text": "σαφὲς δὲ οἶμαι τοῦτο·", "seq": 241}
{"id": "Philoponus_Passim_0242", "series": "CAG", "text": "τὸ γὰρ ἐλάτης καὶ ἡ ἐλάτη καταλήξει διαφέροντα οὐκ εἰσὶν ὁμώνυμα.", "seq": 242}
{"id": "Philoponus_Passim_0243", "series": "CAG", "text": "Ζητοῦσι δέ τινες διὰ τί μὴ εἶπεν ὁμώνυμον, ἀλλὰ ὁμώνυμα.", "seq": 243}
{"id": "Philoponus_Passim_0244", "series": "CAG", "text": "φαμὲν ὅτι τὸ ὁμώνυμον οὐκ ἔστιν ἕν (οὐ γὰρ λέγεται αὐτὸ ἑαυτῷ τι εἶναι ὁμώνυμον), ἀλλὰ πλείονα (ἄλλο γὰρ ἄλλῳ ἐστὶν ὁμώνυμον), διὸ πληθυντικῶς εἴρηκεν.", "seq": 244}
{"id": "Philoponus_Passim_0245", "series": "CAG", "text": "ἀποροῦσι δὲ πάλιν τί δή ποτε εἶπε λέγεται, καὶ μὴ λέγονται.", "seq": 245}
{"id": "Philoponus_Passim_0246", "series": "CAG", "text": "φαμὲν ὅτι ἐπειδὴ τὰ ὁμώνυμα εἰ καὶ πολλά εἰσιν, ἀλλ᾿ ὅμως καθὸ ὁμώνυμα ἓν ὑπάρχουσιν (ἓν γὰρ τὸ κατὰ πολλῶν κατηγορούμενον ὄνομα), διὰ τοῦτο ἑνικῶς εἶπε λέγεται·", "seq": 246}
{"id": "Philoponus_Passim_0247", "series": "CAG", "text": "πληθυντικὸν γὰρ τὸ λέγονται.", "seq": 247}
{"id": "Philoponus_Passim_0248", "series": "CAG", "text": "ἄλλως τε ἔθος Ἕλλησιν ἐπὶ τῶν οὐδετέρων ὀνομάτων τῷ ἑνικῷ ἀριθμῷ ἀντὶ πληθυντικοῦ κεχρῆσθαι ἐπὶ τῶν τρίτων προσώπων, οἷον τρέχει τὰ παιδία, ἔσφαλται τὰ βιβλία, οὐκ ἐβλάστησε τὰ δένδρα.", "seq": 248}
{"id": "Philoponus_Passim_0249", "series": "CAG", "text": "τὴν δὲ αἰτίαν γραμματικοὶ λεγόντων.", "seq": 249}
{"id": "Philoponus_Passim_0250", "series": "CAG", "text": "οὕτως οὖν κἀνταῦθα τῇ πληθυντικῇ εὐθείᾳ, λέγω δὴ τῇ ὁμώνυμα, ἑνικὸν ῥῆμα ἐπηνέχθη τὸ λέγεται.", "seq": 250}
{"id": "Philoponus_Passim_0251", "series": "CAG", "text": "Ἰστέον δὲ ὅτι τὰ τρία ταῦτά ἐστιν ἀλλήλων διαφέροντα, ὁμώνυμα ὁμωνυμία ὁμωνύμως.", "seq": 251}
{"id": "Philoponus_Passim_0252", "series": "CAG", "text": "ὁμώνυμα μὲν οὖν ἐστιν αὐτὰ τὰ πράγματα, ὁμωνυμία δὲ ἡ σχέσις αὐτή, καθ᾿ ἣν τῷ ὀνόματι κεκοινωνήκασιν, ὁμωνύμως δὲ αὐτὴ ἡ κατηγορία, ἣ κατὰ τῶν πραγμάτων ἐστίν.", "seq": 252}
{"id": "Philoponus_Passim_0253", "series": "CAG", "text": "Ἰστέον δὲ ὅτι εὐθὺς ἐκ προοιμίων τὸν σκοπὸν τοῦ βιβλίου ἀνακηρύττει·", "seq": 253}
{"id": "Philoponus_Passim_0254", "series": "CAG", "text": "φησὶ γὰρ ὁμώνυμα λέγεται·", "seq": 254}
{"id": "Philoponus_Passim_0255", "series": "CAG", "text": "τῷ μὲν γὰρ εἰπεῖν ὁμώνυμα σημαίνει τὰ πράγματα, τῷ δὲ λέγεται τὰς φωνάς·", "seq": 255}
{"id": "Philoponus_Passim_0256", "series": "CAG", "text": "θεωροῦνται δὲ ἐξ ἡμῶν τὰ πράγματα διὰ μέσων τῶν νοημάτων.", "seq": 256}
{"id": "Philoponus_Passim_0257", "series": "CAG", "text": "1a1 Ὁμώνυμα λέγεται.", "seq": 257}
{"id": "Philoponus_Passim_0258", "series": "CAG", "text": "Τὴν τῶν ὁμωνύμων διδασκαλίαν δι᾿ ὁμωνύμων φωνῶν ἐποιήσατο·", "seq": 258}
{"id": "Philoponus_Passim_0259", "series": "CAG", "text": "καὶ γὰρ αὐτὸ τὸ ὁμώνυμον ὁμώνυμόν ἐστι·", "seq": 259}
{"id": "Philoponus_Passim_0260", "series": "CAG", "text": "πολλαχῶς γὰρ λέγεται·", "seq": 260}
{"id": "Philoponus_Passim_0261", "series": "CAG", "text": "τῶν γὰρ ὁμωνύμων τὰ μὲν κατὰ τύχην ἐστίν, ὡς ὅταν ἐν διαφόροις τόποις τύχωσί τινες τὸ αὐτὸ ἔχοντες ὄνομα, ὡς Ἀλέξανδρος ὁ Πάρις καὶ Ἀλέξανδρος ὁ Μακεδών, τὰ δὲ κατὰ προαίρεσιν καὶ διάνοιαν.", "seq": 261}
{"id": "Philoponus_Passim_0262", "series": "CAG", "text": "καὶ τούτων τὰ μὲν κατὰ μνήμην, ὡς ὅταν τις τὸν ἴδιον υἱὸν ὀνόματι τῶν προγόνων καλέσῃ, τὰ δὲ κατ᾿ ἐλπίδα, ὡς ὅταν τις τὸν ἴδιον υἱὸν προσδοκῶν ἔσεσθαι φιλόσοφον καλέσῃ Πλάτωνα (καὶ πολλάκις συντρέχει τῷ κατὰ μνήμην τὸ κατ᾿ ἐλπίδα, ὡς ὅταν τοιοῦτον ἐπιτήδευμα μεταχειρισάμενος ὁ πάππος εὑρεθῇ), τὰ δὲ κατὰ ἀναλογίαν, ὡς ὅταν τῇ τινος ἀναλογίᾳ καλέσωμέν τι, οἷον πόδα κλίνης καὶ κορυφὴν ὄρους (ὃν γὰρ λόγον ἔχει πρὸς τὸν ἄνθρωπον ὁ πούς, τοῦτον καὶ πρὸς τὴν κλίνην ὁ τῆς κλίνης πούς), τὰ δὲ ἀφ᾿ ἑνός, ὡς ὅταν ἀπό τινος ὡρμημένοι καλέσωμεν τῇ ἐκείνου προσηγορίᾳ πάντα τὰ ἐξ αὐτοῦ, ὥσπερ ἰατρικὸν σμιλίον καὶ ἰατρικὸν φάρμακον, τὰ δὲ πρὸς ἕν, ὡς ὅταν ἀφορῶντες πρός τι ἔσεσθαι μέλλον τέλος ὀνομάσωμεν αὐτὰ πρὸς ἐκεῖνο, ὡς ὑγιεινὸν γυμνάσιον καὶ ὑγιεινὸν σιτίον.", "seq": 262}
{"id": "Philoponus_Passim_0263", "series": "CAG", "text": "διαφέρει δὲ τοῦ ἀφ᾿ ἑνός, ὅτι ἐκεῖνα μὲν ἀπό τινος ἀρχῆς λέγεται, ταῦτα δὲ πρός τι τέλος ὁρᾷ.", "seq": 263}
{"id": "Philoponus_Passim_0264", "series": "CAG", "text": "τῶν δὲ ἀφ᾿ ἑνὸς τὰ μὲν ὡς ἀπὸ παραδειγματικοῦ αἰτίου λέγονται, ὡς ὁ ἐν τῇ εἰκόνι ἄνθρωπος ἀπό τινος ἀληθινοῦ ἀνθρώπου, τὰ δὲ ὡς ἀπὸ ποιητικοῦ, ὡς τὸ ἰατρικὸν σμιλίον.", "seq": 264}
{"id": "Philoponus_Passim_0265", "series": "CAG", "text": "ζητητέον δὲ ἐνταῦθα κατὰ ποῖον σημαινόμενον τῶν ὁμωνύμων ὁ Ἀριστοτέλης τὴν τῶν ὁμωνύμων διδασκαλίαν ποιεῖται.", "seq": 265}
{"id": "Philoponus_Passim_0266", "series": "CAG", "text": "φαμὲν οὖν ὡς κατὰ τὸ πρὸς ἓν καὶ ἀφ᾿ ἑνός·", "seq": 266}
{"id": "Philoponus_Passim_0267", "series": "CAG", "text": "ἀπὸ γὰρ τοῦ ἀληθινοῦ ἀνθρώπου ὁ γεγραμμένος ὠνόμασται.", "seq": 267}
{"id": "Philoponus_Passim_0268", "series": "CAG", "text": "τινὲς δὲ ἐζήτησαν διὰ τί μὴ τῷ κατὰ ἀναλογίαν ἐχρήσατο, ὅπερ καὶ ἄμεινον εἶναι δοκεῖ.", "seq": 268}
{"id": "Philoponus_Passim_0269", "series": "CAG", "text": "καί φαμεν ὅτι τὸ ἀνάλογον ἐν τέτρασι τὸ ἐλάχιστον θεωρεῖται (λέγομεν γάρ, εἰ τύχοι, ὅτι τὰ δύο πρὸς τὰ ὀκτὼ ἀναλογίαν ἔχει ὡς τὰ δέκα πρὸς τὰ τεσσαράκοντα·", "seq": 269}
{"id": "Philoponus_Passim_0270", "series": "CAG", "text": "τετραπλασίονα γὰρ λόγον ἔχει ἑκάτερα), τὰ δὲ ὁμώνυμα καὶ ἐν δυσίν·", "seq": 270}
{"id": "Philoponus_Passim_0271", "series": "CAG", "text": "εἰκότως ἄρα οὐ περὶ τῶν κατὰ ἀναλογίαν ὁμωνύμων διαλέγεται.", "seq": 271}
{"id": "Philoponus_Passim_0272", "series": "CAG", "text": "Τινὲς δέ φασιν ὅτι διὰ τοῦτο τῶν πολυωνύμων οὐκ ἐμνήσθη, ἐπειδὴ τὰ ὁμώνυμα κατὰ μὲν τὸ ὄνομα ταὐτὰ εὑρίσκονται, κατὰ δὲ τὸν ὁρισμὸν διαφέρουσι, τὰ δὲ πολυώνυμα τοὐναντίον·", "seq": 272}
{"id": "Philoponus_Passim_0273", "series": "CAG", "text": "ὁ οὖν φιλόσοφος ὡς περὶ πραγμάτων διαλεγόμενος κατεφρόνησε τῶν ὀνομάτων·", "seq": 273}
{"id": "Philoponus_Passim_0274", "series": "CAG", "text": "τὸ γὰρ ταῦτα ζητεῖν γραμματικοῖς πρέπει.", "seq": 274}
{"id": "Philoponus_Passim_0275", "series": "CAG", "text": "καὶ ἄλλως, ὅπερ ἤδη εἶπον, περὶ μόνων τῶν χρησιμευόντων αὐτῷ εἰς τὴν τῶν κατηγοριῶν διδασκαλίαν προλαμβάνει νῦν.", "seq": 275}
{"id": "Philoponus_Passim_0276", "series": "CAG", "text": "1a1 Λέγεται.", "seq": 276}
{"id": "Philoponus_Passim_0277", "series": "CAG", "text": "Ὑπακουστέον ‘πράγματα’, ἵνα οὕτως ᾖ ‘ὁμώνυμα λέγεται πράγματα, ὧν ὄνομα μόνον κοινόν’.", "seq": 277}
{"id": "Philoponus_Passim_0278", "series": "CAG", "text": "ἡνίκα δὲ εἴπῃ ὅτι λέγεται, δηλοῖ ὅτι καὶ παρὰ τοῖς παλαιοῖς τοὔνομα φέρεται καὶ οὐκ αὐτοῦ ἐστιν ἡ τοιαύτη θέσις τοῦ ὀνόματος·", "seq": 278}
{"id": "Philoponus_Passim_0279", "series": "CAG", "text": "καὶ γὰρ καὶ Πλάτων ἐμνήσθη αὐτῶν καὶ ὁ ποιητὴς λέγων περὶ τῶν Αἰάντων", "seq": 279}
{"id": "Philoponus_Passim_0280", "series": "CAG", "text": "ἶσον θυμὸν ἔχοντες ὁμώνυμοι.", "seq": 280}
{"id": "Philoponus_Passim_0281", "series": "CAG", "text": "ὅταν δὲ αὐτὸς ὀνοματοθετῇ, λέγει ‘καλῶ’, ὡς ἐν τοῖς Ἀναλυτικοῖς “ὅρον δὲ καλῶ” καὶ ἐν τῷ Περὶ ἑρμηνείας “καὶ ἔστω τοῦτο ἀντίφασις”.", "seq": 281}
{"id": "Philoponus_Passim_0282", "series": "CAG", "text": "1a1 Ὦν ὄνομα μόνον κοινόν.", "seq": 282}
{"id": "Philoponus_Passim_0283", "series": "CAG", "text": "Ἆρ᾿ οὖν ἐν τοῖς ῥήμασιν οὐκ ἔστιν ὁμωνυμία;", "seq": 283}
{"id": "Philoponus_Passim_0284", "series": "CAG", "text": "καὶ μὴν ἔστι·", "seq": 284}
{"id": "Philoponus_Passim_0285", "series": "CAG", "text": "λέγομεν γὰρ ‘ἐρῶ’, καὶ σημαίνει τοῦτο καὶ τὸ λέξω καὶ τὸ ἐρωτικῶς διάκειμαι.", "seq": 285}
{"id": "Philoponus_Passim_0286", "series": "CAG", "text": "πῶς οὖν ὁμώνυμα εἶπε τὰ μόνον τὸ ὄνομα κοινὸν ἔχοντα;", "seq": 286}
{"id": "Philoponus_Passim_0287", "series": "CAG", "text": "ἐροῦμεν πρὸς τοῦτο ὅτι τὸ ὄνομα διχῶς λέγεται, τὸ μὲν πρὸς ἀντιδιαστολὴν τοῦ ῥήματος τὸ δὲ κοινῶς λεγόμενον ἐπὶ πάσης λέξεως, καθ᾿ ὃ σημαινόμενον πᾶσα φωνὴ σημαντικὴ ὄνομα λέγεται, ὡς ἐν τῷ Περὶ ἑρμηνείας φησίν “αὐτὰ μὲν οὖν καθ᾿ ἑαυτὰ λεγόμενα τὰ ῥήματα ὀνόματά ἐστι καὶ σημαίνει τι”.", "seq": 287}
{"id": "Philoponus_Passim_0288", "series": "CAG", "text": "ἐνταῦθα οὖν ὄνομα λέγει οὐ τὸ ἀντιδιαστελλόμενον πρὸς τὸ ῥῆμα, ἀλλὰ τὸ κοινῶς κατηγορούμενον πάσης φωνῆς σημαντικῆς·", "seq": 288}
{"id": "Philoponus_Passim_0289", "series": "CAG", "text": "ὥστε τὸ ἐρῶ τὸ σημαῖνον τὸ λέξω καὶ τὸ ἐρωτικῶς διάκειμαι ὁμώνυμόν ἐστι·", "seq": 289}
{"id": "Philoponus_Passim_0290", "series": "CAG", "text": "κοινὸν γὰρ ὄνομα ἔχει τὸ ἐρῶ, ὅρον δὲ διάφορον.", "seq": 290}
{"id": "Philoponus_Passim_0291", "series": "CAG", "text": "ἔστιν οὖν καὶ ἐν τοῖς ῥήμασιν ὁμωνυμία.", "seq": 291}
{"id": "Philoponus_Passim_0292", "series": "CAG", "text": "1a1 Μόνον κοινόν.", "seq": 292}
{"id": "Philoponus_Passim_0293", "series": "CAG", "text": "Διχῶς λέγεται τὸ μόνον·", "seq": 293}
{"id": "Philoponus_Passim_0294", "series": "CAG", "text": "ἢ τὸ μοναδικόν, ὡς ὅταν λέγωμεν μόνον ἥλιον καὶ μόνην σελήνην, ἢ τὸ ἀντιδιαστελλόμενον πρὸς τὸ σύζυγον, ὡς ὅταν λέγωμεν ‘ἀπελείφθην ἐν πολέμῳ δόρυ ἔχων μόνον’, καίτοι οὐδὲν κωλύει καὶ ὑποδήματα ἔχειν καὶ ἱμάτιον, ἀλλὰ πρὸς ἀντιδιαστολὴν τῆς ἀσπίδος ἢ τῶν ἄλλων ὅπλων, καὶ ‘ἐν τῷ ἀρίστῳ ἄρτον εἶχον μόνον’, καίτοι οὐδὲν κωλύει καὶ ἱμάτιον ἔχειν, ἀλλὰ πρὸς ἀντιδιαστολὴν τῶν ὄψων.", "seq": 294}
{"id": "Philoponus_Passim_0295", "series": "CAG", "text": "ἐνταῦθα οὖν ὡς πρὸς τὸ σύζυγον τὸ μόνον ἀπέδωκε, λέγω δὴ τὸν ὁρισμόν.", "seq": 295}
{"id": "Philoponus_Passim_0296", "series": "CAG", "text": "Τὸ δὲ κοινὸν τετραχῶς λέγεται·", "seq": 296}
{"id": "Philoponus_Passim_0297", "series": "CAG", "text": "ἢ τὸ ἀμερίστως μεθεκτόν, ὥς φαμεν δοῦλον κοινόν (οὗτος γὰρ τῇ μὲν οὐσίᾳ ἀμέριστος, τῇ δὲ χρήσει μεριστός), ἢ τὸ μεριστῶς μεθεκτόν, ὡς λέγομεν ἄριστον κοινὸν καὶ ἀγρὸν κοινόν (μετέχομεν γὰρ οὐ πάντες ὅλου, ἀλλὰ ἕκαστος μέρους), ἢ τὸ ἐν προκαταλήψει, ὡς ὁ ἐν τῷ θεάτρῳ τόπος κοινός (τοῦ γὰρ προκαταλαβόντος γίνεται), ἢ τὸ ἐξ ἴσου παρὰ τῶν μετεχόντων μεταλαμβανόμενον, ὡς λέγεται κοινὴ ἡ τοῦ κήρυκος φωνή (ἐξ ἴσου γὰρ αὐτῆς πάντες ἀκούουσι, καὶ οὐχ ὅδε μὲν τῆσδε ὅδε δὲ τῆσδε τῆς συλλαβῆς) καὶ ἡ ἀνθρωπεία φύσις κοινὴ τῶν μετεχόντων πάντων·", "seq": 297}
{"id": "Philoponus_Passim_0298", "series": "CAG", "text": "ἐξ ἴσου γὰρ αὐτῆς οἱ κατὰ μέρος μετέχομεν ἄνθρωποι πάντες.", "seq": 298}
{"id": "Philoponus_Passim_0299", "series": "CAG", "text": "ἐνταῦθα οὖν τὸ κοινὸν παρέλαβε κατὰ τὸ ἐξ ἴσου μεθεκτόν.", "seq": 299}
{"id": "Philoponus_Passim_0300", "series": "CAG", "text": "1a1 Ὁ δὲ κατὰ τοὔνομα λόγος τῆς οὐσίας ἕτερος.", "seq": 300}
{"id": "Philoponus_Passim_0301", "series": "CAG", "text": "Εἰπὼν τὰ τοῖς ὁμωνύμοις ὑπάρχοντα νῦν προστίθησι τίνα αὐτοῖς οὐχ ὑπάρχει, ἵνα μὴ μόνον ἐκ τῆς κοινωνίας ἀλλὰ καὶ ἐκ τῆς διαφορᾶς ἔχωμεν διαγινώσκειν αὐτά.", "seq": 301}
{"id": "Philoponus_Passim_0302", "series": "CAG", "text": "ζητητέον δὲ τί δή ποτε μὴ εἶπεν ‘ὧν ὄνομα μόνον κοινόν, ὁ δὲ λόγος τῆς οὐσίας ἕτερος’, ἀλλ᾿ ὁ κατὰ τοὔνομα λόγος τῆς οὐσίας ἕτερος.", "seq": 302}
{"id": "Philoponus_Passim_0303", "series": "CAG", "text": "φαμὲν ὅτι ἐνδέχεται τὰ ὁμώνυμα καὶ συνώνυμα εἶναι κατ᾿ ἄλλο καὶ ἄλλο·", "seq": 303}
{"id": "Philoponus_Passim_0304", "series": "CAG", "text": "οἱ γὰρ Αἴαντες ᾗ μὲν ἄνθρωποί εἰσιν, συνώνυμοί εἰσι (μετέχουσι γὰρ καὶ τοῦ ἀνθρώπου ὀνόματος καὶ τοῦ ὁρισμοῦ·", "seq": 304}
{"id": "Philoponus_Passim_0305", "series": "CAG", "text": "ἑκάτερος γὰρ αὐτῶν ζῷον λογικὸν θνητόν ἐστιν), ᾗ δὲ Αἴαντες, ὁμώνυμοι.", "seq": 305}
{"id": "Philoponus_Passim_0306", "series": "CAG", "text": "ἵνα οὖν μὴ τὸν τυχόντα ὁρισμὸν λαμβάνωμεν, ἀλλὰ τὸν κατὰ τὸ ὄνομα, καθ᾿ ὃ κοινωνοῦσι, καλῶς εἶπεν ὁ δὲ κατὰ τοὔνομα λόγος·", "seq": 306}
{"id": "Philoponus_Passim_0307", "series": "CAG", "text": "οἱ γὰρ Αἴαντες κοινὸν μὲν ἔχουσιν αὐτὸ τοῦτο τὸ ὄνομα, τὸν δὲ λόγον τὸν κατ᾿ αὐτὸ τοῦτο οὐκέτι τὸν αὐτόν, ἀλλ᾿ ὁ μέν ἐστιν ἐκ Σαλαμῖνος υἱὸς Τελαμῶνος ὁ μονομαχήσας Ἕκτορι, ὁ δὲ Ὀϊλέως ἐκ Λοκρίδος πόδας ταχὺς τοξότης.", "seq": 307}
{"id": "Philoponus_Passim_0308", "series": "CAG", "text": "1a1 Ὁ δὲ κατὰ τοὔνομα λόγος.", "seq": 308}
{"id": "Philoponus_Passim_0309", "series": "CAG", "text": "Τί δή ποτε μὴ εἶπεν ‘ὁ δὲ κατὰ τοὔνομα ὁρισμός’, ἀλλὰ λόγος;", "seq": 309}
{"id": "Philoponus_Passim_0310", "series": "CAG", "text": "φασὶν ἐπειδήπερ οὐκ ἐπὶ πάντων τῶν πραγμάτων εὐποροῦμεν ὁρισμῶν, ἀλλ᾿ ἔστιν ὅτε ὑπογραφαῖς κεχρήμεθα ἀποροῦντες δι᾿ ὁρισμῶν ἀποδιδόναι τὰ πράγματα·", "seq": 310}
{"id": "Philoponus_Passim_0311", "series": "CAG", "text": "τῶν γοῦν γενικωτάτων γενῶν ὁρισμὸν ἀποδοῦναι ἀδύνατον·", "seq": 311}
{"id": "Philoponus_Passim_0312", "series": "CAG", "text": "πᾶς γὰρ ὁρισμὸς ἐκ γένους ἐστὶ καὶ συστατικῶν διαφορῶν, τούτων δὲ ὑπεραναβεβηκὸς γένος οὐκ ἔστιν εὑρεῖν, ἵνα ἐκ τούτου καὶ τῶν διαφορῶν ἀποδῶμεν αὐτῶν τὸν ὁρισμόν, διὸ ἀνάγκη κἂν δι᾿ ὑπογραφῆς αὐτὰ ἀποδιδόναι.", "seq": 312}
{"id": "Philoponus_Passim_0313", "series": "CAG", "text": "διὰ τοῦτο οὐκ εἶπεν ‘ὁ δὲ κατὰ τοὔνομα ὁρισμός’, ἐπειδὴ παρελίμπανε τὰ δι᾿ ὑπογραφῆς σημαινόμενα·", "seq": 313}
{"id": "Philoponus_Passim_0314", "series": "CAG", "text": "δυνατὸν γὰρ ταύτῃ χρήσασθαι ἐπὶ πάντων, ἐκ τῶν κατὰ συμβεβηκὸς ὑπαρχόντων τοῖς πράγμασιν αὐτὴν λαμβάνοντας.", "seq": 314}
{"id": "Philoponus_Passim_0315", "series": "CAG", "text": "ἀλλὰ λέγω ὅτι ἐν οἷς ἔστι δι᾿ ὁρισμῶν ἀποδοῦναι τὰ πράγματα, περιττὸν τὸ δι᾿ ὑπογραφῆς ἀποδοῦναι.", "seq": 315}
{"id": "Philoponus_Passim_0316", "series": "CAG", "text": "καὶ διὰ τί οὖν μὴ εἶπεν ‘ὁ δὲ κατὰ τοὔνομα ὁρισμὸς ἤτοι ὑπογραφή’;", "seq": 316}
{"id": "Philoponus_Passim_0317", "series": "CAG", "text": "λέγομεν οὖν ὅτι συντομίας ὢν ἐραστὴς τὸ κοινῶς τούτων κατηγορούμενον εἶπεν, ὅπερ ἐστὶν ὁ λόγος·", "seq": 317}
{"id": "Philoponus_Passim_0318", "series": "CAG", "text": "λόγος γὰρ λέγεται καὶ ὁ ὁρισμὸς καὶ ἡ ὑπογραφὴ τῆς οὐσίας.", "seq": 318}
{"id": "Philoponus_Passim_0319", "series": "CAG", "text": "Ἆρ᾿ οὖν οὐκ ἔστι καὶ ἐν τοῖς συμβεβηκόσιν ὁμωνυμία;", "seq": 319}
{"id": "Philoponus_Passim_0320", "series": "CAG", "text": "καὶ μὴν ὁρῶμεν τὸ τοιοῦτον·", "seq": 320}
{"id": "Philoponus_Passim_0321", "series": "CAG", "text": "τὸ γὰρ ὀξὺ κατηγορεῖται καὶ κατὰ χυμοῦ καὶ φωνῆς καὶ νοσήματος καὶ ὄγκου·", "seq": 321}
{"id": "Philoponus_Passim_0322", "series": "CAG", "text": "λέγομεν γὰρ ὀξὺν χυμὸν καὶ ὀξεῖαν φωνὴν καὶ ὀξὺ νόσημα καὶ ὄγκον ὀξύν.", "seq": 322}
{"id": "Philoponus_Passim_0323", "series": "CAG", "text": "ὁμοίως καὶ τὸ βαρὺ κατηγορεῖται καὶ κατὰ φωνῆς καὶ κατὰ ὄγκου καὶ κατὰ ἤθους ψυχῆς, ὡς ὅταν λέγωμεν ‘βαρὺς ἄνθρωπος’.", "seq": 323}
{"id": "Philoponus_Passim_0324", "series": "CAG", "text": "πῶς οὖν εἶπε τῆς οὐσίας;", "seq": 324}
{"id": "Philoponus_Passim_0325", "series": "CAG", "text": "φαμὲν ὅτι διπλοῦν οἶδε τὸ σημαινόμενον τῆς οὐσίας ὁ Ἀριστοτέλης, καθ᾿ ἓν μὲν τὴν ἀντιδιαστελλομένην πρὸς τὰ συμβεβηκότα καὶ αὐθυπόστατον (ἐκείνων ἐν ἑτέρῳ τὸ εἶναι ἐχόντων, λέγω δὴ ἐν τῇ οὐσίᾳ), καθ᾿ ἕτερον δέ, καθ᾿ ὃ πᾶσαν ἁπλῶς ὕπαρξιν οὐσίαν καλεῖ, καθ᾿ ὃ νῦν σημαινόμενον ἐχρήσατο τῷ τῆς οὐσίας ὀνόματι περιλαμβάνων καὶ τὰ συμβεβηκότα.", "seq": 325}
{"id": "Philoponus_Passim_0326", "series": "CAG", "text": "τί δή ποτε ὅλως προσέθηκε τῆς οὐσίας, καὶ μὴ εἶπεν ‘ὁ δὲ κατὰ τοὔνομα λόγος ἕτερος’;", "seq": 326}
{"id": "Philoponus_Passim_0327", "series": "CAG", "text": "λέγομεν οὖν ἵνα μή τις ἀποδιδοὺς τῆς φωνῆς τὸν ὁρισμὸν λέγῃ τὰ ὁμώνυμα εἶναι συνώνυμα·", "seq": 327}
{"id": "Philoponus_Passim_0328", "series": "CAG", "text": "δυνατὸν γὰρ τῆς Αἴας φωνῆς ἀποδοῦναι τὸν ὁρισμὸν ἤτοι τὴν ὑπογραφὴν λέγοντας ὅτι ἐστὶν Αἴας φωνὴ δισύλλαβος βαρύτονος ψιλὴ εἰς καθαρὸν ας λήγουσα, καὶ κατὰ τοῦτο συνώνυμοι ἔσονται οἱ Αἴαντες.", "seq": 328}
{"id": "Philoponus_Passim_0329", "series": "CAG", "text": "διὰ τοῦτο ἀκριβῶς προσέθηκεν ὁ δὲ κατὰ τοὔνομα λόγος τῆς οὐσίας, τοῦτ᾿ ἔστι τῆς ὑπὸ τοῦ ὀνόματος σημαινομένης.", "seq": 329}
{"id": "Philoponus_Passim_0330", "series": "CAG", "text": "Φασὶ δέ τινες μήποτε καὶ τὰ ὁμώνυμά εἰσι συνώνυμα·", "seq": 330}
{"id": "Philoponus_Passim_0331", "series": "CAG", "text": "κοινωνοῦσι γὰρ ἀλλήλοις καὶ κατὰ τοὔνομα καὶ κατὰ τὸν ὁρισμὸν τὸν τοῦ ὁμωνύμου·", "seq": 331}
{"id": "Philoponus_Passim_0332", "series": "CAG", "text": "τῶν γὰρ Αἰάντων κατηγορεῖται μὲν καὶ αὐτὸ τὸ ὁμώνυμον, οὐ μόνον δὲ ἀλλὰ καὶ ὁ τοῦ ὁμωνύμου ὁρισμός·", "seq": 332}
{"id": "Philoponus_Passim_0333", "series": "CAG", "text": "ἑκάτερος γὰρ αὐτῶν λέγεται ἔχειν τῷ ἑτέρῳ ὄνομα μόνον κοινόν, τὸν δὲ κατὰ τοὔνομα λόγον τῆς οὐσίας ἕτερον.", "seq": 333}
{"id": "Philoponus_Passim_0334", "series": "CAG", "text": "οὕτως οὖν ἐδείχθη καὶ τὰ ὁμώνυμα ὄντα συνώνυμα.", "seq": 334}
{"id": "Philoponus_Passim_0335", "series": "CAG", "text": "τί οὖν ἐροῦμεν;", "seq": 335}
{"id": "Philoponus_Passim_0336", "series": "CAG", "text": "πρῶτον μὲν οὐδὲν ἄτοπον, εἰ τὰ αὐτὰ καὶ ὁμώνυμα καὶ συνώνυμά εἰσι κατ᾿ ἄλλο καὶ ἄλλο, μᾶλλον δὲ καὶ ἀναγκαῖον·", "seq": 336}
{"id": "Philoponus_Passim_0337", "series": "CAG", "text": "οἱ γὰρ Αἴαντες ᾗ μὲν ἄνθρωποι, συνώνυμοί εἰσιν, ᾗ δ᾿ Αἴαντες, ὁμώνυμοι.", "seq": 337}
{"id": "Philoponus_Passim_0338", "series": "CAG", "text": "οὕτω τοίνυν κἀνταῦθα ᾗ μὲν Αἴαντες, ὁμώνυμοι (μόνης γὰρ τῆς Αἴας φωνῆς κοινωνοῦντες τῷ κατ᾿ αὐτὴν ὁρισμῷ διαφέρουσιν), ᾗ δὲ ὁμώνυμοι, συνώνυμοι κοινωνοῦντες οὐ μόνον τῆς τοῦ ὁμωνύμου προσηγορίας, ἀλλὰ καὶ τοῦ κατ᾿ αὐτὴν ὁρισμοῦ.", "seq": 338}
{"id": "Philoponus_Passim_0339", "series": "CAG", "text": "ἄλλως τε οὔτε δυνατὸν ταῦτα συνώνυμα λέγειν·", "seq": 339}
{"id": "Philoponus_Passim_0340", "series": "CAG", "text": "τῶν γὰρ συνωνύμων κοινῶς τε κατηγορεῖται τὸ ὄνομα καὶ ὁ ὁρισμὸς καὶ ἰδίᾳ ἑκάστου καὶ ἀσχέτως·", "seq": 340}
{"id": "Philoponus_Passim_0341", "series": "CAG", "text": "οἷον τὸ ζῷον κατηγορεῖται καὶ κοινῶς πάντων τῶν ὑπ᾿ αὐτὸ καὶ ἰδίᾳ ἑκάστου (λέγεται γὰρ Σωκράτης εἶναι ζῷον καὶ ἵππος εἶναι ζῷον), ἀλλὰ καὶ ὁ ὁρισμός·", "seq": 341}
{"id": "Philoponus_Passim_0342", "series": "CAG", "text": "οὐσία γὰρ ἔμψυχος αἰσθητική, ὅπερ ἐστὶν ὁρισμὸς ζῴου, καὶ κοινῶς πάντων τῶν κατὰ μέρος ζῴων κατηγορεῖται καὶ ἰδίᾳ ἑκάστου·", "seq": 342}
{"id": "Philoponus_Passim_0343", "series": "CAG", "text": "καὶ γὰρ ὁ Σωκράτης οὐσία ἔμψυχος αἰσθητικὴ καὶ ὁ ἵππος ὁμοίως.", "seq": 343}
{"id": "Philoponus_Passim_0344", "series": "CAG", "text": "ἐπὶ δὲ τῶν ὁμωνύμων οὐχ οὕτως·", "seq": 344}
{"id": "Philoponus_Passim_0345", "series": "CAG", "text": "οὐ γὰρ δυνατὸν ἑκάστου ἰδίᾳ καὶ ἀσχέτως οὔτε τὸ ὄνομα οὔτε τὸν ὁρισμὸν κατηγορῆσαι·", "seq": 345}
{"id": "Philoponus_Passim_0346", "series": "CAG", "text": "οὐ γὰρ λέγεται ὁ Αἴας καθ᾿ ἑαυτὸν ὁμώνυμος, ἀλλ᾿ οὐδὲ ὄνομα μόνον ἔχει κοινὸν τὸν δὲ κατὰ τοὔνομα λόγον τῆς οὐσίας ἕτερον, ἀλλὰ ἄλλῳ λέγεται ὁμώνυμος, καὶ τοὐλάχιστον δύο πραγμάτων κατηγορηθήσεται ἡ τοῦ ὁμωνύμου προσηγορία, ἐπειδὴ καὶ τῶν ἐν σχέσει ἐστίν.", "seq": 346}
{"id": "Philoponus_Passim_0347", "series": "CAG", "text": "οὐ συνώνυμα ἄρα τὰ ὁμώνυμα.", "seq": 347}
{"id": "Philoponus_Passim_0348", "series": "CAG", "text": "Δύναται δὲ τὸ ὁμώνυμον διαιρεῖσθαι οὐ μόνον κατὰ τὴν ἔμπροσθεν ἀποδεδομένην διαίρεσιν, ἀλλὰ καὶ ποικιλώτερον κατὰ τὸν ὑποκείμενον τρόπον.", "seq": 348}
{"id": "Philoponus_Passim_0349", "series": "CAG", "text": "τὰ ὁμώνυμα ἢ ἀπὸ τύχης εἰσὶν ἢ ἀπὸ διανοίας·", "seq": 349}
{"id": "Philoponus_Passim_0350", "series": "CAG", "text": "καὶ ἀπὸ μὲν τύχης, ὡς εἰ τύχοι ἐν Ἀθήναις κἀνταῦθά τινας τῷ αὐτῷ ὀνόματι κεχρῆσθαι, ἀπὸ δὲ διανοίας, ὡς ὅταν πρός τινα σκοπὸν ἀφορῶσα ἡ διάνοια ἐπιτίθησι τὰ ὀνόματα.", "seq": 350}
{"id": "Philoponus_Passim_0351", "series": "CAG", "text": "καὶ τῶν ἀπὸ διανοίας ἢ τῷ μὲν ἀφ᾿ οὗ παρώνυμα ἀλλήλοις δὲ ὁμώνυμα, ὡς ἀπὸ ἰατρικῆς τὰ ἰατρικὰ ὄργανα (παρωνύμως γὰρ ἀπ᾿ αὐτῆς ὀνομάζεται, ἀλλήλοις δὲ ὁμωνύμως), ἢ καὶ τῷ ἀφ᾿ οὗ καὶ ἀλλήλοις ὁμώνυμα, ὡς ὅταν τις τῷ τοῦ πατρὸς ὀνόματι τοὺς παῖδας ἢ τοὺς ἐκγόνους καλέσῃ.", "seq": 351}
{"id": "Philoponus_Passim_0352", "series": "CAG", "text": "τῶν δὲ τῷ ἀφ᾿ οὗ παρωνύμων ἀλλήλοις δὲ ὁμωνύμων τὰ μὲν ἀπὸ ποιητικοῦ τινος αἰτίου ὀνομάζονται, ἃ ἀφ᾿ ἑνὸς λέγεται, ὡς ἀπὸ ἰατρικῆς ἰατρικὰ ὄργανα (ἀπ᾿ ἐκείνης γὰρ παρωνύμως λέγονται), τὰ δὲ ἀπὸ τοῦ τελικοῦ καὶ λέγεται πρὸς ἕν, ὡς ὑγιεινὸν σιτίον καὶ δίαιτα καὶ γυμνάσιον·", "seq": 352}
{"id": "Philoponus_Passim_0353", "series": "CAG", "text": "πρὸς ἓν τέλος γὰρ ὁρῶσι τὴν ὑγείαν.", "seq": 353}
{"id": "Philoponus_Passim_0354", "series": "CAG", "text": "τὰ δὲ τῷ ἀφ᾿ οὗ καὶ ἀλλήλοις ὁμώνυμα ἢ ἀλλήλοις εἰσὶν ἰσόχρονα καὶ τῷ ἀφ᾿ οὗ ἢ ἀλλήλοις μὲν ἰσόχρονα τῷ δὲ ἀφ᾿ οὗ οὐκέτι.", "seq": 354}
{"id": "Philoponus_Passim_0355", "series": "CAG", "text": "καὶ τῶν ἀφ᾿ οὗ τὰ μὲν καθ᾿ ὁμοιότητα λέγεται τὰ δὲ κατὰ ἀναλογίαν, ὡς λέγομεν κορυφὰς ὄρους καὶ πόδας κλίνης·", "seq": 355}
{"id": "Philoponus_Passim_0356", "series": "CAG", "text": "ὃν γὰρ λόγον ἔχουσιν οἱ πόδες πρὸς τὸ ὅλον ζῷον, οὕτω καὶ τὰ κάτω μέρη τῆς κλίνης.", "seq": 356}
{"id": "Philoponus_Passim_0357", "series": "CAG", "text": "τῶν δὲ καθ᾿ ὁμοιότητα τὰ μὲν κατ᾿ ἐνέργειαν, ὡς ὅταν διὰ τὸ ἐοικέναι τὰς ἐνεργείας τῷ πατρὶ καλέσωμέν τινα τῷ ἐκείνου ὀνόματι, τὰ δὲ κατὰ μορφήν, ὡς ὅταν τὴν εἰκόνα τοῦ Σωκράτους καλέσωμεν τῷ τοῦ Σωκράτους ὀνόματι.", "seq": 357}
{"id": "Philoponus_Passim_0358", "series": "CAG", "text": "τῶν δὲ ἀλλήλοις μὲν ἰσοχρόνων τῷ δὲ ἀφ᾿ οὗ οὐκέτι τὰ μὲν κατ᾿ ἐλπίδα, ὡς ὅταν τινὲς Πλάτωνας τοὺς υἱοὺς καλέσωσιν ἐλπίζοντες αὐτοὺς γενέσθαι κατὰ Πλάτωνα, τὰ δὲ κατὰ μνήμην, ὡς ὅταν τινὲς καλέσωσι τὸν παῖδα τῷ τοῦ πάππου ὀνόματι, ἵνα φυλάττηται ἡ ἐκείνου μνήμη.", "seq": 358}
{"id": "Philoponus_Passim_0359", "series": "CAG", "text": "ἐνταῦθα οὖν Ἀριστοτέλης ποῖον σημαινόμενον τοῦ ὁμωνύμου παραλαμβάνει;", "seq": 359}
{"id": "Philoponus_Passim_0360", "series": "CAG", "text": "τὸ κατὰ τὴν μορφὴν ὅμοιον.", "seq": 360}
{"id": "Philoponus_Passim_0361", "series": "CAG", "text": "τινὲς δέ φασιν ὅτι τὸ ὡς ἀφ᾿ ἑνός·", "seq": 361}
{"id": "Philoponus_Passim_0362", "series": "CAG", "text": "ὡς γὰρ ἀπ᾿ αἰτίου τοῦ ἀνθρώπου ἐστὶν ἡ εἰκών.", "seq": 362}
{"id": "Philoponus_Passim_0363", "series": "CAG", "text": "ἑκάτερον δέ ἐστιν ἀληθές.", "seq": 363}
{"id": "Philoponus_Passim_0364", "series": "CAG", "text": "1a2 Οἷον ζῷον ὅ τε ἄνθρωπος καὶ τὸ γεγραμμένον.", "seq": 364}
{"id": "Philoponus_Passim_0365", "series": "CAG", "text": "Τούτων γὰρ ἡ μὲν ὀνομασία κοινή (ζῷον γὰρ ἐρεῖς ἑκάτερον), ὁ δὲ ὁρισμὸς οὐκέτι ὁ αὐτός·", "seq": 365}
{"id": "Philoponus_Passim_0366", "series": "CAG", "text": "τὸ μὲν γὰρ ὁριζόμενος ἐρεῖς ‘οὐσία ἔμψυχος αἰσθητική’, τὸ δὲ ‘μίμημα οὐσίας ἐμψύχου αἰσθητικῆς’.", "seq": 366}
{"id": "Philoponus_Passim_0367", "series": "CAG", "text": "1a4 Ἐὰν γὰρ ἀποδιδῶ τις τί ἐστιν αὐτῶν ἑκατέρῳ τὸ ζῴῳ εἶναι, ἴδιον ἑκατέρου λόγον ἀποδώσει.", "seq": 367}
{"id": "Philoponus_Passim_0368", "series": "CAG", "text": "Τριῶν τούτων ὄντων, ὕλης καὶ εἴδους καὶ τοῦ συναμφοτέρου, τοὺς ὁρισμοὺς τῶν πραγμάτων ποτὲ μὲν ἀπὸ τῆς ὕλης ποιούμεθα ποτὲ δὲ ἀπὸ τοῦ εἴδους ποτὲ δὲ ἀπὸ τοῦ συναμφοτέρου, ὥσπερ ὁ Ἀριστοτέλης τὸν θυμὸν ὁρίζεται ποτὲ μὲν ἐκ τῆς ὕλης ποτὲ δὲ ἐκ τοῦ εἴδους ποτὲ δὲ ἐκ τοῦ συναμφοτέρου, καὶ ἐκ μὲν τῆς ὕλης θυμὸν εἶναι λέγων ζέσιν τοῦ περικαρδίου αἵματος (τοῦτο γὰρ ὕλη θυμοῦ), ἐκ δὲ τοῦ εἴδους λέγων ‘ὄρεξις ἀντιλυπήσεως’, ἐκ δὲ τοῦ συναμφοτέρου ‘ζέσις τοῦ περικαρδίου αἵματος δι᾿ ὄρεξιν ἀντιλυπήσεως’.", "seq": 368}
{"id": "Philoponus_Passim_0369", "series": "CAG", "text": "ὁ δὲ κυρίως ὁ ἐκ τοῦ εἴδους·", "seq": 369}
{"id": "Philoponus_Passim_0370", "series": "CAG", "text": "ἡ μὲν γὰρ ὕλη κοινωνίας ἐστὶν αἰτία τοῖς πράγμασι, τὸ δὲ εἶδος διαφορᾶς.", "seq": 370}
{"id": "Philoponus_Passim_0371", "series": "CAG", "text": "βουλόμεθα δὲ τοῖς ὁρισμοῖς διακρίνειν ἀλλήλων τὰ πράγματα.", "seq": 371}
{"id": "Philoponus_Passim_0372", "series": "CAG", "text": "διὸ κἀνταῦθα ὁ Ἀριστοτέλης βουλόμενος τὸν ἐκ τοῦ εἴδους αὐτῶν ὁρισμὸν ἀποδοῦναι οὐκ εἶπε ‘τί ἐστιν αὐτῶν ἑκατέρῳ τὸ ζῷον εἶναι’ (τοῦτο γὰρ τὸ συναμφότερον σημαίνει, τήν τε ὕλην καὶ τὸ εἶδος), ἀλλὰ τί ἐστιν αὐτῶν ἑκατέρῳ τὸ ζῴῳ εἶναι, τοῦτ᾿ ἔστι τί ἐστιν ἑκατέρῳ αὐτῶν καθ᾿ ὃ ζῷά εἰσιν, ἵνα τὸν ἐκ τοῦ εἴδους ὁρισμὸν δηλώσῃ·", "seq": 372}
{"id": "Philoponus_Passim_0373", "series": "CAG", "text": "κατὰ τοῦτο γὰρ ζῷά εἰσιν.", "seq": 373}
{"id": "Philoponus_Passim_0374", "series": "CAG", "text": "ἀποδιδοὺς δέ τις κατὰ τί ἑκάτερον τούτων ζῷον λέγεται, ἴδιον ἑκατέρου λόγον ἀποδώσει, ὡς ἀνωτέρω ἡμῖν εἴρηται.", "seq": 374}
{"id": "Philoponus_Passim_0375", "series": "CAG", "text": "1a6 Συνώνυμα δὲ λέγεται ὧν τό τε ὄνομα κοινὸν καὶ ὁ κατὰ τοὔνομα λόγος τῆς οὐσίας ὁ αὐτός, οἷον ζῷον ὅ τε ἄνθρωπος καὶ ὁ βοῦς.", "seq": 375}
{"id": "Philoponus_Passim_0376", "series": "CAG", "text": "Μετὰ τὸ πληρῶσαι τὸν περὶ τῶν ὁμωνύμων λόγον ἑξῆς περὶ τῶν συνωνύμων διαλαμβάνει.", "seq": 376}
{"id": "Philoponus_Passim_0377", "series": "CAG", "text": "ἐκ δὲ τῶν ὁμωνύμων δήλη καὶ ἡ περὶ τῶν συνωνύμων διδασκαλία·", "seq": 377}
{"id": "Philoponus_Passim_0378", "series": "CAG", "text": "τὰ αὐτὰ γὰρ δεῖ εἰπεῖν, ὅσα καὶ ἐπὶ τῶν ὁμωνύμων εἴρηται, ὅτι οὐ μόνον ἐν ὀνόμασιν ἀλλὰ καὶ ἐν ῥήμασίν ἐστιν ἡ συνωνυμία καὶ ὅτι ἐστὶ καὶ ἐν τοῖς συμβεβηκόσιν ἡ συνωνυμία·", "seq": 378}
{"id": "Philoponus_Passim_0379", "series": "CAG", "text": "τὸ γὰρ ἀλλοιοῦν ῥῆμα συνώνυμόν ἐστι·", "seq": 379}
{"id": "Philoponus_Passim_0380", "series": "CAG", "text": "λέγεται γὰρ ἀλλοιοῦν καὶ ὁ λευκαίνων καὶ ὁ μελαίνων.", "seq": 380}
{"id": "Philoponus_Passim_0381", "series": "CAG", "text": "καὶ τὸν αὐτὸν δὲ ὁρισμὸν ἐπιδέχονται·", "seq": 381}
{"id": "Philoponus_Passim_0382", "series": "CAG", "text": "ὁριζόμενοι γὰρ τὸ ἀλλοιοῦν φαμεν ὅτι τὸ ἔχον ἐν ἑαυτῷ ἀρχὴν μεταβλητικὴν ἄλλου, ᾗ ἄλλο.", "seq": 382}
{"id": "Philoponus_Passim_0383", "series": "CAG", "text": "τοῦτο δὲ ἁρμόσει λέγειν καὶ ἐπὶ τοῦ λευκαίνοντος καὶ ἐπὶ τοῦ μελαίνοντος·", "seq": 383}
{"id": "Philoponus_Passim_0384", "series": "CAG", "text": "ἕκαστον γὰρ τῶν ἀλλοιούντων ἀρχὴν ἔχει ἐν ἑαυτῷ μεταβλητικὴν τῶν ἀλλοιουμένων, ἄλλο ὂν παρὰ τὰ ἀλλοιούμενα·", "seq": 384}
{"id": "Philoponus_Passim_0385", "series": "CAG", "text": "εἰ γὰρ μὴ ἦν ἄλλο, οὐκ ἂν οὐδὲ ἠλλοίου·", "seq": 385}
{"id": "Philoponus_Passim_0386", "series": "CAG", "text": "διὸ προσετέθη τὸ ‘ᾗ ἄλλο’.", "seq": 386}
{"id": "Philoponus_Passim_0387", "series": "CAG", "text": "τῷ αὐτῷ δὲ παραδείγματι κέχρηται ἐπίτηδες τῷ τοῦ ζῴου, ἵνα δείξῃ ὅτι τὸ αὐτὸ δύναται καὶ ὁμώνυμον εἶναι καὶ συνώνυμον κατ᾿ ἄλλο καὶ ἄλλο·", "seq": 387}
{"id": "Philoponus_Passim_0388", "series": "CAG", "text": "ἐπὶ μὲν γὰρ ἀνθρώπου τοῦ ἀληθινοῦ καὶ τοῦ γεγραμμένου ὁμώνυμον τὸ ζῷον, ἐπὶ δὲ ἀνθρώπου καὶ βοὸς συνώνυμον.", "seq": 388}
{"id": "Philoponus_Passim_0389", "series": "CAG", "text": "1a12 Παρώνυμα δὲ λέγεται ὅσα ἀπό τινος διαφέροντα τῇ πτώσει τὴν κατὰ τοὔνομα προσηγορίαν ἔχει.", "seq": 389}
{"id": "Philoponus_Passim_0390", "series": "CAG", "text": "Μετὰ τὴν τῶν ὁμωνύμων καὶ συνωνύμων διδασκαλίαν διαλέγεται περὶ τῶν παρωνύμων εἰκότως, ἐπειδὴ ταῦτα σκολιωτέραν τὴν συμπλοκὴν ἔχει·", "seq": 390}
{"id": "Philoponus_Passim_0391", "series": "CAG", "text": "τῶν γὰρ ὁμωνύμων κατὰ τὸ ὄνομα μόνον κοινωνούντων διαφερόντων δὲ κατὰ τὸν ὁρισμόν, καὶ τῶν συνωνύμων καὶ κατὰ τὸ ὄνομα καὶ κατὰ τὸν ὁρισμὸν κοινωνούντων, ταῦτα οὔτε κατὰ τὸ ὄνομα καθάπαξ κοινωνεῖ οὔτε καθάπαξ διαφέρει, ὁμοίως καὶ κατὰ τὸν ὁρισμὸν κατά τι μὲν κοινωνεῖ κατά τι δὲ διαφέρει.", "seq": 391}
{"id": "Philoponus_Passim_0392", "series": "CAG", "text": "οὐκ ἀνάγονται δὲ ταῦτα ὑπὸ τὴν συμπλοκὴν τῶν εἰρημένων τεσσάρων συζυγιῶν, τὴν τῶν ὁμωνύμων λέγω καὶ πολυωνύμων καὶ συνωνύμων καὶ ἑτερωνύμων·", "seq": 392}
{"id": "Philoponus_Passim_0393", "series": "CAG", "text": "ἐκείνων γὰρ χαρακτηριζομένων ἤτοι κατὰ τὴν κοινωνίαν τοῦ ὀνόματος καὶ τοῦ ὁρισμοῦ ἢ κατὰ τὴν διαφορὰν ἀμφοτέρων ἢ κατὰ τὴν καθ᾿ ἕτερον μὲν κοινωνίαν καθ᾿ ἕτερον δὲ διαφοράν, ταῦτα οὔτε καθάπαξ κοινωνεῖ κατ᾿ ἀμφότερα οὔτε καθάπαξ διαφέρει, ἀλλ᾿ οὐδὲ καθ᾿ ἕτερον ἀκριβῶς κοινωνεῖ, καθ᾿ ἕτερον δὲ διαφέρει, ἀλλὰ πῇ μὲν κοινωνεῖ πῇ δὲ διαφέρει κατ᾿ ἀμφότερα.", "seq": 393}
{"id": "Philoponus_Passim_0394", "series": "CAG", "text": "τινὲς δὲ ἀξιοῦσιν αὐτὰ τάττεσθαι μεταξὺ τῶν τε ὁμωνύμων καὶ τῶν συνωνύμων, διότι τῶν ὁμωνύμων κατὰ τὸ ὄνομα μόνον κοινωνούντων κατὰ δὲ τὸν ὁρισμὸν διαφερόντων, τῶν δὲ συνωνύμων κοινωνούντων κατ᾿ ἀμφότερα, ταῦτα οὔτε κατὰ τὸ ὄνομα ἁπλῶς κοινωνεῖ οὔτε κατὰ τὸν ὁρισμόν.", "seq": 394}
{"id": "Philoponus_Passim_0395", "series": "CAG", "text": "βέλτιον δὲ μεταξὺ τῶν συνωνύμων καὶ τῶν ἑτερωνύμων αὐτὰ τάττειν·", "seq": 395}
{"id": "Philoponus_Passim_0396", "series": "CAG", "text": "τῶν μὲν γὰρ κοινωνούντων κατ᾿ ἀμφότερα τῶν δὲ κατ᾿ ἀμφότερα διαφερόντων, ταῦτα μεταξύ πώς εἰσι, πῇ μὲν κοινωνοῦντα πῇ δὲ διαφέροντα κατ᾿ ἀμφότερα.", "seq": 396}
{"id": "Philoponus_Passim_0397", "series": "CAG", "text": "Ἀνάγκη δὲ ἐπὶ τῶν παρωνύμων τέσσαρα ταῦτα παρεῖναι, κοινωνίαν πράγματος καὶ διαφορὰν πράγματος, κοινωνίαν ὀνόματος καὶ διαφορὰν περὶ τὴν τελευταίαν συλλαβήν·", "seq": 397}
{"id": "Philoponus_Passim_0398", "series": "CAG", "text": "εἰ γὰρ ἕν τι τούτων ἐλλείψει, οὐκέτι ἔσται παρώνυμον·", "seq": 398}
{"id": "Philoponus_Passim_0399", "series": "CAG", "text": "ἔστω γὰρ περὶ τὸ ὄνομα κοινωνία καὶ διαφορά, ἔστω δὲ καὶ ἡ περὶ τὸ πρᾶγμα κοινωνία, διαφορὰ δὲ μὴ ἔστω, λέγω ὅτι οὐκ ἔστι παρώνυμον, ὡς ἐπὶ τοῦ πλάτανος καὶ πλατάνιστος καὶ παρθένος καὶ παρθενική·", "seq": 399}
{"id": "Philoponus_Passim_0400", "series": "CAG", "text": "τὸ αὐτὸ γὰρ πρᾶγμα ὑπ᾿ ἀμφοτέρων σημαίνεται, καὶ ἔστι ποιητικὸν μὲν τὸ παρθενικὴ καὶ τὸ πλατάνιστος, πεζολόγων δὲ τὸ πλάτανος καὶ παρθένος.", "seq": 400}
{"id": "Philoponus_Passim_0401", "series": "CAG", "text": "πάλιν ἔστω τὰ ἄλλα πάντα ἀκολούθως, κοινωνία δὲ μὴ ἔστω περὶ τὸ πρᾶγμα, καὶ ὁμοίως οὐκ ἔσται παρώνυμα, ὡς ἐπὶ τῆς Ἑλένης καὶ Ἑλένου.", "seq": 401}
{"id": "Philoponus_Passim_0402", "series": "CAG", "text": "πάλιν ἔστω τὰ ἄλλα πάντα ἀκολούθως, διαφορὰ δὲ μὴ ἔστω κατὰ τὴν τελευταίαν συλλαβήν, ὡς ἐπὶ τῆς μουσικῆς <ἐπιστήμης> καὶ μουσικῆς γυναικός·", "seq": 402}
{"id": "Philoponus_Passim_0403", "series": "CAG", "text": "ὁμώνυμα γὰρ ταῦτα καὶ οὐ παρώνυμα.", "seq": 403}
{"id": "Philoponus_Passim_0404", "series": "CAG", "text": "πάλιν τὰ μὲν ἄλλα ἔστω, μὴ ἔστω δὲ κοινωνία τις περὶ τὸ ὄνομα, καὶ οὐκ ἔσται παρώνυμα, ὡς ἐπὶ τῆς ἀρετῆς καὶ τοῦ σπουδαίου·", "seq": 404}
{"id": "Philoponus_Passim_0405", "series": "CAG", "text": "οὐδὲ γὰρ ἀπὸ τῆς ἀρετῆς λέγεται ἐνάρετος, διότι οὐδὲ ἐν ὀνείρου ἴχνει τούτου οἱ παλαιοὶ μέμνηνται, ἀλλὰ τοὐναντίον καὶ κακόσημον ἴσασιν οἱ ποιηταὶ τὸ ὄνομα·", "seq": 405}
{"id": "Philoponus_Passim_0406", "series": "CAG", "text": "αἰναρέτη, τί σεῦ ἄλλος ὀνήσεται ὀψίγονός περ;", "seq": 406}
{"id": "Philoponus_Passim_0407", "series": "CAG", "text": "φησὶν Ὅμηρος ἀντὶ τοῦ ‘ὦ ἐπὶ κακῷ τὴν ἀρετὴν ἔχων’.", "seq": 407}
{"id": "Philoponus_Passim_0408", "series": "CAG", "text": "ἀλλ᾿ οὐδὲ ἀπὸ τῆς σπουδῆς ὁ σπουδαῖος, ἥτις ὁμοίως ἐπί τε κακίας καὶ ἀρετῆς λέγεται, ὁ δὲ σπουδαῖος μόνος ὁ ἐνάρετος·", "seq": 408}
{"id": "Philoponus_Passim_0409", "series": "CAG", "text": "ὥστε κατὰ μὲν τὴν φωνὴν ἐκ τοῦ σπουδή παρῆκται τὸ σπουδαῖος, κατὰ δὲ τὸ σημαινόμενον οὐκέτι, ἀλλ᾿ ἐκ τῆς ἀρετῆς.", "seq": 409}
{"id": "Philoponus_Passim_0410", "series": "CAG", "text": "** διὰ δὲ τοῦ εἰπεῖν τὴν κατὰ τοὔνομα προσηγορίαν ἔχει τὴν κοινωνίαν ἐδήλωσε τοῦ ὀνόματος.", "seq": 410}
{"id": "Philoponus_Passim_0411", "series": "CAG", "text": "ἢ οὕτως·", "seq": 411}
{"id": "Philoponus_Passim_0412", "series": "CAG", "text": "εἰρηκὼς ἀπό τινος τὴν κατὰ τὸ πρᾶγμα κοινωνίαν καὶ ἑτερότητα ἐδήλωσεν·", "seq": 412}
{"id": "Philoponus_Passim_0413", "series": "CAG", "text": "εἰ γὰρ ἀπό τινος, δῆλον ὅτι ἔχει τινὰ κοινωνίαν πρὸς ἐκεῖνο, εἰ δὲ ὅλως ἀπό τινος, δῆλον ὅτι καὶ διαφέρει·", "seq": 413}
{"id": "Philoponus_Passim_0414", "series": "CAG", "text": "εἰ γὰρ μὴ διέφερεν, οὔτε ἀπό τινος ἐλέγετο, ἀλλ᾿ αὐτὸ τὸ πρᾶγμα.", "seq": 414}
{"id": "Philoponus_Passim_0415", "series": "CAG", "text": "εἰπὼν δὲ διαφέροντα τῇ πτώσει ἐδήλωσε τὸν μετασχηματισμὸν τῆς τελευταίας συλλαβῆς.", "seq": 415}
{"id": "Philoponus_Passim_0416", "series": "CAG", "text": "διδάσκει δὲ περὶ τῶν παρωνύμων ὁ Ἀριστοτέλης ὡς χρησιμευόντων καὶ αὐτῶν εἰς τὴν περὶ τῶν κατηγοριῶν διδασκαλίαν.", "seq": 416}
{"id": "Philoponus_Passim_0417", "series": "CAG", "text": "1a16 Τῶν λεγομένων τὰ μὲν κατὰ συμπλοκὴν λέγεται, τὰ δὲ ἄνευ συμπλοκῆς·", "seq": 417}
{"id": "Philoponus_Passim_0418", "series": "CAG", "text": "τὰ μὲν οὖν κατὰ συμπλοκὴν οἷον ἄνθρωπος τρέχει, ἄνθρωπος νικᾷ, τὰ δὲ ἄνευ συμπλοκῆς οἷον ἄνθρωπος, βοῦς, τρέχει, νικᾷ.", "seq": 418}
{"id": "Philoponus_Passim_0419", "series": "CAG", "text": "Ἐντεῦθεν εἰσβάλλει εἰς τὴν τῶν κατηγοριῶν διδασκαλίαν.", "seq": 419}
{"id": "Philoponus_Passim_0420", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ τὸ τῆς κατηγορίας ὄνομα λέγεται καὶ ἐπὶ πραγμάτων καὶ νοημάτων καὶ φωνῶν (λέγεται γὰρ καὶ αὐτὸ τὸ πρᾶγμα κατηγορία καὶ τὸ νόημα τὸ περὶ τοῦ πράγματος καὶ αὐτὴ ἡ φωνή), πρότερον παραδίδωσι τὴν τῶν φωνῶν διαίρεσιν.", "seq": 420}
{"id": "Philoponus_Passim_0421", "series": "CAG", "text": "εἰ δὲ ἐνταῦθα μὲν περὶ φωνῶν διαλέγεται καὶ φωνῶν οὐκ ἀσήμων, μικρὸν δὲ ὕστερον περὶ πραγμάτων, ὅταν λέγῃ “τῶν ὄντων τὰ μὲν καθ᾿ ὑποκειμένου λέγεται”, δῆλον ὅτι καὶ περὶ τῶν μεταξὺ νοημάτων ποιεῖται τὸν λόγον·", "seq": 421}
{"id": "Philoponus_Passim_0422", "series": "CAG", "text": "ὥστε καὶ ἐξ αὐτῶν τῶν ῥητῶν πρόδηλος ὁ τοῦ βιβλίου σκοπός.", "seq": 422}
{"id": "Philoponus_Passim_0423", "series": "CAG", "text": "διαιρεῖ δὲ τὰς φωνὰς εἴς τε τὰς ἁπλᾶς καὶ τὰς συνθέτους, καὶ ἁπλᾶς μέν φησι τὰς ἁπλοῦν σημαινούσας πρᾶγμα, ἢ οὐσίαν ἢ ἐνέργειαν ἢ πάθος, συνθέτους δὲ τὰς σύνθετόν τι σημαινούσας καὶ συμπλεκούσας οὐσίαν ἐνεργείᾳ ἢ πάθει, ὡς Σωκράτης τρέχει (τοῦτο γὰρ σύνθετον) καὶ Σωκράτης ἢ βοῦς (ταῦτα γὰρ ἁπλᾶ).", "seq": 423}
{"id": "Philoponus_Passim_0424", "series": "CAG", "text": "οὐ πᾶσα δὲ ἁπλῆ φωνὴ ἁπλοῦν πρᾶγμα σημαίνει, οὐδὲ σύνθετος διπλοῦν.", "seq": 424}
{"id": "Philoponus_Passim_0425", "series": "CAG", "text": "σύνθετος μὲν οὖν φωνὴ ὡς τὸ Ἄρειος πάγος καὶ Κόρακος πέτρα, ἀλλὰ τὸ ὑπ᾿ αὐτῶν σημαινόμενον ἁπλοῦν, φωνὴ δὲ ἁπλῆ ὡς τὸ τρέχω τρέχεις καὶ πάντα τὰ τοῦ πρώτου καὶ δευτέρου προσώπου ῥήματα, καὶ τοῦ τρίτου ὅσα ἐπὶ ὡρισμένου προσώπου φέρονται, ὡς τὸ βροντᾷ καὶ ἀστράπτει καὶ ὕει (ὁ Ζεὺς γὰρ δηλονότι)·", "seq": 425}
{"id": "Philoponus_Passim_0426", "series": "CAG", "text": "ταῦτα γὰρ πάντα τῇ φωνῇ ἁπλᾶ, τῷ δὲ σημαινομένῳ σύνθετα·", "seq": 426}
{"id": "Philoponus_Passim_0427", "series": "CAG", "text": "οὐσίαν γάρ τινα σημαίνει συμπεπλεγμένην ἐνεργείᾳ.", "seq": 427}
{"id": "Philoponus_Passim_0428", "series": "CAG", "text": "φασὶ δὲ ἐπὶ τῶν τρίτων προσώπων μὴ πάνυ ἐμφαίνεσθαι τὴν οὐσίαν διὰ τὴν ἀοριστίαν τοῦ ῥήματος, διὸ μόνα τὰ ὡρισμένον πρόσωπον σημαίνοντα παρέλαβον.", "seq": 428}
{"id": "Philoponus_Passim_0429", "series": "CAG", "text": "ἀλλ᾿ εἰ καὶ μὴ ὡρισμένην οὐσίαν τὰ τρίτα πρόσωπα τῶν ῥημάτων σημαίνει, ἀλλ᾿ οὖν πάντως οὐσίαν τινὰ δηλοῖ τὴν ἐνεργοῦσαν ἢ πάσχουσαν·", "seq": 429}
{"id": "Philoponus_Passim_0430", "series": "CAG", "text": "ὥστε πάντως τὰ τρίτα πρόσωπα τῶν ὁριστικῶν ῥημάτων φωνῇ μὲν ἁπλᾶ ἐστι σημαινομένῳ δὲ σύνθετα·", "seq": 430}
{"id": "Philoponus_Passim_0431", "series": "CAG", "text": "ὁ γὰρ λέγων ‘τρέχει’ ἢ ‘νικᾷ’ δῆλον ὅτι τινὸς κατηγορεῖ τὸ νικᾶν ἢ τὸ τρέχειν.", "seq": 431}
{"id": "Philoponus_Passim_0432", "series": "CAG", "text": "πάντως οὖν καὶ ἐν τοῖς τρίτοις ἡ οὐσία συνεμφαίνεται, εἰ καὶ ἀορίστως.", "seq": 432}
{"id": "Philoponus_Passim_0433", "series": "CAG", "text": "ὅμως γοῦν ὁ Ἀριστοτέλης διὰ τὸ μὴ ὡρισμένως ἐμφαίνεσθαι τὴν οὐσίαν ὡς ἁπλᾶ τὰ τοιαῦτα παρείληφε.", "seq": 433}
{"id": "Philoponus_Passim_0434", "series": "CAG", "text": "κυρίως δὲ ἁπλᾶ ἂν εἴη ῥήματα τὰ ἐνέργειαν μόνην ἢ πάθος δηλοῦντα, ἄνευ τοῦ ἐνεργοῦντος ἢ πάσχοντος, οἷον τύπτειν τύπτεσθαι.", "seq": 434}
{"id": "Philoponus_Passim_0435", "series": "CAG", "text": "οὐ δεῖ οὖν τῇ συνθέσει ἢ τῇ ἁπλότητι τῶν φωνῶν τὰ ἁπλᾶ ἢ σύνθετα κρίνειν πράγματα, ἀλλ᾿ ἐξ αὐτῶν τῶν σημαινομένων.", "seq": 435}
{"id": "Philoponus_Passim_0436", "series": "CAG", "text": "ἀλλὰ καὶ αὐτὰς τὰς φωνὰς κἂν σύνθετοι εἶεν, ἐὰν ἁπλοῦν πρᾶγμα σημαίνωσιν, ἁπλᾶς λεκτέον, ὁμοίως καὶ τὰς ἁπλᾶς συνθέτους, ἐὰν σύνθετον σημαίνωσιν·", "seq": 436}
{"id": "Philoponus_Passim_0437", "series": "CAG", "text": "εἰ μὲν γὰρ περὶ φωνῶν μόνων διελεγόμεθα καὶ τοῦ ποσοῦ τῶν συλλαβῶν, εἰκότως κατὰ τὸ ποσὸν τὴν σύνθεσιν ὡριζόμεθα, ὡς καὶ οἱ γραμματικοί, εἰ δὲ ὡς περὶ σημαινουσῶν διαλεγόμεθα, κατὰ τὰ σημαινόμενα δεῖ κρίνειν καὶ τὰς φωνάς·", "seq": 437}
{"id": "Philoponus_Passim_0438", "series": "CAG", "text": "τὸ γὰρ ἱππεύς οὐχ ἁπλοῦν τι δηλοῖ·", "seq": 438}
{"id": "Philoponus_Passim_0439", "series": "CAG", "text": "σημαίνει γὰρ τόν τε ἵππον καὶ τὸν ἐπικαθήμενον ἄνθρωπον καὶ τὴν ἱππικὴν τέχνην.", "seq": 439}
{"id": "Philoponus_Passim_0440", "series": "CAG", "text": "οὐχ ἁπλῆν οὖν λεκτέον τὴν φωνὴν ἀλλὰ σύνθετον, ὡς καὶ τὸ Νεάπολις, ἐπειδὴ ἕν τι σημαίνει, οὐ σύνθετον ἀλλ᾿ ἁπλῆν.", "seq": 440}
{"id": "Philoponus_Passim_0441", "series": "CAG", "text": "Τὸ δὲ λέγεται ἁρμόζει καὶ ἐπὶ τῶν πραγμάτων καὶ ἐπὶ τῶν νοημάτων καὶ ἐπὶ τῶν φωνῶν·", "seq": 441}
{"id": "Philoponus_Passim_0442", "series": "CAG", "text": "λέγονται γὰρ καὶ τὰ πράγματα λέγεσθαι, ἀλλ᾿ ὡς σημαινόμενα, καὶ τὰ νοήματα ὁμοίως λέγεσθαι, ἀλλ᾿ ὡς ἐξαγγελλόμενα, λέγονται δὲ καὶ αἱ φωναὶ λέγεσθαι, ἀλλ᾿ ὡς προφερόμεναι.", "seq": 442}
{"id": "Philoponus_Passim_0443", "series": "CAG", "text": "Διὰ ποίαν δὲ αἰτίαν τὰ κατὰ συμπλοκὴν προτάττει τῶν ἄνευ συμπλοκῆς;", "seq": 443}
{"id": "Philoponus_Passim_0444", "series": "CAG", "text": "λέγομεν ὅτι ἀγαπητὸν τῇ ἀνθρωπίνῃ φύσει ἐκ τῶν ἀτελεστέρων καὶ συνθέτων ἐπὶ τὰ ἁπλούστερα καὶ τελειότερα προϊέναι·", "seq": 444}
{"id": "Philoponus_Passim_0445", "series": "CAG", "text": "τὰ γὰρ σύνθετα μᾶλλον συνήθη ἡμῖν καὶ γνωριμώτερα.", "seq": 445}
{"id": "Philoponus_Passim_0446", "series": "CAG", "text": "οὕτω γοῦν καὶ ὁ παῖς εἶραι μὲν λόγον καὶ εἰπεῖν ‘Σωκράτης περιπατεῖ’ οἶδε·", "seq": 446}
{"id": "Philoponus_Passim_0447", "series": "CAG", "text": "τοῦτον δὲ ἀναλῦσαι εἰς τὸ ῥῆμα καὶ τὸ ὄνομα καὶ ταῦτα εἰς συλλαβὰς κἀκείνας εἰς τὰ στοιχεῖα οὐκέτι.", "seq": 447}
{"id": "Philoponus_Passim_0448", "series": "CAG", "text": "οὕτως οὖν καὶ ἡμεῖς ἄνθρωπον περιπατοῦντα ἰδόντες πρότερον ἔγνωμεν τὸ ὅλον τοῦτο, ἄνθρωπον περιπατοῦντα, καὶ οὕτως ἀναλύομεν αὐτὸν εἰς οὐσίαν καὶ ἐνέργειαν.", "seq": 448}
{"id": "Philoponus_Passim_0449", "series": "CAG", "text": "καὶ πῶς οὖν ἐλέγομεν ἀνωτέρω δεῖν ἄρχεσθαι ἐκ τῶν ἁπλουστέρων, ὡς τῶν συνθέτων οὐ γνωσθησομένων μὴ προεγνωσμένων τῶν ἁπλῶν, καὶ διὰ τοῦτο δεῖν προηγεῖσθαι τὴν τῶν ἁπλῶν φωνῶν διδασκαλίαν τῆς τῶν συλλογισμῶν;", "seq": 449}
{"id": "Philoponus_Passim_0450", "series": "CAG", "text": "λέγομεν οὖν ὅτι ἐφ᾿ ὧν ὁμοίως ἀγνοοῦνται καὶ τὰ ἁπλᾶ καὶ τὰ σύνθετα, δέον ἐκ τῶν ἁπλουστέρων ἄρχεσθαι·", "seq": 450}
{"id": "Philoponus_Passim_0451", "series": "CAG", "text": "ἐκεῖ μὲν γὰρ ὁμοίως καὶ ὁ συλλογισμὸς ἠγνοεῖτο καὶ αἱ ἁπλαῖ φωναί, ἐνταῦθα δὲ γνωριμώτερα τὰ συνθετώτερα, διὸ ἐκ τῶν γνωριμωτέρων ἄρχεσθαι δεῖ τῆς διδασκαλίας·", "seq": 451}
{"id": "Philoponus_Passim_0452", "series": "CAG", "text": "ὥστε ἐκεῖ μὲν ἐλέγομεν ἐκ τῶν ἁπλουστέρων ἄρχεσθαι διὰ τὸν τρόπον τῆς διδασκαλίας, ἐνταῦθα δὲ ἐκ τῶν συνθετωτέρων διὰ τὸν τρόπον τῆς γνώσεως.", "seq": 452}
{"id": "Philoponus_Passim_0453", "series": "CAG", "text": "ἔστι δὲ καὶ ἄλλη αἰτία τοῦ προτετάχθαι ἐνταῦθα τῶν ἁπλῶν τὰ σύνθετα·", "seq": 453}
{"id": "Philoponus_Passim_0454", "series": "CAG", "text": "ἐπειδὴ γὰρ τὰ ἄνευ συμπλοκῆς μέλλει διαιρεῖν, διὰ τοῦτο ὕστερον ταῦτα εἶπεν, ἵνα εὐθέως αὐτῶν ποιήσηται τὴν διδασκαλίαν.", "seq": 454}
{"id": "Philoponus_Passim_0455", "series": "CAG", "text": "μέλλει δὲ ταῦτα διαιρεῖν, ὅταν εἴπῃ “τῶν ἄνευ συμπλοκῆς λεγομένων”.", "seq": 455}
{"id": "Philoponus_Passim_0456", "series": "CAG", "text": "ἐξεπίτηδες δὲ ἐπὶ τούτων δύο ὀνόματα τάττει καὶ δύο ῥήματα ἐφεξῆς, ἵνα μή τις ὕστερον παρακολουθήσῃ πλάνη.", "seq": 456}
{"id": "Philoponus_Passim_0457", "series": "CAG", "text": "1a20 Τῶν ὄντων τὰ μὲν καθ᾿ ὑποκειμένου τινὸς λέγεται, ἐν ὑποκειμένῳ δὲ οὐδενί ἐστιν.", "seq": 457}
{"id": "Philoponus_Passim_0458", "series": "CAG", "text": "Μέλλων τὴν εἰς δέκα διαίρεσιν τῶν πραγμάτων ἡμῖν παραδοῦναι πρότερον ἐκτίθεται τὴν εἰς τέσσαρα τούτων διαίρεσιν·", "seq": 458}
{"id": "Philoponus_Passim_0459", "series": "CAG", "text": "παραδοὺς γὰρ πρότερον τὴν εἰς δύο τῶν φωνῶν διαίρεσιν πρόεισιν ἐπὶ τὴν τετραδικὴν ταύτην τομὴν εἰκότως·", "seq": 459}
{"id": "Philoponus_Passim_0460", "series": "CAG", "text": "ὁ γὰρ δύο ἀριθμὸς ἐφ᾿ ἑαυτοῦ πολυπλασιαζόμενος ποιεῖ τὸν τέσσαρα.", "seq": 460}
{"id": "Philoponus_Passim_0461", "series": "CAG", "text": "μετὰ δὲ ταύτην τὴν διαίρεσιν παραδώσει τὴν εἰς δέκα·", "seq": 461}
{"id": "Philoponus_Passim_0462", "series": "CAG", "text": "ὁ γὰρ ἀπὸ μονάδος ἀρχόμενος ἀριθμὸς συντιθέμενος μέχρι τοῦ τέσσαρα ποιεῖ τὸν δέκα·", "seq": 462}
{"id": "Philoponus_Passim_0463", "series": "CAG", "text": "αʹ βʹ γʹ δʹ, καὶ γίνονται δέκα.", "seq": 463}
{"id": "Philoponus_Passim_0464", "series": "CAG", "text": "ἄλλως τε ἐνταῦθα μὲν συμπεπλεγμένην τὴν τῶν πραγμάτων ποιεῖται διαίρεσιν (συμπλέκει γὰρ τὸ καθόλου τῇ οὐσίᾳ καὶ τῷ συμβεβηκότι, ὁμοίως δὲ καὶ τὸ μερικὸν τοῖς αὐτοῖς), ἐκεῖ δὲ κατὰ ἄρθρα καὶ ἁπλουστάτην ποιεῖται τὴν τομὴν μηδὲν μηδενὶ συμπλέκων, ἀλλ᾿ ἕκαστον ὅπως ἔχει φύσεως διδάσκων, ἰδίᾳ μὲν περὶ τῆς οὐσίας, ἰδίᾳ δὲ καὶ οὐ κοινῶς περὶ τῶν συμβεβηκότων ἑκάστου.", "seq": 464}
{"id": "Philoponus_Passim_0465", "series": "CAG", "text": "κατὰ διαφόρους οὖν ἐπιβολὰς τῆς τῶν ὄντων γινομένης διαιρέσεως εἰκότως καὶ τὰ τῆς διαιρέσεως τμήματα διάφορα γέγονεν.", "seq": 465}
{"id": "Philoponus_Passim_0466", "series": "CAG", "text": "ἔστιν οὖν ἡ προκειμένη τῶν ὄντων διαίρεσις τοιαύτη·", "seq": 466}
{"id": "Philoponus_Passim_0467", "series": "CAG", "text": "τῶν ὄντων, φησί, τὰ μέν ἐστιν οὐσίαι τὰ δὲ συμβεβηκότα, πάλιν τῶν ὄντων τὰ μέν ἐστι καθόλου τὰ δὲ μερικά.", "seq": 467}
{"id": "Philoponus_Passim_0468", "series": "CAG", "text": "τεσσάρων οὖν τούτων ὄντων τμημάτων καὶ σύνδυο λαμβανομένων ἐκ τῆς τούτων συμπλοκῆς γίνονται συζυγίαι ἕξ, δύο μὲν ἀνυπόστατοι, αἱ τὰ ἐναντία ζευγνύουσαι, αἱ δὲ λοιπαὶ τέσσαρες συνιστάμεναι·", "seq": 468}
{"id": "Philoponus_Passim_0469", "series": "CAG", "text": "τῶν γὰρ ὄντων τὰ μέν εἰσι καθόλου οὐσίαι τὰ δὲ καθόλου συμβεβηκότα, καὶ τὰ μὲν μερικαὶ οὐσίαι τὰ δὲ μερικὰ συμβεβηκότα, ὡς τὸ ὑποκείμενον ἔχει διάγραμμα·", "seq": 469}
{"id": "Philoponus_Passim_0470", "series": "CAG", "text": "οὐσία ἀσύστατον συμβεβηκός", "seq": 470}
{"id": "Philoponus_Passim_0471", "series": "CAG", "text": "οὐκ ἐν ὑποκειμένῳ καὶ καθ᾿ ὑποκειμένου", "seq": 471}
{"id": "Philoponus_Passim_0472", "series": "CAG", "text": "ἐν ὑποκειμένῳ καὶ οὐ καθ᾿ ὑποκειμένου", "seq": 472}
{"id": "Philoponus_Passim_0473", "series": "CAG", "text": "οὔτε ἐν ὑποκειμένῳ οὔτε καθ᾿ ὑποκειμένου καὶ καθ᾿ ὑποκειμένου καὶ ἐν ὑποκειμένῳ καθόλου ἀσύστατον μερικόν", "seq": 473}
{"id": "Philoponus_Passim_0474", "series": "CAG", "text": "ἀλλ᾿ εἰ μὲν ταύταις ταῖς φωναῖς ἐχρήσατο ὁ Ἀριστοτέλης, σαφὲς ἂν ἦν τὸ λεγόμενον, ὁ δὲ τὴν ἀσάφειαν ἐπιτηδεύων διὰ τὴν εἰρημένην αἰτίαν ἑτέροις ἐχρήσατο ὀνόμασιν, οἰκειοτέροις μὲν τῇ τῶν σημαινομένων φύσει, ἀσυνήθεσι δὲ τοῖς πολλοῖς καὶ ταύτῃ ἀσαφεστέροις.", "seq": 474}
{"id": "Philoponus_Passim_0475", "series": "CAG", "text": "τὸ μὲν οὖν συμβεβηκὸς καλεῖ ἐν’ ὑποκειμένῳ, τὴν δὲ οὐσίαν οὐκ ἐν ὑποκειμένῳ, τὸ δὲ καθόλου καθ᾿ ὑποκειμένου, τὸ δὲ μερικὸν οὐ καθ᾿ ὑποκειμένου.", "seq": 475}
{"id": "Philoponus_Passim_0476", "series": "CAG", "text": "καὶ διὰ τί μὲν τὸ συμβεβηκὸς καλεῖ ἐν ὑποκειμένῳ, δῆλον (αὐτὸ γὰρ καθ᾿ αὑτὸ ὑποστῆναι οὐ δύναται, δέεται δὲ ἄλλου πρὸς ὕπαρξιν, τοῦτ᾿ ἔστιν οὐσίας), τὴν δὲ οὐσίαν οὐκ ἐν ὑποκειμένῳ (οὐ γὰρ δέεται ἑτέρου πρὸς ὕπαρξιν), τὸ δὲ καθόλου καθ᾿ ὑποκειμένου, διότι δέεται τῶν μερικῶν οὐ πρὸς ὕπαρξιν ἀλλὰ πρὸς κατηγορίαν (μὴ γὰρ ὄντων τῶν μερικῶν οὐκ ἔχει τὸ καθόλου κατά τινος κατηγορηθῆναι), τὸ δὲ μερικὸν οὐ καθ᾿ ὑποκειμένου, διότι τὰ κατὰ μέρος κατ᾿ οὐδενὸς ἄλλου κατηγορεῖται.", "seq": 476}
{"id": "Philoponus_Passim_0477", "series": "CAG", "text": "Διὰ τί τὴν οὐσίαν ἐκάλεσεν οὐκ ἐν ὑποκειμένῳ καὶ μὴ ὑποκείμενον, εἴ γε ὑπόκειται τοῖς συμβεβηκόσι πρὸς ὕπαρξιν;", "seq": 477}
{"id": "Philoponus_Passim_0478", "series": "CAG", "text": "ἐροῦμεν οὖν πρὸς τοῦτο ὅτι πρῶτον μὲν οὐ πᾶσα οὐσία ἐστὶν ὑποκείμενον·", "seq": 478}
{"id": "Philoponus_Passim_0479", "series": "CAG", "text": "οὐ γὰρ δήπου ἡ θεία οὐσία ἐστὶν ὑποκείμενον·", "seq": 479}
{"id": "Philoponus_Passim_0480", "series": "CAG", "text": "οὐδὲν γὰρ αὐτῇ συμβέβηκεν·", "seq": 480}
{"id": "Philoponus_Passim_0481", "series": "CAG", "text": "οὐκοῦν οὐκ ἂν κληθείη ὑποκείμενον.", "seq": 481}
{"id": "Philoponus_Passim_0482", "series": "CAG", "text": "εἰ οὖν κοινῶς ὠνόμασε τὴν οὐσίαν ὑποκείμενον, οὐ συμπεριέλαβε τὴν θείαν οὐσίαν.", "seq": 482}
{"id": "Philoponus_Passim_0483", "series": "CAG", "text": "δεύτερον δὲ ὃ καὶ μάλιστα κυριωτάτη ἐστὶν αἰτία, διότι τῶν διαιρέσεων εἰς τὰ ἀντικείμενα γινομένων αἱ μέν εἰσι φυκταὶ αἱ δὲ ἄφυκτοι, καὶ φυκταὶ μὲν αἱ εἰς τὰ ἐναντία γινόμεναι ἄφυκτοι δὲ αἱ κατὰ ἀντίφασιν·", "seq": 483}
{"id": "Philoponus_Passim_0484", "series": "CAG", "text": "ἐπειδὴ γὰρ τῶν ἐναντίων τὰ μέν ἐστιν ἔμμεσα τὰ δὲ ἄμεσα, ἀνάγκη τὴν εἰς τὰ ἐναντία γινομένην διαίρεσιν ἐπὶ τῶν ἐμμέσων μὴ ἄφυκτον εἶναι.", "seq": 484}
{"id": "Philoponus_Passim_0485", "series": "CAG", "text": "ἔμμεσα δέ ἐστιν ἐναντία οἷον λευκὸν καὶ μέλαν, ὑγεία καὶ νόσος·", "seq": 485}
{"id": "Philoponus_Passim_0486", "series": "CAG", "text": "ἔστι γὰρ μεταξὺ λευκοῦ καὶ μέλανος τὸ φαιὸν τὸ ἐρυθρὸν καὶ πάντα τὰ ἄλλα χρώματα, μεταξὺ δὲ ὑγείας καὶ νόσου τὸ παρὰ τοῖς ἰατροῖς λεγόμενον οὐδέτερον·", "seq": 486}
{"id": "Philoponus_Passim_0487", "series": "CAG", "text": "τὰς γὰρ ἐκ νόσου ἀναλήψεις οὔτε ὑγείας εἶναί φασιν (οὐ γὰρ τὰ τῶν ὑγιαινόντων ἐνεργοῦσιν) οὔτε νόσους (τῆς γὰρ νοσοποιοῦ αἰτίας ἀπηλλαγμένοι εἰσὶν οἱ ἀναλαμβάνοντες)·", "seq": 487}
{"id": "Philoponus_Passim_0488", "series": "CAG", "text": "οὐκοῦν μέσον τί ἐστι νόσου καὶ ὑγείας ἡ ἀνάληψις.", "seq": 488}
{"id": "Philoponus_Passim_0489", "series": "CAG", "text": "ἄμεσα δὲ τὸ περιττὸν καὶ τὸ ἄρτιον, εἴπερ ὅλως ὡς ἐναντία ταῦτα ἀντίκειται (ἐδείξαμεν γὰρ ἡμεῖς ἐν ἄλλοις ὅτι οὐκ ἔστιν ἐναντία), πάλιν τὸ λογικὸν καὶ τὸ ἄλογον ἀμέσως ἀντίκεινται, οὐδ᾿ αὐτὰ ἐναντία ὄντα.", "seq": 489}
{"id": "Philoponus_Passim_0490", "series": "CAG", "text": "ὥστε τὰ κυρίως ἐναντία πάντα ἐστὶν ἔμμεσα.", "seq": 490}
{"id": "Philoponus_Passim_0491", "series": "CAG", "text": "εἴ τις οὖν εἰς τὰ ἐναντία διέλοι τὰ ὄντα λέγων τῶν ὄντων τὰ μὲν εἶναι λευκὰ τὰ δὲ μέλανα, ἀνάγκη διαφεύγειν αὐτὸν πάντα τὰ ἐν μέσῳ χρώματα, οὐ μόνον δὲ ἀλλὰ καὶ τὰς οὐσίας τὰς ἀνεπιδέκτους χρωμάτων, οἷον ἀέρα ψυχὴν ἄγγελον.", "seq": 491}
{"id": "Philoponus_Passim_0492", "series": "CAG", "text": "ἀλλ᾿ οὐδὲ αἱ εἰς τὰ λοιπὰ τῶν ἀντικειμένων εἴδη διαιρέσεις τὸ ἄφυκτον ἔχουσι, πλὴν τῶν κατὰ ἀντίφασιν μόνων γινομένων, οἷον εἴ τις λέγοι τῶν ὄντων τὰ μὲν εἶναι δεξιὰ τὰ δὲ ἀριστερά, ἢ τὰ μὲν δεσπότας τὰ δὲ δούλους, τὰ μὲν πατέρας τὰ δὲ υἱούς·", "seq": 492}
{"id": "Philoponus_Passim_0493", "series": "CAG", "text": "ἔστι γὰρ ἃ καὶ τούτων οὐδέν ἐστιν.", "seq": 493}
{"id": "Philoponus_Passim_0494", "series": "CAG", "text": "ἀλλὰ μὴν οὐδὲ εἰ κατὰ στέρησιν καὶ ἕξιν ἡ διαίρεσις γίνοιτο, οἷον εἴ τις λέγοι τῶν ὄντων τὰ μὲν τυφλὰ εἶναι τὰ δὲ βλέποντα, ἢ τὰ μὲν σοφὰ τὰ δὲ ἄσοφα·", "seq": 494}
{"id": "Philoponus_Passim_0495", "series": "CAG", "text": "ἕξις γὰρ καὶ στέρησις ἐπὶ τῶν δεκτικῶν μόνων λέγεται, τὸ δὲ τὴν ἕξιν μὴ πεφυκὸς δέχεσθαι οὐδὲ ἐστερῆσθαι λέγεται ταύτης.", "seq": 495}
{"id": "Philoponus_Passim_0496", "series": "CAG", "text": "ὥστε οὐ πάντα τὰ ὄντα διαιρεῖ ἡ ἕξις καὶ ἡ στέρησις, χωρὶς εἰ μὴ ἰσοδυναμοίη ἐπί τινων τῇ ἀντιφάσει, ὡς ἔχει τὸ σῶμα καὶ ἀσώματον·", "seq": 496}
{"id": "Philoponus_Passim_0497", "series": "CAG", "text": "οὐδὲν γάρ ἐστι τούτων μεταξύ·", "seq": 497}
{"id": "Philoponus_Passim_0498", "series": "CAG", "text": "ταὐτὸν γὰρ δύναται τῇ ἀποφάσει τῇ οὐ σῶμα τὸ ἀσώματον.", "seq": 498}
{"id": "Philoponus_Passim_0499", "series": "CAG", "text": "μόνως οὖν ἡ κατὰ ἀντίφασιν διαίρεσις (οἷον εἴ τις λέγοι τῶν ὄντων τὰ μὲν εἶναι λευκὰ τὰ δὲ οὐ λευκά) πάντα τὰ ὄντα περιλαμβάνει·", "seq": 499}
{"id": "Philoponus_Passim_0500", "series": "CAG", "text": "καὶ γὰρ τὸ φαιὸν οὐ λευκόν, καὶ τὸ ξανθὸν καὶ τὸ ἐρυθρὸν ὁμοίως, ἀλλὰ καὶ ψυχὴ οὐ λευκὴ καὶ ἄγγελος οὐ λευκός·", "seq": 500}
{"id": "Philoponus_Passim_0501", "series": "CAG", "text": "οὐδὲ γὰρ ὅλως χρῶμα πέφυκεν ὑποδέχεσθαι.", "seq": 501}
{"id": "Philoponus_Passim_0502", "series": "CAG", "text": "καὶ ὁ Πλάτων δὲ τὴν διαιρετικὴν ἐξυμνεῖ μέθοδον τὴν κατὰ ἀντίφασιν γινομένην·", "seq": 502}
{"id": "Philoponus_Passim_0503", "series": "CAG", "text": "οὐδὲν γάρ, φησί, τῶν ὄντων καυχήσεται αὐτὴν ἐκφυγεῖν.", "seq": 503}
{"id": "Philoponus_Passim_0504", "series": "CAG", "text": "διὰ τοῦτο τοίνυν καὶ ὁ Ἀριστοτέλης εἰρηκὼς τὸ συμβεβηκὸς ἐν ὑποκειμένῳ διὰ τῆς τούτου ἀποφάσεως ἐσήμανε τὴν οὐσίαν, εἰρηκὼς αὐτὴν οὐκ ἐν ὑποκειμένῳ, ἵνα πᾶσαν οὐσίαν περιλάβῃ.", "seq": 504}
{"id": "Philoponus_Passim_0505", "series": "CAG", "text": "Πρὸς τούτοις ἐροῦμεν ὅτι τὸ ὑποκείμενον διττόν, τὸ μὲν πρὸς ὕπαρξιν ὑποκείμενον τὸ δὲ πρὸς κατηγορίαν·", "seq": 505}
{"id": "Philoponus_Passim_0506", "series": "CAG", "text": "πρὸς ὕπαρξιν μὲν ἡ οὐσία (αὕτη γὰρ ὑπόκειται πρὸς ὕπαρξιν τοῖς συμβεβηκόσι), πρὸς κατηγορίαν δὲ τὰ μερικά·", "seq": 506}
{"id": "Philoponus_Passim_0507", "series": "CAG", "text": "ταῦτα γὰρ ὑπόκειται πρὸς κατηγορίαν τοῖς καθόλου, οὐ πρὸς ὕπαρξιν·", "seq": 507}
{"id": "Philoponus_Passim_0508", "series": "CAG", "text": "οὐ γὰρ δέονται τὰ καθόλου τῶν μερικῶν, ἵνα ὑποστῶσιν, ἀλλ᾿ ἵνα ἔχωσι καθ᾿ ὧν κατηγορηθήσονται.", "seq": 508}
{"id": "Philoponus_Passim_0509", "series": "CAG", "text": "τοὐναντίον δὲ τὰ μερικὰ δέονται τῶν καθόλου, οὐ πρὸς κατηγορίαν, ἀλλὰ πρὸς ὕπαρξιν·", "seq": 509}
{"id": "Philoponus_Passim_0510", "series": "CAG", "text": "οὐκ ἂν γὰρ εἴη Σωκράτης καὶ Πλάτων μὴ ὄντος τοῦ ἁπλῶς ἀνθρώπου.", "seq": 510}
{"id": "Philoponus_Passim_0511", "series": "CAG", "text": "τῶν δὲ πρὸς κατηγορίαν ὑποκειμένων τὸ μέν ἐστιν οὐσία τὸ δὲ συμβεβηκός·", "seq": 511}
{"id": "Philoponus_Passim_0512", "series": "CAG", "text": "ὑπόκειται γὰρ καὶ ἡ μερικὴ οὐσία τῇ καθόλου πρὸς κατηγορίαν, ὡς εἴρηται, ὡς Σωκράτης τῷ ἁπλῶς ἀνθρώπῳ καὶ τῷ ἁπλῶς ζῴῳ, καὶ τὸ μερικὸν συμβεβηκὸς τῷ καθόλου, ὡς τὸ ἐν τῷδε τῷ λίθῳ λευκὸν τῷ ἁπλῶς λευκῷ καὶ τῷ χρώματι·", "seq": 512}
{"id": "Philoponus_Passim_0513", "series": "CAG", "text": "λέγομεν γὰρ καὶ τόνδε τὸν λίθον λευκὸν εἶναι καὶ τὸ ἁπλῶς λευκὸν χρῶμα εἶναι.", "seq": 513}
{"id": "Philoponus_Passim_0514", "series": "CAG", "text": "ἐπειδὴ οὖν ὡσαύτως ἑκάτερον λέγεται ὑποκείμενον, εἰ εἶπε ‘τῶν ὄντων τὰ μὲν ἐν ὑποκειμένῳ τὰ δὲ ὑποκείμενα’, περιέλαβεν ἂν καὶ τὰ μερικὰ συμβεβηκότα, ἅτινα καὶ αὐτὰ ὑποκείμενά ἐστιν, εἰ καὶ μὴ πρὸς ὕπαρξιν, ἀλλὰ πρὸς κατηγορίαν·", "seq": 514}
{"id": "Philoponus_Passim_0515", "series": "CAG", "text": "βούλεται δὲ διὰ τοῦ εἰπεῖν οὐκ ἐν ὑποκειμένῳ τὴν πρὸς ὕπαρξιν ὑποκειμένην οὐσίαν εἰπεῖν καὶ ἀντιδιαστεῖλαι αὐτὴν τοῖς συμβεβηκόσι.", "seq": 515}
{"id": "Philoponus_Passim_0516", "series": "CAG", "text": "τῶν δὲ δύο διαιρέσεων τούτων ἡ μέν ἐστιν ἀπὸ τοῦ τρόπου τῆς ὑπάρξεως ἡ δὲ ἀπὸ τοῦ τρόπου τῆς κατηγορίας, καὶ ἀπὸ τοῦ τρόπου τῆς ὑπάρξεως ἡ λέγουσα τῶν ὄντων τὰ μὲν εἶναι ἐν ὑποκειμένῳ τὰ δὲ οὐκ ἐν ὑποκειμένῳ, ἀπὸ τοῦ τρόπου δὲ τῆς κατηγορίας ἡ λέγουσα τῶν ὄντων τὰ μὲν καθ᾿ ὑποκειμένου τὰ δὲ οὐ καθ᾿ ὑποκειμένου λέγεται·", "seq": 516}
{"id": "Philoponus_Passim_0517", "series": "CAG", "text": "τὰ μὲν γὰρ εἶναί φησι κατηγορούμενα τὰ δὲ ὑποκείμενα πρὸς κατηγορίαν.", "seq": 517}
{"id": "Philoponus_Passim_0518", "series": "CAG", "text": "καὶ σκόπει τὴν ἀκρίβειαν τοῦ Ἀριστοτέλους, πῶς ἐπὶ μὲν τῆς σημαινούσης τὸν τρόπον τῆς ὑπάρξεως εἶπε τὸ ἐστίν, ἐπὶ δὲ τῆς σημαινούσης τὸν τρόπον τῆς κατηγορίας εἶπε τὸ λέγεται·", "seq": 518}
{"id": "Philoponus_Passim_0519", "series": "CAG", "text": "*** ἀντὶ τοῦ κατηγορεῖται, \\ἐν ὑποκειμένῳ δὲ οὐδενί ἐστιν ἀντὶ τοῦ ‘οὐκ ἐν ἑτέρῳ ὑπάρχει’.", "seq": 519}
{"id": "Philoponus_Passim_0520", "series": "CAG", "text": "τῶν δὲ τεσσάρων συζυγιῶν προτάττει τὴν καθόλου οὐσίαν ὡς τιμιωτέραν καὶ ὅτι κατὰ τὰ καθόλου ἐπιστήμονες γινόμεθα·", "seq": 520}
{"id": "Philoponus_Passim_0521", "series": "CAG", "text": "ἐν γὰρ τοῖς κατὰ μέρος οὐδὲν διαφέρομεν τῶν ἀλόγων ζῴων, ἔνια δὲ αὐτῶν καὶ ὀξυτέρας ἡμῶν ἔχουσι τὰς αἰσθήσεις, αἷς τῶν κατὰ μέρος ἀντιλαμβανόμεθα.", "seq": 521}
{"id": "Philoponus_Passim_0522", "series": "CAG", "text": "ἔπειτα δευτέραν τίθησι τὴν ἀντικειμένην ταύτῃ, ἔστι δὲ τὸ μερικὸν συμβεβηκός·", "seq": 522}
{"id": "Philoponus_Passim_0523", "series": "CAG", "text": "ἀντίκειται γὰρ τῇ μὲν οὐσίᾳ τὸ συμβεβηκὸς τῷ δὲ καθόλου τὸ μερικόν.", "seq": 523}
{"id": "Philoponus_Passim_0524", "series": "CAG", "text": "εἶτα προετίμησε τὸ καθόλου συμβεβηκὸς τῆς μερικῆς οὐσίας, διότι περὶ τῶν καθόλου τοῖς φιλοσόφοις ὁ λόγος.", "seq": 524}
{"id": "Philoponus_Passim_0525", "series": "CAG", "text": "1a24 Ἐν ὑποκειμένῳ δὲ λέγω, ὃ ἔν τινι μὴ ὡς μέρος ὑπάρχον ἀδύνατον χωρὶς εἶναι τοῦ ἐν ᾧ ἐστιν.", "seq": 525}
{"id": "Philoponus_Passim_0526", "series": "CAG", "text": "Ἐπειδὴ ᾔσθετο ἑαυτοῦ ὁ φιλόσοφος φωναῖς τισι χρησαμένου ἀγνώστοις ἡμῖν ἐκ τῆς συνηθείας, τῷ τε καθ᾿ ὑποκειμένου καὶ οὐ καθ᾿ ὑποκειμένου καὶ ἐν ὑποκειμένῳ καὶ οὐκ ἐν ὑποκειμένῳ, βούλεται λοιπὸν διδάξαι ἡμᾶς περὶ αὐτῶν.", "seq": 526}
{"id": "Philoponus_Passim_0527", "series": "CAG", "text": "ἐξηγεῖται δὲ οὐ πάσας, ἀλλὰ τὰς δύο μόνας, τήν τε ἐν ὑποκειμένῳ καὶ τὴν καθ᾿ ὑποκειμένου·", "seq": 527}
{"id": "Philoponus_Passim_0528", "series": "CAG", "text": "τούτων γὰρ γνωσθεισῶν δήλη ἔσται καὶ ἡ τῶν λοιπῶν σημασία·", "seq": 528}
{"id": "Philoponus_Passim_0529", "series": "CAG", "text": "ὁ γὰρ εἰδὼς τί ἐστι τὸ ἐν ὑποκειμένῳ εἴσεται καὶ τί ἐστι τὸ οὐκ ἐν ὑποκειμένῳ, καὶ ὁ ἐγνωκὼς τὸ καθ᾿ ὑποκειμένου οἶδε καὶ τὸ οὐ καθ᾿ ὑποκειμένου.", "seq": 529}
{"id": "Philoponus_Passim_0530", "series": "CAG", "text": "καὶ πρότερον διδάσκει περὶ τοῦ ἐν ὑποκειμένῳ, καὶ διδάσκει δι᾿ ὁρισμοῦ·", "seq": 530}
{"id": "Philoponus_Passim_0531", "series": "CAG", "text": "οἱ γὰρ ὁρισμοί, ὡς πολλάκις εἴπομεν, παριστῶσιν ἡμῖν τὴν τῶν πραγμάτων φύσιν.", "seq": 531}
{"id": "Philoponus_Passim_0532", "series": "CAG", "text": "τοῦ δὲ ὁρισμοῦ ἐκ γένους ὄντος καὶ τῶν συστατικῶν διαφορῶν παραλαμβάνει ἐνταῦθα ὁ Ἀριστοτέλης τὸ μὲν ἔν τινι ἀναλογοῦν γένει, τὰ δὲ λοιπὰ ὡς διαφοράς·", "seq": 532}
{"id": "Philoponus_Passim_0533", "series": "CAG", "text": "λέγεται γὰρ τὸ ἔν τινι ἑνδεκαχῶς·", "seq": 533}
{"id": "Philoponus_Passim_0534", "series": "CAG", "text": "ἢ ὡς μέρος ἐν ὅλῳ, ὡς λέγεται ἡ χεὶρ ἐν ὅλῳ τῷ σώματι εἶναι, ἢ ὡς ὅλον ἐν τοῖς μέρεσιν, ὥσπερ λέγεται ἡ ὁλότης τοῦ σώματος ἐν κεφαλῇ εἶναι καὶ χερσὶ καὶ τοῖς ἄλλοις (οὐ λέγεται δὲ ἐν μέρει τὸ ὅλον, ἀλλ᾿ ἐν μέρεσι, διότι ἡ ὁλότης οὐκ ἐν ἑνὶ μέρει ἀλλ᾿ ἐν πᾶσι θεωρεῖται·", "seq": 534}
{"id": "Philoponus_Passim_0535", "series": "CAG", "text": "ἑνὸς γοῦν τῶν μερῶν ἀφαιρεθέντος κολοβὸν τὸ ὅλον γίνεται καὶ οὐκ ἂν κληθείη ὅλον), ἢ ὡς εἶδος ἐν γένει, ὡς λέγομεν τὸν ἄνθρωπον ἐν τῷ ζῴῳ εἶναι, ἢ ὡς γένος ἐν εἴδει, ὡς ἐν τῷ ἀνθρώπῳ τὸ ζῷον (οὐκ ἀναγκαῖον δὲ ἐνταῦθα λέγειν τὸ γένος ἐν τοῖς εἴδεσιν, ὡς ἐλέγομεν τὸ ὅλον ἐν τοῖς μέρεσιν·", "seq": 535}
{"id": "Philoponus_Passim_0536", "series": "CAG", "text": "ἡ μὲν γὰρ ὁλότης οὐκ ἐξῄρηται τῶν μερῶν ἀλλ᾿ ἐν αὐτοῖς ἔχει τὸ εἶναι, τὸ μέντοι γένος ἐξῃρημένην ἔχει τὴν οὐσίαν καὶ ὅλον ἐν ἑκάστῳ γίνεται εἴδει), ἢ ὡς ἐν χρόνῳ, ὡς λέγομεν ἐν τῷδε τῷ χρόνῳ γεγονέναι τὰ Ἰλιακά, ἢ ὡς ἐν τόπῳ, ὡς λέγομεν ἐν Λυκείῳ ἢ ἐν ἀγορᾷ, ἢ ὡς ἐν ἀγγείῳ, ὡς ὁ οἶνος ἐν κεράμῳ ἢ οἱ πυροὶ ἐν μεδίμνῳ (ἰσοστροφοῦσι δέ πως ὅ τε τόπος καὶ τὸ ἀγγεῖον·", "seq": 536}
{"id": "Philoponus_Passim_0537", "series": "CAG", "text": "τόν τε γὰρ τόπον ἐρεῖς ἀμεταφόρητον ἀγγεῖον καὶ τὸ ἀγγεῖον τόπον περιφορητόν), ἢ ὡς εἶδος ἐν ὕλῃ, ὡς τὸ τοῦ ἀνδριάντος εἶδος ἐν τῷ χαλκῷ, ἢ ὡς τὰ τῶν ἀρχομένων ἐν τῷ ἄρχοντι, ὡς λέγομεν τὰ πράγματα τῶν πολιτῶν ἐν τῷ ἄρχοντι κεῖσθαι, ἢ ὡς ἐν τέλει, ὡς λέγομεν τὸν ἰατρὸν ἐν τῇ ἰατρικῇ ἔχειν τὰς ἐλπίδας ἢ τὸν στρατιώτην ἐν τῇ στρατείᾳ, ἢ ὡς ἐν ὑποκειμένῳ, ὡς τὸ συμβεβηκὸς ἐν οὐσίᾳ.", "seq": 537}
{"id": "Philoponus_Passim_0538", "series": "CAG", "text": "τοῦτο οὖν τὸ ἔν τινι παραλαμβάνει ὁ Ἀριστοτέλης ὡς γένος κατὰ πλειόνων λεγόμενον.", "seq": 538}
{"id": "Philoponus_Passim_0539", "series": "CAG", "text": "προστίθησι δὲ ὡς διαφορὰς τὰ ἑξῆς, ἵνα διακρίνῃ αὐτὸ τῶν ἄλλων, καθ᾿ ὧν τὸ ἔν τινι κατηγορεῖται.", "seq": 539}
{"id": "Philoponus_Passim_0540", "series": "CAG", "text": "καὶ διὰ μὲν τοῦ εἰπεῖν μὴ ὡς μέρος ὑπάρχον διακρίνει αὐτὸ τοῦ τε ὡς μέρους ἐν ὅλῳ ὑπάρχοντος καὶ τοῦ ὡς εἴδους ἐν γένει (καὶ γὰρ τοῦτο δοκεῖ πως ὡς μέρος εἶναι τοῦ ὅλου ζῴου καὶ τὸ ζῷον ὅλον τι εἶναι·", "seq": 540}
{"id": "Philoponus_Passim_0541", "series": "CAG", "text": "καὶ τοῦτο καὶ ὁ Πορφύριος ἐν ταῖς Εἰσαγωγαῖς φησιν, ὅτι τριῶν ὄντων τούτων, <τῶν> γενικωτάτων γενῶν καὶ τῶν εἰδικωτάτων εἰδῶν καὶ τῶν ὑπαλλήλων, τὸ μὲν γενικώτατον μόνως ἐστὶν ὅλον, τὸ δὲ εἰδικώτατον μόνως μέρος, τὸ δὲ ὑπάλληλον καὶ ὅλον καὶ μέρος, ἀλλὰ μέρος μὲν ἄλλου, ὅλον δὲ οὐκ ἄλλου ἀλλ᾿ ἐν ἄλλοις), διὰ δὲ τοῦ εἰπεῖν ἀδύνατον χωρὶς εἶναι τοῦ ἐν ᾧ ἐστι τῶν λοιπῶν ἐχώρισε.", "seq": 541}
{"id": "Philoponus_Passim_0542", "series": "CAG", "text": "Κακίζουσι δέ τινες τὸν ὁρισμὸν τοῦτον, οἱ μὲν ἐκ τοῦ πλεονάζειν οἱ δὲ ἐκ τοῦ ἐλλείπειν·", "seq": 542}
{"id": "Philoponus_Passim_0543", "series": "CAG", "text": "αὕτη γὰρ κακία ὁρισμοῦ τὸ μὴ ἀντιστρέφειν πρὸς τὸ ὁριστὸν ἀλλ᾿ ἢ πλείονα περιλαμβάνειν ἢ ἐλάττονα.", "seq": 543}
{"id": "Philoponus_Passim_0544", "series": "CAG", "text": "καὶ οἱ μὲν πλεονάζειν λέγοντές φασι μὴ μόνα τὰ συμβεβηκότα περιλαμβάνειν τὸν ὁρισμὸν ἀλλὰ καὶ τὰ σώματα·", "seq": 544}
{"id": "Philoponus_Passim_0545", "series": "CAG", "text": "φασὶ γὰρ ὅτι ὁ Σωκράτης ἐν τόπῳ ὢν καὶ ἐν χρόνῳ ἔν τινί ἐστι, καὶ οὐχ ὡς μέρος ἐν ὅλῳ (οὐ γὰρ μέρος ἐστὶ τοῦ τόπου ἢ τοῦ χρόνου), καὶ ἀδύνατον χωρισθῆναι αὐτὸν τοῦ τόπου ἢ τοῦ χρόνου.", "seq": 545}
{"id": "Philoponus_Passim_0546", "series": "CAG", "text": "φαμὲν οὖν ὅτι οὐκ ἔστιν ὁμοία ἡ παραβολή·", "seq": 546}
{"id": "Philoponus_Passim_0547", "series": "CAG", "text": "τὸ μὲν γὰρ συμβεβηκὸς χωρισθῆναι τοῦ ἐν ᾧ ἐστιν ἀδύνατον, ἀλλ᾿ ἅμα τῷ χωρισθῆναι καὶ ἔφθαρται, τὰ μέντοι σώματα εἰ καὶ παντὸς τόπου χωρισθείη, οὐδὲν ἧττον ἔστι·", "seq": 547}
{"id": "Philoponus_Passim_0548", "series": "CAG", "text": "τὸ γὰρ σῶμα ᾗ σῶμά ἐστιν οὐ δέεται τόπου ἢ χρόνου πρὸς τὴν οἰκείαν ὑπόστασιν, ἔχει μέντοι ταῦτα παρακολουθήματα, ὥσπερ ὁ ἐν φωτὶ βαδίζων ἔχει τὴν σκιὰν παρακολούθημα μηδὲν εἰς τὴν οὐσίαν αὐτῷ συντελοῦσαν.", "seq": 548}
{"id": "Philoponus_Passim_0549", "series": "CAG", "text": "τῷ μέντοι γε συμβεβηκότι εἰς αὐτὴν τὴν ὑπόστασιν συντελεῖ τὰ σώματα·", "seq": 549}
{"id": "Philoponus_Passim_0550", "series": "CAG", "text": "ἄνευ γὰρ αὐτῶν οὐκ ἂν συσταίη.", "seq": 550}
{"id": "Philoponus_Passim_0551", "series": "CAG", "text": "ἄλλως τε οὐδὲ ἀνάγκη πᾶν σῶμα ἐν τόπῳ εἶναι·", "seq": 551}
{"id": "Philoponus_Passim_0552", "series": "CAG", "text": "τὴν γὰρ ἀπλανῆ σφαῖραν ἀποδείκνυσιν ὁ Ἀριστοτέλης μὴ οὖσαν ἐν τόπῳ·", "seq": 552}
{"id": "Philoponus_Passim_0553", "series": "CAG", "text": "εἰ γὰρ τόπος ἐστὶ τὸ πέρας τοῦ περιέχοντος, καθ᾿ ὃ περιέχει τὸ περιεχόμενον, οἷον ὁ κέραμος τόπος ἐστὶ τοῦ οἴνου τοῦ ἐν αὐτῷ, οὐ καθ᾿ ὅλον ἑαυτὸν ἀλλὰ κατὰ τὴν ἐντὸς ἐπιφάνειαν, ὅπερ αὐτοῦ ἐστι πέρας (ἀμέλει εἰ ἔξωθεν ἐγκολαφθείη, οὐδὲν ἧττον συνέχει τὸν οἶνον, ἅτε δὴ κατὰ μόνην τὴν ἐντὸς ἐπιφάνειαν ὢν τόπος)·", "seq": 553}
{"id": "Philoponus_Passim_0554", "series": "CAG", "text": "εἰ οὖν τοῦτό ἐστιν, ὡς εἴρηται, τόπος, δείκνυσι δὲ ὁ Ἀριστοτέλης ὅτι ἔξωθεν τῆς ἀπλανοῦς σφαίρας οὐδέν ἐστιν, ἵνα καὶ τῷ τούτου πέρατι περιέχοιτο, οὐ τόπος οὐ χρόνος οὐ σῶμα οὐ κενὸν οὔτε ἄλλο οὐδέν, οὐκ ἄρα ἐν τόπῳ ἐστὶν ἡ ἀπλανής.", "seq": 554}
{"id": "Philoponus_Passim_0555", "series": "CAG", "text": "ὥστε οὐκ ἀνάγκη πᾶν σῶμα ἐν τόπῳ εἶναι, ἀλλ᾿, ὡς εἴρηται, παρακολούθημα μᾶλλόν ἐστιν ὁ τόπος καὶ ὁ χρόνος τῶν σωμάτων.", "seq": 555}
{"id": "Philoponus_Passim_0556", "series": "CAG", "text": "Ἀποροῦσι δὲ καὶ τοῦτο, πῶς οὐχὶ ὁ ὁρισμὸς περιλαμβάνει καὶ τὸ ὡς ὅλον ἐν τοῖς μέρεσι·", "seq": 556}
{"id": "Philoponus_Passim_0557", "series": "CAG", "text": "καὶ γὰρ ἔν τινί ἐστιν (ἐν τοῖς μέρεσι γάρ), καὶ οὐχ ὡς μέρος ὑπάρχει καὶ ἀδύνατον αὐτὸ χωρὶς εἶναι τοῦ ἐν ᾧ ἐστι.", "seq": 557}
{"id": "Philoponus_Passim_0558", "series": "CAG", "text": "λέγομεν οὖν ὅτι εἰ καὶ κατ᾿ ἄλλο κοινωνεῖ, ἀλλ᾿ οὐκέτι κατὰ τὸ ἔν τινι·", "seq": 558}
{"id": "Philoponus_Passim_0559", "series": "CAG", "text": "οὐ γὰρ λέγεται τὸ ὅλον ἔν τινι εἶναι (οὐ γὰρ ἐν μέρει τὸ ὅλον), ἀλλὰ μᾶλλον ἔν τισιν·", "seq": 559}
{"id": "Philoponus_Passim_0560", "series": "CAG", "text": "ἐν γὰρ τοῖς μέρεσιν.", "seq": 560}
{"id": "Philoponus_Passim_0561", "series": "CAG", "text": "οὕτω καὶ ὁ Πορφύριος ἔλεγε “τὸ δὲ ὅλον οὐκ ἄλλου, ἀλλ᾿ ἐν ἄλλοις”·", "seq": 561}
{"id": "Philoponus_Passim_0562", "series": "CAG", "text": "ἐν γὰρ τοῖς μέρεσι τὸ ὅλον.", "seq": 562}
{"id": "Philoponus_Passim_0563", "series": "CAG", "text": "εἰ δὲ καὶ ἐν τοῖς σημαινομένοις τοῦ ἔν τινι παρελαμβάνομεν καὶ τὸ ὡς ὅλον ἐν μέρεσιν, ἀλλ᾿ οὐ καθὸ ἐν ἑνί ἐστιν, ἀλλὰ κατὰ μόνην τὴν σημασίαν τοῦ μὴ καθ᾿ ἑαυτὸ ὑφεστηκέναι ἐλέγομεν καὶ αὐτὸ τῶν ἔν τινι εἶναι.", "seq": 563}
{"id": "Philoponus_Passim_0564", "series": "CAG", "text": "ἔτι πρὸς τοῖς εἰρημένοις κἀκεῖνο ἀποροῦσιν, ὅτι περιλαμβάνει ὁ ὁρισμὸς καὶ τὸ ὡς εἶδος ἐν ὕλῃ·", "seq": 564}
{"id": "Philoponus_Passim_0565", "series": "CAG", "text": "καὶ γὰρ τὸ εἶδος, φασίν, ἔν τινί ἐστι τῇ ὕλῃ καὶ οὐ μέρος αὐτῆς ὑπάρχει καὶ ἀδύνατον χωρὶς εἶναι αὐτὸ τῆς ὕλης.", "seq": 565}
{"id": "Philoponus_Passim_0566", "series": "CAG", "text": "φαμὲν οὖν ὅτι τὸ εἶδος εἰ καὶ μὴ τῆς ὕλης μέρος ἐστίν, ἀλλὰ τοῦ συναμφοτέρου.", "seq": 566}
{"id": "Philoponus_Passim_0567", "series": "CAG", "text": "οὕτως ἄρα καὶ τὴν χεῖρά φαμεν οὐ τοῦ λοιποῦ σώματος μέρος εἶναι, ἀλλὰ τοῦ παντός.", "seq": 567}
{"id": "Philoponus_Passim_0568", "series": "CAG", "text": "ἔπειτα δὲ ὅτι τὸ μὲν εἶδος συμπληρωτικόν ἐστι τῆς οὐσίας ἑκάστου, καὶ τούτου φθαρέντος φθείρεται τὸ ὑποκείμενον·", "seq": 568}
{"id": "Philoponus_Passim_0569", "series": "CAG", "text": "τὸ δὲ συμβεβηκὸς οὔτε συμπληροῖ τὴν οὐσίαν τοῦ ὑποκειμένου, καὶ φθαρέντος οὐδὲν ἐβλάβη τὸ ὑποκείμενον.", "seq": 569}
{"id": "Philoponus_Passim_0570", "series": "CAG", "text": "ἄλλως τε λέγομεν ὅτι ὁ σκοπὸς ἐνταῦθα τῷ Ἀριστοτέλει διαλαβεῖν περὶ τῶν ὄντων, οὐχ ᾗ ὄντα ἐστίν, ἀλλ᾿ ᾗ σημαίνονται ὑπὸ τῶν πολλῶν ἀνθρώπων, καὶ οὐ κατὰ τὰ δοκοῦντα αὐτῷ διαλεχθῆναι περὶ αὐτῶν.", "seq": 570}
{"id": "Philoponus_Passim_0571", "series": "CAG", "text": "καὶ ὅτι τοῦτό ἐστιν ἀληθές, σαφῶς αὐτὸς δείκνυσιν ἐν τῷ περὶ τῆς οὐσίας λόγῳ πρώτην μὲν λέγων οὐσίαν εἶναι τὴν κατὰ τὰ ἄτομα θεωρουμένην, δευτέραν δὲ τὴν κατὰ τὰ εἴδη καὶ τὰ γένη, τῶν πραγμάτων ἀνάπαλιν ἐχόντων·", "seq": 571}
{"id": "Philoponus_Passim_0572", "series": "CAG", "text": "ἡ μὲν γὰρ κατὰ τὰ εἴδη καὶ τὰ γένη θεωρουμένη πρώτη ἐστίν, ἅτε δὴ καὶ αἰτία οὖσα τῶν ἀτόμων καὶ ἀσώματος καὶ ἀεὶ κατὰ τὰ αὐτὰ καὶ ὡσαύτως ἔχουσα, ἡ δὲ κατὰ τὰ ἄτομα δευτέρα ἐστὶν ὡς αἰτιατή.", "seq": 572}
{"id": "Philoponus_Passim_0573", "series": "CAG", "text": "ἀλλ᾿ ἐπειδὴ ταύτης ἔχει γνῶσιν ὁ πολὺς ἄνθρωπος, διὰ τοῦτο κατὰ τὴν τούτων δόξαν τὴν διδασκαλίαν ποιούμενος πρώτην αὐτὴν εἶπεν.", "seq": 573}
{"id": "Philoponus_Passim_0574", "series": "CAG", "text": "ἐπειδὴ οὖν τοῦ εἴδους καὶ τῆς ὕλης ἔννοιαν οὐκ ἔχει ὁ πολὺς ἄνθρωπος, μόνον δὲ οἶδε τὸ ἐκ τούτων σύνθετον καὶ τοῦτο ὡς ἕν, διὰ τοῦτο ὁ Ἀριστοτέλης καὶ εἰ κατηριθμεῖτο τὰ τοῦ ἔν τινι σημαινόμενα, οὐκ ἂν ἐμνήσθη τοῦ ὡς εἴδους ἐν ὕλῃ, ἅτε δὴ μὴ περὶ τῶν ὄντων ᾗ ὄντα ἐστὶ διαλεγόμενος, ἀλλὰ κατὰ τὰ τῷ πολλῷ ἀνθρώπῳ δοκοῦντα περὶ αὐτῶν.", "seq": 574}
{"id": "Philoponus_Passim_0575", "series": "CAG", "text": "ὥσπερ οὖν ὁ γεωμέτρης ὁριζόμενος τὸ σημεῖον λέγει ὅτι σημεῖόν ἐστιν οὗ μέρος οὐδὲν καὶ ὁ ὁρισμὸς οὗτος περιλαμβάνει οὐ μόνον τὸ σημεῖον ἀλλὰ καὶ τὴν μονάδα καὶ τὸ νῦν (ἕκαστον γὰρ τούτων ἀμερές ἐστι) καὶ οὐκ ἄν τις ἐγκαλέσειε τῷ γεωμέτρῃ ὡς διὰ τοῦ ὁρισμοῦ τοῦ σημείου περιλαμβάνοντι καὶ ταῦτα (ἐρεῖ γὰρ πάντως ὅτι εἰ καὶ ἡ μονὰς καὶ τὸ νῦν ἀμερῆ εἰσιν, ἀλλὰ τῶν ἐμοὶ ὑποβεβλημένων πραγμάτων οὐδέν ἐστιν ἄλλο ἀμερὲς ἢ τὸ σημεῖον), οὕτως καὶ ὁ Ἀριστοτέλης κατὰ τὸν σκοπὸν τῆς προκειμένης αὐτῷ διδασκαλίας οὐκ οἶδεν ἔν τινι τὸ ὡς εἶδος ἐν ὕλῃ·", "seq": 575}
{"id": "Philoponus_Passim_0576", "series": "CAG", "text": "οὐ γὰρ ἔχει τούτου ἔννοιαν ὁ πολὺς ἄνθρωπος.", "seq": 576}
{"id": "Philoponus_Passim_0577", "series": "CAG", "text": "βούλεται δέ, ὡς εἴπομεν, οὐ περὶ τῶν ὄντων ᾗ ὄντα ἐστὶ διαλεχθῆναι, ἀλλὰ ᾗ σημαίνονται ὑπὸ τῶν τοιῶνδε φωνῶν κατὰ τὰ τοῖς πολλοῖς δοκοῦντα.", "seq": 577}
{"id": "Philoponus_Passim_0578", "series": "CAG", "text": "καὶ ταῦτα μὲν πρὸς τοὺς λέγοντας πλεονάζειν τὸν ὁρισμόν.", "seq": 578}
{"id": "Philoponus_Passim_0579", "series": "CAG", "text": "Οἱ δὲ ἐλλείπειν εἰρηκότες φασὶ μὴ πάντα τὰ συμβεβηκότα περιειληφέναι τὸν ὁρισμόν, ἀλλὰ μόνα τὰ ἀχώριστα·", "seq": 579}
{"id": "Philoponus_Passim_0580", "series": "CAG", "text": "εἶπε γάρ, φασίν, ὅτι ἀδύνατον χωρὶς εἶναι τοῦ ἐν ᾧ ἐστι·", "seq": 580}
{"id": "Philoponus_Passim_0581", "series": "CAG", "text": "τὰ δὲ χωριστά φασιν οὐκ ἀδύνατον χωρισθῆναι, ἀλλὰ καὶ ἀναγκαῖον.", "seq": 581}
{"id": "Philoponus_Passim_0582", "series": "CAG", "text": "τί οὖν φαμεν;", "seq": 582}
{"id": "Philoponus_Passim_0583", "series": "CAG", "text": "ὅτι εἰ μὲν εἶπεν ‘ἀδύνατον χωρισθῆναι’, καλῶς ἂν ἐλέγετε·", "seq": 583}
{"id": "Philoponus_Passim_0584", "series": "CAG", "text": "νῦν δὲ λέγει ἀδύνατον χωρὶς εἶναι ἀντὶ τοῦ ὑπάρξαι καὶ συστῆναι·", "seq": 584}
{"id": "Philoponus_Passim_0585", "series": "CAG", "text": "καὶ γὰρ καὶ τὰ χωριστὰ ἀδύνατον ὑποστῆναι δίχα τῆς ὑποκειμένης αὐτοῖς οὐσίας.", "seq": 585}
{"id": "Philoponus_Passim_0586", "series": "CAG", "text": "ἔτι ἀποροῦσί τινες λέγοντες ‘πῶς εἶπεν ὅτι οὐ δύναται τὸ συμβεβηκὸς χωρὶς εἶναι τοῦ ἐν ᾧ ἐστιν;", "seq": 586}
{"id": "Philoponus_Passim_0587", "series": "CAG", "text": "ἰδοὺ γὰρ ἡ ὀσμὴ συμβεβηκός ἐστι καὶ χωρισθεῖσα τοῦ ὑποκειμένου ἔστιν ἔτι·", "seq": 587}
{"id": "Philoponus_Passim_0588", "series": "CAG", "text": "μήλου γὰρ πολλάκις πόρρω ἡμῶν ὄντος διαβαίνει πρὸς ἡμᾶς ἡ τούτου εὐωδία·", "seq": 588}
{"id": "Philoponus_Passim_0589", "series": "CAG", "text": "ὥστε δύναται καὶ ἡ εὐωδία τοῦ μήλου, συμβεβηκὸς αὐτοῦ οὖσα, χωρὶς εἶναι τῆς οὐσίας τοῦ μήλου.", "seq": 589}
{"id": "Philoponus_Passim_0590", "series": "CAG", "text": "καὶ ἐπὶ πάντων δὲ τῶν τοιούτων ὁμοίως’.", "seq": 590}
{"id": "Philoponus_Passim_0591", "series": "CAG", "text": "διχῶς οὖν τοῦτο ἐπιλυόμεθα.", "seq": 591}
{"id": "Philoponus_Passim_0592", "series": "CAG", "text": "πρῶτον μὲν ὅτι οὐκ εἶπεν ὁ Ἀριστοτέλης ‘ἐν ᾧ ἦν’, ἀλλ᾿ ἐν ᾧ ἐστιν·", "seq": 592}
{"id": "Philoponus_Passim_0593", "series": "CAG", "text": "ἀδύνατον οὖν χωρὶς εἶναι τὴν εὐωδίαν τοῦ μήλου τοῦ ἐν ᾧ ἐστιν·", "seq": 593}
{"id": "Philoponus_Passim_0594", "series": "CAG", "text": "ἢ γὰρ ἐν τῷ μήλῳ ἐστὶν ἢ ἐν ἀέρι.", "seq": 594}
{"id": "Philoponus_Passim_0595", "series": "CAG", "text": "ἔπειτα δὲ ὅτι οὐ μόνη ἡ τοῦ μήλου εὐωδία χωρεῖ πρὸς ἡμᾶς, ἀλλὰ μετά τινος λεπτομεροῦς τοῦ μήλου οὐσίας.", "seq": 595}
{"id": "Philoponus_Passim_0596", "series": "CAG", "text": "καὶ τοῦτο δῆλον ἐξ ὧν πολλάκις παριόντες δυσώδη τόπον ῥάκει τοὺς μυκτῆρας περιφράξαντες τὸν μὲν ἀέρα ἀναπνέομεν (ἀδύνατον γὰρ τοῦτον μὴ ἀναπνεῖν), τῆς δὲ δυσωδίας οὐκ ἀντιλαμβανόμεθα, ἅτε παχυμερεστέρας οὔσης τῆς ἀπορρυείσης οὐσίας ἐκείνης ἢ κατὰ τὸν ἀέρα καὶ μὴ δυναμένης διεισδῦναι τοὺς πόρους τοῦ ῥάκους·", "seq": 596}
{"id": "Philoponus_Passim_0597", "series": "CAG", "text": "ὁ δὲ ἀὴρ διεισδύνει διὰ τὴν λεπτομέρειαν.", "seq": 597}
{"id": "Philoponus_Passim_0598", "series": "CAG", "text": "εἰ δὲ χρόνῳ πολλάκις καὶ τοῦ ῥάκους ἐπικειμένου τῆς δυσωδίας ἀντιλαμβανόμεθα, οὐδὲν θαυμαστόν·", "seq": 598}
{"id": "Philoponus_Passim_0599", "series": "CAG", "text": "ἴσως γὰρ καὶ παρὰ τὴν θέσιν τοῦ ῥάκους τοῦτο γίνεται παρακεκλιμένου καὶ διείσδυσιν δεδωκότος τῇ παχυμερεστέρᾳ οὐσίᾳ, ὁπότε καὶ ἐπὶ πολὺ τῇ κινήσει ἀναρριπιζομένη μᾶλλον λεπτύνεται καὶ διεισδύνει·", "seq": 599}
{"id": "Philoponus_Passim_0600", "series": "CAG", "text": "ἀμέλει ἐπὶ πολὺ ἀναρριπισθεῖσα καὶ λεπτομερὴς γινομένη διεισδύνει.", "seq": 600}
{"id": "Philoponus_Passim_0601", "series": "CAG", "text": "τεκμήριον δὲ μέγιστον τοῦ μετά τινος οὐσίας ἀπορρεῖν, ὅτι ἐν χρόνῳ πλείονι ῥυτιδοῦται τὸ μῆλον, ἅτε τῆς οὐσίας αὐτοῦ διαφορουμένης, ἐν ᾗ ἡ εὐωδία ὑπῆρχε.", "seq": 601}
{"id": "Philoponus_Passim_0602", "series": "CAG", "text": "δηλοῦσι δὲ τοῦτο καὶ οἱ ἐκ τοῦ θυμιάματος ἀναδιδόμενοι ἀτμοὶ αὐτόθεν τῇ αἰσθήσει ὑποπίπτοντες διὰ τὴν παχύτητα τῆς ὑποκειμένης οὐσίας, ὅθεν καὶ ταῖς χερσὶ πολλάκις τὸν ἀέρα κινοῦντες ὠθοῦμεν πρὸς τοὺς μυκτῆρας, ὁπηνίκα παχυμερέστερος ὢν ὁ ἀπὸ τοῦ θυμιάματος ἀναδιδόμενος ἀτμὸς μὴ διικνεῖται ῥᾳδίως πρὸς τὸ αἰσθητήριον, ὅπερ οὐκ ἂν ἐδεόμεθα ποιεῖν, εἰ ἀσωμάτως αἱ ποιότητες ἐκ τῶν θυμιαμάτων εἰς τὸν ἀέρα ἐχώρουν·", "seq": 602}
{"id": "Philoponus_Passim_0603", "series": "CAG", "text": "τοῦτο γοῦν ἐπὶ τῶν ψόφων οὐ ποιοῦμεν.", "seq": 603}
{"id": "Philoponus_Passim_0604", "series": "CAG", "text": "εἰ δέ τις εἴποι ‘πῶς οὖν ἐν τῷ δένδρῳ ὄντα τὰ μῆλα καὶ τῆς ὀσμῆς ἡμῖν μεταδιδόασι καὶ μείωσιν οὐχ ὑπομένει;’", "seq": 604}
{"id": "Philoponus_Passim_0605", "series": "CAG", "text": ", λέγομεν ὅτι ἐνταῦθα πλεῖόν ἐστι τὸ ἐπιρρέον καὶ τρέφον τοῦ διαφορουμένου.", "seq": 605}
{"id": "Philoponus_Passim_0606", "series": "CAG", "text": "1b6 Ἁπλῶς δὲ τὰ ἄτομα καὶ ἓν ἀριθμῷ κατ᾿ οὐδενὸς ὑποκειμένου λέγεται, ἐν ὑποκειμένῳ δ᾿ ἔνια οὐδὲν κωλύει εἶναι·", "seq": 606}
{"id": "Philoponus_Passim_0607", "series": "CAG", "text": "ἡ γὰρ τὶς γραμματικὴ τῶν ἐν ὑποκειμένῳ μέν ἐστι, καθ᾿ ὑποκειμένου δὲ οὐδενὸς λέγεται.", "seq": 607}
{"id": "Philoponus_Passim_0608", "series": "CAG", "text": "Ἐπειδὴ προσεχῶς τῶν μερικῶν οὐσιῶν ἐμνημόνευσεν ὡς μὴ καθ᾿ ὑποκειμένου λεγομένων, λέγων τὰ δὲ οὔτε ἐν ὑποκειμένῳ ἐστὶν οὔτε καθ᾿ ὑποκειμένου τινὸς λέγεται, οἷον ὁ τὶς ἄνθρωπος ἢ ὁ τὶς ἵππος, οὐ μόναι δὲ αἱ μερικαὶ οὐσίαι λέγονται οὐ καθ᾿ ὑποκειμένου ἀλλὰ καὶ τὰ μερικὰ συμβεβηκότα, διὰ τοῦτο ἐνταῦθα καθολικὸν ποιεῖται τὸν λόγον καί φησιν ἁπλῶς δὲ (ἀντὶ τοῦ ‘καθολικῷ δέ τινι λόγῳ’) πάντα τὰ ἄτομα, ἃ καὶ ἕν ἐστι τῷ ἀριθμῷ, εἴτε οὐσίαι εἶεν εἴτε συμβεβηκότα, κατ᾿ οὐδενὸς ὑποκειμένου λέγεται.", "seq": 608}
{"id": "Philoponus_Passim_0609", "series": "CAG", "text": "τὸ δὲ ἁπλῶς λέγεται τριχῶς·", "seq": 609}
{"id": "Philoponus_Passim_0610", "series": "CAG", "text": "ἢ τὸ καθόλου, ὡς λέγομεν ‘ἁπλῶς πᾶς ἄνθρωπος’ ἀντὶ τοῦ καθόλου, ἢ τὸ μοναχῶς ὡς τὸ", "seq": 610}
{"id": "Philoponus_Passim_0611", "series": "CAG", "text": "ἁπλοῦς ὁ μῦθος τῆς ἀληθείας ἔφυ", "seq": 611}
{"id": "Philoponus_Passim_0612", "series": "CAG", "text": "ἀντὶ τοῦ οὐ ποικίλος, ἢ τὸ κυρίως, ὡς ὅταν λέγωμεν ‘ἡ ἁπλῶς ἀρετή’ ἀντὶ τοῦ ‘ἡ κυρίως ἀρετή’.", "seq": 612}
{"id": "Philoponus_Passim_0613", "series": "CAG", "text": "καὶ τὸ ἓν δὲ λέγεται τριχῶς, καὶ ὅλως ἡ ταυτότης καὶ ἡ ἑτερότης·", "seq": 613}
{"id": "Philoponus_Passim_0614", "series": "CAG", "text": "λέγομεν γὰρ ἢ τῷ γένει ἓν ὡς ἄνθρωπον καὶ ἵππον, ἢ τῷ εἴδει ἓν ὡς Σωκράτην καὶ Πλάτωνα, ἢ τῷ ἀριθμῷ ὡς Πλάτωνα·", "seq": 614}
{"id": "Philoponus_Passim_0615", "series": "CAG", "text": "ἓν γάρ τι τῷ ἀριθμῷ ὁ Πλάτων.", "seq": 615}
{"id": "Philoponus_Passim_0616", "series": "CAG", "text": "ἀλλὰ καὶ τὰ ἕτερα ὁμοίως ἢ τῷ γένει φαμὲν ὡς ἵππον καὶ συκῆν, ἢ τῷ εἴδει ὡς ἵππον καὶ ἄνθρωπον, ἢ τῷ ἀριθμῷ ὡς Πλάτωνα καὶ Σωκράτην.", "seq": 616}
{"id": "Philoponus_Passim_0617", "series": "CAG", "text": "ἐνταῦθα οὖν τὸ τῷ ἀριθμῷ ἓν παρέλαβεν.", "seq": 617}
{"id": "Philoponus_Passim_0618", "series": "CAG", "text": "ἰστέον δὲ ὅτι τὰ μὲν τῷ ἀριθμῷ ἕτερα ἐνδέχεται εἶναι τῷ γένει καὶ τῷ εἴδει ἕν, ὡς Σωκράτην καὶ Πλάτωνα, τὰ δὲ τῷ εἴδει ἕτερα πάντως μὲν καὶ τῷ ἀριθμῷ ἕτερα, οὐ πάντως δὲ τῷ γένει, ἀλλ᾿ ἔστιν ὅτε ταὐτά, ὡς ἵππος καὶ ἄνθρωπος, τὰ δὲ τῷ γένει ἕτερα πάντως καὶ τῷ εἴδει καὶ τῷ ἀριθμῷ, ὡς ἵππος καὶ συκῆ ἢ ὡς ἄνθρωπος καὶ λευκόν.", "seq": 618}
{"id": "Philoponus_Passim_0619", "series": "CAG", "text": "Ἐν ὑποκειμένῳ δ᾿ ἔνια, φησίν, οὐδὲν κωλύει εἶναι·", "seq": 619}
{"id": "Philoponus_Passim_0620", "series": "CAG", "text": "ἐπειδὴ <γὰρ> καθολικὸν τὸν λόγον ἐποιήσατο εἰπὼν μηδὲν τῶν ἀτόμων, ἃ καὶ ἕν ἐστι τῷ ἀριθμῷ, εἶναι καθ᾿ ὑποκειμένου, οὐ μόναι δὲ αἱ μερικαὶ οὐσίαι ἀλλὰ καὶ τὰ μερικὰ συμβεβηκότα ἄτομά εἰσιν, ὡς ἡ τὶς γραμματική, ὡς αὐτός φησιν, ἐπήγαγε τὸ ἐν ὑποκειμένῳ δέ τινα οὐδὲν κωλύει εἶναι, τὰ μερικὰ συμβεβηκότα δηλῶν οὕτως.", "seq": 620}
{"id": "Philoponus_Passim_0621", "series": "CAG", "text": "1b10 Ὅταν ἕτερον καθ᾿ ἑτέρου κατηγορῆται ὡς καθ᾿ ὑποκειμένου, ὅσα κατὰ τοῦ κατηγορουμένου λέγεται, πάντα καὶ κατὰ τοῦ ὑποκειμένου ῥηθήσεται.", "seq": 621}
{"id": "Philoponus_Passim_0622", "series": "CAG", "text": "Διαλεχθεὶς περὶ τοῦ ἐν ὑποκειμένῳ νῦν τρέπεται ἐπὶ τὴν τοῦ καθ᾿ ὑποκειμένου διδασκαλίαν καὶ τρόπον τινὰ τοῦτό φησιν, ὅτι ἄλλο ἐστὶ τὸ κατηγορεῖσθαι κατά τινος καὶ ἄλλο τὸ ὡς καθ᾿ ὑποκειμένου κατηγορεῖσθαι, τούτῳ δὲ πάντως παρακολουθεῖ τῷ ὡς καθ᾿ ὑποκειμένου κατηγορουμένῳ τὸ πάντα ὅσα κατὰ τοῦ κατηγορουμένου λέγεται ταῦτα καὶ κατὰ τοῦ ὑποκειμένου τούτῳ λέγεσθαι·", "seq": 622}
{"id": "Philoponus_Passim_0623", "series": "CAG", "text": "οἷον κατηγορεῖται Σωκράτους ὡς καθ᾿ ὑποκειμένου ὁ ἁπλῶς ἄνθρωπος, τοῦ δὲ ἁπλῶς ἀνθρώπου κατηγορεῖται τὸ ζῷον, τοῦτο οὖν καὶ κατὰ τοῦ Σωκράτους κατηγορηθήσεται·", "seq": 623}
{"id": "Philoponus_Passim_0624", "series": "CAG", "text": "διαβιβάζει γὰρ διὰ μέσου ἑαυτοῦ ὁ ἁπλῶς ἄνθρωπος ἐπὶ Σωκράτην τὴν τοῦ ζῴου κατηγορίαν.", "seq": 624}
{"id": "Philoponus_Passim_0625", "series": "CAG", "text": "τί δὲ αὐτῷ βούλεται τὸ ὡς καθ᾿ ὑποκειμένου;", "seq": 625}
{"id": "Philoponus_Passim_0626", "series": "CAG", "text": "τὸ οὐσιωδῶς καὶ πραγματικῶς.", "seq": 626}
{"id": "Philoponus_Passim_0627", "series": "CAG", "text": "εἰ γάρ τι κατὰ τοῦ κατηγορουμένου κατὰ συμβεβηκὸς κατηγορεῖται, οὐκ ἀνάγκη τοῦτο καὶ κατὰ τοῦ ὑποκειμένου λέγεσθαι·", "seq": 627}
{"id": "Philoponus_Passim_0628", "series": "CAG", "text": "οἷον τοῦ Ἀγαμέμνονος πραγματικῶς κατηγορεῖται καὶ ὡς καθ᾿ ὑποκειμένου ὁ ἄνθρωπος, τοῦ δὲ ἀνθρώπου οὐσιωδῶς μὲν κατηγορεῖται τὸ ζῷον, κατὰ συμβεβηκὸς δὲ τὸ τρισύλλαβον·", "seq": 628}
{"id": "Philoponus_Passim_0629", "series": "CAG", "text": "διὰ τοῦτο τὸ μὲν ζῷον κατηγορεῖται κατὰ τοῦ Ἀγαμέμνονος, οὐκέτι δὲ τὸ τρισύλλαβον.", "seq": 629}
{"id": "Philoponus_Passim_0630", "series": "CAG", "text": "πάλιν τοῦ μὲν ζῴου ὡς καθ᾿ ὑποκειμένου μὲν καὶ ὡς πράγματος κατηγορεῖται τὸ ἔμψυχον τὸ αἰσθητικόν, κατὰ συμβεβηκὸς δὲ καὶ σχετικῶς τὸ γένος ἢ τὸ δισύλλαβον *.", "seq": 630}
{"id": "Philoponus_Passim_0631", "series": "CAG", "text": "ὁμοίως ἔχει καὶ ἐπὶ συμβεβηκότων·", "seq": 631}
{"id": "Philoponus_Passim_0632", "series": "CAG", "text": "τῶν γὰρ τριῶν, εἰ τύχοι, ὡς πράγματος κατηγορεῖται ὁ ἀριθμός, τοῦ δὲ ἀριθμοῦ ὡς μὲν πράγματος τὸ ποσόν, κατὰ συμβεβηκὸς δὲ τὸ τρισύλλαβον·", "seq": 632}
{"id": "Philoponus_Passim_0633", "series": "CAG", "text": "διὰ τοῦτο τῶν τριῶν ὁ μὲν ἀριθμὸς κατηγορεῖται, τὸ δὲ τρισύλλαβον οὐκέτι.", "seq": 633}
{"id": "Philoponus_Passim_0634", "series": "CAG", "text": "ἵνα οὖν σημάνῃ τὰ οὐσιωδῶς καὶ ὡς πραγμάτων κατηγορούμενα, εἶπε τὸ ὡς καθ᾿ ὑποκειμένου·", "seq": 634}
{"id": "Philoponus_Passim_0635", "series": "CAG", "text": "τοῦ γὰρ ζῴου τὸ δισύλλαβον οὐχ ὡς καθ᾿ ὑποκειμένου κατηγορεῖται, ἀλλ᾿ ὡς φωνῆς καὶ τοῦ ποσοῦ τῶν συλλαβῶν, καὶ τὸ γένος ὡς σχέσεως.", "seq": 635}
{"id": "Philoponus_Passim_0636", "series": "CAG", "text": "ὅσα οὖν, φησί, καθ᾿ ἑτέρου λέγεται ὡς καθ᾿ ὑποκειμένου (ἀντὶ τοῦ ὡς πράγματος ὑφεστῶτος), ὅσα κατὰ τοῦ κατηγορουμένου λέγεται (προσυπακουστέον δὲ καὶ ἐνταῦθα τὸ ὡς καθ᾿ ὑποκειμένου), πάντα καὶ κατὰ τοῦ ὑποκειμένου ῥηθήσεται.", "seq": 636}
{"id": "Philoponus_Passim_0637", "series": "CAG", "text": "1b16 Τῶν ἑτερογενῶν καὶ μὴ ὑπ᾿ ἄλληλα τεταγμένων ἕτεραι τῷ εἴδει καὶ αἱ διαφοραί.", "seq": 637}
{"id": "Philoponus_Passim_0638", "series": "CAG", "text": "Λημμάτιά τινα προλαμβάνει χρήσιμα αὐτῷ ἐσόμενα πρὸς τὴν προκειμένην διδασκαλίαν·", "seq": 638}
{"id": "Philoponus_Passim_0639", "series": "CAG", "text": "ἐπειδὴ γὰρ αἱ κατηγορίαι καὶ γενικώτατά εἰσι γένη καὶ ἐφ᾿ ἑκάστης σειρά τις ἐκδίδοται τῶν ὑπαλλήλων γενῶν, κανόνα διακριτικὸν ἡμῖν ἐνταῦθα παραδίδωσιν ὁ φιλόσοφος τῶν τε πάντῃ ἑτέρων γενῶν καὶ τῶν ὑπαλλήλων καί φησιν ὅτι τῶν ἑτέρων γενῶν πάντως ἕτεραι καὶ αἱ διαφοραὶ αἵ τε συστατικαὶ καὶ αἱ διαιρετικαί, οἷον ζῴου καὶ ἐπιστήμης·", "seq": 639}
{"id": "Philoponus_Passim_0640", "series": "CAG", "text": "ζῴου μὲν γὰρ διαφοραὶ συστατικαὶ τὸ ἔμψυχον καὶ τὸ αἰσθητικόν, διαιρετικαὶ δὲ τὸ λογικὸν καὶ τὸ ἄλογον, τὸ θνητὸν καὶ τὸ ἀθάνατον, τῆς δὲ ἐπιστήμης συστατικαὶ μὲν διαφοραί, εἰ τύχοι, τὸ ἄπταιστον τῶν λόγων καὶ βέβαιον τῷ ἀεὶ κατὰ τὰ αὐτὰ καὶ ὡσαύτως ἔχειν τὰ τῇ ἐπιστήμῃ ὑποκείμενα πράγματα, διαιρετικαὶ δὲ τὸ θεωρητικὸν καὶ πρακτικόν.", "seq": 640}
{"id": "Philoponus_Passim_0641", "series": "CAG", "text": "ἕτεραι οὖν ὑπάρχουσιν αἱ διαφοραὶ ἑτέρων ὄντων τῶν γενῶν.", "seq": 641}
{"id": "Philoponus_Passim_0642", "series": "CAG", "text": "ἐπειδὴ δὲ τὰ ἕτερα γένη πολλαχῶς λέγεται (λέγεται γὰρ ἕτερα ἢ τὰ πάντῃ διεστηκότα ἀλλήλων, ὡς ἡ οὐσία καὶ τὸ ποσόν, ἢ τὰ μὴ πάντῃ κεχωρισμένα ἀντιδιῃρημένα μέντοι ἀλλήλοις ἀπὸ τῆς αὐτῆς διαιρέσεως, οἷον τὸ πτηνὸν καὶ τὸ ἔνυδρον·", "seq": 642}
{"id": "Philoponus_Passim_0643", "series": "CAG", "text": "ἔχει γὰρ ταῦτα κοινὸν γένος τὸ ζῷον·", "seq": 643}
{"id": "Philoponus_Passim_0644", "series": "CAG", "text": "λέγεται δὲ καὶ τὰ ὑπάλληλα ἕτερα, ὡς ἡ οὐσία καὶ τὸ σῶμα), διὰ τοῦτο εἶπε καὶ μὴ ὑπ᾿ ἄλληλα τεταγμένων·", "seq": 644}
{"id": "Philoponus_Passim_0645", "series": "CAG", "text": "τούτων μὲν γὰρ ἐνδέχεται τὰς αὐτὰς εἶναι διαφοράς, οἷον τοῦ τε ἁπλῶς ζῴου καὶ τοῦ λογικοῦ ζῴου·", "seq": 645}
{"id": "Philoponus_Passim_0646", "series": "CAG", "text": "ἀμφοτέρων γὰρ αἱ αὐταὶ διαφοραὶ αἵ τε συστατικαὶ καὶ αἱ διαιρετικαί·", "seq": 646}
{"id": "Philoponus_Passim_0647", "series": "CAG", "text": "συστατικαὶ γὰρ ἀμφοτέρων τὸ ἔμψυχον καὶ τὸ αἰσθητικόν·", "seq": 647}
{"id": "Philoponus_Passim_0648", "series": "CAG", "text": "ἀλλὰ καὶ αἱ διαιρετικαὶ αἱ αὐταί, τὸ θνητὸν καὶ τὸ ἀθάνατον.", "seq": 648}
{"id": "Philoponus_Passim_0649", "series": "CAG", "text": "τῶν δὲ μὴ ὑπ᾿ ἄλληλα τεταγμένων ἀλλ᾿ ἑτέρων οὔτε αἱ συστατικαὶ οὔτε αἱ διαιρετικαὶ αἱ αὐταί, ὡς ἐπὶ τοῦ ζῴου εἴπομεν καὶ τῆς ἐπιστήμης.", "seq": 649}
{"id": "Philoponus_Passim_0650", "series": "CAG", "text": "τῶν δέ γε ὑπαλλήλων, ὡς εἴρηται, αἱ μὲν συστατικαὶ πάντως αἱ αὐταί, αἱ δὲ διαιρετικαὶ οὐ πάντως αἱ αὐταί, ἀλλ᾿ ἐνδέχεται εἶναι καὶ ἑτέρας, ὡς ἐπὶ τοῦ ζῴου καὶ τοῦ ἀλόγου ζῴου·", "seq": 650}
{"id": "Philoponus_Passim_0651", "series": "CAG", "text": "συστατικαὶ μὲν γὰρ αἱ αὐταί, ὡς εἴρηται, διαιρετικαὶ δὲ οὐχὶ αἱ αὐταί·", "seq": 651}
{"id": "Philoponus_Passim_0652", "series": "CAG", "text": "τοῦ μὲν γὰρ ἁπλῶς ζῴου τὸ λογικὸν καὶ τὸ ἄλογον, τὸ θνητὸν καὶ τὸ ἀθάνατον, τοῦ δὲ ἀλόγου τὸ πτηνὸν τὸ ἔνυδρον τὸ χερσαῖον.", "seq": 652}
{"id": "Philoponus_Passim_0653", "series": "CAG", "text": "ὁ αὐτὸς δὲ λόγος ἁρμόσει καὶ ἐπὶ τῶν ἀντιδιῃρημένων ἀλλήλοις γενῶν·", "seq": 653}
{"id": "Philoponus_Passim_0654", "series": "CAG", "text": "καὶ τούτων γὰρ συστατικαὶ μὲν αἱ αὐταί, διαιρετικαὶ δὲ ἕτεραι·", "seq": 654}
{"id": "Philoponus_Passim_0655", "series": "CAG", "text": "ἀλόγου μὲν γὰρ αἱ εἰρημέναι, λογικοῦ δὲ θνητὸν ἀθάνατον οὐράνιον χθόνιον.", "seq": 655}
{"id": "Philoponus_Passim_0656", "series": "CAG", "text": "Καλῶς δὲ τῷ εἴδει προσέθηκε, τοῦτ᾿ ἔστι τῷ πράγματι·", "seq": 656}
{"id": "Philoponus_Passim_0657", "series": "CAG", "text": "ἐνδέχεται γὰρ τῶν ἑτέρων γενῶν κατὰ ἀναλογίαν τὰς αὐτὰς εἶναι διαφοράς·", "seq": 657}
{"id": "Philoponus_Passim_0658", "series": "CAG", "text": "λέγομεν γὰρ τῶν σκευῶν τὰ μὲν εἶναι ὑπόποδα τὰ δὲ ἄποδα·", "seq": 658}
{"id": "Philoponus_Passim_0659", "series": "CAG", "text": "ἄποδα μὲν θυία καὶ δοίδυξ καὶ τὰ τοιαῦτα, ὑπόποδα δὲ θρόνος καὶ κλίνη·", "seq": 659}
{"id": "Philoponus_Passim_0660", "series": "CAG", "text": "ἀλλὰ καὶ τῶν ζῴων τὰ μὲν λέγομεν ὑπόποδα εἶναι τὰ δὲ ἄποδα.", "seq": 660}
{"id": "Philoponus_Passim_0661", "series": "CAG", "text": "ἀλλ᾿ αὗται αἱ διαφοραὶ οὐκ εἰσὶν εἰδοποιοί·", "seq": 661}
{"id": "Philoponus_Passim_0662", "series": "CAG", "text": "οὐ γὰρ τῷ εἶναι δίπους ὁ ἄνθρωπος χαρακτηρίζεται.", "seq": 662}
{"id": "Philoponus_Passim_0663", "series": "CAG", "text": "ἀλλ᾿ οὐδὲ εἰ τῇ φωνῇ αἱ αὐταὶ εἶναι δοκοῦσι διαφοραί, ἤδη καὶ κατ᾿ εἶδος αἱ αὐταί εἰσιν·", "seq": 663}
{"id": "Philoponus_Passim_0664", "series": "CAG", "text": "οὐδὲ γὰρ τοῦ αὐτοῦ εἴδους οἵ τε τῆς κλίνης πόδες καὶ οἱ τοῦ ζῴου, ἐπεὶ μηδὲ ἡ ἐνέργεια ἡ αὐτή.", "seq": 664}
{"id": "Philoponus_Passim_0665", "series": "CAG", "text": "ἐξ ἀναλογίας δὲ εἴπερ ἄρα ἡ ὁμοιότης·", "seq": 665}
{"id": "Philoponus_Passim_0666", "series": "CAG", "text": "τὰ γὰρ κάτω μέρη οἷον ἐρείσματα καὶ τοῦ ζῴου καὶ τῆς κλίνης πόδες καλοῦνται·", "seq": 666}
{"id": "Philoponus_Passim_0667", "series": "CAG", "text": "ὡς γὰρ πρὸς ζῷον οἱ πόδες, οὕτω καὶ πρὸς κλίνην οἱ ἑρμῖνες·", "seq": 667}
{"id": "Philoponus_Passim_0668", "series": "CAG", "text": "ἀλλ᾿ οὐκέτι καὶ τὰς λοιπὰς χρείας τῶν ποδῶν ἀποδιδόασι, τὸ βαδίζειν φέρε καὶ συμμετάγειν τῇ ἰδίᾳ κινήσει τὸ σῶμα καὶ τὰ παραπλήσια·", "seq": 668}
{"id": "Philoponus_Passim_0669", "series": "CAG", "text": "ὥστε οὐκ εἴδει οἱ αὐτοί, ἀλλὰ φωνῇ καὶ ἀναλογίᾳ.", "seq": 669}
