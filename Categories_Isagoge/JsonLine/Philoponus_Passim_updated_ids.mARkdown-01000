{"id": "Philoponus_Passim_2313", "series": "CAG", "text": "εἰ γὰρ ὁμωνύμως εἴληπτο, εἰς διάφορα ἂν σημαινόμενα ἐγίνετο ἡ διαίρεσις·", "seq": 2313}
{"id": "Philoponus_Passim_2314", "series": "CAG", "text": "ἐπεὶ δὲ τὸ διαφόρως εἴληπται, διὰ τοῦτο γίνεται καὶ ἡ διαίρεσις ὡς γένους εἰς εἴδη.", "seq": 2314}
{"id": "Philoponus_Passim_2315", "series": "CAG", "text": "ἆρα οὖν οὐκ ἔστι γένος ἡ ποιότης;", "seq": 2315}
{"id": "Philoponus_Passim_2316", "series": "CAG", "text": "διὰ τί οὖν τῶν εἰδῶν αὐτῆς τὸ μὲν πρῶτον λέγεται τὸ δὲ δεύτερον;", "seq": 2316}
{"id": "Philoponus_Passim_2317", "series": "CAG", "text": "λέγομεν ὅτι καθὸ ποιότης οὐκ ἔστι τὸ μὲν πρῶτον τὸ δὲ δεύτερον, ἀλλὰ μόνῳ ἀξιώματι διαφέρουσιν, ὡς καὶ ἄνθρωπος ἵππου.", "seq": 2317}
{"id": "Philoponus_Passim_2318", "series": "CAG", "text": "8b26 Ἓν μὲν οὖν εἶδος ποιότητος ἕξις καὶ διάθεσις λεγέσθωσαν", "seq": 2318}
{"id": "Philoponus_Passim_2319", "series": "CAG", "text": "Πρῶτον εἶδος τῆς ποιότητος ἕξις καὶ διάθεσις.", "seq": 2319}
{"id": "Philoponus_Passim_2320", "series": "CAG", "text": "διαφέρει δέ, φησίν, ἡ ἕξις τῆς διαθέσεως τῷ τὴν μὲν διάθεσιν εὐαπόβλητον εἶναι τὴν δὲ ἕξιν δυσαπόβλητον, καὶ ὅτι ἡ μὲν ἕξις πάντως καὶ διάθεσις, ἡ δὲ διάθεσις οὐκ ἐξ ἀνάγκης καὶ ἕξις.", "seq": 2320}
{"id": "Philoponus_Passim_2321", "series": "CAG", "text": "8b29 Τοιαῦται δὲ αἵ τε ἐπιστῆμαι καὶ αἱ ἀρεταί.", "seq": 2321}
{"id": "Philoponus_Passim_2322", "series": "CAG", "text": "Ἐπιστήμας ἐνταῦθα λέγει οὐ τὰς ἀπταίστους, ἀλλὰ πᾶσαν ἁπλῶς τέχνην μόνιμον, ὥστε κατὰ τοῦτο τὸ σημαινόμενον καὶ γραμματικὴν ἐπιστήμην εἶναι καὶ τεκτονικὴν καὶ τὰς ἄλλας βαναύσους τέχνας·", "seq": 2322}
{"id": "Philoponus_Passim_2323", "series": "CAG", "text": "ἑκάστη γὰρ ἕξις τίς ἐστι μόνιμος.", "seq": 2323}
{"id": "Philoponus_Passim_2324", "series": "CAG", "text": "ἡ δὲ ἐπιστήμη τριχῶς λέγεται·", "seq": 2324}
{"id": "Philoponus_Passim_2325", "series": "CAG", "text": "λέγεται γὰρ ἐπιστήμη ἡ ὑποκείμενον ἔχουσα ἄπταιστον καὶ ἀεὶ κατὰ τὰ αὐτὰ καὶ ὡσαύτως ἔχοντα καταγινομένη, καθ᾿ ὃ σημαινόμενον καὶ ἡ γεωμετρία ἐπιστήμη καὶ ἡ ἀστρονομία καὶ ἡ ἀριθμητική.", "seq": 2325}
{"id": "Philoponus_Passim_2326", "series": "CAG", "text": "ἰατρικὴ δὲ κατὰ τοῦτο οὐκ ἐπιστήμη περὶ ῥευστὸν καταγινομένη ὑποκείμενον.", "seq": 2326}
{"id": "Philoponus_Passim_2327", "series": "CAG", "text": "λέγεται δὲ ἐπιστήμη καὶ ἡ ἐξ ἀρχῶν αὐτοπίστων ὁρμωμένη, ἣ καὶ ὄντως ἐστὶν ἐπιστήμη, ἣν καλοῦσιν ἀνυπόθετον φιλοσοφίαν παρὰ τὸ ἐκ κοινῶν ἐννοιῶν ὁρμᾶσθαι.", "seq": 2327}
{"id": "Philoponus_Passim_2328", "series": "CAG", "text": "κατὰ τοῦτο δὲ οὔτε γεωμετρίαν οὔτε ἀστρονομίαν οὔτε τῶν τοιούτων οὐδεμίαν ἐπιστήμην ἐρεῖς, ἐπειδὴ μὴ ἐξ αὐτοπίστων ἀρχῶν ὁρμῶνται ἀλλ᾿ ἀποδείξεως δεομένων·", "seq": 2328}
{"id": "Philoponus_Passim_2329", "series": "CAG", "text": "ἀρχαὶ γὰρ γεωμετρίας τὸ σημεῖον ἡ γραμμὴ ἡ ἐπιφάνεια καὶ τὰ τοιαῦτα.", "seq": 2329}
{"id": "Philoponus_Passim_2330", "series": "CAG", "text": "καὶ ὁρίζεται μὲν ἕκαστον τούτων ὁ γεωμέτρης, τὸ μὲν σημεῖον λέγων οὗ μέρος οὐδέν, τὴν δὲ γραμμὴν μῆκος ἀπλατές, καὶ τὰ ἄλλα ὡς ἔχει·", "seq": 2330}
{"id": "Philoponus_Passim_2331", "series": "CAG", "text": "τούτων δὲ τὴν ἀπόδειξιν, λέγω δὴ διὰ τί τὸ σημεῖον ἀμερὲς ἢ ἡ γραμμὴ μῆκος ἀπλατές, οὐκέτι οἶδεν ᾗ γεωμέτρης ἐστίν, ἀλλὰ τῷ πρώτῳ φιλοσόφῳ ἀναπέμπει τούτων τὰς ἀποδείξεις ποιεῖσθαι·", "seq": 2331}
{"id": "Philoponus_Passim_2332", "series": "CAG", "text": "οὐδεμία γὰρ ἐπιστήμη αὐτὴ τὰς ἑαυτῆς ἀρχὰς ἀποδείκνυσιν.", "seq": 2332}
{"id": "Philoponus_Passim_2333", "series": "CAG", "text": "αἱ τοίνυν μὴ ἐξ ἀρχῶν αὐτοπίστων ὁρμώμεναι οὐκ ἂν εἶεν κυρίως ἐπιστῆμαι, ὡς καὶ ὁ Πλάτων φησὶν ‘ᾧ γὰρ ἀρχαὶ μὲν ἃς οὐκ οἶδε, μέσα δὲ καὶ τελευταῖα ἐξ ὧν οὐκ οἶδε, πῶς ἂν εἴη τοῦτο ἐπιστήμη;’", "seq": 2333}
{"id": "Philoponus_Passim_2334", "series": "CAG", "text": ".", "seq": 2334}
{"id": "Philoponus_Passim_2335", "series": "CAG", "text": "ἔστι δὲ καὶ κατὰ τρίτον τινὰ λόγον ἐπιστήμη ἡ ὁδοποιητική, ἥτις οἶδε τίνα δεῖ προλαμβάνειν καὶ τίνα ἕπεσθαι, καθ᾿ ὃ σημαινόμενον καὶ ἡ ἰατρικὴ ἐπιστήμη καὶ πᾶσα βάναυσος τέχνη.", "seq": 2335}
{"id": "Philoponus_Passim_2336", "series": "CAG", "text": "ᾧ καὶ ἐνταῦθα κέχρηται σημαινομένῳ τῆς ἐπιστήμης ὁ φιλόσοφος.", "seq": 2336}
{"id": "Philoponus_Passim_2337", "series": "CAG", "text": "ἀρετὰς δὲ ἐνταῦθα λέγει τὰς τελείας τὰς καὶ τὸ ὅτι ἐπισταμένας καὶ τὸ διότι·", "seq": 2337}
{"id": "Philoponus_Passim_2338", "series": "CAG", "text": "τῶν γὰρ ἀρετῶν αἱ μέν εἰσι φυσικαί, ὡς οἱ φυσικήν τινα ἔχοντες σωφροσύνην ἢ πραεῖς ὄντες φύσει ἢ καί τινα τῶν ἀλόγων ἔχειν λέγονται, ὡς ἡ τρυγὼν καὶ ἡ κορώνη τὴν σωφροσύνην καὶ οἱ πελαργοὶ τὴν δικαιοσύνην, αἱ δὲ ἠθικαὶ αἱ εἰδυῖαι ὅτι καλὸν ἡ δικαιοσύνη καὶ ἁπλῶς ἡ ἀρετή, διὰ τί μέντοι καλὸν οὐκ εἰδυῖαι, ὀρθοδοξαστικῶς ἐκ πατέρων ἢ διδασκάλων τοῦτο γινωσκόντων τῶν κεκτημένων, αἱ δὲ πολιτικαί, αἵτινες μετὰ τοῦ ὅτι καὶ τὸ διότι ἴσασιν, αἱ δὲ καθαρτικαί.", "seq": 2338}
{"id": "Philoponus_Passim_2339", "series": "CAG", "text": "διαφέρουσι δὲ αἱ καθαρτικαὶ τῶν πολιτικῶν, ὅτι αἱ μὲν πολιτικαὶ ἐπιστρέφονται πρὸς τὰ καταδεέστερα καὶ τῶν ἡδονῶν ἀντιποιοῦνται τῶν σεμνοτέρων καὶ χρόνον καὶ τόπον καὶ ποσὸν παραφυλάττουσαι, οἱ μέντοι καθαρτικῶς ἐνεργοῦντες ἀνεπίστρεπτοί εἰσι πρὸς τὰ χείρονα καὶ καθάπαξ τῶν ἡδονῶν ὑπερορῶσιν.", "seq": 2339}
{"id": "Philoponus_Passim_2340", "series": "CAG", "text": "αἱ δὲ τῶν ἀρετῶν εἰσι θεωρητικαί.", "seq": 2340}
{"id": "Philoponus_Passim_2341", "series": "CAG", "text": "ἐνταῦθα οὖν, ὡς εἴρηται, τὰς τελείας ἀρετὰς λέγει, τάς τε πολιτικὰς καὶ καθαρτικὰς καὶ θεωρητικάς.", "seq": 2341}
{"id": "Philoponus_Passim_2342", "series": "CAG", "text": "8b31 Ἐάν περ μὴ μεγάλη μεταβολὴ γένηται ὑπὸ νόσου ἢ ἄλλου τινὸς τοιούτου.", "seq": 2342}
{"id": "Philoponus_Passim_2343", "series": "CAG", "text": "Εἰκὸς γὰρ ἐν μακρᾷ τινι νόσῳ γενόμενον ἢ ἐν ἄλλοις ἀσχοληθέντα πράγμασι δι᾿ ἀμελετησίαν ἀπολέσαι τὴν ἐπιστήμην.", "seq": 2343}
{"id": "Philoponus_Passim_2344", "series": "CAG", "text": "8b35 Διαθέσεις δὲ λέγονται ἅ ἐστιν εὐκίνητα καὶ ταχὺ μεταβάλλοντα, οἷον θερμότης καὶ κατάψυξις καὶ νόσος καὶ ὑγεία καὶ ὅσα ἄλλα τοιαῦτα.", "seq": 2344}
{"id": "Philoponus_Passim_2345", "series": "CAG", "text": "Λέγεται γὰρ διακεῖσθαί πως κατὰ ταῦτα ὁ ἄνθρωπος, οὐ μέντοι ἕξεις ἔχειν.", "seq": 2345}
{"id": "Philoponus_Passim_2346", "series": "CAG", "text": "9a1 Εἰ μή τις καὶ αὐτῶν τούτων τυγχάνοι διὰ χρόνου πλῆθος ἤδη πεφυσιωμένη καὶ ἀνίατος ἢ πάνυ δυσκίνητος οὖσα, ἣν ἄν τις ἴσως ἕξιν προσαγορεύσοι.", "seq": 2346}
{"id": "Philoponus_Passim_2347", "series": "CAG", "text": "Ἡ γὰρ τοιαύτη οὐκέτι διάθεσις ἀλλ᾿ ἕξις προσαγορεύεται.", "seq": 2347}
{"id": "Philoponus_Passim_2348", "series": "CAG", "text": "πεφυσιωμένη δέ φησι, τοῦτ᾿ ἔστιν εἰς φύσιν μεταβληθεῖσα καὶ αὐτὴ φύσις γενομένη διὰ τὸν συνεθισμὸν τοῦ πολλοῦ χρόνου.", "seq": 2348}
{"id": "Philoponus_Passim_2349", "series": "CAG", "text": "9a5 Τοὺς γὰρ τῶν ἐπιστημῶν μὴ πάνυ κατέχοντας οὔ φασιν ἕξιν ἔχειν.", "seq": 2349}
{"id": "Philoponus_Passim_2350", "series": "CAG", "text": "Τὸν μὲν γὰρ ἕτοιμον ὄντα ἐν ῥητορικῇ ἢ γραμματικῇ ἀποκρίνεσθαι, περὶ ὧν ἂν ἐρωτᾶται θεωρημάτων ῥητορικῆς ἢ γραμματικῆς, καὶ λόγον ὑπέχοντα τούτων καὶ τὰ ὑποπίπτοντα ἄπορα ἐξ ἑτοίμου ἐπιλυόμενον τοῦτόν φασιν ἕξιν ἔχειν ῥητορικῆς ἢ γραμματικῆς·", "seq": 2350}
{"id": "Philoponus_Passim_2351", "series": "CAG", "text": "ἐὰν δὲ ἄλλος τις πεποίωται κατὰ ταύτας μετρίως, οὗτος ἕξιν μὲν τούτων οὐ λέγεται ἔχειν, διακεῖσθαι δέ πως κατ᾿ αὐτάς.", "seq": 2351}
{"id": "Philoponus_Passim_2352", "series": "CAG", "text": "9a10 Εἰσὶ δὲ αἱ μὲν ἕξεις καὶ διαθέσεις, αἱ δὲ διαθέσεις οὐκ ἐξ ἀνάγκης ἕξεις.", "seq": 2352}
{"id": "Philoponus_Passim_2353", "series": "CAG", "text": "Ὥσπερ γὰρ τοῦ ὀνόματος καὶ τοῦ ῥήματος κατηγορεῖται τὸ ὄνομα καὶ τὸ μὲν ὄνομά ἐστι γένος ὀνόματος καὶ ῥήματος τὸ δὲ πρὸς τὸ ῥῆμα ἀντιδιαστελλόμενον, οὕτω καὶ τῆς ἕξεως καὶ τῆς διαθέσεως κατηγορεῖται ἡ διάθεσις καὶ ἡ μέν τίς ἐστι διάθεσις ὡς γένος κατηγορουμένη ἕξεως καὶ διαθέσεως ἡ δὲ ὡς εἶδος ἀντιδιαστελλομένη πρὸς τὴν ἕξιν.", "seq": 2353}
{"id": "Philoponus_Passim_2354", "series": "CAG", "text": "ὥστε ἡ μὲν ἕξις πάντως καὶ διάθεσις, ἐπειδὴ γένος αὐτῆς ἡ διάθεσις, ἡ δὲ διάθεσις οὐκέτι καὶ ἕξις·", "seq": 2354}
{"id": "Philoponus_Passim_2355", "series": "CAG", "text": "κατὰ ἀντιδιαστολὴν γὰρ αὐτῆς λέγεται ἡ ἕξις.", "seq": 2355}
{"id": "Philoponus_Passim_2356", "series": "CAG", "text": "9a14 Ἕτερον δὲ γένος ποιότητος καθ᾿ ὃ πυκτικοὺς ἢ δρομικοὺς ἢ ὑγιεινοὺς ἢ νοσώδεις λέγομεν.", "seq": 2356}
{"id": "Philoponus_Passim_2357", "series": "CAG", "text": "Τοῦτο δεύτερον εἶδος τῆς ποιότητος, τὸ κατὰ δύναμιν λέγω καὶ ἀδυναμίαν.", "seq": 2357}
{"id": "Philoponus_Passim_2358", "series": "CAG", "text": "διὰ τί δὲ γένος τῆς ποιότητος αὐτὸ προσηγόρευσεν;", "seq": 2358}
{"id": "Philoponus_Passim_2359", "series": "CAG", "text": "αὕτη γάρ ἐστι γένος γενικώτατον.", "seq": 2359}
{"id": "Philoponus_Passim_2360", "series": "CAG", "text": "φασὶν ὅτι ἀντὶ τοῦ εἰπεῖν εἶδος γένος εἶπεν, ἵνα μή τις ὑπολάβῃ τοῦτο εἶδος εἶναι εἰδικώτατον·", "seq": 2360}
{"id": "Philoponus_Passim_2361", "series": "CAG", "text": "ἀμέλει γοῦν οὐκ εἶπε γενικώτατον γένος, ἀλλὰ γένος, ἵνα σημάνῃ ὅτι ὑπάλληλόν ἐστι γένος, ὡς ἂν εἴποιμεν γένος εἶναι τῆς οὐσίας τὸ ζῷον ἀντὶ τοῦ ὑπὸ τὴν οὐσίαν.", "seq": 2361}
{"id": "Philoponus_Passim_2362", "series": "CAG", "text": "τὸ οὖν δεύτερον εἶδος, ὡς εἶπον, τῆς ποιότητος παραδίδωσι τὸ κατὰ δύναμιν καὶ ἀδυναμίαν, καθ᾿ ὃ πυκτικοὺς ἢ δρομικοὺς ἢ ὑγιεινοὺς ἢ νοσώδεις λέγομεν.", "seq": 2362}
{"id": "Philoponus_Passim_2363", "series": "CAG", "text": "λέγει δὲ πυκτικοὺς ἢ δρομικοὺς τοὺς φύσιν ἔχοντας ἐπιτηδείαν πρός τι τῶν τοιούτων, τοῦτ᾿ ἔστι τοὺς δυνάμει τοιούτους ὄντας.", "seq": 2363}
{"id": "Philoponus_Passim_2364", "series": "CAG", "text": "καὶ τὸ μὲν πρῶτον εἶδος τῆς ποιότητος ἐνεργείᾳ θεωρεῖται, ἡ ἕξις καὶ ἡ διάθεσις, τὸ δὲ δεύτερον δυνάμει·", "seq": 2364}
{"id": "Philoponus_Passim_2365", "series": "CAG", "text": "ἕτερον γάρ ἐστι πύκτης εἰπεῖν καὶ ἕτερον πυκτικός, καὶ δρομεὺς καὶ δρομικός·", "seq": 2365}
{"id": "Philoponus_Passim_2366", "series": "CAG", "text": "τὸ μὲν γάρ ἐστιν ἐνεργείᾳ, ὁ πύκτης καὶ ὁ δρομεύς, τὸ δὲ δυνάμει, ὁ πυκτικὸς καὶ ὁ δρομικός, ὁ μήπω μὲν ἐνεργείᾳ ὢν τοιοῦτος δύναμιν δὲ φυσικὴν ἔχων, τοῦτ᾿ ἔστιν ἐπιτηδειότητα εἰς τὸ γενέσθαι τοιοῦτος.", "seq": 2366}
{"id": "Philoponus_Passim_2367", "series": "CAG", "text": "ὁ δὲ ἐνεργείᾳ ὢν πύκτης ἢ δρομεὺς οὐκέτι κατὰ δύναμιν φυσικὴν λέγεται, ἀλλ᾿ ἕξιν ἔχει ἢ διάθεσιν.", "seq": 2367}
{"id": "Philoponus_Passim_2368", "series": "CAG", "text": "πῶς δὲ καὶ τὴν ἀδυναμίαν ποιότητά φησιν;", "seq": 2368}
{"id": "Philoponus_Passim_2369", "series": "CAG", "text": "ὅτι διακείμεθά πως καὶ κατὰ ταύτην·", "seq": 2369}
{"id": "Philoponus_Passim_2370", "series": "CAG", "text": "τῷ γὰρ τοιῶσδε τὸν ἵππον διακεῖσθαι ἀδυναμίαν αὐτόν φαμεν ἔχειν τοῦ δέξασθαι ἐπιστήμην.", "seq": 2370}
{"id": "Philoponus_Passim_2371", "series": "CAG", "text": "καὶ ὅλως ἐφ᾿ ὧν θεωρεῖται ἡ δύναμις, ἐπὶ τούτων καὶ ἡ ἀδυναμία·", "seq": 2371}
{"id": "Philoponus_Passim_2372", "series": "CAG", "text": "ὁ γὰρ δύναμιν ἔχων τοῦ πάσχειν οὗτος ἀδυναμίαν ἔχει τοῦ μὴ πάσχειν, καὶ ὁ δύναμιν ἔχων τοῦ μὴ παθεῖν ἀδυναμίαν ἔχει τοῦ παθεῖν.", "seq": 2372}
{"id": "Philoponus_Passim_2373", "series": "CAG", "text": "καὶ ἄλλως ἐπειδὴ τῶν ἀντικειμένων τὸ αὐτό ἐστι γένος, εἴτε οὖν ὡς ἐναντία ταῦτά τις βούλεται ἀντικεῖσθαι, ὑφ᾿ ὃ γένος τὸ ἕτερον τῶν ἐναντίων ἀνάγεται, ὑπ᾿ ἐκεῖνο καὶ τὸ ἕτερον ἀναχθήσεται, ἐπειδὴ καὶ τὸ λευκὸν καὶ τὸ μέλαν ἐναντία ὄντα ὑπὸ τὸ αὐτὸ γένος, τὴν ποιότητα, ἀνάγονται (εἰ τοίνυν ἡ δύναμις ὑπὸ τὸ ποιὸν ἀνάγεται, καὶ ἡ ἀδυναμία ὑπὸ τὸ αὐτὸ ἀναχθήσεται), εἴτε ὡς τὰ κατὰ στέρησιν καὶ ἕξιν ταῦτα ἀντικεῖσθαί τις βούλοιτο, καὶ οὕτως ὑπὸ τὸ αὐτὸ γένος αὐτὰ ἀνάξει·", "seq": 2373}
{"id": "Philoponus_Passim_2374", "series": "CAG", "text": "οὗ γὰρ λέγεται εἶναι ἡ ἕξις, τούτου καὶ ἡ στέρησις λεχθήσεται, οἷον ὀφθαλμοῦ·", "seq": 2374}
{"id": "Philoponus_Passim_2375", "series": "CAG", "text": "αὐτοῦ γάρ ἐστι καὶ ἡ ὄψις καὶ ἡ τύφλωσις.", "seq": 2375}
{"id": "Philoponus_Passim_2376", "series": "CAG", "text": "ὑφ᾿ ὃ οὖν γένος ἀνάγεται ἡ ἕξις, ὑπὸ τὸ αὐτὸ καὶ ἡ στέρησις ἀναχθήσεται.", "seq": 2376}
{"id": "Philoponus_Passim_2377", "series": "CAG", "text": "9α16 Οὐ γὰρ τῷ διακεῖσθαί πως ἕκαστον τῶν τοιούτων ποιὸν λέγεται.", "seq": 2377}
{"id": "Philoponus_Passim_2378", "series": "CAG", "text": "Ἀντὶ τοῦ τοῦ ‘οὐ τῷ εἶναι αὐτοὺς ἐνεργείᾳ τοιούτους λέγομεν, ἀλλὰ τῷ δύναμιν ἔχειν τοιαύτην’.", "seq": 2378}
{"id": "Philoponus_Passim_2379", "series": "CAG", "text": "λέγεται δὲ ἡ δύναμις τριχῶς·", "seq": 2379}
{"id": "Philoponus_Passim_2380", "series": "CAG", "text": "ἢ γὰρ πρὸς τὸ ποιῆσαί τις δύναμιν ἔχειν λέγεται ἢ πρὸς τὸ παθεῖν ἢ πρὸς τὸ μὴ παθεῖν, οἷον ὡς λέγομεν τὸν νοσώδη δύναμιν ἔχειν τοῦ πάσχειν ὑπὸ πολλοῦ περιπάτου ἢ ἡλιοκαΐας, τὸν δὲ ὑγιεινὸν δύναμιν ἔχειν τοῦ μὴ πάσχειν ὑπὸ τῶν τοιούτων, καὶ τὸν τέκτονα δύναμιν ἔχειν τοῦ ποιῆσαι θύραν.", "seq": 2380}
{"id": "Philoponus_Passim_2381", "series": "CAG", "text": "ὁσαχῶς δὲ ἡ δύναμις λέγεται, τοσαυταχῶς καὶ ἡ ἀδυναμία ῥηθήσεται·", "seq": 2381}
