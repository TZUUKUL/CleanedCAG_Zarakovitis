{"id": "Philoponus_Passim_3214", "series": "CAG", "text": "οὐδὲν γὰρ αὐτῶν ἕτερον ἑτέρου πρότερόν ἐστιν·", "seq": 3214}
{"id": "Philoponus_Passim_3215", "series": "CAG", "text": "ἔκ τε γὰρ τοῦ ἀνωτάτου γένους ἴσην καὶ τὴν αὐτὴν ἔχει ἀπόστασιν ἔκ τε τοῦ εἰδικωτάτου εἴδους ὁμοίως.", "seq": 3215}
{"id": "Philoponus_Passim_3216", "series": "CAG", "text": "ἐὰν δέ τις διέλῃ τὸ πτηνόν, εἰ τύχοι, εἰς ὄρνιθας καὶ ἀκρίδας, οὐκέτι ἡ ὄρνις καὶ τὸ πτηνὸν ἅμα λέγεται, ἀλλὰ πρότερον τὸ πτηνόν, διότι ἐκ τῆς διαιρέσεως τοῦ ζῴου εἴληπται, ἡ δὲ ὄρνις ἐκ τῆς τοῦ πτηνοῦ διαιρέσεως·", "seq": 3216}
{"id": "Philoponus_Passim_3217", "series": "CAG", "text": "ἀεὶ δὲ πρότερα τὰ γένη τῶν εἰδῶν, ἐπειδὴ μηδὲ ἀντιστρέφει κατὰ τὴν τοῦ εἶναι ἀκολούθησιν·", "seq": 3217}
{"id": "Philoponus_Passim_3218", "series": "CAG", "text": "τοῦ μὲν γὰρ εἴδους τεθέντος ἐξ ἀνάγκης ἀκολουθεῖ τὸ γένος, τῶν δὲ γενῶν τεθέντων οὐκ ἐξ ἀνάγκης ἀκολουθεῖ τὰ εἴδη.", "seq": 3218}
{"id": "Philoponus_Passim_3219", "series": "CAG", "text": "Περὶ κινήσεως.", "seq": 3219}
{"id": "Philoponus_Passim_3220", "series": "CAG", "text": "15a13 Κινήσεως δέ ἐστιν εἴδη ἕξ·", "seq": 3220}
{"id": "Philoponus_Passim_3221", "series": "CAG", "text": "γένεσις φθορὰ αὔξησις μείωσις ἀλλοίωσις ἡ κατὰ τόπον μεταβολή.", "seq": 3221}
{"id": "Philoponus_Passim_3222", "series": "CAG", "text": "Ὁ περὶ κινήσεως λόγος πρέπων μέν ἐστιν ἀνδρὶ φυσιολόγῳ·", "seq": 3222}
{"id": "Philoponus_Passim_3223", "series": "CAG", "text": "πάντα γὰρ τὰ φυσικὰ πράγματα ἐν κινήσει ἔχει τὸ εἶναι·", "seq": 3223}
{"id": "Philoponus_Passim_3224", "series": "CAG", "text": "καὶ γάρ ἐστιν ἡ φύσις, ὡς αὐτὸς ὡρίσατο, ἀρχὴ κινήσεως καὶ ἠρεμίας.", "seq": 3224}
{"id": "Philoponus_Passim_3225", "series": "CAG", "text": "διόπερ καὶ ἐν τῇ Φυσικῇ ἀκροάσει πολὺν περὶ αὐτῆς ἀποτείνει λόγον καὶ ἀκριβέστατον.", "seq": 3225}
{"id": "Philoponus_Passim_3226", "series": "CAG", "text": "ζητητέον δὲ τίνος ἕνεκεν ἐνταῦθα ταύτης ἐμνήσθη.", "seq": 3226}
{"id": "Philoponus_Passim_3227", "series": "CAG", "text": "τινὲς μὲν οὖν εἰρήκασιν ὅτι ἐπειδὴ τῶν κατηγοριῶν αἱ τοῦ ποιεῖν καὶ πάσχειν κινήσεις ἦσαν, οὐδὲν δὲ εἶπε περὶ αὐτῶν, διὰ ταύτην τὴν αἰτίαν ἐνταῦθα τὸν περὶ τῆς κινήσεως ποιεῖται λόγον·", "seq": 3227}
{"id": "Philoponus_Passim_3228", "series": "CAG", "text": "μήποτε γάρ, φασίν, ἡ μὲν κίνησίς ἐστι γένος, εἴδη δὲ τῆς κινήσεως ἄλλα τε πολλὰ καὶ τὸ ποιεῖν καὶ τὸ πάσχειν.", "seq": 3228}
{"id": "Philoponus_Passim_3229", "series": "CAG", "text": "τινὲς μὲν οὖν οὕτω περὶ τούτων διωρίσαντο.", "seq": 3229}
{"id": "Philoponus_Passim_3230", "series": "CAG", "text": "οὐκ ἀποδεκτέον δὲ τὸν τοιοῦτον λόγον·", "seq": 3230}
{"id": "Philoponus_Passim_3231", "series": "CAG", "text": "οὐ γὰρ προῄρηται ὁ φιλόσοφος περὶ τοῦ ποιεῖν καὶ πάσχειν πλέον τι τῶν ἐξ ἀρχῆς εἰρημένων εἰπεῖν.", "seq": 3231}
{"id": "Philoponus_Passim_3232", "series": "CAG", "text": "ἄλλως τε καί, ὡς ἐν ἀρχαῖς ἐλέγομεν, τὸ μὲν κινεῖν ὑπὸ τὸ ποιεῖν ἀνάγεται καὶ τὸ κινεῖσθαι ὑπὸ τὸ πάσχειν, αὕτη μέντοι ἡ κίνησις οὐκέτι·", "seq": 3232}
{"id": "Philoponus_Passim_3233", "series": "CAG", "text": "οὐ γάρ ἐστιν ἡ κίνησις ποιεῖν·", "seq": 3233}
{"id": "Philoponus_Passim_3234", "series": "CAG", "text": "ἐλέγομέν γε ὅτι αἱ κινήσεις οὐ κατηγορίαι εἰσὶν ἀλλ᾿ ὁδοὶ εἰς τὰς κατηγορίας.", "seq": 3234}
{"id": "Philoponus_Passim_3235", "series": "CAG", "text": "τί οὖν ἡμεῖς λέγομεν;", "seq": 3235}
{"id": "Philoponus_Passim_3236", "series": "CAG", "text": "ὅτι ὥσπερ τῶν προλαβουσῶν φωνῶν τὴν διδασκαλίαν ἐποιήσατο διὰ τὸ μεμνημονευκέναι αὐτῶν ἐν τῇ τῶν κατηγοριῶν διδασκαλίᾳ, οὕτω δὴ κἀπὶ τῆς κινήσεως ἐροῦμεν·", "seq": 3236}
{"id": "Philoponus_Passim_3237", "series": "CAG", "text": "ἐμνημόνευσε γὰρ τῆς κινήσεως ἐν τῷ περὶ τῆς οὐσίας λόγῳ·", "seq": 3237}
{"id": "Philoponus_Passim_3238", "series": "CAG", "text": "ἀποδεδωκὼς γὰρ τὸ τῆς οὐσίας ἴδιον τὸ ἓν καὶ ταὐτὸν τῷ ἀριθμῷ παρὰ μέρος τῶν ἐναντίων εἶναι δεκτικὸν καὶ πρὸς τοῦτο ἠπορηκὼς ὅτι μήποτε οὐκ ἔστι τοῦτο ἴδιον τῆς οὐσίας (οὐδὲ γὰρ αὐτῇ μόνῃ ὑπάρχει, ἀλλὰ καὶ τῷ λόγῳ καὶ τῇ δόξῃ·", "seq": 3238}
{"id": "Philoponus_Passim_3239", "series": "CAG", "text": "καὶ ταῦτα γὰρ ἓν καὶ ταὐτὸν μένοντα τῷ ἀριθμῷ παρὰ μέρος τῶν ἐναντίων ἐστὶ δεκτικά, ἀληθείας λέγω καὶ ψεύδους), ἐπήγαγεν ἐπιλυόμενος τὴν ἀπορίαν ὅτι οὐ κατὰ ταὐτὸν τῇ οὐσίᾳ ταῦτα τῶν ἐναντίων ἐστὶ δεκτικά·", "seq": 3239}
{"id": "Philoponus_Passim_3240", "series": "CAG", "text": "ἡ μὲν γὰρ οὐσία αὐτὴ κινουμένη τῶν ἐναντίων γίνεται δεκτική, ἐκεῖνα δὲ οὐκ αὐτὰ κινούμενα ἀλλ᾿ ἑτέρων κινουμένων ἐπιδέχονται ἀλήθειαν καὶ ψεῦδος.", "seq": 3240}
{"id": "Philoponus_Passim_3241", "series": "CAG", "text": "διὰ τοῦτο τοίνυν ἐπειδὴ ἐμνήσθη ἐκεῖσε τῆς κινήσεως, ἀναγκαῖον ἐνόμισεν ἐκδιδάξαι ἡμᾶς περὶ αὐτῆς.", "seq": 3241}
{"id": "Philoponus_Passim_3242", "series": "CAG", "text": "ὡς μὲν οὖν φθάσας εἶπον, φυσικῷ ἀνδρὶ ὁ περὶ τῆς κινήσεως πρεπώδης ἐστὶ λόγος καὶ αὐτὸς γοῦν τῶν ὀκτὼ τῆς Φυσικῆς ἀκροάσεως λόγων τοὺς ὑστέρους τέσσαρας εἰς τὸν περὶ κινήσεως κατηνάλωσε λόγον·", "seq": 3242}
{"id": "Philoponus_Passim_3243", "series": "CAG", "text": "ἐνταῦθα δὲ τοσοῦτον περὶ αὐτῆς διαλέγεται, ὅσον λογικῷ ἀνδρὶ πρέπει ζητεῖν, εἰς πόσα εἴδη διαιρεῖται ἡ κίνησις καὶ τίνα ἐστὶν αὐτῆς τὰ εἴδη καὶ τίνα τίσιν ἕπονται ἢ οὔ.", "seq": 3243}
{"id": "Philoponus_Passim_3244", "series": "CAG", "text": "15a33 Κινήσεως δέ ἐστιν εἴδη ἕξ·", "seq": 3244}
{"id": "Philoponus_Passim_3245", "series": "CAG", "text": "γένεσις φθορὰ αὔξησις μείωσις ἀλλοίωσις ἡ κατὰ τόπον μεταβολή.", "seq": 3245}
{"id": "Philoponus_Passim_3246", "series": "CAG", "text": "Ἐν τῷ τῆς κινήσεως λόγῳ τρία ταῦτα ζητοῦνται·", "seq": 3246}
{"id": "Philoponus_Passim_3247", "series": "CAG", "text": "πόσα τὰ εἴδη τῆς κινήσεώς εἰσι καὶ τίνι διακρίνονται ἀλλήλων καὶ τρίτον ἐπὶ τούτοις ποίῳ εἴδει κινήσεως ποῖον ἀντίκειται.", "seq": 3247}
{"id": "Philoponus_Passim_3248", "series": "CAG", "text": "πόσα μὲν οὖν εἴδη κινήσεως, αὐτὸς φθάσας ἀπηριθμήσατο ἓξ εἶναι λέγων.", "seq": 3248}
{"id": "Philoponus_Passim_3249", "series": "CAG", "text": "ἀλλ᾿ ἵνα καὶ ἐπιστημονικῶς τοῦτο γινώσκωμεν ἡμεῖς διὰ τί ἕξ εἰσι τὰ εἴδη τῆς κινήσεως καὶ οὔτε πλείονα οὔτε ἐλάττονα, ἐκ διαιρέσεως παραγάγωμεν τὸν λόγον.", "seq": 3249}
{"id": "Philoponus_Passim_3250", "series": "CAG", "text": "λέγομεν οὖν ὅτι τρία τινά ἐστι περὶ τὴν ἡμετέραν φύσιν θεωρούμενα, αὐτὴ ἡ οὐσία τὰ ἐν τῇ οὐσίᾳ τὰ περὶ τὴν οὐσίαν·", "seq": 3250}
{"id": "Philoponus_Passim_3251", "series": "CAG", "text": "τὰ μὲν ἐν αὐτῇ, ὡς εἰς μεγάλα μέρη διελεῖν, εἰσὶ τὸ ποσὸν καὶ τὸ ποιόν (εἰς μεγάλα δὲ εἴπομεν, ὅτι εἰ καὶ ἄλλαι κατηγορίαι εἰσὶν ἐν τῇ οὐσίᾳ, ἀλλ᾿ οὖν ἐκ τούτων ἔχουσι τὴν γενέσιν, ὡς φθάσαντες εἴπομεν), περὶ τὴν οὐσίαν δέ ἐστιν ὁ τόπος [καὶ ὁ χρόνος].", "seq": 3251}
{"id": "Philoponus_Passim_3252", "series": "CAG", "text": "τριῶν οὖν τούτων ὄντων τῆς μὲν οὐσίας κίνησίς ἐστιν ἡ γένεσις καὶ φθορά, τῆς δὲ ποιότητος ἀλλοίωσις, τῆς δὲ ποσότητος αὔξησις καὶ μείωσις, τοῦ δὲ τόπου ἡ κατὰ τόπον μεταβολή, ἥτις καλεῖται φορά.", "seq": 3252}
{"id": "Philoponus_Passim_3253", "series": "CAG", "text": "τῆς δὲ φορᾶς ἡ μὲν καλεῖται εὐθυφορία, ἡ ἄνω καὶ κάτω, ἡ δὲ περιφορά, ἡ ἐπὶ τὸ πέριξ ὡς ἡ τοῦ οὐρανοῦ.", "seq": 3253}
{"id": "Philoponus_Passim_3254", "series": "CAG", "text": "ἐνταῦθα μὲν οὖν ταῦτα τὰ ἕξ φησιν εἴδη τῆς κινήσεως εἶναι, τὴν φορὰν οὐ διαιρῶν εἰς εὐθυφορίαν καὶ κυκλοφορίαν, ἐν δὲ τῇ Φυσικῇ ἀκροάσει τὴν μεταβολὴν γένος εἶναι βούλεται καὶ ταύτης εἶναι εἴδη τρία, κίνησιν γένεσιν φθοράν·", "seq": 3254}
{"id": "Philoponus_Passim_3255", "series": "CAG", "text": "ἀντιδιαιρεῖ γὰρ ἐκεῖ τῇ γενέσει καὶ τῇ φθορᾷ τὴν κίνησιν·", "seq": 3255}
{"id": "Philoponus_Passim_3256", "series": "CAG", "text": "οὐ γὰρ βούλεται ἐν ἐκείνοις τὴν γένεσιν μενόντων τινῶν καὶ εἰδοπεποιημένων εἶναι μεταβολὴν κατά τι τῶν περὶ αὐτὰ συμβεβηκότων.", "seq": 3256}
{"id": "Philoponus_Passim_3257", "series": "CAG", "text": "διό φησι τὰ κινούμενα κινεῖσθαι ἢ κατὰ ποσὸν ἢ κατὰ ποιὸν ἢ κατὰ τόπον φυλάττοντα τὸ ἐξ ἀρχῆς οὐσιῶδες εἶδος.", "seq": 3257}
{"id": "Philoponus_Passim_3258", "series": "CAG", "text": "ἐπὶ δὲ τῆς γενέσεως καὶ τῆς φθορᾶς οὐ μένει τὸ ἐξ ἀρχῆς εἶδος ἐν τῷ μεταβάλλοντι, διότι ἡ μὲν γένεσις ὁδός ἐστιν ἀπὸ τοῦ πῆ μὴ ὄντος εἰς τὸ πῆ ὄν, τοῦτ᾿ ἔστιν ἀπὸ τοῦ δυνάμει ὄντος εἰς τὸ ἐνεργείᾳ ὄν, ἡ δὲ φθορὰ ὁδός ἐστι πάλιν ἀπὸ τοῦ ὄντος εἰς τὸ μὴ ὄν.", "seq": 3258}
{"id": "Philoponus_Passim_3259", "series": "CAG", "text": "ἐνταῦθα μέντοι ἐπειδὴ εἰσαγωγικόν ἐστι τὸ βιβλίον καὶ λογικὸν μᾶλλον, οὐ φυσικόν, οὐκ ἀκριβολογεῖται περὶ τούτων, ἀλλὰ καὶ τὴν γένεσιν καὶ τὴν φθορὰν κινήσεις εἶναι λέγει·", "seq": 3259}
{"id": "Philoponus_Passim_3260", "series": "CAG", "text": "οὐ γὰρ ὡς φυσικὸς ἐνταῦθα διαλέγεται, ἀλλ᾿ ὡς λογικός, ζητῶν ἐν τούτοις τίνα τίσιν ἕπεται ἢ οὐχ ἕπεται.", "seq": 3260}
{"id": "Philoponus_Passim_3261", "series": "CAG", "text": "15a15 Αἱ μὲν οὖν ἄλλαι κινήσεις φανερὸν ὅτι ἕτεραι ἀλλήλων εἰσίν·", "seq": 3261}
{"id": "Philoponus_Passim_3262", "series": "CAG", "text": "οὐ γάρ ἐστιν ἡ γένεσις φθορὰ οὐδέ γε ἡ αὔξησις μείωσις οὐδὲ ἡ κατὰ τόπον μεταβολή, ὡσαύτως δὲ καὶ αἱ ἄλλαι.", "seq": 3262}
{"id": "Philoponus_Passim_3263", "series": "CAG", "text": "Ἀπαριθμησάμενος τὰ εἴδη τῆς κινήσεως ἐντεῦθεν λοιπὸν διακρίνει ταῦτα ἀλλήλων καὶ δείκνυσι πῶς οὔκ εἰσι τὰ αὐτά·", "seq": 3263}
{"id": "Philoponus_Passim_3264", "series": "CAG", "text": "οὔτε γὰρ ἡ γένεσις, φησί, φθορά ἐστιν οὔτε ἡ αὔξησις μείωσις (πῶς γάρ, ὁπότε καὶ ἐναντία ἐστίν;)", "seq": 3264}
{"id": "Philoponus_Passim_3265", "series": "CAG", "text": ", ἀλλ᾿ οὐδὲ μὴν ἡ αὔξησις γένεσις (αὔξεται μὲν γὰρ τὸ ὄν, γίνεται δὲ τὸ μὴ ὄν), ἀλλ᾿ οὔτε μὴν ἡ μείωσις φθορά·", "seq": 3265}
{"id": "Philoponus_Passim_3266", "series": "CAG", "text": "καὶ ἐπὶ τούτων γὰρ ὁ αὐτὸς λόγος·", "seq": 3266}
{"id": "Philoponus_Passim_3267", "series": "CAG", "text": "ἡ μὲν γὰρ μείωσις ὕφεσίν τινα κατὰ ποσὸν τοῦ ὄντος σημαίνει, ἡ δὲ φθορὰ παντελῆ τοῦ ὄντος ἀφανισμόν.", "seq": 3267}
{"id": "Philoponus_Passim_3268", "series": "CAG", "text": "οὔτε δὲ πάλιν ἡ κατὰ τόπον μεταβολὴ ἑνὶ τῶν εἰρημένων συμβαίνει·", "seq": 3268}
{"id": "Philoponus_Passim_3269", "series": "CAG", "text": "τὸ γὰρ ἐκ τόπου εἰς τόπον μεταβάλλον οὔτε γίνεται οὔτε φθείρεται οὔτε αὔξεται οὔτε μειοῦται·", "seq": 3269}
{"id": "Philoponus_Passim_3270", "series": "CAG", "text": "οὐδὲ γὰρ εἰ ἐξ Ἀθηνῶν τυχὸν ἐπὶ Κόρινθον μεταβαίνοι Σωκράτης, ἕν τι τῶν εἰρημένων πείσεται, ἀλλ᾿ ὁ αὐτὸς μένων κατὰ πάντα μεταβάλλει κατὰ μόνον τὸν τόπον.", "seq": 3270}
{"id": "Philoponus_Passim_3271", "series": "CAG", "text": "15a18 Ἐπὶ δὲ τῆς ἀλλοιώσεως ἔχει τινὰ ἀπορίαν, μήποτε ἀναγκαῖον ᾖ τὸ ἀλλοιούμενον κατά τινα τῶν λοιπῶν κινήσεων ἀλλοιοῦσθαι.", "seq": 3271}
{"id": "Philoponus_Passim_3272", "series": "CAG", "text": "Ὅτι μέν, φησίν, αἱ ἄλλαι πᾶσαι κινήσεις οὐκ εἰσὶν ἀλλήλαις αἱ αὐταί, οὐδεὶς διημφισβήτηκεν·", "seq": 3272}
{"id": "Philoponus_Passim_3273", "series": "CAG", "text": "ἐπὶ δὲ τῆς ἀλλοιώσεως ἀπορητέον, μήποτε τὸ ἀλλοιούμενον ἀνάγκη ἤτοι κατὰ γένεσιν ἀλλοιοῦσθαι ἢ κατὰ φθορὰν ἢ αὔξησιν ἢ μείωσιν ἤ τινα τῶν λοιπῶν.", "seq": 3273}
{"id": "Philoponus_Passim_3274", "series": "CAG", "text": "ἀλλὰ τοῦτο, φησίν, οὐκ ἔστιν ἀληθές·", "seq": 3274}
{"id": "Philoponus_Passim_3275", "series": "CAG", "text": "ἐπὶ γὰρ τῶν πλείστων παθῶν, θερμάνσεώς φησι καὶ ψύξεως καὶ τῶν ὁμοίων, ἀλλοιούμεθα μὲν πάντως, οὐ μήν τινα τῶν λοιπῶν κινήσεων ὑπομένομεν·", "seq": 3275}
{"id": "Philoponus_Passim_3276", "series": "CAG", "text": "οὔτε γὰρ αὔξεσθαι δεῖ τὸ θερμαινόμενον ἢ ψυχόμενον ἢ μειοῦσθαι ἢ γίνεσθαι ἢ φθείρεσθαι ἤ τι τῶν λοιπῶν ὑπομένειν.", "seq": 3276}
{"id": "Philoponus_Passim_3277", "series": "CAG", "text": "ὥστε κεχώρισται τῶν ἄλλων κινήσεων ἡ ἀλλοίωσις.", "seq": 3277}
{"id": "Philoponus_Passim_3278", "series": "CAG", "text": "15a25 Εἰ γὰρ ἦν ἡ αὐτή, ἔδει τὸ ἀλλοιούμενον εὐθὺς καὶ αὔξεσθαι ἢ μειοῦσθαι ἤ τινα τῶν ἄλλων ἀκολουθεῖν κινήσεων.", "seq": 3278}
{"id": "Philoponus_Passim_3279", "series": "CAG", "text": "Εἰ ταὐτὸν ἦν, φησίν, ἡ ἀλλοίωσις μιᾷ τῶν ἄλλων κινήσεων, ἔδει πάντως τὸ ἀλλοιούμενον καί τινα τῶν λοιπῶν ὑπομένειν κινήσεων.", "seq": 3279}
{"id": "Philoponus_Passim_3280", "series": "CAG", "text": "νῦν δὲ τοῦτο οὐ συμβαίνει·", "seq": 3280}
{"id": "Philoponus_Passim_3281", "series": "CAG", "text": "ἀλλοιοῦται μὲν γὰρ τὰ σώματα διατρίψαντα ἐν ἡλίῳ, θερμαινόμενά τε καὶ μελαινόμενα, οὐ μὴν τούτου γε ἕνεκεν αὔξεται ἢ μειοῦται ἤ τι τῶν λοιπῶν ὑπομένει.", "seq": 3281}
{"id": "Philoponus_Passim_3282", "series": "CAG", "text": "τὰ αὐτὰ δὲ ἔστιν εἰπεῖν καὶ περὶ τῶν ὑπὸ ψύχους ἀλλοιουμένων ἢ ὁπωσοῦν ἄλλως.", "seq": 3282}
{"id": "Philoponus_Passim_3283", "series": "CAG", "text": "15a28 Ὡσαύτως δὲ καὶ τὸ αὐξανόμενον ἤ τινα ἄλλην κίνησιν κινούμενον ἀλλοιοῦσθαι.", "seq": 3283}
{"id": "Philoponus_Passim_3284", "series": "CAG", "text": "Ἀνάπαλιν κατασκευάζει τὸν λόγον·", "seq": 3284}
{"id": "Philoponus_Passim_3285", "series": "CAG", "text": "οὐ μόνον γάρ, φησίν, εἴ γε ἦν ταὐτὸν ἀλλοίωσις ταῖς ἄλλαις κινήσεσιν, ἔδει τὸ ἀλλοιούμενον εὐθὺς καὶ κατὰ μίαν τῶν ἄλλων κινεῖσθαι κινήσεων, ἀλλὰ καὶ ἀνάπαλιν εἴ τι κινηθείη κατὰ αὔξησιν ἢ μείωσιν ἤ τινα τῶν λοιπῶν, τοῦτο εὐθὺς καὶ ἀλλοιοῦσθαι, εἰ καὶ τὰ μάλιστα προϋπάρχει τῶν λοιπῶν κινήσεων ἡ ἀλλοίωσις ἤτοι παρακολουθεῖ αὐταῖς·", "seq": 3285}
