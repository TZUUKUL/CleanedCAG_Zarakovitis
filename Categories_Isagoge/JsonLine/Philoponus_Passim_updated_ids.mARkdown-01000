{"id": "Philoponus_Passim_1847", "series": "CAG", "text": "καὶ ἡμεῖς δὲ στρέφεσθαι λεγόμεθα, ὅταν ἐξ οὗ ἠρξάμεθα τόπου εἰς ἐκεῖνον καταλήξωμεν.", "seq": 1847}
{"id": "Philoponus_Passim_1848", "series": "CAG", "text": "ἀντιστροφὴ δέ ἐστιν οἱονεὶ ἰσοστροφή·", "seq": 1848}
{"id": "Philoponus_Passim_1849", "series": "CAG", "text": "τὸ γὰρ ἀντὶ παρὰ τοῖς παλαιοῖς τὸ ἴσον σημαίνει, ὥσπερ τὸ ἀντίθεον ἀντὶ τοῦ ἰσόθεον καὶ ἀντιάνειρα ἡ ἰσουμένη ἀνδράσι, καὶ ἀντίχειρα δὲ τὸν μέγαν φαμὲν δάκτυλον διὰ τὸ ἴσην ἔχειν δύναμιν τοῖς ἄλλοις.", "seq": 1849}
{"id": "Philoponus_Passim_1850", "series": "CAG", "text": "ἰσοστροφὴ δέ ἐστιν ὅταν μηδὲν μᾶλλον τὸ ἕτερον τοῦ ἑτέρου κατηγορῆται ἢ ἐκεῖνο τοῦ λοιποῦ, οἷον ὁ πατὴρ οὐδὲν μᾶλλον πρὸς υἱὸν λέγεται ἢ ὁ υἱὸς πρὸς τὸν πατέρα.", "seq": 1850}
{"id": "Philoponus_Passim_1851", "series": "CAG", "text": "τὰ οὖν πρός τι πρὸς ἀντιστρέφοντα λέγεται, οἷον ὁ δοῦλος δεσπότου δοῦλος καὶ ὁ δεσπότης δούλου δεσπότης.", "seq": 1851}
{"id": "Philoponus_Passim_1852", "series": "CAG", "text": "6b33 Πλὴν τῇ πτώσει ἐνίοτε διοίσει κατὰ τὴν λέξιν.", "seq": 1852}
{"id": "Philoponus_Passim_1853", "series": "CAG", "text": "Ἐπειδὴ γὰρ πρὸς γενικὴν ἀποδέδωκε, διὰ τοῦτο ἐπήγαγεν ὅτι οὐ μόνον πρὸς γενικὴν ἀλλὰ καὶ πρὸς ἄλλην ἀποδίδοται πτῶσιν τὰ πρός τι, ὅθεν οὐδὲ πρὸς τὴν αὐτὴν πάντως ἀντιστρέφει.", "seq": 1853}
{"id": "Philoponus_Passim_1854", "series": "CAG", "text": "εἴρηται δὲ ἡμῖν ἤδη περὶ τούτων ἔμπροσθεν.", "seq": 1854}
{"id": "Philoponus_Passim_1855", "series": "CAG", "text": "6b36 Οὐ μὴν ἀλλ᾿ ἐνίοτε οὐ δόξει ἀντιστρέφειν, ἐὰν μὴ οἰκείως πρὸς ὃ λέγεται ἀποδοθῇ, ἀλλὰ διαμάρτῃ ὁ ἀποδιδούς.", "seq": 1855}
{"id": "Philoponus_Passim_1856", "series": "CAG", "text": "Τὰ πρός τι ἰσότητα τηρεῖν ὀφείλει πρὸς ἄλληλα, ἵνα καὶ ἀντιστρέφῃ, ὥσπερ ἀντιστρέφει ὁ ἄνθρωπος καὶ τὸ γελαστικόν.", "seq": 1856}
{"id": "Philoponus_Passim_1857", "series": "CAG", "text": "ἐὰν δὲ ὦσιν ἄνισα, τῷ μὲν ἐλάσσονι τὸ πλεῖον ἀκολουθεῖ ὡς τῷ ἀνθρώπῳ τὸ ζῷον, τῷ δὲ πλείονι τὸ ἔλασσον οὐκέτι·", "seq": 1857}
{"id": "Philoponus_Passim_1858", "series": "CAG", "text": "οὐ γὰρ τῷ ζῴῳ ὁ ἄνθρωπος ἀκολουθεῖ.", "seq": 1858}
{"id": "Philoponus_Passim_1859", "series": "CAG", "text": "οὗτος οὖν ὁ κανών ἐστι τῶν πρός τι, ἡ ἰσότης, ὡς πατὴρ υἱοῦ καὶ διπλάσιον ἡμίσεος, ἅπερ καὶ ἀντιστρέφει.", "seq": 1859}
{"id": "Philoponus_Passim_1860", "series": "CAG", "text": "ἐὰν δὲ ἄνισα ὦσιν, οὐκέτι ἀντιστρέφει, ὃ καὶ αὐτός φησι·", "seq": 1860}
{"id": "Philoponus_Passim_1861", "series": "CAG", "text": "τὸ πτερὸν ἐὰν ἀποδοθῇ ὄρνιθος, οὐκ ἀντιστρέφει ὄρνις πτεροῦ·", "seq": 1861}
{"id": "Philoponus_Passim_1862", "series": "CAG", "text": "οὐ γὰρ πᾶν πτερὸν ὄρνιθός ἐστι πτερόν·", "seq": 1862}
{"id": "Philoponus_Passim_1863", "series": "CAG", "text": "εἰσὶ γάρ τινα πτηνὰ ἃ οὔκ εἰσιν ὄρνιθες·", "seq": 1863}
{"id": "Philoponus_Passim_1864", "series": "CAG", "text": "τῶν γὰρ πτηνῶν τὰ μέν εἰσι σχιζόπτερα ὡς τὰ παρ᾿ ἡμῖν, ἃ καὶ μόνα ὄρνιθες καλοῦνται, ὡς καὶ αὐτὸς ἔφησεν ἐν τῇ Περὶ ζῴων ἱστορίᾳ τὰ σχιζόπτερα ὄρνις καλεῖσθαι, τὰ δέ ἐστιν ὑμενόπτερα, ὡς αἱ νυκτερίδες, τὰ δὲ κολεόπτερα ὡς οἱ κάνθαροι, ἅπερ οὔκ εἰσιν ὄρνιθες.", "seq": 1864}
{"id": "Philoponus_Passim_1865", "series": "CAG", "text": "ἐπεὶ οὖν τὸ πτερὸν καὶ ἡ ὄρνις οὐκ ἐξισάζει, ἀλλ᾿ ἐπὶ πλέον τὸ πτερὸν τῆς ὄρνιθος, δεῖ ταῦτα ἐξισῶσαι, ἵνα καὶ ἀντιστρέφῃ.", "seq": 1865}
{"id": "Philoponus_Passim_1866", "series": "CAG", "text": "ἐξισοῦται δὲ τὰ ἄνισα ἢ τοῦ ἐλάττονος αὐξηθέντος ἢ τοῦ μείζονος μειωθέντος.", "seq": 1866}
{"id": "Philoponus_Passim_1867", "series": "CAG", "text": "ἐὰν οὖν ἐπὶ τούτων αὐξήσωμεν τὸ ἔλαττον, τοῦτ᾿ ἔστι τὴν ὄρνιν, καὶ ποιήσωμεν οὕτως τὸ πτερὸν πτερωτοῦ πτερόν, πτερωτὸν τὴν ὄρνιν προσαγορεύοντες, οὕτως ἀντιστρέφει·", "seq": 1867}
{"id": "Philoponus_Passim_1868", "series": "CAG", "text": "τὸ γὰρ πτερωτὸν πτερῷ πτερωτόν.", "seq": 1868}
{"id": "Philoponus_Passim_1869", "series": "CAG", "text": "πάλιν ἐὰν ἀποδοθῇ τὸ πηδάλιον πλοίου πηδάλιον, ἐνταῦθα οὐκ ἀντιστρέφει·", "seq": 1869}
{"id": "Philoponus_Passim_1870", "series": "CAG", "text": "οὐ γὰρ δυνατὸν λέγειν τὸ πλοῖον πηδαλίῳ πλοῖον·", "seq": 1870}
{"id": "Philoponus_Passim_1871", "series": "CAG", "text": "πολλὰ γὰρ πλοῖα πηδάλια οὐκ ἔχει ὡς τὰ ἀκάτια.", "seq": 1871}
{"id": "Philoponus_Passim_1872", "series": "CAG", "text": "ἐπειδὴ οὖν ἄνισά ἐστι καὶ ταῦτα (ἐπὶ πλεῖον γὰρ τὸ πλοῖον ἢ τὸ πηδάλιον), ἐὰν τὸ μεῖζον ἐλαττώσωμεν, λέγω δὴ τὸ πλοῖον, λέγοντες ἀντὶ πλοίου πηδαλιωτόν, τότε ἐξ ἴσης γενόμενα ἀντιστρέφει·", "seq": 1872}
{"id": "Philoponus_Passim_1873", "series": "CAG", "text": "τό τε γὰρ πηδάλιον πηδαλιωτοῦ πηδάλιον καὶ τὸ πηδαλιωτὸν πηδαλίῳ πηδαλιωτόν ἐστιν.", "seq": 1873}
{"id": "Philoponus_Passim_1874", "series": "CAG", "text": "ἔτι δὲ καὶ ἡ κεφαλὴ τινὸς λέγεται κεφαλή (ζῴου γάρ)·", "seq": 1874}
{"id": "Philoponus_Passim_1875", "series": "CAG", "text": "ἐὰν δὲ ἀποδοθῇ πρὸς τὸ ζῷον, οὐκ ἀντιστρέφει, ἐπειδὴ μὴ οἰκεία πάλιν γίνεται ἡ ἀπόδοσις·", "seq": 1875}
{"id": "Philoponus_Passim_1876", "series": "CAG", "text": "ἡ μὲν γὰρ κεφαλὴ ζῴου λέγεται κεφαλή, οὐκέτι δὲ τὸ ζῷον τῇ κεφαλῇ ζῷον·", "seq": 1876}
{"id": "Philoponus_Passim_1877", "series": "CAG", "text": "ἔστι γάρ τινα τῶν ζῴων ἃ κεφαλὴν οὐκ ἔχει, οἷον καρκῖνος, σκώληκες, γῆς ἔντερα.", "seq": 1877}
{"id": "Philoponus_Passim_1878", "series": "CAG", "text": "δεῖ οὖν πάλιν μειῶσαι τὸ μεῖζον, λέγω δὴ τὸ ζῷον, καὶ ποιῆσαι κεφαλωτόν, καὶ οὕτως σωθήσεται ἡ ἀντιστροφή·", "seq": 1878}
{"id": "Philoponus_Passim_1879", "series": "CAG", "text": "ἡ γὰρ κεφαλὴ κεφαλωτοῦ κεφαλή, καὶ τὸ κεφαλωτὸν τῇ κεφαλῇ κεφαλωτόν.", "seq": 1879}
{"id": "Philoponus_Passim_1880", "series": "CAG", "text": "ἐπὶ μὲν οὖν τῆς ὄρνιθος τὸ ἔλαττον ηὐξήσαμεν, λέγω δὴ τὴν ὄρνιν, ἐν δὲ τοῖς ἄλλοις τὸ μεῖζον ἐμειώσαμεν, τὸ πλοῖον λέγω καὶ τὸ ζῷον.", "seq": 1880}
{"id": "Philoponus_Passim_1881", "series": "CAG", "text": "7a5 Ἐνίοτε δὲ καὶ ὀνοματοποιεῖν ἴσως ἀναγκαῖον, ἐὰν μὴ κείμενον ᾖ ὄνομα, πρὸς ὃ οἰκείως ἂν ἀποδοθείη.", "seq": 1881}
{"id": "Philoponus_Passim_1882", "series": "CAG", "text": "Ἵνα γὰρ μή τις εἴπῃ ‘τί οὖν;", "seq": 1882}
{"id": "Philoponus_Passim_1883", "series": "CAG", "text": "εἰ καινοτομεῖ τὰ ὀνόματα καὶ ἕκαστον ὡς βούλεταί τις μετασκευάζει, οὔκουν οὕτως συμβήσεται πᾶσαν τὴν συνήθειαν τῶν ὀνομάτων ἀφανισθῆναι, ἑκάστου καινοτομοῦντος ὡς βούλεται τὰ ὀνόματα, καὶ λοιπὸν δόξει ἕκαστος ἄσημα φθέγγεσθαι, ἀντὶ μὲν ἀνθρώπου, εἰ τύχοι, κεφαλωτὸν λέγων ἀντὶ δὲ πλοίου πηδαλιωτόν, ἢ ὁπωσοῦν ἄλλως τις καινοτομήσει;’", "seq": 1883}
{"id": "Philoponus_Passim_1884", "series": "CAG", "text": "·", "seq": 1884}
{"id": "Philoponus_Passim_1885", "series": "CAG", "text": "λέγει οὖν πρὸς τοῦτο ὅτι οὐδὲν χαλεπὸν οἷς μὴ ἐφρόντισε θεῖναι ὀνόματα ἡ συνήθεια, ἐκείνοις ἡμᾶς αὐτοὺς ἐπινοεῖν·", "seq": 1885}
{"id": "Philoponus_Passim_1886", "series": "CAG", "text": "ἡ γὰρ συνήθεια ἐκείνοις τίθησιν ὀνόματα οἷς γινώσκει, αἱ δὲ τέχναι ἅτε δὴ καινοτέρων πραγμάτων οὖσαι εὑρέτιδες ὀφείλουσι τοῖς πράγμασι τοῖς ὑπ᾿ αὐτῶν εὑρισκομένοις τιθέναι ὀνόματα πρὸς τὴν τούτων σημασίαν·", "seq": 1886}
{"id": "Philoponus_Passim_1887", "series": "CAG", "text": "οἷον ὁ γεωμέτρης εὑρὼν ὅτι τῶν τριγώνων τὸ μέν ἐστιν ἔχον τὰς δύο πλευρὰς ἴσας τὸ δὲ τὰς τρεῖς ἴσας τὸ δὲ τὰς τρεῖς ἀνίσους, ἐκάλεσε τὸ μὲν ἰσόπλευρον τὸ δὲ ἰσοσκελὲς τὸ δὲ σκαληνόν, καὶ ὁ μουσικὸς ὁμοίως τοῖς διαφόροις κρούμασιν ἐπέθηκε ὀνόματα καὶ τὸ μὲν ἐκάλεσε χρωματικὸν τὸ δὲ διατονικὸν ἢ ὁπωσοῦν ἑτέρως.", "seq": 1887}
{"id": "Philoponus_Passim_1888", "series": "CAG", "text": "κἀνταῦθα τοίνυν ἐπειδὴ ἠμέλησεν ἡ συνήθεια τοῖς τοιούτοις θεῖναι ὀνόματα, ἡμᾶς ἀνάγκη τιθέναι·", "seq": 1888}
{"id": "Philoponus_Passim_1889", "series": "CAG", "text": "πλοῖον μὲν γὰρ ἐκάλεσεν, οὐκέτι δὲ διέστειλε τὰ πηδαλιωτὰ ἀπὸ τῶν μὴ πηδαλιωτῶν, καὶ ζῷον μὲν ὠνόμασεν, οὐκέτι δὲ διεχώρισε τῇ προσηγορίᾳ τὰ ἔχοντα κεφαλὴν ἀπὸ τῶν μὴ ἐχόντων.", "seq": 1889}
{"id": "Philoponus_Passim_1890", "series": "CAG", "text": "διὰ τοῦτο, ὡς εἴρηται, ἡμᾶς ὀνοματοποιεῖν ἐν τοῖς τοιούτοις οὐδὲν ἄτοπον.", "seq": 1890}
{"id": "Philoponus_Passim_1891", "series": "CAG", "text": "ὅπως δὲ δεῖ τίθεσθαι τὰ ὀνόματα καὶ πόθεν, αὐτὸς ἐφεξῆς ἐδήλωσεν εἰπών·", "seq": 1891}
{"id": "Philoponus_Passim_1892", "series": "CAG", "text": "7a18 Οὕτως δὲ ῥᾷστα ἂν ἴσως τις λάβοι οἷς μὴ κεῖται ὀνόματα, εἰ ἀπὸ τῶν πρώτων καὶ τοῖς πρὸς ἃ ἀντιστρέφουσι τιθείη τὰ ὀνόματα.", "seq": 1892}
{"id": "Philoponus_Passim_1893", "series": "CAG", "text": "Κανόνα ἡμῖν νῦν παραδίδωσι, δι᾿ οὗ δυνησόμεθα ὀνοματοποιεῖν οἰκείως, ἐὰν ἐν τῇ κοινῇ συνηθείᾳ ὄνομα μὴ εὑρίσκηται·", "seq": 1893}
{"id": "Philoponus_Passim_1894", "series": "CAG", "text": "δεῖ γάρ, φησίν, ἀπὸ τῶν πρώτων καὶ οἰκείως κατηγορουμένων παρώνυμον τιθέναι ὄνομα ἐκείνοις ὧν κατηγοροῦνται, καὶ οὕτως εὑρήσομεν αὐτὰ ἀντιστρέφοντα, οἷον ἀπὸ τοῦ πηδαλίου καλεῖν τὸ πλοῖον οὗ τὸ πηδάλιον κατηγορεῖται πηδαλιωτόν, καὶ ἀπὸ τῆς κεφαλῆς καλεῖν τὸ ζῷον τὸ κεφαλὴν ἔχον κεφαλωτόν.", "seq": 1894}
{"id": "Philoponus_Passim_1895", "series": "CAG", "text": "καὶ ἐπὶ τῶν ἄλλων ὁμοίως.", "seq": 1895}
{"id": "Philoponus_Passim_1896", "series": "CAG", "text": "καὶ ταῦτα δὲ πάλιν φησὶ λεληθότως βουλόμενος τὸν ὁρισμὸν κακίσαι·", "seq": 1896}
{"id": "Philoponus_Passim_1897", "series": "CAG", "text": "εἰ γὰρ πρός τι ταῦτά ἐστιν ἅπερ ἑτέρων εἶναι λέγεται, καὶ ἡ κεφαλὴ καὶ τὸ πηδάλιον καὶ τὸ πτερὸν ἔσται τῶν πρός τι, ὅπερ ἄτοπον·", "seq": 1897}
{"id": "Philoponus_Passim_1898", "series": "CAG", "text": "ταῦτα γὰρ ὡς μὲν μέρη οὐσιῶν λέγεται εἶναι πρός τι (τὸ γὰρ μέρος ὅλου ἐστὶ μέρος καὶ τὸ ὅλον τοῖς μέρεσιν ὅλον), ὡς μέντοι γε πτερὸν ἢ πηδάλιον ἢ κεφαλὴ οὔκ εἰσι πρός τι, ἀλλ᾿ οὐσίαι·", "seq": 1898}
{"id": "Philoponus_Passim_1899", "series": "CAG", "text": "ἕκαστον γὰρ τούτων αὐτὸ καθ᾿ αὑτὸ θεωρεῖται·", "seq": 1899}
{"id": "Philoponus_Passim_1900", "series": "CAG", "text": "ἀμέλει ἐὰν ἀποτμηθῇ ἡ κεφαλὴ ἢ ἡ χεὶρ τοῦ παντός, οὐδὲν ἧττον λέγεται κεφαλὴ καὶ χείρ, μέρη μέντοι οὐκέτι λέγεται·", "seq": 1900}
{"id": "Philoponus_Passim_1901", "series": "CAG", "text": "τὸ γὰρ μέρος ἐν τῷ ὅλῳ θεωρεῖται.", "seq": 1901}
{"id": "Philoponus_Passim_1902", "series": "CAG", "text": "τὰ δὲ πρός τι ἐὰν ἀφαιρεθῇ ἐκείνων πρὸς ἃ λέγεται, καὶ τὴν οἰκείαν ὀνομασίαν εὐθὺς συναφῃρέθη·", "seq": 1902}
{"id": "Philoponus_Passim_1903", "series": "CAG", "text": "οἷον ὁ πατὴρ λέγεται υἱοῦ πατήρ, ἀλλ᾿ ἐὰν ἀφαιρεθῇ ὁ υἱός, καὶ τὸ πατὴρ εἶναι ὁ πατὴρ συναφῃρέθη.", "seq": 1903}
{"id": "Philoponus_Passim_1904", "series": "CAG", "text": "τὰ δὲ ἑτέρων λεγόμενα κἂν ἀφαιρεθῇ ἐκείνων ὧν λέγεται εἶναι, φυλάττει οὐδὲν ἧττον τὴν ὀνομασίαν·", "seq": 1904}
{"id": "Philoponus_Passim_1905", "series": "CAG", "text": "οἷον ἡ κεφαλὴ ζῴου λέγεται κεφαλή, καὶ ἐὰν ἀφαιρεθῇ τοῦ ζῴου, οὐδὲν ἧττον λέγεται κεφαλή, καὶ τὸ πηδάλιον πλοίου καὶ τὸ πτερὸν ὄρνιθος καὶ ἀφαιρεθέντα τούτων ὧν εἶναι λέγεται οὐδὲν ἧττον πάλιν τῆς οἰκείας ὀνομασίας τετύχηκε.", "seq": 1905}
{"id": "Philoponus_Passim_1906", "series": "CAG", "text": "7a25 Λέγω δὲ ὅτι οὐδὲ τῶν ὁμολογουμένως πρὸς ἀντιστρέφοντα λεγομένων, καὶ ὀνομάτων αὐτοῖς κειμένων, οὐδὲν ἀντιστρέφει, ἐὰν πρός τι τῶν συμβεβηκότων ἀποδιδῶται, καὶ μὴ πρὸς αὐτὰ ἃ λέγεται.", "seq": 1906}
{"id": "Philoponus_Passim_1907", "series": "CAG", "text": "Ἐντεῦθεν ἐκ τοῦ μᾶλλον ἡ ἐπιχείρησις·", "seq": 1907}
{"id": "Philoponus_Passim_1908", "series": "CAG", "text": "τί γὰρ θαυμαστόν, φησίν, εἰ ἐπὶ τῶν εἰρημένων οὐ σώζεται ἡ ἀντιστροφὴ διὰ τὸ μὴ κυρίως ἀποδεδόσθαι, ὁπότε οὐδὲ τὰ ὁμολογουμένως ὄντα πρός τι καὶ πρὸς ἀντιστρέφοντα λεγόμενα, οἷς καὶ ὀνόματα κεῖται, οὐκ ἀντιστρέφει, ἐὰν μὴ κυρίως ἡ ἀπόδοσις γένηται;", "seq": 1908}
{"id": "Philoponus_Passim_1909", "series": "CAG", "text": "οἷον τὸν δεσπότην ἐὰν μὴ πρὸς δοῦλον ἀλλὰ πρὸς ἄνθρωπόν τις ἀποδῷ λέγων ‘ὁ δεσπότης ἀνθρώπου δεσπότης’, οὐ δυνήσεται ἀντιστρέψας εἰπεῖν ‘ὁ ἄνθρωπος δεσπότου ἄνθρωπος’·", "seq": 1909}
{"id": "Philoponus_Passim_1910", "series": "CAG", "text": "τοῦτο γὰρ καταγέλαστον·", "seq": 1910}
{"id": "Philoponus_Passim_1911", "series": "CAG", "text": "τὸν μὲν γὰρ δεσπότην ἀνθρώπου εἰπεῖν δεσπότην οὐ χαλεπόν, τὸν δὲ ἄνθρωπον δεσπότου ἄνθρωπον ἀτοπώτατον.", "seq": 1911}
{"id": "Philoponus_Passim_1912", "series": "CAG", "text": "ὥστε καὶ ἐπὶ τούτων ἐπειδὴ μὴ οἰκεία γέγονεν ἡ ἀπόδοσις, οὐδὲ ἡ ἀντιστροφὴ σώζεται·", "seq": 1912}
{"id": "Philoponus_Passim_1913", "series": "CAG", "text": "οὐ γὰρ πρὸς ἴσον ἐποιησάμεθα τὴν ἀπόδοσιν·", "seq": 1913}
{"id": "Philoponus_Passim_1914", "series": "CAG", "text": "ἐπὶ πλέον γὰρ ὁ ἄνθρωπος.", "seq": 1914}
{"id": "Philoponus_Passim_1915", "series": "CAG", "text": "δεῖ οὖν τὰ ἀντιστρέφοντα ἐξισάζειν ἀλλήλοις, ὥσπερ εἴρηται, ἵνα καὶ ἀντιστρέφῃ·", "seq": 1915}
{"id": "Philoponus_Passim_1916", "series": "CAG", "text": "διὰ τοῦτο γὰρ καὶ τὰ ἴδια ἀντιστρέφει πρὸς ἐκεῖνα ὧν ἐστιν ἴδια, ἐπειδὴ καὶ ἐξισάζει ἀλλήλοις.", "seq": 1916}
{"id": "Philoponus_Passim_1917", "series": "CAG", "text": "ταῦτα δὲ πάντα φησὶ συναγωνιζόμενος τῷ ὁρισμῷ τῷ λέγοντι τὰ πρός τι εἶναι τῷ ἑτέρων λέγεσθαι καὶ δεικνύειν πειρᾶται κατὰ τὸν ὁρισμὸν τοῦτον τὰ πρός τι ἀντιστρέφοντα, κρατῦναι βουλόμενος αὐτὸν ὡς οἷόν τε, ἵνα μὴ δόξῃ ἐρήμην αὐτοῦ καταψηφίζεσθαι, εἶθ᾿ ὕστερον εὐλόγως αὐτὸν διελέγξαι δεικνὺς ὅτι καὶ μετὰ τοσαύτην συνηγορίαν ὅμως πολλὰ ἄτοπα αὐτῷ παρακολουθεῖ.", "seq": 1917}
{"id": "Philoponus_Passim_1918", "series": "CAG", "text": "7a31 Ἔτι ἐὰν μὲν οἰκείως ἀποδεδομένον ᾖ πρὸς ὃ λέγεται, πάντων περιαιρουμένων τῶν ἄλλων ὅσα συμβεβηκότα ἐστί, καταλειπομένου δὲ μόνου τούτου πρὸς ὃ ἀπεδόθη οἰκείως, πρὸς αὐτὸ ῥηθήσεται.", "seq": 1918}
{"id": "Philoponus_Passim_1919", "series": "CAG", "text": "Κανόνα ἡμῖν παραδίδωσι τῶν οἰκείως κατά τινος ἀποδεδομένων·", "seq": 1919}
{"id": "Philoponus_Passim_1920", "series": "CAG", "text": "λέγει γὰρ ὅτι ἐάν τι ᾖ πλείοσιν ὀνόμασι λεγόμενον, εἶτα ὑπάρχῃ ἄλλο τι καθ᾿ ἑνὸς τούτων τῶν ὀνομάτων κατηγορούμενον, καὶ βούλῃ γνῶναι εἰ οἰκείως τὸ κατηγορούμενον ἐκείνῳ τῷ ὀνόματι κατηγορήθη, περιελὼν πάντα τὰ ἄλλα ὀνόματα τὰ συμβεβηκότα τῷ ὑποκειμένῳ, καταλιπὼν δὲ μόνον ἐκεῖνο πρὸς ὃ ἀπεδόθη τὸ κατηγορούμενον, ἐὰν εὕρῃς αὐτὸ ἀντιστρέφον πρὸς ἐκεῖνο ὅπερ αὐτοῦ κατηγορεῖται, ἴσθι ὅτι οἰκείως ἀπεδόθη τὸ πρότερον·", "seq": 1920}
{"id": "Philoponus_Passim_1921", "series": "CAG", "text": "οὐ γὰρ ἂν ἀντέστρεφεν, εἰ μὴ οἰκείως ἀπεδόθη·", "seq": 1921}
{"id": "Philoponus_Passim_1922", "series": "CAG", "text": "οἷον ὁ δοῦλος ἐὰν ἀποδοθῇ δεσπότου δοῦλος, ἐπειδὴ τῷ δεσπότῃ συμβέβηκε τὸ ἀνθρώπῳ εἶναι καὶ δίποδι καὶ ἐπιστήμης δεκτικῷ, ἐὰν ταῦτα πάντα ἀφέλῃς αὐτοῦ καὶ ὑποθῇ ὡς μηδὲ ὅλως ὑπάρχοντα, καταλείψῃς δὲ μόνον τὸ δεσπότην εἶναι, οὐδὲν ἧττον εὑρήσεις κυρίως γινομένην τὴν ἀντιστροφήν·", "seq": 1922}
{"id": "Philoponus_Passim_1923", "series": "CAG", "text": "ὁ γὰρ δεσπότης δούλου λέγεται δεσπότης.", "seq": 1923}
{"id": "Philoponus_Passim_1924", "series": "CAG", "text": "ἐὰν δὲ μὴ πρὸς δεσπότην ἀποδοθῇ ὁ δοῦλος ἀλλὰ πρὸς ἄνθρωπον, περιαιρουμένων τοῦ ἀνθρώπου τῶν λοιπῶν πάντων, λέγω δὴ τοῦ δεσπότου τοῦ δίποδος καὶ τῶν λοιπῶν, οὐ σωθήσεται ἡ ἀντιστροφή·", "seq": 1924}
{"id": "Philoponus_Passim_1925", "series": "CAG", "text": "οὐ γὰρ δυνατὸν ἀντιστρέψαντα εἰπεῖν ‘ὁ ἄνθρωπος δούλου ἄνθρωπος’.", "seq": 1925}
{"id": "Philoponus_Passim_1926", "series": "CAG", "text": "ὥστε οὐκ οἰκείως ὁ δοῦλος πρὸς τὸν ἄνθρωπον ἀπεδόθη.", "seq": 1926}
{"id": "Philoponus_Passim_1927", "series": "CAG", "text": "περιαιρουμένων φησὶν τῶν ἄλλων ἁπάντων ὅσα συμβεβηκότα ἐστὶ τῷ δεσπότῃ, οἷον τὸ δίποδι εἶναι <καὶ> τὸ ἐπιστήμης δεκτικῷ καὶ τὸ ἀνθρώπῳ, καὶ οὐδὲν θαυμαστὸν ὅτι ταῦτα συμβεβηκότα εἶπεν·", "seq": 1927}
{"id": "Philoponus_Passim_1928", "series": "CAG", "text": "οὐχ ἁπλῶς γὰρ συμβεβηκότα εἶπεν, ἀλλ᾿ ἃ συμβεβηκότα πρὸς τὴν τοῦ δούλου σχέσιν εἶεν ἂν καὶ δευτέρως αὐτοῦ κατηγορούμενα, πρώτως δὲ καὶ καθ᾿ αὑτὸ ὁ δεσπότης·", "seq": 1928}
{"id": "Philoponus_Passim_1929", "series": "CAG", "text": "τῇ γὰρ σχέσει τῶν πρός τι, ὡς ἔφθην εἰπών, αὐτῇ καθ᾿ αὑτὴν οὐχ ὑφεστηκυίᾳ ποτὲ μὲν συμβαίνει ἐν οὐσίᾳ εἶναι ποτὲ δὲ ἐν ποσῷ ἢ ἐν ποιῷ ἢ ἐν ἄλλῃ τινὶ τῶν κατηγοριῶν.", "seq": 1929}
{"id": "Philoponus_Passim_1930", "series": "CAG", "text": "ὥστε οὐκ ἀτόπως τις τῷ διπλασίῳ πρός τι ὄντι, ὅταν μὲν ᾖ, εἰ τύχοι, ἐν ξύλῳ, λέγει αὐτῷ συμβεβηκέναι τὸ ξύλον, ὅταν δὲ ἐν λίθῳ, τὸν λίθον, καὶ ὅταν ἐν ἐπιφανείᾳ ἢ ἐν χρόνῳ, τὸν χρόνον ἢ τὴν ἐπιφάνειαν, τῆς σχέσεως καθ᾿ αὑτὴν τῇ ἐπινοίᾳ θεωρουμένης.", "seq": 1930}
{"id": "Philoponus_Passim_1931", "series": "CAG", "text": "7b15 Δοκεῖ δὲ τὰ πρός τι ἅμα τῇ φύσει εἶναι.", "seq": 1931}
{"id": "Philoponus_Passim_1932", "series": "CAG", "text": "καὶ ἐπὶ μὲν τῶν πλείστων ἀληθές ἐστιν, ἐπ᾿ ἐνίων δὲ οὐκ ἀληθές·", "seq": 1932}
{"id": "Philoponus_Passim_1933", "series": "CAG", "text": "ἅμα γὰρ διπλάσιόν τέ ἐστι καὶ ἥμισυ, καὶ ἡμίσεος ὄντος διπλάσιόν ἐστι.", "seq": 1933}
{"id": "Philoponus_Passim_1934", "series": "CAG", "text": "Ἕτερον τῶν πρός τι παρακολούθημα ἴδιον ἀποδέδωκε μετὰ τὸ πρὸς ἀντιστρέφοντα λέγεσθαι, τὸ ἅμα τῇ φύσει εἶναι.", "seq": 1934}
{"id": "Philoponus_Passim_1935", "series": "CAG", "text": "ἅμα δὲ τῇ φύσει ταῦτά ἐστιν ὧν τοῦ ἑνὸς τεθέντος ἀνάγκη συνεισάγεσθαι καὶ τὸ ἕτερον καὶ ἀναιρεθέντος συναναιρεῖσθαι, καὶ μηδέποτε τοῦ ἑτέρου ὄντος τὸ ἕτερον μὴ εἶναι·", "seq": 1935}
{"id": "Philoponus_Passim_1936", "series": "CAG", "text": "ἅμα γὰρ τῷ εἰπεῖν δοῦλον ἀνάγκη τὸν δεσπότην συνεπινοεῖν, καὶ διπλασίου ὄντος ἀνάγκη καὶ ἥμισυ εἶναι.", "seq": 1936}
{"id": "Philoponus_Passim_1937", "series": "CAG", "text": "καὶ ἐπὶ μὲν τῶν πλείστων φησὶν ἀληθές ἐστιν.", "seq": 1937}
{"id": "Philoponus_Passim_1938", "series": "CAG", "text": "ἐπὶ τῶν πλείστων εἶπεν, ἐπειδὴ ἐπί τινων ἄλλων μέλλει ἀπορεῖν δοκούντων μὴ ἅμα τῇ φύσει ὑπάρχειν.", "seq": 1938}
{"id": "Philoponus_Passim_1939", "series": "CAG", "text": "7b22 Οὐκ ἐπὶ πάντων δὲ τῶν πρός τι ἀληθὲς δοκεῖ τὸ ἅμα τῇ φύσει εἶναι·", "seq": 1939}
{"id": "Philoponus_Passim_1940", "series": "CAG", "text": "τὸ γὰρ ἐπιστητὸν τῆς ἐπιστήμης πρότερον ἂν δόξειεν εἶναι.", "seq": 1940}
{"id": "Philoponus_Passim_1941", "series": "CAG", "text": "Ἔνστασιν πρὸς τὸ εἰρημένον κομίζει ὅτι οὐ πᾶσι τοῖς πρός τι δοκεῖ ὑπάρχειν τὸ ἅμα τῇ φύσει εἶναι·", "seq": 1941}
{"id": "Philoponus_Passim_1942", "series": "CAG", "text": "ἡ γὰρ ἐπιστήμη καὶ τὸ ἐπιστητὸν τῶν πρός τι ὄντα οὐχ ἅμα ὑπάρχει·", "seq": 1942}
{"id": "Philoponus_Passim_1943", "series": "CAG", "text": "τῶν μὲν γὰρ ἐπιστητῶν ἀναιρεθέντων ἀναιρεῖται καὶ ἡ ἐπιστήμη·", "seq": 1943}
{"id": "Philoponus_Passim_1944", "series": "CAG", "text": "ἐπιστητοῦ γὰρ μὴ ὄντος τίνος ἂν εἴη ἐπιστήμη;", "seq": 1944}
{"id": "Philoponus_Passim_1945", "series": "CAG", "text": "ἐπιστήμης δὲ μὴ οὔσης οὐδὲν κωλύει εἶναι ἐπιστητά·", "seq": 1945}
{"id": "Philoponus_Passim_1946", "series": "CAG", "text": "ὥστε οὐχ ἅμα τῇ φύσει ταῦτα ὑπάρχουσι τῶν πρός τι ὄντα.", "seq": 1946}
{"id": "Philoponus_Passim_1947", "series": "CAG", "text": "τὸ δὲ πρότερον διττόν, τὸ μὲν χρόνῳ τὸ δὲ φύσει.", "seq": 1947}
{"id": "Philoponus_Passim_1948", "series": "CAG", "text": "καὶ πρότερον μὲν χρόνῳ ἐστὶν οὗ πρὸς τὸ νῦν πλείων ἡ ἀπόστασις, ὡς ἐπὶ τοῦ παρεληλυθότος·", "seq": 1948}
{"id": "Philoponus_Passim_1949", "series": "CAG", "text": "διὰ τοῦτο γὰρ λέγομεν τὰ Μηδικὰ πρότερα τῶν Πελοποννησιακῶν, ὅτι αὐτῶν πλείων ἐστὶν ἀπὸ τοῦ νῦν ἡ ἀπόστασις.", "seq": 1949}
{"id": "Philoponus_Passim_1950", "series": "CAG", "text": "ἐπὶ δὲ τοῦ μέλλοντος ἀνάπαλιν οὗ ἐλάττων ἀπὸ τοῦ νῦν ἡ ἀπόστασις, τοῦτο πρότερον·", "seq": 1950}
{"id": "Philoponus_Passim_1951", "series": "CAG", "text": "πρότερον γὰρ τὸ αὔριον τοῦ μεταύριον.", "seq": 1951}
{"id": "Philoponus_Passim_1952", "series": "CAG", "text": "τοιοῦτον μὲν οὖν τὸ τῷ χρόνῳ πρότερον.", "seq": 1952}
{"id": "Philoponus_Passim_1953", "series": "CAG", "text": "τῇ δὲ φύσει πρότερον τὸ συναναιροῦν μὲν μὴ συναναιρούμενον δὲ καὶ τὸ συνεισφερόμενον μὲν μὴ συνεισφέρον δέ, ὡς ἐπὶ ζῴου καὶ ἀνθρώπου ἔχει.", "seq": 1953}
{"id": "Philoponus_Passim_1954", "series": "CAG", "text": "τὸ οὖν ἐπιστητὸν τῆς ἐπιστήμης πρότερον ἂν δόξειεν εἶναι φύσει·", "seq": 1954}
{"id": "Philoponus_Passim_1955", "series": "CAG", "text": "ἐπιστητοῦ γὰρ μὴ ὄντος ἐπιστήμη οὐκ ἔστιν, ἐπιστήμης δὲ μὴ οὔσης τὸ ἐπιστητὸν δύναται εἶναι.", "seq": 1955}
{"id": "Philoponus_Passim_1956", "series": "CAG", "text": "ἀμέλει φασὶ Θαλῆν τὸν Μιλήσιον πρῶτον ἐπιστῆσαι τῇ αἰτίᾳ τῆς σεληνιακῆς ἐκλείψεως κατανοήσαντα ὅτι ἐκ τοῦ ἡλίου ἡ σελήνη δέχεται τὸ φῶς, διότι ἀεὶ τὸ πεφωτισμένον αὐτῆς μέρος πρὸς τὸν ἥλιον νεύει, ὅθεν αὐξομένη μὲν τῇ ἀποστάσει τοῦ ἡλίου τὸ μὲν πεφωτισμένον μέρος ἔχει πρὸς δυσμάς, δυτικωτέρου ὄντος τότε τοῦ ἡλίου, τὸ δὲ κερατοειδὲς αὐτῆς καὶ ἀφώτιστον νεύει πρὸς ἀνατολάς.", "seq": 1956}
{"id": "Philoponus_Passim_1957", "series": "CAG", "text": "ἐπὰν δὲ γένηται ἀντιπρόσωπος ὅλη τῷ ἡλίῳ, κατὰ διάμετρον αὐτοῦ ἀποστᾶσα, τότε πᾶσα φωτίζεται ὅλη ὅλῳ τῷ ἡλίῳ προσβάλλουσα (ὅλην δὲ λέγω κατὰ τὸ πρὸς ἡμᾶς αὐτῆς νενευκὸς μέρος), ἡνίκα δὲ ἄρξηται μειοῦσθαι τῇ συνόδῳ τῇ πρὸς τὸν ἥλιον, τότε πάλιν τὸ μὲν πεφωτισμένον αὐτῆς μέρος νεύει πρὸς ἀνατολάς, τοῦ ἡλίου τότε ἀνατολικωτέρου ὄντος, τὸ δὲ ἀφώτιστον καὶ κερατοειδὲς πρὸς δυσμάς.", "seq": 1957}
{"id": "Philoponus_Passim_1958", "series": "CAG", "text": "ἐντεῦθεν τοίνυν ἐπέστησε τῇ σεληνιακῇ ἐκλείψει, ὅτι ἐπειδὰν ἐμπέσῃ εἰς τὸ καλούμενον σκίασμα τῆς γῆς, τοῦ ἡλίου κατὰ κάθετον αὐτῇ ὄντος ἐν τῷ ὑπὸ γῆν ἡμισφαιρίῳ, πάσχειν συμβαίνει αὐτῇ παντελῆ ἔκλειψιν, τῶν ἀκτίνων τῶν ἡλιακῶν μηδαμῶς αὐτῇ προσβαλλουσῶν.", "seq": 1958}
{"id": "Philoponus_Passim_1959", "series": "CAG", "text": "ἀμέλει εἰ μὴ ἐν πανσελήνῳ μόνῃ τοῦτο οὐ συμβαίνει.", "seq": 1959}
{"id": "Philoponus_Passim_1960", "series": "CAG", "text": "εἰ τοίνυν πρῶτος ὁ Θαλῆς ἐπέστησε τῇ σεληνιακῇ ἐκλείψει, δῆλον ὅτι πρὸ αὐτοῦ τὸ μὲν ἐπιστητὸν ἦν, λέγω δὴ ἡ σεληνιακὴ ἔκλειψις, ἐπιστήμη δὲ ταύτης οὐκ ἦν.", "seq": 1960}
{"id": "Philoponus_Passim_1961", "series": "CAG", "text": "δῆλον οὖν ὅτι προϋπάρχει καὶ χρόνῳ καὶ φύσει τὸ ἐπιστητὸν τῆς ἐπιστήμης καὶ οὐχ ἅμα εἰσὶ ταῦτα τῶν πρός τι ὄντα.", "seq": 1961}
{"id": "Philoponus_Passim_1962", "series": "CAG", "text": "ὡσαύτως αἰσθητοῦ μὲν μὴ ὄντος οὐδὲ αἴσθησίς ἐστι (τίνος γὰρ ἔσται αἴσθησις;)", "seq": 1962}
{"id": "Philoponus_Passim_1963", "series": "CAG", "text": ", αἰσθήσεως μέντοι μὴ οὔσης οὐδὲν κωλύει τὰ αἰσθητὰ εἶναι, οἷον πῦρ γῆν καὶ τὰ τοιαῦτα.", "seq": 1963}
{"id": "Philoponus_Passim_1964", "series": "CAG", "text": "7b24 Ὡς γὰρ ἐπὶ τὸ πολὺ προϋπαρχόντων τῶν πραγμάτων τὰς ἐπιστήμας λαμβάνομεν.", "seq": 1964}
{"id": "Philoponus_Passim_1965", "series": "CAG", "text": "Τὸ ὡς ἐπὶ τὸ πολὺ αὐτὸς ἐξηγήσατο εἰπὼν ἐπ᾿ ὀλίγων γὰρ ἢ ἐπ᾿ οὐδενὸς ἴδοι τις ἂν ἅμα τῷ ἐπιστητῷ τὴν ἐπιστήμην γινομένην.", "seq": 1965}
{"id": "Philoponus_Passim_1966", "series": "CAG", "text": "ταῦτα δὲ εἶπε διὰ τὰ ἀπό τινος τέχνης προαγόμενα·", "seq": 1966}
{"id": "Philoponus_Passim_1967", "series": "CAG", "text": "ταῦτα γὰρ οὐ προϋπάρχει, ἀλλ᾿ ἅμα τῷ ἐκ τῆς τέχνης προαχθῆναι τὸ εἶναι ἔχει·", "seq": 1967}
{"id": "Philoponus_Passim_1968", "series": "CAG", "text": "τὰ μὲν γὰρ φυσικὰ προϋπάρχει τῆς ἐπιστήμης, τὰ δὲ τεχνητὰ ἅμα τῇ αὐτῶν ἐπιστήμῃ τὸ εἶναι ἔχει·", "seq": 1968}
{"id": "Philoponus_Passim_1969", "series": "CAG", "text": "οἷον ἐπενόησέ τις στιβάδα πρὸς τὸ καθεύδειν·", "seq": 1969}
{"id": "Philoponus_Passim_1970", "series": "CAG", "text": "ἐνταῦθα ἅμα τῷ ἐπιστητῷ καὶ ἡ ἐπιστήμη τὸ εἶναι ἔχει.", "seq": 1970}
{"id": "Philoponus_Passim_1971", "series": "CAG", "text": "ἴδοις δ᾿ ἂν τοῦτο μάλιστα ἐπὶ τῶν κατὰ μηχανικὴν εὑρημάτων, οἷον πῶς ἄν τις βάρη κινήσειεν ἢ μετεωρίσειεν ὕδωρ ἤ τι τοιοῦτον·", "seq": 1971}
{"id": "Philoponus_Passim_1972", "series": "CAG", "text": "δῆλον γὰρ ὅτι ταῦτα καὶ τὰ τοιαῦτα ἅμα τῇ περὶ αὐτῶν ἐπιστήμῃ εὕρηται οὐκ ὄντα πρὸ τῆς περὶ αὐτῶν ἐπιστήμης.", "seq": 1972}
{"id": "Philoponus_Passim_1973", "series": "CAG", "text": "τάχα δὲ καὶ ἀντιπεπονθότως τοῖς φυσικοῖς ἔχουσι τὰ τεχνητά·", "seq": 1973}
{"id": "Philoponus_Passim_1974", "series": "CAG", "text": "ἐπὶ μὲν γὰρ τῶν φυσικῶν, ὡς εἴρηται, αὐτὰ τὰ ἐπιστητὰ προϋπάρχει τῆς περὶ αὐτῶν ἐπιστήμης, ἐπὶ δὲ τῶν ἐκ τῆς τέχνης συνεστώτων δεῖ πρότερον τὴν περὶ αὐτῶν ὑπάρξαι ἐπιστήμην, εἶτα τὸ ἐπιστητὸν γενέσθαι·", "seq": 1974}
{"id": "Philoponus_Passim_1975", "series": "CAG", "text": "πρῶτον γὰρ δηλονότι ἡ περὶ τῆς θύρας ἐπίνοια γέγονε καὶ ὅπως ἂν αὐτὴ συσταίη, εἶτα λοιπὸν γέγονε τῆς ἐπινοίας τὸ ἀποτέλεσμα·", "seq": 1975}
{"id": "Philoponus_Passim_1976", "series": "CAG", "text": "εἰ μή τις ἐκεῖνο εἴποι ὅτι ἡ ἐπιστήμη ἡ περὶ τοῦ πλοίου πρὶν τὸ πλοῖον γενέσθαι εἰ καὶ προϋπῆρξεν ἐν τῇ ψυχῇ τοῦ πρῶτον ἐπινενοηκότος, ἀλλ᾿ οὖν οὔπω τὸ εἶναι κυρίως ἐπιστήμη εἶχεν, ἀδήλου τέως ὄντος εἰ τῇ ἐπινοίᾳ καὶ τὸ πρᾶγμα συνακολουθήσει ἢ μή·", "seq": 1976}
{"id": "Philoponus_Passim_1977", "series": "CAG", "text": "τότε γὰρ μέχρι μόνον φαντασίας προῆλθε τὸ τοιοῦτον, εἰς ἔργον δὲ ἐκβῆναι οὐ δύναται, ὥσπερ ὁ μῦθος ὁ περὶ Δαιδάλου ἔχει, ὅτι πτερῶσαι ἐπινενόηκεν ἑαυτὸν καὶ τὸν υἱὸν Ἴκαρον·", "seq": 1977}
{"id": "Philoponus_Passim_1978", "series": "CAG", "text": "ὥστε ὅταν ἅμα τῇ περί τινος ἐπιστητοῦ ἐπιστήμῃ καὶ αὐτὸ εἰς ἔργον ἐκβῇ τὸ ἐπιστητόν, τότε τῷ ὄντι καὶ ἡ ἐπιστήμη κυρίως ἐστὶν ἐπιστήμη τὸ ἀμφίβολον οὐκ ἔχουσα.", "seq": 1978}
{"id": "Philoponus_Passim_1979", "series": "CAG", "text": "ὥστε ἐπὶ τῶν τεχνητῶν ἅμα συνυφίστασθαι ἀλλήλοις τὸ ἐπιστητόν τε καὶ τὴν ἐπιστήμην συμβαίνει.", "seq": 1979}
{"id": "Philoponus_Passim_1980", "series": "CAG", "text": "7b27 Ἔτι τὸ μὲν ἐπιστητὸν ἀναιρεθὲν συναναιρεῖ τὴν ἐπιστήμην.", "seq": 1980}
{"id": "Philoponus_Passim_1981", "series": "CAG", "text": "Ἐκθέμενος τὸ τῷ χρόνῳ πρότερον ἐπὶ τοῦ ἐπιστητοῦ (ὡς γὰρ ἐπὶ τὸ πολύ, φησί, προϋπαρχόντων τῶν πραγμάτων τὰς ἐπιστήμας λαμβάνομεν) νῦν πάλιν ἐπὶ τοῦ ἐπιστητοῦ τὸ τῇ φύσει ἐκτίθεται πρότερον διὰ τοῦ συναναιρεῖν μὲν τὴν ἐπιστήμην μὴ συναναιρεῖσθαι δὲ ὑπ᾿ αὐτῆς.", "seq": 1981}
{"id": "Philoponus_Passim_1982", "series": "CAG", "text": "7b31 Οἷον καὶ ὁ τοῦ κύκλου τετραγωνισμὸς εἴ γε ἔστιν ἐπιστητόν, ἐπιστήμη μὲν αὐτοῦ οὐκ ἔστι πω, τὸ δὲ ἐπιστητὸν ἔστιν.", "seq": 1982}
{"id": "Philoponus_Passim_1983", "series": "CAG", "text": "Οἱ γεωμέτραι τετράγωνον εἶναι χωρίον λέγουσιν οὐ τὸ ἁπλῶς τέσσαρας πλευρὰς καὶ τέσσαρας γωνίας ἔχον, ἀλλὰ τὸ ἴσας ἔχον τὰς τέσσαρας πλευρὰς καὶ ὀρθὰς τὰς γωνίας.", "seq": 1983}
{"id": "Philoponus_Passim_1984", "series": "CAG", "text": "οὕτω δὲ καὶ τὴν ὀρθὴν γωνίαν γίνεσθαί φασιν·", "seq": 1984}
{"id": "Philoponus_Passim_1985", "series": "CAG", "text": "ὅταν εὐθεῖα ἐπ᾿ εὐθεῖαν σταθεῖσα τὰς ἐντὸς καὶ ἐπὶ τὰ αὐτὰ μέρη γωνίας ἴσας ἀλλήλαις ποιῇ, ὀρθὴ ἑκατέρα τῶν γωνιῶν ἐστι, καὶ ἡ ἐφεστηκυῖα εὐθεῖα κάθετος λέγεται ἐφ᾿ ἣν ἐφέστηκεν.", "seq": 1985}
{"id": "Philoponus_Passim_1986", "series": "CAG", "text": "ὀρθὴ μὲν οὖν γωνία αὕτη.", "seq": 1986}
{"id": "Philoponus_Passim_1987", "series": "CAG", "text": "ὀξεῖα δὲ γωνία ἐστὶν ἡ ἐλάττων τῆς ὀρθῆς, ἀμβλεῖα δὲ ἡ μείζων τῆς ὀρθῆς·", "seq": 1987}
{"id": "Philoponus_Passim_1988", "series": "CAG", "text": "τῆς γὰρ ἐφεστηκυίας εὐθείας ἐγκεκλιμένης ἡ μὲν τῶν γωνιῶν μείζων γίνεται ἡ δὲ ἐλάττων·", "seq": 1988}
{"id": "Philoponus_Passim_1989", "series": "CAG", "text": "τὴν μὲν οὖν ἐλάττονα, ὡς εἴρηται, ὀξεῖαν καλοῦσιν, ἐπειδὴ κατὰ ταύτην γίνονται καὶ οἱ ὀξεῖς τῶν ὄγκων πρὸς τὸ κόπτειν ὄντες ἐπιτήδειοι, οἷον τὸ μαχαίριον, τὴν δὲ μείζονα ἀμβλεῖαν·", "seq": 1989}
{"id": "Philoponus_Passim_1990", "series": "CAG", "text": "κατὰ γὰρ ταύτην οἱ ἀμβλεῖς τῶν ὄγκων γίνονται, οἷον τὸ ὕπερον πρὸς τὸ ὠθεῖν ἐπιτήδειον.", "seq": 1990}
{"id": "Philoponus_Passim_1991", "series": "CAG", "text": "τῶν δὲ σχημάτων τὰ μέν φασιν εἶναι εὐθύγραμμα τὰ δὲ περιφερόγραμμα, καὶ τῶν εὐθυγράμμων τὰ μὲν τρίγωνα ἢ τετράγωνα ἢ ἑξάγωνα ἢ ὅσας ἂν ἄλλας ἐπινοεῖν δυνατὸν γωνίας, περιφερόγραμμα δέ φασι τοὺς κύκλους.", "seq": 1991}
{"id": "Philoponus_Passim_1992", "series": "CAG", "text": "οἱ γεωμέτραι οὖν ζητοῦσι τῷ δοθέντι εὐθυγράμμῳ, πενταγώνῳ εἰ τύχοι ὄντι, πῶς δυνατὸν ἴσον τετράγωνον συστήσασθαι·", "seq": 1992}
{"id": "Philoponus_Passim_1993", "series": "CAG", "text": "καὶ γοῦν μεθόδῳ τοῦτο ἐδίδαξαν.", "seq": 1993}
{"id": "Philoponus_Passim_1994", "series": "CAG", "text": "ὥσπερ οὖν ἐπὶ τῶν εὐθυγράμμων ἐζήτησαν, ζητοῦσι καὶ ἐπὶ τοῦ κύκλου πῶς δυνατὸν τῷ δοθέντι κύκλῳ ἴσον τετράγωνον εὑρεῖν.", "seq": 1994}
{"id": "Philoponus_Passim_1995", "series": "CAG", "text": "τοῦτο δὲ πολλοὶ καὶ θεῖοι ἄνδρες ζητήσαντες οὐχ εὗρον.", "seq": 1995}
{"id": "Philoponus_Passim_1996", "series": "CAG", "text": "μόνος δὲ Ἀρχιμήδης τὸ σύνεγγυς παντὶ εὗρε, τὸ μέντοι ἀκριβὲς οὐχ εὗρε.", "seq": 1996}
{"id": "Philoponus_Passim_1997", "series": "CAG", "text": "φησὶ τοίνυν ὁ Ἀριστοτέλης ‘εἴπερ ἔστιν ἐπιστητὸν ὁ τοῦ κύκλου τετραγωνισμός, τῆς ἐπιστήμης αὐτοῦ μήπω μέχρι τοῦ νῦν οὔσης, δῆλον ὅτι πρότερον τὸ ἐπιστητὸν τῆς ἐπιστήμης ἐστί.’", "seq": 1997}
{"id": "Philoponus_Passim_1998", "series": "CAG", "text": "τοῦτο δὲ τὸ ὑπόδειγμα οὐ μᾶλλον τοῦ φύσει πρότερα εἶναι τὰ ἐπιστητὰ τῆς ἐπιστήμης κατασκευαστικόν ἐστιν, ἀλλ᾿ ἢ τοῦ χρόνῳ·", "seq": 1998}
{"id": "Philoponus_Passim_1999", "series": "CAG", "text": "ἐπιστητοῦ γὰρ ὄντος τοῦ τετραγωνισμοῦ τοῦ κύκλου οὔπω ἡ περὶ αὐτοῦ ἐπιστήμη εὕρηται.", "seq": 1999}
{"id": "Philoponus_Passim_2000", "series": "CAG", "text": "τὸ δὲ ἐπιφερόμενον τοῦ ὅτι καὶ φύσει πρότερον τὸ ἐπιστητὸν τῆς ἐπιστήμης δεικτικόν ἐστιν·", "seq": 2000}
{"id": "Philoponus_Passim_2001", "series": "CAG", "text": "7b33 Ἔτι ζῴου μὲν ἀναιρεθέντος οὐκ ἔσται ἐπιστήμη, τῶν δὲ ἐπιστητῶν πολλὰ ἐνδέχεται εἶναι.", "seq": 2001}
{"id": "Philoponus_Passim_2002", "series": "CAG", "text": "Πρότερον ἐπὶ ἑνὸς ὑποδείγματος τῶν πρός τι, λέγω δὴ τοῦ ἐπιστητοῦ, σκάζον δείξας τὸ παρακολούθημα, νῦν καθολικῶς ἐπὶ πάντων δείκνυσι·", "seq": 2002}
{"id": "Philoponus_Passim_2003", "series": "CAG", "text": "ζῴου γὰρ ἀναιρεθέντος, φησίν, ἀναιροῦνται καὶ αἱ ἐπιστῆμαι (ἐν ψυχῇ γάρ εἰσιν αἱ ἐπιστῆμαι), τὰ μέντοι ἐπιστητὰ οὐδὲν ἧττόν ἐστι καθ᾿ αὑτά.", "seq": 2003}
{"id": "Philoponus_Passim_2004", "series": "CAG", "text": "ὥστε πρῶτον τῇ φύσει τὸ ἐπιστητὸν τῆς ἐπιστήμης.", "seq": 2004}
{"id": "Philoponus_Passim_2005", "series": "CAG", "text": "7b35 Ὁμοίως δὲ τούτοις καὶ τὰ ἐπὶ τῆς αἰσθήσεως <ἔχει·", "seq": 2005}
{"id": "Philoponus_Passim_2006", "series": "CAG", "text": "τὸ γὰρ αἰσθητὸν πρότερον τῆς αἰσθήσεως> δοκεῖ εἶναι.", "seq": 2006}
{"id": "Philoponus_Passim_2007", "series": "CAG", "text": "Γυμνάσας τὸν λόγον ἐπὶ τῆς ἐπιστήμης καὶ τοῦ ἐπιστητοῦ, νῦν ἐπὶ τῆς αἰσθήσεως καὶ τοῦ αἰσθητοῦ γυμνάζει καὶ δείκνυσι τοῖς αὐτοῖς λόγοις ὅτι πρότερον τὸ αἰσθητὸν τῆς αἰσθήσεως·", "seq": 2007}
{"id": "Philoponus_Passim_2008", "series": "CAG", "text": "τὸ μὲν γὰρ αἰσθητὸν συναναιρεῖ τὴν αἴσθησιν, ἡ δὲ αἴσθησις τὸ αἰσθητὸν οὐ συναναιρεῖ·", "seq": 2008}
{"id": "Philoponus_Passim_2009", "series": "CAG", "text": "εἰ γὰρ ἡ αἴσθησις ἐν ζῴῳ, τὸ δὲ ζῷον ἔμψυχον σῶμα, πᾶν δὲ σῶμα αἰσθητόν, ἀνάγκη αἰσθητοῦ ἀναιρουμένου συναναιρεῖσθαι καὶ τὸ σῶμα, σώματος δὲ ἀναιρεθέντος μηδὲ ἔμψυχον εἶναι, ἐμψύχου δὲ μὴ ὄντος μηδὲ ζῷον εἶναι, ζῴου δὲ ἀναιρεθέντος μηδὲ αἴσθησιν εἶναι·", "seq": 2009}
{"id": "Philoponus_Passim_2010", "series": "CAG", "text": "ἐν γὰρ τοῖς ζῴοις ἡ αἴσθησις τὸ εἶναι ἔχει.", "seq": 2010}
{"id": "Philoponus_Passim_2011", "series": "CAG", "text": "αἰσθητοῦ μὲν οὖν ἀναιρεθέντος οὐδὲ αἴσθησις ἔσται, ὡς ἐδείξαμεν, διότι πᾶσα αἴσθησις ἐν σώματι ἔχει τὸ εἶναι καὶ περὶ μόνον αὐτὸ θεωρεῖται·", "seq": 2011}
{"id": "Philoponus_Passim_2012", "series": "CAG", "text": "τὰ γὰρ ἀσώματα ἐκπέφευγε πᾶσαν αἴσθησιν μήτε αὐτὰ αἰσθήσει ὑποπίπτοντα μήτε δεκτικὰ ὄντα αἰσθήσεως.", "seq": 2012}
{"id": "Philoponus_Passim_2013", "series": "CAG", "text": "οὐ μήν γε καὶ ἀντιστρέφει·", "seq": 2013}
{"id": "Philoponus_Passim_2014", "series": "CAG", "text": "οὐ γὰρ ἀναιρεθείσης αἰσθήσεως ἀνῄρηται καὶ τὸ αἰσθητόν·", "seq": 2014}
{"id": "Philoponus_Passim_2015", "series": "CAG", "text": "τί δή ποτε;", "seq": 2015}
{"id": "Philoponus_Passim_2016", "series": "CAG", "text": "ἐπειδὴ πᾶν ζῷον ἔμψυχον, πᾶν δὲ ἔμψυχον σῶμα, οὐ πᾶν δὲ σῶμα ἤδη καὶ ἔμψυχον ζῷον, πᾶν δὲ σῶμα αἰσθητόν, ὥστε καὶ ζῴου ἀναιρεθέντος οὐδὲν κωλύει πλείονα ἄλλα εἶναι, οἷον πῦρ γῆν ὕδωρ ἀέρα γλυκὺ πικρὸν καὶ τὰ τοιαύτα.", "seq": 2016}
{"id": "Philoponus_Passim_2017", "series": "CAG", "text": "ἐκ τούτων ἄρα κατεσκεύασται ὅτι φύσει πρότερα τὰ αἰσθητὰ τῶν αἰσθήσεων, ὅτι συναναιροῦσι μὲν ἑαυτοῖς τὰς αἰσθήσεις οὐ συναναιροῦνται δὲ ἐκεῖνα, καὶ συνεισάγονται μὲν ταῖς αἰσθήσεσιν οὐ συνεισάγουσι δὲ αὐτάς.", "seq": 2017}
{"id": "Philoponus_Passim_2018", "series": "CAG", "text": "8a6 Ἔτι ἡ μὲν αἴσθησις ἅμα τῷ αἰσθητικῷ γίνεται·", "seq": 2018}
{"id": "Philoponus_Passim_2019", "series": "CAG", "text": "ἅμα γὰρ ζῷον γίνεται καὶ αἴσθησις.", "seq": 2019}
{"id": "Philoponus_Passim_2020", "series": "CAG", "text": "τὸ δέ γε αἰσθητόν ἐστι καὶ πρὸ τοῦ αἴσθησιν εἶναι·", "seq": 2020}
{"id": "Philoponus_Passim_2021", "series": "CAG", "text": "πῦρ γὰρ καὶ ὕδωρ καὶ τὰ τοιαῦτα, ἐξ ὧν τὸ ζῷον συνίσταται, ἔστι καὶ πρὸ τοῦ ζῷον ὅλως εἶναι ἢ αἴσθησιν.", "seq": 2021}
{"id": "Philoponus_Passim_2022", "series": "CAG", "text": "Ἐντεῦθεν πάλιν ἐκ τοῦ μᾶλλον ἡ ἐπιχείρησις καὶ ἐκ τοῦ προσεχέστερον πρὸς τὸ αἰσθητὸν ἀποδιδομένου, λέγω δὴ τοῦ αἰσθητικοῦ·", "seq": 2022}
{"id": "Philoponus_Passim_2023", "series": "CAG", "text": "τὸ γὰρ αἰσθητικὸν αἰσθητοῦ αἰσθητικόν, αἰσθητικὸν δέ ἐστι τὸ μετέχον αἰσθήσεως.", "seq": 2023}
{"id": "Philoponus_Passim_2024", "series": "CAG", "text": "τί οὖν λέγω, φησίν, ὅτι τῆς αἰσθήσεως προϋπάρχει τὰ αἰσθητά, ὁπότε τὸ αἰσθητικόν, λέγω δὴ τὸ ζῷον, ᾧ συγγίνεσθαι πέφυκεν ἡ αἴσθησις, ἐκ τῶν αἰσθητῶν ἔχει τὸ εἶναι, πυρὸς λέγω καὶ ὕδατος καὶ τῶν λοιπῶν στοιχείων;", "seq": 2024}
{"id": "Philoponus_Passim_2025", "series": "CAG", "text": "τὸ δὲ ἔκ τινος γινόμενον, καὶ μάλιστα ὡς ἐξ ὕλης, ὕστερόν ἐστιν ἐκείνου ἐξ οὗ γέγονε καὶ τῇ φύσει καὶ τῷ χρόνῳ·", "seq": 2025}
{"id": "Philoponus_Passim_2026", "series": "CAG", "text": "ὥστε πρότερον τὸ αἰσθητὸν τῆς αἰσθήσεως, φησίν, εἶναι δόξειε.", "seq": 2026}
{"id": "Philoponus_Passim_2027", "series": "CAG", "text": "καὶ μέχρι μὲν τοσούτου προέρχεται αὐτῷ ἡ ἀπορία.", "seq": 2027}
{"id": "Philoponus_Passim_2028", "series": "CAG", "text": "οὐκ ἐπήγαγε δὲ τῶν εἰρημένων ἐνστάσεων τὴν λύσιν.", "seq": 2028}
{"id": "Philoponus_Passim_2029", "series": "CAG", "text": "λεκτέον οὖν πρὸς ταῦτα ὅτι τὸ πρός τι διχῶς νοεῖται, ἢ ὡς πράγματα αὐτὰ καθ᾿ αὑτὰ ἀπολελυμένα ἢ ὡς σχέσει τινὶ συνδεδεμένα πρὸς ἄλληλα, οἷον ὁ πατὴρ καὶ ὁ υἱός·", "seq": 2029}
{"id": "Philoponus_Passim_2030", "series": "CAG", "text": "ἐν τούτοις γὰρ ἐὰν μὲν νοήσωμεν τὸν πατέρα ὡς Σωφρονίσκον τὸν δὲ υἱὸν ὡς Σωκράτην, πρότερος ἔσται ὁ Σωφρονίσκος τοῦ Σωκράτους (πρότερος γὰρ Σωφρονίσκος ὡς πράγματα νοούντων ἡμῶν τούτους), ἐὰν δὲ ὡς πατέρα καὶ υἱόν, ἅμα ἔσται τῇ σχέσει δεσμούμενα.", "seq": 2030}
{"id": "Philoponus_Passim_2031", "series": "CAG", "text": "οὕτως οὖν καὶ τὴν ἐπιστήμην καὶ τὸ ἐπιστητὸν ἐὰν μὲν ὡς πράγματα νοήσῃς, προϋπάρχει τὸ ἐπιστητὸν τῆς ἐπιστήμης, ἐὰν δὲ ὡς σχέσιν, ἅμα ταῦτα ὑφέστηκεν·", "seq": 2031}
{"id": "Philoponus_Passim_2032", "series": "CAG", "text": "οὐδὲ γὰρ ἂν εἴη ἐπιστητόν τι ἐπιστήμης περὶ αὐτὸ μὴ οὔσης·", "seq": 2032}
{"id": "Philoponus_Passim_2033", "series": "CAG", "text": "οἷον τὰ ἄστρα ἐπιστητὰ ὄντα ὡς μὲν πράγματα νοούμενα πρότερα ἔσται τῆς περὶ αὐτὰ ἐπιστήμης, ἐὰν δὲ ὡς πρός τι αὐτὰ νοήσωμεν, φημὶ δὴ ὡς ἐπιστητά, ἅμα ἔσται ταῦτα τῇ περὶ αὐτῶν ἐπιστήμῃ·", "seq": 2033}
{"id": "Philoponus_Passim_2034", "series": "CAG", "text": "οὐδὲ γὰρ ἂν εἶεν ἐπιστητὰ ἐπιστήμης αὐτῶν μὴ οὔσης, ἐξ ἧς καὶ παρωνύμως λέγονται·", "seq": 2034}
{"id": "Philoponus_Passim_2035", "series": "CAG", "text": "τίνι γὰρ ἂν εἶεν ἐπιστητά;", "seq": 2035}
{"id": "Philoponus_Passim_2036", "series": "CAG", "text": "τὸ γὰρ ἐπιστητὸν ἐπιστήμῃ ἐστὶν ἐπιστητόν·", "seq": 2036}
{"id": "Philoponus_Passim_2037", "series": "CAG", "text": "τῆς οὖν ἐπιστήμης μὴ οὔσης, πῶς ἐκεῖνα ἐκ τῆς μὴ οὔσης τὴν παρωνυμίαν ἕξουσιν;", "seq": 2037}
{"id": "Philoponus_Passim_2038", "series": "CAG", "text": "ἀλλ᾿ ὡς μὲν πράγματα εἰσίν, ὡς δὲ ἐπιστητὰ οὐκέτι.", "seq": 2038}
{"id": "Philoponus_Passim_2039", "series": "CAG", "text": "τὰ αὐτὰ καὶ περὶ τῆς αἰσθήσεως καὶ τοῦ αἰσθητοῦ ἐροῦμεν.", "seq": 2039}
{"id": "Philoponus_Passim_2040", "series": "CAG", "text": "Καὶ ἄλλως δὲ τῶν πραγμάτων τῶν μὲν ὄντων δυνάμει τῶν δὲ ἐνεργείᾳ (δυνάμει μὲν τῶν πεφυκότων τι εἶναι μήπω δὲ ὄντων, ἐνεργείᾳ δὲ τῶν τὴν φυσικὴν δύναμιν ἐνεργῆ δειξάντων, οἷον ἐνεργείᾳ μὲν ὡς ὁ γραμματικὸς ὁ τέλειος, ᾧ μηδὲν εἰς τέχνην τὴν γραμματικὴν ἐπιλείπει, δυνάμει δὲ ὡς τὸ παιδίον, ὅπερ ἔχει δύναμιν τοῦ γενέσθαι γραμματικόν), ἐπὶ τῶν πρός τι πάντων ὡς ἂν ἔχῃ τὸ ἕτερον, οὕτως ἕξει καὶ τὸ λοιπόν·", "seq": 2040}
{"id": "Philoponus_Passim_2041", "series": "CAG", "text": "ἐὰν μὲν γὰρ τὸ ἕτερον ἐνεργείᾳ ᾖ, καὶ τὸ λοιπὸν ἐνεργείᾳ ἔσται, ἐὰν δὲ δυνάμει, καὶ τὸ λοιπὸν δυνάμει.", "seq": 2041}
{"id": "Philoponus_Passim_2042", "series": "CAG", "text": "ὅταν οὖν τὸ ἐπιστητὸν ἢ τὸ αἰσθητὸν ἐνεργείᾳ ᾖ, καὶ ἡ ἐπιστήμη καὶ ἡ αἴσθησις ἐνεργείᾳ ἔσται, ἐὰν δὲ τὰ πρότερα δυνάμει, δυνάμει καὶ τὰ δεύτερα.", "seq": 2042}
{"id": "Philoponus_Passim_2043", "series": "CAG", "text": "εἰ οὖν τις τὴν ἔκλειψιν τὴν σεληνιακὴν πρὸ τοῦ Θαλοῦ ὡς ἐπιστητὸν προεπινοήσειε, δυνάμει ἔσται ἐπιστητὸν καὶ οὐκ ἐνεργείᾳ, καὶ ἡ ἐπιστήμη δὲ ταύτης πάντως καὶ αὐτὴ δυνάμει προεπινοηθήσεται·", "seq": 2043}
{"id": "Philoponus_Passim_2044", "series": "CAG", "text": "εἰ γὰρ μὴ ἦν πρὸ τοῦ Θαλοῦ ἡ ἐπιστήμη τῆς σεληνιακῆς ἐκλείψεως δυνάμει, οὐδ᾿ ἂν ἐκβεβήκει εἰς ἐνέργειαν ἐπὶ αὐτοῦ·", "seq": 2044}
{"id": "Philoponus_Passim_2045", "series": "CAG", "text": "ὃ γὰρ πρότερον οὐκ εἶχε δύναμιν τοῦ γενέσθαι, τοῦτο ἀδύνατον εἰς ὕστερον γενέσθαι·", "seq": 2045}
{"id": "Philoponus_Passim_2046", "series": "CAG", "text": "ὥσπερ γὰρ ὁ ἵππος οὐκ ἔχων δύναμιν τοῦ γενέσθαι γραμματικὸς οὐδέποτε ἐνεργείᾳ γενήσεται γραμματικός, οὕτως εἰ μὴ πρὸ τοῦ Θαλοῦ δυνάμει ὑπῆρχεν ἡ ἐπιστήμη τῆς σεληνιακῆς ἐκλείψεως, οὐδ᾿ ἂν ὑπ᾿ αὐτοῦ εἰς ἐνέργειαν προήχθη.", "seq": 2046}
{"id": "Philoponus_Passim_2047", "series": "CAG", "text": "ἐνεργείᾳ δὲ ἐπ᾿ αὐτοῦ γενομένης τῆς ἐπιστήμης καὶ τὸ ἐπιστητόν, ἡ σεληνιακὴ ἔκλειψις, ἐνεργείᾳ γεγένηται.", "seq": 2047}
{"id": "Philoponus_Passim_2048", "series": "CAG", "text": "τὰ αὐτὰ πάλιν καὶ ἐπὶ τῆς αἰσθήσεως καὶ τοῦ αἰσθητοῦ ἐροῦμεν.", "seq": 2048}
{"id": "Philoponus_Passim_2049", "series": "CAG", "text": "καὶ νῦν δὲ τὸν τοῦ κύκλου τετραγωνισμὸν εἰ μὲν οἷόν τέ ἐστιν εὑρεθῆναι, νῦν δῆλον ὅτι δυνάμει ἐπιστητός ἐστι καὶ ἡ ἐπιστήμη αὐτοῦ δυνάμει ἔσται.", "seq": 2049}
{"id": "Philoponus_Passim_2050", "series": "CAG", "text": "εἰ δὲ μὴ ἐνδέχεται αὐτὸν εὑρεθῆναι πώποτε ὑπὸ ἀνθρώπων, οὐδὲ δυνάμει ἔσται ἐπιστητόν, ἀλλ᾿ ὡς πρᾶγμα μὲν ἔστιν, ἐπιστητὸν δὲ οὐδὲ δυνάμει ἐστίν, ὥσπερ οὐδὲ δυνάμει ἐστὶν ἐπιστητὸς ἀνθρώποις ὁ τῆς ψάμμου ἀριθμός.", "seq": 2050}
{"id": "Philoponus_Passim_2051", "series": "CAG", "text": "διὰ τούτου δὲ τοῦ λόγου κἀκεῖνο τὸ ἄπορον ἐπιλυόμεθα τὸ ἐπιφερόμενον ἡμῖν παρὰ τῶν νομικῶν·", "seq": 2051}
{"id": "Philoponus_Passim_2052", "series": "CAG", "text": "φασὶ γὰρ ἐκεῖνοι εἶναι δοῦλον ἀδέσποτον·", "seq": 2052}
{"id": "Philoponus_Passim_2053", "series": "CAG", "text": "οἷον ἀποθνήσκων τις, φασίν, εἶπε κατὰ διαθήκας ὅτι ὁ δεῖνα ἐὰν τόδε ποιήσῃ, λαμβανέτω τόνδε τὸν ἐμὸν δοῦλον οἰκέτην·", "seq": 2053}
{"id": "Philoponus_Passim_2054", "series": "CAG", "text": "ἰδοὺ οὖν, φασίν, ἐνταῦθα ἐν ὅσῳ οὐκ ἐξανύει τὸ προσταχθὲν ὁ κληρονομήσας, ἔστιν ὁ δοῦλος ἀδέσποτος.", "seq": 2054}
{"id": "Philoponus_Passim_2055", "series": "CAG", "text": "φαμὲν οὖν ὅτι κἀνταῦθα τὸ δυνάμει καὶ τὸ ἐνεργείᾳ ἐπιλύεται τὴν ἀπορίαν·", "seq": 2055}
{"id": "Philoponus_Passim_2056", "series": "CAG", "text": "οὔτε γὰρ ἐκεῖνος δεσπότης ἐστὶν ἐνεργείᾳ οὔτε οὗτος δοῦλος, ἀλλ᾿ ἑκάτερος δυνάμει.", "seq": 2056}
{"id": "Philoponus_Passim_2057", "series": "CAG", "text": "ἐπειδὰν δὲ τὸ προσταχθὲν ὁ κληρονόμος ποιήσῃ καὶ γένηται ἐνεργείᾳ δεσπότης, τότε καὶ ὁ καταλειφθεὶς οἰκέτης ἐνεργείᾳ δοῦλος γενήσεται.", "seq": 2057}
{"id": "Philoponus_Passim_2058", "series": "CAG", "text": "ὥστε ὑγιὴς ὁ λόγος ἐπὶ πάντων ὁ λέγων τὰ πρός τι ἅμα τῇ φύσει εἶναι.", "seq": 2058}
{"id": "Philoponus_Passim_2059", "series": "CAG", "text": "8a13 Ἔχει δὲ ἀπορίαν πότερον οὐδεμία οὐσία τῶν πρός τι λέγεται.", "seq": 2059}
{"id": "Philoponus_Passim_2060", "series": "CAG", "text": "Πληρώσας τὸν τῶν παλαιῶν περὶ τῶν πρός τι ὁρισμὸν καὶ συναγωνισάμενος αὐτῷ ὡς ἐνῆν μάλιστα, εἶτα καὶ τὰ παρακολουθήματα τῶν πρός τι εἰρηκὼς καὶ μέλλων τὸν ἴδιον ὁρισμὸν ἀποδοῦναι, πρότερον τὸ παρακολουθοῦν ἄτοπον τῷ ἀποδεδομένῳ ὁρισμῷ ἐντεῦθεν ἄρχεται διελέγχειν.", "seq": 2060}
{"id": "Philoponus_Passim_2061", "series": "CAG", "text": "ἔστι δὲ τὸ ἄτοπον τὸ τὰ μέρη τῶν δευτέρων οὐσιῶν κατὰ τὸν ἀποδοθέντα ὁρισμὸν πρός τι εὑρίσκεσθαι, τοῦτ᾿ ἔστι τὴν οὐσίαν συμβεβηκός·", "seq": 2061}
{"id": "Philoponus_Passim_2062", "series": "CAG", "text": "τῶν γὰρ δέκα κατηγοριῶν, ὡς πολλάκις εἴρηται, μία μέν ἐστιν οὐσία, αἱ δὲ ἐννέα τοῦ συμβεβηκότος, ὧν μία ἡ τῶν πρός τι.", "seq": 2062}
{"id": "Philoponus_Passim_2063", "series": "CAG", "text": "εἰ οὖν τὰ μέρη τῶν οὐσιῶν πρός τι, δῆλον ὅτι καὶ συμβεβηκότα ἂν εἴη·", "seq": 2063}
{"id": "Philoponus_Passim_2064", "series": "CAG", "text": "εἰ δὲ τὰ μέρη συμβεβηκότα, καὶ τὸ ὅλον ἐξ ἀνάγκης (ἐκ γὰρ τῶν μερῶν τὸ ὅλον συνέστηκεν)·", "seq": 2064}
{"id": "Philoponus_Passim_2065", "series": "CAG", "text": "οὐκοῦν καὶ ἡ οὐσία συμβεβηκὸς ἔσται, οὗ τί ἀτοπώτερον;", "seq": 2065}
{"id": "Philoponus_Passim_2066", "series": "CAG", "text": "διαίρεσις δὲ τῆς οὐσίας ἡμῖν ἐνταῦθα παραδίδοται τοιαύτη·", "seq": 2066}
{"id": "Philoponus_Passim_2067", "series": "CAG", "text": "ἡ οὐσία ἢ καθόλου ἐστὶν ἢ μερικὴ ἢ ὅλον ἢ μέρος.", "seq": 2067}
{"id": "Philoponus_Passim_2068", "series": "CAG", "text": "τεσσάρων οὖν ὄντων τμημάτων ἓξ πάλιν γίνονται συζυγίαι, καὶ αἱ μὲν δύο, ὡς πολλάκις εἴρηται, ἀσύστατοι αἱ τὰ ἐναντία συνάγουσαι (οὐ γὰρ δύναται τὸ αὐτὸ κατὰ τὸ αὐτὸ καὶ καθόλου εἶναι καὶ μερικόν, καὶ ὅλον καὶ μέρος), συνίστανται δὲ αἱ λοιπαὶ τέσσαρες, αἵ τε ὑπάλληλοί φημι καὶ αἱ διαγώνιοι·", "seq": 2068}
{"id": "Philoponus_Passim_2069", "series": "CAG", "text": "ἢ γὰρ τὸ καθόλου τῷ ὅλῳ συμπλεκόμενον ποιεῖ τὸν ἁπλῶς ἄνθρωπον, ὃς καὶ καθόλου ἐστὶ (κατηγορεῖται γὰρ κατὰ τῶν ἀτόμων καὶ περιέχει αὐτά) καὶ ὅλον τί ἐστι·", "seq": 2069}
{"id": "Philoponus_Passim_2070", "series": "CAG", "text": "τῶν οἰκείων γὰρ μερῶν ὁλότης τίς ἐστιν, οἷον ζῴου καὶ λογικοῦ.", "seq": 2070}
{"id": "Philoponus_Passim_2071", "series": "CAG", "text": "πάλιν τὸ καθόλου συμπλεκόμενον τῷ μέρει ποιεῖ τὸ καθόλου μέρος, οἷον ἁπλῶς κεφαλὴν καὶ ἁπλῶς χεῖρα·", "seq": 2071}
{"id": "Philoponus_Passim_2072", "series": "CAG", "text": "καθόλου μέν, ὅτι κατὰ πάσης μερικῆς κεφαλῆς ἢ χειρὸς κατηγορεῖται, μέρος δέ, διότι ἕν τι τῶν τοῦ ζῴου μερῶν ἐστι.", "seq": 2072}
{"id": "Philoponus_Passim_2073", "series": "CAG", "text": "τὸ δὲ μερικὸν συμπλεκόμενον τῷ ὅλῳ ποιεῖ τὸν τινὰ ἄνθρωπον, οἷον Σωκράτην, ὅστις μερικόν ἐστι, διότι κατ᾿ οὐδενὸς κατηγορεῖται, ὅλον δὲ ὡς τῶν οἰκείων μερῶν περιεκτικόν.", "seq": 2073}
{"id": "Philoponus_Passim_2074", "series": "CAG", "text": "πάλιν τὸ μερικὸν συμπλεκόμενον τῷ μέρει ποιεῖ τὴν τινὰ κεφαλὴν ἢ τὴν τινὰ χεῖρα, οἷον Σωκράτους·", "seq": 2074}
{"id": "Philoponus_Passim_2075", "series": "CAG", "text": "αὕτη γὰρ μερικὴ μέν, ὅτι Σωκράτους μόνου, μέρος δέ, ὅτι ἐν τῇ ὁλότητι αὐτοῦ θεωρεῖται·", "seq": 2075}
{"id": "Philoponus_Passim_2076", "series": "CAG", "text": "ἐν τούτῳ γὰρ διαφέρει τὸ μέρος τοῦ μερικοῦ, ὅτι τὸ μὲν μερικὸν πλείοσιν ὑπάρχει, τὸ δὲ μέρος ἑνὶ μόνῳ.", "seq": 2076}
{"id": "Philoponus_Passim_2077", "series": "CAG", "text": "Τούτων αἱ μὲν τρεῖς, φησίν, οὐκ ἂν ὑπονοηθεῖεν τῶν πρός τι, ἡ δὲ μία ἡ τοῦ καθόλου μέρους, ὅ ἐστι κεφαλὴ χείρ, ὅσον ἐπὶ τῷ ἀποδεδομένῳ τῶν πρός τι ὁρισμῷ δόξειεν εἶναι τῶν πρός τι.", "seq": 2077}
{"id": "Philoponus_Passim_2078", "series": "CAG", "text": "καὶ ὅτι μέν, φησίν, ἡ πρώτη συζυγία οὐκ ἔστι τῶν πρός τι, πρόδηλον·", "seq": 2078}
{"id": "Philoponus_Passim_2079", "series": "CAG", "text": "ὁ γὰρ Σωκράτης οὐ λέγεται ἄλλου τινὸς εἶναι Σωκράτης.", "seq": 2079}
{"id": "Philoponus_Passim_2080", "series": "CAG", "text": "ἀλλ᾿ οὐδὲ τὸ τούτου μέρος, λέγω δὴ τὸ μερικὸν μέρος, οἷον ἡ τὶς χείρ, οὐδὲ αὐτὴ δόξειεν εἶναι τῶν πρός τι·", "seq": 2080}
{"id": "Philoponus_Passim_2081", "series": "CAG", "text": "οὐδεὶς γὰρ ἐρεῖ ὅτι ἡ τὶς χεὶρ τινός ἐστι τὶς χείρ·", "seq": 2081}
{"id": "Philoponus_Passim_2082", "series": "CAG", "text": "καταγέλαστον γάρ.", "seq": 2082}
{"id": "Philoponus_Passim_2083", "series": "CAG", "text": "ἀλλ᾿ οὐδὲ ἡ δευτέρα ἡ τὸ καθόλου καὶ ὅλον συμπλέκουσα, λέγω δὴ ὁ ἁπλῶς ἄνθρωπος·", "seq": 2083}
{"id": "Philoponus_Passim_2084", "series": "CAG", "text": "οὐδεὶς γὰρ ἐρεῖ ὅτι ὁ ἄνθρωπος τινός ἐστιν ἄνθρωπος οὐδὲ ὁ βοῦς τινὸς βοῦς, ἀλλὰ κτῆμα μὲν εἶναι λέγεταί τινος ὁ βοῦς καὶ ὁ ἄνθρωπος, ὁ ἄνθρωπος δὲ τινὸς εἶναι ἄνθρωπος ἢ ὁ βοῦς τινὸς εἶναι βοῦς οὐκέτι.", "seq": 2084}
{"id": "Philoponus_Passim_2085", "series": "CAG", "text": "μόνως οὖν, φησίν, ἡ τὸ καθόλου καὶ μέρος συμπλέκουσα αὕτη δόξει κατὰ τὸν ἀποδεδομένον ὁρισμὸν τῶν πρός τι εἶναι, ἡ ἁπλῶς λέγω κεφαλὴ καὶ ἡ ἁπλῶς χείρ·", "seq": 2085}
{"id": "Philoponus_Passim_2086", "series": "CAG", "text": "ἡ γὰρ κεφαλὴ τινὸς λέγεται κεφαλὴ καὶ ἡ χεὶρ τινὸς χείρ.", "seq": 2086}
{"id": "Philoponus_Passim_2087", "series": "CAG", "text": "ἐμοὶ δὲ καὶ τὸ μερικὸν καὶ μέρος δοκεῖ τῶν πρός τι εἶναι ὅσον ἐκ τοῦ προαποδοθέντος ὁρισμοῦ·", "seq": 2087}
{"id": "Philoponus_Passim_2088", "series": "CAG", "text": "εἰ γὰρ τῶν πρός τι ἐκεῖνα εἶναι ἐλέγετο ὅσα αὐτὰ ἅπερ ἐστὶν ἑτέρων εἶναι λέγεται, οὐ μόνον δὲ τὸ καθόλου μέρος οἷον ἡ ἁπλῶς χεὶρ τοῦ ἁπλῶς ἀνθρώπου λέγεται εἶναι, ἀλλὰ καὶ ἡ τὶς χεὶρ τοῦ τινὸς ἀνθρώπου λέγεται εἶναι (λέγομεν γὰρ ὅτι ἥδε ἡ χεὶρ Σωκράτους ἐστί), καὶ τούτου μεστὴ καὶ ἡ κοινὴ συνήθεια καὶ ἡ τῶν ἀρχαίων χρῆσις (φαμὲν γὰρ ‘τῇ χειρί μου ἔγραψα’, ‘τὴν χεῖρα τοῦδ᾿ ἔπληξα ἢ τὴν κεφαλήν’,", "seq": 2088}
{"id": "Philoponus_Passim_2089", "series": "CAG", "text": "‘κείνου γὰρ τοιοίδε πόδες τοιαίδε τε χεῖρες’, ‘πάντες δ᾿ ἐσσείοντο πόδες πολυπιδάκου Ἴδης’, ‘κεφαλὴ Διὸς οὐκ ἐπινεύει’)·", "seq": 2089}
{"id": "Philoponus_Passim_2090", "series": "CAG", "text": "ὥστε εἰ καὶ τὸ μερικὸν μέρος τινός ἐστι μέρος, καὶ τοῦτο ἄρα τῶν πρός τι ἔσται.", "seq": 2090}
{"id": "Philoponus_Passim_2091", "series": "CAG", "text": "τὸ δὲ κατὰ τὴν λέξιν δόξαν ἄτοπον ἕπεσθαι εὐχερὲς λῦσαι·", "seq": 2091}
{"id": "Philoponus_Passim_2092", "series": "CAG", "text": "οὐδὲ γὰρ ἀνάγκη λέγειν ὅτι ἡ τὶς χεὶρ τινὸς τίς ἐστι χείρ, ἐπειδὴ μηδὲ τὴν καθόλου χεῖρα τινὸς καθόλου χεῖρα λέγομεν, ἀλλὰ ἀνθρώπου χεῖρα.", "seq": 2092}
{"id": "Philoponus_Passim_2093", "series": "CAG", "text": "οὕτω δὴ οὖν καὶ τὴν τινὰ χεῖρα τινὸς χεῖρα λέγομεν, οἷον Σωκράτους, ἄνευ τοῦ προσδιορισμοῦ.", "seq": 2093}
{"id": "Philoponus_Passim_2094", "series": "CAG", "text": "τὰ οὖν δύο μόρια τοῦ προεκκειμένου διαγράμματος, τό τε καθόλου μέρος καὶ τὸ μερικὸν μέρος, τῶν πρός τι ἔσται καὶ συμβήσεται, ὡς εἶπον, τὴν οὐσίαν συμβεβηκὸς εἶναι.", "seq": 2094}
{"id": "Philoponus_Passim_2095", "series": "CAG", "text": "τοῦτο οὖν, φησί, τὸ ἄτοπον, λέγω δὴ τὸ τὰ μέρη τῶν οὐσιῶν εἶναι τῶν πρός τι, ἀδύνατον ἢ δυσχερὲς λῦσαι κατὰ τὸν προαποδεδομένον τῶν πρός τι ὁρισμόν.", "seq": 2095}
{"id": "Philoponus_Passim_2096", "series": "CAG", "text": "Οὕτω μὲν οὖν διὰ τῆς εἰς ἄτοπον ἀπαγωγῆς διαβάλλει τὸν ἀποδεδομένον ὁρισμόν.", "seq": 2096}
{"id": "Philoponus_Passim_2097", "series": "CAG", "text": "ἡ δὲ εἰς ἄτοπον ἀπαγωγή ἐστιν, ὡς ὅταν ἀποδεῖξαί τι βουλόμενοι λάβωμεν τὸ ἀντικείμενον τούτῳ καὶ τούτῳ ἄτοπόν τι ἀκολουθοῦν δείξωμεν, εἶτα ἐκ τούτου συνάγωμεν ὅτι διὰ τοῦτο ἠκολούθησε τὸ ἄτοπον ἡμῖν, ὅτι ψευδὴς ἡ δεδομένη πρότασις·", "seq": 2097}
{"id": "Philoponus_Passim_2098", "series": "CAG", "text": "οὐδεμιᾷ γὰρ ἀληθεῖ προτάσει ἄτοπόν τι ἀκολουθεῖ·", "seq": 2098}
{"id": "Philoponus_Passim_2099", "series": "CAG", "text": "εἰ δὲ ψευδὴς αὕτη ἡ πρότασις, ἡ ἀντικειμένη ἄρα ταύτῃ ἀληθής.", "seq": 2099}
{"id": "Philoponus_Passim_2100", "series": "CAG", "text": "οἷόν τι λέγω, βουλόμενοι δεῖξαι ὡς ἔστιν ἡ ψυχὴ ἀθάνατος, λαμβάνομεν τὴν ἐναντίαν ταύτῃ πρότασιν τὴν λέγουσαν ὅτι θνητή, εἶτα δείκνυμεν ἄτοπόν τι ταύτῃ ἀκολουθοῦν, ἵν᾿ οὕτως τὸ ἐναντίον κρατύνωμεν·", "seq": 2100}
{"id": "Philoponus_Passim_2101", "series": "CAG", "text": "εἰ γὰρ θνητὴ ἡ ψυχή, οὐκ ἔσται τὰ ὑπὸ γῆν δικαιωτήρια, ἀλλὰ μέχρι τοῦ φαινομένου ἡμῖν ὁ βίος καὶ τῷ σώματι ἡ ψυχὴ συναπόλλυται.", "seq": 2101}
{"id": "Philoponus_Passim_2102", "series": "CAG", "text": "οὐκ ἔσται οὖν οὐδὲ ἀγαθῶν ἔργων ἀμοιβὴ οὐδὲ πονηρῶν ἔκτισις·", "seq": 2102}
{"id": "Philoponus_Passim_2103", "series": "CAG", "text": "εἰ γὰρ ὁρῶμεν ὅτι πολλοὶ τῶν δικαίων ἐν θλίψεσι τὸν πάντα βίον διέζησαν, ἁμαρτωλοὶ δὲ πλεῖστοι ἐν εὐδοξίᾳ πολλῇ καὶ εὐπορίᾳ τὸν βίον κατέλυσαν, οὐκ ἔστι δέ τις μετὰ τὸν βίον τοῦτον ἐξέτασις τῶν βεβιωμένων, μέχρι τούτου μόνου τῆς τῶν ἀνθρώπων ζωῆς περικλειομένης, οὐδεὶς ἄρα τὸ κατ᾿ ἀξίαν ἀπολήψεται, καὶ εἰ οὐδεὶς τὸ κατ᾿ ἀξίαν ἀπολήψεται, οὐκ ἔσται πρόνοια·", "seq": 2103}
{"id": "Philoponus_Passim_2104", "series": "CAG", "text": "εἰ γὰρ ἀγαθοῦ ἄρχοντος πόλιν διοικοῦντος ἔστιν ἰδεῖν πάντα τεταγμένως τὰ ἐν τῇ πόλει γινόμενα καὶ τοὺς μὲν ἀγαθοὺς δωρεαῖς καὶ ἀξιώμασι τιμωμένους, τοὺς δὲ πονηροὺς στηλιτευομένους καὶ ἐν τιμωρίαις διάγοντας, πόσῳ μᾶλλον τοῦ ἀγαθοῦ κατὰ οὐσίαν θεοῦ καὶ μιᾷ ἐπιβολῇ τὰ πάντα γινώσκοντός τε καὶ προνοουμένου τῶν ὅλων οὐδὲν ἄτακτον ἐν τῷ βίῳ γενήσεται;", "seq": 2104}
{"id": "Philoponus_Passim_2105", "series": "CAG", "text": "τοιγαροῦν οὐκ ἔσται πρόνοια, εἰ μὴ ἔσται τῶν βεβιωμένων ἐξέτασις·", "seq": 2105}
{"id": "Philoponus_Passim_2106", "series": "CAG", "text": "ταύτης δὲ τῆς ἀτοπίας τί ἀσεβέστερον;", "seq": 2106}
{"id": "Philoponus_Passim_2107", "series": "CAG", "text": "εἰ γὰρ οὐκ ἔσται πρόνοια, οὐδὲν ἔσται τῶν ὄντων τεταγμένον·", "seq": 2107}
{"id": "Philoponus_Passim_2108", "series": "CAG", "text": "τὸ γὰρ ἀπρονόητον ἄτακτον, ἅτε δὴ ἐκ ταυτομάτου καὶ ὡς ἔτυχε φερόμενον.", "seq": 2108}
{"id": "Philoponus_Passim_2109", "series": "CAG", "text": "ὅτι δὲ οὐκ ἐκ ταυτομάτου ὁ βίος οὐδὲ τυχαῖος, δῆλον ἐντεῦθεν·", "seq": 2109}
{"id": "Philoponus_Passim_2110", "series": "CAG", "text": "τὰ γὰρ ἐκ ταυτομάτου καὶ τύχης σπανιώτατά ἐστι καὶ ἄλλων παρακολουθήματα, τὸ μὲν αὐτόματον τῶν φυσικῶν ὁρμῶν τὸ δὲ τυχαῖον τῶν προαιρετικῶν·", "seq": 2110}
{"id": "Philoponus_Passim_2111", "series": "CAG", "text": "οἷον κατηνέχθη τις λίθος ἄνωθεν φυσικῇ ὁρμῇ ἐπὶ τὸ κάτω φερόμενος καὶ προσραγεὶς τῇ γῇ καὶ τῶν ἐξοχῶν αὐτοῦ περιθραυσθεισῶν γέγονεν εἰς καθέδραν ἐπιτήδειος·", "seq": 2111}
{"id": "Philoponus_Passim_2112", "series": "CAG", "text": "τὸ οὖν ἐπιτήδειον αὐτὸν γενέσθαι πρὸς καθέδραν ἐκ ταυτομάτου λέγεται γεγενῆσθαι, διότι τῇ ἐπὶ τὸ κάτω φυσικῇ ὁρμῇ τοῦ λίθου ἐπηκολούθησε.", "seq": 2112}
{"id": "Philoponus_Passim_2113", "series": "CAG", "text": "σπανίως δὲ καταφερόμενος λίθος ἄνωθεν ἐπιτήδειος γίνεται πρὸς καθέδραν.", "seq": 2113}
{"id": "Philoponus_Passim_2114", "series": "CAG", "text": "πάλιν ἵππος διψήσας ἐν πολέμῳ τοῦ δεσπότου ἀποσκιρτήσας ἔδραμε πιεῖν καὶ συμβολῆς γενομένης καὶ τοῦ δεσπότου τετελευτηκότος μετὰ πάντων σώζεται ὁ ἵππος.", "seq": 2114}
{"id": "Philoponus_Passim_2115", "series": "CAG", "text": "ἐκ ταυτομάτου οὖν σεσῶσθαι λέγεται ὁ ἵππος.", "seq": 2115}
{"id": "Philoponus_Passim_2116", "series": "CAG", "text": "σπανίως δὲ ἵππος ἀποσείεται τὸν δεσπότην ἐν πολέμῳ καὶ σώζεται διὰ τοῦτο.", "seq": 2116}
{"id": "Philoponus_Passim_2117", "series": "CAG", "text": "τὸ δὲ τυχαῖον καὶ αὐτὸ σπάνιον καὶ ταῖς προαιρετικαῖς ὁρμαῖς παρακολουθοῦν·", "seq": 2117}
{"id": "Philoponus_Passim_2118", "series": "CAG", "text": "οἷον κατῆλθέ τις <ἐπὶ τὸ> λούσασθαι ἢ εὔξασθαι καὶ περιέτυχε βιβλίῳ πωλουμένῳ, ὃ πάλαι ἐζήτει, καὶ ἠγόρασε.", "seq": 2118}
{"id": "Philoponus_Passim_2119", "series": "CAG", "text": "τοῦτο τυχαῖον·", "seq": 2119}
{"id": "Philoponus_Passim_2120", "series": "CAG", "text": "οὐ γὰρ ἔκ τινος προνοίας, οὐδὲ φοιτήσας ἔνθα πιπράσκεσθαι βιβλία εἴωθεν, ἠγόρασε τὸ βιβλίον.", "seq": 2120}
{"id": "Philoponus_Passim_2121", "series": "CAG", "text": "καὶ τοῦτο δὲ τῶν σπανιωτάτων.", "seq": 2121}
{"id": "Philoponus_Passim_2122", "series": "CAG", "text": "τὰ μὲν οὖν ἐκ ταυτομάτου καὶ τυχαῖα σπανιώτατα, τὰ δὲ τεχνητὰ καὶ φυσικὰ καὶ ὅλως τὰ ἐκ προνοίας γινόμενα τῶν ὡς ἐπὶ τὸ πολὺ γινομένων ἐστὶν ἢ καὶ ὡς ἐπὶ πᾶν·", "seq": 2122}
{"id": "Philoponus_Passim_2123", "series": "CAG", "text": "ὡς γὰρ ἐπὶ τὸ πολὺ ὁ τέκτων τυγχάνει τοῦ οἰκείου τέλους καὶ ὁ οἰκοδόμος ἢ ἀποτυγχάνει.", "seq": 2123}
{"id": "Philoponus_Passim_2124", "series": "CAG", "text": "καὶ ὁ ἰατρὸς μᾶλλον ὑγιάζει ἢ οὐχ ὑγιάζει·", "seq": 2124}
{"id": "Philoponus_Passim_2125", "series": "CAG", "text": "εἰ γὰρ ἐξ ἴσης ὑγίαζέ τε καὶ οὐχ ὑγίαζεν, οὐδ᾿ ἄν τις αὐτὸν μετεκαλεῖτο, καὶ ἔτι μᾶλλον, εἰ ἐπ᾿ ἔλαττον ὑγίαζε.", "seq": 2125}
{"id": "Philoponus_Passim_2126", "series": "CAG", "text": "καὶ ἡ φύσις δὲ ὡς ἐπὶ τὸ πολὺ πενταδάκτυλον ποιεῖ σπανιώτατα δὲ ἑξαδάκτυλον (καὶ τοῦτο διὰ τὴν πλεονεξίαν τῆς ὕλης), ἀεὶ ἡ σελήνη μειοῦται μὲν τῇ συνόδῳ τῇ πρὸς τὸν ἥλιον αὔξεται δὲ τῇ ἀποστάσει, ἀεὶ ὁ ἥλιος ἐν αἰγοκέρῳ γινόμενος ποιεῖ χειμερινὰς τροπάς, ἀεὶ ἐν καρκίνῳ τροπὰς θερινάς, καὶ οὐκ ἄλλοτε ἄλλως, καὶ τὸ πῦρ ἀεὶ ἀνωφερὲς τὸ δὲ ὕδωρ ἐπὶ τὸ κάτω ῥεῖ, καὶ ἐπὶ πάντων ὁμοίως τῶν τεχνητῶν καὶ φυσικῶν, καὶ ὅλως τῶν ἐκ προνοίας τὸ ἀεὶ ἢ ὡς ἐπὶ τὸ πολὺ ἔστιν ἰδεῖν καὶ οὐδέποτε τὸ ἐναντίον.", "seq": 2126}
{"id": "Philoponus_Passim_2127", "series": "CAG", "text": "δῆλον οὖν ὅτι οὐκ ἔστιν ἐκ ταυτομάτου ὁ κόσμος, οὐδὲ τὰ τούτου μέρη.", "seq": 2127}
{"id": "Philoponus_Passim_2128", "series": "CAG", "text": "εἰ δὲ οὐκ ἔστιν ἐκ ταυτομάτου, ἔχει δηλονότι τινὰ αἰτίαν ἑαυτοῦ προκαθεζομένην καὶ εὐρύθμως τὰ κατ᾿ αὐτὸν τάττουσαν, ἥνπερ πρόνοιαν λέγομεν.", "seq": 2128}
{"id": "Philoponus_Passim_2129", "series": "CAG", "text": "προνοίας οὖν οὔσης ἕκαστος ἐξ ἀνάγκης τὸ κατ᾿ ἀξίαν ἀπολήψεται.", "seq": 2129}
{"id": "Philoponus_Passim_2130", "series": "CAG", "text": "εἰ δὲ τοῦτο ἀληθές, ὁρῶμεν δέ, ὡς ἔφθην εἰπών, πολλοὺς τὰ ἐναντία τῶν οἰκείων πράξεων ὑπομένοντας ἐν τῷ τῇδε βίῳ ὅσον ἐκ τῶν φαινομένων, οὐκ ἄρα μέχρι τούτου τοῦ βίου ἡ τῶν ἀνθρώπων ζωὴ περιώρισται.", "seq": 2130}
{"id": "Philoponus_Passim_2131", "series": "CAG", "text": "ἔσται οὖν τις πάντως μετὰ τὸν τῇδε βίον τῶν βεβιωμένων ἐξέτασις, ἐν ᾗ ἡ πρόνοια ἀποκληρώσει ἑκάστῳ τὸ κατ᾿ ἀξίαν.", "seq": 2131}
{"id": "Philoponus_Passim_2132", "series": "CAG", "text": "εἰ δὲ τοῦτο, ἀθάνατος ἄρα ἡ ψυχή ἐστι καὶ οὐ συμφθείρεται τῷ σώματι·", "seq": 2132}
{"id": "Philoponus_Passim_2133", "series": "CAG", "text": "δεῖ γὰρ αὐτὴν ὑπομεῖναι λυομένου τοῦ σώματος καὶ μὴ φθείρεσθαι, ἵνα ἀπολάβῃ μετὰ τὸν τῇδε βίον τὸ κατ᾿ ἀξίαν.", "seq": 2133}
{"id": "Philoponus_Passim_2134", "series": "CAG", "text": "σκόπει οὖν ἐνταῦθα πῶς βουλόμενοι δεῖξαι τὴν ψυχὴν ἀθάνατον ὑπεθέμεθα τὴν ἐναντίαν ταύτῃ πρότασιν τὴν λέγουσαν ὅτι θνητή, καὶ ἐδείξαμεν ταύτῃ ἄτοπόν τι παρακολουθοῦν τὸ εἰσάγεσθαι ἐκ τούτου μὴ εἶναι πρόνοιαν, καὶ οὕτως ὅτι ἀθάνατος κατεσκευάσαμεν·", "seq": 2134}
{"id": "Philoponus_Passim_2135", "series": "CAG", "text": "εἰ γὰρ ἄτοπον ἀκολουθεῖ τῷ λέγειν θνητὴν τὴν ψυχήν, τῇ δ᾿ ἀληθεῖ προτάσει οὐδὲν ἄτοπον οἷόν τε ἀκολουθεῖν, ψευδὴς ἄρα αὕτη.", "seq": 2135}
{"id": "Philoponus_Passim_2136", "series": "CAG", "text": "ἀληθὴς οὖν ἡ ταύτῃ ἐναντία ἡ λέγουσα ὅτι ἀθάνατος·", "seq": 2136}
{"id": "Philoponus_Passim_2137", "series": "CAG", "text": "τὸ γὰρ ἀντικείμενον τῷ ψεύδει ἀληθές ἐστιν ἐξ ἀνάγκης.", "seq": 2137}
{"id": "Philoponus_Passim_2138", "series": "CAG", "text": "Αὕτη μὲν οὖν ἐστιν ἡ εἰς ἄτοπον ἀπαγωγή, ᾗ καὶ ἐνταῦθα κέχρηται ὁ φιλόσοφος·", "seq": 2138}
{"id": "Philoponus_Passim_2139", "series": "CAG", "text": "αὐτὸς μὲν γὰρ βούλεται τὰ πρός τι τῷ εἶναι ἑτέρων χαρακτηρίζεσθαι, ὑποτίθεται δὲ τὸ ἐναντίον τούτῳ καὶ ἄλλοις δοκοῦν, λέγω δὴ τὸ τῷ λέγεσθαι αὐτὰ ἑτέρων χαρακτηρίζεσθαι, καὶ δείκνυσι τὸ παρακολουθοῦν ἄτοπον·", "seq": 2139}
{"id": "Philoponus_Passim_2140", "series": "CAG", "text": "τοῦτο δέ ἐστι τὸ καὶ τὰ μέρη τῶν δευτέρων οὐσιῶν πρός τι εἶναι·", "seq": 2140}
{"id": "Philoponus_Passim_2141", "series": "CAG", "text": "ἑτέρων γὰρ καὶ αὐτὰ λέγεται.", "seq": 2141}
{"id": "Philoponus_Passim_2142", "series": "CAG", "text": "καὶ οὕτως ὡς ψευδῆ τὴν δόξαν ταύτην ἀθετήσας τὴν ἰσίαν κρατύνει.", "seq": 2142}
{"id": "Philoponus_Passim_2143", "series": "CAG", "text": "συμπεραίνων δὲ ὧδέ πως τὰ εἰρημένα φησίν·", "seq": 2143}
{"id": "Philoponus_Passim_2144", "series": "CAG", "text": "8a28 Εἰ μὲν οὖν ἱκανῶς ὁ τῶν πρός τι ὁρισμὸς ἀποδέδοται, ἢ τῶν πάνυ χαλεπῶν ἢ τῶν ἀδυνάτων ἐστὶ τὸ δεῖξαι ὡς οὐδεμία οὐσία τῶν πρός τι λέγεται.", "seq": 2144}
{"id": "Philoponus_Passim_2145", "series": "CAG", "text": "Τοῦτο δὲ εἶπε, λέγω δὴ τὸ τῶν πάνυ χαλεπῶν, διὰ τὸ δοκεῖν πώς τινα ἀπολογίαν ἔχειν·", "seq": 2145}
{"id": "Philoponus_Passim_2146", "series": "CAG", "text": "ἔφη γὰρ ὁ ὁρισμὸς ‘αὐτὰ ἅπερ ἐστὶν ἑτέρων εἶναι λέγεται’·", "seq": 2146}
{"id": "Philoponus_Passim_2147", "series": "CAG", "text": "ἡ οὖν κεφαλὴ τῶν πρός τι ἐστὶν οὐχ ὡς κεφαλὴ ἢ σῶμα, ἀλλὰ καθὸ μέρος·", "seq": 2147}
{"id": "Philoponus_Passim_2148", "series": "CAG", "text": "τὸ γὰρ μέρος τοῦ ὅλου μέρος.", "seq": 2148}
{"id": "Philoponus_Passim_2149", "series": "CAG", "text": "ἀλλὰ τοῦτο οὐκ ἀληθές·", "seq": 2149}
{"id": "Philoponus_Passim_2150", "series": "CAG", "text": "ἡ γὰρ κεφαλὴ οὐ καθὸ μέρος ἑτέρου λέγεται, ἀλλὰ κατὰ αὐτὸ τοῦτο τὸ εἶναι κεφαλή.", "seq": 2150}
{"id": "Philoponus_Passim_2151", "series": "CAG", "text": "ὥστε καὶ τὰ μέρη τῶν οὐσιῶν τῶν πρός τι εὑρεθήσονται κατὰ τὸν προαποδοθέντα ὁρισμὸν τὸν λέγοντα τὰ πρός τι τῷ ἑτέρων λέγεσθαι χαρακτηρίζεσθαι·", "seq": 2151}
{"id": "Philoponus_Passim_2152", "series": "CAG", "text": "καὶ γὰρ ἡ κεφαλὴ τινὸς λέγεται κεφαλή.", "seq": 2152}
{"id": "Philoponus_Passim_2153", "series": "CAG", "text": "ὥστε ἀδύνατον τὸν ἀποδοθέντα τῶν πρός τι ὁρισμὸν ἐκφυγεῖν ταύτην τὴν ἀτοπίαν·", "seq": 2153}
{"id": "Philoponus_Passim_2154", "series": "CAG", "text": "διὰ τοῦτο γὰρ ἐπειδὴ εἶπε τῶν πάνυ χαλεπῶν, ἐπήγαγε καὶ τὸ ἀδυνάτων, δεικνὺς τὸ ἀναπολόγητον τῆς ἀτοπίας.", "seq": 2154}
{"id": "Philoponus_Passim_2155", "series": "CAG", "text": "8a31 Εἰ δὲ μὴ ἱκανῶς, ἀλλ᾿ ἔστι τὰ πρός τι οἷς τὸ εἶναι ταὐτόν ἐστι τῷ πρός τί πως ἔχειν, ἴσως ἂν ῥηθείη τι πρὸς ταῦτα.", "seq": 2155}
{"id": "Philoponus_Passim_2156", "series": "CAG", "text": "Νῦν τὸν ἴδιον τῶν πρός τι ὁρισμὸν ἐκτίθεται καί φησιν εἰ δὲ μὴ ἱκανῶς, τοῦτ᾿ ἔστιν εἰ μὴ αὐτάρκως καὶ ἀνελλιπῶς ὁ τῶν πρός τι ὁρισμὸς ὑπὸ τῶν παλαιῶν ἡμῖν παρεδόθη, ἀλλ᾿ ἔστι τὰ πρός τι οἷς τὸ εἶναι ταὐτόν ἐστι τῷ πρός τί πως ἔχειν, τοῦτ᾿ ἔστιν οἷς ἡ ὕπαρξις ἐν τούτῳ ἐστὶν ἐν τῷ πρὸς ἕτερον ἀναδέχεσθαί τινα σχέσιν, ἴσως ἄν, φησί, ῥηθείη τι πρὸς ταῦτα.", "seq": 2156}
{"id": "Philoponus_Passim_2157", "series": "CAG", "text": "πρὸς ποῖα;", "seq": 2157}
{"id": "Philoponus_Passim_2158", "series": "CAG", "text": "πρὸς τὰς ἀπορίας τὰς εἰρημένας ὅτι καὶ τὰ μέρη τῶν οὐσιῶν τῶν πρός τι εἶναι δόξουσιν·", "seq": 2158}
{"id": "Philoponus_Passim_2159", "series": "CAG", "text": "εἰ γὰρ οὕτω, φησίν, ἀποδοθείη ὁ ὁρισμὸς ὥσπερ νῦν ἀποδεδώκαμεν, εὐχερῶς ἀπαντῆσαι δυνάμεθα πρὸς τὰς εἰρημένας ἀτοπίας.", "seq": 2159}
{"id": "Philoponus_Passim_2160", "series": "CAG", "text": "τίς δὲ ἡ ἀπάντησις, αὐτὸς ἐπήγαγεν·", "seq": 2160}
{"id": "Philoponus_Passim_2161", "series": "CAG", "text": "ὁ δὲ πρότερος ὁρισμὸς παρακολουθεῖ μὲν πᾶσι τοῖς πρός τι, οὐ μὴν ταὐτό γέ ἐστι τῷ πρός τι αὐτοῖς εἶναι τὸ αὐτὰ ἅπερ ἐστὶν ἑτέρων λέγεσθαι·", "seq": 2161}
{"id": "Philoponus_Passim_2162", "series": "CAG", "text": "οὐ γὰρ εἴ τι, φησί, λέγεται ἑτέρου, τούτου καὶ τὸ εἶναι ἐν τούτῳ ἐστὶν ἐν τῷ πρὸς ἕτερον λέγεσθαι·", "seq": 2162}
{"id": "Philoponus_Passim_2163", "series": "CAG", "text": "εἴ τι μὲν γάρ ἐστιν ἑτέρου, τοῦτο καὶ ἑτέρου λέγεται, οὐκ εἴ τι δὲ ἑτέρου λέγεται, ἤδη τοῦτο καὶ ἑτέρου ἐστίν·", "seq": 2163}
{"id": "Philoponus_Passim_2164", "series": "CAG", "text": "ὁ μὲν γὰρ πατὴρ υἱοῦ ὢν πατὴρ ἐν τούτῳ ἔχει τὸ εἶναι ἐν τῷ πατὴρ υἱοῦ εἶναι, καὶ μέντοι καὶ υἱοῦ λέγεται πατήρ.", "seq": 2164}
{"id": "Philoponus_Passim_2165", "series": "CAG", "text": "ἡ δὲ κεφαλὴ ζῴου λεγομένη κεφαλὴ οὐκέτι καὶ τὸ εἶναι ἐν τούτῳ ἔχει ἐν τῷ λέγεσθαι ζῴου·", "seq": 2165}
{"id": "Philoponus_Passim_2166", "series": "CAG", "text": "καὶ ἀποτμηθεῖσα γὰρ τοῦ ζῴου ἔτι κεφαλὴ λέγεταί τε καὶ ἔστιν.", "seq": 2166}
{"id": "Philoponus_Passim_2167", "series": "CAG", "text": "ὁ δὲ πατὴρ ἀποτμηθεὶς υἱοῦ οὔτε ἔστι πατὴρ οὔτε πρὸς υἱὸν ἔτι λέγεται.", "seq": 2167}
{"id": "Philoponus_Passim_2168", "series": "CAG", "text": "ὥστε εἰκότως εἴρηται παρακολουθεῖν τοῖς πρός τι τὸν πρότερον ὁρισμόν, τὸν δὲ δεύτερον τῷ προτέρῳ μηκέτι.", "seq": 2168}
{"id": "Philoponus_Passim_2169", "series": "CAG", "text": "τοῦτο καὶ Ὅμηρος διδάσκει", "seq": 2169}
{"id": "Philoponus_Passim_2170", "series": "CAG", "text": "μηκέτ᾿ ἔπειτ᾿ Ὀδυσῆϊ κάρη ὤμοισιν ἐπείη, μηδ᾿ ἔτι Τηλεμάχοιο πατὴρ κεκλημένος εἴην·", "seq": 2170}
{"id": "Philoponus_Passim_2171", "series": "CAG", "text": "μηκέτι γὰρ ὢν πατὴρ τῷ μηκέτι εἶναι οὐδὲ καλεῖσθαι δύναται·", "seq": 2171}
{"id": "Philoponus_Passim_2172", "series": "CAG", "text": "ὥστε τοῦ εἶναι τὸ λέγεσθαι παρακολούθημα, καὶ οὐκ ἔμπαλιν.", "seq": 2172}
{"id": "Philoponus_Passim_2173", "series": "CAG", "text": "εἰ δὲ τοῦτο οὕτως ἔχει, οὐκ ἄρα τὰ μέρη τῶν οὐσιῶν ἑτέρων εἶναι λεγόμενα τῶν πρός τι κατὰ τοῦτο ἔσται.", "seq": 2173}
{"id": "Philoponus_Passim_2174", "series": "CAG", "text": "Ζητητέον δὲ τί δή ποτε ἐν τῷ ὁρισμῷ τῶν πρός τι τὰ πρός τι παρέλαβε λέγων τῷ πρός τί πως ἔχειν·", "seq": 2174}
{"id": "Philoponus_Passim_2175", "series": "CAG", "text": "οὐ δεῖ γὰρ ἐν τῷ ὁρισμῷ τὸ ὁριστὸν παραλαμβάνειν.", "seq": 2175}
{"id": "Philoponus_Passim_2176", "series": "CAG", "text": "λέγομεν τοίνυν πρὸς τοῦτο ὅτι τὰ πρός τι διττά ἐστι·", "seq": 2176}
{"id": "Philoponus_Passim_2177", "series": "CAG", "text": "λέγονται γὰρ πρός τι καὶ αὐτὰ τὰ πράγματα ἐν οἷς ἡ σχέσις γίνεται καὶ αὐτὴ δὲ ἡ σχέσις, ὥσπερ καὶ ἡ ποῦ κατηγορία καὶ ἡ ποτὲ σημαίνει μὲν καὶ αὐτὰ τὰ πράγματα, τήν τε οὐσίαν λέγω καὶ τὸν χρόνον ἢ τὸν τόπον, σημαίνει δὲ καὶ αὐτὴν ψιλὴν τὴν σχέσιν, ἣν ἔχει ἡ οὐσία πρὸς τὸν χρόνον ἢ τὸν τόπον·", "seq": 2177}
{"id": "Philoponus_Passim_2178", "series": "CAG", "text": "ἐπειδὴ οὖν σαφέστερά εἰσι τὰ πράγματα τῆς σχέσεως ἅτε αἰσθητὰ ὄντα, διὰ τοῦτο ἐν τῷ ὁρισμῷ αὐτὰ παραλαμβάνει, ἵνα ἐκ τῶν σαφεστέρων τὴν διδασκαλίαν ποιήσηται.", "seq": 2178}
{"id": "Philoponus_Passim_2179", "series": "CAG", "text": "8a35 Ἐκ δὲ τούτων δῆλόν ἐστιν ὅτι ἐάν τις εἰδῇ τι ὡρισμένως τῶν πρός τι, κἀκεῖνο πρὸς ὃ λέγεται ὡρισμένως εἴσεται.", "seq": 2179}
{"id": "Philoponus_Passim_2180", "series": "CAG", "text": "Τὸν ἴδιον τῶν πρός τι ὁρισμὸν ἀποδεδωκὼς ἐκ τούτου πόρισμά τι συνάγει κατὰ τοὺς γεωμέτρας.", "seq": 2180}
{"id": "Philoponus_Passim_2181", "series": "CAG", "text": "πόρισμα δὲ λέγουσιν ἐκεῖνοι ὃ τῇ ἑτέρου ἀποδείξει συναναφαίνεται, ὥσπερ πρότερον ζητοῦσιν ἡμῖν ἀποδεῖξαι τὴν τῆς ψυχῆς ἀθανασίαν συνανεφάνη ὅτι ἔστι πρόνοια.", "seq": 2181}
{"id": "Philoponus_Passim_2182", "series": "CAG", "text": "κἀνταῦθα οὖν ζητοῦσιν ἡμῖν τὸν ἀληθῆ τῶν πρός τι ὁρισμὸν συνανεφάνη τούτῳ ὅτι ἐάν τις τῶν πρός τι τὸ ἕτερον εἰδῇ ὡρισμένως, καὶ τὸ ἕτερον ὡρισμένως εἴσεται, κἂν τὸ ἕτερον ἀορίστως οἶδε, καὶ τὸ ἕτερον ἀορίστως εἴσεται·", "seq": 2182}
{"id": "Philoponus_Passim_2183", "series": "CAG", "text": "εἰ γάρ τις ἐπίσταται τὸν Σωφρονίσκον πατέρα, καὶ τὸν Σωκράτην εἴσεται ὅτι υἱός·", "seq": 2183}
{"id": "Philoponus_Passim_2184", "series": "CAG", "text": "εἰ γὰρ μὴ οἶδε Σωκράτην ὅτι υἱός, οὐδὲ εἰ πατήρ ἐστι Σωφρονίσκος εἴσεται.", "seq": 2184}
{"id": "Philoponus_Passim_2185", "series": "CAG", "text": "φασὶ δὲ πρὸς τοῦτό τινες ὅτι εἴ τις ὅλον τὸ σῶμα περικαλύπτοιτο, τὴν δὲ κεφαλὴν ἢ τὴν χεῖρα ἔχει γυμνήν, ἐπὶ τούτου τὸ μὲν μέρος, τὴν χεῖρα εἰ τύχοι ἢ τὴν κεφαλήν, ἔστιν ὡρισμένως εἰδέναι (ἴσμεν γὰρ ὅτι πάντως ἐστὶ μέρος), τίνος μέντοι γε μέρος, οὐκ ἴσμεν·", "seq": 2185}
{"id": "Philoponus_Passim_2186", "series": "CAG", "text": "οὐκ ἄρα, φασίν, ὁ τὸ ἕτερον τῶν πρός τι ὡρισμένως εἰδὼς καὶ τὸ λοιπὸν ὡρισμένως εἴσεται.", "seq": 2186}
{"id": "Philoponus_Passim_2187", "series": "CAG", "text": "ἀλλὰ λέγομεν ὅτι ὡς μὲν κεφαλὴν ἢ ὡς χεῖρα ὡρισμένως γινώσκομεν, ὡς δὲ μέρος οὐκέτι ὡρισμένως, ἀορίστως δέ·", "seq": 2187}
{"id": "Philoponus_Passim_2188", "series": "CAG", "text": "οὐ γὰρ ἴσμεν τίνος μέρος.", "seq": 2188}
{"id": "Philoponus_Passim_2189", "series": "CAG", "text": "ὥσπερ δὲ τοῦτο ἴσμεν ἀορίστως, οὕτω δὴ καὶ οὗ ἐστι μέρος, ἀορίστως γινώσκομεν.", "seq": 2189}
{"id": "Philoponus_Passim_2190", "series": "CAG", "text": "δύναται δὲ τοῦτο καὶ ὡς ἐπιλυόμενος τὰς ἀνωτέρω εἰρημένας ἀπορίας προσθεῖναι·", "seq": 2190}
{"id": "Philoponus_Passim_2191", "series": "CAG", "text": "ἐπειδὴ γὰρ ἔλεγεν εἶναί τινα τῶν πρός τι ἃ μή ἐστιν ἅμα τῇ φύσει, τὸ γὰρ ἐπιστητὸν προϋπάρχειν τῆς ἐπιστήμης καὶ τὸ αἰσθητὸν δὲ τῆς αἰσθήσεως φύσει εἶναι πρῶτον (ὡς γὰρ ἐπὶ τὸ πολύ, ἔφησε, προϋπαρχόντων τῶν πραγμάτων τὰς ἐπιστήμας λαμβάνομεν), τοῦτο οὖν ἐνταῦθα ἐπιλυόμενός φησιν ὅτι εἰ τὰ πρός τι ταῦτά ἐστιν οἷς τὸ εἶναι ταὐτόν ἐστι τῷ πρός τί πως ἔχειν, ἀνάγκη ἄρα ὡς ἂν ἔχῃ τῶν πρός τι θάτερον, οὕτω καὶ τὸ λοιπὸν ἔχειν.", "seq": 2191}
{"id": "Philoponus_Passim_2192", "series": "CAG", "text": "ὥστε εἰ μὲν δυνάμει εἴη ἡ ἐπιστήμη, καὶ τὸ ἐπιστητὸν δυνάμει ἔσται, καὶ εἰ ἐνεργείᾳ θάτερον, καὶ τὸ λοιπόν.", "seq": 2192}
{"id": "Philoponus_Passim_2193", "series": "CAG", "text": "εἴπομεν δὲ ἤδη ἐντελῶς περὶ τούτου.", "seq": 2193}
{"id": "Philoponus_Passim_2194", "series": "CAG", "text": "8b7 Ὡσαύτως δὲ καὶ τόδε τι εἰ οἶδεν ὅτι κάλλιόν ἐστι.", "seq": 2194}
{"id": "Philoponus_Passim_2195", "series": "CAG", "text": "Ὁ γὰρ εἰδὼς περί τινος ὅτι κάλλιόν ἐστιν ὀφείλει ἀφωρισμένως εἰδέναι καὶ ὅτου κάλλιόν ἐστιν καὶ κατὰ τί κάλλιον·", "seq": 2195}
{"id": "Philoponus_Passim_2196", "series": "CAG", "text": "εἰ γὰρ μὴ οἶδε κατὰ τί κάλλιον, οὐδὲ εἰ κάλλιόν ἐστιν οἶδε·", "seq": 2196}
{"id": "Philoponus_Passim_2197", "series": "CAG", "text": "πῶς γὰρ τὴν διαφορὰν οὐκ εἰδὼς καθ᾿ ἣν λέγεται ἐκείνου κάλλιον;", "seq": 2197}
{"id": "Philoponus_Passim_2198", "series": "CAG", "text": "8b9 Οὐκ ἀορίστως δὲ εἴσεται ὅτι τοῦτό ἐστι χείρονος κάλλιον·", "seq": 2198}
{"id": "Philoponus_Passim_2199", "series": "CAG", "text": "ὑπόληψις γὰρ τὸ τοιοῦτον γίνεται, οὐκ ἐπιστήμη.", "seq": 2199}
{"id": "Philoponus_Passim_2200", "series": "CAG", "text": "Ὑπόληψιν ἐνταῦθα τὴν ἀμυδρὰν καὶ ἀβέβαιόν φησι γνῶσιν τὴν οἷον δόκησιν, ἡ δὲ ἐπιστήμη γνῶσίς ἐστιν ἄπταιστος.", "seq": 2200}
{"id": "Philoponus_Passim_2201", "series": "CAG", "text": "ὥστε ἀορίστως εἰδὼς ὅτι τόδε τι χείρονός ἐστι κάλλιον καὶ μὴ ἐπιστημόνως, ἅτε δὴ πεπλανημένην ἔχων τὴν γνῶσιν, ὑποπτεύσειεν ἄν ποτε καὶ περὶ τοῦ χειρίστου πάντων, λέγω δὴ τῆς ὕλης, ὅτι τινὸς κάλλιόν ἐστι, τὴν διαφορὰν τὴν κατὰ τί κάλλιον καὶ τίνος κάλλιον ἀγνοῶν, ὅπερ ἄτοπον.", "seq": 2201}
{"id": "Philoponus_Passim_2202", "series": "CAG", "text": "ἐκ τούτων οὖν ἀποδείκνυσι τὴν κεφαλὴν καὶ τὴν χεῖρα καὶ πάντα τὰ μέρη τῶν οὐσιῶν, ἃ καὶ αὐτὰ οὐσίαι εἰσίν, ὅτι οὔκ εἰσι τῶν πρός τι, εἴ γε αὐτὰ μὲν ἀφωρισμένως ἔστιν εἰδέναι, ὧν δὲ λέγονται εἶναι οὐκ ἀναγκαῖον ἀφωρισμένως εἰδέναι.", "seq": 2202}
{"id": "Philoponus_Passim_2203", "series": "CAG", "text": "τὰ δὲ πρός τι ἐλέγετο ὅτι ὡς ἄν τις εἰδῇ τούτων τὸ ἕτερον, οὕτως καὶ τὸ ἕτερον ἀνάγκη εἰδέναι.", "seq": 2203}
{"id": "Philoponus_Passim_2204", "series": "CAG", "text": "ὥστε οὔκ εἰσι τῶν πρός τι τὰ τῶν οὐσιῶν μέρη.", "seq": 2204}
{"id": "Philoponus_Passim_2205", "series": "CAG", "text": "8b21 Ἴσως δὲ χαλεπὸν ὑπὲρ τῶν τοιούτων σφοδρῶς ἀποφαίνεσθαι μὴ πολλάκις ἐπεσκεμμένον.", "seq": 2205}
{"id": "Philoponus_Passim_2206", "series": "CAG", "text": "τὸ μέντοι διηπορηκέναι περὶ ἑκάστου αὐτῶν οὐκ ἄχρηστόν ἐστιν.", "seq": 2206}
{"id": "Philoponus_Passim_2207", "series": "CAG", "text": "Πάνυ ἐμφιλοσόφως τοῦτό φησιν·", "seq": 2207}
{"id": "Philoponus_Passim_2208", "series": "CAG", "text": "ἐπειδὴ γὰρ ἔλεγε τὴν χεῖρα καὶ τὴν κεφαλὴν ὡς μὲν οὐσίας ὡρισμένως γινώσκεσθαι, ὡς δὲ μέρη ἀορίστως, εἰ μὴ γινώσκοιτο τίνος εἴη κεφαλὴ ἢ χείρ, διὰ τοῦτό φησιν ὅτι οὐ δεῖ τὸν μὴ ἐσκεμμένον πάνυ τὰ τοιαῦτα σφοδρῶς περὶ αὐτῶν ἀποφαίνεσθαι.", "seq": 2208}
{"id": "Philoponus_Passim_2209", "series": "CAG", "text": "οὐ μόνον δὲ περὶ τούτου, ἀλλὰ καὶ περὶ ἑκάστου πράγματος.", "seq": 2209}
{"id": "Philoponus_Passim_2210", "series": "CAG", "text": "ὅμως δὲ τὸ ἀπορεῖν περὶ τῶν τοιούτων ἀναγκαῖον·", "seq": 2210}
{"id": "Philoponus_Passim_2211", "series": "CAG", "text": "ἡ γὰρ ἀπορία ἀρχή ἐστιν εὐπορίας καὶ ὁδός τις ἐπὶ μάθησιν.", "seq": 2211}
{"id": "Philoponus_Passim_2212", "series": "CAG", "text": "ταῦτα δέ φησι βουλόμενος ἡμᾶς μὴ ἐπαναπαύεσθαι τοῖς αὐτοῦ λόγοις, ἀλλὰ καὶ αὐτοὺς ἡμᾶς ζητεῖν τὰ τοιαῦτα καὶ μὴ ἑτεροκινήτους εἶναι.", "seq": 2212}
{"id": "Philoponus_Passim_2213", "series": "CAG", "text": "Περὶ ποιοὖ καὶ ποιότητος.", "seq": 2213}
{"id": "Philoponus_Passim_2214", "series": "CAG", "text": "8b25 Ποιότητα δὲ λέγω καθ᾿ ἣν ποιοί τινες εἶναι λέγονται.", "seq": 2214}
{"id": "Philoponus_Passim_2215", "series": "CAG", "text": "Ζητοῦμεν πάλιν ἐνταῦθα περί τε τῆς τάξεως τῆς ποιότητος καὶ τὴν αἰτίαν τῆς ἐπιγραφῆς τήν τε διαίρεσιν τῆς ποιότητος καὶ τὴν τάξιν τῆς διαιρέσεως τῶν εἰδῶν.", "seq": 2215}
{"id": "Philoponus_Passim_2216", "series": "CAG", "text": "πρῶτον οὖν περὶ τῆς τάξεως·", "seq": 2216}
{"id": "Philoponus_Passim_2217", "series": "CAG", "text": "αὕτη δὲ δήλη ἐκ τῶν προειρημένων·", "seq": 2217}
{"id": "Philoponus_Passim_2218", "series": "CAG", "text": "ὡς γὰρ ἐλέγομεν, ἔδει μὲν προτετάχθαι τὸν περὶ ποιότητος λόγον τῶν πρός τι, ἐπειδὴ αὕτη μὲν αὐτὴ καθ᾿ αὑτὴν θεωρεῖται, τὰ δὲ πρός τι ἐν τῇ πρὸς ἕτερον σχέσει τὸ εἶναι ἔχει, τιμιώτερα δὲ τὰ καθ᾿ ἑαυτὰ ὑφεστῶτα τῶν μὴ καθ᾿ ἑαυτὰ τὸ εἶναι ἐχόντων, καὶ ὅτι ἀναιρουμένου τοῦ ποιοῦ καὶ τὸ ἐν τούτῳ ὑφιστάμενον πρός τι συναναιρεῖται, οἷον τὸ λευκότερον καὶ θερμότερον μαθητής τε καὶ διδάσκαλος καὶ τὰ παραπλήσια, τῶν πρός τι δὲ μὴ ὄντων οὐδὲν κωλύει εἶναι πᾶσαν ποιότητα·", "seq": 2218}
{"id": "Philoponus_Passim_2219", "series": "CAG", "text": "εἴπομεν γὰρ ὡς ἰδίαν ὅλως ὑπόστασιν τὰ πρός τι οὐκ ἔχει, ἀλλὰ ταῖς ἄλλαις ἐπισυμβαίνει κατηγορίαις.", "seq": 2219}
{"id": "Philoponus_Passim_2220", "series": "CAG", "text": "ἀλλ᾿, ὡς ἐλέγομεν, διὰ τὸ ἐν τῷ περὶ τοῦ ποσοῦ λόγῳ μνησθῆναι τὸν φιλόσοφον τῶν πρός τι, ἀναγκαῖον ἦν εὐθὺς τὴν περὶ αὐτῶν ποιῆσαι διδασκαλίαν, ἵνα μὴ ἐπὶ πολὺ ἀγνοῶμεν αὐτῶν τὴν φύσιν.", "seq": 2220}
{"id": "Philoponus_Passim_2221", "series": "CAG", "text": "καὶ ταῦτα μὲν περὶ τῆς τάξεως.", "seq": 2221}
{"id": "Philoponus_Passim_2222", "series": "CAG", "text": "τί δή ποτε δὲ διπλῆν ποιεῖται τὴν ἐπιγραφὴν περὶ ποιοῦ καὶ ποιότητος, καὶ μὴ ἁπλῆν, ὥσπερ ἐπὶ τῶν ἄλλων κατηγοριῶν;", "seq": 2222}
{"id": "Philoponus_Passim_2223", "series": "CAG", "text": "λέγομεν οὖν ὅτι ἄλλο ἐστὶ ποιὸν καὶ ἄλλο ποιότης·", "seq": 2223}
{"id": "Philoponus_Passim_2224", "series": "CAG", "text": "ποιότης μὲν γάρ ἐστιν αὐτὴ ἡ καθόλου ποιότης, ἀφ᾿ ἧς παρωνύμως τὰ μετέχοντα ποιὰ ὀνομάζονται, οἷον ἡ καθόλου λευκότης ἢ μελανία, ποιὸν δέ ἐστι τὸ σῶμα τὸ μεταλαβὸν τῆς ποιότητος καὶ παρωνύμως ἀπ᾿ αὐτῆς ὀνομαζόμενον, οἷον τὸ λευκὸν σῶμα ἢ θερμόν.", "seq": 2224}
{"id": "Philoponus_Passim_2225", "series": "CAG", "text": "ἡ οὖν ποιότης νῷ μόνῳ ἐστὶ ληπτή, τὸ δὲ ποιὸν αἰσθήσει ὑποπίπτει.", "seq": 2225}
{"id": "Philoponus_Passim_2226", "series": "CAG", "text": "ἐπεὶ οὖν διπλοῦν τὸ τῆς ποιότητος ὄνομα, ἢ ὡς αὐτὸ καθ᾿ αὑτὸ καὶ νῷ μόνῳ νοούμενον, οἷόν ἐστιν αὐτὸ τὸ τῆς ποιότητος γένος, ἢ ὡς αἰσθήσει ληπτόν, διὰ τοῦτο διπλῆν καὶ τὴν ἐπιγραφὴν ἐποιήσατο.", "seq": 2226}
{"id": "Philoponus_Passim_2227", "series": "CAG", "text": "προέταξε δὲ τὸ ποιόν, ὅτι γνωριμώτερόν ἐστιν ἅτε αἰσθητὸν ὄν, δεῖ δὲ ἀεὶ ἀπὸ τῶν γνωριμωτέρων ἄρχεσθαι τῆς διδασκαλίας.", "seq": 2227}
{"id": "Philoponus_Passim_2228", "series": "CAG", "text": "ἔστι δὲ καὶ ἄλλως φάναι ὅτι καὶ ἡ ποιότης ποιόν ἐστι·", "seq": 2228}
{"id": "Philoponus_Passim_2229", "series": "CAG", "text": "τὸ γὰρ ποιὸν κατηγορεῖται ποιοῦ καὶ ποιότητος κοινότερον <ὄν>, ὥστε καὶ τὴν ποιότητα ποιὸν λέγεσθαι, ὥσπερ ἀμέλει καὶ τὸ ὄνομα κοινῶς κατηγορεῖται ὀνόματός τε καὶ ῥήματος·", "seq": 2229}
{"id": "Philoponus_Passim_2230", "series": "CAG", "text": "κἂν γὰρ περὶ ποιῶν διαλέγηται, οὐ πρώτως περὶ τούτων ποιεῖται τὸν λόγον, ἀλλὰ δι᾿ αὐτὴν τὴν ποιότητα, ἵνα ὡς ἐκ γνωριμωτέρων σαφὴς ὁ περὶ αὐτῆς γένηται λόγος.", "seq": 2230}
{"id": "Philoponus_Passim_2231", "series": "CAG", "text": "Διαιρεῖ δὲ τὴν ποιότητα εἰς τέσσαρα εἴδη, ὧν τὸ μὲν πρῶτόν φησιν ἕξιν καὶ διάθεσιν, δεύτερον δύναμιν καὶ ἀδυναμίαν, τρίτον παθητικὰς ποιότητας καὶ πάθη, τέταρτον σχῆμα καὶ μορφήν.", "seq": 2231}
{"id": "Philoponus_Passim_2232", "series": "CAG", "text": "ἵνα δὲ γνῶμεν τίνος ἕνεκεν τέσσαρα μόνα εἴδη ἐστὶ ποιότητος καὶ οὔτε πλείονα οὔτε ἐλάττονα καὶ διὰ τί τοιαύτην τάξιν αὐτοῖς ἐπέθηκε, διαίρεσίν τινα τῆς ποιότητος ποιησώμεθα.", "seq": 2232}
{"id": "Philoponus_Passim_2233", "series": "CAG", "text": "ἡ τοίνυν ποιότης ἢ κατὰ δύναμίν ἐστι καὶ ἀδυναμίαν ἢ κατ᾿ ἐνέργειαν, κατὰ δύναμιν μὲν ὡς τὸ παιδίον δυνάμει ἐστὶ γραμματικόν, κατὰ ἀδυναμίαν δὲ ὡς ὁ ἵππος ἀδυναμίαν ἔχει τοῦ δέξασθαι γραμματικήν.", "seq": 2233}
{"id": "Philoponus_Passim_2234", "series": "CAG", "text": "εἰ δὲ κατ᾿ ἐνέργειαν εἴη ἡ ποιότης, ἤτοι τελειωτική ἐστιν ἢ κακωτικὴ τοῦ ὑποκειμένου ἢ οὔτε τελειωτικὴ οὔτε κακωτική.", "seq": 2234}
{"id": "Philoponus_Passim_2235", "series": "CAG", "text": "καὶ εἰ μὲν τελειωτικὴ εἴη ἢ κακωτική, ἢ οὐκ ἐμποιεῖ πάθος περὶ τὴν αἴσθησιν τὴν ἡμετέραν ἢ ἐμποιεῖ.", "seq": 2235}
{"id": "Philoponus_Passim_2236", "series": "CAG", "text": "καὶ εἰ μὲν οὐκ ἐμποιεῖ πάθος ἢ δυσαπόβλητός ἐστιν ἢ εὐαπόβλητος.", "seq": 2236}
{"id": "Philoponus_Passim_2237", "series": "CAG", "text": "καὶ εἰ μὲν δυσαπόβλητος εἴη, λέγεται ἕξις, εἰ δὲ εὐαπόβλητος, διάθεσις·", "seq": 2237}
{"id": "Philoponus_Passim_2238", "series": "CAG", "text": "οἷον κατ᾿ ἐνέργειαν καὶ τελειωτικὴ καὶ οὐκ ἐμποιοῦσα πάθος ἡ ὑγεία καὶ ἐπὶ ψυχῆς ἡ ἀρετή, κακωτικὴ δὲ νόσος καὶ κακία·", "seq": 2238}
{"id": "Philoponus_Passim_2239", "series": "CAG", "text": "ἡ γὰρ ὑγεία καὶ ἡ ἀρετὴ καὶ τελειωτικαὶ τῶν ὑποκειμένων εἰσίν, ἐπεὶ καὶ κατὰ φύσιν, καὶ πάθος οὐκ ἐμποιοῦσιν·", "seq": 2239}
{"id": "Philoponus_Passim_2240", "series": "CAG", "text": "οὐδεμιᾷ γὰρ τῶν αἰσθήσεων ὑποπίπτουσιν, εἰ μὴ ἄρα τὰ παρακολουθήματα τῆς ὑγείας, οἷον ἡ εὔχροια, ἢ τῆς νόσου κακωτικῆς οὔσης, οἷον ἡ ὠχρίασις, αὐτὴ μέντοι ἡ ὑγεία καὶ ἡ νόσος καὶ τὰ τοιαῦτα οὐδεμιᾷ τῶν αἰσθήσεων ὑποπίπτουσι.", "seq": 2240}
{"id": "Philoponus_Passim_2241", "series": "CAG", "text": "πολυχρόνιοι μὲν οὖν οὖσαι καὶ δυσαπόβλητοι λέγονται ἕξεις·", "seq": 2241}
{"id": "Philoponus_Passim_2242", "series": "CAG", "text": "λεγόμεθα γὰρ ἐν ἕξει ἔχειν τὴν ἀρετὴν ἢ τὴν κακίαν, ἀλλὰ καὶ τὴν ὑγείαν ἢ τὴν νόσον·", "seq": 2242}
{"id": "Philoponus_Passim_2243", "series": "CAG", "text": "διὸ καὶ εὐεκτεῖν λεγόμεθα, ὁπόταν ἡ ὑγεία ᾖ ἐπιτεταμένη.", "seq": 2243}
{"id": "Philoponus_Passim_2244", "series": "CAG", "text": "ἀλλὰ καὶ νόσος τις ἑκτικὴ λέγεται, καὶ καχεκτεῖν δὲ πάλιν λεγόμεθα.", "seq": 2244}
{"id": "Philoponus_Passim_2245", "series": "CAG", "text": "ὀλιγοχρόνιοι δὲ οὖσαι καὶ εὐαπόβλητοι λέγονται διαθέσεις.", "seq": 2245}
{"id": "Philoponus_Passim_2246", "series": "CAG", "text": "τοῦτο δὲ πρῶτον λέγει εἶδος εἶναι ποιότητος, ἕξιν λέγω καὶ διάθεσιν.", "seq": 2246}
{"id": "Philoponus_Passim_2247", "series": "CAG", "text": "ἕξιν δὲ λέγουσι τὴν μόνιμον ποιότητα καὶ δυσαπόβλητον, διάθεσιν δὲ τὴν εὐαπόβλητον·", "seq": 2247}
{"id": "Philoponus_Passim_2248", "series": "CAG", "text": "οὕτως γὰρ ἕξιν λέγομεν ἔχειν τὸν δεῖνα ῥητορικῆς τὸν εἰδότα μὴ μόνον τὰς τῆς ῥητορικῆς μεθόδους ἀλλὰ καὶ πρὸς τὰς ἀπορίας τὰς ἐπιφερομένας αὐτῷ ἐνστῆναι δυνάμενον, τὸν δὲ μὴ πάνυ περιγεγονότως κατεσχηκότα τῶν κατὰ τὴν ῥητορικὴν μεθόδων ἄλλως δὲ πεποιωμένον πως κατ᾿ αὐτήν, ἕξιν μὲν τοῦτον ῥητορικῆς οὔ φαμεν ἔχειν, διακεῖσθαι δέ πως κατὰ ῥητορικήν.", "seq": 2248}
{"id": "Philoponus_Passim_2249", "series": "CAG", "text": "τί οὖν;", "seq": 2249}
{"id": "Philoponus_Passim_2250", "series": "CAG", "text": "οὐκ ἔστι καὶ ἡ ἕξις διάθεσις;", "seq": 2250}
{"id": "Philoponus_Passim_2251", "series": "CAG", "text": "ὁ γοῦν τὴν ἕξιν ἔχων διάκειταί πως κατ᾿ αὐτήν.", "seq": 2251}
{"id": "Philoponus_Passim_2252", "series": "CAG", "text": "λέγομεν ὅτι τὸ τῆς διαθέσεως ὄνομα διττόν ἐστι, τὸ μὲν γενικώτερον ὃ κατηγορεῖται καὶ κατὰ τῆς ἕξεως, τὸ δὲ εἰδικώτερον ὃ ἀντιδιαστέλλεται πρὸς τὴν ἕξιν.", "seq": 2252}
{"id": "Philoponus_Passim_2253", "series": "CAG", "text": "ἐνταῦθα οὖν διάθεσιν παρέλαβεν οὐ τὴν γενικὴν ἀλλὰ τὴν εἰδικὴν τὴν ἀντιδιαστελλομένην πρὸς τὴν ἕξιν.", "seq": 2253}
{"id": "Philoponus_Passim_2254", "series": "CAG", "text": "ἰστέον δὲ ὅτι τὸ τῆς ἕξεως ὄνομα ἐπὶ τούτων φέρεται, ἐφ᾿ ὧν καὶ τὸ τῆς εὐεξίας·", "seq": 2254}
{"id": "Philoponus_Passim_2255", "series": "CAG", "text": "ἡ γὰρ εὐεξία ἐπίτασίς ἐστι τῆς ἕξεως.", "seq": 2255}
{"id": "Philoponus_Passim_2256", "series": "CAG", "text": "εἰ οὖν τὸ τῆς εὐεξίας ὄνομα ἐπὶ μόνων τῶν ἐμψύχων εἰώθαμεν φέρειν (οὐδεὶς γὰρ ἂν εἴποι τὸ πῦρ εὐεκτεῖν κατὰ τὴν θερμότητα οὐδὲ τὴν χιόνα κατὰ τὴν ψῦξιν), καὶ τὸ τῆς ἕξεως ἄρα ὄνομα ἐπὶ μόνων τῶν ἐμψύχων λεχθήσεται.", "seq": 2256}
{"id": "Philoponus_Passim_2257", "series": "CAG", "text": "Εἰ δὲ κατ᾿ ἐνέργειαν οὖσα ἡ ποιότης τελειωτικὴ εἴη ἢ κακωτικὴ καὶ ἐμποιεῖ πάθος περὶ τὴν ἡμετέραν αἴσθησιν, λέγεται παθητικὴ ποιότης ὡς πάθος ἐμποιοῦσα περὶ τὴν ἡμετέραν αἴσθησιν, τελειωτικὴ μὲν ὡς ἡ ἐν τῷ πυρὶ θερμότης ἢ ἡ ἐν τῷ μέλιτι γλυκύτης, κακωτικὴ δὲ ὡς ἡ τοῦ οἴνου ὀξύτης καὶ ἡ ἐν καρποῖς καὶ τοῖς ἄλλοις σώμασι σῆψις.", "seq": 2257}
{"id": "Philoponus_Passim_2258", "series": "CAG", "text": "εἰκότως δὲ αἱ μὲν τελειωτικαὶ λέγονται (εἰδοπεποίηνται γὰρ κατὰ ταύτας τό τε μέλι καὶ τὸ πῦρ), αἱ δὲ κακωτικαί, ἐπειδὴ φθαρτικαί εἰσι τοῦ ὑποκειμένου, πᾶσαι μέντοι πάθος ἐμποιοῦσι περὶ τὴν ἡμετέραν αἴσθησιν.", "seq": 2258}
{"id": "Philoponus_Passim_2259", "series": "CAG", "text": "αὗται δὲ ὡς ἀπὸ πάθους οὐ λέγονται γίνεσθαι, ἐπειδὴ μὴ κατὰ τροπήν τινα τοῦ ὑποκειμένου γεγόνασι, λέγω δὴ αἱ τελειωτικαί, ἀλλ᾿ οὐσιώδεις αὐτῶν εἰσι ποιότητες, καθ᾿ ἃς καὶ χαρακτηρίζονται.", "seq": 2259}
{"id": "Philoponus_Passim_2260", "series": "CAG", "text": "οὐκ ἀναγκαῖον δὲ τοῦτο ὑποδιελεῖν τὸ τμῆμα εἴς τε τὸ δυσαπόβλητον καὶ εὐαπόβλητον, ὥσπερ τὸ ἕτερον·", "seq": 2260}
{"id": "Philoponus_Passim_2261", "series": "CAG", "text": "ἐκεῖνο γὰρ ἐπὶ ἐμψύχων μόνων ἐθεωρεῖτο, ἐν οἷς καὶ αἱ κακωτικαὶ ποιότητες καὶ αἱ τελειωτικαὶ γίνεσθαι πεφύκασι καὶ ἀπογίνεσθαι τοῦ ὑποκειμένου τοῦ αὐτοῦ μένοντος, διὸ καὶ διῃροῦντο εἴς τε τὰς πολυχρονίους καὶ ὀλιγοχρονίους·", "seq": 2261}
