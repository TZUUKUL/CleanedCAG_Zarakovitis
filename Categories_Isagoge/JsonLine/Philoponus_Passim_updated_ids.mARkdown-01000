{"id": "Philoponus_Passim_2652", "series": "CAG", "text": "Ὡς γὰρ ὁ πατὴρ καὶ ὁ υἱὸς ἀνάγονται μὲν καὶ ὑπὸ τὴν οὐσίαν, ἀνάγονται δὲ καὶ ὑπὸ τὰ πρός τι, κατ᾿ ἄλλο μέντοι καὶ ἄλλο, οὕτως οὐδὲν ἄτοπον καὶ τὰς ἕξεις καὶ τὰς διαθέσεις ὡς μὲν πράγματα ἀνάγεσθαι ὑπὸ τὴν ποιότητα, ὡς δὲ σχέσιν τινὰ ἀναδεξάμενα ὑπὸ τὰ πρός τι.", "seq": 2652}
{"id": "Philoponus_Passim_2653", "series": "CAG", "text": "Περὶ τοῦ ποιεῖν καὶ πάσχειν.", "seq": 2653}
{"id": "Philoponus_Passim_2654", "series": "CAG", "text": "11b1 Ἐπιδέχεται δὲ καὶ τὸ ποιεῖν καὶ τὸ πάσχειν ἐναντιότητα.", "seq": 2654}
{"id": "Philoponus_Passim_2655", "series": "CAG", "text": "Τῶν κατηγοριῶν αἱ μέν εἰσιν ἁπλαῖ αἱ δὲ κατὰ συνδυασμὸν καὶ συμπλοκὴν τῶν ἁπλῶν τὸ εἶναι ἔχουσι.", "seq": 2655}
{"id": "Philoponus_Passim_2656", "series": "CAG", "text": "καὶ ἁπλαῖ μέν εἰσιν αἱ εἰρημέναι τέσσαρες, ἥ τε οὐσία καὶ τὸ ποσὸν καὶ τὰ πρός τι καὶ τὸ ποιόν, κατὰ συμπλοκὴν δὲ τῆς οὐσίας πρὸς μίαν τούτων ἢ πρὸς ἑαυτὴν αἱ λοιπαὶ ἓξ γίνονται.", "seq": 2656}
{"id": "Philoponus_Passim_2657", "series": "CAG", "text": "ἵνα δὲ τοῦτο γνῶμεν, λέγω δὴ ὅτι αἱ μὲν κυρίως κατηγορίαι τέσσαρές εἰσιν αἱ εἰρημέναι αἱ δὲ λοιπαὶ ἓξ ἐκ τῆς πρὸς ἄλληλα συμπλοκῆς τούτων γίνονται, ἐκ τῆς διαιρέσεως λάβωμεν τὰ εἰρημένα·", "seq": 2657}
{"id": "Philoponus_Passim_2658", "series": "CAG", "text": "τῶν ὄντων τὰ μὲν καθ᾿ ἑαυτὰ ὑφέστηκεν, ὡς ἡ οὐσία, τὰ δὲ ἐν ἑτέροις ἔχει τὸ εἶναι.", "seq": 2658}
{"id": "Philoponus_Passim_2659", "series": "CAG", "text": "τῶν δὲ ἐν ἑτέροις ἐχόντων τὸ εἶναι τὰ μὲν ἐν σχέσει θεωρεῖται, οἷον τὰ πρός τι, τὰ δὲ ἄσχετά εἰσι.", "seq": 2659}
{"id": "Philoponus_Passim_2660", "series": "CAG", "text": "καὶ τῶν μὴ ἐχόντων σχέσιν τὰ μέν ἐστι μεριστά, οἷον τὰ ποσά (τοῦτο γὰρ ἴδιον ἐλέγομεν τοῦ ποσοῦ εἶναι, τὸ μεριστόν), τὰ δὲ ἀμέριστα, οἷον αἱ ποιότητες.", "seq": 2660}
{"id": "Philoponus_Passim_2661", "series": "CAG", "text": "αὗται μὲν οὖν αἱ κυρίως καὶ πρώτως λεγόμεναι κατηγορίαι, αἱ δὲ ἄλλαι ἓξ γίνονται τῆς οὐσίας συμπλεκομένης ταῖς λοιπαῖς τρισί, τῷ ποσῷ λέγω καὶ τῷ πρός τι καὶ τῷ ποιῷ, <ἢ ἑαυτῇ>·", "seq": 2661}
{"id": "Philoponus_Passim_2662", "series": "CAG", "text": "ἡ γὰρ οὐσία τῷ ποσῷ συμπλεκομένη ποιεῖ δύο κατηγορίας, τήν τε ποτὲ καὶ τὴν ποῦ·", "seq": 2662}
{"id": "Philoponus_Passim_2663", "series": "CAG", "text": "τῷ μὲν γὰρ χρόνῳ συμπλεκομένη ποιεῖ τὴν ποτέ (τὸ γὰρ ποτὲ οὔτε οὐσίαν μόνως σημαίνει οὔτε χρόνον, ἀλλ᾿ οὐσίαν ἐν χρόνῳ οὖσαν), τῷ δὲ τόπῳ συμπλεκομένη ποιεῖ τὴν ποῦ·", "seq": 2663}
{"id": "Philoponus_Passim_2664", "series": "CAG", "text": "τὸ γὰρ ποῦ οὔτε τόπον μόνον σημαίνει (οὐ γάρ ἐστι τόπος ἐν τόπῳ) οὔτε μὴν οὐσίαν, ἀλλ᾿ οὐσίαν ἐν τόπῳ οὖσαν.", "seq": 2664}
{"id": "Philoponus_Passim_2665", "series": "CAG", "text": "πάλιν ἡ οὐσία συμπλεκομένη τῷ ποιῷ ἑτέρας δύο ποιεῖ κατηγορίας, τήν τε τοῦ ποιεῖν καὶ τοῦ πάσχειν·", "seq": 2665}
{"id": "Philoponus_Passim_2666", "series": "CAG", "text": "τὸ γὰρ ποιεῖν καὶ τὸ πάσχειν κατὰ ποιότητα γίνονται·", "seq": 2666}
{"id": "Philoponus_Passim_2667", "series": "CAG", "text": "ὁ γὰρ ποιῶν εἴς τι ἢ τῷ θερμαίνειν ποιεῖ ἢ τῷ ψύχειν ἢ κατ᾿ ἄλλην τινὰ ποιότητα, καὶ ὁ πάσχων δὲ ἢ τῷ θερμαίνεσθαι ἢ μελαίνεσθαι ἢ κατ᾿ ἄλλην τινὰ ποιότητα πάσχει.", "seq": 2667}
{"id": "Philoponus_Passim_2668", "series": "CAG", "text": "πάλιν ἡ οὐσία τοῖς πρός τι συμπλεκομένη ποιεῖ τὸ κεῖσθαι, τὴν δὲ θέσιν τῶν πρός τι ἐλέγομεν εἶναι.", "seq": 2668}
{"id": "Philoponus_Passim_2669", "series": "CAG", "text": "αὐτὴ δὲ ἑαυτῇ συμπλεκομένη ποιεῖ τὸ ἔχειν·", "seq": 2669}
{"id": "Philoponus_Passim_2670", "series": "CAG", "text": "τὸ γὰρ ἔχειν οὐσίας περὶ οὐσίαν σημαίνει περίθεσιν.", "seq": 2670}
{"id": "Philoponus_Passim_2671", "series": "CAG", "text": "Ἀποδοὺς δὲ ὁ Ἀριστοτέλης τῶν τεσσάρων κατηγοριῶν τοὺς ὅρους καὶ τὰ παρακολουθήματα, τῶν λοιπῶν ἓξ οὔτε τοὺς ὁρισμοὺς ἀποδέδωκεν οὔτε τὴν εἰς τὰ εἴδη διαίρεσιν, ὡς ἡμῶν δυναμένων ἐκ τῶν ῥηθέντων τούτοις ἐπιστῆσαι.", "seq": 2671}
{"id": "Philoponus_Passim_2672", "series": "CAG", "text": "δεῖ οὖν ἡμᾶς ἑκάστου τὸν ὁρισμὸν ἀποδοῦναι καὶ τὴν εἰς τὰ εἴδη διαίρεσιν.", "seq": 2672}
{"id": "Philoponus_Passim_2673", "series": "CAG", "text": "ἔστιν οὖν ποιεῖν μὲν τὸ εἴς τι ἐνεργεῖν.", "seq": 2673}
{"id": "Philoponus_Passim_2674", "series": "CAG", "text": "τούτου δὲ εἴδη δύο·", "seq": 2674}
{"id": "Philoponus_Passim_2675", "series": "CAG", "text": "τὸ γὰρ ποιοῦν ἢ εἰς ἑαυτὸ ποιεῖ, ὥσπερ ἡ ψυχὴ ἑαυτὴν γινώσκουσα, ἢ εἰς ἕτερον, ὡς τὸ πῦρ εἰς ἡμᾶς ποιεῖ θερμαῖνον ἡμᾶς.", "seq": 2675}
{"id": "Philoponus_Passim_2676", "series": "CAG", "text": "πάσχειν δέ ἐστι τὸ ὑπό τινος ἀλλοιοῦσθαι.", "seq": 2676}
{"id": "Philoponus_Passim_2677", "series": "CAG", "text": "τούτου δὲ εἴδη δύο·", "seq": 2677}
{"id": "Philoponus_Passim_2678", "series": "CAG", "text": "ἢ γὰρ ὡς εἰς φθοράν τι ἀγόμενον πάσχει, ὡς τὸ ξύλον ὑπὸ πυρὸς καιόμενον, ἢ ὡς εἰς τελειότητα, ὡς ὅταν εἴπωμεν πάσχειν τὴν ὅρασιν ὑπὸ τοῦ ὁρατοῦ·", "seq": 2678}
{"id": "Philoponus_Passim_2679", "series": "CAG", "text": "εἰς τελειότητα γὰρ ἄγεται ἡ ὅρασις ὑπὸ τῶν ὁρατῶν τὴν οἰκείαν ἀπολαμβάνουσα ἐνέργειαν.", "seq": 2679}
{"id": "Philoponus_Passim_2680", "series": "CAG", "text": "καὶ ὁ μαθητὴς ὑπὸ τοῦ διδασκάλου πάσχει καὶ αὐτὸς οὐ φθειρόμενος ἀλλὰ τελειούμενος.", "seq": 2680}
{"id": "Philoponus_Passim_2681", "series": "CAG", "text": "κεῖσθαι δέ ἐστι τὸ θέσιν τινὰ ἔχειν.", "seq": 2681}
{"id": "Philoponus_Passim_2682", "series": "CAG", "text": "τούτου δὲ εἴδη τρία, τὸ ἀνακεκλίσθαι τὸ καθῆσθαι τὸ ἑστάναι·", "seq": 2682}
{"id": "Philoponus_Passim_2683", "series": "CAG", "text": "ἢ γάρ, ὡς πολλάκις εἴρηται, τὸ ὅλον σῶμα κέκλιται καὶ λέγεται ἀνακεκλίσθαι, ἢ τὸ μέν τι κέκλιται τὸ δὲ ὀρθόν ἐστι καὶ λέγεται καθῆσθαι, ἢ ὅλον ὀρθόν ἐστι καὶ λέγεται ἵστασθαι.", "seq": 2683}
{"id": "Philoponus_Passim_2684", "series": "CAG", "text": "ποτὲ δέ ἐστι τὸ χρόνου δηλωτικὸν ἤτοι τὸ ἐν χρόνῳ ὄν·", "seq": 2684}
{"id": "Philoponus_Passim_2685", "series": "CAG", "text": "τούτου δὲ εἴδη τρία, ἐνεστὼς παρεληλυθὼς μέλλων.", "seq": 2685}
{"id": "Philoponus_Passim_2686", "series": "CAG", "text": "ποῦ δέ ἐστι τὸ τόπου δηλωτικὸν ἢ τὸ ἐν τόπῳ ὄν·", "seq": 2686}
{"id": "Philoponus_Passim_2687", "series": "CAG", "text": "τούτου δὲ εἴδη ἕξ, τὸ ἄνω τὸ κάτω τὸ δεξιὸν τὸ ἀριστερὸν τὸ ἔμπροσθεν τὸ ὄπισθεν.", "seq": 2687}
{"id": "Philoponus_Passim_2688", "series": "CAG", "text": "εἰκότως δὲ ἓξ τοῦ τόπου εἰσὶν αἱ διαφοραί·", "seq": 2688}
{"id": "Philoponus_Passim_2689", "series": "CAG", "text": "εἰ γὰρ τόπος ἐστίν, ὡς εἴρηται ἡμῖν, πέρας τοῦ περιέχοντος καθ᾿ ὃ περιέχει τὸ περιεχόμενον, τὸ δὲ περιεχόμενον σῶμά ἐστι, πᾶν δὲ σῶμα τρεῖς ἔχει διαστάσεις, ἑκάστη δὲ διάστασις κατ᾿ εὐθεῖαν γραμμὴν θεωρεῖται ὡρισμένως καὶ οὐ κατ᾿ ἄλλην τινά (εἰ γάρ τις βουληθείη τοίχου, εἰ τύχοι, τὴν κατὰ μῆκος διάστασιν γνῶναι πόση τίς ἐστι, κατὰ κάθετον ταύτην μετρήσει, ἡ δὲ κάθετος εὐθεῖα γραμμή ἐστιν, ὡσαύτως δὲ καὶ εἰ τὴν κατὰ πλάτος ἢ βάθος διάστασίν τις γνῶναι βούλοιτο πόση ἐστί, σπάρτον ἐκτείνας ταύτην μετρήσει, ἥτις καὶ αὐτὴ εὐθεῖα γραμμή ἐστι), πᾶσα δὲ εὐθεῖα γραμμὴ δύο πέρατα ἔχει·", "seq": 2689}
{"id": "Philoponus_Passim_2690", "series": "CAG", "text": "εἰ τοίνυν πᾶν σῶμα τρεῖς ἔχει διαστάσεις, ἑκάστη δὲ διάστασις κατ᾿ εὐθεῖαν γραμμὴν χαρακτηρίζεται, πᾶσα δὲ εὐθεῖα γραμμὴ δύο ἔχει πέρατα, εἰκότως τὸ σῶμα ἓξ ἔχει πέρατα.", "seq": 2690}
{"id": "Philoponus_Passim_2691", "series": "CAG", "text": "εἰ οὖν τὸ σῶμα ἓξ ἔχει πέρατα, καὶ ὁ τόπος ὁ περιέχων αὐτὸ ἐξ ἀνάγκης ἓξ σχήσει πέρατα, ἐπειδὴ κατὰ πᾶσαν διάστασιν περιέχει ὁ τόπος τὸ σῶμα.", "seq": 2691}
{"id": "Philoponus_Passim_2692", "series": "CAG", "text": "καὶ ἔστι τῆς μὲν ὡς ἐπὶ ἐμψύχων εἰπεῖν κατὰ μῆκος διαστάσεως πέρατα τὸ ἄνω καὶ τὸ κάτω, τῆς δὲ κατὰ πλάτος τὰ δεξιὰ καὶ τὰ ἀριστερά, τῆς δὲ κατὰ βάθος τὸ ἔμπροσθεν καὶ τὸ ὄπισθεν.", "seq": 2692}
{"id": "Philoponus_Passim_2693", "series": "CAG", "text": "ἔχειν δέ ἐστιν οὐσίας περὶ οὐσίαν περίθεσις.", "seq": 2693}
{"id": "Philoponus_Passim_2694", "series": "CAG", "text": "τοῦτο δὲ ἢ ὅλον περὶ ὅλον περίκειται, ὡς ὁ χιτὼν ὅλον περιέχει τὸ σῶμα, ἢ ὅλον περὶ μέρος, ὡς ὁ δακτύλιος ἐν δακτύλῳ.", "seq": 2694}
{"id": "Philoponus_Passim_2695", "series": "CAG", "text": "11b1 Ἐπιδέχεται δὲ καὶ τὸ ποιεῖν καὶ τὸ πάσχειν ἐναντιότητα.", "seq": 2695}
{"id": "Philoponus_Passim_2696", "series": "CAG", "text": "Ζητητέον ἐνταῦθα τί δή ποτε τὸ ποιεῖν καὶ τὸ πάσχειν οὐχ ὑπὸ τὰ πρός τι ἀνάγει ὁ φιλόσοφος, ἀλλ᾿ ἑτέρας αὐτὰς εἶναι λέγει κατηγορίας·", "seq": 2696}
{"id": "Philoponus_Passim_2697", "series": "CAG", "text": "ὁ γὰρ ποιῶν εἰς πάσχοντα ποιεῖ καὶ ὁ πάσχων ὑπὸ ποιοῦντος πάσχει·", "seq": 2697}
{"id": "Philoponus_Passim_2698", "series": "CAG", "text": "ὥστε καὶ αὗται τῶν πρός τί εἰσι.", "seq": 2698}
{"id": "Philoponus_Passim_2699", "series": "CAG", "text": "λέγομεν οὖν πρὸς τοῦτο ὅτι τὰ μὲν ἀπαρέμφατα ῥήματα μόνης εἰσὶ τῆς φύσεως τῶν ἐνεργειῶν ἢ τῶν παθῶν σημαντικά (ἢ γὰρ ἐνέργειαν μόνως ἢ πάθος σημαίνει), τὰ μέντοι γε ἄλλα ῥήματα ἤτοι αἱ μετοχαὶ τὴν σχέσιν σημαίνουσι τῶν οὐσιῶν ἤτοι πρὸς τὴν ἐνέργειαν ἢ πρὸς τὸ πάθος.", "seq": 2699}
{"id": "Philoponus_Passim_2700", "series": "CAG", "text": "τὸ τοίνυν ποιεῖν καὶ τὸ πάσχειν, ἀπαρέμφατα ὄντα ῥήματα, τῆς ποιήσεως αὐτῆς ἢ παθήσεώς ἐστι δηλωτικὰ καὶ οὐχὶ τῶν πρός τι·", "seq": 2700}
{"id": "Philoponus_Passim_2701", "series": "CAG", "text": "οὐδεὶς γὰρ ἂν εἴποι τὸ ποιεῖν εἰς τὸ πάσχειν ποιεῖν ἢ τὸ πάσχειν ὑπὸ τοῦ ποιεῖν πάσχειν.", "seq": 2701}
{"id": "Philoponus_Passim_2702", "series": "CAG", "text": "ὁ μέντοι γε πάσχων ἢ ποιῶν ὑπὸ τὰ πρός τι ἀναφέρεται·", "seq": 2702}
{"id": "Philoponus_Passim_2703", "series": "CAG", "text": "ὁ γὰρ ποιῶν εἰς πάσχοντα ποιεῖ καὶ ὁ πάσχων ὑπὸ ποιοῦντος πάσχει.", "seq": 2703}
{"id": "Philoponus_Passim_2704", "series": "CAG", "text": "καλῶς δὲ ὁ Ἀριστοτέλης ἐν τῇ Φυσικῇ ἀκροάσει ζητεῖ ὅτι εἰ ἐκ τοῦ ποιεῖν καὶ τοῦ πάσχειν ἡ κίνησις, πότερον ἐν τῷ ποιοῦντι θεωρεῖται ἢ ἐν τῷ πάσχοντι, καί φησιν ὅτι ἐν τῷ πάσχοντι·", "seq": 2704}
{"id": "Philoponus_Passim_2705", "series": "CAG", "text": "ἡ γὰρ κίνησις ὁδός ἐστιν ἀπὸ τοῦ δυνάμει εἰς τὸ ἐνεργείᾳ·", "seq": 2705}
{"id": "Philoponus_Passim_2706", "series": "CAG", "text": "ἐνέργεια δέ ἐστιν αὐτὴ ἡ προβολὴ τῆς ἕξεως·", "seq": 2706}
{"id": "Philoponus_Passim_2707", "series": "CAG", "text": "ἐκεῖνα οὖν κινεῖται ὅσα ἐνδεᾶ ἐστι καὶ ἀπὸ τοῦ ἀτελοῦς μεταβάλλει ἐπὶ τὸ τέλειον.", "seq": 2707}
{"id": "Philoponus_Passim_2708", "series": "CAG", "text": "ὅσα γοῦν πλειόνων τινῶν δέεται, πλείονας κινήσεις κινεῖται, τὰ δὲ ὀλιγοδεᾶ ὀλιγοκίνητα·", "seq": 2708}
{"id": "Philoponus_Passim_2709", "series": "CAG", "text": "ἀμέλει τὸ θεῖον ἀνενδεὲς ὂν καὶ πάντῃ ἐστὶν ἀκίνητον.", "seq": 2709}
{"id": "Philoponus_Passim_2710", "series": "CAG", "text": "εἰ τοίνυν ὁ ποιῶν κατ᾿ αὐτὸ τοῦτο ὃ ποιεῖ τελείαν ἔχει τὴν ἕξιν, οὐ κινηθήσεται κατ᾿ ἐκεῖνο ὃ ποιεῖ, ὁ δὲ πάσχων ἅτε δεόμενος τοῦ ποιοῦντος, ἵνα τὴν ἐν αὐτῷ ἐνοῦσαν δύναμιν εἰς ἐνέργειαν προαγάγῃ, εἰκότως κινεῖσθαι λέγεται, ἐκ τοῦ δυνάμει εἰς τὸ ἐνεργείᾳ εἶναι, ὃ πέφυκεν εἶναι, προαγόμενος.", "seq": 2710}
{"id": "Philoponus_Passim_2711", "series": "CAG", "text": "ὥστε ἡ κίνησις μία ἐστὶν ἐπὶ μόνου τοῦ πάσχοντος θεωρουμένη, ὁ μέντοι λόγος ὁ τῆς κινήσεως δύναται εἶναι διττός·", "seq": 2711}
{"id": "Philoponus_Passim_2712", "series": "CAG", "text": "δύναται γὰρ θεωρεῖσθαι καὶ ἐπὶ τοῦ ποιοῦντος καὶ ἐπὶ τοῦ πάσχοντος·", "seq": 2712}
{"id": "Philoponus_Passim_2713", "series": "CAG", "text": "ὅταν μὲν γὰρ τὴν κίνησιν θεωρήσωμεν ἀρχομένην ἀπὸ τοῦ ποιοῦντος καὶ λήγουσαν ἐπὶ τὸ πάσχον, ποίησιν αὐτὴν λέγομεν.", "seq": 2713}
{"id": "Philoponus_Passim_2714", "series": "CAG", "text": "ὅταν δὲ θεωρήσωμεν αὐτὴν ἀπὸ τοῦ πάσχοντος ἀρχομένην τελευτῶσαν δὲ ἐπὶ τὸ ποιοῦν, πάθησιν λέγομεν, ὥσπερ καὶ δίδαξιν καὶ μάθησιν ὁμοίως.", "seq": 2714}
{"id": "Philoponus_Passim_2715", "series": "CAG", "text": "ὥστε τῷ μὲν ὑποκειμένῳ μία ἐστὶν ἡ κίνησις, διαφέρει δὲ τῷ λόγῳ.", "seq": 2715}
{"id": "Philoponus_Passim_2716", "series": "CAG", "text": "τὰ δὲ πρός τι οὐ μόνον τῷ λόγῳ διαφέρουσιν, ἀλλὰ καὶ τῷ ὑποκειμένῳ διάφορά ἐστιν.", "seq": 2716}
{"id": "Philoponus_Passim_2717", "series": "CAG", "text": "ὥστε τὸ ποιεῖν καὶ τὸ πάσχειν περὶ ἓν καταγινόμενα ὑποκείμενον, τὴν κίνησιν, οὐκ ἂν εἴη πρός τι, εἴ γε τὰ πρός τι οὐ μόνον τὴν σχέσιν διάφορον θέλουσιν ἔχειν, ἀλλὰ καὶ τὰ ὑποκείμενα.", "seq": 2717}
{"id": "Philoponus_Passim_2718", "series": "CAG", "text": "Διὰ τί οὖν μὴ ἐπέγραψε ‘περὶ ποιήσεως καὶ παθήσεως’;", "seq": 2718}
